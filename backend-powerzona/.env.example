PZ_SECURITY_HMAC_SECRET=
# Clave AES de exactamente 32 caracteres. C03 la reutiliza para cifrar el IP
# completo de instalaciones; el valor nunca se comparte con el telefono.
PZ_SECURITY_AES_KEY=

# C03 storefront: ambos secretos son aleatorios, distintos entre si y de los
# secretos de Seguridad/relay. Minimo 32 caracteres, siempre fuera de Git.
PZ_STOREFRONT_INTERNAL_SECRET=
PZ_STOREFRONT_CREDENTIAL_SECRET=

# C10: secreto exclusivo de al menos 32 caracteres para el runner Android.
# No reutilizar secretos de relay, Firebase, App Check o Seguridad.
PZ_STORE_APP_RUNNER_SECRET=

# C10.7: origen HTTPS permanente del backend que sirve los APK y secreto
# exclusivo para capacidades HMAC no adivinables. No reutilizar el del runner.
# En pruebas locales se acepta solamente http://127.0.0.1 o http://localhost.
PZ_STOREFRONT_APP_DOWNLOAD_PUBLIC_ORIGIN=https://api.tusenda84.com
PZ_STOREFRONT_APP_DOWNLOAD_SECRET=

# Release aprobada del motor Android comun. Incrementar la version solo cuando
# un cambio nativo deba ofrecerse a las apps existentes. La revision es el
# commit Git exacto (40 hex) desplegado en el runner; puede quedar vacia localmente.
PZ_STOREFRONT_ENGINE_VERSION=1.0.0
PZ_STOREFRONT_ENGINE_REVISION=
# normal | recommended | critical
PZ_STOREFRONT_ENGINE_UPDATE_SEVERITY=recommended

# Endpoint SSR que entrega a Firebase los avisos creados en store_notifications.
PZ_PUSH_RELAY_URL=https://tusenda84.com/api/internal/push/send
PZ_PUSH_RELAY_SECRET=

# Solo para una URL HTTP dentro de una red privada entre contenedores.
PZ_PUSH_RELAY_ALLOW_HTTP=0

# C05 storefront: relay v2 paralelo para campañas públicas. URL y secreto son
# exclusivos de storefront; el secreto debe diferir de PZ_PUSH_RELAY_SECRET.
PZ_STOREFRONT_PUSH_RELAY_URL=https://tusenda84.com/api/internal/push/v2/send
PZ_STOREFRONT_PUSH_RELAY_SECRET=
# Origen público HTTPS de PocketBase usado para construir image_url de push_media.
PZ_STOREFRONT_MEDIA_PUBLIC_ORIGIN=https://media.tusenda84.com
# Solo permite HTTP hacia localhost durante pruebas locales explícitas.
PZ_STOREFRONT_PUSH_RELAY_ALLOW_HTTP=0
