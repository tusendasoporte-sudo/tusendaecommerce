PUBLIC_POCKETBASE_URL=http://127.0.0.1:8091
# Opcional y solo SSR: alias interno estable de PocketBase en la red privada de Coolify.
# PZ_POCKETBASE_INTERNAL_URL=http://powerzona-pocketbase-staging:8080

# Rifas usa la sesión normal del admin y no requiere credenciales privadas de superusuario.

# Relay interno para notificaciones push Android. Solo variables del servidor SSR.
# Usa el mismo secreto aleatorio (minimo 32 caracteres) en PocketBase.
PZ_PUSH_RELAY_SECRET=
FIREBASE_PROJECT_ID=

# C03 storefront: mismo secreto interno aleatorio (minimo 32 caracteres) que
# PocketBase. Debe ser distinto de PZ_PUSH_RELAY_SECRET y de Seguridad.
PZ_STOREFRONT_INTERNAL_SECRET=

# Credenciales Firebase Admin: configura una sola opcion como secreto del despliegue.
# Tambien verifican Firebase App Check para /api/storefront/v1/*.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
