---
import { refreshAuthFromCookie } from '../../lib/auth';
import { getStoreAdminPath } from '../../lib/adminRoutes';
import { requireCurrentStoreForAdmin } from '../../lib/storeContext';
import { getStoreAccessContext } from '../../lib/storeTeam';
import { hasStorePermission } from '../../lib/storeTeamPermissions';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import AdminSectionHeader from '../../components/admin/AdminSectionHeader.astro';
import '../../styles/global.css';

const pocketbaseUrl = String(import.meta.env.PUBLIC_POCKETBASE_URL || '').replace(/\/+$/, '');
const authPb = Astro.locals.adminAuthPb
  ?? await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
const adminContext = Astro.locals.adminContext
  ?? await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
const authToken = authPb.authStore.token;
const storeAccessContext = Astro.locals.storeAccessContext
  ?? await getStoreAccessContext({
    baseUrl: pocketbaseUrl,
    token: authToken,
    supportStoreId: adminContext.isMasterSupport ? adminContext.storeId : undefined,
  }).catch(() => null);
const canViewAnalytics = adminContext.isMasterSupport || hasStorePermission({
  permissions: storeAccessContext?.access.permissions,
  is_primary_admin: storeAccessContext?.access.is_primary_admin,
  blocked_by_plan: storeAccessContext?.access.blocked_by_plan,
}, 'analytics.view');
if (!canViewAnalytics) return Astro.redirect(getStoreAdminPath(adminContext.store.slug, 'pageviews'));

const allowedRanges = new Set(['today', '7', '15', '30', '90']);
const requestedRange = String(Astro.url.searchParams.get('range') || 'today').trim().toLowerCase();
const range = allowedRanges.has(requestedRange) ? requestedRange : 'today';
const response = await fetch(`${pocketbaseUrl}/api/pz/storefront/v1/analytics/installations`, {
  method: 'POST',
  headers: {
    Accept: 'application/json',
    Authorization: `Bearer ${authToken}`,
    'Content-Type': 'application/json',
    ...(adminContext.isMasterSupport ? { 'X-PZ-Support-Store': adminContext.storeId } : {}),
  },
  body: JSON.stringify({ range }),
  cache: 'no-store',
}).catch(() => null);
const payload = response?.ok ? await response.json().catch(() => null) : null;
const isCount = (value: unknown) => Number.isInteger(value) && Number(value) >= 0;
const normalizeAnalytics = (value: any) => {
  const expectedDays: Record<string, number> = { today: 1, '7': 7, '15': 15, '30': 30, '90': 90 };
  if (!value || typeof value !== 'object' || value.ok !== true
    || !Object.prototype.hasOwnProperty.call(expectedDays, value.range)
    || value.period_days !== expectedDays[value.range]
    || value.active_estimate_window_days !== 30
    || value.time_zone !== 'America/Havana'
    || typeof value.measurement_note !== 'string' || !value.measurement_note.trim()
    || !value.metrics || !value.status || !value.permission
    || !Array.isArray(value.daily) || !value.distributions) return null;
  const metricKeys = ['instalaciones_vigentes_ahora', 'instalaciones_nuevas', 'bajas_detectadas'];
  const statusKeys = ['active', 'disabled', 'invalid', 'revoked'];
  const permissionKeys = ['granted', 'denied', 'unknown'];
  const distributionKeys = ['app_versions', 'android_versions', 'device_models'];
  if (metricKeys.some((key) => !isCount(value.metrics[key]))
    || statusKeys.some((key) => !isCount(value.status[key]))
    || permissionKeys.some((key) => !isCount(value.permission[key]))
    || distributionKeys.some((key) => !Array.isArray(value.distributions[key])
      || value.distributions[key].some((item: any) => !item || typeof item.label !== 'string' || !isCount(item.count)))
    || value.daily.length !== value.period_days
    || value.daily.some((item: any) => !item || !/^\d{4}-\d{2}-\d{2}$/.test(item.day)
      || !isCount(item.new_installations) || !isCount(item.bajas_detectadas))
    || value.metrics.instalaciones_vigentes_ahora !== value.status.active
    || value.permission.granted + value.permission.denied + value.permission.unknown !== value.status.active) return null;
  return value;
};
const analytics = normalizeAnalytics(payload);
const metrics = analytics?.metrics || {};
const permission = analytics?.permission || {};
const rangeLabels = { today: 'Hoy', '7': '7 días', '15': '15 días', '30': '30 días', '90': '90 días' };
const adminOverviewPath = getStoreAdminPath(adminContext.store.slug);
const installationDetailsPath = getStoreAdminPath(adminContext.store.slug, 'app-installation-details');
const chartRows = analytics?.daily || [];
const chartWidth = 960;
const chartLeft = 58;
const chartRight = 930;
const chartTop = 26;
const chartBottom = 238;
const chartMaximum = Math.max(1, ...chartRows.flatMap((item: any) => [
  Number(item.new_installations || 0),
  Number(item.bajas_detectadas || 0),
]));
const chartX = (index: number) => chartRows.length <= 1
  ? (chartLeft + chartRight) / 2
  : chartLeft + (index / (chartRows.length - 1)) * (chartRight - chartLeft);
const chartY = (value: number) => chartBottom - (value / chartMaximum) * (chartBottom - chartTop);
const highPoints = chartRows.map((item: any, index: number) => `${chartX(index)},${chartY(Number(item.new_installations || 0))}`).join(' ');
const lowPoints = chartRows.map((item: any, index: number) => `${chartX(index)},${chartY(Number(item.bajas_detectadas || 0))}`).join(' ');
const chartTickValues = [...new Set([chartMaximum, Math.ceil(chartMaximum / 2), 0])];
const chartLabelIndexes = [...new Set([0, Math.floor((chartRows.length - 1) / 2), chartRows.length - 1])]
  .filter((index) => index >= 0);
const shortDate = (value: string) => {
  const [, month = '', day = ''] = String(value || '').split('-');
  return `${day}/${month}`;
};
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>App instalaciones | Admin</title>
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #0f172a; background: #eef3f9; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; }
      .page { padding: 28px; display: grid; gap: 22px; }
      .back { color: #1d4ed8; font-weight: 850; width: fit-content; }
      .period-picker { width: min(100%, 280px); display: grid; gap: 7px; }
      .period-picker span { color: #475569; font-size: 13px; font-weight: 850; }
      .period-picker select { width: 100%; min-height: 46px; border: 1px solid #cbd5e1; border-radius: 14px; background: #fff; color: #0f172a; padding: 0 42px 0 14px; font: inherit; font-weight: 850; cursor: pointer; }
      .section { background: #fff; border: 1px solid #dbe4ef; border-radius: 22px; padding: 20px; box-shadow: 0 12px 32px rgba(15, 23, 42, .06); }
      .muted { color: #64748b; }
      .section h2 { margin: 0 0 14px; font-size: 20px; }
      .summary-lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: stretch; }
      .summary-lists .admin-compact-summary { max-width: none; height: 100%; margin: 0; }
      .details-cta { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 20px; border: 1px solid #dbe4ef; border-radius: 22px; background: linear-gradient(135deg, #fff 0%, #f8fbff 100%); box-shadow: 0 12px 32px rgba(15,23,42,.06); }
      .details-cta h2 { margin: 0; font-size: 19px; }
      .details-cta p { margin: 6px 0 0; color: #64748b; font-size: 13px; font-weight: 750; line-height: 1.45; }
      .details-button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 17px; border: 1px solid #2563eb; border-radius: 13px; background: #2563eb; color: #fff; font-size: 13px; font-weight: 950; text-decoration: none; white-space: nowrap; box-shadow: 0 10px 22px rgba(37,99,235,.2); }
      .details-button:hover { background: #1d4ed8; }
      .chart-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
      .chart-head h2 { margin-bottom: 4px; }
      .chart-legend { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; color: #475569; font-size: 13px; font-weight: 800; }
      .chart-legend span { display: inline-flex; align-items: center; gap: 7px; }
      .chart-legend i { width: 18px; height: 4px; border-radius: 999px; background: #2563eb; }
      .chart-legend .is-low { background: #ef4444; }
      .installations-chart { width: 100%; min-height: 250px; overflow: hidden; border-radius: 16px; background: linear-gradient(180deg, #f8fafc 0%, #fff 100%); }
      .installations-chart svg { display: block; width: 100%; height: auto; min-height: 250px; }
      .chart-grid-line { stroke: #dbe4ef; stroke-width: 1; }
      .chart-axis-label { fill: #64748b; font-size: 12px; font-weight: 700; }
      .chart-high-line, .chart-low-line { fill: none; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
      .chart-high-line { stroke: #2563eb; }
      .chart-low-line { stroke: #ef4444; }
      .chart-high-point { fill: #2563eb; }
      .chart-low-point { fill: #ef4444; }
      .notice { background: #eff6ff; color: #1e3a8a; border: 1px solid #bfdbfe; border-radius: 16px; padding: 14px 16px; line-height: 1.55; }
      .error { background: #fff1f2; color: #9f1239; border-color: #fecdd3; }
      @media (max-width: 800px) { .page { padding: 18px; } .summary-lists { grid-template-columns: 1fr; } .details-cta { align-items: stretch; flex-direction: column; } .details-button { width: 100%; } .chart-head { display: grid; } }
    </style>
  </head>
  <body>
    <main class="pz-admin-content">
      <AdminSidebar
        storeId={adminContext.storeId}
        pocketbaseUrl={pocketbaseUrl}
        authToken={authToken}
        storeAccessContext={storeAccessContext}
        storeSlug={adminContext.store.slug}
        storeName={adminContext.store.name || adminContext.store.slug}
        storePlanValues={adminContext.store}
        activeSection="overview"
      />
      <div class="pz-admin-content-inner page">
        <a class="back" href={`${adminOverviewPath}#app-installations`}>← Volver a Analíticas</a>
        <AdminSectionHeader
          kicker="Analíticas"
          title="App instalaciones"
          description="Salud y evolución agregada de las instalaciones de esta tienda."
        />
        <form class="period-picker" method="get">
          <label for="installation-period"><span>Período</span></label>
          <select id="installation-period" name="range" data-installation-period aria-label="Período de instalaciones">
            {Object.entries(rangeLabels).map(([value, label]) => (
              <option value={value} selected={range === value}>{label}</option>
            ))}
          </select>
        </form>

        {!analytics ? (
          <p class="notice error">No se pudo cargar la analítica de instalaciones. No se mostraron datos parciales.</p>
        ) : (
          <>
            <section class="summary-lists" aria-label="Resumen de instalaciones y permisos">
              <section class="admin-compact-summary" aria-label="Resumen de instalaciones">
                <div class="admin-compact-summary__head">
                  <span class="admin-compact-summary__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="3"></rect><path d="M10 5h4M11 18h2"></path></svg>
                  </span>
                  <div>
                    <p class="admin-compact-summary__eyebrow">Resumen</p>
                    <h2 class="admin-compact-summary__title">Instalaciones</h2>
                    <p class="admin-compact-summary__subtitle">Estado estimado y movimientos del período seleccionado.</p>
                  </div>
                </div>
                <div class="admin-compact-summary__list">
                  <article class="admin-compact-summary__item is-ok"><p class="admin-compact-summary__label">Instalaciones activas estimadas</p><p class="admin-compact-summary__value">{Number(metrics.instalaciones_vigentes_ahora || 0).toLocaleString('es-US')}</p></article>
                  <article class="admin-compact-summary__item"><p class="admin-compact-summary__label">Nuevas del período</p><p class="admin-compact-summary__value">{Number(metrics.instalaciones_nuevas || 0).toLocaleString('es-US')}</p></article>
                  <article class="admin-compact-summary__item is-warn"><p class="admin-compact-summary__label">Bajas detectadas</p><p class="admin-compact-summary__value">{Number(metrics.bajas_detectadas || 0).toLocaleString('es-US')}</p></article>
                </div>
              </section>

              <section class="admin-compact-summary" aria-label="Permisos de notificaciones">
                <div class="admin-compact-summary__head">
                  <span class="admin-compact-summary__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path><path d="M10 21h4"></path></svg>
                  </span>
                  <div>
                    <p class="admin-compact-summary__eyebrow">Resumen</p>
                    <h2 class="admin-compact-summary__title">Permisos de notificaciones</h2>
                    <p class="admin-compact-summary__subtitle">Distribución entre las instalaciones activas estimadas.</p>
                  </div>
                </div>
                <div class="admin-compact-summary__list">
                  <article class="admin-compact-summary__item is-ok"><p class="admin-compact-summary__label">Concedido</p><p class="admin-compact-summary__value">{Number(permission.granted || 0).toLocaleString('es-US')}</p></article>
                  <article class="admin-compact-summary__item is-warn"><p class="admin-compact-summary__label">Denegado</p><p class="admin-compact-summary__value">{Number(permission.denied || 0).toLocaleString('es-US')}</p></article>
                  <article class="admin-compact-summary__item is-muted"><p class="admin-compact-summary__label">Sin decidir</p><p class="admin-compact-summary__value">{Number(permission.unknown || 0).toLocaleString('es-US')}</p></article>
                </div>
              </section>
            </section>

            <section class="details-cta" aria-label="Versiones y modelos">
              <div>
                <h2>Versiones y modelos</h2>
                <p>Consulta cada instalación activa con su código seguro, modelo, versión de app y Android.</p>
              </div>
              <a class="details-button" href={`${installationDetailsPath}?range=${encodeURIComponent(range)}`}>Más detalles</a>
            </section>

            <section class="section">
              <header class="chart-head">
                <div>
                  <h2>Altas y bajas detectadas</h2>
                  <p class="muted">Evolución diaria durante el período seleccionado.</p>
                </div>
                <div class="chart-legend" aria-label="Leyenda de la gráfica">
                  <span><i aria-hidden="true"></i>Altas activas</span>
                  <span><i class="is-low" aria-hidden="true"></i>Bajas detectadas</span>
                </div>
              </header>
              <div class="installations-chart">
                <svg viewBox={`0 0 ${chartWidth} 280`} role="img" aria-labelledby="installations-chart-title installations-chart-description">
                  <title id="installations-chart-title">Gráfica de altas y bajas detectadas</title>
                  <desc id="installations-chart-description">Compara altas activas y bajas técnicas por día.</desc>
                  {chartTickValues.map((tick) => (
                    <g>
                      <line class="chart-grid-line" x1={chartLeft} x2={chartRight} y1={chartY(tick)} y2={chartY(tick)} />
                      <text class="chart-axis-label" x={chartLeft - 12} y={chartY(tick) + 4} text-anchor="end">{tick}</text>
                    </g>
                  ))}
                  {chartRows.length > 1 && <polyline class="chart-high-line" points={highPoints} />}
                  {chartRows.length > 1 && <polyline class="chart-low-line" points={lowPoints} />}
                  {chartRows.map((item: any, index: number) => (
                    <>
                      <circle class="chart-high-point" cx={chartX(index)} cy={chartY(Number(item.new_installations || 0))} r="5">
                        <title>{`${item.day}: ${Number(item.new_installations || 0)} altas activas`}</title>
                      </circle>
                      <circle class="chart-low-point" cx={chartX(index)} cy={chartY(Number(item.bajas_detectadas || 0))} r="5">
                        <title>{`${item.day}: ${Number(item.bajas_detectadas || 0)} bajas detectadas`}</title>
                      </circle>
                    </>
                  ))}
                  {chartLabelIndexes.map((index) => (
                    <text class="chart-axis-label" x={chartX(index)} y={chartBottom + 28} text-anchor="middle">{shortDate(chartRows[index]?.day)}</text>
                  ))}
                </svg>
              </div>
            </section>
          </>
        )}
      </div>
    </main>
    <script>
      document.querySelector<HTMLSelectElement>('[data-installation-period]')
        ?.addEventListener('change', (event) => {
          const select = event.currentTarget as HTMLSelectElement;
          select.form?.requestSubmit();
        });
    </script>
  </body>
</html>
