---
export const prerender = false;

import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import { getStoreAdminPath } from '../../lib/adminRoutes';
import { isMasterAdmin, isStoreAdmin, refreshAuthFromCookie } from '../../lib/auth';
import { readAdminDeviceToken } from '../../lib/adminDevice';
import { getAdminAppErrorMessage, getAdminAppPortal, parseNativeAdminAppUserAgent } from '../../lib/mobileAdminReleases';
import { requireCurrentStoreForAdmin } from '../../lib/storeContext';
import '../../styles/global.css';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const cookie = Astro.request.headers.get('cookie') || '';
const authPb = Astro.locals.adminAuthPb ?? await refreshAuthFromCookie(cookie);
if (!authPb.authStore.isValid || !authPb.authStore.record) return Astro.redirect('/login');
if (isMasterAdmin(authPb.authStore.record as any)) return Astro.redirect('/master/mobile-admin');
if (!isStoreAdmin(authPb.authStore.record as any)) return Astro.redirect('/admin');

let adminContext;
try {
  adminContext = Astro.locals.adminContext ?? await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
} catch (_) { return Astro.redirect('/login'); }
const storeSlug = String(adminContext.store.slug || '').trim().toLowerCase();
const canonicalPath = getStoreAdminPath(storeSlug, 'mobile-app');
const pathSlug = String(Astro.params.storeSlug || '').trim().toLowerCase();
if (pathSlug && pathSlug !== storeSlug) return Astro.redirect(canonicalPath);

const grant = String(Astro.url.searchParams.get('grant') || '').trim();
const nativeIdentity = parseNativeAdminAppUserAgent(Astro.request.headers.get('user-agent') || '');
const packageName = nativeIdentity?.package_name || '';
// Una primera instalación desde navegador recibe siempre producción. Staging solo
// se resuelve cuando la propia APK se identifica con su package_name exacto.
const channel = 'production';
const deviceToken = readAdminDeviceToken(cookie);
const result = await getAdminAppPortal(
  import.meta.env.PUBLIC_POCKETBASE_URL,
  authPb.authStore.token,
  deviceToken,
  { grant, package_name: packageName, channel },
);
const access = result.data;
const storeName = String(adminContext.store.name || storeSlug || 'Tienda');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Mobile Admin | {storeName}</title>
  </head>
  <body class="admin-mobile-release-page">
    <AdminSidebar
      storeId={adminContext.storeId}
      pocketbaseUrl={import.meta.env.PUBLIC_POCKETBASE_URL}
      authToken={authPb.authStore.token}
      storeSlug={storeSlug}
      storeName={storeName}
      storePlanValues={adminContext.store}
      activeSection="account"
      mobileTitle="Mobile Admin"
    />
    <main class="release-shell" data-admin-mobile-portal data-grant={grant} data-package={packageName} data-channel={channel}>
      {access ? (
        <>
          <header class="release-hero">
            <span>ACTUALIZACIÓN PRIVADA</span>
            <h1>{access.profile.display_name}</h1>
            <p>Disponible para <strong>{access.recipient.user.name || access.recipient.user.email}</strong> únicamente con su sesión y el dispositivo autorizado <strong>{access.recipient.device.label}</strong>.</p>
          </header>
          <section class="release-card">
            <dl>
              <div><dt>Versión</dt><dd>{access.artifact.version_name} ({access.artifact.version_code})</dd></div>
              <div><dt>Paquete</dt><dd>{access.profile.package_name}</dd></div>
              <div><dt>Archivo</dt><dd>{access.artifact.file_name}</dd></div>
              <div><dt>SHA-256</dt><dd class="checksum">{access.artifact.sha256}</dd></div>
              <div><dt>Canal</dt><dd>{access.profile.channel === 'staging' ? 'Pruebas' : 'Producción'}</dd></div>
            </dl>
            <div class="release-warning">
              <strong>Comprueba antes de instalar</strong>
              <p>Android debe mostrar el mismo paquete y aceptar la actualización sin desinstalar. Si solicita eliminar la app anterior, cancela.</p>
            </div>
            <button
              type="button"
              class="release-download"
              data-admin-mobile-download
              data-package={access.profile.package_name}
              data-version-code={String(access.artifact.version_code)}
              data-sha256={access.artifact.sha256}
            >{nativeIdentity ? 'Descargar actualización' : 'Descargar APK'}</button>
            <p class="release-status" data-admin-mobile-status aria-live="polite"></p>
          </section>
        </>
      ) : (
        <section class="release-card release-card--error" role="alert">
          <h1>Entrega no disponible</h1>
          <p>{getAdminAppErrorMessage(result.error)}</p>
          <a href={getStoreAdminPath(storeSlug, 'account')}>Volver a mi cuenta</a>
        </section>
      )}
    </main>

    {access && (
      <script>
        const root = document.querySelector('[data-admin-mobile-portal]') as HTMLElement | null;
        const button = root?.querySelector<HTMLButtonElement>('[data-admin-mobile-download]');
        const status = root?.querySelector<HTMLElement>('[data-admin-mobile-status]');
        const grant = root?.dataset.grant || '';
        const packageName = root?.dataset.package || '';
        const channel = root?.dataset.channel === 'staging' ? 'staging' : 'production';
        function show(message: string, error = false) {
          if (!status) return;
          status.textContent = message;
          status.classList.toggle('is-error', error);
        }

        window.addEventListener('pz:android-admin-app-state', async (event) => {
          const detail = (event as CustomEvent).detail || {};
          if (!detail.package_name || !detail.version_code || !detail.version_name) return;
          await fetch('/api/admin/mobile-app/check-in', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ package_name: detail.package_name, version_code: Number(detail.version_code), version_name: detail.version_name }),
          }).catch(() => null);
        });
        (window as any).PZAndroidUpdate?.requestState?.();

        button?.addEventListener('click', async () => {
          button.disabled = true;
          show('Creando un ticket privado de un solo uso…');
          try {
            const response = await fetch('/api/admin/mobile-app/ticket', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ grant, package_name: packageName, channel }),
            });
            const payload = await response.json();
            if (!response.ok || payload?.ok !== true) throw new Error(String(payload?.error || 'ticket_failed'));
            const nativeUpdater = (window as any).PZAndroidUpdate;
            if (nativeUpdater?.downloadUpdate) {
              nativeUpdater.downloadUpdate(
                new URL(payload.download_url, window.location.origin).toString(),
                button.dataset.sha256 || '', Number(button.dataset.versionCode || 0), button.dataset.package || '',
              );
              show('La app verificará checksum, paquete, firma y versión antes de abrir Android.');
            } else {
              show('Descarga autorizada. El ticket vence en dos minutos y solo funciona una vez.');
              window.location.assign(payload.download_url);
            }
          } catch (_) {
            show('No fue posible autorizar la descarga. Actualiza la página e inténtalo nuevamente.', true);
          } finally { button.disabled = false; }
        });
      </script>
    )}
  </body>
</html>

<style>
  .admin-mobile-release-page{margin:0;background:#f4f7fb;color:#0f172a}.release-shell{width:min(920px,calc(100% - 36px));margin:0 auto;padding:34px 0 90px}.release-hero{padding:28px;border-radius:24px;background:linear-gradient(135deg,#0f172a,#312e81);color:#fff}.release-hero>span{font-size:11px;font-weight:900;letter-spacing:.12em;color:#c7d2fe}.release-hero h1{margin:8px 0;font-size:clamp(30px,7vw,48px)}.release-hero p{margin:0;color:#e0e7ff;line-height:1.55}.release-card{display:grid;gap:20px;margin-top:18px;border:1px solid #dbe3ef;border-radius:22px;background:#fff;padding:24px;box-shadow:0 18px 50px rgba(15,23,42,.08)}.release-card dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0}.release-card dl div{display:grid;gap:5px;border:1px solid #e2e8f0;border-radius:13px;padding:13px}.release-card dt{color:#64748b;font-size:11px;font-weight:900;text-transform:uppercase}.release-card dd{margin:0;font-weight:850;overflow-wrap:anywhere}.checksum{font:700 12px ui-monospace,monospace}.release-warning{border:1px solid #fde68a;border-radius:14px;background:#fffbeb;color:#92400e;padding:14px}.release-warning p{margin:5px 0 0;line-height:1.5}.release-download{min-height:50px;border:0;border-radius:12px;background:#111827;color:#fff;padding:12px 18px;font:900 14px inherit;cursor:pointer}.release-download:disabled{opacity:.55;cursor:wait}.release-status{min-height:20px;margin:0;color:#166534;font-weight:800}.release-status.is-error{color:#b91c1c}.release-card--error{color:#991b1b}.release-card--error a{width:max-content;border-radius:10px;background:#111827;color:#fff;padding:11px 14px;text-decoration:none;font-weight:900}@media(max-width:760px){.release-shell{padding-top:90px}.release-card dl{grid-template-columns:1fr}}
</style>
