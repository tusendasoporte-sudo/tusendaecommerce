          const result = await apiRequest(`/api/pz/admin/orders/${selectedOrder.id}/items/${adjustmentItem.id}/price-adjustments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              final_unit_price_usd: finalUnit,
              reason_code: reason.reasonCode,
              reason_text: reason.reasonText,
              confirm_zero_price: finalUnit === 0 && priceAdjustmentZeroConfirm.checked,
            }),
          });
          await applyPrivateOrderMutation(result);
          closePriceAdjustment();
          setDetailAlert('Ajuste especial guardado y auditado.', 'success');
