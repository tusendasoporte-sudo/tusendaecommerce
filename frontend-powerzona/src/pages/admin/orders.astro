          return CAN_CONTACT_ORDER_CUSTOMERS;
        }
        if (['delivery_method', 'shipping_zone'].includes(key)) return CAN_MANAGE_ORDER_SHIPPING;
        if (['shipping', 'shipping_usd', 'shipping_cup'].includes(key)) return CAN_MANAGE_ORDER_SHIPPING && CAN_ADJUST_ORDER_PRICE;
        if (['subtotal', 'total', 'total_usd', 'usd_total'].includes(key)) return CAN_ADJUST_ORDER_PRICE;
        if (['review_requested_at', 'review_request_count', 'review_skipped_at', 'review_completed_at'].includes(key)) return CAN_MANAGE_ORDER_REVIEWS;
        // Estado, inventario y tokens solo se mutan mediante acciones privadas
        // atomicas; nunca por PATCH directo desde el navegador.
