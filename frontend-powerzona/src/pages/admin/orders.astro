      function assertOrderMutationAllowed(path, options = {}) {
        const method = String(options.method || 'GET').toUpperCase();
        if (!['POST', 'PATCH', 'PUT', 'DELETE'].includes(method)) return;

        if (/^\/api\/pz\/admin\/orders\/[^/]+\/transition(?:\?|$)/.test(path)) {
          const status = String(parseMutationJsonBody(options.body).status || '').trim().toLowerCase();
          const allowed = status === 'cancelled' ? CAN_CANCEL_DELETE_ORDERS : CAN_MANAGE_ORDER_STATUS;
          if (!allowed) throw new Error('No tienes permiso para cambiar este estado.');
          return;
        }
        if (/^\/api\/pz\/admin\/orders\/[^/]+\/receipt-token(?:\?|$)/.test(path)) {
          if (method !== 'POST' || !CAN_CONTACT_ORDER_CUSTOMERS) {
            throw new Error('No tienes permiso para generar el resumen del pedido.');
          }
          return;
        }
        if (/^\/api\/pz\/admin\/orders\/[^/]+\/review-token(?:\?|$)/.test(path)) {
          if (method !== 'POST' || !CAN_MANAGE_ORDER_REVIEWS) {
