        updateOrderEditorPreviewBeforeAutoSave();
        clearTimeout(orderAutoSaveTimer);
        orderAutoSaveTimer = setTimeout(() => autoSaveOrderEditorFields(), 650);
      }

      async function autoSaveOrderEditorFields() {
        if (!selectedOrder || isOrderEditingLocked() || (!CAN_CONTACT_ORDER_CUSTOMERS && !CAN_MANAGE_ORDER_SHIPPING)) return;
        const phoneValidation = CAN_CONTACT_ORDER_CUSTOMERS
          ? normalizeEditableCustomerPhone(editCustomerPhone?.value || '')
          : { isValid: true, phone: selectedOrder.customer_phone || '' };
        if (!phoneValidation.isValid) {
          setDetailAlert('El teléfono del cliente no parece válido para WhatsApp. Revisa el número antes de guardar.', 'error');
          return;
        }
        const payload = getOrderEditorPayloadForAutoSave(phoneValidation.phone);
        if (!payload) return;

        if (orderAutoSaveRunning) {
          orderAutoSavePending = true;
          return;
        }

        orderAutoSaveRunning = true;
        orderAutoSavePending = false;
        setDetailAlert('Guardando cambios automáticos...', 'info');

        try {
          const updatedOrder = await apiRequest(`/api/collections/orders/records/${selectedOrder.id}?expand=shipping_zone,currency`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          orders = orders.map((order) => order.id === updatedOrder.id ? updatedOrder : order);
          selectedOrder = updatedOrder;
          detailStatusBadge.className = getStatusClass(selectedOrder.status);
          detailStatusBadge.textContent = getStatusLabel(selectedOrder.status);
          detailCustomer.textContent = selectedOrder.customer_name || 'Sin nombre';
          detailPhone.textContent = CAN_CONTACT_ORDER_CUSTOMERS ? (selectedOrder.customer_phone || 'Sin teléfono') : '';
          if (editCustomerPhone) editCustomerPhone.value = CAN_CONTACT_ORDER_CUSTOMERS ? (selectedOrder.customer_phone || '') : '';
          updateShippingCostPreview();
          updateDeliveryLivePreview();
          renderStats();
          renderOrders();
          setDetailAlert('Cambios guardados automáticamente.', 'success');
        } catch (error) {
          setDetailAlert('No se pudieron guardar automáticamente los datos de la orden. Revisa tu sesion admin o las reglas administrativas.', 'error');
        } finally {
          orderAutoSaveRunning = false;
          if (orderAutoSavePending) {
            orderAutoSavePending = false;
            scheduleOrderAutoSave();
          }
        }
      }

      function getVariationsForProduct(productId) {
        return productVariations.filter((variation) => variation.product === productId);
      }

      function productUsesVariationMode(product) {
        return globalThis.pzAdminStoreProducts?.productUsesVariations
          ? globalThis.pzAdminStoreProducts.productUsesVariations(product)
          : Boolean(product?.has_variations);
      }

      function getSellableVariationsForProduct(product) {
        const owned = getVariationsForProduct(product?.id);
        if (!productUsesVariationMode(product)) return [];
        if (globalThis.pzAdminStoreProducts?.getSellableProductVariations) {
          return globalThis.pzAdminStoreProducts.getSellableProductVariations(product, owned);
        }
        const today = new Date().toISOString().slice(0, 10);
        return owned.filter((variation) => variation.active !== false
          && Number(variation.price_usd || 0) > 0
          && (!variation.expiration_date || String(variation.expiration_date).slice(0, 10) > today));
      }

      function parentProductUnavailableReason(product) {
        if (!product || product.active === false) return 'Producto no disponible';
        if (!(Number(product.base_price_usd || 0) > 0)) return 'Producto sin precio de venta valido';
        const today = globalThis.pzAdminStoreProducts?.todayCivilDate?.() || new Date().toISOString().slice(0, 10);
        const expirationDate = String(product.expiration_date || '').slice(0, 10);
        if (expirationDate && expirationDate <= today) return 'Producto no disponible por vencimiento';
        if (productTracksStock(product) && !product.allow_preorder && !(Number(product.stock || 0) > 0)) return 'Producto sin stock disponible';
        return '';
      }

      function getVariationLabel(variation) {
        return [variation.variation_type, variation.value].filter(Boolean).join(': ') || 'Variación';
      }

      function getVariationUnitPrice(product, variation) {
        return globalThis.pzAdminStoreProducts?.variationUnitPrice
          ? globalThis.pzAdminStoreProducts.variationUnitPrice(variation)
          : Math.max(0, Number(variation?.price_usd ?? variation?.precio_usd ?? 0));
      }

      function getStockValue(record) {
        if (!record) return null;
        const candidates = [record.stock, record.quantity, record.inventory, record.stock_available];
        const value = candidates.find((candidate) => candidate !== undefined && candidate !== null && candidate !== '');
        if (value === undefined) return null;
        const numeric = Number(value);
        return Number.isFinite(numeric) ? Math.max(0, numeric) : null;
      }

      // Regla segura: track_stock=false significa que el producto se puede vender sin validar ni descontar inventario.
      function productTracksStock(product) {
        return product?.track_stock !== false;
      }

      function getItemProduct(item) {
        return item?.expand?.product || productCatalog.find((product) => product.id === item?.product) || null;
      }

      function getItemVariation(item) {
        return item?.expand?.variation || productVariations.find((variation) => variation.id === item?.variation) || null;
      }

      function orderHasStockDeducted(order = selectedOrder) {
        return Boolean(order?.stock_deducted || order?.inventory_deducted);
      }

      function isOrderEditingLocked() {
        const status = normalizeStatus(selectedOrder?.status);
        return Boolean(selectedOrder && ['confirmed', 'delivered', 'cancelled'].includes(status));
      }

      function isProductEditingLocked() {
        return isOrderEditingLocked();
      }

      function getProductStockKey(productId, variationId = '') {
        if (variationId) return `variation:${variationId}`;
        if (productId) return `product:${productId}`;
        return '';
      }

      function getItemStockKey(item) {
        if (!item) return '';
        return getProductStockKey(item.product, item.variation || '');
      }

      function getUsedQuantityForStockKey(stockKey, excludeItemId = '') {
        if (!stockKey) return 0;
        return selectedItems.reduce((sum, item) => {
          if (excludeItemId && item.id === excludeItemId) return sum;
          return getItemStockKey(item) === stockKey ? sum + Number(item.quantity || 0) : sum;
        }, 0);
      }

      function getMaxQuantityForExistingItem(item) {
        const stockInfo = getItemStockInfo(item);
        if (!stockInfo?.tracksStock) return null;
        if (!Number.isFinite(stockInfo.stock) || stockInfo.stock === null) return null;
        const usedByOtherLines = getUsedQuantityForStockKey(getItemStockKey(item), item.id);
        return Math.max(0, Number(stockInfo.stock || 0) - usedByOtherLines);
      }

      function getAvailableStockForProductSelection(product, variation = null) {
        if (!product || !productTracksStock(product)) return null;
        const stockSource = variation || product;
        const baseStock = getStockValue(stockSource);
        if (!Number.isFinite(baseStock) || baseStock === null) return null;
        const stockKey = getProductStockKey(product.id, variation?.id || '');
        const usedInThisOrder = getUsedQuantityForStockKey(stockKey);
        return Math.max(0, Number(baseStock || 0) - usedInThisOrder);
      }

      function findExistingItemForSelection(productId, variationId = '') {
        const stockKey = getProductStockKey(productId, variationId);
        return selectedItems.find((item) => getItemStockKey(item) === stockKey) || null;
      }

      function getItemStockInfo(item) {
        const product = getItemProduct(item);
        if (!productTracksStock(product)) {
          return {
            stock: null,
            label: 'Sin stock descontable',
            source: 'none',
            tracksStock: false,
          };
        }

        const variation = getItemVariation(item);
        if (variation) {
          return {
            stock: getStockValue(variation),
            label: `Stock de variación: ${Number(getStockValue(variation) || 0)}`,
            source: 'variation',
            tracksStock: true,
          };
        }

        return {
          stock: getStockValue(product),
          label: `Stock del producto: ${Number(getStockValue(product) || 0)}`,
          source: 'product',
          tracksStock: true,
        };
      }

      function clampQuantityToStock(input, maxStock, statusEl = null) {
        if (!input) return 1;
        let quantity = Math.max(1, Math.floor(Number(input.value || 1)));
        if (Number.isFinite(maxStock) && maxStock !== null) {
          if (maxStock <= 0) {
            quantity = 1;
            input.value = '1';
            if (statusEl) statusEl.textContent = 'Este producto no tiene stock disponible.';
            return quantity;
          }
          if (quantity > maxStock) {
            quantity = maxStock;
            input.value = String(maxStock);
            if (statusEl) statusEl.textContent = `No puedes superar el stock disponible (${maxStock}).`;
          }
        }
        input.value = String(quantity);
        return quantity;
      }

      function getAddProductCurrentStock() {
        if (!selectedAddProduct) return null;
        const usesVariations = productUsesVariationMode(selectedAddProduct);
        const variation = productVariations.find((item) => item.id === addProductVariationSelect.value);
        if (usesVariations && variation) return getAvailableStockForProductSelection(selectedAddProduct, variation);
        if (!usesVariations) return getAvailableStockForProductSelection(selectedAddProduct, null);
        return null;
      }

      function updateAddProductQuantityLimit() {
        if (!addProductQuantity) return;
        const availableStock = getAddProductCurrentStock();
        if (Number.isFinite(availableStock) && availableStock !== null) {
          addProductQuantity.max = String(availableStock);
          if (availableStock <= 0) {
            addProductQuantity.value = '1';
            if (addProductPreview && selectedAddProduct) {
              addProductPreview.textContent = 'Este producto ya no tiene unidades disponibles para agregar en esta orden.';
            }
            return;
          }
          if (Number(addProductQuantity.value || 1) > availableStock) {
            addProductQuantity.value = String(availableStock);
          }
        } else {
          addProductQuantity.removeAttribute('max');
        }
      }

      function resetAddProductForm(message = '') {
        selectedAddProduct = null;
        if (addProductSearch) addProductSearch.value = '';
        if (addProductSelectedId) addProductSelectedId.value = '';
        if (addProductPriceDisplay) addProductPriceDisplay.textContent = formatUSD(0);
        if (addProductQuantity) addProductQuantity.value = '1';
        if (addProductVariationWrap) addProductVariationWrap.classList.add('hidden');
        if (addProductVariationSelect) addProductVariationSelect.innerHTML = '<option value="">Selecciona una variación</option>';
        if (addProductResults) {
          addProductResults.innerHTML = '';
          addProductResults.classList.add('hidden');
        }
        if (addProductPreview) {
          addProductPreview.textContent = message || 'Selecciona un producto para cargar precio, stock y variaciones.';
        }
      }

      function renderProductSearchResults() {
        if (!addProductResults || !addProductSearch) return;
        const query = addProductSearch.value.trim().toLowerCase();
        selectedAddProduct = null;
        addProductSelectedId.value = '';

        if (!query) {
          addProductResults.innerHTML = '';
          addProductResults.classList.add('hidden');
          if (addProductPreview) addProductPreview.textContent = 'Escribe el nombre del producto para buscarlo.';
          return;
        }

        const matches = productCatalog
          .filter((product) => String(product.name || '').toLowerCase().includes(query))
          .slice(0, 10);

        if (!matches.length) {
          addProductResults.innerHTML = '<div class="item-row" style="grid-template-columns:1fr;"><div class="item-sub">No se encontraron productos con ese nombre.</div></div>';
          addProductResults.classList.remove('hidden');
          return;
        }

        addProductResults.innerHTML = matches.map((product) => {
          const variationsCount = productUsesVariationMode(product)
            ? getSellableVariationsForProduct(product).length
            : 0;
          return `
            <button class="item-row add-product-result" type="button" data-product-id="${escapeHtml(product.id)}" style="width:100%; grid-template-columns:1fr auto; text-align:left; border:1px solid #e2e8f0; background:#fff;">
              <div>
                <div class="item-name">${escapeHtml(product.name)}</div>
                <div class="item-sub">${productTracksStock(product) ? `Stock: ${Number(product.stock || 0)} · Disponible sin duplicar: ${variationsCount ? 'elige variación' : Number(getAvailableStockForProductSelection(product, null) || 0)}` : 'Sin stock descontable'} · ${variationsCount ? `${variationsCount} variaciones` : 'Sin variaciones'}</div>
              </div>
              <div class="item-price">${formatUSD(product.base_price_usd)}</div>
            </button>`;
        }).join('');
        addProductResults.classList.remove('hidden');

        addProductResults.querySelectorAll('.add-product-result').forEach((button) => {
          button.addEventListener('click', () => selectAddProduct(button.dataset.productId));
        });
      }

      function selectAddProduct(productId) {
        const product = productCatalog.find((item) => item.id === productId);
        if (!product) return;

        selectedAddProduct = product;
        addProductSelectedId.value = product.id;
        addProductSearch.value = product.name;
        addProductResults.innerHTML = '';
        addProductResults.classList.add('hidden');
        addProductQuantity.value = '1';

        const usesVariations = productUsesVariationMode(product);
        const variations = getSellableVariationsForProduct(product);
        addProductVariationSelect.value = '';
        if (usesVariations && variations.length) {
          addProductVariationWrap.classList.remove('hidden');
          addProductVariationSelect.innerHTML = '<option value="">Selecciona una variación</option>' + variations.map((variation) => `
            <option value="${escapeHtml(variation.id)}">${escapeHtml(getVariationLabel(variation))} · ${productTracksStock(product) ? `Stock: ${Number(variation.stock || 0)}` : 'Sin stock descontable'} · ${formatUSD(getVariationUnitPrice(product, variation))}</option>
          `).join('');
          addProductPriceDisplay.textContent = formatUSD(product.base_price_usd || 0);
          addProductQuantity.removeAttribute('max');
          addProductPreview.textContent = `Producto seleccionado: ${product.name}. Selecciona una variación para cargar precio y stock.`;
        } else if (usesVariations) {
          addProductVariationWrap.classList.add('hidden');
          addProductVariationSelect.innerHTML = '<option value="">Producto no disponible</option>';
          addProductPriceDisplay.textContent = formatUSD(0);
          addProductQuantity.removeAttribute('max');
          addProductPreview.textContent = 'Producto no disponible: no tiene variaciones activas, vigentes y vendibles.';
        } else {
          addProductVariationWrap.classList.add('hidden');
          addProductVariationSelect.innerHTML = '<option value="">Sin variaciones</option>';
          addProductPriceDisplay.textContent = formatUSD(product.base_price_usd || 0);
          updateAddProductQuantityLimit();
          const availableStock = getAvailableStockForProductSelection(product, null);
          addProductPreview.textContent = productTracksStock(product)
            ? `Producto seleccionado: ${product.name}. Disponible para agregar: ${Number(availableStock || 0)} de ${Number(getStockValue(product) || 0)} en stock.`
            : `Producto seleccionado: ${product.name}. Este producto no descuenta inventario; puedes agregar la cantidad necesaria.`;
        }
      }

      function handleAddVariationChange() {
        if (!selectedAddProduct) return;
        const variation = getSellableVariationsForProduct(selectedAddProduct)
          .find((item) => item.id === addProductVariationSelect.value);
        if (!variation) {
          addProductPriceDisplay.textContent = formatUSD(selectedAddProduct.base_price_usd || 0);
          addProductPreview.textContent = `Producto seleccionado: ${selectedAddProduct.name}. Selecciona una variación para cargar precio y stock.`;
          return;
        }
        addProductPriceDisplay.textContent = formatUSD(getVariationUnitPrice(selectedAddProduct, variation));
        updateAddProductQuantityLimit();
        const availableStock = getAvailableStockForProductSelection(selectedAddProduct, variation);
        addProductPreview.textContent = productTracksStock(selectedAddProduct)
          ? `Variación seleccionada: ${getVariationLabel(variation)}. Disponible para agregar: ${Number(availableStock || 0)} de ${Number(getStockValue(variation) || 0)} en stock.`
          : `Variación seleccionada: ${getVariationLabel(variation)}. Este producto no descuenta inventario; puedes agregar la cantidad necesaria.`;
      }

      function renderStats() {
        statTotal.textContent = String(orders.length);
        statPending.textContent = String(orders.filter((order) => normalizeStatus(order.status) === 'pending').length);
        statConfirmed.textContent = String(orders.filter((order) => normalizeStatus(order.status) === 'confirmed').length);
        statCancelled.textContent = String(orders.filter((order) => normalizeStatus(order.status) === 'cancelled').length);
        statDelivered.textContent = String(orders.filter((order) => normalizeStatus(order.status) === 'delivered').length);
        updateCleanupSelectionUI();
      }

      function getShippingZoneLabel(order) {
        const zone = order.expand?.shipping_zone;
        if (!zone) return '';
        const zoneName = [zone.municipality, zone.zone].filter(Boolean).join(' / ');
        return zoneName ? `${zoneName} - ${formatUSD(zone.price_usd || order.shipping || 0)}` : '';
      }

      function getFilteredOrders() {
        const search = searchInput.value.trim().toLowerCase();
        const status = statusFilter.value;
        const delivery = deliveryFilter.value;
        return orders.filter((order) => {
          const matchesStatus = status === 'all' || normalizeStatus(order.status) === status;
          const matchesDelivery = delivery === 'all' || order.delivery_method === delivery;
          const contactSearch = CAN_CONTACT_ORDER_CUSTOMERS ? [order.customer_phone, order.customer_address] : [];
          const haystack = [order.order_number, order.customer_name, ...contactSearch, getShippingZoneLabel(order)].join(' ').toLowerCase();
          const matchesSearch = !search || haystack.includes(search);
          return matchesStatus && matchesDelivery && matchesSearch;
        });
      }

      function getOrderAccent(status) {
        const normalized = normalizeStatus(status);
        if (normalized === 'confirmed') return 'linear-gradient(180deg,#22c55e,#16a34a)';
        if (normalized === 'delivered') return 'linear-gradient(180deg,#3b82f6,#2563eb)';
        if (normalized === 'cancelled') return 'linear-gradient(180deg,#ef4444,#dc2626)';
        return 'linear-gradient(180deg,#f59e0b,#f97316)';
      }

      function renderOrders() {
        const filteredOrders = getFilteredOrders();
        const totalPages = Math.max(1, Math.ceil(filteredOrders.length / ORDERS_PER_PAGE));
        if (currentOrdersPage > totalPages) currentOrdersPage = totalPages;
        if (currentOrdersPage < 1) currentOrdersPage = 1;

        if (!filteredOrders.length) {
          ordersList.innerHTML = '<div class="empty-state">No hay pedidos con esos filtros.</div>';
          if (ordersPagination) {
            ordersPagination.classList.add('hidden');
            ordersPagination.innerHTML = '';
          }
          updateCleanupSelectionUI();
          return;
        }

        const startIndex = (currentOrdersPage - 1) * ORDERS_PER_PAGE;
        const pageOrders = filteredOrders.slice(startIndex, startIndex + ORDERS_PER_PAGE);
        const headerMarkup = `
          <div class="orders-table-head" aria-hidden="true">
            <span>Pedido</span>
            <span>Cliente</span>
            <span>Fecha</span>
            <span>Total</span>
            <span>Entrega</span>
            <span>Estado</span>
            <span>Acciones</span>
          </div>`;
        const rowsMarkup = pageOrders.map((order) => {
          const isActive = selectedOrder?.id === order.id;
          const checked = cleanupSelectedOrderIds.has(order.id) ? 'checked' : '';
          const deliveryMethod = String(order.delivery_method || '').trim();
          const deliveryClass = ['delivery', 'pickup', 'coordinate'].includes(deliveryMethod) ? deliveryMethod : 'coordinate';
          const statusClass = normalizeStatus(order.status);
          const itemsSummary = getOrderItemsSummary(order);
          const deleteIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10l-.8 13H7.8L7 7Zm2-3h6l1 2h4v2H4V6h4l1-2Zm1 7h2v6h-2v-6Zm4 0h2v6h-2v-6Z"/></svg>';
          const rowMarkup = `
            <article class="order-table-row ${isActive ? 'active' : ''}" data-order-id="${escapeHtml(order.id)}">
              <div class="order-cell order-main">
                <span class="order-number">${escapeHtml(order.order_number || '')}</span>
                ${itemsSummary ? `<span class="order-items-summary">${escapeHtml(itemsSummary)}</span>` : '<span class="order-items-summary">Sin resumen de productos</span>'}
                <span class="pz-last-modification" data-pz-last-modification data-resource-type="order" data-resource-id="${escapeHtml(order.id)}" data-useful-empty="true"><span class="pz-last-modification__skeleton">Cargando última modificación…</span></span>
              </div>
              <div class="order-cell order-customer">
                <span class="order-customer-name">${escapeHtml(order.customer_name || 'Cliente sin nombre')}</span>
                ${CAN_CONTACT_ORDER_CUSTOMERS ? `<span class="order-subtext">${escapeHtml(order.customer_phone || 'Sin telefono')}</span>` : ''}
              </div>
              <div class="order-cell order-date-cell">${formatDateOnly(order.created)}</div>
              <div class="order-cell center order-total-cell"><span class="order-total-simple">${getOrderFinalTotal(order)}</span></div>
              <div class="order-cell center order-delivery-cell"><span class="order-chip ${deliveryClass}">${escapeHtml(deliveryLabels[deliveryMethod] || deliveryMethod || 'Coordinar')}</span></div>
              <div class="order-cell center order-status-cell"><span class="order-status-chip status-${escapeHtml(statusClass)}">${escapeHtml(getStatusLabel(order.status))}</span></div>
              <div class="order-row-actions">
                <button class="order-open-btn js-open-order" type="button" data-order-open="${escapeHtml(order.id)}">Abrir</button>
                ${CAN_CANCEL_DELETE_ORDERS ? `<button class="order-delete-btn js-delete-order" type="button" data-order-delete="${escapeHtml(order.id)}" aria-label="Borrar pedido">${deleteIcon}</button>` : ''}
              </div>
            </article>`;

          if (!cleanupSelectionMode) return rowMarkup;
          return `
            <div class="order-select-row">
              <input class="cleanup-order-checkbox order-select-box" type="checkbox" value="${escapeHtml(order.id)}" ${checked} aria-label="Seleccionar orden ${escapeHtml(order.order_number || '')}" />
              ${rowMarkup}
            </div>`;
        }).join('');

        ordersList.innerHTML = `${headerMarkup}${rowsMarkup}`;
        renderOrdersPagination(filteredOrders.length, totalPages, startIndex, pageOrders.length);

        document.querySelectorAll('[data-order-id]').forEach((row) => {
          row.addEventListener('click', () => {
            const orderId = row.dataset.orderId;
            if (cleanupSelectionMode) {
              const selectRow = row.closest('.order-select-row');
              const checkbox = selectRow?.querySelector('.cleanup-order-checkbox');
              if (checkbox) {
                checkbox.checked = !checkbox.checked;
                toggleCleanupOrderSelection(checkbox.value, checkbox.checked);
              }
              return;
            }
            if (!orderId) return;
            window.location.assign(getOrderDetailPath(orderId));
          });
        });

        document.querySelectorAll('.js-open-order').forEach((button) => {
          button.addEventListener('click', (event) => {
            event.stopPropagation();
            const orderId = button.dataset.orderOpen;
            if (!orderId || cleanupSelectionMode) return;
            window.location.assign(getOrderDetailPath(orderId));
          });
        });

        document.querySelectorAll('.js-delete-order').forEach((button) => {
          button.addEventListener('click', (event) => {
            event.stopPropagation();
            requestDeleteOrderFromList(button.dataset.orderDelete);
          });
        });

        document.querySelectorAll('.cleanup-order-checkbox').forEach((checkbox) => {
          checkbox.addEventListener('click', (event) => event.stopPropagation());
          checkbox.addEventListener('change', () => toggleCleanupOrderSelection(checkbox.value, checkbox.checked));
        });
        updateCleanupSelectionUI();
      }

      function renderOrdersPagination(totalOrders, totalPages, startIndex, pageCount) {
        if (!ordersPagination) return;
        if (!totalOrders) {
          ordersPagination.classList.add('hidden');
          ordersPagination.innerHTML = '';
          return;
        }

        ordersPagination.classList.remove('hidden');
        const from = startIndex + 1;
        const to = startIndex + pageCount;
        const totalLabel = totalOrders === 1 ? '1 pedido' : `${totalOrders} pedidos`;
        const windowSize = 5;
        const firstPage = Math.max(1, Math.min(currentOrdersPage - 2, totalPages - windowSize + 1));
        const lastPage = Math.min(totalPages, firstPage + windowSize - 1);
        const pageButtons = Array.from({ length: lastPage - firstPage + 1 }, (_, index) => {
          const page = firstPage + index;
          return `<button class="page-btn ${page === currentOrdersPage ? 'active' : ''}" type="button" data-orders-page="${page}">${page}</button>`;
        }).join('');

        ordersPagination.innerHTML = `
          <div class="pagination-info">Mostrando ${from}&ndash;${to} de ${totalLabel} · 10 por página</div>
          <div class="pagination-actions">
            <button class="page-btn" type="button" data-orders-page="prev" ${currentOrdersPage === 1 ? 'disabled' : ''}>Anterior</button>
            ${pageButtons}
            <button class="page-btn" type="button" data-orders-page="next" ${currentOrdersPage === totalPages ? 'disabled' : ''}>Siguiente</button>
          </div>`;

        ordersPagination.querySelectorAll('[data-orders-page]').forEach((button) => {
          button.addEventListener('click', () => {
            const target = button.dataset.ordersPage;
            if (target === 'prev') currentOrdersPage -= 1;
            else if (target === 'next') currentOrdersPage += 1;
            else currentOrdersPage = Number(target || 1);
            renderOrders();
          });
        });
      }

      function clearDetail() {
        selectedOrder = null;
        selectedItems = [];
        orderDetailEmpty.classList.remove('hidden');
        orderDetail.classList.add('hidden');
        floatingDeleteOrderBtn?.classList.add('hidden');
        detailActionsArea?.classList.add('hidden');
        renderDetailCoupon(null);
        updateReviewRequestButtonState();
        setAddProductPanel(false);
        setEditOrderPanel(false);
        renderOrders();
      }

      async function selectOrder(orderId) {
        selectedOrder = orders.find((order) => order.id === orderId) || null;
        selectedItems = [];
        renderOrders();
        if (!selectedOrder) return;
        orderDetailEmpty.classList.add('hidden');
        orderDetail.classList.remove('hidden');
        detailActionsArea?.classList.remove('hidden');
        setDetailAlert('Cargando productos de la orden...', 'info');
        fillDetail(selectedOrder);
        detailItems.innerHTML = '<div class="item-row"><div class="item-sub">Cargando productos...</div></div>';
        try {
          const filter = encodeURIComponent(`order = "${selectedOrder.id}"`);
          const result = await apiRequest(`/api/collections/order_items/records?filter=${filter}&sort=created&expand=product,variation,gift&perPage=100`);
          selectedItems = result.items || [];
          orderItemsByOrder[selectedOrder.id] = selectedItems;
          renderItems();
          if (selectedOrder) detailTotal.innerHTML = renderOrderAdminSummary(selectedOrder, selectedItems);
          setDetailAlert('', 'info');
        } catch (error) {
          detailItems.innerHTML = '<div class="item-row"><div class="item-sub">No se pudieron cargar los productos.</div></div>';
          setDetailAlert('No se pudieron cargar los productos de la orden.', 'error');
        }
      }

      function fillDetail(order) {
        const isDeliveryOrder = order.delivery_method === 'delivery';
        const deliveryText = [deliveryLabels[order.delivery_method] || order.delivery_method || 'Sin forma', isDeliveryOrder ? getShippingZoneLabel(order) : ''].filter(Boolean).join(' · ');
        const orderId = String(order?.id || '').trim();
        if (orderHistoryLink) {
          const params = /^[a-z0-9]{15}$/.test(orderId)
            ? new URLSearchParams({ tab: 'activity', resource_type: 'order', resource_id: orderId })
            : new URLSearchParams({ tab: 'activity' });
          orderHistoryLink.setAttribute('href', `${ADMIN_TEAM_ACTIVITY_PATH}?${params.toString()}`);
        }
        detailOrderNumber.textContent = order.order_number;
        detailCreated.textContent = formatDate(order.created);
        detailStatusBadge.className = getStatusClass(order.status);
        detailStatusBadge.textContent = getStatusLabel(order.status);
        detailCustomer.textContent = order.customer_name || 'Sin nombre';
        detailPhone.textContent = CAN_CONTACT_ORDER_CUSTOMERS ? (order.customer_phone || 'Sin teléfono') : '';
        detailDelivery.textContent = deliveryText;
        detailTotal.innerHTML = renderOrderAdminSummary(order, selectedItems);
        renderDetailCoupon(order);
        if (detailAddressBox) detailAddressBox.classList.toggle('hidden', !CAN_CONTACT_ORDER_CUSTOMERS || !isDeliveryOrder);
        detailAddress.textContent = CAN_CONTACT_ORDER_CUSTOMERS && isDeliveryOrder
          ? (order.customer_address || 'Sin dirección / no aplica')
          : '';
        detailStatus.value = normalizeStatus(order.status);
        detailNotes.value = order.notes || '';
        editCustomerName.value = order.customer_name || '';
        editCustomerPhone.value = CAN_CONTACT_ORDER_CUSTOMERS ? (order.customer_phone || '') : '';
        editCustomerAddress.value = CAN_CONTACT_ORDER_CUSTOMERS ? (order.customer_address || '') : '';
        editDeliveryMethod.value = order.delivery_method || 'delivery';

        const currentZone = order.expand?.shipping_zone || getShippingZoneById(order.shipping_zone);
        const currentMunicipality = currentZone?.municipality || '';
        renderShippingMunicipalities(currentMunicipality);
        renderShippingZoneOptions(order.shipping_zone || currentZone?.id || '');
        updateDeliveryEditorVisibility();

        setEditOrderPanel(false);
        updateStatusControlsState();
        updateProductEditorLockState();
        updateCustomerEditorLockState();
        updateWhatsAppButtonState();
      }

      function setAddProductPanel(open) {
        if (!addProductPanel || !toggleAddProductBtn) return;
        if (!CAN_MANAGE_ORDER_ITEMS) return;
        const locked = isProductEditingLocked();
        if (locked) {
          addProductPanel.classList.add('hidden');
          toggleAddProductBtn.disabled = true;
          toggleAddProductBtn.textContent = 'Edición bloqueada';
          return;
        }
        addProductPanel.classList.toggle('hidden', !open);
        toggleAddProductBtn.disabled = false;
        toggleAddProductBtn.textContent = open ? 'Cerrar agregar producto' : '+ Agregar producto';
        if (!open) resetAddProductForm();
      }

      function setEditOrderPanel(open) {
        if (!editOrderPanel || !toggleEditOrderBtn) return;
        if (!CAN_CONTACT_ORDER_CUSTOMERS && !CAN_MANAGE_ORDER_SHIPPING) return;
        const locked = isOrderEditingLocked();
        if (locked) {
          editOrderPanel.classList.add('hidden');
          toggleEditOrderBtn.disabled = true;
          toggleEditOrderBtn.textContent = 'Datos bloqueados';
          return;
        }
        editOrderPanel.classList.toggle('hidden', !open);
        toggleEditOrderBtn.disabled = false;
        const editOrderLabel = toggleEditOrderBtn?.querySelector('[data-edit-order-label]');
        if (editOrderLabel) editOrderLabel.textContent = open ? 'Cerrar edición' : 'Editar Datos del Cliente';
        else toggleEditOrderBtn.textContent = open ? 'Cerrar edición' : 'Editar Datos del Cliente';
      }

      function parseProductImageOrder(product) {
        const images = Array.isArray(product?.images) ? product.images.filter(Boolean) : [];
        let stored = [];
        try {
          stored = Array.isArray(JSON.parse(product?.image_order || '[]')) ? JSON.parse(product?.image_order || '[]') : [];
        } catch (_) {
          stored = [];
        }
        const ordered = stored.filter((name) => images.includes(name));
        images.forEach((name) => { if (!ordered.includes(name)) ordered.push(name); });
        return ordered;
      }

      function getProductImageUrlFromItem(item) {
        const product = item?.expand?.product || productCatalog.find((entry) => entry.id === item?.product);
        const images = parseProductImageOrder(product);
        const firstImage = images[0];
        if (!product?.id || !firstImage || !POCKETBASE_URL) return '';
        return `${POCKETBASE_URL}/api/files/products/${encodeURIComponent(product.id)}/${encodeURIComponent(firstImage)}?thumb=160x160`;
      }

      function getProductInitial(name = '') {
        const cleanName = String(name || 'P').trim();
        return escapeHtml(cleanName.charAt(0).toUpperCase() || 'P');
      }

      function getStockBadgeClass(stockInfo) {
        const stock = Number(stockInfo?.stock);
        if (!Number.isFinite(stock)) return '';
        if (stock <= 0) return 'danger';
        if (stock <= 3) return 'warning';
        return 'success';
      }

      function updateProductEditorLockState() {
        const locked = !CAN_MANAGE_ORDER_ITEMS || isProductEditingLocked();
        [addProductSearch, addProductVariationSelect, addProductQuantity, addProductBtn].forEach((element) => {
          if (element) element.disabled = locked;
        });
        if (toggleAddProductBtn) {
          toggleAddProductBtn.disabled = locked;
          toggleAddProductBtn.textContent = locked ? 'Edición bloqueada' : (addProductPanel?.classList.contains('hidden') ? '+ Agregar producto' : 'Cerrar agregar producto');
        }
        if (locked && addProductPanel) addProductPanel.classList.add('hidden');
        if (locked && addProductPreview) {
          addProductPreview.textContent = 'Esta orden está cerrada para edición. Para cambiar productos, primero vuelve la orden a Pendiente si aplica.';
        }
      }

      function updateCustomerEditorLockState() {
        const locked = isOrderEditingLocked();
        [editCustomerName, editCustomerPhone, editCustomerAddress, detailNotes].forEach((element) => {
          if (element) element.disabled = locked || !CAN_CONTACT_ORDER_CUSTOMERS;
        });
        [editDeliveryMethod, editShippingMunicipality, editShippingZone].forEach((element) => {
          if (element) element.disabled = locked || !CAN_MANAGE_ORDER_SHIPPING;
        });
        if (toggleEditOrderBtn) {
          toggleEditOrderBtn.disabled = locked || (!CAN_CONTACT_ORDER_CUSTOMERS && !CAN_MANAGE_ORDER_SHIPPING);
          const editOrderLabel = toggleEditOrderBtn.querySelector('[data-edit-order-label]');
          const nextLabel = locked ? 'Datos bloqueados' : (editOrderPanel?.classList.contains('hidden') ? 'Editar Datos del Cliente' : 'Cerrar edición');
          if (editOrderLabel) editOrderLabel.textContent = nextLabel;
          else toggleEditOrderBtn.textContent = nextLabel;
        }
        if (locked && editOrderPanel) editOrderPanel.classList.add('hidden');
      }

      function getReviewRequestDelayHours() {
        const hours = Number(storeSettingsRecord?.review_request_delay_hours);
        return Number.isFinite(hours) && hours >= 0 ? hours : 24;
      }

      function getDeliveredAtDate(order) {
        if (!hasValue(order?.delivered_at)) return null;
        const deliveredAt = new Date(order.delivered_at);
        return Number.isNaN(deliveredAt.getTime()) ? null : deliveredAt;
      }

      function isReviewDelayReady(order) {
        const deliveredAt = getDeliveredAtDate(order);
        if (!deliveredAt) return false;
        const delayMs = getReviewRequestDelayHours() * 60 * 60 * 1000;
        return Date.now() - deliveredAt.getTime() >= delayMs;
      }

      function updateReviewRequestButtonState() {
        if (!requestReviewBtn) return;
        if (!CAN_REQUEST_ORDER_REVIEWS) {
          requestReviewBtn.classList.add('permission-hidden');
          requestReviewBtn.disabled = true;
          return;
        }
        requestReviewBtn.classList.remove('hidden');
        requestReviewBtn.disabled = true;
        requestReviewBtn.textContent = 'Pedir reseña';
        if (!selectedOrder) return;

        const currentStatus = normalizeStatus(selectedOrder.status);
        if (currentStatus !== 'delivered') {
          requestReviewBtn.textContent = 'Pedir reseña';
          return;
        }
        if (hasValue(selectedOrder.review_completed_at)) {
          requestReviewBtn.textContent = 'Reseña recibida';
          return;
        }
        if (hasValue(selectedOrder.review_skipped_at)) {
          requestReviewBtn.textContent = 'Reseña ignorada';
          return;
        }
        if (!getDeliveredAtDate(selectedOrder)) {
          requestReviewBtn.textContent = 'Falta fecha de entrega';
          return;
        }
        if (!hasValue(selectedOrder.review_requested_at) && !isReviewDelayReady(selectedOrder)) {
          requestReviewBtn.textContent = 'Reseña disponible luego';
          return;
        }

        requestReviewBtn.disabled = false;
        requestReviewBtn.textContent = hasValue(selectedOrder.review_requested_at) ? 'Reenviar reseña' : 'Pedir reseña';
      }

      function updateStatusControlsState() {
        if (!selectedOrder || !detailStatus) return;
        const currentStatus = normalizeStatus(selectedOrder.status);
        detailStatus.disabled = !CAN_MANAGE_ORDER_STATUS && !CAN_CANCEL_DELETE_ORDERS;
        ['pending', 'confirmed'].forEach((status) => {
          const option = detailStatus.querySelector(`option[value="${status}"]`);
          if (option) option.disabled = !CAN_MANAGE_ORDER_STATUS;
        });
        const deliveredOption = detailStatus.querySelector('option[value="delivered"]');
        if (deliveredOption) {
          deliveredOption.disabled = !CAN_MANAGE_ORDER_STATUS || !['confirmed', 'delivered'].includes(currentStatus);
        }
        const cancelledOption = detailStatus.querySelector('option[value="cancelled"]');
        if (cancelledOption) cancelledOption.disabled = !CAN_CANCEL_DELETE_ORDERS;
        if (saveOrderBtn) saveOrderBtn.disabled = !CAN_MANAGE_ORDER_STATUS && !CAN_CANCEL_DELETE_ORDERS;
        if (markDeliveredBtn) {
          markDeliveredBtn.disabled = !CAN_MANAGE_ORDER_STATUS || currentStatus !== 'confirmed';
          markDeliveredBtn.textContent = currentStatus === 'delivered' ? 'Orden entregada' : 'Marcar entregada';
        }
        updateReviewRequestButtonState();
        updateCancelledDeleteButtonState();
      }

      function updateCancelledDeleteButtonState() {
        const canDeleteFromSummary = CAN_CANCEL_DELETE_ORDERS && selectedOrder && normalizeStatus(selectedOrder.status) === 'cancelled';
        if (deleteCancelledOrderBtn) deleteCancelledOrderBtn.classList.toggle('hidden', !canDeleteFromSummary);
        if (floatingDeleteOrderBtn) {
          const showFloatingDelete = Boolean(IS_ORDER_DETAIL_PAGE && selectedOrder && !canDeleteFromSummary);
          floatingDeleteOrderBtn.classList.toggle('hidden', !showFloatingDelete);
        }
      }

      function getItemUnitPrice(item) {
        const quantity = Math.max(1, Number(item.quantity || 1));
        return Number(item.unit_price_usd || item.unit_price_selected_currency || (Number(item.line_total_usd || 0) / quantity) || 0);
      }

      function getOrderShippingAmount(order) {
        if (!order || order.delivery_method !== 'delivery') return 0;
        return Number(order.shipping || order.shipping_usd || order.expand?.shipping_zone?.price_usd || 0);
      }


      function getAutomaticUnitPrice(item) {
        const explicit = Number(item?.unit_price_after_automatic_discount_usd);
        if (Number.isFinite(explicit) && (explicit > 0 || Number(item?.line_subtotal_after_automatic_discount_usd) === 0)) return Math.max(0, explicit);
        const quantity = Math.max(1, Number(item?.quantity || 1));
        return Math.max(0, (Number(item?.line_total_usd || 0) - Number(item?.manual_adjustment_total_usd || 0)) / quantity);
      }

      function renderItems() {
        if (!selectedItems.length) {
          detailItems.innerHTML = '<div class="item-row"><div class="item-sub">Esta orden no tiene productos asociados. Puedes agregar uno desde el botón de arriba.</div></div>';
          return;
        }

        const adjustmentAllowed = ['pending', 'confirmed', 'preparing'].includes(normalizeStatus(selectedOrder?.status));
        detailItems.innerHTML = `<div class="order-product-list">${selectedItems.map((item) => {
          const quantity = Math.max(1, Number(item.quantity || 1));
          const isGiftItem = Boolean(item.is_gift);
          const baseUnit = isGiftItem ? 0 : Math.max(0, Number(item.unit_price_original_usd ?? item.unit_price_usd ?? 0));
          const automaticUnit = isGiftItem ? 0 : getAutomaticUnitPrice(item);
          const finalUnit = isGiftItem ? 0 : getItemUnitPrice(item);
          const automaticDiscount = Math.max(0, (baseUnit - automaticUnit) * quantity);
          const manualTotal = Number(item.manual_adjustment_total_usd || ((finalUnit - automaticUnit) * quantity));
          const maxStockValue = getMaxQuantityForExistingItem(item);
          const maxStock = Number.isFinite(maxStockValue) && maxStockValue !== null ? maxStockValue : '';
          const productsLocked = isProductEditingLocked();
          const quantityDisabled = !CAN_MANAGE_ORDER_ITEMS || productsLocked || isGiftItem;
          const imageUrl = isGiftItem ? (item.expand?.gift?.image ? `${POCKETBASE_URL}/api/files/gifts/${item.expand.gift.id}/${Array.isArray(item.expand.gift.image) ? item.expand.gift.image[0] : item.expand.gift.image}` : '') : getProductImageUrlFromItem(item);
          const imageHtml = imageUrl
            ? `<img class="order-product-img" src="${escapeHtml(imageUrl)}" alt="${escapeHtml(item.product_name || 'Producto')}" loading="lazy" style="width:46px!important;height:46px!important;border-radius:13px;object-fit:cover;display:block;" />`
            : `<div class="order-product-placeholder" style="width:46px!important;height:46px!important;border-radius:13px;">${getProductInitial(item.product_name)}</div>`;
          const adjustmentHtml = item.has_manual_price_adjustment
            ? `<div style="display:flex;justify-content:space-between;gap:12px;color:#7c3aed;font-weight:950;"><span>Ajuste especial</span><span>${manualTotal >= 0 ? '+' : '−'}${formatUSD(Math.abs(manualTotal))}</span></div>` : '';

          return `
            <div class="order-product-card clean-order-product-card" data-item-id="${escapeHtml(item.id)}" style="display:grid;grid-template-columns:46px minmax(0,1fr);gap:12px;align-items:start;background:#f8fafc;border:0;box-shadow:none;border-radius:16px;padding:12px;margin-bottom:10px;">
              ${imageHtml}
              <div style="display:flex;flex-direction:column;gap:10px;min-width:0;">
                <div>
                  <div style="font-size:14px;font-weight:1000;color:#0f172a;line-height:1.3;">${escapeHtml(item.product_name || 'Producto')}</div>
                  ${isGiftItem ? '<span class="product-pill success">🎁 Regalo</span>' : getItemVariationDisplay(item) ? `<span class="product-pill" style="margin-top:6px;">Variación: ${escapeHtml(getItemVariationDisplay(item))}</span>` : ''}
                </div>
                ${!isGiftItem ? `<div class="item-economic-breakdown" style="display:grid;gap:5px;padding:10px 12px;border-radius:14px;background:#fff;border:1px solid #e2e8f0;font-size:12px;color:#475569;">
                  <div style="display:flex;justify-content:space-between;gap:12px;"><span>Precio base · ${quantity}</span><strong>${formatUSD(baseUnit * quantity)}</strong></div>
                  ${automaticDiscount > .000001 ? `<div style="display:flex;justify-content:space-between;gap:12px;color:#166534;font-weight:900;"><span>Promoción/cupón</span><span>−${formatUSD(automaticDiscount)}</span></div>` : ''}
                  ${adjustmentHtml}
                  <div style="display:flex;justify-content:space-between;gap:12px;padding-top:6px;border-top:1px solid #e2e8f0;color:#0f172a;font-weight:1000;"><span>Final · ${formatUSD(finalUnit)} c/u</span><span class="item-live-total">${formatUSD(finalUnit * quantity)}</span></div>
                </div>` : ''}
                <div style="display:flex;flex-wrap:wrap;align-items:end;gap:10px;">
                  <div style="display:flex;flex-direction:column;gap:5px;min-width:150px;flex:1 1 170px;">
                    <label style="font-size:11px;font-weight:900;color:#64748b;margin:0;">Cantidad</label>
                    <div style="display:grid;grid-template-columns:38px minmax(0,1fr) 38px;gap:8px;align-items:center;">
                      <button class="item-qty-minus" type="button" ${quantityDisabled ? 'disabled' : ''} style="height:38px;border:0;border-radius:12px;background:#e2e8f0;font-size:18px;font-weight:1000;">−</button>
                      <input class="edit-item-quantity" type="number" min="1" ${maxStock ? `max="${maxStock}"` : ''} step="1" value="${quantity}" data-max-stock="${maxStock}" ${quantityDisabled ? 'disabled' : ''} style="width:100%;height:38px;border:0;border-radius:12px;background:#fff;text-align:center;font-weight:900;box-shadow:inset 0 0 0 1px #e2e8f0;" />
                      <button class="item-qty-plus" type="button" ${quantityDisabled ? 'disabled' : ''} style="height:38px;border:0;border-radius:12px;background:#dcfce7;color:#166534;font-size:18px;font-weight:1000;">+</button>
                    </div>
                  </div>
                  ${CAN_ADJUST_ORDER_PRICE && !isGiftItem ? `<button class="btn btn-secondary adjust-price-btn" type="button" data-item-id="${escapeHtml(item.id)}" ${adjustmentAllowed ? '' : 'disabled'}>${item.has_manual_price_adjustment ? 'Editar ajuste' : 'Ajustar precio'}</button>` : ''}
                  ${CAN_MANAGE_ORDER_ITEMS ? `<button class="btn btn-danger delete-item-btn" type="button" data-item-id="${escapeHtml(item.id)}" ${productsLocked ? 'disabled' : ''}>Borrar</button>` : ''}
                </div>
                <span class="item-save-status" style="font-size:11px;color:#64748b;font-weight:850;">${productsLocked ? 'Cantidad y borrado bloqueados por inventario.' : 'El precio canónico es de solo lectura.'}</span>
              </div>
            </div>`;
        }).join('')}</div>`;

        detailItems.querySelectorAll('.delete-item-btn').forEach((button) => button.addEventListener('click', () => deleteOrderItem(button.dataset.itemId)));
        detailItems.querySelectorAll('.adjust-price-btn').forEach((button) => button.addEventListener('click', () => openPriceAdjustment(button.dataset.itemId)));
        bindQuantityButtons();
        bindItemAutoSave();
      }

      async function reloadSelectedItems() {
        if (!selectedOrder) return;
        const filter = encodeURIComponent(`order = "${selectedOrder.id}"`);
        const result = await apiRequest(`/api/collections/order_items/records?filter=${filter}&sort=created&expand=product,variation,gift&perPage=100`);
        selectedItems = result.items || [];
        if (selectedOrder?.id) orderItemsByOrder[selectedOrder.id] = selectedItems;
        renderItems();
        renderOrders();
      }

      async function applyPrivateOrderMutation(result) {
        if (result?.order?.id) {
          selectedOrder = { ...selectedOrder, ...result.order };
          orders = orders.map((order) => order.id === selectedOrder.id ? { ...order, ...selectedOrder } : order);
        }
        await reloadSelectedItems();
        if (selectedOrder) fillDetail(selectedOrder);
        renderStats();
        renderOrders();
      }

      function bindQuantityButtons() {
        detailItems.querySelectorAll('.item-qty-minus, .item-qty-plus').forEach((button) => {
          button.addEventListener('click', () => {
            if (isProductEditingLocked()) return;

            const row = button.closest('.order-product-card');
            if (!row) return;

            const quantityInput = row.querySelector('.edit-item-quantity');
            if (!quantityInput) return;

            const currentValue = Math.max(1, Number(quantityInput.value || 1));
            const maxStock = quantityInput.dataset.maxStock ? Number(quantityInput.dataset.maxStock) : null;
            let nextValue = currentValue;

            if (button.classList.contains('item-qty-minus')) {
              nextValue = Math.max(1, currentValue - 1);
            }

            if (button.classList.contains('item-qty-plus')) {
              nextValue = Number.isFinite(maxStock) && maxStock > 0
                ? Math.min(maxStock, currentValue + 1)
                : currentValue + 1;
            }

            if (nextValue === currentValue) return;

            quantityInput.value = String(nextValue);
            quantityInput.dispatchEvent(new Event('input', { bubbles: true }));
            quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
      }

      function bindItemAutoSave() {
        detailItems.querySelectorAll('[data-item-id]').forEach((row) => {
          const itemId = row.dataset.itemId;
          row.querySelectorAll('.edit-item-quantity').forEach((input) => {
            input.addEventListener('input', () => {
              const status = row.querySelector('.item-save-status');
              if (status) status.textContent = 'Guardando cantidad...';
              clearTimeout(itemSaveTimers.get(itemId));
              itemSaveTimers.set(itemId, setTimeout(() => saveSingleOrderItem(itemId), 650));
            });
            input.addEventListener('change', () => {
              clearTimeout(itemSaveTimers.get(itemId));
              saveSingleOrderItem(itemId);
            });
          });
        });
      }

      async function saveSingleOrderItem(itemId) {
        if (!CAN_MANAGE_ORDER_ITEMS || !selectedOrder || !itemId) return;
        if (isProductEditingLocked()) {
          setDetailAlert('Esta orden ya descontó inventario. La edición de productos está bloqueada por seguridad.', 'error');
          return;
        }
        const row = detailItems.querySelector(`[data-item-id="${itemId}"]`);
        const item = selectedItems.find((entry) => entry.id === itemId);
        if (!row || !item) return;

        const status = row.querySelector('.item-save-status');
        try {
          const quantityInput = row.querySelector('.edit-item-quantity');
          const maxStock = quantityInput?.dataset.maxStock ? Number(quantityInput.dataset.maxStock) : null;
          const quantity = clampQuantityToStock(quantityInput, maxStock, status);
          if (Number.isFinite(maxStock) && maxStock !== null && maxStock <= 0) {
            if (status) status.textContent = 'No se guardó: sin stock disponible.';
            setDetailAlert('No puedes guardar una cantidad mayor al stock disponible.', 'error');
            return;
          }
          const result = await apiRequest(`/api/pz/admin/orders/${selectedOrder.id}/items/${itemId}/quantity`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quantity }),
          });
          await applyPrivateOrderMutation(result);
          setDetailAlert('Cantidad actualizada conservando el acuerdo económico original.', 'success');
        } catch (error) {
          if (status) status.textContent = 'No se pudo guardar';
          setDetailAlert(error?.message || 'No se pudo actualizar la cantidad.', 'error');
        }
      }

      function setPriceAdjustmentAlert(message = '', type = 'error') {
        if (!priceAdjustmentAlert) return;
        priceAdjustmentAlert.textContent = message;
        priceAdjustmentAlert.className = message ? `alert ${type}` : 'alert hidden';
      }

      function clearPriceAdjustmentFieldErrors() {
        for (const element of [priceAdjustmentReasonError, priceAdjustmentReasonTextError]) {
          if (!element) continue;
          element.textContent = '';
          element.classList.add('hidden');
        }
      }

      function setPriceAdjustmentFieldError(element, message) {
        if (!element) return;
        element.textContent = message;
        element.classList.remove('hidden');
      }

      function validatePriceAdjustmentReason() {
        clearPriceAdjustmentFieldErrors();
        const reasonCode = priceAdjustmentReason.value;
        const reasonText = priceAdjustmentReasonText.value.trim();
        if (!reasonCode) {
          setPriceAdjustmentFieldError(priceAdjustmentReasonError, 'Selecciona un motivo nuevo antes de confirmar.');
          priceAdjustmentReason.focus();
          return null;
        }
        if (reasonText.length > 500 || (reasonCode === 'other' && reasonText.length < 5)) {
          setPriceAdjustmentFieldError(priceAdjustmentReasonTextError, 'Para “Otro”, escribe entre 5 y 500 caracteres.');
          priceAdjustmentReasonText.focus();
          return null;
        }
        return { reasonCode, reasonText };
      }

      function updatePriceAdjustmentStateWarning() {
        const status = normalizeStatus(selectedOrder?.status);
        const message = status === 'confirmed'
          ? 'La orden está confirmada. Este cambio modificará el importe acordado, pero no modificará el inventario.'
          : status === 'preparing'
            ? 'La orden está en preparación. Este cambio modificará el importe acordado, pero no modificará el inventario.'
            : '';
        if (priceAdjustmentStateWarning) {
          priceAdjustmentStateWarning.textContent = message;
          priceAdjustmentStateWarning.classList.toggle('hidden', !message);
        }
      }

      function updatePriceAdjustmentWarning() {
        if (!adjustmentItem) return;
        if (priceAdjustmentMode === 'reset') {
          priceAdjustmentWarning?.classList.add('hidden');
          priceAdjustmentZeroWrap?.classList.add('hidden');
          return;
        }
        const automatic = getAutomaticUnitPrice(adjustmentItem);
        const next = Number(priceAdjustmentFinalPrice?.value);
        const valid = Number.isFinite(next) && next >= 0;
        priceAdjustmentWarning?.classList.toggle('hidden', !valid || Math.abs(next - automatic) < .000001);
        if (priceAdjustmentWarning && valid && Math.abs(next - automatic) >= .000001) {
          priceAdjustmentWarning.textContent = next > automatic
            ? `Estás aumentando el total que deberá pagar el cliente. El precio final subirá ${formatUSD(next - automatic)} por unidad.`
            : `El precio final disminuirá ${formatUSD(automatic - next)} por unidad frente al precio automático.`;
        }
        priceAdjustmentZeroWrap?.classList.toggle('hidden', !valid || next !== 0);
        if (next !== 0 && priceAdjustmentZeroConfirm) priceAdjustmentZeroConfirm.checked = false;
      }

      function openPriceAdjustment(itemId) {
        if (!CAN_ADJUST_ORDER_PRICE) return;
        const item = selectedItems.find((entry) => entry.id === itemId);
        if (!item || item.is_gift || !['pending', 'confirmed', 'preparing'].includes(normalizeStatus(selectedOrder?.status))) return;
        adjustmentItem = item;
        adjustmentPreviousFocus = document.activeElement;
        const automatic = getAutomaticUnitPrice(item);
        const currentFinal = getItemUnitPrice(item);
        priceAdjustmentMode = 'adjust';
        priceAdjustmentProduct.textContent = getItemDisplayName(item);
        priceAdjustmentAutomaticPrice.textContent = formatUSD(automatic);
        priceAdjustmentFinalPrice.value = currentFinal.toFixed(2);
        priceAdjustmentReason.value = '';
        priceAdjustmentReasonText.value = '';
        priceAdjustmentZeroConfirm.checked = false;
        priceAdjustmentTitle.textContent = 'Ajustar precio';
        priceAdjustmentBaseline.classList.remove('hidden');
        priceAdjustmentResetSummary.classList.add('hidden');
        priceAdjustmentFinalWrap.classList.remove('hidden');
        priceAdjustmentReset.classList.toggle('hidden', !item.has_manual_price_adjustment);
        priceAdjustmentSubmit.textContent = 'Guardar ajuste';
        clearPriceAdjustmentFieldErrors();
        setPriceAdjustmentAlert();
        updatePriceAdjustmentStateWarning();
        updatePriceAdjustmentWarning();
        priceAdjustmentModal.classList.remove('hidden');
        priceAdjustmentModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => priceAdjustmentFinalPrice?.focus());
      }

      function closePriceAdjustment() {
        if (!priceAdjustmentModal || priceAdjustmentModal.classList.contains('hidden')) return;
        priceAdjustmentModal.classList.add('hidden');
        priceAdjustmentModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        priceAdjustmentMode = 'adjust';
        adjustmentItem = null;
        if (adjustmentPreviousFocus?.focus) adjustmentPreviousFocus.focus();
        adjustmentPreviousFocus = null;
      }

      function priceAdjustmentFocusables() {
        return Array.from(priceAdjustmentCard?.querySelectorAll('button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])') || [])
          .filter((element) => !element.classList.contains('hidden') && element.offsetParent !== null);
      }

      function handlePriceAdjustmentKeydown(event) {
        if (!priceAdjustmentModal || priceAdjustmentModal.classList.contains('hidden')) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closePriceAdjustment();
          return;
        }
        if (event.key !== 'Tab') return;
        const focusables = priceAdjustmentFocusables();
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }

      async function submitPriceAdjustment() {
        if (!CAN_ADJUST_ORDER_PRICE || !selectedOrder || !adjustmentItem) return;
        if (priceAdjustmentMode === 'reset') {
          await submitPriceAdjustmentReset();
          return;
        }
        const finalUnit = Number(priceAdjustmentFinalPrice.value);
        if (!Number.isFinite(finalUnit) || finalUnit < 0 || finalUnit > 1000000) {
          setPriceAdjustmentAlert('Ingresa un precio entre $0.00 y $1,000,000.00 USD.');
          return;
        }
        const reason = validatePriceAdjustmentReason();
        if (!reason) return;
        if (finalUnit === 0 && !priceAdjustmentZeroConfirm.checked) {
          setPriceAdjustmentAlert('Confirma expresamente el precio cero antes de guardar.');
          priceAdjustmentZeroConfirm.focus();
          return;
        }
        priceAdjustmentSubmit.disabled = true;
        setPriceAdjustmentAlert('Guardando ajuste...', 'info');
