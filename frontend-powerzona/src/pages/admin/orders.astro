      async function saveSelectedOrder(extraPayload = {}) {
        if (!selectedOrder) return;
        const previousStatus = normalizeStatus(selectedOrder.status);
        const nextStatus = normalizeStatus(extraPayload.status || detailStatus.value);
        const canTransition = nextStatus === 'cancelled' ? CAN_CANCEL_DELETE_ORDERS : CAN_MANAGE_ORDER_STATUS;
        if (!canTransition) {
          detailStatus.value = previousStatus;
          setDetailAlert('No tienes permiso para cambiar la orden a ese estado.', 'error');
          return;
        }
        if (nextStatus === 'delivered' && !['confirmed', 'delivered'].includes(previousStatus)) {
          detailStatus.value = previousStatus;
          setDetailAlert('Para marcar una orden como Entregada, primero debe estar Confirmada.', 'error');
          return;
        }
        if (nextStatus === previousStatus) {
          setDetailAlert('La orden ya tiene ese estado.', 'info');
          return;
        }

        saveOrderBtn.disabled = true;
        setDetailAlert(nextStatus === 'cancelled' ? 'Cancelando orden de forma segura...' : 'Actualizando estado e inventario...', 'info');
        try {
          const result = await apiRequest(`/api/pz/admin/orders/${selectedOrder.id}/transition`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: nextStatus }),
          });
          if (result?.order?.id) {
            await applyPrivateOrderMutation(result);
          } else {
            const refreshed = await apiRequest(`/api/collections/orders/records/${selectedOrder.id}?expand=shipping_zone,currency`);
            selectedOrder = refreshed;
            orders = orders.map((order) => order.id === refreshed.id ? refreshed : order);
            await reloadSelectedItems();
            fillDetail(refreshed);
            renderStats();
            renderOrders();
          }
          setDetailAlert(nextStatus === 'cancelled'
            ? 'Orden cancelada correctamente; el inventario fue conciliado por el servidor.'
            : 'Estado e inventario actualizados correctamente.', 'success');
        } catch (error) {
          detailStatus.value = previousStatus;
          setDetailAlert(error?.message || 'No se pudo actualizar el estado de la orden.', 'error');
        } finally {
          saveOrderBtn.disabled = false;
        }
      }

      function buildOrderSummary() {
        if (!selectedOrder) return '';
        const lines = [];
        lines.push(`Hola PowerZona, quiero revisar este pedido:`);
        lines.push('');
        lines.push(`Orden: ${selectedOrder.order_number}`);
        lines.push(`Cliente: ${selectedOrder.customer_name || ''}`);
        if (CAN_CONTACT_ORDER_CUSTOMERS) lines.push(`Teléfono: ${selectedOrder.customer_phone || ''}`);
        lines.push(`Entrega: ${deliveryLabels[selectedOrder.delivery_method] || selectedOrder.delivery_method || ''}`);
        const zoneLabel = selectedOrder.delivery_method === 'delivery' ? getShippingZoneLabel(selectedOrder) : '';
        if (zoneLabel) lines.push(`Zona: ${zoneLabel}`);
        if (CAN_CONTACT_ORDER_CUSTOMERS && selectedOrder.delivery_method === 'delivery' && selectedOrder.customer_address) {
          lines.push(`Dirección: ${selectedOrder.customer_address}`);
        }
        lines.push('');
        lines.push('Productos:');
        if (selectedItems.length) {
          selectedItems.forEach((item, index) => {
            lines.push(`${index + 1}. ${getItemDisplayName(item)}`);
            lines.push(`   Cantidad: ${Number(item.quantity || 0)}`);
            lines.push(`   Precio unitario final: ${formatUSD(getItemUnitPrice(item))}`);
            if (item.has_manual_price_adjustment) lines.push('   Ajuste especial aplicado');
            lines.push(`   Total: ${formatUSD(item.line_total_usd)}`);
          });
        } else {
          lines.push('Sin productos cargados.');
        }
        lines.push('');
        lines.push('Resumen cliente:');
        getOrderVisualSummaryLines(selectedOrder, selectedItems).forEach((line) => lines.push(line));
        const internal = getOrderVisualBreakdown(selectedOrder, selectedItems);
        lines.push(`Interno USD: productos ${formatUSD(internal.subtotalUSD)} + envío ${formatUSD(internal.shippingUSD)} = ${formatUSD(internal.totalInternalUSD)}`);
        lines.push(`Estado: ${getStatusLabel(selectedOrder.status)}`);
        if (selectedOrder.notes) lines.push(`Notas: ${selectedOrder.notes}`);
        return lines.join('\n');
      }

