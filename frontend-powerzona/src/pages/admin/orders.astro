        color: #fff;
      }
      .order-delete-btn {
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #fff;
        color: #dc2626;
        border: 1px solid #fecaca;
        line-height: 1;
      }
      .order-delete-btn:hover {
        background: #fef2f2;
        border-color: #fca5a5;
      }
      .order-delete-btn svg {
        width: 17px;
        height: 17px;
        fill: currentColor;
      }
      .order-select-row {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr);
        align-items: stretch;
        gap: 0;
        border-bottom: 1px solid #edf2f7;
        background: #fff;
      }
      .order-select-box {
        width: 22px !important;
        height: 22px !important;
        padding: 0 !important;
        accent-color: #0f172a;
        align-self: center;
        justify-self: center;
      }
      .order-select-row .order-table-row { border-bottom: 0; }
      .orders-pagination {
        padding: 14px 18px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        background: #fff;
      }
      .pagination-info {
        color: #64748b;
        font-size: 13px;
        font-weight: 900;
      }
      .pagination-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
      }
      .page-btn {
        min-width: 38px;
        min-height: 38px;
        border-radius: 13px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #0f172a;
        font-weight: 1000;
      }
      .page-btn.active {
        background: #0f172a;
        border-color: #0f172a;
        color: #fff;
      }
      .page-btn:disabled { opacity: .45; cursor: not-allowed; }
      .orders-list .empty-state {
        padding: 36px 18px;
        text-align: center;
        color: #64748b;
        font-weight: 800;
      }
      @media (max-width: 900px) {
        .orders-list-head {
          padding: 16px;
          align-items: flex-start;
        }
        .orders-table-head { display: none; }
        .orders-list #orders-list {
          display: grid;
          gap: 8px;
          padding: 10px;
          background: #f8fafc;
        }
        .order-table-row {
          display: grid;
          grid-template-columns: minmax(58px, 0.75fr) minmax(72px, 0.9fr) minmax(76px, 0.95fr) auto auto minmax(88px, auto);
          align-items: center;
          gap: 6px;
          min-height: 48px;
          padding: 8px 8px;
          border: 1px solid #e2e8f0;
          border-radius: 14px;
          background: #ffffff;
          box-shadow: 0 8px 18px rgba(15,23,42,.05);
          overflow: hidden;
        }
        .order-main {
          grid-column: 1;
          min-width: 0;
        }
        .order-number {
          font-size: 11px;
          font-weight: 1000;
          color: #2563eb;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        .order-items-summary,
        .order-customer,
        .order-subtext {
          display: none !important;
        }
        .order-date-cell {
          grid-column: 2;
          font-size: 10px;
          font-weight: 850;
          color: #475569;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        .order-total-cell {
          grid-column: 3;
          display: flex;
          justify-content: flex-start;
          text-align: left;
          min-width: 0;
        }
        .order-total-simple {
          font-size: 11px;
          font-weight: 1000;
          color: #0f172a;
          white-space: nowrap;
        }
        .order-delivery-cell,
        .order-status-cell {
          display: flex;
          justify-content: center;
          min-width: 0;
        }
        .order-chip,
        .order-status-chip {
          min-height: 22px;
          padding: 5px 7px;
          border-radius: 999px;
          font-size: 9px;
          font-weight: 1000;
          white-space: nowrap;
        }
        .order-delivery-cell { grid-column: 4; }
        .order-status-cell { grid-column: 5; }
        .order-cell.center:not(.order-total-cell) {
          justify-content: flex-start;
          text-align: left;
        }
        .order-row-actions {
          grid-column: 6;
          display: flex;
          align-items: center;
          justify-content: flex-end;
          gap: 5px;
          flex-wrap: nowrap;
          min-width: max-content;
          padding-right: 0;
        }
        .order-open-btn {
          min-width: 52px;
          min-height: 30px;
          padding: 7px 9px;
          border-radius: 10px;
          font-size: 10px;
          font-weight: 1000;
        }
        .order-delete-btn {
          width: 30px;
          height: 30px;
          flex: 0 0 30px;
          border-radius: 10px;
        }
        .order-delete-btn svg { width: 14px; height: 14px; }
        .order-select-row {
          grid-template-columns: 34px minmax(0, 1fr);
          align-items: flex-start;
          gap: 8px;
          border-bottom: 0;
          background: transparent;
        }
        .order-select-row .order-select-box { margin-top: 16px !important; }
        .orders-pagination {
          align-items: stretch;
          flex-direction: column;
        }
        .pagination-actions { justify-content: center; }
      }
    </style>
</head>
  <body class="orders-admin-page">
    <div id="sidebar-overlay" class="sidebar-overlay" hidden></div>

    <div class="app-shell pz-admin-content">
      <AdminSidebar storeId={currentStoreId} pocketbaseUrl={pocketbaseUrl} authToken={adminAuthToken} storeSlug={currentStoreSlug} storeName={adminContext.store.name || adminContext.store.title || currentStoreSlug || 'PowerZona'} storePlanValues={adminContext.store} activeSection="orders" mobileTitle="Pedidos" mobileActionLabel="Actualizar" mobileActionTarget="#refresh-btn" />
      <LastModificationMeta
        pocketbaseUrl={pocketbaseUrl}
        enabled={storeAccessContext?.access.is_primary_admin === true}
        showActor={storeAccessContext?.access.is_primary_admin === true}
        controllerOnly={true}
      />

      <main id="admin-view" class="orders-main pz-admin-content-inner">
        <header class="mobile-topbar">
          <button id="sidebar-open" class="icon-btn menu-btn" type="button" aria-controls="pz-admin-sidebar" aria-expanded="false" aria-label="Abrir menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z"/></svg></button>
          <h1 class="mobile-topbar-title">Pedidos</h1>
          <span class="mobile-topbar-slot" aria-hidden="true"></span>
        </header>

          <AdminSectionHeader
            kicker="Pedidos"
            title="Pedidos"
            description="Administra y da seguimiento a los pedidos de tu tienda."
            titleId="orders-page-title"
            descriptionId="admin-subtitle"
            bellId="admin-orders-bell"
          >
            <button id="refresh-btn" class="admin-primary-action admin-header-primary-action" type="button" slot="action">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.7 6.3A8 8 0 1 0 20 12h-2a6 6 0 1 1-1.8-4.2L13 11h8V3l-3.3 3.3Z"/></svg>
              <span>Actualizar</span>
            </button>
          </AdminSectionHeader>

          {isOrderDetailPage && <a class="action-btn detail-back-link" href={adminOrdersPath}>← Volver a pedidos</a>}

          <section class:list={['admin-compact-summary', 'admin-compact-summary--orders', isOrderDetailPage && 'hidden']} aria-label="Resumen de pedidos">
            <div class="admin-compact-summary__head">
              <span class="admin-compact-summary__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M6 3h12a1 1 0 0 1 1 1v17l-3-2-2 2-2-2-2 2-2-2-3 2V4a1 1 0 0 1 1-1Z"></path>
                  <path d="M9 8h6"></path>
                  <path d="M9 12h6"></path>
                  <path d="M9 16h4"></path>
                </svg>
              </span>
              <div>
                <p class="admin-compact-summary__eyebrow">Resumen</p>
                <h2 class="admin-compact-summary__title">Pedidos</h2>
                <p class="admin-compact-summary__subtitle">Estado actual de las &oacute;rdenes de la tienda.</p>
              </div>
            </div>

            <div class="admin-compact-summary__list">
              <article class="admin-compact-summary__item">
                <p class="admin-compact-summary__label">Total</p>
                <p id="stat-total" class="admin-compact-summary__value">0</p>
              </article>
              <article class="admin-compact-summary__item is-warn">
                <p class="admin-compact-summary__label">Pendientes</p>
                <p id="stat-pending" class="admin-compact-summary__value">0</p>
              </article>
              <article class="admin-compact-summary__item is-ok">
                <p class="admin-compact-summary__label">Confirmadas</p>
                <p id="stat-confirmed" class="admin-compact-summary__value">0</p>
              </article>
              <article class="admin-compact-summary__item is-muted">
                <p class="admin-compact-summary__label">Canceladas</p>
                <p id="stat-cancelled" class="admin-compact-summary__value">0</p>
              </article>
              <article class="admin-compact-summary__item is-purple">
                <p class="admin-compact-summary__label">Entregadas</p>
                <p id="stat-delivered" class="admin-compact-summary__value">0</p>
              </article>
            </div>
          </section>

          <div class:list={['card toolbar', isOrderDetailPage && 'hidden']}>
            <input id="search-input" type="search" placeholder="Buscar por orden, cliente, teléfono o dirección..." />
            <select id="status-filter">
              <option value="all">Todos los estados</option>
              <option value="pending">Pendiente</option>
              <option value="confirmed">Confirmada</option>
              <option value="delivered">Entregada</option>
              <option value="cancelled">Cancelada</option>
            </select>
            <select id="delivery-filter">
              <option value="all">Todas las entregas</option>
              <option value="delivery">Envío</option>
              <option value="pickup">Recogida</option>
              <option value="coordinate">Coordinar</option>
            </select>
          </div>

          <section id="cleanup-orders-panel" class:list={['card cleanup-selection-bar hidden', !canCancelDeleteOrders && 'permission-hidden']} hidden>
            <div class="cleanup-selection-copy">
              <h2 class="cleanup-selection-title">Modo borrar órdenes</h2>
              <p class="cleanup-selection-warning">Esta acción elimina la orden y concilia el inventario de forma segura.<br />Úsalo solo para limpieza administrativa o después de exportar tus órdenes.</p>
            </div>
            <span id="cleanup-selected-count" class="cleanup-selection-count">0 seleccionadas</span>
            <div class="cleanup-selection-actions">
              <button id="cleanup-select-all-btn" class="btn btn-secondary" type="button">Seleccionar todas</button>
              <button id="cleanup-delete-selected-btn" class="btn btn-danger" type="button">Borrar seleccionadas</button>
              <button id="cleanup-orders-close-btn" class="btn btn-secondary" type="button">Cancelar</button>
            </div>
          </section>

          <div id="orders-admin-alert" class="alert orders-admin-alert hidden"></div>

          <div class:list={['admin-grid', isOrderDetailPage && 'detail-page']}>
            <section class:list={['card orders-list', isOrderDetailPage && 'hidden']}>
              <div class="orders-list-head">
                <div>
                  <h2>Listado de pedidos</h2>
                  <p>Visualiza y gestiona todos los pedidos de tu tienda.</p>
                </div>
                <button id="orders-list-refresh-btn" class="btn btn-secondary" type="button">Actualizar</button>
              </div>
              <div id="orders-list"></div>
              <div id="orders-pagination" class="orders-pagination hidden"></div>
            </section>
            <aside class="card detail-panel">
              <div id="order-detail-empty" class="empty-state">Selecciona una orden para ver el detalle, actualizar datos y ejecutar acciones administrativas.</div>
              <div id="order-detail" class="hidden">
                <div class="detail-title">
                  <div><h2 id="detail-order-number"></h2><p id="detail-created" class="page-subtitle"></p></div>
                  <div class="detail-title-actions"><a id="order-history-link" class="btn btn-secondary" href={adminOrderHistoryPath}>Ver historial</a><span id="detail-status-badge" class="badge"></span><button id="close-detail-btn" class="close-detail-btn" type="button" title="Cerrar resumen">×</button></div>
                </div>

                <div class="info-grid">
                  <div class="info-box"><div class="info-label">Cliente</div><div id="detail-customer" class="info-value"></div></div>
                  <div class:list={['info-box', !canContactOrderCustomers && 'permission-hidden']}><div class="info-label">Teléfono</div><div id="detail-phone" class="info-value"></div></div>
                  <div class="info-box"><div class="info-label">Entrega</div><div id="detail-delivery" class="info-value"></div></div>
                  <div class="info-box"><div class="info-label">Resumen cliente</div><div id="detail-total" class="info-value"></div></div>
                  <div id="detail-address-box" class:list={['info-box', !canContactOrderCustomers && 'permission-hidden']} style="grid-column: 1 / -1;"><div class="info-label">Dirección</div><div id="detail-address" class="info-value"></div></div>
                </div>

                <div class:list={['status-always-visible', !(canManageOrderStatus || canCancelDeleteOrders) && 'permission-hidden']}>
                  <div>
                    <label for="detail-status">Estado de la orden</label>
                    <select id="detail-status" disabled={!(canManageOrderStatus || canCancelDeleteOrders)}>
                      <option value="pending" disabled={!canManageOrderStatus}>Pendiente</option>
                      <option value="confirmed" disabled={!canManageOrderStatus}>Confirmada</option>
                      <option value="delivered" disabled={!canManageOrderStatus}>Entregada</option>
                      <option value="cancelled" disabled={!canCancelDeleteOrders}>Cancelada</option>
                    </select>
                  </div>
                  <button id="save-order-btn" class="btn btn-primary" type="button" disabled={!(canManageOrderStatus || canCancelDeleteOrders)}>Guardar cambios</button>
                </div>

                <div class:list={['add-product-header', !canManageOrderItems && 'permission-hidden']}>
                  <h3 class="section-title">Agregar producto a la orden</h3>
                  <button id="toggle-add-product-btn" class="btn btn-secondary" type="button">+ Agregar producto</button>
                </div>
                <div id="add-product-panel" class:list={['add-product-panel hidden', !canManageOrderItems && 'permission-hidden']}>
                  <div class="form-grid">
                    <div>
                      <label for="add-product-search">Buscar producto del catálogo</label>
                      <input id="add-product-search" type="search" placeholder="Escribe el nombre del producto..." autocomplete="off" />
                      <input id="add-product-selected-id" type="hidden" />
                      <div id="add-product-results" class="items-box hidden" style="margin-top:8px; padding:8px !important;"></div>
                      <div id="add-product-preview" class="item-sub" style="margin-top:8px;">Selecciona un producto para cargar precio, stock y variaciones.</div>
                    </div>
                    <div id="add-product-variation-wrap" class="hidden">
                      <label for="add-product-variation-select">Variación</label>
                      <select id="add-product-variation-select"><option value="">Selecciona una variación</option></select>
                    </div>
                    <div class="form-grid two">
                      <div><label for="add-product-quantity">Cantidad</label><input id="add-product-quantity" type="number" min="1" step="1" value="1" /></div>
                      <div><label>Precio canónico vigente</label><div id="add-product-price-display" class="canonical-price-display">$0.00 USD</div></div>
                    </div>
                    <div class="add-product-actions">
                      <button id="add-product-btn" class="btn btn-primary" type="button" style="width:100%;">Agregar a la orden</button>
                      <button id="close-add-product-btn" class="btn btn-secondary" type="button">Cerrar</button>
                    </div>
                  </div>
                </div>

                <div class="order-products-summary-box">
                  <div class="summary-box-header">
                    <span class="summary-box-icon">🛒</span>
                    <h3 class="section-title">Productos de la orden</h3>
                  </div>
                  <div id="detail-items" class="order-products-clean-list"></div>
                </div>

                <div id="detail-coupon" class="hidden"></div>

                <div class:list={['edit-order-header', !(canContactOrderCustomers || canManageOrderShipping) && 'permission-hidden']}>
                  <h3 class="section-title">Editar Datos del Cliente</h3>
                  <button id="toggle-edit-order-btn" class="btn btn-secondary pz-admin-action-btn" type="button">
                    <AdminIcon name="edit" class="pz-admin-action-icon" />
                    <span data-edit-order-label>Editar Datos del Cliente</span>
                  </button>
                </div>
                <div id="edit-order-panel" class:list={['edit-order-panel hidden', !(canContactOrderCustomers || canManageOrderShipping) && 'permission-hidden']}>
                  <div class="form-grid two">
                    <div class:list={[!canContactOrderCustomers && 'permission-hidden']}><label for="edit-customer-name">Cliente</label><input id="edit-customer-name" type="text" disabled={!canContactOrderCustomers} /></div>
                    <div class:list={[!canContactOrderCustomers && 'permission-hidden']}><label for="edit-customer-phone">Teléfono</label><input id="edit-customer-phone" type="text" disabled={!canContactOrderCustomers} /></div>
                    <div class:list={[!canManageOrderShipping && 'permission-hidden']}><label for="edit-delivery-method">Forma de entrega</label><select id="edit-delivery-method" disabled={!canManageOrderShipping}><option value="delivery">Envío</option><option value="pickup">Recogida</option><option value="coordinate">Coordinar</option></select></div>
                    <div id="edit-customer-address-wrap" class:list={[!canContactOrderCustomers && 'permission-hidden']}><label for="edit-customer-address">Dirección / referencia</label><textarea id="edit-customer-address" placeholder="Dirección del cliente, referencia o instrucciones de entrega..." disabled={!canContactOrderCustomers}></textarea></div>
                    <div id="edit-shipping-municipality-wrap" class:list={[!canManageOrderShipping && 'permission-hidden']}><label for="edit-shipping-municipality">Municipio</label><select id="edit-shipping-municipality" disabled={!canManageOrderShipping}><option value="">Selecciona municipio</option></select></div>
                    <div id="edit-shipping-zone-wrap" class:list={[!canManageOrderShipping && 'permission-hidden']}><label for="edit-shipping-zone">Zona de entrega</label><select id="edit-shipping-zone" disabled={!canManageOrderShipping}><option value="">Selecciona zona</option></select></div>
                    <div id="edit-shipping-cost-wrap" class:list={[!(canManageOrderShipping && canAdjustOrderPrice) && 'permission-hidden']}><label for="edit-shipping-cost">Costo de envío</label><input id="edit-shipping-cost" type="text" value="$0.00 USD" readonly /></div>
                  </div>
                  <div class="form-grid" style="margin-top:14px;">
                    <div class:list={[!canContactOrderCustomers && 'permission-hidden']}><label for="detail-notes">Observaciones del pedido</label><textarea id="detail-notes" placeholder="Ej: confirmado por WhatsApp, pendiente pago, entregar después de las 5pm..." disabled={!canContactOrderCustomers}></textarea></div>
                    <div class="add-product-actions">
                      <button id="close-edit-order-btn" class="btn btn-secondary" type="button">Cerrar edición</button>
                    </div>
                  </div>
                </div>

                <div id="detail-alert" class="alert hidden"></div>

                <div id="detail-actions-area" class="hidden">
                  <h3 class="section-title">Acciones rápidas</h3>
                  <div class="quick-actions">
                    <button id="copy-order-btn" class="btn btn-secondary" type="button">Copiar resumen</button>
                    <button id="whatsapp-order-btn" class:list={['btn btn-secondary whatsapp-contact-btn pz-admin-action-btn success', !canContactOrderCustomers && 'permission-hidden']} type="button" disabled={!canContactOrderCustomers}>
                      <AdminIcon name="whatsapp" class="pz-admin-action-icon" />
                      <span data-whatsapp-order-label>Contactar cliente</span>
                    </button>
                    <button id="print-order-btn" class:list={['btn btn-secondary', !canContactOrderCustomers && 'permission-hidden']} type="button" disabled={!canContactOrderCustomers}>Imprimir pedido</button>
                    <button id="mark-delivered-btn" class:list={['btn btn-secondary', !canManageOrderStatus && 'permission-hidden']} type="button" disabled={!canManageOrderStatus}>Marcar entregada</button>
                    <button id="request-review-btn" class:list={['btn btn-secondary', !canRequestOrderReviews && 'permission-hidden']} type="button" disabled={!canRequestOrderReviews}>Pedir reseña</button>
                    <button id="delete-cancelled-order-btn" class:list={['btn btn-danger hidden', !canCancelDeleteOrders && 'permission-hidden']} type="button" disabled={!canCancelDeleteOrders}>Eliminar pedido</button>
                  </div>

                </div>
              </div>
            </aside>
          </div>
      </main>

      <div id="order-delete-confirm-modal" class:list={['order-confirm-modal hidden', !canCancelDeleteOrders && 'permission-hidden']} role="dialog" aria-modal="true" aria-labelledby="order-delete-confirm-title" aria-hidden="true">
        <div class="order-confirm-card">
          <div class="order-confirm-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 7h10l-.8 13H7.8L7 7Zm2-3h6l1 2h4v2H4V6h4l1-2Zm1 7h2v6h-2v-6Zm4 0h2v6h-2v-6Z"/></svg>
          </div>
          <h2 id="order-delete-confirm-title" class="order-confirm-title">Eliminar pedido</h2>
          <p id="order-delete-confirm-message" class="order-confirm-message">Esta acción eliminará la orden y conciliará el inventario de forma segura.</p>
          <div id="order-delete-confirm-alert" class="alert order-confirm-alert hidden"></div>
          <div class="order-confirm-actions">
            <button id="order-delete-confirm-cancel" class="btn btn-secondary" type="button">Cancelar</button>
            <button id="order-delete-confirm-submit" class="btn btn-danger" type="button">Sí, borrar pedido</button>
          </div>
        </div>
      </div>

      <div id="price-adjustment-modal" class:list={['price-adjustment-modal hidden', !canAdjustOrderPrice && 'permission-hidden']} role="dialog" aria-modal="true" aria-labelledby="price-adjustment-title" aria-hidden="true">
        <div class="price-adjustment-card" tabindex="-1">
          <div class="price-adjustment-heading">
            <div>
              <span class="price-adjustment-kicker">Acuerdo económico manual</span>
              <h2 id="price-adjustment-title">Ajustar precio</h2>
              <p id="price-adjustment-product"></p>
            </div>
            <button id="price-adjustment-close" class="price-adjustment-close" type="button" aria-label="Cerrar">×</button>
          </div>
          <div id="price-adjustment-baseline" class="price-adjustment-baseline">
            <span>Precio después de promoción/cupón</span>
            <strong id="price-adjustment-automatic-price">$0.00 USD</strong>
          </div>
          <div id="price-adjustment-reset-summary" class="price-adjustment-reset-summary hidden" aria-live="polite">
            <div class="price-adjustment-reset-row"><span>Precio final actual</span><strong id="price-adjustment-reset-current">$0.00 USD</strong></div>
            <div class="price-adjustment-reset-row"><span>Precio automático del sistema</span><strong id="price-adjustment-reset-automatic">$0.00 USD</strong></div>
            <div class="price-adjustment-reset-row"><span>Diferencia que se retirará</span><strong id="price-adjustment-reset-difference">$0.00 USD</strong></div>
          </div>
          <div id="price-adjustment-state-warning" class="price-adjustment-state-warning hidden" role="status"></div>
          <div class="form-grid">
            <div id="price-adjustment-final-wrap">
              <label for="price-adjustment-final-price">Precio unitario final USD</label>
              <input id="price-adjustment-final-price" type="number" min="0" max="1000000" step="0.01" inputmode="decimal" />
            </div>
            <div>
              <label for="price-adjustment-reason">Motivo obligatorio</label>
              <select id="price-adjustment-reason">
                <option value="">Selecciona un motivo</option>
                <option value="customer_agreement">Acuerdo con el cliente</option>
