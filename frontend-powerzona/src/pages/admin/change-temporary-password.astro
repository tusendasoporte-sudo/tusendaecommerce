---
export const prerender = false;
import { getStoreAdminPath } from '../../lib/adminRoutes';
import { refreshAuthFromCookie } from '../../lib/auth';
import { requireCurrentStoreForAdmin } from '../../lib/storeContext';
const authPb = await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
try {
  const context = await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
  return Astro.redirect(getStoreAdminPath(context.store.slug || '', 'change-temporary-password'));
} catch (_) {
  return Astro.redirect('/login');
}
---
