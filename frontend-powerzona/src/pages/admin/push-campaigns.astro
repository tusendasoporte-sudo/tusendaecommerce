---
export const prerender = false;

import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import PushCampaignsView from '../../components/admin/PushCampaignsView.astro';
import StoreCapabilityGate from '../../components/shared/StoreCapabilityGate.astro';
import { getStoreAdminPath } from '../../lib/adminRoutes';
import { isMasterAdmin, refreshAuthFromCookie } from '../../lib/auth';
import {
  resolveStorefrontPushAdminAccess,
} from '../../lib/storefrontPushAdmin';
import {
  requireCurrentStoreForAdmin,
  StoreContextError,
  STORE_CONTEXT_ERRORS,
} from '../../lib/storeContext';
import '../../styles/global.css';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');

const pocketbaseUrl = String(import.meta.env.PUBLIC_POCKETBASE_URL || '').replace(/\/$/, '');
const authPb = Astro.locals.adminAuthPb
  ?? await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');

let adminContext;
try {
  adminContext = Astro.locals.adminContext
    ?? await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
} catch (error) {
  if (isMasterAdmin(authPb.authStore.record as any)) return Astro.redirect('/master');
  if (error instanceof StoreContextError && error.code === STORE_CONTEXT_ERRORS.MASTER_ADMIN) {
    return Astro.redirect('/master');
  }
  return Astro.redirect('/login');
}

const authToken = authPb.authStore.token;
const currentStoreSlug = String(adminContext.store.slug || '').trim().toLowerCase();
const currentStoreName = adminContext.store.name || adminContext.store.title || currentStoreSlug || 'Tienda';
const canonicalPath = getStoreAdminPath(currentStoreSlug, 'push-campaigns');
const requestedStoreSlug = String(Astro.params.storeSlug || '').trim().toLowerCase();
if (requestedStoreSlug && requestedStoreSlug !== currentStoreSlug) return Astro.redirect(canonicalPath);

const pushAccess = await resolveStorefrontPushAdminAccess(adminContext, {
  baseUrl: pocketbaseUrl,
  token: authToken,
  storeAccess: Astro.locals.storeAccessContext,
});
const showPremiumGate = pushAccess.isPrimaryAdmin && !pushAccess.capability.allowed;
if (!pushAccess.allowed && !showPremiumGate) {
  return new Response('No se encontró la página solicitada.', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store, max-age=0',
      Pragma: 'no-cache',
      'X-Robots-Tag': 'noindex, nofollow, noarchive',
    },
  });
}

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <link rel="canonical" href={canonicalPath} />
    <title>{`Campañas push | ${currentStoreName}`}</title>
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <style is:global>
      html, body { min-height: 100%; margin: 0; }
      body {
        overflow-x: hidden;
        background:
          radial-gradient(circle at 14% 0%, rgba(37, 99, 235, .14), transparent 31%),
          radial-gradient(circle at 88% 6%, rgba(2, 132, 199, .10), transparent 26%),
          linear-gradient(180deg, #f8fbff 0%, #edf3fa 52%, #e8eef7 100%);
        color: #0f172a;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      @media (min-width: 1024px) {
        body { padding-left: calc(var(--pz-admin-sidebar-width, 278px) + var(--pz-admin-content-gap, 30px)); }
      }
      .push-campaigns-gate {
        width: min(1120px, calc(100% - 32px));
        margin: 28px auto 56px;
      }
      @media (max-width: 720px) {
        .push-campaigns-gate { width: min(100% - 20px, 1120px); margin-top: 16px; }
      }
    </style>
  </head>
  <body>
    <AdminSidebar
      storeId={adminContext.storeId}
      pocketbaseUrl={pocketbaseUrl}
      authToken={authToken}
      storeSlug={currentStoreSlug}
      storeName={currentStoreName}
      storePlanValues={adminContext.store}
      storeAccessContext={pushAccess.storeAccess}
      activeSection="push-campaigns"
      mobileTitle="Campañas push"
      mobileActionLabel={pushAccess.allowed ? 'Nueva' : ''}
      mobileActionEvent={pushAccess.allowed ? 'pz:push-campaign:new' : ''}
      mobileActionAriaLabel="Crear una campaña push"
    />

    {pushAccess.allowed ? (
      <PushCampaignsView
        pocketbaseUrl={pocketbaseUrl}
        storeName={currentStoreName}
        storeSlug={currentStoreSlug}
        supportStoreId={adminContext.isMasterSupport ? adminContext.storeId : ''}
      />
    ) : (
      <main class="push-campaigns-gate">
        <StoreCapabilityGate
          access={pushAccess.capability}
          featureName="Campañas push"
          featureDescription="Crea, programa y envía notificaciones a la app pública de tu tienda con un plan Premium activo."
          preservationMessage="Si cambias de plan, el contenido y la evidencia se conservan durante sus plazos normales, pero el módulo deja de estar accesible. Al recuperar Premium vuelves a ver lo que aún siga vigente; las campañas programadas no se reanudan solas."
          requiredPlanLabel="Plan Premium requerido"
          infoTitle="Mensajes controlados desde tu tienda"
          infoDescription="Cada envío vuelve a validar plan, permiso, tienda, contenido y las cuotas permanentes de 10 campañas diarias y 310 mensuales."
          planExpiredUsesPlanGate={true}
        />
      </main>
    )}
  </body>
</html>
