---
export const prerender = false;

import AdminSidebar from '../../../../components/admin/AdminSidebar.astro';
import StoreActivityView from '../../../../components/admin/StoreActivityView.astro';
import { getStoreAdminPath } from '../../../../lib/adminRoutes';
import { isMasterAdmin, refreshAuthFromCookie } from '../../../../lib/auth';
import { requireCurrentStoreForAdmin, StoreContextError, STORE_CONTEXT_ERRORS } from '../../../../lib/storeContext';
import { getStoreAccessContext, getStoreTeamErrorMessage } from '../../../../lib/storeTeam';
import '../../../../styles/global.css';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow,noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const pocketbaseUrl = String(import.meta.env.PUBLIC_POCKETBASE_URL || '').replace(/\/+$/, '');
const authPb = Astro.locals.adminAuthPb
  ?? await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');

let adminContext;
try {
  adminContext = Astro.locals.adminContext
    ?? await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
} catch (error) {
  if (isMasterAdmin(authPb.authStore.record as any)) return Astro.redirect('/master');
  if (error instanceof StoreContextError && error.code === STORE_CONTEXT_ERRORS.MASTER_ADMIN) return Astro.redirect('/master');
  return Astro.redirect('/login');
}

const currentStoreSlug = String(adminContext.store.slug || '').trim().toLowerCase();
const currentStoreName = adminContext.store.name || adminContext.store.title || currentStoreSlug || 'Tienda';
const teamPath = getStoreAdminPath(currentStoreSlug, 'team');
const requestedStoreSlug = String(Astro.params.storeSlug || '').trim().toLowerCase();
const userId = String(Astro.params.userId || '').trim();
if (requestedStoreSlug && requestedStoreSlug !== currentStoreSlug) return Astro.redirect(teamPath);
if (!/^[a-z0-9]{15}$/.test(userId)) return Astro.redirect(teamPath);
const currentUserId = String(adminContext.user?.id || authPb.authStore.record?.id || '').trim();
if (userId === currentUserId) {
  return Astro.redirect(`${getStoreAdminPath(currentStoreSlug, 'account/history')}?from=team`);
}
const canonicalPath = getStoreAdminPath(currentStoreSlug, `team/${encodeURIComponent(userId)}/activity`);

let isPrimaryAdmin = false;
let accessMessage = '';
try {
  const accessContext = Astro.locals.storeAccessContext
    ?? await getStoreAccessContext({ baseUrl: pocketbaseUrl, token: authPb.authStore.token, supportStoreId: adminContext.isMasterSupport ? adminContext.storeId : undefined });
  isPrimaryAdmin = accessContext.access.is_primary_admin === true;
  if (!isPrimaryAdmin) accessMessage = 'Solo el Administrador principal puede consultar reportes de otros usuarios.';
} catch (error) {
  accessMessage = getStoreTeamErrorMessage(error);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Actividad del usuario | {currentStoreName}</title>
    <link rel="canonical" href={canonicalPath} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <style is:global>
      html, body { min-height: 100%; margin: 0; }
      body {
        overflow-x: hidden;
        background:
          radial-gradient(circle at 14% 0%, rgba(37, 99, 235, .15), transparent 30%),
          linear-gradient(180deg, #f8fbff 0%, #eef3f9 48%, #e8eef7 100%);
        color: #0f172a;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      .store-activity-report-shell { width: min(1460px, 100%); margin: 0 auto; padding: 24px 24px 110px; }
      .store-activity-report-actions { display: flex; justify-content: flex-end; margin-bottom: 10px; }
      .store-activity-report-back { display: inline-flex; min-height: 42px; align-items: center; gap: 9px; border: 0; border-radius: 14px; background: transparent; color: #2563eb; padding: 3px 5px 3px 3px; text-decoration: none; font-size: 13px; font-weight: 950; }
      .store-activity-report-back__icon { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 12px; background: #eaf2ff; font-size: 18px; line-height: 1; }
      .store-activity-report-back:hover, .store-activity-report-back:focus-visible { background: rgba(255, 255, 255, .7); outline: 3px solid rgba(37, 99, 235, .12); }
      .store-activity-report-denied { max-width: 720px; margin: 72px auto; border: 1px solid #fecaca; border-radius: 20px; background: #fff; padding: 26px; }
      .store-activity-report-denied h1 { margin: 0; font-size: 25px; font-weight: 1000; }
      .store-activity-report-denied p { color: #64748b; line-height: 1.55; font-weight: 750; }
      @media (min-width: 1024px) {
        body { padding-left: calc(var(--pz-admin-sidebar-width, 278px) + var(--pz-admin-content-gap, 30px)); }
      }
      @media (max-width: 640px) {
        .store-activity-report-shell { padding: 18px 14px 132px; }
        .store-activity-report-actions { min-height: 42px; margin-bottom: 8px; }
        .store-activity-report-back { max-width: 100%; }
      }
    </style>
  </head>
  <body>
    <AdminSidebar
      storeId={adminContext.storeId}
      pocketbaseUrl={pocketbaseUrl}
      authToken={authPb.authStore.token}
      storeSlug={currentStoreSlug}
      storeName={currentStoreName}
      storePlanValues={adminContext.store}
      activeSection="team"
      mobileTitle="Actividad de usuario"
      mobileBackHref={teamPath}
      mobileBackLabel="Volver a Mi equipo"
    />

    {isPrimaryAdmin ? (
      <main class="store-activity-report-shell">
        <div class="store-activity-report-actions">
          <a class="store-activity-report-back" href={teamPath}>
            <span class="store-activity-report-back__icon" aria-hidden="true">←</span>
            <span>Volver a Mi equipo</span>
          </a>
        </div>
        <StoreActivityView
          mode="user"
          pocketbaseUrl={pocketbaseUrl}
          storeSlug={currentStoreSlug}
          userId={userId}
          filtersInitiallyOpen={false}
          pageSize={10}
        />
      </main>
    ) : (
      <main class="store-activity-report-denied">
        <h1>No tienes permiso</h1>
        <p>{accessMessage || 'Solo el Administrador principal puede consultar este reporte.'}</p>
        <a href={getStoreAdminPath(currentStoreSlug)}>Volver al Resumen</a>
      </main>
    )}
  </body>
</html>
