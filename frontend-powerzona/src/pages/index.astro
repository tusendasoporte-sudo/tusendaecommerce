---
import Layout from '../layouts/Layout.astro';
import { getSettings } from '../lib/api';
import {
  formatCommercialCup,
  getPublicCommercialPlanCatalog,
  type CommercialPlanDefinition,
  type CommercialStoreTypeCode,
  type CommercialStoreTypeDefinition,
} from '../lib/commercialPlanCatalog';
import { serverPocketBaseUrl } from '../lib/pocketBaseServerUrl';
import { getPublicHomepageSettings } from '../lib/publicHomepageSettings';
import { getFeaturedStores } from '../lib/stores';
import '../styles/commercial-home.css';

const [featuredStores, commercialCatalogResult, homepageSettings] = await Promise.all([
  getFeaturedStores(),
  getPublicCommercialPlanCatalog(serverPocketBaseUrl()),
  getPublicHomepageSettings(),
]);
const visibleStores = await Promise.all(featuredStores.map(async (store) => {
  const settings = await getSettings({ storeId: store.id }).catch(() => null);
  return {
    ...store,
    bazarImageUrl: store.bazaarImageUrl || settings?.logoImageUrl || settings?.coverImageUrl || store.logoUrl || store.bannerUrl || '',
    description: String(settings?.store_description || '').trim(),
  };
}));
const commercialCatalog = commercialCatalogResult.data;
const commercialPeriods = commercialCatalog?.commercial_period_months || [1, 6, 12];
const visibleFaqs = homepageSettings.faqs.filter((faq) => faq.visible);
const showFeaturedStores = homepageSettings.storesSectionEnabled && visibleStores.length > 0;
const showFaqSection = homepageSettings.faqSectionEnabled && visibleFaqs.length > 0;

const periodLabels: Record<number, string> = {
  1: 'Mensual',
  6: '6 meses',
  12: 'Anual',
};

function storeInitials(name: string) {
  return String(name || 'TS')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join('') || 'TS';
}

function storeHref(store: any) {
  return `/t/${encodeURIComponent(String(store.slug || '').trim().toLowerCase())}`;
}

function periodFor(plan: CommercialPlanDefinition, months: number) {
  return plan.pricing.periods.find((period) => period.months === months) || null;
}

function durationLabel(plan: CommercialPlanDefinition, months: number) {
  return plan.pricing.trial ? `${plan.pricing.trial.days} días` : `${months} ${months === 1 ? 'mes' : 'meses'}`;
}

function pricingView(plan: CommercialPlanDefinition, months: number) {
  if (plan.pricing.trial) {
    return {
      equivalent: 'Gratis',
      equivalentDetail: 'prueba única',
      total: formatCommercialCup(plan.pricing.trial.total_cup),
      savings: 'Sin pago durante la prueba',
      duration: `${plan.pricing.trial.days} días`,
    };
  }
  const period = periodFor(plan, months);
  if (!period) return null;
  return {
    equivalent: formatCommercialCup(period.monthly_equivalent_cup),
    equivalentDetail: '/mes equivalente',
    total: formatCommercialCup(period.total_cup),
    savings: period.savings_cup > 0
      ? `Ahorras ${formatCommercialCup(period.savings_cup)} · ${period.savings_percent}%`
      : 'Precio mensual de referencia',
    duration: durationLabel(plan, months),
  };
}

function storageLabel(value: unknown) {
  const megabytes = Math.round(Number(value || 0) / (1024 * 1024));
  return `${new Intl.NumberFormat('es-CU').format(megabytes)} MB de archivos`;
}

function limitLabels(plan: CommercialPlanDefinition, storeType: CommercialStoreTypeCode) {
  const capabilities = plan.capabilities as Record<string, any>;
  if (storeType === 'promotional') {
    return [
      `${capabilities.max_services} servicios`,
      `${capabilities.max_total_images} imágenes totales`,
      `${capabilities.max_locales} idiomas`,
      storageLabel(capabilities.max_storage_bytes),
    ];
  }
  return [
    `${capabilities.max_products} productos`,
    `${capabilities.max_active_users} ${capabilities.max_active_users === 1 ? 'usuario activo' : 'usuarios activos'}`,
    `${capabilities.max_store_devices} dispositivos administrativos`,
    `${capabilities.max_product_images} ${capabilities.max_product_images === 1 ? 'foto' : 'fotos'} por producto`,
  ];
}

function featureLabels(plan: CommercialPlanDefinition, storeType: CommercialStoreTypeCode) {
  const capabilities = plan.capabilities as Record<string, any>;
  if (storeType === 'promotional') {
    return [
      'Panel administrativo web',
      'Catálogo promocional y publicación',
      'Reseñas y contactos',
      'Personalización de tema',
      'Analítica de visitas',
      'Contenido multilenguaje',
    ];
  }
  const features = [
    'Categorías y subcategorías',
    capabilities.admin_android_app_enabled ? 'Aplicación administrativa Android' : 'Administración desde la web',
  ];
  if (capabilities.customer_android_app_enabled) features.push('Aplicación Android para clientes');
  if (capabilities.raffles_enabled) features.push('Rifas Premium');
  if (capabilities.landing_qr_enabled) features.push('Landing QR');
  if (capabilities.product_expiration_tools_enabled) features.push('Herramientas de vencimiento');
  if (capabilities.push_campaigns_enabled) features.push('Campañas push');
  return features;
}

function appLabel(plan: CommercialPlanDefinition, key: 'admin_android_app_enabled' | 'customer_android_app_enabled') {
  return plan.capabilities[key] === true ? 'Incluida' : 'No incluida';
}

function comparisonRows(storeType: CommercialStoreTypeDefinition) {
  if (storeType.code === 'promotional') {
    return [
      { label: 'Servicios', value: (plan: CommercialPlanDefinition) => String(plan.capabilities.max_services) },
      { label: 'Imágenes totales', value: (plan: CommercialPlanDefinition) => String(plan.capabilities.max_total_images) },
      { label: 'Idiomas', value: (plan: CommercialPlanDefinition) => String(plan.capabilities.max_locales) },
      { label: 'Almacenamiento', value: (plan: CommercialPlanDefinition) => storageLabel(plan.capabilities.max_storage_bytes) },
      { label: 'Panel administrativo web', value: (plan: CommercialPlanDefinition) => plan.capabilities.admin_panel_enabled === true },
      { label: 'Reseñas y contactos', value: (plan: CommercialPlanDefinition) => plan.capabilities.reviews_management_enabled === true && plan.capabilities.contacts_management_enabled === true },
      { label: 'Analítica', value: (plan: CommercialPlanDefinition) => plan.capabilities.analytics_enabled === true },
      { label: 'App administrativa Android', value: () => false },
      { label: 'App Android para clientes', value: () => false },
      { label: 'Seguridad avanzada', value: () => 'No incluida' },
    ];
  }
  return [
    { label: 'Productos', value: (plan: CommercialPlanDefinition) => String(plan.capabilities.max_products) },
    { label: 'Usuarios activos', value: (plan: CommercialPlanDefinition) => String(plan.capabilities.max_active_users) },
    { label: 'Dispositivos administrativos', value: (plan: CommercialPlanDefinition) => String(plan.capabilities.max_store_devices) },
    { label: 'Fotos por producto', value: (plan: CommercialPlanDefinition) => String(plan.capabilities.max_product_images) },
    { label: 'Categorías y subcategorías', value: (plan: CommercialPlanDefinition) => plan.capabilities.categories_enabled === true && plan.capabilities.subcategories_enabled === true },
    { label: 'App administrativa Android', value: (plan: CommercialPlanDefinition) => plan.capabilities.admin_android_app_enabled === true },
    { label: 'App Android para clientes', value: (plan: CommercialPlanDefinition) => plan.capabilities.customer_android_app_enabled === true },
    { label: 'Rifas Premium', value: (plan: CommercialPlanDefinition) => plan.capabilities.raffles_enabled === true },
    { label: 'Landing QR', value: (plan: CommercialPlanDefinition) => plan.capabilities.landing_qr_enabled === true },
    { label: 'Vencimientos y campañas push', value: (plan: CommercialPlanDefinition) => plan.capabilities.product_expiration_tools_enabled === true && plan.capabilities.push_campaigns_enabled === true },
    { label: 'Seguridad avanzada', value: () => 'No incluida' },
  ];
}

function comparisonValue(value: string | boolean) {
  if (value === true) return { label: 'Incluido', tone: 'yes', symbol: '✓' };
  if (value === false) return { label: 'No incluido', tone: 'no', symbol: '—' };
  return { label: value, tone: value.startsWith('No incluida') ? 'no' : 'plain', symbol: '' };
}
---

<Layout
  isBazar={true}
  seo={{
    title: 'Tu Senda 84 | Crea tu tienda online',
    description: 'Crea una tienda promocional o ecommerce con planes claros, catálogo, administración y aplicaciones Android según el plan.',
    image: '/brand/tusenda84-bazzar-logo.webp',
    canonical: '/',
    type: 'website',
    siteName: 'Tu Senda 84',
  }}
>
  <div class="commercial-home" data-commercial-home>
    <header class="commercial-hero" id="inicio">
      <nav class="commercial-nav commercial-shell" aria-label="Navegación principal">
        <a class="commercial-brand" href="#inicio" aria-label="Tu Senda 84, inicio">
          <span class="commercial-brand-mark"><img src="/brand/tu-senda-84-admin-icon-512.png" alt="" width="42" height="42" /></span>
          <span>Tu Senda 84</span>
        </a>
        <div class="commercial-nav-links">
          <a href="#soluciones">Soluciones</a>
          <a href="#planes">Planes</a>
          <a href="#aplicaciones">Aplicaciones</a>
          <a href="#preguntas">Preguntas</a>
          <a class="commercial-button commercial-button-light" href="#planes">Comparar planes</a>
        </div>
      </nav>

      <div class="commercial-hero-grid commercial-shell">
        <div class="commercial-hero-copy">
          <span class="commercial-kicker">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.4 4.1L17.5 8.5l-4.1 1.4L12 14l-1.4-4.1-4.1-1.4 4.1-1.4L12 3Zm6 11 .9 2.6 2.6.9-2.6.9L18 21l-.9-2.6-2.6-.9 2.6-.9L18 14Z" /></svg>
            Tu negocio, en su mejor versión digital
          </span>
          <h1>Abre una tienda que se sienta <em>tan tuya</em> como tu marca.</h1>
          <p>Presenta tus productos, recibe pedidos y administra tu negocio desde un solo lugar. Empieza con una vitrina promocional o da el salto a una experiencia ecommerce completa.</p>
          <div class="commercial-hero-actions">
            <a class="commercial-button commercial-button-light" href="#planes">Explorar planes <span aria-hidden="true">↓</span></a>
            {showFeaturedStores && <a class="commercial-button commercial-button-ghost" href="#tiendas">Ver tiendas destacadas <span aria-hidden="true">↗</span></a>}
          </div>
          <ul class="commercial-hero-points" aria-label="Características principales">
            <li>Precios en CUP</li>
            <li>Periodos de 1, 6 y 12 meses</li>
            <li>Prueba gratis de 30 días</li>
          </ul>
        </div>
        <div class="commercial-hero-visual" aria-label="Plataforma de tiendas Tu Senda 84">
          <div class="commercial-visual-orbit" aria-hidden="true"></div>
          <img src="/brand/tusenda84-storefront-platform-v2.webp" alt="Ilustración de una tienda digital con panel administrativo y catálogo móvil" width="840" height="1000" fetchpriority="high" />
          <div class="commercial-visual-note commercial-visual-note-top"><strong>2 modalidades</strong><span>Promocional y Ecommerce</span></div>
          <div class="commercial-visual-note commercial-visual-note-bottom"><strong>Todo conectado</strong><span>Web, administración y Android</span></div>
        </div>
      </div>
    </header>

    <div class="commercial-main">
      <section class="commercial-section" id="soluciones" aria-labelledby="soluciones-title">
        <div class="commercial-shell">
          <div class="commercial-section-head">
            <span class="commercial-eyebrow">Dos formas de empezar</span>
            <h2 id="soluciones-title">Dos maneras de llevar tu negocio a internet.</h2>
            <p>Comienza con la solución que mejor encaja con tu etapa actual y conserva un camino claro para crecer.</p>
          </div>

          <div class="commercial-type-grid">
            <article class="commercial-type-card">
              <span class="commercial-type-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7M3 13h18l-2 7H5l-2-7Zm5 0V8h8v5" /></svg></span>
              <span class="commercial-type-tag">Promocional</span>
              <h3>Convierte visitas en contactos.</h3>
              <p>Presenta servicios, catálogo, reseñas y vías de contacto en una presencia pública diseñada para promocionar tu negocio.</p>
              <ul><li>Hasta 12 servicios</li><li>Reseñas y contactos</li><li>Analítica incluida</li><li>Contenido en 2 idiomas</li></ul>
            </article>

            <article class="commercial-type-card commercial-type-card-accent">
              <span class="commercial-type-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 8H7M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" /></svg></span>
              <span class="commercial-type-tag">Ecommerce</span>
              <h3>Vende y gestiona de principio a fin.</h3>
              <p>Organiza productos, inventario y pedidos, con aplicaciones Android disponibles según el plan seleccionado.</p>
              <ul><li>Hasta 1,600 productos</li><li>Categorías y subcategorías</li><li>Administración Android</li><li>Funciones Premium</li></ul>
            </article>
          </div>

          <div class="commercial-benefit-grid" aria-label="Beneficios de Tu Senda 84">
            <article><span>01</span><h3>Tu identidad primero</h3><p>Una presencia visual preparada para representar la personalidad de cada negocio.</p></article>
            <article><span>02</span><h3>Lista para móviles</h3><p>Una experiencia clara y rápida para clientes y administradores desde cualquier pantalla.</p></article>
            <article><span>03</span><h3>Control del negocio</h3><p>Catálogo, pedidos, equipo y herramientas organizadas según la modalidad y el plan.</p></article>
            <article><span>04</span><h3>Crece por etapas</h3><p>Empieza con una prueba y amplía límites o funciones cuando el negocio lo necesite.</p></article>
          </div>
        </div>
      </section>

      <section class="commercial-section commercial-pricing" id="planes" aria-labelledby="planes-title">
        <div class="commercial-shell">
          <div class="commercial-pricing-head">
            <div class="commercial-section-head">
              <span class="commercial-eyebrow">Planes claros</span>
              <h2 id="planes-title">La tienda que necesitas hoy, lista para crecer mañana.</h2>
              <p>Elige una presencia promocional para mostrar tu catálogo y recibir contactos, o activa ecommerce para vender y gestionar pedidos de principio a fin.</p>
            </div>
            {commercialCatalog && (
              <div class="commercial-price-controls" aria-label="Configurar comparación de planes">
                <div class="commercial-segment" role="group" aria-label="Tipo de tienda"><button type="button" data-store-mode="promotional" aria-pressed="true">Promocional</button><button type="button" data-store-mode="ecommerce" aria-pressed="false">Ecommerce</button></div>
                <div class="commercial-segment" role="group" aria-label="Periodo de pago">
                  {commercialPeriods.map((months) => <button type="button" data-billing-period={months} aria-pressed={months === 1 ? 'true' : 'false'}>{periodLabels[months] || `${months} meses`}</button>)}
                </div>
              </div>
            )}
          </div>

          {commercialCatalog ? (
            <>
              {commercialCatalog.store_types.flatMap((storeType) => commercialPeriods.map((months) => (
                <section class:list={['commercial-plan-panel', storeType.code === 'ecommerce' && 'commercial-plan-panel-three']} data-plan-panel data-panel-mode={storeType.code} data-panel-period={months} hidden={storeType.code !== 'promotional' || months !== 1} aria-label={`${storeType.name}, ${periodLabels[months] || `${months} meses`}`}>
                  <div class="commercial-period-summary"><span>{storeType.name}</span><strong>{months === 1 ? 'Pago mensual, sin permanencia.' : `Pago por ${months} meses con ahorro frente al precio mensual.`}</strong></div>
                  <div class="commercial-plan-grid">
                    {storeType.plans.map((plan) => {
                      const pricing = pricingView(plan, months);
                      if (!pricing) return null;
                      const featured = plan.code === 'basic';
                      return (
                        <article class:list={['commercial-plan-card', featured && 'is-featured']}>
                          <div class="commercial-plan-ribbon">{featured && <span>Más elegido</span>}</div>
                          <h3>{plan.name}</h3>
                          <p class="commercial-plan-purpose">{plan.code === 'free' ? 'Para conocer la plataforma sin pago inicial.' : plan.code === 'premium' ? 'Para operaciones que necesitan todas las herramientas.' : 'Para negocios listos para operar y crecer.'}</p>
                          <div class="commercial-plan-price"><strong>{pricing.equivalent}</strong><span>{pricing.equivalentDetail}</span></div>
                          <p class="commercial-plan-total">Total a pagar: <strong>{pricing.total}</strong></p>
                          <p class="commercial-plan-saving">{pricing.savings}</p>
                          <p class="commercial-plan-duration"><span>Duración</span><strong>{pricing.duration}</strong></p>
                          <button class="commercial-plan-action" type="button" data-plan-action data-plan-name={plan.name} data-store-name={storeType.name} data-period-name={pricing.duration} data-plan-total={pricing.total}>Elegir {plan.name.toLowerCase()}</button>
                          <div class="commercial-plan-detail"><h4>Límites principales</h4><ul>{limitLabels(plan, storeType.code).map((label) => <li><span aria-hidden="true">✓</span>{label}</li>)}</ul></div>
                          <div class="commercial-plan-detail"><h4>Funciones incluidas</h4><ul>{featureLabels(plan, storeType.code).map((label) => <li><span aria-hidden="true">✓</span>{label}</li>)}</ul></div>
                          <div class="commercial-app-summary">
                            <p><span>App administrativa Android</span><strong>{storeType.code === 'ecommerce' ? appLabel(plan, 'admin_android_app_enabled') : 'No incluida'}</strong></p>
                            <p><span>App Android para clientes</span><strong>{storeType.code === 'ecommerce' ? appLabel(plan, 'customer_android_app_enabled') : 'No incluida'}</strong></p>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                </section>
              )))}
              <div class="commercial-selection" data-plan-selection hidden aria-live="polite"><div><strong data-selection-title>Plan seleccionado</strong><span data-selection-detail></span></div><a href="#comparacion">Revisar comparación <span aria-hidden="true">↓</span></a></div>
            </>
          ) : (
            <div class="commercial-catalog-unavailable" role="status"><strong>Los planes no están disponibles temporalmente.</strong><span>Vuelve a intentarlo en unos minutos para consultar precios, límites y periodos vigentes.</span></div>
          )}
        </div>
      </section>

      {commercialCatalog && (
        <section class="commercial-section commercial-comparison" id="comparacion" aria-labelledby="comparacion-title">
          <div class="commercial-shell">
            <div class="commercial-section-head"><span class="commercial-eyebrow">Comparación rápida</span><h2 id="comparacion-title">Lo esencial, lado a lado.</h2><p>La tabla cambia junto con la modalidad seleccionada en Planes claros.</p></div>
            {commercialCatalog.store_types.map((storeType) => (
              <div class="commercial-table-wrap" data-comparison-table={storeType.code} hidden={storeType.code !== 'promotional'}>
                <table>
                  <thead><tr><th scope="col">Función o límite</th>{storeType.plans.map((plan) => <th scope="col">{plan.name}</th>)}</tr></thead>
                  <tbody>{comparisonRows(storeType).map((row) => <tr><th scope="row">{row.label}</th>{storeType.plans.map((plan) => { const display = comparisonValue(row.value(plan)); return <td><span class:list={['commercial-table-value', `is-${display.tone}`]}>{display.symbol && <b aria-hidden="true">{display.symbol}</b>}{display.label}</span></td>; })}</tr>)}</tbody>
                </table>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="commercial-section commercial-apps" id="aplicaciones" aria-labelledby="aplicaciones-title">
        <div class="commercial-shell">
          <div class="commercial-section-head"><span class="commercial-eyebrow">Aplicaciones Android</span><h2 id="aplicaciones-title">Una aplicación para gestionar. Otra para comprar.</h2><p>Son experiencias diferentes y su disponibilidad depende de la modalidad Ecommerce y del plan contratado.</p></div>
          <div class="commercial-app-grid">
            <article class="commercial-app-card commercial-app-admin"><div><span class="commercial-app-label">Para ti y tu equipo</span><h3>Aplicación administrativa</h3><p>El centro de control móvil para gestionar catálogo y operación. Está incluida en los planes Ecommerce Básico y Premium.</p><ul><li>Administración desde Android</li><li>Acceso de usuarios autorizados</li><li>Hasta 20 dispositivos en Premium</li></ul></div><img src="/brand/tu-senda-84-admin-icon-512.png" alt="Icono de Tu Senda 84 Admin para Android" width="512" height="512" loading="lazy" /></article>
            <article class="commercial-app-card commercial-app-customer"><div><span class="commercial-app-label">Para tus compradores</span><h3>Aplicación para clientes</h3><p>Una app con la identidad de la tienda para que los clientes exploren y compren. Está incluida en Ecommerce Premium.</p><ul><li>Marca propia de la tienda</li><li>Catálogo y experiencia de compra</li><li>Campañas push en Premium</li></ul></div><figure><img src="/brand/android-platform-icon.svg" alt="Icono de Android para la aplicación de clientes" width="512" height="512" loading="lazy" /><figcaption>Disponible para Android</figcaption></figure></article>
          </div>
        </div>
      </section>

      {homepageSettings.storesSectionEnabled && (
      <section class="commercial-section commercial-stores" id="tiendas" aria-labelledby="tiendas-title">
        <div class="commercial-shell">
          <div class="commercial-section-head commercial-section-head-row"><div><span class="commercial-eyebrow">Tiendas destacadas</span><h2 id="tiendas-title">Negocios que ya forman parte de la senda.</h2><p>Explora tiendas reales publicadas dentro de Tu Senda 84.</p></div><a class="commercial-text-link" href="#planes">Ver planes <span aria-hidden="true">↑</span></a></div>
          {visibleStores.length > 0 ? (
            <div class="commercial-store-carousel" data-store-carousel>
              <div class="commercial-store-grid" data-store-rail role="list" aria-label="Tiendas destacadas">
                {visibleStores.map((store) => (
                  <a class="commercial-store-card" href={storeHref(store)} aria-label={`Entrar a ${store.name}`} role="listitem">
                    <div class="commercial-store-image">
                      {store.logoCardUrl || store.logoUrl || store.bazarImageUrl ? <img src={store.logoCardUrl || store.logoUrl || store.bazarImageUrl || ''} alt={`Logo de ${store.name}`} loading="lazy" /> : <span>{storeInitials(store.name)}</span>}
                    </div>
                    <div class="commercial-store-copy"><h3>{store.name || 'Tienda'}</h3><span><i aria-hidden="true"></i>Abierta</span></div>
                  </a>
                ))}
              </div>
              <div class="commercial-store-controls" data-store-controls hidden>
                <button type="button" data-store-scroll="-1" aria-label="Ver tiendas anteriores">←</button>
                <button type="button" data-store-scroll="1" aria-label="Ver más tiendas">→</button>
              </div>
            </div>
          ) : <div class="commercial-empty-stores">Próximamente estarán disponibles las primeras tiendas destacadas.</div>}
        </div>
      </section>
      )}

      {showFaqSection && (
      <section class="commercial-section commercial-faq" id="preguntas" aria-labelledby="preguntas-title">
        <div class="commercial-shell commercial-faq-grid">
          <div class="commercial-section-head"><span class="commercial-eyebrow">{homepageSettings.faqEyebrow}</span><h2 id="preguntas-title">{homepageSettings.faqTitle}</h2><p>{homepageSettings.faqIntro}</p></div>
          <div class="commercial-faq-list">
            {visibleFaqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
          </div>
        </div>
      </section>
      )}

      <section class="commercial-final-cta" aria-label="Comenzar con Tu Senda 84"><div><span>Tu próxima tienda empieza aquí</span><h2>Encuentra el plan que acompaña tu próximo paso.</h2><p>Compara precios, duración, límites, aplicaciones y funciones incluidas.</p></div><div><a class="commercial-button commercial-button-light" href="#planes">Elegir modalidad</a>{showFeaturedStores && <a class="commercial-button commercial-button-ghost" href="#tiendas">Explorar tiendas</a>}</div></section>
    </div>

    <footer class="commercial-footer commercial-shell"><a class="commercial-brand commercial-brand-footer" href="#inicio"><span class="commercial-brand-mark"><img src="/brand/tu-senda-84-admin-icon-512.png" alt="" width="42" height="42" /></span><span>Tu Senda 84</span></a><p>Tiendas promocionales y ecommerce para negocios que quieren crecer.</p></footer>
  </div>

  <script>
    const root = document.querySelector('[data-commercial-home]');
    if (root instanceof HTMLElement) {
      const modeButtons = Array.from(root.querySelectorAll('[data-store-mode]'));
      const periodButtons = Array.from(root.querySelectorAll('[data-billing-period]'));
      const planPanels = Array.from(root.querySelectorAll('[data-plan-panel]'));
      const comparisonTables = Array.from(root.querySelectorAll('[data-comparison-table]'));
      const selection = root.querySelector('[data-plan-selection]');
      const selectionTitle = root.querySelector('[data-selection-title]');
      const selectionDetail = root.querySelector('[data-selection-detail]');
      let activeMode = 'promotional';
      let activePeriod = '1';

      const clearSelection = () => { if (selection instanceof HTMLElement) selection.hidden = true; };
      const updatePricing = () => {
        modeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.getAttribute('data-store-mode') === activeMode)));
        periodButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.getAttribute('data-billing-period') === activePeriod)));
        planPanels.forEach((panel) => { if (panel instanceof HTMLElement) panel.hidden = panel.dataset.panelMode !== activeMode || panel.dataset.panelPeriod !== activePeriod; });
        comparisonTables.forEach((table) => { if (table instanceof HTMLElement) table.hidden = table.dataset.comparisonTable !== activeMode; });
        clearSelection();
      };

      modeButtons.forEach((button) => button.addEventListener('click', () => { activeMode = button.getAttribute('data-store-mode') || 'promotional'; updatePricing(); }));
      periodButtons.forEach((button) => button.addEventListener('click', () => { activePeriod = button.getAttribute('data-billing-period') || '1'; updatePricing(); }));
      root.querySelectorAll('[data-plan-action]').forEach((button) => button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement) || !(selection instanceof HTMLElement)) return;
        if (selectionTitle) selectionTitle.textContent = `${button.dataset.planName} · ${button.dataset.storeName}`;
        if (selectionDetail) selectionDetail.textContent = `${button.dataset.periodName} · Total ${button.dataset.planTotal}`;
        selection.hidden = false;
        selection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }));

      const storeRail = root.querySelector('[data-store-rail]');
      const storeControls = root.querySelector('[data-store-controls]');
      const updateStoreControls = () => {
        if (!(storeRail instanceof HTMLElement) || !(storeControls instanceof HTMLElement)) return;
        storeControls.hidden = storeRail.scrollWidth <= storeRail.clientWidth + 2;
      };
      root.querySelectorAll('[data-store-scroll]').forEach((button) => button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement) || !(storeRail instanceof HTMLElement)) return;
        const direction = Number(button.dataset.storeScroll || 1);
        storeRail.scrollBy({ left: direction * Math.max(180, storeRail.clientWidth * 0.72), behavior: 'smooth' });
      }));
      if (storeRail instanceof HTMLElement) {
        requestAnimationFrame(updateStoreControls);
        window.addEventListener('resize', updateStoreControls, { passive: true });
      }

      const faqs = Array.from(root.querySelectorAll('.commercial-faq-list details'));
      faqs.forEach((detail) => detail.addEventListener('toggle', () => {
        if (!(detail instanceof HTMLDetailsElement) || !detail.open) return;
        faqs.forEach((other) => { if (other instanceof HTMLDetailsElement && other !== detail) other.open = false; });
      }));
    }
  </script>
</Layout>
