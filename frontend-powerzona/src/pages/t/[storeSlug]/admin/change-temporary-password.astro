---
export const prerender = false;

import { getStoreAdminPath } from '../../../../lib/adminRoutes';
import { isMasterAdmin, isStoreUser, refreshAuthFromCookie, requiresTemporaryPasswordChange } from '../../../../lib/auth';
import { requireCurrentStoreForAdmin } from '../../../../lib/storeContext';
import '../../../../styles/account-ui.css';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow,noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const authPb = await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
if (!authPb.authStore.isValid || !authPb.authStore.record) return Astro.redirect('/login');
if (isMasterAdmin(authPb.authStore.record as any)) return Astro.redirect('/master');

let adminContext;
try {
  adminContext = await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
} catch (_) {
  return Astro.redirect('/login');
}
const storeSlug = String(adminContext.store.slug || '').trim().toLowerCase();
const pathSlug = String(Astro.params.storeSlug || '').trim().toLowerCase();
const adminPath = getStoreAdminPath(storeSlug);
const canonicalPath = getStoreAdminPath(storeSlug, 'change-temporary-password');
if (pathSlug !== storeSlug) return Astro.redirect(canonicalPath);
if (!isStoreUser(adminContext.user) || !requiresTemporaryPasswordChange(adminContext.user)) return Astro.redirect(adminPath);

const user = adminContext.user;
const displayName = String(user.display_name || user.name || user.email || 'Usuario');
const initials = displayName.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || 'U';
const roleLabel = String(user.role) === 'store_admin' ? 'Administrador de tienda' : 'Personal de tienda';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Crear mi contraseña</title>
  </head>
  <body class="pz-account-page">
    <main class="pz-temporary-shell">
      <section class="pz-temporary-panel pz-account-card" aria-labelledby="temporary-password-title">
        <div class="pz-temporary-brand"><span>PZ</span><strong>{String(adminContext.store.name || 'PowerZona')}</strong></div>
        <header class="pz-account-heading">
          <h1 id="temporary-password-title">Debes crear tu contraseña personal</h1>
          <p>Estás usando una contraseña temporal. Crea una contraseña personal para continuar.</p>
        </header>
        <div class="pz-temporary-user"><span class="pz-temporary-avatar">{initials}</span><div><strong>{displayName}</strong><span>{String(user.email || '')} · {roleLabel}</span></div></div>
        <div class="pz-account-alert" style="margin: 0 0 18px">Al terminar se cerrará esta sesión y deberás iniciar sesión nuevamente.</div>
        <form id="temporary-password-form" class="pz-account-form" novalidate>
          <div class="pz-account-field"><label for="temporary-current-password">Contraseña temporal actual</label><div class="pz-account-input-wrap"><input class="pz-account-input" id="temporary-current-password" name="currentPassword" type="password" autocomplete="current-password" required /><button class="pz-account-toggle" type="button" data-toggle-password aria-label="Mostrar contraseña">◉</button></div></div>
          <div class="pz-account-field"><label for="temporary-new-password">Nueva contraseña</label><div class="pz-account-input-wrap"><input class="pz-account-input" id="temporary-new-password" name="newPassword" type="password" autocomplete="new-password" required /><button class="pz-account-toggle" type="button" data-toggle-password aria-label="Mostrar contraseña">◉</button></div></div>
          <div class="pz-account-field"><label for="temporary-confirm-password">Confirmar nueva contraseña</label><div class="pz-account-input-wrap"><input class="pz-account-input" id="temporary-confirm-password" name="newPasswordConfirm" type="password" autocomplete="new-password" required /><button class="pz-account-toggle" type="button" data-toggle-password aria-label="Mostrar contraseña">◉</button></div></div>
          <div class="pz-account-strength"><span>Seguridad</span><span class="pz-account-strength__bar" data-strength-bar></span><strong data-strength-label>Sin evaluar</strong></div>
          <button class="pz-account-submit" type="submit">Crear mi contraseña</button>
          <p class="pz-account-message" data-temporary-message aria-live="polite"></p>
        </form>
      </section>
    </main>

    <script>
      import { changeTemporaryPassword, clearStoreAuthentication, finishStoreAccountMutation, getStoreAccountErrorCode, getStoreAccountErrorMessage } from '../../../../lib/storeAccount';
      const form = document.getElementById('temporary-password-form') as HTMLFormElement | null;
      const message = document.querySelector<HTMLElement>('[data-temporary-message]');
      const newPassword = document.getElementById('temporary-new-password') as HTMLInputElement | null;
      const bar = document.querySelector<HTMLElement>('[data-strength-bar]');
      const label = document.querySelector<HTMLElement>('[data-strength-label]');
      function updateStrength(value: string) {
        let score = 0;
        if (value.length >= 8) score++;
        if (value.length >= 12) score++;
        if (/[a-z]/.test(value) && /[A-Z]/.test(value)) score++;
        if (/\d/.test(value) && /[^A-Za-z0-9]/.test(value)) score++;
        const labels = ['Sin evaluar', 'Básica', 'Aceptable', 'Buena', 'Fuerte'];
        const colors = ['#94a3b8', '#ef4444', '#f97316', '#2563eb', '#16a34a'];
        bar?.style.setProperty('--strength', `${score * 25}%`);
        bar?.style.setProperty('--strength-color', colors[score]);
        if (label) label.textContent = value ? labels[score] : labels[0];
      }
      document.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((button) => button.addEventListener('click', () => {
        const input = button.previousElementSibling as HTMLInputElement | null;
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
        button.setAttribute('aria-label', input.type === 'password' ? 'Mostrar contraseña' : 'Ocultar contraseña');
      }));
      newPassword?.addEventListener('input', () => updateStrength(newPassword.value));
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const data = new FormData(form);
        const input = { currentPassword: String(data.get('currentPassword') || ''), newPassword: String(data.get('newPassword') || ''), newPasswordConfirm: String(data.get('newPasswordConfirm') || '') };
        if (input.newPassword !== input.newPasswordConfirm) { if (message) message.textContent = 'Las contraseñas nuevas no coinciden.'; return; }
        if (submit) submit.disabled = true;
        if (message) message.textContent = '';
        try {
          await changeTemporaryPassword(input);
          form.reset();
          finishStoreAccountMutation('password_setup=1');
        } catch (error) {
          if (getStoreAccountErrorCode(error) === 'temporary_password_expired') {
            form.reset();
            clearStoreAuthentication();
            window.location.assign('/login?temporary_expired=1');
            return;
          }
          if (message) message.textContent = getStoreAccountErrorMessage(error);
        } finally { if (submit) submit.disabled = false; }
      });
    </script>
  </body>
</html>
