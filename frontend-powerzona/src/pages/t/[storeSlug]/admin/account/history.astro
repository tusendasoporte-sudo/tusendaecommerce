---
export const prerender = false;

import AdminSidebar from '../../../../../components/admin/AdminSidebar.astro';
import StoreActivityView from '../../../../../components/admin/StoreActivityView.astro';
import { getStoreAdminPath } from '../../../../../lib/adminRoutes';
import { isMasterAdmin, refreshAuthFromCookie } from '../../../../../lib/auth';
import { requireCurrentStoreForAdmin } from '../../../../../lib/storeContext';
import '../../../../../styles/global.css';
import '../../../../../styles/account-ui.css';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const authPb = Astro.locals.adminAuthPb
  ?? await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
if (!authPb.authStore.isValid || !authPb.authStore.record) return Astro.redirect('/login');
if (isMasterAdmin(authPb.authStore.record as any)) return Astro.redirect('/master');

let adminContext;
try {
  adminContext = Astro.locals.adminContext
    ?? await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
} catch (_) {
  return Astro.redirect('/login');
}

const storeSlug = String(adminContext.store.slug || '').trim().toLowerCase();
const accountPath = getStoreAdminPath(storeSlug, 'account');
const canonicalPath = getStoreAdminPath(storeSlug, 'account/history');
const returnToTeam = Astro.url.searchParams.get('from') === 'team';
const backPath = returnToTeam ? getStoreAdminPath(storeSlug, 'team') : accountPath;
const backLabel = returnToTeam ? 'Volver a Mi equipo' : 'Volver a Mi cuenta';
const pathSlug = String(Astro.params.storeSlug || '').trim().toLowerCase();
if (pathSlug !== storeSlug) return Astro.redirect(canonicalPath);
const storeName = String(adminContext.store.name || storeSlug || 'Tienda');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Mi historial | {storeName}</title>
    <link rel="canonical" href={canonicalPath} />
  </head>
  <body class="pz-account-page pz-account-page--sidebar pz-account-history-page">
    <AdminSidebar
      storeId={adminContext.storeId}
      pocketbaseUrl={import.meta.env.PUBLIC_POCKETBASE_URL}
      authToken={authPb.authStore.token}
      storeSlug={storeSlug}
      storeName={storeName}
      storePlanValues={adminContext.store}
      activeSection="account"
      mobileTitle="Mi historial"
      mobileBackHref={backPath}
      mobileBackLabel={backLabel}
    />

    <main class="pz-account-shell pz-account-history-shell">
      <header class="pz-account-heading pz-account-heading--with-back pz-account-heading--history">
        <div>
          <h1>Mi historial</h1>
          <p>Consulta únicamente los cambios administrativos realizados con tu cuenta.</p>
        </div>
        <a class="pz-account-secondary pz-account-heading__back" href={backPath}>{backLabel}</a>
      </header>

      <section id="my-activity" class="pz-account-activity-view" aria-label="Mi actividad">
        <StoreActivityView
          mode="self"
          pocketbaseUrl={String(import.meta.env.PUBLIC_POCKETBASE_URL || '')}
          storeSlug={storeSlug}
          embedded={true}
          filtersInitiallyOpen={false}
          pageSize={10}
        />
      </section>
    </main>
  </body>
</html>
