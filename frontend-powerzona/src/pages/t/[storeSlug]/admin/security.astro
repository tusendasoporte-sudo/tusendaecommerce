---
export const prerender = false;

import { getStoreAdminPath } from '../../../../lib/adminRoutes';
import { isMasterAdmin, refreshAuthFromCookie } from '../../../../lib/auth';
import { requireCurrentStoreForAdmin, StoreContextError, STORE_CONTEXT_ERRORS } from '../../../../lib/storeContext';
import {
  getDefaultSecuritySettings,
  getStoreSecuritySettings,
  isStoreSecurityEnabled,
} from '../../../../lib/security';
import { resolveSecurityAdminAccess } from '../../../../lib/securityAccess';
import {
  getMonitoringParams,
  getSecurityActivityPage,
  getSecurityBlocksPage,
  getSecurityCustomerDetail,
  getSecurityCustomersPage,
  getSecurityMergeCandidates,
  getSecurityManualIpDeviceCandidates,
  getSecurityMonitoringSummary,
  getSecurityVisitorsPage,
  mergeSecurityCustomers,
  runSecurityBlockDeviceCandidateAction,
  runSecurityBlockCreate,
  runSecurityBlockRevoke,
  runSecurityManualIpBlockCreate,
  updateSecurityVpnPolicy,
  runSecurityCustomerObservation,
  runSecurityCustomerLifecycle,
  type PaginatedResult,
  type SecurityAddressCandidate,
  type SecurityAvailableSignals,
  type SecurityBlock,
  type SecurityBlockCapabilities,
  type SecurityBlockHistorySummary,
  type SecurityBlocksMetrics,
  type SecurityCustomer,
  type SecurityCustomerDevice,
  type SecurityCustomerLifecycleCounts,
  type SecurityCustomerLinksSummary,
  type SecurityCustomerPhone,
  type SecurityEventRow,
  type SecurityOrder,
  type SecuritySummary,
  type SecurityVisitorSessionRow,
  type ManualIpBlockDraft,
  type ManualIpDeviceLookupResult,
} from '../../../../lib/securityMonitoring';
import AdminSidebar from '../../../../components/admin/AdminSidebar.astro';
import AdminSectionHeader from '../../../../components/admin/AdminSectionHeader.astro';
import SecurityMonitoringView from '../../../../components/admin/SecurityMonitoringView.astro';
import LastModificationMeta from '../../../../components/admin/LastModificationMeta.astro';
import StoreCapabilityGate from '../../../../components/shared/StoreCapabilityGate.astro';
import '../../../../styles/global.css';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'same-origin');

const pocketbaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
const authPb = Astro.locals.adminAuthPb
  ?? await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');

let adminContext;
try {
  adminContext = Astro.locals.adminContext
    ?? await requireCurrentStoreForAdmin(authPb, { pathname: Astro.url.pathname });
} catch (error) {
  if (isMasterAdmin(authPb.authStore.record as any)) return Astro.redirect('/master');
  if (error instanceof StoreContextError && error.code === STORE_CONTEXT_ERRORS.MASTER_ADMIN) return Astro.redirect('/master');
  return Astro.redirect('/login');
}

const currentStoreId = adminContext.storeId;
const currentStoreSlug = adminContext.store.slug || '';
const currentStoreName = adminContext.store.name || adminContext.store.title || currentStoreSlug || 'Tienda';
const adminBasePath = getStoreAdminPath(currentStoreSlug);
const adminSecurityPath = getStoreAdminPath(currentStoreSlug, 'security');
const adminOrdersPath = getStoreAdminPath(currentStoreSlug, 'orders');
const adminAuthToken = authPb.authStore.token;

const pathStoreSlug = String(Astro.params.storeSlug || '').trim().toLowerCase();
if (pathStoreSlug && pathStoreSlug !== String(currentStoreSlug || '').trim().toLowerCase()) {
  return Astro.redirect(adminBasePath);
}

const securityAdminAccess = await resolveSecurityAdminAccess(adminContext, {
  baseUrl: pocketbaseUrl,
  token: adminAuthToken,
});
const canRenderSecurity = securityAdminAccess.allowed;
const showSecurityGate = securityAdminAccess.isPrimaryAdmin && !securityAdminAccess.capability.allowed;
if (!canRenderSecurity && !showSecurityGate) {
  return new Response('No se encontró la página solicitada.', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store, max-age=0',
      Pragma: 'no-cache',
      'X-Robots-Tag': 'noindex, nofollow, noarchive',
    },
  });
}

const storeAccess = securityAdminAccess.storeAccess!;
const canManageSecurity = canRenderSecurity && securityAdminAccess.canManage;
const securitySettings = canRenderSecurity
  ? await getStoreSecuritySettings(currentStoreId, authPb)
  : getDefaultSecuritySettings(currentStoreId);
if (canRenderSecurity && (!securitySettings.exists || !isStoreSecurityEnabled(securitySettings))) {
  return Astro.redirect(adminBasePath);
}

const requestMethod = Astro.request.method.toUpperCase();
let formData: FormData | null = null;
let viewError = '';

if (canRenderSecurity && requestMethod === 'POST' && !canManageSecurity) {
  viewError = 'No tienes permiso para modificar la configuraciÃ³n de Seguridad.';
} else if (canRenderSecurity && requestMethod === 'POST') {
  const contentType = String(Astro.request.headers.get('content-type') || '').toLowerCase();
  const isFormRequest = contentType.includes('application/x-www-form-urlencoded') || contentType.includes('multipart/form-data');
  if (isFormRequest) {
    formData = await Astro.request.formData();
  } else {
    viewError = 'No se pudo procesar la busqueda enviada.';
  }
}

const params = getMonitoringParams(Astro.url, formData);
const notice = String(Astro.url.searchParams.get('notice') || '').trim();
const noticeMessages: Record<string, string> = {
  customer_archived: 'Cliente archivado.',
  customer_restored: 'Cliente restaurado.',
  profile_deleted: 'Ficha de Seguridad eliminada. Los pedidos comerciales se conservaron.',
  observation_updated: 'Observacion actualizada.',
  block_created: 'Bloqueo creado.',
  manual_ip_block_created: 'Bloqueo manual por IP creado.',
  block_device_confirmed: 'Dispositivo agregado al bloqueo.',
  block_device_dismissed: 'Dispositivo pendiente descartado.',
  block_revoked: 'Bloqueo revocado.',
  vpn_policy_updated: 'Politica de VPN actualizada.',
};
const viewNotice = noticeMessages[notice] || '';
let summary: SecuritySummary | null = null;
let summaryError = false;
let customerUnavailable = false;
let customersResult: PaginatedResult<SecurityCustomer> | null = null;
let activityResult: PaginatedResult<SecurityEventRow> | null = null;
let visitorsResult: PaginatedResult<SecurityVisitorSessionRow> | null = null;
let blocksResult: PaginatedResult<SecurityBlock> | null = null;
let blocksMetrics: SecurityBlocksMetrics | null = null;
let selectedCustomer: SecurityCustomer | null = null;
let customerOrders: PaginatedResult<SecurityOrder> | null = null;
let customerEvents: PaginatedResult<SecurityEventRow> | null = null;
let customerPhones: SecurityCustomerPhone[] = [];
let customerDevices: SecurityCustomerDevice[] = [];
let customerLinksSummary: SecurityCustomerLinksSummary | null = null;
let customerLifecycleCounts: SecurityCustomerLifecycleCounts | null = null;
let activeBlocks: SecurityBlock[] = [];
let blockHistorySummary: SecurityBlockHistorySummary | null = null;
let blockCapabilities: SecurityBlockCapabilities | null = null;
let availableSignals: SecurityAvailableSignals | null = null;
let addressCandidates: SecurityAddressCandidate[] = [];
let customerIdentityWarnings: string[] = [];
let mergeCandidates: SecurityCustomer[] = [];
let customerOrdersError = false;
let customerEventsError = false;
let manualIpDraft: ManualIpBlockDraft | null = null;
let manualIpDeviceLookup: ManualIpDeviceLookupResult | null = null;

if (canRenderSecurity) {
  try {
    summary = await getSecurityMonitoringSummary(authPb, currentStoreId);
  } catch (_) {
    summaryError = true;
  }

  try {
  if (formData && String(formData.get('security_action') || '') === 'customer_observation') {
    const targetCustomerId = String(formData.get('customer') || '').trim();
    const observationAction = String(formData.get('observation_action') || '').trim() === 'disable' ? 'disable' : 'enable';
    const reason = String(formData.get('observation_reason') || '').trim();
    try {
      await runSecurityCustomerObservation(authPb, currentStoreId, targetCustomerId, observationAction, reason);
      return Astro.redirect(`${adminSecurityPath}?section=customers&customer=${encodeURIComponent(targetCustomerId)}&notice=observation_updated`);
    } catch (_) {
      viewError = 'No se pudo actualizar la observacion. Revisa el motivo, estado y permisos.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'security_block_create') {
    const targetCustomerId = String(formData.get('customer') || '').trim();
    try {
      await runSecurityBlockCreate(authPb, currentStoreId, targetCustomerId, {
        scope: String(formData.get('block_scope') || 'orders') as any,
        duration: String(formData.get('block_duration') || 'days_7') as any,
        matchPhone: formData.get('match_phone') === 'on',
        matchDevice: formData.get('match_device') === 'on',
        matchIp: formData.get('match_ip') === 'on',
        matchMode: String(formData.get('match_mode') || 'any') as any,
        addressOrderIds: formData.getAll('block_address_order_ids').map(String),
        reason: String(formData.get('block_reason') || '').trim(),
      });
      return Astro.redirect(`${adminSecurityPath}?section=customers&customer=${encodeURIComponent(targetCustomerId)}&notice=block_created`);
    } catch (_) {
      viewError = 'No se pudo crear el bloqueo. Revisa capacidades, solapamientos, senales disponibles y motivo.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'manual_ip_block_create') {
    try {
      await runSecurityManualIpBlockCreate(authPb, currentStoreId, {
        ip: String(formData.get('manual_ip') || ''),
        scope: String(formData.get('block_scope') || 'orders') as any,
        duration: String(formData.get('block_duration') || 'hours_24') as any,
        visitorSessionId: String(formData.get('visitor_session_id') || ''),
        ipSourceIds: formData.getAll('manual_ip_source_ids').map(String),
        deviceSessionIds: formData.getAll('manual_device_session_ids').map(String),
        reason: String(formData.get('block_reason') || '').trim(),
      });
      return Astro.redirect(`${adminSecurityPath}?section=blocked&notice=manual_ip_block_created`);
    } catch (_) {
      viewError = 'No se pudo crear el bloqueo por IP. Revisa que sea una IP publica exacta, que no exista un bloqueo solapado y que las capacidades esten activas.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'manual_ip_device_preview') {
    manualIpDraft = {
      ip: String(formData.get('manual_ip') || '').trim(),
      visitorSessionId: String(formData.get('visitor_session_id') || '').trim(),
      scope: String(formData.get('block_scope') || 'orders') as any,
      duration: String(formData.get('block_duration') || 'hours_24') as any,
      reason: String(formData.get('block_reason') || '').trim(),
    };
    try {
      manualIpDeviceLookup = await getSecurityManualIpDeviceCandidates(authPb, currentStoreId, {
        ip: manualIpDraft.ip,
        visitorSessionId: manualIpDraft.visitorSessionId,
      });
    } catch (_) {
      viewError = 'No se pudieron buscar dispositivos para esa IP. Revisa el valor y vuelve a intentarlo.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'vpn_policy_update') {
    try {
      await updateSecurityVpnPolicy(
        authPb,
        currentStoreId,
        String(formData.get('vpn_policy') || 'off') as any
      );
      return Astro.redirect(`${adminSecurityPath}?section=rules&notice=vpn_policy_updated`);
    } catch (_) {
      viewError = 'No se pudo actualizar la politica de VPN. El modo Bloquear requiere Proteccion activa.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'block_device_candidate_review') {
    const action = String(formData.get('device_review_action') || '') === 'dismiss' ? 'dismiss' : 'confirm';
    try {
      await runSecurityBlockDeviceCandidateAction(
        authPb,
        currentStoreId,
        String(formData.get('block_id') || '').trim(),
        String(formData.get('candidate_id') || '').trim(),
        action,
        String(formData.get('device_review_reason') || '').trim()
      );
      const nextNotice = action === 'confirm' ? 'block_device_confirmed' : 'block_device_dismissed';
      return Astro.redirect(`${adminSecurityPath}?section=blocked&notice=${nextNotice}`);
    } catch (_) {
      viewError = 'No se pudo revisar el dispositivo. Confirma que el bloqueo siga activo, el candidato este pendiente y el motivo sea valido.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'security_block_revoke') {
    const blockId = String(formData.get('block_id') || '').trim();
    const targetCustomerId = String(formData.get('customer') || '').trim();
    const returnSection = String(formData.get('return_section') || '').trim() === 'blocked' ? 'blocked' : 'customers';
    try {
      await runSecurityBlockRevoke(authPb, currentStoreId, blockId, String(formData.get('revoke_reason') || '').trim());
      if (returnSection === 'blocked') return Astro.redirect(`${adminSecurityPath}?section=blocked&notice=block_revoked`);
      return Astro.redirect(`${adminSecurityPath}?section=customers&customer=${encodeURIComponent(targetCustomerId)}&notice=block_revoked`);
    } catch (_) {
      viewError = 'No se pudo desbloquear al cliente. Revisa el motivo, estado y permisos.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'customer_lifecycle') {
    const targetCustomerId = String(formData.get('customer') || '').trim();
    const lifecycleAction = String(formData.get('lifecycle_action') || '').trim() as any;
    const reason = String(formData.get('lifecycle_reason') || '').trim();
    try {
      await runSecurityCustomerLifecycle(authPb, currentStoreId, targetCustomerId, lifecycleAction, reason);
      if (lifecycleAction === 'delete_profile') {
        return Astro.redirect(`${adminSecurityPath}?section=customers&notice=profile_deleted`);
      }
      if (lifecycleAction === 'archive') {
        return Astro.redirect(`${adminSecurityPath}?section=customers&customer_status=archived&customer=${encodeURIComponent(targetCustomerId)}&notice=customer_archived`);
      }
      return Astro.redirect(`${adminSecurityPath}?section=customers&customer=${encodeURIComponent(targetCustomerId)}&notice=customer_restored`);
    } catch (error: any) {
      viewError = lifecycleAction === 'archive' && String(error?.response?.error || '') === 'active_blocks'
        ? 'Desbloquea al cliente antes de archivarlo.'
        : 'No se pudo completar la accion sobre el cliente. Revisa el motivo y los permisos.';
    }
  }

  if (formData && String(formData.get('security_action') || '') === 'merge_customers') {
    const sourceCustomerId = String(formData.get('source_customer_id') || '').trim();
    const reason = String(formData.get('merge_reason') || '').trim();
    try {
      const canonicalId = await mergeSecurityCustomers(authPb, currentStoreId, params.customerId, sourceCustomerId, reason);
      return Astro.redirect(`${adminSecurityPath}?section=customers&customer=${encodeURIComponent(canonicalId)}`);
    } catch (_) {
      viewError = 'No se pudo unir estos clientes. Revisa el cliente seleccionado y el motivo interno.';
    }
  }

  if (params.section === 'customers') {
    customersResult = await getSecurityCustomersPage(
      authPb,
      currentStoreId,
      params.customersPage,
      params.customerStatus,
      params.customerSearch
    );

    if (params.customerId) {
      try {
        const customerDetail = await getSecurityCustomerDetail(
          authPb,
          currentStoreId,
          params.customerId,
          params.customerOrdersPage,
          params.customerEventsPage
        );
        selectedCustomer = customerDetail.customer;
        if (selectedCustomer) {
          customerOrders = customerDetail.orders;
          customerEvents = customerDetail.events;
          customerPhones = customerDetail.phones;
          customerDevices = customerDetail.devices;
          customerLinksSummary = customerDetail.linksSummary;
          customerLifecycleCounts = customerDetail.lifecycleCounts;
          activeBlocks = customerDetail.activeBlocks;
          blockHistorySummary = customerDetail.blockHistorySummary;
          blockCapabilities = customerDetail.blockCapabilities;
          availableSignals = customerDetail.availableSignals;
          addressCandidates = customerDetail.addressCandidates;
          customerIdentityWarnings = customerDetail.identityWarnings;
          customerOrdersError = customerDetail.ordersError;
          customerEventsError = customerDetail.eventsError;
          if (params.mergeSearch) {
            mergeCandidates = await getSecurityMergeCandidates(authPb, currentStoreId, selectedCustomer.id, params.mergeSearch);
          }
        } else {
          customerUnavailable = true;
        }
      } catch (error: any) {
        if (error?.status === 404) {
          customerUnavailable = true;
        } else {
          viewError = viewError || 'No se pudo cargar la ficha de cliente en este momento.';
        }
      }
      if (!selectedCustomer && !customerUnavailable) {
        customerUnavailable = true;
      }
    }
  }

  if (params.section === 'activity') {
    activityResult = await getSecurityActivityPage(
      authPb,
      currentStoreId,
      params.activityPage,
      params.eventType,
      params.eventRisk
    );
  }

  if (params.section === 'visitors') {
    visitorsResult = await getSecurityVisitorsPage(authPb, currentStoreId, params.visitorsPage, params.visitorRange);
  }

  if (params.section === 'blocked') {
    const blocksPage = await getSecurityBlocksPage(
      authPb,
      currentStoreId,
      params.blockedPage,
      params.blockedStatus,
      params.blockedScope,
      params.blockedSearch,
      params.blockedFocusId
    );
    blocksResult = blocksPage.blocks;
    blocksMetrics = blocksPage.metrics;
  }
  } catch (_) {
    viewError = viewError || 'No se pudieron cargar los datos de seguridad en este momento.';
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seguridad | Admin</title>
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <style is:global>
      :root {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --page: #eef3f9;
        --text: #0f172a;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body {
        color: var(--text);
        background:
          radial-gradient(circle at 14% 0%, rgba(37, 99, 235, .15), transparent 30%),
          radial-gradient(circle at 85% 8%, rgba(22, 163, 74, .10), transparent 25%),
          linear-gradient(180deg, #f8fbff 0%, var(--page) 48%, #e8eef7 100%);
      }

      a { color: inherit; text-decoration: none; }
      button { font: inherit; }

      .app-shell { width: min(1480px, 100%); margin: 0 auto; padding: 24px; }
      .main-wrap { min-width: 0; padding: 2px 0 96px; }

      @media (min-width: 1024px) {
        body { padding-left: calc(var(--pz-admin-sidebar-width, 278px) + var(--pz-admin-content-gap, 30px)); }
        .app-shell { padding: var(--pz-admin-content-top, 28px) var(--pz-admin-content-right, 32px) var(--pz-admin-content-bottom, 48px) 0; }
      }

      @media (max-width: 760px) {
        .app-shell { padding: 14px 14px 110px; }
      }
    </style>
  </head>
  <body>
    <AdminSidebar
      storeSlug={currentStoreSlug}
      storeName={currentStoreName}
      storePlanValues={adminContext.store}
      activeSection="security"
      mobileTitle="Seguridad"
      storeId={currentStoreId}
      pocketbaseUrl={pocketbaseUrl}
      authToken={adminAuthToken}
    />
    {canRenderSecurity && (
      <LastModificationMeta
        controllerOnly={true}
        pocketbaseUrl={pocketbaseUrl}
        enabled={storeAccess.access.is_primary_admin === true}
        showActor={storeAccess.access.is_primary_admin === true}
      />
    )}

    <div class="app-shell admin-view">
      <main class="main-wrap">
        <AdminSectionHeader
          kicker="Control de tienda"
          title="Seguridad"
          description={`Clientes y actividad privada para ${currentStoreName}.`}
          bellId="security-bell"
        />

        {canRenderSecurity ? (
          <SecurityMonitoringView
            context="store"
            storeName={currentStoreName}
            basePath={adminSecurityPath}
            adminOrdersPath={adminOrdersPath}
            actionsEnabled={canManageSecurity}
            params={params}
            settings={securitySettings}
            summary={summary}
            summaryError={summaryError}
            viewNotice={viewNotice}
            viewError={viewError}
            customerUnavailable={customerUnavailable}
            customersResult={customersResult}
            activityResult={activityResult}
            visitorsResult={visitorsResult}
            blocksResult={blocksResult}
            blocksMetrics={blocksMetrics}
            selectedCustomer={selectedCustomer}
            customerOrders={customerOrders}
            customerEvents={customerEvents}
            customerPhones={customerPhones}
            customerDevices={customerDevices}
            customerLinksSummary={customerLinksSummary}
            customerLifecycleCounts={customerLifecycleCounts}
            activeBlocks={activeBlocks}
            blockHistorySummary={blockHistorySummary}
            blockCapabilities={blockCapabilities}
            availableSignals={availableSignals}
            addressCandidates={addressCandidates}
            customerIdentityWarnings={customerIdentityWarnings}
            mergeCandidates={mergeCandidates}
            customerOrdersError={customerOrdersError}
            customerEventsError={customerEventsError}
            manualIpDraft={manualIpDraft}
            manualIpDeviceLookup={manualIpDeviceLookup}
          />
        ) : (
          <section data-security-premium-gate>
            <StoreCapabilityGate
              access={securityAdminAccess.capability}
              featureName="Seguridad"
              featureDescription="Monitorea clientes, actividad y visitantes, y administra bloqueos privados desde el Plan Premium."
              preservationMessage="Tu configuración, clientes, eventos, bloqueos y auditoría permanecen guardados y volverán a estar disponibles al regresar a Premium."
              requiredPlanLabel="Plan Premium requerido"
              infoTitle="Tu historial está protegido"
              infoDescription="El cambio de plan no elimina ni modifica la información de Seguridad existente."
              planExpiredUsesPlanGate={true}
            />
          </section>
        )}
      </main>
    </div>
  </body>
</html>
