---
import RafflePublicPage from '../../../../components/public-store/RafflePublicPage.astro';
import { getSettings } from '../../../../lib/api';
import { StoreResolutionError, getCurrentStore } from '../../../../lib/stores';
import { getPublicRafflePageData } from '../../../../lib/raffles';
import {
  rafflesUnavailableRedirectResponse,
  resolveRafflesCapability,
} from '../../../../lib/raffleAccess';

let currentStore;

try {
  currentStore = await getCurrentStore(Astro, { fresh: true });
} catch (error) {
  if (error instanceof StoreResolutionError) {
    return Astro.redirect('/');
  }

  throw error;
}

if (!resolveRafflesCapability(currentStore).allowed) {
  return rafflesUnavailableRedirectResponse(currentStore);
}

const raffleSlug = String(Astro.params.raffleSlug || '').trim();
const settings = await getSettings({ storeId: currentStore.id }).catch(() => null);
const { raffle, occupiedNumbers } = await getPublicRafflePageData(currentStore.slug, raffleSlug);
const canonicalPath = `/t/${encodeURIComponent(currentStore.slug)}/rifa/${encodeURIComponent(raffle?.slug || raffleSlug)}`;
---

<RafflePublicPage
  store={currentStore}
  settings={settings}
  raffle={raffle}
  occupiedNumbers={occupiedNumbers}
  canonicalPath={canonicalPath}
/>
