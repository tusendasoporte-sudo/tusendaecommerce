---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import MasterShell from '../../components/master/MasterShell.astro';
import MasterIcon from '../../components/master/MasterIcon.astro';
import type { MasterIconName } from '../../lib/masterIcons';
import { refreshAuthFromCookie, requireMasterAdmin } from '../../lib/auth';
import { serverPocketBaseUrl } from '../../lib/pocketBaseServerUrl';
import { getMasterStoreUserCount } from '../../lib/masterUsers';
import { getMasterStoreActivitySummary } from '../../lib/masterStoreActivity';
import { getMasterGlobalOverview } from '../../lib/masterStoreOverview';
import { getMasterNotificationsFeed } from '../../lib/masterNotifications';
import { getMasterSecuritySettingsMap } from '../../lib/security';
import { getMasterStoreCounts } from '../../lib/stores';
import { getMasterStoreAppEngineUpdates } from '../../lib/masterStoreAppBuilds';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const legacyPage = Astro.url.searchParams.get('stores_page');
if (legacyPage) {
  const page = Math.max(1, Math.floor(Number(legacyPage) || 1));
  return Astro.redirect(`/master/stores?stores_page=${page}#tiendas-registradas`);
}

const authPb = await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
const masterUser = requireMasterAdmin(authPb.authStore.record as any);
if (!authPb.authStore.isValid || !authPb.authStore.record) return Astro.redirect('/master-login');
if (!masterUser) return Astro.redirect('/master');

const pocketbaseUrl = serverPocketBaseUrl();
const [storeCounts, totalUsers, activity, overviewResult, notificationFeed, securityMap, engineUpdatesResult] = await Promise.all([
  getMasterStoreCounts(authPb),
  getMasterStoreUserCount(authPb),
  getMasterStoreActivitySummary(pocketbaseUrl, authPb.authStore.token),
  getMasterGlobalOverview(pocketbaseUrl, authPb.authStore.token),
  getMasterNotificationsFeed(pocketbaseUrl, authPb.authStore.token, 5),
  getMasterSecuritySettingsMap(authPb),
  getMasterStoreAppEngineUpdates(pocketbaseUrl, authPb.authStore.token),
]);

const overview = overviewResult.data;
const ordersTotal = activity.items.reduce((total, item) => total + item.orders_total, 0);
const ordersRecent = activity.items.reduce((total, item) => total + item.orders_30d, 0);
const visitorsRecent = activity.items.reduce((total, item) => total + item.visitors_30d, 0);
const pageviewsRecent = activity.items.reduce((total, item) => total + item.pageviews_30d, 0);
const securityValues = Array.from(securityMap.values());
const securityEnabled = securityValues.filter((item) => item.enabled).length;
const securityProtected = securityValues.filter((item) => item.enabled && item.mode === 'protection').length;
const engineUpdates = engineUpdatesResult.data;
const metrics = [
  ['Tiendas totales', storeCounts.total, 'Todas las tiendas registradas'],
  ['Tiendas activas', storeCounts.active, 'Disponibles al público'],
  ['Tiendas suspendidas', storeCounts.suspended, 'Acceso público detenido'],
  ['Usuarios de tienda', totalUsers, 'Administradores y empleados'],
  ['Pedidos históricos', ordersTotal, 'Todas las tiendas'],
  ['Pedidos últimos 30 días', ordersRecent, 'Todos los estados'],
  ['Visitantes registrados por tienda', visitorsRecent, 'Suma por tienda · 30 días'],
  ['Páginas vistas últimos 30 días', pageviewsRecent, 'Solo páginas vistas'],
  ['Productos en seguimiento activo', overview?.metrics.active_price_watches || 0, 'Seguimiento global'],
  ['Notificaciones Master no leídas', overview?.metrics.unread_notifications || 0, 'Centro de notificaciones'],
] as const;

function number(value: unknown) {
  return new Intl.NumberFormat('es').format(Math.max(0, Number(value || 0)));
}

function relative(value: string) {
  const parsed = new Date(value).getTime();
  if (!Number.isFinite(parsed)) return 'Sin fecha';
  const minutes = Math.max(0, Math.floor((Date.now() - parsed) / 60000));
  if (minutes < 1) return 'Ahora';
  if (minutes < 60) return `Hace ${minutes} min`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `Hace ${hours} h`;
  return `Hace ${Math.floor(hours / 24)} d`;
}

function icon(type: string): MasterIconName {
  if (type === 'order_created') return 'cart';
  if (type === 'price_changed') return 'price';
  if (type === 'security_event') return 'security';
  if (type === 'user_created') return 'user-plus';
  return 'clock';
}

const displayName = String(masterUser.display_name || masterUser.name || masterUser.email || '').trim();
---

<Layout isMaster={true}>
  <MasterShell currentUrl={Astro.url.toString()} displayName={displayName} title="Resumen">
    <section class="master-page">
      <header class="master-overview-heading">
        <div><h2>Panel Master</h2><p>Gestión global de tiendas y supervisión de la plataforma.</p></div>
      </header>

      {!overviewResult.available && <div class="master-error" role="alert">El overview privado no está disponible. No se muestran datos estimados para seguimiento ni notificaciones.</div>}

      {engineUpdates && engineUpdates.update_count > 0 && (
        <section class:list={['master-engine-update-alert', { 'is-critical': engineUpdates.critical_count > 0 }]} role="alert" aria-live="polite">
          <span class="master-engine-update-alert__icon"><MasterIcon name="alert" size={26} /></span>
          <div class="master-engine-update-alert__copy">
            <strong>{number(engineUpdates.update_count)} {engineUpdates.update_count === 1 ? 'app necesita' : 'apps necesitan'} actualizar el motor nativo</strong>
            <span>Versión aprobada {engineUpdates.engine_release.version}. La alerta no compila ni publica: cada tienda requiere vista previa y confirmación Master.</span>
            <div class="master-engine-update-alert__apps">
              {engineUpdates.apps.slice(0, 5).map((item) => (
                <a href={item.action_url}>{item.store.name || item.display_name}<small>{item.engine_update.current_version || 'Sin trazabilidad'} → {item.engine_update.target_version}</small></a>
              ))}
              {engineUpdates.update_count > 5 && <span>+{number(engineUpdates.update_count - 5)} pendientes</span>}
            </div>
          </div>
          <a class="master-btn master-btn--primary" href="/master/stores">Revisar tiendas</a>
        </section>
      )}

      {engineUpdates && engineUpdates.delivery_pending_count > 0 && (
        <section class="master-engine-update-alert is-delivery" role="alert" aria-live="polite">
          <span class="master-engine-update-alert__icon"><MasterIcon name="bell" size={26} /></span>
          <div class="master-engine-update-alert__copy">
            <strong>{number(engineUpdates.delivery_pending_count)} {engineUpdates.delivery_pending_count === 1 ? 'actualización lista' : 'actualizaciones listas'} para enviar por WhatsApp</strong>
            <span>
              El APK ya fue generado. El panel solo prepara el mensaje y abre WhatsApp;
              {engineUpdates.manual_whatsapp_sender.configured
                ? ` el remitente configurado es +${engineUpdates.manual_whatsapp_sender.whatsapp_number}.`
                : ' primero debes configurar el número oficial del Master.'}
            </span>
            <div class="master-engine-update-alert__apps">
              {engineUpdates.deliveries.slice(0, 5).map((item) => (
                <a href={item.action_url}>
                  {item.store.name || item.display_name}
                  <small>{item.version_name} · {item.recipient.status === 'ready' ? `+${item.recipient.whatsapp_number}` : 'Revisar administrador principal'}</small>
                </a>
              ))}
              {engineUpdates.delivery_pending_count > 5 && <span>+{number(engineUpdates.delivery_pending_count - 5)} pendientes</span>}
            </div>
          </div>
          <a class="master-btn master-btn--primary" href={engineUpdates.deliveries[0]?.action_url || '/master/stores'}>Preparar envío</a>
        </section>
      )}

      <div class="master-kpi-grid" aria-label="Resumen global">
        {metrics.map(([label, value, meta]) => (
          <article class="master-kpi"><span class="master-kpi__label">{label}</span><strong class="master-kpi__value">{number(value)}</strong><span class="master-kpi__meta">{meta}</span></article>
        ))}
      </div>

      <div class="master-overview-grid">
        <div class="master-overview-column">
          <section class="master-card">
            <header class="master-card-header"><h3 class="master-card-title">Actividad reciente de plataforma</h3></header>
            <div class="master-card-body master-activity-list">
              {overview?.recent_activity.length ? overview.recent_activity.map((item) => (
                <article class="master-activity-item"><span class="master-activity-icon"><MasterIcon name={icon(item.type)} size={20} /></span><div class="master-activity-copy"><time datetime={item.created}>{relative(item.created)}</time><strong>{item.label}</strong><span>{item.detail}</span></div><a class="master-btn master-btn--secondary" href={item.action_url}>{item.action_label || 'Abrir'}</a></article>
              )) : <p class="master-empty">No hay actividad reciente.</p>}
            </div>
          </section>

          <section class="master-card">
            <header class="master-card-header"><h3 class="master-card-title">Tiendas con mayor actividad</h3><a class="master-btn master-btn--secondary" href="/master/stores">Ver todas las tiendas</a></header>
            <div class="master-card-body master-activity-list">
              {overview?.top_stores.length ? overview.top_stores.map((store) => (
                <article class="master-activity-item"><span class="master-activity-icon"><MasterIcon name="stores" size={20} /></span><div class="master-activity-copy"><strong>{store.name}</strong><span>{number(store.orders_30d)} pedidos · {number(store.visitors_30d)} visitantes · {number(store.pageviews_30d)} páginas vistas</span><time datetime={store.last_activity_at}>{relative(store.last_activity_at)}</time></div><a class="master-btn master-btn--secondary" href={store.action_url}>Abrir panel</a></article>
              )) : <p class="master-empty">No hay actividad de tiendas en los últimos 30 días.</p>}
            </div>
          </section>
        </div>

        <div class="master-overview-column">
          <section class="master-card">
            <header class="master-card-header"><h3 class="master-card-title">Notificaciones recientes</h3><a class="master-btn master-btn--secondary" href="/master/notifications">Ver todas</a></header>
            <div class="master-card-body master-activity-list">
              {notificationFeed.items.length ? notificationFeed.items.map((item) => (
                <article class="master-activity-item"><span class="master-activity-icon"><MasterIcon name="bell" size={20} /></span><div class="master-activity-copy"><strong>{item.title}</strong><span>{item.message}</span><time datetime={item.last_event_at}>{relative(item.last_event_at)}</time></div><a class="master-btn master-btn--secondary" href={item.action_url}>Abrir</a></article>
              )) : <p class="master-empty">No hay notificaciones recientes.</p>}
            </div>
          </section>

          <section class="master-card">
            <header class="master-card-header"><h3 class="master-card-title">Estado general de Seguridad</h3></header>
            <div class="master-card-body master-team-grid">
              <article class="master-mini-stat"><span>Tiendas configuradas</span><strong>{number(securityValues.length)}</strong></article>
              <article class="master-mini-stat"><span>Seguridad habilitada</span><strong>{number(securityEnabled)}</strong></article>
              <article class="master-mini-stat"><span>Protección activa</span><strong>{number(securityProtected)}</strong></article>
            </div>
          </section>
        </div>
      </div>
    </section>
  </MasterShell>
</Layout>

<style>
  .master-engine-update-alert { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem; padding: 1rem 1.1rem; border: 1px solid #e7b75b; border-radius: 16px; background: #fff8e2; color: #61450a; box-shadow: 0 14px 34px rgba(146, 94, 0, .1); }
  .master-engine-update-alert.is-critical { border-color: #ef9a9a; background: #fff0f0; color: #8f1d1d; }
  .master-engine-update-alert.is-delivery { border-color: #87d3a4; background: #effaf3; color: #17643a; }
  .master-engine-update-alert__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 13px; background: rgba(255,255,255,.78); }
  .master-engine-update-alert__copy { display: grid; gap: .3rem; min-width: 0; }
  .master-engine-update-alert__copy > span { line-height: 1.45; }
  .master-engine-update-alert__apps { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .35rem; }
  .master-engine-update-alert__apps a, .master-engine-update-alert__apps > span { display: inline-flex; align-items: center; gap: .35rem; padding: .42rem .62rem; border-radius: 999px; background: rgba(255,255,255,.8); color: inherit; font-size: .82rem; font-weight: 800; text-decoration: none; }
  .master-engine-update-alert__apps small { font-weight: 600; opacity: .75; }
  @media (max-width: 760px) {
    .master-engine-update-alert { grid-template-columns: auto 1fr; }
    .master-engine-update-alert > .master-btn { grid-column: 1 / -1; }
  }
</style>
