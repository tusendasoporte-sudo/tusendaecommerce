---
export const prerender = false;

import Layout from '../../../../../layouts/Layout.astro';
import { refreshAuthFromCookie, requireMasterAdmin } from '../../../../../lib/auth';
import { getStoreSecuritySettings } from '../../../../../lib/security';
import {
  getSecurityVisitorDetail,
  isValidRecordId,
  normalizePage,
  normalizeVisitorRangeFilter,
  type PaginatedResult,
  type SecurityOrder,
  type SecurityVisitorNetworkHistoryRow,
  type SecurityVisitorPageviewRow,
  type SecurityVisitorSessionRow,
} from '../../../../../lib/securityMonitoring';
import SecurityVisitorDetailView from '../../../../../components/admin/SecurityVisitorDetailView.astro';
import MasterShell from '../../../../../components/master/MasterShell.astro';
import { resolveStorePlanPresentation } from '../../../../../lib/storePlanPresentation';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const authPb = await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
const masterUser = requireMasterAdmin(authPb.authStore.record as any);

if (!authPb.authStore.isValid || !authPb.authStore.record) {
  return Astro.redirect('/master-login');
}

if (!masterUser) {
  return Astro.redirect('/master');
}
const displayName = String(masterUser.display_name || masterUser.name || masterUser.email || '').trim();

const storeId = String(Astro.params.storeId || '').trim();
const visitorSessionId = String(Astro.params.visitorSessionId || '').trim();

if (!isValidRecordId(storeId) || !isValidRecordId(visitorSessionId)) {
  return Astro.redirect('/master/stores');
}

let storeRecord: any = null;
try {
  storeRecord = await authPb.collection('stores').getOne(storeId, {
    fields: 'id,name,slug,status,plan,plan_expires_at,plan_is_permanent',
  });
} catch (_) {
  return Astro.redirect('/master/stores');
}

const securitySettings = await getStoreSecuritySettings(storeId, authPb);
if (!securitySettings.exists) {
  return Astro.redirect(`/master/stores/${encodeURIComponent(storeId)}`);
}

const page = normalizePage(Astro.url.searchParams.get('page'));
const ordersPage = normalizePage(Astro.url.searchParams.get('orders_page'));
const networkPage = normalizePage(Astro.url.searchParams.get('network_page'));
const visitorRange = normalizeVisitorRangeFilter(Astro.url.searchParams.get('visitor_range'));
const fullHistory = Astro.url.searchParams.get('history') === 'full';
const storeName = String(storeRecord?.name || storeRecord?.slug || 'Tienda').trim();
const currentStore = {
  id: storeId,
  name: storeName,
  slug: String(storeRecord?.slug || ''),
  status: String(storeRecord?.status || '') === 'active' ? 'active' : 'suspended',
  planPresentation: resolveStorePlanPresentation(storeRecord),
};
const basePath = `/master/security/${encodeURIComponent(storeId)}`;
let visitor: SecurityVisitorSessionRow | null = null;
let orders: PaginatedResult<SecurityOrder> | null = null;
let ordersError = false;
let networkHistory: PaginatedResult<SecurityVisitorNetworkHistoryRow> | null = null;
let pageviews: PaginatedResult<SecurityVisitorPageviewRow> | null = null;
let viewError = '';

try {
  const detail = await getSecurityVisitorDetail(authPb, storeId, visitorSessionId, page, ordersPage, visitorRange, fullHistory, networkPage);
  visitor = detail.visitor;
  if (!visitor) return Astro.redirect(`${basePath}?section=visitors`);
  orders = detail.orders;
  ordersError = detail.ordersError;
  networkHistory = detail.networkHistory;
  pageviews = detail.pageviews;
} catch (_) {
  viewError = 'No se pudo cargar el detalle de este visitante en este momento.';
}

if (!visitor || !orders || !networkHistory || !pageviews) {
  return Astro.redirect(`${basePath}?section=visitors`);
}
---

<Layout isMaster={true}>
  <MasterShell currentUrl={Astro.url.toString()} displayName={displayName} title="Detalle de visitante" currentStore={currentStore}>
    <style>
      .master-security-shell { display: grid; gap: 18px; min-width: 0; padding: 6px 0 32px; }
    </style>
    <main class="master-security-shell">
      <SecurityVisitorDetailView
        storeName={storeName}
        basePath={basePath}
        backHref={`${basePath}?section=visitors${visitorRange === 'today' ? '' : `&visitor_range=${encodeURIComponent(visitorRange)}`}`}
        visitorRange={visitorRange}
        fullHistory={fullHistory}
        settings={securitySettings}
        visitor={visitor}
        orders={orders}
        ordersError={ordersError}
        networkHistory={networkHistory}
        pageviews={pageviews}
        viewError={viewError}
      />
    </main>
  </MasterShell>
</Layout>
