---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import MasterStoreProductsView from '../../../components/master/MasterStoreProductsView.astro';
import MasterShell from '../../../components/master/MasterShell.astro';
import { refreshAuthFromCookie, requireMasterAdmin } from '../../../lib/auth';
import {
  getMasterStoreProducts,
  isValidRecordId,
  normalizeMasterProductSort,
  normalizeMasterProductStatus,
  normalizeMasterProductWatchFilter,
  normalizeMasterProductsPage,
  type MasterProductsStore,
} from '../../../lib/masterStoreProducts';
import { resolveStorePlanPresentation } from '../../../lib/storePlanPresentation';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const authPb = await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
const masterUser = requireMasterAdmin(authPb.authStore.record as any);

if (!authPb.authStore.isValid || !authPb.authStore.record) {
  return Astro.redirect('/master-login');
}
if (!masterUser) {
  return Astro.redirect('/master');
}
const displayName = String(masterUser.display_name || masterUser.name || masterUser.email || '').trim();

const storeId = String(Astro.params.storeId || '').trim();
if (!isValidRecordId(storeId)) {
  return Astro.redirect('/master/stores');
}

let storeRecord: any = null;
try {
  storeRecord = await authPb.collection('stores').getOne(storeId, {
    fields: 'id,name,slug,status,plan,plan_expires_at,plan_is_permanent',
    requestKey: null,
  });
} catch (_) {
  return Astro.redirect('/master/stores');
}

const currentPage = normalizeMasterProductsPage(Astro.url.searchParams.get('page'));
const currentStatus = normalizeMasterProductStatus(Astro.url.searchParams.get('status'));
const currentSort = normalizeMasterProductSort(Astro.url.searchParams.get('sort'));
const currentWatch = normalizeMasterProductWatchFilter(Astro.url.searchParams.get('watch'));
const currentSearch = String(Astro.url.searchParams.get('q') || '').trim().slice(0, 100);
const categoryParam = String(Astro.url.searchParams.get('category') || '').trim();
const subcategoryParam = String(Astro.url.searchParams.get('subcategory') || '').trim();
const currentCategory = isValidRecordId(categoryParam) ? categoryParam : '';
const currentSubcategory = isValidRecordId(subcategoryParam) ? subcategoryParam : '';
const pocketbaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
const result = await getMasterStoreProducts(pocketbaseUrl, authPb.authStore.token, storeId, {
  page: currentPage,
  status: currentStatus,
  search: currentSearch,
  category_id: currentCategory,
  subcategory_id: currentSubcategory,
  sort: currentSort,
  watch: currentWatch,
});

if (result.status === 404 && result.error === 'store_not_found') {
  return Astro.redirect('/master/stores');
}

const fallbackStore: MasterProductsStore = {
  id: storeId,
  name: String(storeRecord?.name || storeRecord?.slug || 'Tienda').trim().slice(0, 160),
  slug: /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(String(storeRecord?.slug || '').trim().toLowerCase())
    ? String(storeRecord.slug).trim().toLowerCase()
    : '',
  status: String(storeRecord?.status || '').trim().toLowerCase() === 'active' ? 'active' : 'suspended',
};
const products = result.data;
const store = products?.store || fallbackStore;
const currentStore = { ...store, planPresentation: resolveStorePlanPresentation(storeRecord) };
const basePath = `/master/products/${encodeURIComponent(storeId)}`;
const viewError = result.available
  ? ''
  : result.status === 403
    ? 'La sesión Master no pudo autorizar esta consulta privada.'
    : result.status === 400
      ? 'Los filtros solicitados no pertenecen a esta tienda o no son válidos.'
      : 'No fue posible consultar el endpoint privado de productos. No se muestran datos parciales.';
---

<Layout isMaster={true}>
  <MasterShell currentUrl={Astro.url.toString()} displayName={displayName} title="Productos" currentStore={currentStore}>
    <MasterStoreProductsView
      products={products}
      store={store}
      basePath={basePath}
      currentStatus={currentStatus}
      currentSort={currentSort}
      currentWatch={currentWatch}
      currentSearch={currentSearch}
      currentCategory={currentCategory}
      currentSubcategory={currentSubcategory}
      viewError={viewError}
    />
  </MasterShell>
</Layout>
