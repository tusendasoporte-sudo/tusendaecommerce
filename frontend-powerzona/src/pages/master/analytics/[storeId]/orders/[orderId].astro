---
export const prerender = false;

import Layout from '../../../../../layouts/Layout.astro';
import MasterOrderReadonlyView from '../../../../../components/master/MasterOrderReadonlyView.astro';
import MasterShell from '../../../../../components/master/MasterShell.astro';
import { refreshAuthFromCookie, requireMasterAdmin } from '../../../../../lib/auth';
import {
  getMasterOrderReadonlyDetail,
  isValidRecordId,
} from '../../../../../lib/masterStoreAnalytics';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const authPb = await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
const masterUser = requireMasterAdmin(authPb.authStore.record as any);

if (!authPb.authStore.isValid || !authPb.authStore.record) {
  return Astro.redirect('/master-login');
}
if (!masterUser) {
  return Astro.redirect('/master');
}
const displayName = String(masterUser.display_name || masterUser.name || masterUser.email || '').trim();

const storeId = String(Astro.params.storeId || '').trim();
const orderId = String(Astro.params.orderId || '').trim();
if (!isValidRecordId(storeId) || !isValidRecordId(orderId)) {
  return Astro.redirect('/master/stores');
}

let storeRecord: any;
try {
  storeRecord = await authPb.collection('stores').getOne(storeId, {
    fields: 'id,name,slug,status',
    requestKey: null,
  });
} catch (_) {
  return Astro.redirect('/master/stores');
}

const currentStore = {
  id: storeId,
  name: String(storeRecord.name || storeRecord.slug || 'Tienda'),
  slug: String(storeRecord.slug || ''),
  status: storeRecord.status === 'active' ? 'active' : 'suspended',
};

const analyticsPath = `/master/analytics/${encodeURIComponent(storeId)}`;
const pocketbaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
const result = await getMasterOrderReadonlyDetail(
  pocketbaseUrl,
  authPb.authStore.token,
  storeId,
  orderId,
);

if (result.status === 404) {
  return Astro.redirect(analyticsPath);
}

const detail = result.data;
const viewError = result.status === 403
  ? 'La sesión Master no pudo autorizar este pedido.'
  : 'No fue posible consultar el detalle privado. No se muestran datos parciales.';
---

<Layout isMaster={true}>
  <MasterShell currentUrl={Astro.url.toString()} displayName={displayName} title="Detalle de pedido" currentStore={currentStore}>
    {detail ? (
      <MasterOrderReadonlyView detail={detail} analyticsPath={analyticsPath} />
    ) : (
      <main class="order-error-shell">
        <a href={analyticsPath}>Volver a Analíticas</a>
        <section role="alert">
          <span>Pedido · Solo lectura</span>
          <h1>Detalle temporalmente no disponible</h1>
          <p>{viewError}</p>
        </section>
      </main>
    )}
  </MasterShell>
  <style>
    .order-error-shell { display: grid; gap: 16px; padding: 12px 0 42px; }
    .order-error-shell > a { width: max-content; color: #1d4ed8; font-size: var(--master-font-meta); font-weight: 900; text-decoration: none; }
    .order-error-shell section { border: 1px solid #fed7aa; border-radius: 16px; background: #fff7ed; color: #9a3412; padding: clamp(22px, 5vw, 36px); }
    .order-error-shell span { font-size: var(--master-font-caption); font-weight: 950; letter-spacing: .07em; text-transform: uppercase; }
    .order-error-shell h1 { margin: 7px 0 0; font-size: var(--master-font-page-title); line-height: 1.05; font-weight: 1000; }
    .order-error-shell p { margin: 11px 0 0; font-size: var(--master-font-control); line-height: var(--master-line-normal); font-weight: 750; }
  </style>
</Layout>
