---
export const prerender = false;

import Layout from '../../../../../layouts/Layout.astro';
import MasterShell from '../../../../../components/master/MasterShell.astro';
import MasterStoreUserDetailView from '../../../../../components/master/MasterStoreUserDetailView.astro';
import { refreshAuthFromCookie, requireMasterAdmin } from '../../../../../lib/auth';
import { getMasterStoreUserAudit, getMasterStoreUserDetail } from '../../../../../lib/masterUsers';
import { getMasterPrimaryAdminStatus } from '../../../../../lib/masterPrimaryAdmin';
import { getMasterUserDeviceAudit, listMasterUserDevices } from '../../../../../lib/masterUserDevices';
import { resolveStorePlanPresentation } from '../../../../../lib/storePlanPresentation';
import { serverPocketBaseUrl } from '../../../../../lib/pocketBaseServerUrl';
import { getMasterStoreKind } from '../../../../../lib/promoMaster';
import '../../../../../styles/master-users.css';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const authPb = await refreshAuthFromCookie(Astro.request.headers.get('cookie') || '');
const masterUser = requireMasterAdmin(authPb.authStore.record as any);
if (!authPb.authStore.isValid || !masterUser) return Astro.redirect('/master-login');
const storeId = String(Astro.params.storeId || '').trim();
const userId = String(Astro.params.userId || '').trim();
if (!/^[a-z0-9]{15}$/.test(storeId) || !/^[a-z0-9]{15}$/.test(userId)) return Astro.redirect('/master/stores');
if (await getMasterStoreKind(serverPocketBaseUrl(), authPb.authStore.token, storeId) !== 'commerce') {
  return Astro.redirect(`/master/stores/${encodeURIComponent(storeId)}`);
}

let storeRecord: any;
try {
  storeRecord = await authPb.collection('stores').getOne(storeId, { fields: 'id,name,slug,status,plan,plan_started_at,plan_expires_at,plan_duration_months,plan_is_permanent,free_trial_used', requestKey: null });
} catch (_) {
  return Astro.redirect('/master/stores');
}

let data;
try {
  const [detail, devices, userAudit, deviceAudit, primaryAdmin] = await Promise.all([
    getMasterStoreUserDetail(storeId, userId, authPb),
    listMasterUserDevices(storeId, userId, { page: 1, perPage: 10, status: 'authorized' }, authPb),
    getMasterStoreUserAudit(storeId, userId, { page: 1, perPage: 20 }, authPb),
    getMasterUserDeviceAudit(storeId, userId, { page: 1, perPage: 20 }, authPb),
    getMasterPrimaryAdminStatus(storeId, authPb),
  ]);
  data = { detail, devices, userAudit, deviceAudit, primaryAdmin };
} catch (_) {
  return Astro.redirect(`/master/stores/${encodeURIComponent(storeId)}/users`);
}

const currentStore = {
  id: storeId,
  name: String(storeRecord.name || storeRecord.slug || 'Tienda'),
  slug: String(storeRecord.slug || ''),
  status: String(storeRecord.status || '') === 'active' ? 'active' : 'suspended',
  planPresentation: resolveStorePlanPresentation(storeRecord),
};
const displayName = String(masterUser.display_name || masterUser.name || masterUser.email || 'Master Admin');
---

<Layout isMaster={true}>
  <MasterShell currentUrl={Astro.url.toString()} displayName={displayName} title="Detalle de usuario" currentStore={currentStore}>
    <MasterStoreUserDetailView store={currentStore} {...data} />
  </MasterShell>
</Layout>
