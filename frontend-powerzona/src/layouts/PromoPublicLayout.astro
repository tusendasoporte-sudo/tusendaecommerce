---
import '../styles/promo-public-shell.css';
import type { PromoPublicSeo } from '../lib/promoPublicShell';

interface Props {
  lang: string;
  direction: 'ltr' | 'rtl';
  title: string;
  description: string;
  themeId: string;
  themeVersion: string;
  themeRenderer: string;
  themeTokens: Readonly<Record<string, string>>;
  seo: PromoPublicSeo;
}

const {
  lang,
  direction,
  title,
  description,
  themeId,
  themeVersion,
  themeRenderer,
  themeTokens,
  seo,
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={seo.canonical_url} />
    {seo.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={seo.x_default} />
    <link rel="sitemap" type="application/xml" href={seo.sitemap_url} />
    <meta property="og:type" content={seo.open_graph.type} />
    <meta property="og:url" content={seo.open_graph.url} />
    <meta property="og:title" content={seo.open_graph.title} />
    <meta property="og:description" content={seo.open_graph.description} />
    <meta property="og:site_name" content={seo.open_graph.site_name} />
    <meta property="og:locale" content={seo.open_graph.locale.replaceAll('-', '_')} />
    {seo.open_graph.alternate_locales.map((locale) => (
      <meta property="og:locale:alternate" content={locale.replaceAll('-', '_')} />
    ))}
    {seo.open_graph.image && <meta property="og:image" content={seo.open_graph.image.url} />}
    {seo.open_graph.image && <meta property="og:image:type" content={seo.open_graph.image.type} />}
    {seo.open_graph.image && <meta property="og:image:width" content={String(seo.open_graph.image.width)} />}
    {seo.open_graph.image && <meta property="og:image:height" content={String(seo.open_graph.image.height)} />}
    {seo.open_graph.image && <meta property="og:image:alt" content={seo.open_graph.image.alt} />}
    <meta name="twitter:card" content={seo.twitter.card} />
    <meta name="twitter:title" content={seo.twitter.title} />
    <meta name="twitter:description" content={seo.twitter.description} />
    {seo.twitter.image && <meta name="twitter:image" content={seo.twitter.image} />}
    {seo.twitter.image_alt && <meta name="twitter:image:alt" content={seo.twitter.image_alt} />}
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body
    data-promo-theme={themeId}
    data-promo-theme-version={themeVersion}
    data-promo-theme-renderer={themeRenderer}
    data-promo-token-surface={themeTokens.surface}
    data-promo-token-text={themeTokens.text}
    data-promo-token-accent={themeTokens.accent}
    data-promo-token-border={themeTokens.border}
    data-promo-token-focus={themeTokens.focus}
    data-promo-token-heading-font={themeTokens.heading_font}
    data-promo-token-body-font={themeTokens.body_font}
    data-promo-token-radius={themeTokens.radius}
    data-promo-token-shadow={themeTokens.shadow}
    data-promo-token-density={themeTokens.density}
    data-promo-token-motion={themeTokens.motion}
  >
    <slot />
    <script>
      const canonicalLink = document.querySelector('link[rel="canonical"]');
      const canonicalUrl = canonicalLink instanceof HTMLLinkElement ? new URL(canonicalLink.href) : null;
      const platformMatch = canonicalUrl?.hostname === 'tusenda84.com'
        ? canonicalUrl.pathname.match(/^\/promo\/([a-z0-9]+(?:-[a-z0-9]+)*)\/[A-Za-z0-9-]{2,80}$/)
        : null;
      const analyticsEndpoint = platformMatch
        ? `/api/promo/analytics/sites/${platformMatch[1]}`
        : '/api/promo/analytics/host';
      const analyticsLocale = document.documentElement.lang;
      const privacySignal = navigator.doNotTrack === '1' || navigator.globalPrivacyControl === true;
      const canGenerateEventId = typeof crypto?.randomUUID === 'function';

      function sendPromoEvent(eventType, sectionKey) {
        if (privacySignal || !canGenerateEventId || !canonicalUrl) return;
        const body = {
          contract: 'promo.analytics.collect.v1',
          event_id: crypto.randomUUID(),
          event_type: eventType,
          locale: analyticsLocale,
          ...(sectionKey ? { section_key: sectionKey } : {}),
        };
        void fetch(analyticsEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body),
          credentials: 'omit',
          cache: 'no-store',
          keepalive: true,
          referrerPolicy: 'no-referrer',
        }).catch(() => {});
      }

      if (!privacySignal && canGenerateEventId && canonicalUrl) {
        sendPromoEvent('page_view');
        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (target?.closest('[data-contact-action="primary"]')) sendPromoEvent('contact_activate');
          if (target?.closest('[data-promo-landing-qr-link]')) sendPromoEvent('landing_qr_open');
        }, { capture: true });

        if ('IntersectionObserver' in window) {
          const observed = new Set<string>();
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting || entry.intersectionRatio < 0.5) return;
              const id = entry.target.id || '';
              const key = id.startsWith('promo-section-') ? id.slice('promo-section-'.length) : '';
              if (!/^[a-z][a-z0-9_-]{0,63}$/.test(key) || observed.has(key)) return;
              observed.add(key);
              observer.unobserve(entry.target);
              sendPromoEvent('section_view', key);
            });
          }, { threshold: [0.5] });
          document.querySelectorAll('[id^="promo-section-"]').forEach((section) => observer.observe(section));
        }
      }
    </script>
  </body>
</html>
