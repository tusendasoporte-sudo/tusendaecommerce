---
import Layout from './Layout.astro';
import type { AdminStoreContext } from '../lib/storeContext';
import type { PromoAccessContext } from '../lib/promoAccess';
import { getPromoAdminSectionPath } from '../lib/promoAdminShell';
import '../styles/promo-analytics.css';

interface Props {
  adminContext: AdminStoreContext;
  accessContext: PromoAccessContext;
}

const { adminContext, accessContext } = Astro.props;
const storeSlug = String(accessContext.store.slug || adminContext.store.slug || '').trim().toLowerCase();
const storeName = String(accessContext.store.name || adminContext.store.name || 'Tienda Promo').trim();
const homePath = getPromoAdminSectionPath(storeSlug, 'overview');
const contextLabel = adminContext.isMasterSupport ? `Soporte Master · ${storeName}` : storeName;
---

<Layout isMaster={true}>
  <main class="pz-promo-analytics-page" data-promo-analytics data-store-slug={storeSlug}>
    <nav class="pz-promo-analytics-page__top" aria-label="Contexto Promo">
      <a class="pz-promo-analytics-page__back" href={homePath}>← Volver al Admin Promo</a>
      <span class="pz-promo-analytics-page__context">{contextLabel}</span>
    </nav>
    <section class="pz-promo-analytics" aria-labelledby="promo-analytics-title">
      <header class="pz-promo-analytics__header">
        <div>
          <span>Conteos agregados</span>
          <h1 id="promo-analytics-title">Rendimiento del sitio Promo</h1>
          <p>Visitas e interacciones first-party, sin cookies analíticas ni identificación de personas.</p>
        </div>
        <div class="pz-promo-analytics__ranges" role="group" aria-label="Período de analíticas">
          {[7, 30, 90].map((days) => (
            <button type="button" data-promo-analytics-range={days} aria-pressed={days === 30 ? 'true' : 'false'}>{days} días</button>
          ))}
        </div>
      </header>
      <div class="pz-promo-analytics__status" role="status" aria-live="polite" data-promo-analytics-status>Cargando analíticas…</div>
      <div class="pz-promo-analytics__body" data-promo-analytics-body hidden>
        <div class="pz-promo-analytics__cards">
          <article><span>Visitas</span><strong data-promo-metric="page_views">0</strong></article>
          <article><span>Secciones vistas</span><strong data-promo-metric="section_views">0</strong></article>
          <article><span>Contactos activados</span><strong data-promo-metric="contact_activations">0</strong></article>
          <article><span>Aperturas Landing QR</span><strong data-promo-metric="landing_qr_opens">0</strong></article>
        </div>
        <div class="pz-promo-analytics__details">
          <section aria-labelledby="promo-analytics-sections"><h2 id="promo-analytics-sections">Secciones principales</h2><ol data-promo-analytics-list="sections"></ol></section>
          <section aria-labelledby="promo-analytics-contact"><h2 id="promo-analytics-contact">Canales de contacto</h2><ol data-promo-analytics-list="contact_actions"></ol></section>
          <section aria-labelledby="promo-analytics-locales"><h2 id="promo-analytics-locales">Idiomas</h2><ol data-promo-analytics-list="locales"></ol></section>
        </div>
        <p class="pz-promo-analytics__privacy">No se calculan visitantes únicos. Los eventos crudos se conservan 7 días; este panel consume solo agregados diarios.</p>
      </div>
    </section>
  </main>

  <script>
    const analyticsRoot = document.querySelector('[data-promo-analytics]');
    if (analyticsRoot instanceof HTMLElement) {
      const status = analyticsRoot.querySelector('[data-promo-analytics-status]');
      const body = analyticsRoot.querySelector('[data-promo-analytics-body]');
      const store = analyticsRoot.dataset.storeSlug || '';
      const labels: Record<string, string> = {
        whatsapp: 'WhatsApp', phone: 'Teléfono', email: 'Correo',
        internal_form: 'Formulario', approved_live_chat: 'Chat aprobado',
      };
      const formatter = new Intl.NumberFormat('es');

      function renderList(name: string, items: Array<{ key: string; count: number }>) {
        const list = analyticsRoot.querySelector(`[data-promo-analytics-list="${name}"]`);
        if (!(list instanceof HTMLOListElement)) return;
        list.replaceChildren();
        if (!items.length) {
          const empty = document.createElement('li');
          empty.textContent = 'Sin eventos en este período';
          empty.className = 'is-empty';
          list.append(empty);
          return;
        }
        items.forEach((item) => {
          const row = document.createElement('li');
          const label = document.createElement('span');
          const value = document.createElement('strong');
          label.textContent = labels[item.key] || item.key.replaceAll('_', ' ');
          value.textContent = formatter.format(item.count);
          row.append(label, value);
          list.append(row);
        });
      }

      async function loadAnalytics(days: number) {
        if (status instanceof HTMLElement) status.textContent = 'Cargando analíticas…';
        if (body instanceof HTMLElement) body.hidden = true;
        try {
          const response = await fetch(`/api/admin/promo-analytics?store=${encodeURIComponent(store)}&range=${days}`, {
            headers: { Accept: 'application/json' }, credentials: 'same-origin', cache: 'no-store',
          });
          const result = await response.json();
          if (!response.ok || result?.contract !== 'promo.analytics.summary.v1') throw new Error('unavailable');
          ['page_views', 'section_views', 'contact_activations', 'landing_qr_opens'].forEach((key) => {
            const element = analyticsRoot.querySelector(`[data-promo-metric="${key}"]`);
            if (element instanceof HTMLElement) element.textContent = formatter.format(Number(result.totals?.[key]) || 0);
          });
          renderList('sections', Array.isArray(result.sections) ? result.sections : []);
          renderList('contact_actions', Array.isArray(result.contact_actions) ? result.contact_actions : []);
          renderList('locales', Array.isArray(result.locales) ? result.locales : []);
          if (status instanceof HTMLElement) status.textContent = `Datos agregados del ${result.range.from} al ${result.range.to}.`;
          if (body instanceof HTMLElement) body.hidden = false;
        } catch (_) {
          if (status instanceof HTMLElement) status.textContent = 'No fue posible cargar las analíticas. Intenta nuevamente.';
        }
      }

      analyticsRoot.querySelectorAll('[data-promo-analytics-range]').forEach((button) => {
        button.addEventListener('click', () => {
          const days = Number((button as HTMLElement).dataset.promoAnalyticsRange || 0);
          analyticsRoot.querySelectorAll('[data-promo-analytics-range]').forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
          if ([7, 30, 90].includes(days)) void loadAnalytics(days);
        });
      });
      void loadAnalytics(30);
    }
  </script>
</Layout>
