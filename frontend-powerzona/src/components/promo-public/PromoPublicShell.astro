---
import PromoBlackGoldTheme from './PromoBlackGoldTheme.astro';
import {
  PROMO_PUBLIC_RENDERER_KEYS,
  type PromoPublicProfile,
  type PromoPublicSeo,
} from '../../lib/promoPublicShell';

interface Props {
  profile: PromoPublicProfile;
  seo: PromoPublicSeo;
}

const { profile, seo } = Astro.props;

if (!PROMO_PUBLIC_RENDERER_KEYS.includes(profile.theme.renderer_key)) {
  throw new Error('promo_public_renderer_unavailable');
}
---

<PromoBlackGoldTheme profile={profile} seo={seo} />
