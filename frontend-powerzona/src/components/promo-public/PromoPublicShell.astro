---
import PromoBlackGoldTheme from './PromoBlackGoldTheme.astro';
import {
  PROMO_BLACK_GOLD_RENDERER_KEY,
  type PromoPublicProfile,
} from '../../lib/promoPublicShell';

interface Props {
  profile: PromoPublicProfile;
}

const { profile } = Astro.props;

if (profile.theme.renderer_key !== PROMO_BLACK_GOLD_RENDERER_KEY) {
  throw new Error('promo_public_renderer_unavailable');
}
---

<PromoBlackGoldTheme profile={profile} />
