---
import '../../styles/promo-contact.css';
import { promoQuoteHref, type PromoPublicProfile } from '../../lib/promoPublicShell';

interface Props {
  profile: PromoPublicProfile;
  className?: string;
  fallbackLabel: string;
  enabled?: boolean;
  context?: string;
  purpose?: 'primary' | 'quote';
}

const {
  profile, className = '', fallbackLabel, enabled = true, context = '', purpose = 'primary',
} = Astro.props;
const compiled = purpose === 'quote' ? profile.quote_action : profile.contact_action;
const action = enabled && compiled.available ? compiled.action : null;
const unavailable = profile.system.messages['contact.unavailable'];
const configuredLabel = String(profile.content.identity?.contact_cta_label || '').trim();
const actionLabel = configuredLabel || fallbackLabel;
const quoteContext = context.trim();
const actionHref = action && purpose === 'quote' && quoteContext
  ? promoQuoteHref(action.href, quoteContext)
  : action?.href;
---

{action ? (
  <a
    class:list={['promo-contact-action', className]}
    href={actionHref}
    aria-label={action.aria_label}
    rel={action.type === 'whatsapp' ? 'noopener noreferrer' : undefined}
    data-contact-action={purpose}
    data-contact-type={action.type}
    data-quote-context={context.trim() || undefined}
  >
    <span class="promo-contact-action__label">{actionLabel}</span>
    <span class="promo-contact-action__mark" aria-hidden="true">→</span>
  </a>
) : (
  <span
    class:list={['promo-contact-action', 'promo-contact-action--unavailable', className]}
    role="status"
    data-contact-action="unavailable"
  >
    <span class="promo-contact-action__label">{actionLabel}</span>
    <span class="promo-contact-action__state">{unavailable}</span>
  </span>
)}
