---
import '../../styles/promo-landing-qr.css';
import type { PromoPublicLandingQrLink } from '../../lib/promoPublicShell';

interface Props {
  value: PromoPublicLandingQrLink;
}

const { value } = Astro.props;
const link = value.enabled ? value.link : null;
---

{link && (
  <a
    class="promo-landing-qr-link"
    href={link.href}
    aria-label={link.aria_label}
    data-promo-landing-qr-link
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 4h6v6H4V4Zm2 2v2h2V6H6Zm8-2h6v6h-6V4Zm2 2v2h2V6h-2ZM4 14h6v6H4v-6Zm2 2v2h2v-2H6Zm8-2h2v2h-2v-2Zm4 0h2v4h-2v-4Zm-4 4h4v2h-4v-2Z"></path>
    </svg>
    <span class="promo-landing-qr-link__label">{link.label}</span>
  </a>
)}
