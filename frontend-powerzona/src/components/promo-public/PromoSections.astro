---
import '../../styles/promo-sections.css';
import type {
  PromoPublicMedia,
  PromoPublicProfile,
  PromoPublicSection,
} from '../../lib/promoPublicShell';
import { promoServicePath } from '../../lib/promoServiceCatalog';
import PromoContactAction from './PromoContactAction.astro';
import PromoSectionMedia from './PromoSectionMedia.astro';

interface Props {
  profile: PromoPublicProfile;
  section: PromoPublicSection;
  localized: Record<string, any>;
  heading: string;
  navigationLabel: string;
  primaryHeading: boolean;
}

type WorkModel = {
  key: string;
  galleryKey: string;
  galleryHeading: string;
  name: string;
  summary: string;
  caption: string;
  featured: boolean;
  media: PromoPublicMedia[];
};

const {
  profile,
  section,
  localized,
  heading,
  navigationLabel,
  primaryHeading,
} = Astro.props;
const sectionId = `promo-section-${section.key}`;
const items = Array.isArray(localized.items) ? localized.items : [];
const mediaByKey = new Map(profile.media.map((item) => [item.key, item]));
const sectionByKey = new Map(profile.sections.map((item) => [item.key, item]));
const gallerySections = profile.sections.filter((item) => item.type === 'gallery');
const ownerMediaKey = String(section.config.media_use_key || section.media_use_keys[0] || '');
const ownerMedia = ownerMediaKey ? mediaByKey.get(ownerMediaKey) : undefined;
const itemNumber = (index: number) => String(index + 1).padStart(2, '0');
const estimateLabel = profile.system.messages['contact.request_estimate'];
const quoteLabel = profile.locale.lang.startsWith('es') ? 'Cotizar' : 'Get a quote';
const viewOptionsLabel = profile.locale.lang.startsWith('es') ? 'Ver opciones' : 'View options';

const galleryWorks = (gallery: PromoPublicSection): WorkModel[] => {
  const content = profile.content.sections[gallery.key] || {};
  const localizedItems = new Map((Array.isArray(content.items) ? content.items : [])
    .map((item: Record<string, string>) => [item.key, item]));
  return (Array.isArray(gallery.config.items) ? gallery.config.items : [])
    .filter((item: Record<string, any>) => item.visible === true)
    .map((item: Record<string, any>) => {
      const copy = localizedItems.get(item.key) || {};
      return {
        key: String(item.key),
        galleryKey: gallery.key,
        galleryHeading: String(content.heading || profile.content.navigation[gallery.key] || ''),
        name: String(copy.name || ''),
        summary: String(copy.summary || ''),
        caption: String(copy.caption || ''),
        featured: item.featured === true,
        media: (Array.isArray(item.media_use_keys) ? item.media_use_keys : [])
          .map((key: string) => mediaByKey.get(key))
          .filter((media): media is PromoPublicMedia => Boolean(media && media.purpose === 'gallery')),
      };
    });
};

const featuredWorks = gallerySections.flatMap(galleryWorks).filter((work) => work.featured);
const currentGalleryWorks = section.type === 'gallery' ? galleryWorks(section) : [];
const serviceGalleryKeys = Array.isArray(section.config.gallery_keys) ? section.config.gallery_keys : [];
const serviceIconKeys = Array.isArray(section.config.icon_keys) ? section.config.icon_keys : [];
const services = section.type === 'services' ? items.map((item: Record<string, string>, index: number) => {
  const galleryKey = String(serviceGalleryKeys[index] || '');
  const gallery = galleryKey ? sectionByKey.get(galleryKey) : undefined;
  const coverKey = gallery?.type === 'gallery' ? String(gallery.config.cover_media_use_key || '') : '';
  const cover = coverKey ? mediaByKey.get(coverKey) : undefined;
  return {
    item,
    iconKey: String(serviceIconKeys[index] || ''),
    cover: cover?.purpose === 'gallery' ? cover : undefined,
    productCount: gallery?.type === 'gallery' ? galleryWorks(gallery).length : 0,
  };
}) : [];
const itemCount = section.type === 'featured_work'
  ? featuredWorks.length
  : section.type === 'gallery'
    ? currentGalleryWorks.length
    : items.length;
---

<section
  id={sectionId}
  class:list={['promo-shell-section', 'promo-sections', `promo-sections--${section.type}`]}
  aria-labelledby={`${sectionId}-heading`}
  data-section-type={section.type}
  data-section-variant={section.variant}
  data-section-item-count={String(itemCount)}
>
  <div class:list={['promo-shell-section__inner', 'promo-sections__inner', { 'promo-sections__inner--owner': section.type === 'owner' }]}>
    {section.type === 'owner' && (
      <div class:list={['promo-sections__owner-media', { 'promo-sections__owner-media--empty': !ownerMedia }]}>
        {ownerMedia ? (
          <figure>
            <PromoSectionMedia media={ownerMedia} accessibleLabel={String(localized.name || navigationLabel)} />
          </figure>
        ) : (
          <div class="promo-sections__media-placeholder" aria-hidden="true"><span></span></div>
        )}
      </div>
    )}

    <div class:list={['promo-shell-section__copy', 'promo-sections__intro', { 'promo-sections__owner-copy': section.type === 'owner' }]}>
      <p class="promo-shell-section__eyebrow">{navigationLabel}</p>
      {primaryHeading
        ? <h1 id={`${sectionId}-heading`}>{heading}</h1>
        : <h2 id={`${sectionId}-heading`}>{heading}</h2>}
      {localized.summary && <p class="promo-shell-section__summary">{localized.summary}</p>}

      {section.type === 'owner' && (
        <div class="promo-sections__owner-story">
          {localized.name && <h3>{localized.name}</h3>}
          {localized.bio && <p>{localized.bio}</p>}
        </div>
      )}
    </div>

    {section.type === 'services' && services.length > 0 && (
      <ul class="promo-sections__services-list">
        {services.map(({ item, iconKey, cover, productCount }, index) => (
          <li>
            <section class="promo-sections__service-category" aria-labelledby={`${sectionId}-service-${index + 1}`}>
              <article class:list={['promo-sections__service-card', { 'promo-sections__service-card--with-media': cover }]}>
                <div class="promo-sections__service-media">
                  {cover ? (
                    <PromoSectionMedia media={cover} accessibleLabel={String(item.name || navigationLabel)} />
                  ) : (
                    <div class="promo-sections__service-mark" aria-hidden="true"><span></span></div>
                  )}
                </div>
                <div class="promo-sections__service-copy">
                  <div class="promo-sections__service-heading">
                    {iconKey && (
                      <span class="promo-service-icon" aria-hidden="true">
                        <svg viewBox="0 0 48 48" focusable="false">
                          {iconKey === 'carpet' && (
                            <g>
                              <path d="M8 15h25a7 7 0 0 1 0 14H14a5 5 0 0 1 0-10h18" />
                              <path d="M8 15v14m8-14v4m-2 10v4m8-18v4m6 10v4" />
                            </g>
                          )}
                          {iconKey === 'flooring' && (
                            <g>
                              <path d="M7 11h34v26H7zM7 20h34M7 29h34" />
                              <path d="M16 11v9m14-9v9M23 20v9m14-9v9M13 29v8m18-8v8" />
                            </g>
                          )}
                          {iconKey === 'stairs' && (
                            <path d="M8 38h8v-8h8v-8h8v-8h8V8" />
                          )}
                          {iconKey === 'finishing' && (
                            <g>
                              <path d="m10 34 18-18 6 6-18 18H10zM28 16l3-3 6 6-3 3" />
                              <path d="m13 31 6 6m17-22 4-4" />
                            </g>
                          )}
                          {iconKey === 'upholstery' && (
                            <g>
                              <path d="M11 25v-6a5 5 0 0 1 10 0v4h6v-4a5 5 0 0 1 10 0v6" />
                              <path d="M8 24a4 4 0 0 1 4 4v8h24v-8a4 4 0 0 1 4-4v16H8zM14 40v2m20-2v2" />
                            </g>
                          )}
                          {iconKey === 'cleaning' && (
                            <g>
                              <path d="m26 10 9 9M18 38l13-13-8-8-13 13-2 10z" />
                              <path d="m13 30 8 8M37 8v6m-3-3h6M12 8v8m-4-4h8" />
                            </g>
                          )}
                          {iconKey === 'installation' && (
                            <g>
                              <path d="m9 38 18-18 5 5-18 18H9zM24 17l5-5 9 9-5 5" />
                              <path d="M8 10h13M8 15h8" />
                            </g>
                          )}
                          {iconKey === 'commercial' && (
                            <g>
                              <path d="M9 42V12h20v30M29 21h10v21M6 42h36" />
                              <path d="M14 18h4m5 0h1m-10 7h4m5 0h1m-10 7h4m5 0h1m10-5h2m-2 7h2" />
                            </g>
                          )}
                        </svg>
                      </span>
                    )}
                    <div>
                      <span class="promo-sections__item-number" aria-hidden="true">{itemNumber(index)}</span>
                      {item.name && <h3 id={`${sectionId}-service-${index + 1}`}>{item.name}</h3>}
                    </div>
                  </div>
                  {item.summary && <p>{item.summary}</p>}
                  {item.caption && <p class="promo-sections__caption">{item.caption}</p>}
                  {productCount > 0 ? (
                    <a
                      class="promo-sections__service-action"
                      href={promoServicePath(profile, String(item.key || ''))}
                      aria-label={`${viewOptionsLabel}: ${String(item.name || '')}`}
                    >
                      <span>{viewOptionsLabel}</span><span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <PromoContactAction
                      profile={profile}
                      className="promo-sections__service-action promo-sections__service-quote"
                      fallbackLabel={estimateLabel}
                      labelOverride={quoteLabel}
                      context={profile.locale.lang.startsWith('es')
                        ? `Quiero cotizar: ${String(item.name || '')}`
                        : `Quote request: ${String(item.name || '')}`}
                    />
                  )}
                </div>
              </article>
            </section>
          </li>
        ))}
      </ul>
    )}

    {section.type === 'featured_work' && featuredWorks.length > 0 && (
      <ol class="promo-sections__featured-list">
        {featuredWorks.map((work, index) => {
          const carouselId = `${sectionId}-${work.galleryKey}-${work.key}`;
          return (
            <li>
              <article class="promo-sections__featured-card">
                <div class="promo-sections__featured-media">
                  <ol class="promo-sections__work-slides" aria-label={work.name} tabindex={work.media.length > 1 ? '0' : undefined}>
                    {work.media.map((media, mediaIndex) => (
                      <li id={`${carouselId}-media-${mediaIndex + 1}`}>
                        <PromoSectionMedia media={media} accessibleLabel={work.name} />
                      </li>
                    ))}
                  </ol>
                  {work.media.length > 1 && (
                    <nav class="promo-sections__work-controls" aria-label={`${work.name} - ${work.media.length}`}>
                      {work.media.map((_, mediaIndex) => (
                        <a href={`#${carouselId}-media-${mediaIndex + 1}`} aria-label={`${mediaIndex + 1}/${work.media.length}`}>
                          {mediaIndex + 1}
                        </a>
                      ))}
                    </nav>
                  )}
                </div>
                <div class="promo-sections__featured-copy">
                  <span class="promo-sections__item-number" aria-hidden="true">{itemNumber(index)}</span>
                  <p class="promo-sections__category">{work.galleryHeading}</p>
                  <h3>{work.name}</h3>
                  {work.summary && <p>{work.summary}</p>}
                  {work.caption && <p class="promo-sections__caption">{work.caption}</p>}
                  <PromoContactAction profile={profile} className="promo-sections__estimate" fallbackLabel={estimateLabel} />
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    )}

    {section.type === 'gallery' && currentGalleryWorks.length > 0 && (
      <ul class="promo-sections__gallery-list promo-sections__work-grid">
        {currentGalleryWorks.map((work, index) => {
          const carouselId = `${sectionId}-${work.key}`;
          return (
            <li>
              <article class="promo-sections__work-card">
                <div class="promo-sections__work-media">
                  <ol class="promo-sections__work-slides" aria-label={work.name} tabindex={work.media.length > 1 ? '0' : undefined}>
                    {work.media.map((media, mediaIndex) => (
                      <li id={`${carouselId}-media-${mediaIndex + 1}`}>
                        <PromoSectionMedia media={media} accessibleLabel={work.name} />
                      </li>
                    ))}
                  </ol>
                  {work.media.length > 1 && (
                    <nav class="promo-sections__work-controls" aria-label={`${work.name} - ${work.media.length}`}>
                      {work.media.map((_, mediaIndex) => (
                        <a href={`#${carouselId}-media-${mediaIndex + 1}`} aria-label={`${mediaIndex + 1}/${work.media.length}`}>
                          {mediaIndex + 1}
                        </a>
                      ))}
                    </nav>
                  )}
                </div>
                <div class="promo-sections__work-copy">
                  <span class="promo-sections__item-number" aria-hidden="true">{itemNumber(index)}</span>
                  <h3>{work.name}</h3>
                  {work.summary && <p>{work.summary}</p>}
                  {work.caption && <p class="promo-sections__caption">{work.caption}</p>}
                  <PromoContactAction profile={profile} className="promo-sections__estimate" fallbackLabel={estimateLabel} />
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>
