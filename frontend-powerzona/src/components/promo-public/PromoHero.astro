---
import '../../styles/promo-hero.css';
import type {
  PromoPublicMedia,
  PromoPublicProfile,
  PromoPublicSection,
} from '../../lib/promoPublicShell';
import PromoContactAction from './PromoContactAction.astro';
import PromoSectionMedia from './PromoSectionMedia.astro';

interface Props {
  profile: PromoPublicProfile;
  section: PromoPublicSection;
  localized: Record<string, any>;
  heading: string;
  navigationLabel: string;
  primaryHeading: boolean;
}

const {
  profile,
  section,
  localized,
  heading,
  navigationLabel,
  primaryHeading,
} = Astro.props;
const sectionId = `promo-section-${section.key}`;
const mediaByKey = new Map(profile.media.map((item) => [item.key, item]));
const primaryMediaKey = String(section.config.media_use_key || section.media_use_keys[0] || '');
const heroMediaKeys = [primaryMediaKey, ...section.media_use_keys]
  .filter((key, index, keys) => key && keys.indexOf(key) === index);
const heroMedia = heroMediaKeys
  .map((key) => mediaByKey.get(key))
  .filter((item): item is PromoPublicMedia => Boolean(item && item.purpose === 'hero'));
const primaryActionKey = String(profile.contact.primary_action_key || '');
const ctaLabel = String(
  profile.content.identity?.contact_cta_label
  || profile.system.messages['contact.request_estimate'],
);
const requestedActionKey = String(section.config.action_key || primaryActionKey);
const contactEnabled = Boolean(primaryActionKey && requestedActionKey === primaryActionKey);
const heroLayout = ['immersive', 'split', 'centered', 'editorial'].includes(String(section.config.layout))
  ? String(section.config.layout)
  : 'immersive';
const logoMediaKey = String(profile.contact.logo_media_use_key || '');
const logoMedia = profile.media.find((media) => (
  media.key === logoMediaKey && media.kind === 'image' && media.purpose === 'logo'
));
const heroBrandPlacement = heroLayout === 'centered' ? 'centered'
  : heroLayout === 'editorial' ? 'lateral'
    : '';
const highlights = Array.isArray(localized.highlights) ? localized.highlights.slice(0, 4) : [];
const buttonTargets = Array.isArray(section.config.button_targets) ? section.config.button_targets.slice(0, 2) : [];
const buttonLabels = Array.isArray(localized.button_labels) ? localized.button_labels.slice(0, 2) : [];
const targetDefaults: Record<string, string> = {
  'primary-contact': ctaLabel,
  'contact-section': profile.system.messages['navigation.contact'],
  'services-section': profile.system.messages['navigation.services'],
  'work-section': profile.system.messages['navigation.gallery'],
};
const targetSection = (target: string) => {
  if (target === 'contact-section') return profile.sections.find((candidate) => candidate.type === 'contact');
  if (target === 'services-section') return profile.sections.find((candidate) => candidate.type === 'services');
  if (target === 'work-section') return profile.sections.find((candidate) => candidate.key === 'videos-main');
  return null;
};
const heroButtons = buttonTargets.map((target: string, index: number) => ({
  target,
  label: String(target === 'primary-contact' ? ctaLabel : (buttonLabels[index] || targetDefaults[target] || ctaLabel)),
  section: targetSection(target),
})).filter((button) => button.target === 'primary-contact' || button.section);
const srcset = (media: PromoPublicMedia) => media.kind === 'image'
  ? media.delivery.srcset.map((source) => `${source.url} ${source.width}w`).join(', ')
  : '';
const mediaLabel = (media: PromoPublicMedia, index: number) => (
  media.accessibility.alt || `${navigationLabel} ${index + 1}`
);
const carouselControlLabels = profile.locale.lang.toLowerCase().startsWith('en')
  ? { previous: 'Previous cover image', next: 'Next cover image' }
  : { previous: 'Imagen anterior de portada', next: 'Imagen siguiente de portada' };
---

<section
  id={sectionId}
  class:list={['promo-shell-section', 'promo-shell-section--hero', 'promo-hero', `promo-hero--layout-${heroLayout}`, { 'promo-hero--with-media': heroMedia.length > 0 }]}
  aria-labelledby={`${sectionId}-heading`}
  data-section-type="hero"
  data-section-variant={section.variant}
  data-hero-media-count={String(heroMedia.length)}
>
  <div class="promo-shell-section__inner promo-hero__inner">
    <div class="promo-shell-section__copy promo-hero__copy">
      <p class="promo-shell-section__eyebrow">{localized.intro || navigationLabel}</p>
      {logoMedia?.kind === 'image' && heroBrandPlacement && (
        <a class:list={['promo-hero__brand', `promo-hero__brand--${heroBrandPlacement}`]} href={profile.locale.canonical_path} aria-label={profile.content.identity.name}>
          <PromoSectionMedia media={logoMedia} accessibleLabel={profile.content.identity.name} />
        </a>
      )}
      {profile.content.identity.slogan && <p class="promo-hero__slogan">{profile.content.identity.slogan}</p>}
      {primaryHeading
        ? <h1 id={`${sectionId}-heading`}>{heading}</h1>
        : <h2 id={`${sectionId}-heading`}>{heading}</h2>}
      {localized.summary && <p class="promo-shell-section__summary">{localized.summary}</p>}
      {highlights.length > 0 && (
        <ul class="promo-hero__highlights" aria-label={navigationLabel}>
          {highlights.map((highlight: string) => <li>{highlight}</li>)}
        </ul>
      )}
      {heroButtons.length > 0 && (
        <div class="promo-hero__actions">
          {heroButtons.map((button, index) => button.target === 'primary-contact' ? (
            <PromoContactAction
              profile={profile}
              className="promo-hero__cta"
              fallbackLabel={button.label}
              enabled={contactEnabled}
            />
          ) : (
            <a
              class:list={['promo-hero__cta', 'promo-hero__anchor', { 'is-secondary': index > 0 }]}
              href={`#promo-section-${button.section?.key}`}
            >
              <span>{button.label}</span><span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      )}
    </div>

    {heroMedia.length > 0 ? (
      <div class="promo-hero__media-region">
        <ol class="promo-hero__slides" aria-label={navigationLabel} tabindex={heroMedia.length > 1 ? '0' : undefined}>
          {heroMedia.map((media, index) => (
            <li
              class="promo-hero__slide"
              data-media-kind={media.kind}
              data-media-priority={media.key === primaryMediaKey ? 'primary' : 'secondary'}
            >
              <figure class="promo-hero__figure">
                {media.kind === 'image' ? (
                  <img
                    src={media.delivery.src}
                    srcset={srcset(media)}
                    sizes={media.delivery.sizes}
                    width={media.width}
                    height={media.height}
                    loading={media.delivery.loading}
                    fetchpriority={media.delivery.fetch_priority}
                    decoding={media.delivery.decoding}
                    alt={media.accessibility.alt}
                  />
                ) : (
                  <video
                    controls={media.delivery.controls_required}
                    preload={media.delivery.preload}
                    playsinline={media.delivery.plays_inline}
                    poster={media.delivery.poster.src}
                    width={media.width}
                    height={media.height}
                    aria-label={mediaLabel(media, index)}
                  >
                    <source src={media.delivery.src} type={media.delivery.mime} />
                  </video>
                )}
                {media.kind === 'video' && !media.accessibility.decorative && (
                  <figcaption class="promo-shell-visually-hidden">{media.accessibility.alt}</figcaption>
                )}
              </figure>
            </li>
          ))}
        </ol>

        {heroMedia.length > 1 && (
          <div class="promo-hero__controls" role="group" aria-label={navigationLabel}>
            <button
              type="button"
              class="promo-hero__arrow promo-hero__arrow--previous"
              data-promo-hero-direction="previous"
              aria-label={carouselControlLabels.previous}
            >
              <span aria-hidden="true">←</span>
            </button>
            <button
              type="button"
              class="promo-hero__arrow promo-hero__arrow--next"
              data-promo-hero-direction="next"
              aria-label={carouselControlLabels.next}
            >
              <span aria-hidden="true">→</span>
            </button>
          </div>
        )}
      </div>
    ) : (
      <div class="promo-shell-section__ornament" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    )}
  </div>
</section>
