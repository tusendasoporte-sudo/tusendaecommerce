---
import '../../styles/promo-footer.css';
import type { PromoPublicProfile, PromoPublicSection } from '../../lib/promoPublicShell';

interface Props {
  profile: PromoPublicProfile;
  section: PromoPublicSection;
  localized: Record<string, any>;
  basePath?: string;
}

const { profile, section, localized, basePath = '' } = Astro.props;
const footer = profile.footer.sections.find((entry) => entry.key === section.key);
const sectionId = `promo-section-${section.key}`;
const footerHref = (href: string) => basePath && href.startsWith('#') ? `${basePath}${href}` : href;
const footerContrastMode = ['auto', 'light', 'dark', 'custom'].includes(String(section.config.contrast_mode))
  ? String(section.config.contrast_mode) : 'auto';
const footerTitleColor = /^#[0-9a-f]{6}$/i.test(String(section.config.title_color))
  ? String(section.config.title_color).toLowerCase() : '#ffffff';
const footerBodyColor = /^#[0-9a-f]{6}$/i.test(String(section.config.body_color))
  ? String(section.config.body_color).toLowerCase() : '#e2e8f0';
const footerAccentColor = /^#[0-9a-f]{6}$/i.test(String(section.config.accent_color))
  ? String(section.config.accent_color).toLowerCase() : '#d8b25c';
const footerStyle = footerContrastMode === 'custom'
  ? `--promo-footer-title-color:${footerTitleColor};--promo-footer-body-color:${footerBodyColor};--promo-footer-accent-color:${footerAccentColor}`
  : undefined;
---

{footer && (
  <footer
    id={sectionId}
    class="promo-shell-footer promo-footer"
    aria-label={profile.content.navigation[section.key]}
    data-section-type="footer"
    data-section-variant={section.variant}
    data-footer-contrast={footerContrastMode}
    style={footerStyle}
  >
    <div class="promo-footer__inner">
      <div class="promo-footer__identity">
        <span class="promo-shell-footer__mark" aria-hidden="true"></span>
        {localized.heading && <h2>{localized.heading}</h2>}
        {localized.summary && <p class="promo-footer__summary">{localized.summary}</p>}
      </div>

      {footer.navigation_links.length > 0 && (
        <nav class="promo-footer__navigation" aria-label={footer.navigation_label}>
          <ul>
            {footer.navigation_links.map((link) => (
              <li><a href={footerHref(link.href)}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      {footer.social_links.length > 0 && (
        <nav class="promo-footer__social" aria-label={footer.social_label}>
          <ul>
            {footer.social_links.map((link) => (
              <li>
                <a href={link.href} aria-label={link.aria_label} data-social-network={link.network}>
                  <span aria-hidden="true">{link.label.slice(0, 1)}</span>
                  <span>{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <p class="promo-footer__platform-brand">
        <span>{footer.branding.label}</span>
        <strong>{footer.branding.name}</strong>
      </p>
    </div>
  </footer>
)}
