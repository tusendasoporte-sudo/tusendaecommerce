---
import type { PromoPublicMedia, PromoPublicProfile, PromoPublicSection } from '../../lib/promoPublicShell';
import PromoContactAction from './PromoContactAction.astro';
import PromoSectionMedia from './PromoSectionMedia.astro';

interface Props {
  profile: PromoPublicProfile;
  section: PromoPublicSection;
  localized: Record<string, any>;
  heading: string;
  navigationLabel: string;
  primaryHeading: boolean;
}

const { profile, section, localized, heading, navigationLabel, primaryHeading } = Astro.props;
const sectionId = `promo-section-${section.key}`;
const primaryKey = String(profile.contact.primary_action_key || '');
const primaryCopy = primaryKey ? profile.content.contact[primaryKey] : undefined;
const fallbackLabel = String(primaryCopy?.label || profile.system.messages['contact.request_estimate']);
const actionKeys = Array.isArray(section.config.action_keys) ? section.config.action_keys : [];
const contactEnabled = Boolean(primaryKey && actionKeys.includes(primaryKey));
const logoMediaKey = String(profile.contact.logo_media_use_key || '');
const logoMedia = profile.media.find((media): media is PromoPublicMedia => (
  media.key === logoMediaKey && media.kind === 'image' && media.purpose === 'logo'
));
const qrMediaKey = String(profile.contact.qr_media_use_key || '');
const qrMedia = profile.media.find((media): media is PromoPublicMedia => (
  media.key === qrMediaKey && media.kind === 'image' && media.purpose === 'qr'
));
const qrHeading = profile.locale.lang.startsWith('es') ? 'Escanea para contactar' : 'Scan to contact';
---

<section
  id={sectionId}
  class="promo-shell-section promo-shell-section--contact promo-contact"
  aria-labelledby={`${sectionId}-heading`}
  data-section-type="contact"
  data-section-variant={section.variant}
  data-contact-available={profile.contact_action.available ? 'true' : 'false'}
>
  <div class="promo-shell-section__inner promo-contact__inner">
    <div class="promo-shell-section__copy promo-contact__copy">
      {logoMedia && (
        <div class="promo-contact__logo">
          <PromoSectionMedia media={logoMedia} accessibleLabel={String(profile.content.identity.name || heading)} />
        </div>
      )}
      <p class="promo-shell-section__eyebrow">{navigationLabel}</p>
      {primaryHeading
        ? <h1 id={`${sectionId}-heading`}>{heading}</h1>
        : <h2 id={`${sectionId}-heading`}>{heading}</h2>}
      {localized.summary && <p class="promo-shell-section__summary">{localized.summary}</p>}
      <PromoContactAction
        profile={profile}
        className="promo-contact__action"
        fallbackLabel={fallbackLabel}
        enabled={contactEnabled}
      />
    </div>

    {qrMedia ? (
      <figure class="promo-contact__qr">
        <PromoSectionMedia media={qrMedia} accessibleLabel={qrHeading} />
        <figcaption>{qrHeading}</figcaption>
      </figure>
    ) : (
      <div class="promo-contact__ornament" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    )}
  </div>
</section>
