    background: linear-gradient(145deg, rgba(21,64,145,.98), rgba(5,25,66,.98));
    border: 1px solid rgba(96,165,250,.48);
    box-shadow: 0 28px 60px rgba(0,0,0,.32), inset 0 1px 0 rgba(255,255,255,.10), 0 0 38px rgba(37,99,235,.18);
    transform: perspective(700px) rotateY(-7deg) rotateX(3deg);
