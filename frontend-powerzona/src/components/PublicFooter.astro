  .pz-platform-window-top i { width: 7px; height: 7px; border-radius: 50%; background: rgba(147,197,253,.52); }
  .pz-platform-shop { position: absolute; left: 22px; top: 64px; width: 116px; height: 112px; border-radius: 12px; background: linear-gradient(180deg, #0b63f6, #0647b8); box-shadow: 0 15px 30px rgba(0,0,0,.24); }
  .pz-platform-shop::before { content: ''; position: absolute; left: -5px; right: -5px; top: -20px; height: 25px; border-radius: 9px 9px 5px 5px; background: repeating-linear-gradient(90deg, #fff 0 20px, #1d7cff 20px 40px); box-shadow: 0 8px 16px rgba(0,0,0,.16); }
  .pz-platform-shop i { position: absolute; left: 45px; bottom: 0; width: 30px; height: 55px; border-radius: 7px 7px 0 0; background: #031c4e; }
