  .pz-footer-utility-copy { min-width: 0; display: grid; gap: 5px; padding-right: 12px; }
  .pz-footer-utility-copy strong { color: #fff; font-size: 15px; line-height: 1.18; font-weight: 1000; overflow-wrap: anywhere; }
  .pz-footer-utility-copy small { color: rgba(191,219,254,.72); font-size: 11px; line-height: 1.35; font-weight: 800; overflow-wrap: anywhere; }
