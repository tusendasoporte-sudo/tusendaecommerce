    box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 22px 52px rgba(0,0,0,.25), 0 0 0 1px rgba(37,99,235,.08);
  }
  .pz-platform-copy { grid-area: copy; align-self: end; }
