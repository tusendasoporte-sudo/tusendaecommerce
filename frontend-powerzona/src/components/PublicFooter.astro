  /* Footer premium: navegación útil + captación de nuevas tiendas. */
  .pz-public-footer {
    position: relative;
    isolation: isolate;
    border-radius: 28px;
    background:
      radial-gradient(circle at 88% 12%, rgba(37,99,235,.34), transparent 29%),
      radial-gradient(circle at 8% 94%, rgba(14,165,233,.13), transparent 30%),
      linear-gradient(145deg, #020b1f 0%, #061b45 46%, #03112f 100%);
    box-shadow: 0 30px 90px rgba(3,19,47,.34), inset 0 1px 0 rgba(255,255,255,.08);
  }
  .pz-public-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: .18;
    background-image: radial-gradient(circle, rgba(96,165,250,.7) 1px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: linear-gradient(135deg, transparent 16%, #000 52%, transparent 88%);
  }
  .pz-footer-main {
    position: relative;
    z-index: 1;
    padding: clamp(28px, 4vw, 48px);
    grid-template-columns: minmax(250px, .78fr) minmax(0, 1.42fr);
    gap: clamp(24px, 3.5vw, 44px);
  }
  .pz-footer-store {
    align-self: stretch;
    align-content: start;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 15px;
  }
  .pz-footer-logo-link {
    width: 66px;
    height: 66px;
    border-radius: 18px;
    background: rgba(255,255,255,.97);
    border-color: rgba(191,219,254,.48);
    box-shadow: 0 16px 34px rgba(0,0,0,.28), 0 0 28px rgba(59,130,246,.16);
  }
  .pz-footer-brand-copy h2 { font-size: clamp(27px, 3vw, 38px); }
  .pz-footer-description {
    margin: 16px 0 0;
    color: rgba(219,234,254,.82);
    font-size: 15px;
    line-height: 1.55;
  }
  .pz-footer-social { margin-top: 17px; gap: 9px; }
  .pz-footer-social a { width: 42px; height: 42px; }
  .pz-footer-utilities {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    align-self: start;
  }
  .pz-footer-utilities.count-1 { grid-template-columns: 1fr; }
  .pz-footer-utilities.count-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pz-footer-utility {
    min-width: 0;
    min-height: 132px;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    gap: 13px;
    border: 1px solid rgba(96,165,250,.25);
    border-radius: 20px;
    padding: 18px 16px;
    background: linear-gradient(145deg, rgba(8,29,71,.80), rgba(4,20,52,.66));
    color: #fff;
    text-align: left;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 16px 34px rgba(0,0,0,.14);
    transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .pz-footer-utility:hover {
    transform: translateY(-3px);
    border-color: rgba(96,165,250,.55);
    background: linear-gradient(145deg, rgba(15,49,111,.92), rgba(5,28,70,.82));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.10), 0 20px 42px rgba(0,0,0,.20);
  }
  .pz-footer-utility:focus-visible { outline: 3px solid rgba(96,165,250,.46); outline-offset: 3px; }
  .pz-footer-utility-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 15px;
    color: #60a5fa;
    background: rgba(37,99,235,.16);
    border: 1px solid rgba(96,165,250,.24);
