  .pz-platform-copy h3 { max-width: 560px; font-size: clamp(28px, 4vw, 46px); line-height: 1.05; letter-spacing: -.025em; }
  .pz-platform-copy p { max-width: 540px; margin-top: 15px; color: rgba(219,234,254,.82); font-size: clamp(14px, 1.5vw, 17px); line-height: 1.58; }
