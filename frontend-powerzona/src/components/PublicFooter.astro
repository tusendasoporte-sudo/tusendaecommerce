    width: min(100%, 430px);
    min-height: 62px;
    border-radius: 16px;
    background: #fff;
    color: #073b9b;
    font-size: 17px;
    box-shadow: 0 18px 40px rgba(0,0,0,.25), inset 0 -2px 0 rgba(15,23,42,.06);
