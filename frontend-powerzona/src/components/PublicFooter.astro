  .pz-footer-platform-cta {
    grid-area: auto;
    grid-column: 1 / -1;
    margin-top: 2px;
    padding: clamp(24px, 4vw, 44px);
    border-radius: 25px;
    border: 1px solid rgba(59,130,246,.72);
    background:
      radial-gradient(circle at 76% 38%, rgba(37,99,235,.27), transparent 28%),
      linear-gradient(135deg, rgba(6,34,86,.97), rgba(2,16,45,.98));
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(260px, .95fr);
    grid-template-areas:
      'copy visual'
      'button visual'
      'backed backed';
    gap: 22px clamp(24px, 4vw, 54px);
