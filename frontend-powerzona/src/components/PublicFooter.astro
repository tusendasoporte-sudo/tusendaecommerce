  .pz-footer-utility.is-whatsapp .pz-footer-utility-icon { color: #4ade80; background: rgba(34,197,94,.13); border-color: rgba(74,222,128,.28); }
  .pz-footer-secondary-links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 22px;
    padding-top: 2px;
