    stroke-linejoin: round;
  }

  .public-raffle-prize-total strong {
    color: #0f172a;
    font-size: inherit;
    line-height: inherit;
    font-weight: 1000;
  }

  .public-raffle-date {
    width: fit-content;
    max-width: 100%;
