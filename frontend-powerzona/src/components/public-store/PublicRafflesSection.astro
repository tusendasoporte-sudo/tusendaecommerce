    border-radius: 14px;
    color: #334155;
    background: rgba(255, 255, 255, .72);
    border: 1px solid rgba(219, 231, 255, .95);
    font-size: 12px;
    line-height: 1.25;
    font-weight: 850;
  }

  .public-raffle-date svg {
    grid-row: 1 / 3;
    width: 18px;
    height: 18px;
    fill: #2563eb;
  }

  .public-raffle-date span {
    color: #64748b;
  }

  .public-raffle-date time {
    color: #0f172a;
    font-weight: 1000;
  }

  .public-raffle-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    border-radius: 12px;
    padding: 12px 15px;
    background: linear-gradient(180deg, #126cff, #0057e6);
    color: #fff;
    font-size: 13px;
    line-height: 1;
    font-weight: 1000;
    box-shadow: 0 14px 24px rgba(37, 99, 235, .18);
  }

  .public-raffle-cta svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .3s ease;
  }

  .public-raffles-grid[data-count="2"] .public-raffle-card {
    grid-template-columns: minmax(150px, 42%) minmax(0, 1fr);
    min-height: 240px;
    gap: 16px;
  }

  .public-raffles-grid[data-count="2"] .public-raffle-title {
    font-size: 21px;
  }

  .public-raffles-grid[data-count="3"] .public-raffle-card {
    grid-template-columns: 1fr;
    min-height: 0;
    gap: 14px;
  }

  .public-raffles-grid[data-count="3"] .public-raffle-media {
    aspect-ratio: 16 / 10;
  }

  .public-raffles-grid[data-count="3"] .public-raffle-copy {
    align-content: start;
    padding: 0 2px 2px;
  }

  .public-raffles-grid[data-count="3"] .public-raffle-title {
    font-size: 20px;
  }

  @media (min-width: 860px) {
    .public-raffles-grid[data-count="1"] {
      grid-template-columns: minmax(0, 1fr);
    }

    .public-raffles-grid[data-count="2"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .public-raffles-grid[data-count="3"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .public-raffle-card:hover {
      transform: translateY(-4px);
      border-color: rgba(37, 99, 235, .82);
      box-shadow: 0 28px 64px rgba(37, 99, 235, .16);
    }

    .public-raffle-card:hover .public-raffle-slide.is-active img {
      transform: scale(1.035);
    }

    .public-raffle-card:hover .public-raffle-arrow,
    .public-raffle-card:focus-within .public-raffle-arrow {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }

    .public-raffle-card:hover .public-raffle-cta svg {
      transform: translateX(4px);
    }
  }

  @media (max-width: 720px) {
    .public-raffles-section {
      margin-bottom: 22px;
      overflow: hidden;
    }

    .public-raffles-head h2 {
      font-size: 21px;
    }

    .public-raffles-grid,
    .public-raffles-grid[data-count="1"],
    .public-raffles-grid[data-count="2"],
    .public-raffles-grid[data-count="3"] {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: min(88vw, 370px);
      grid-template-columns: none;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: rgba(148, 163, 184, .55) transparent;
      padding: 2px 10vw 14px 2px;
      margin-right: -10vw;
    }

    .public-raffles-grid::-webkit-scrollbar {
      height: 6px;
    }

    .public-raffles-grid::-webkit-scrollbar-track {
      background: transparent;
    }

    .public-raffles-grid::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, .45);
      border-radius: 999px;
    }

    .public-raffle-card,
    .public-raffles-grid[data-count="2"] .public-raffle-card,
    .public-raffles-grid[data-count="3"] .public-raffle-card {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 13px;
      padding: 13px;
      border-radius: 20px;
    }

    .public-raffle-media,
    .public-raffles-grid[data-count="3"] .public-raffle-media {
      aspect-ratio: 16 / 10;
      border-radius: 16px;
    }

    .public-raffle-ticket-bg {
      display: none;
    }

    .public-raffle-copy,
    .public-raffles-grid[data-count="3"] .public-raffle-copy {
      align-content: start;
      gap: 9px;
      padding: 0 1px 1px;
    }

    .public-raffle-title,
    .public-raffles-grid[data-count="2"] .public-raffle-title,
    .public-raffles-grid[data-count="3"] .public-raffle-title {
      font-size: 20px;
    }

    .public-raffle-arrows {
      display: none;
    }

    .public-raffle-dots {
      bottom: 10px;
    }

    .public-raffle-date {
      width: 100%;
    }

    .public-raffle-cta {
      width: 100%;
      min-height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .public-raffle-card,
    .public-raffle-slide,
    .public-raffle-slide img,
    .public-raffle-cta svg {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }

    .public-raffle-celebration {
      display: none !important;
    }
  }

  @keyframes publicRaffleReveal {
    from {
      opacity: 0;
      transform: translateY(14px) scale(.992);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes publicRaffleConfettiFall {
    0% {
      opacity: 0;
      transform:
        translate3d(0, -42px, 0)
        rotate(var(--start-rotation));
    }

    12% {
      opacity: .96;
    }

    82% {
      opacity: .92;
    }

    100% {
      opacity: 0;
      transform:
        translate3d(var(--drift), 340px, 0)
        rotate(var(--end-rotation));
    }
  }

  @keyframes publicRaffleStarFall {
    0% {
      opacity: 0;
      transform:
        translateY(-30px)
        scale(.45)
        rotate(-20deg);
    }

    24% {
      opacity: 1;
      transform:
        translateY(30px)
        scale(1.12)
        rotate(8deg);
    }

    80% {
      opacity: .88;
    }

    100% {
      opacity: 0;
      transform:
        translateY(260px)
        scale(.72)
        rotate(120deg);
    }
  }

  @keyframes publicRaffleStreamerFall {
    0% {
      opacity: 0;
      transform:
        translateY(-64px)
        rotate(-14deg);
    }

    10% {
      opacity: .9;
    }

    100% {
      opacity: 0;
      transform:
        translateY(330px)
        rotate(48deg);
    }
  }
</style>

<script>
  const cleanupPublicRaffleMotion = () => {
    const controllers = window.__publicRaffleCarouselControllers || [];
    controllers.forEach((controller) => controller?.destroy?.());
    window.__publicRaffleCarouselControllers = [];
  };

  const initPublicRaffleMotion = () => {
    cleanupPublicRaffleMotion();

    const cards = Array.from(
      document.querySelectorAll('[data-public-raffle-card]')
    );

    if (!cards.length) return;

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const controllers = [];

    const playCard = (card) => {
      if (card.dataset.motionPlayed === 'true') return;

      card.dataset.motionPlayed = 'true';
      card.classList.add('is-revealed');

      if (card.classList.contains('is-celebratory')) {
        card.classList.add('is-celebrating');

        window.setTimeout(() => {
          card.classList.remove('is-celebrating');
          card.classList.add('is-celebration-complete');
        }, 3900);
      }
    };

    const setupCarousel = (card) => {
      const slides = Array.from(card.querySelectorAll('[data-raffle-slide]'));
      const dots = Array.from(card.querySelectorAll('[data-raffle-dot]'));
      const prevButton = card.querySelector('[data-raffle-prev]');
      const nextButton = card.querySelector('[data-raffle-next]');
      const badge = card.querySelector('[data-raffle-featured-position]');
      const live = card.querySelector('[data-raffle-carousel-live]');
      const fallbackImage = card.dataset.raffleFallbackImage || '';
      const slideCount = slides.length;
      let activeIndex = 0;
      let timer = 0;
      let observer = null;
      let visible = false;
      let hovering = false;
      let focusing = false;
      let destroyed = false;
      let changeToken = 0;

      const stopTimer = () => {
        if (!timer) return;
        window.clearTimeout(timer);
        timer = 0;
      };

      const canAutoplay = () => (
        !destroyed
        && !reduceMotion
        && slideCount > 1
        && visible
        && !document.hidden
        && !hovering
        && !focusing
      );

      const imageForSlide = (index) => slides[index]?.querySelector('img');

      const ensureSlideImage = (index) => new Promise((resolve) => {
        const image = imageForSlide(index);
        if (!image) {
          resolve();
          return;
        }

        if (!image.getAttribute('src')) {
          const nextSrc = image.dataset.src || fallbackImage;
          if (nextSrc) image.src = nextSrc;
        }

        if (image.complete) {
          if (!image.naturalWidth && fallbackImage && image.src !== fallbackImage) {
            image.src = fallbackImage;
          }
          resolve();
          return;
        }

        let settled = false;
        const finish = () => {
          if (settled) return;
          settled = true;
          resolve();
        };

        image.addEventListener('load', finish, { once: true });
        image.addEventListener('error', () => {
          if (fallbackImage && image.src !== fallbackImage) image.src = fallbackImage;
          finish();
        }, { once: true });

        if (typeof image.decode === 'function') {
          image.decode().then(finish).catch(() => {});
        }

        window.setTimeout(finish, 1100);
      });

      const prepareNextSlide = () => {
        if (slideCount <= 1) return;
        const nextIndex = (activeIndex + 1) % slideCount;
        ensureSlideImage(nextIndex);
      };

      const updateLiveRegion = (index) => {
        if (!live || slideCount <= 1) return;
        const slide = slides[index];
        const label = slide?.dataset?.slideLiveLabel || 'rifa especial';
        const badgeLabel = slide?.dataset?.slideBadge || 'Rifa especial';
        live.textContent = slide?.dataset?.slideType === 'preview'
          ? `Mostrando portada de la rifa: ${label}`
          : `Mostrando ${badgeLabel}: ${label}`;
      };

      const showSlide = async (nextIndex, announce = false) => {
        if (slideCount <= 0) return;
        const normalizedIndex = (nextIndex + slideCount) % slideCount;
        const token = ++changeToken;
        await ensureSlideImage(normalizedIndex);
        if (destroyed || token !== changeToken) return;

        slides.forEach((slide, index) => {
          const active = index === normalizedIndex;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });

        dots.forEach((dot, index) => {
          const active = index === normalizedIndex;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-current', active ? 'true' : 'false');
        });

        if (badge) {
          badge.textContent = slides[normalizedIndex]?.dataset?.slideBadge || 'Rifa especial';
        }

        activeIndex = normalizedIndex;
        if (announce) updateLiveRegion(normalizedIndex);
        prepareNextSlide();
      };

      const schedule = (delay = 4000) => {
        stopTimer();
        if (!canAutoplay()) return;

        timer = window.setTimeout(async () => {
          await showSlide(activeIndex + 1, false);
          schedule(4000);
        }, delay);
      };

      const restart = (delay = 4000) => {
        if (!canAutoplay()) {
          stopTimer();
          return;
        }
        schedule(delay);
      };

      const goTo = async (index) => {
        stopTimer();
        await showSlide(index, true);
        restart(4000);
      };

      const handlePrev = () => goTo(activeIndex - 1);
      const handleNext = () => goTo(activeIndex + 1);
      const handleDotClick = (event) => {
        const index = Number(event.currentTarget?.dataset?.slideIndex || 0);
        goTo(index);
      };
      const handleMouseEnter = () => {
        hovering = true;
        stopTimer();
      };
      const handleMouseLeave = () => {
        hovering = false;
        restart(4000);
      };
      const handleFocusIn = () => {
        focusing = true;
        stopTimer();
      };
      const handleFocusOut = () => {
        focusing = false;
        restart(4000);
      };
      const handleVisibility = () => {
        if (document.hidden) {
          stopTimer();
          return;
        }
        restart(1200);
      };

      prevButton?.addEventListener('click', handlePrev);
      nextButton?.addEventListener('click', handleNext);
      dots.forEach((dot) => dot.addEventListener('click', handleDotClick));
      card.addEventListener('mouseenter', handleMouseEnter);
      card.addEventListener('mouseleave', handleMouseLeave);
      card.addEventListener('focusin', handleFocusIn);
      card.addEventListener('focusout', handleFocusOut);
      document.addEventListener('visibilitychange', handleVisibility);
      ensureSlideImage(0);

      if (reduceMotion) {
        visible = true;
        playCard(card);
        return {
          destroy() {
            destroyed = true;
            stopTimer();
            prevButton?.removeEventListener('click', handlePrev);
            nextButton?.removeEventListener('click', handleNext);
            dots.forEach((dot) => dot.removeEventListener('click', handleDotClick));
            card.removeEventListener('mouseenter', handleMouseEnter);
            card.removeEventListener('mouseleave', handleMouseLeave);
            card.removeEventListener('focusin', handleFocusIn);
            card.removeEventListener('focusout', handleFocusOut);
            document.removeEventListener('visibilitychange', handleVisibility);
          },
        };
      }

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.target !== card) return;

              visible = entry.isIntersecting && entry.intersectionRatio >= 0.3;

              if (!visible) {
                stopTimer();
                return;
              }

              playCard(card);
              prepareNextSlide();
              const firstDelay = card.dataset.carouselStarted === 'true'
                ? 1200
                : card.classList.contains('is-celebratory')
                  ? 4200
                  : 1200;
              card.dataset.carouselStarted = 'true';
              schedule(firstDelay);
            });
          },
          {
            threshold: [0, 0.3, 0.34, 0.6],
          }
        );

        card.classList.add('is-motion-ready');
        observer.observe(card);
      } else {
        visible = true;
        playCard(card);
        prepareNextSlide();
        schedule(card.classList.contains('is-celebratory') ? 4200 : 1200);
      }

      return {
        destroy() {
          destroyed = true;
          stopTimer();
          observer?.disconnect();
          prevButton?.removeEventListener('click', handlePrev);
          nextButton?.removeEventListener('click', handleNext);
          dots.forEach((dot) => dot.removeEventListener('click', handleDotClick));
          card.removeEventListener('mouseenter', handleMouseEnter);
          card.removeEventListener('mouseleave', handleMouseLeave);
          card.removeEventListener('focusin', handleFocusIn);
          card.removeEventListener('focusout', handleFocusOut);
          document.removeEventListener('visibilitychange', handleVisibility);
        },
      };
    };

    cards.forEach((card) => {
      controllers.push(setupCarousel(card));
    });

    window.__publicRaffleCarouselControllers = controllers;

    if (reduceMotion) {
      cards.forEach((card) => {
        card.classList.add(
          'is-revealed',
          'is-celebration-complete'
        );
      });
    }
  };

  initPublicRaffleMotion();

  if (!window.__publicRaffleMotionBound) {
    window.__publicRaffleMotionBound = true;
    document.addEventListener(
      'astro:page-load',
      initPublicRaffleMotion
    );
    document.addEventListener(
      'astro:before-swap',
      cleanupPublicRaffleMotion
    );
  }
</script>
