---
import {
  RAFFLE_STATUSES,
  formatRaffleDateTime,
  getCalculatedRaffleStatus,
  getStoreFeaturedPrizeCards,
  parseRafflePrizes,
  type RaffleRecord,
} from '../../lib/raffles';

interface Props {
  store: any;
  settings?: any;
  raffles?: RaffleRecord[];
}

const {
  store,
  settings = null,
  raffles = [],
} = Astro.props;

const storeSlug = String(store?.slug || '').trim().toLowerCase();
const storeName = String(settings?.store_name || store?.name || 'Tu tienda').trim();
const fallbackImage = '/images/raffles/raffle-preview-default-v1.jpg';

function publicRaffleState(raffle: RaffleRecord) {
  const status = getCalculatedRaffleStatus(raffle);
  if (status === RAFFLE_STATUSES.SCHEDULED) {
    return {
      status,
      label: 'Próximamente',
      dateLabel: 'Comienza el',
      dateValue: formatRaffleDateTime(raffle.starts_at, 'Por anunciar'),
      className: 'is-scheduled',
      celebratory: false,
    };
  }
  if (status === RAFFLE_STATUSES.ACTIVE) {
    return {
      status,
      label: 'Participa ahora',
      dateLabel: 'Selección disponible hasta',
      dateValue: formatRaffleDateTime(raffle.closes_at, 'Por anunciar'),
      className: 'is-active',
      celebratory: true,
    };
  }
  if (status === RAFFLE_STATUSES.SELECTION_CLOSED) {
    return {
      status,
      label: 'Selección cerrada',
      dateLabel: 'Sorteo el',
      dateValue: formatRaffleDateTime(raffle.draw_at, 'Por anunciar'),
      className: 'is-closed',
      celebratory: false,
    };
  }
  if (status === RAFFLE_STATUSES.RESULT_PENDING) {
    return {
      status,
      label: 'Resultado pendiente',
      dateLabel: 'Sorteo realizado el',
      dateValue: formatRaffleDateTime(raffle.draw_at, 'Por anunciar'),
      className: 'is-pending',
      celebratory: false,
    };
  }
  if (status === RAFFLE_STATUSES.WINNER_PUBLISHED || status === RAFFLE_STATUSES.NO_WINNER_PUBLISHED) {
    return {
      status,
      label: 'Resultado publicado',
      dateLabel: 'Sorteo realizado el',
      dateValue: formatRaffleDateTime(raffle.draw_at, 'Por anunciar'),
      className: 'is-result',
      celebratory: false,
    };
  }
  return null;
}

const raffleCards = raffles
  .map((raffle) => {
    const state = publicRaffleState(raffle);
    if (!state) return null;
    const allPrizes = parseRafflePrizes(raffle, storeName);
    const featuredPrizes = getStoreFeaturedPrizeCards(raffle, storeName);
    const totalPrizeCount = Math.max(allPrizes.length, 1);
    const featuredPrizeCount = featuredPrizes.length;
    const carouselSlides = [
      {
        type: 'preview',
        imageUrl: fallbackImage,
        badge: 'Rifa especial',
        label: 'Rifa especial',
        alt: `Portada promocional - ${String(raffle.title || 'Rifa activa').trim()}`,
      },
      ...featuredPrizes.map((prize, index) => ({
        type: 'prize',
        imageUrl: prize.imageUrl || fallbackImage,
        badge: `Destacado ${index + 1} de ${featuredPrizes.length}`,
        label: prize.name || prize.label || `Destacado ${index + 1}`,
        alt: `${prize.name || prize.label} - ${String(raffle.title || 'Rifa activa').trim()}`,
      })),
    ];
    const title = String(raffle.title || 'Rifa activa').trim();
    const href = `/t/${encodeURIComponent(storeSlug)}/rifa/${encodeURIComponent(raffle.slug || '')}`;

    return {
      raffle,
      state,
      href,
      featuredPrizes,
      featuredPrizeCount,
      carouselSlides,
      carouselSlideCount: carouselSlides.length,
      totalPrizeCount,
      title,
    };
  })
  .filter(Boolean)
  .slice(0, 3);

const confettiPieces = [
  { x: 7, drift: 32, delay: 90, color: '#2563eb', start: '-18deg', end: '156deg' },
  { x: 16, drift: -24, delay: 260, color: '#93c5fd', start: '24deg', end: '210deg' },
  { x: 27, drift: 18, delay: 430, color: '#f7c948', start: '-38deg', end: '176deg' },
  { x: 73, drift: -22, delay: 170, color: '#ffffff', start: '16deg', end: '190deg' },
  { x: 86, drift: 26, delay: 340, color: '#38bdf8', start: '-12deg', end: '168deg' },
  { x: 94, drift: -30, delay: 520, color: '#bbf7d0', start: '34deg', end: '220deg' },
];

const streamers = [
  { x: 10, delay: 120, color: '#2563eb' },
  { x: 88, delay: 300, color: '#f7c948' },
];

const stars = [
  { x: 18, delay: 220, color: '#f7c948' },
  { x: 80, delay: 420, color: '#ffffff' },
  { x: 92, delay: 620, color: '#93c5fd' },
];
---

{raffleCards.length > 0 && (
  <section class="public-raffles-section" aria-labelledby="public-raffles-title">
    <div class="public-raffles-head">
      <h2 id="public-raffles-title">Rifas activas</h2>
    </div>

    <div class="public-raffles-grid" data-count={raffleCards.length}>
      {raffleCards.map((item: any) => (
        <article
          class:list={[
            'public-raffle-card',
            item.state.celebratory && 'is-celebratory',
          ]}
          data-public-raffle-card
          data-raffle-carousel-count={item.carouselSlideCount}
          data-raffle-featured-count={item.featuredPrizeCount}
          data-raffle-fallback-image={fallbackImage}
        >
          {raffleCards.length === 1 && (
            <svg class="public-raffle-ticket-bg" viewBox="0 0 180 120" aria-hidden="true">
              <path d="M16 34a18 18 0 0 0 18-18h112a18 18 0 0 0 18 18v52a18 18 0 0 0-18 18H34a18 18 0 0 0-18-18V34Z"></path>
              <path d="M68 17v86"></path>
              <circle cx="91" cy="60" r="20"></circle>
            </svg>
          )}

          <span class="public-raffle-media">
            <a
              class="public-raffle-media-link"
              href={item.href}
              aria-label={`Ver rifa ${item.title}`}
            >
              {item.carouselSlides.map((slide: any, index: number) => (
                <span
                  class:list={[
                    'public-raffle-slide',
                    slide.type === 'preview' && 'is-preview',
                    index === 0 && 'is-active',
                  ]}
                  data-raffle-slide
                  data-slide-index={index}
                  data-slide-type={slide.type}
                  data-slide-badge={slide.badge}
                  data-slide-live-label={slide.label}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                >
                  <img
                    src={index === 0 ? slide.imageUrl || fallbackImage : undefined}
                    data-src={index > 0 ? slide.imageUrl || fallbackImage : undefined}
                    alt={slide.alt}
                    loading="lazy"
                    decoding="async"
                  />

                  {slide.type === 'preview' && (
                    <span class="public-raffle-preview-label">
                      Rifa especial
                    </span>
                  )}

                  {slide.type === 'prize' && slide.label && (
                    <span class="public-raffle-prize-name">
                      {slide.label}
                    </span>
                  )}
                </span>
              ))}
            </a>

            {item.carouselSlideCount > 1 && (
              <span
                class="public-raffle-featured-badge"
                data-raffle-featured-position
              >
                Rifa especial
              </span>
            )}

            {item.carouselSlideCount > 1 && (
              <span class="public-raffle-arrows" aria-hidden="false">
                <button
                  class="public-raffle-arrow is-prev"
                  type="button"
                  data-raffle-prev
                  aria-label="Mostrar destacado anterior"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                </button>
                <button
                  class="public-raffle-arrow is-next"
                  type="button"
                  data-raffle-next
                  aria-label="Mostrar destacado siguiente"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                </button>
              </span>
            )}

            {item.carouselSlideCount > 1 && (
              <span class="public-raffle-dots" role="tablist" aria-label="Premios destacados">
                {item.carouselSlides.map((slide: any, index: number) => (
                  <button
                    class:list={[
                      'public-raffle-dot',
                      index === 0 && 'is-active',
                    ]}
                    type="button"
                    data-raffle-dot
                    data-slide-index={index}
                    aria-label={slide.type === 'preview'
                      ? 'Mostrar portada de la rifa'
                      : `Mostrar ${slide.badge}`}
                    aria-current={index === 0 ? 'true' : 'false'}
                  ></button>
                ))}
              </span>
            )}

            <span
              class="sr-only"
              aria-live="polite"
              data-raffle-carousel-live
            ></span>

            {item.state.celebratory && (
              <span class="public-raffle-celebration" aria-hidden="true">
                {confettiPieces.map((piece) => (
                  <span
                    class="public-raffle-confetti"
                    style={`--x:${piece.x}%; --drift:${piece.drift}px; --delay:${piece.delay}ms; --confetti-color:${piece.color}; --start-rotation:${piece.start}; --end-rotation:${piece.end};`}
                  ></span>
                ))}
                {streamers.map((streamer) => (
                  <span
                    class="public-raffle-streamer"
                    style={`--x:${streamer.x}%; --delay:${streamer.delay}ms; --streamer-color:${streamer.color};`}
                  ></span>
                ))}
                {stars.map((star) => (
                  <span
                    class="public-raffle-star"
                    style={`--x:${star.x}%; --delay:${star.delay}ms; --star-color:${star.color};`}
                  ></span>
                ))}
              </span>
            )}
          </span>

          <a
            class="public-raffle-copy"
            href={item.href}
          >
            <span class={`public-raffle-status ${item.state.className}`}>{item.state.label}</span>
            <strong class="public-raffle-title">{item.title}</strong>
            <span class="public-raffle-tagline">Rifa exclusiva para miembros del grupo</span>
            <span class="public-raffle-prize-total">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7"></path>
                <path d="M3 8h18v4H3z"></path>
                <path d="M12 8v13"></path>
                <path d="M12 8H8.5a2.5 2.5 0 1 1 2.5-2.5V8Z"></path>
                <path d="M12 8h3.5A2.5 2.5 0 1 0 13 5.5V8Z"></path>
              </svg>

              <span>
                El ganador recibe
                <strong>{item.totalPrizeCount}</strong>
                {item.totalPrizeCount === 1 ? 'premio' : 'premios'}
              </span>
            </span>
            <span class="public-raffle-date">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h2v2h6V2h2v2h3v18H4V4h3V2Zm13 8H4v10h16V10ZM6 6v2h12V6H6Z"></path></svg>
              <span>{item.state.dateLabel}</span>
              <time>{item.state.dateValue}</time>
            </span>
            <span class="public-raffle-cta">
              Ver rifa
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </span>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .public-raffles-section {
    margin: 0 0 26px;
    max-width: 100%;
  }

  .public-raffles-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 2px 14px;
  }

  .public-raffles-head h2 {
    margin: 0;
    color: #0f172a;
    font-size: 23px;
    line-height: 1.1;
    font-weight: 1000;
    letter-spacing: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .public-raffles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
    max-width: 100%;
  }

  .public-raffle-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(220px, 36%) minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
    min-height: 270px;
    padding: 16px;
    border: 1px solid rgba(37, 99, 235, .45);
    border-radius: 24px;
    background: linear-gradient(135deg, #ffffff 0%, #f8fbff 54%, #edf5ff 100%);
    color: #0f172a;
    box-shadow: 0 20px 48px rgba(15, 23, 42, .10);
    text-decoration: none;
    scroll-snap-align: start;
    transition:
      transform .3s ease,
      border-color .3s ease,
      box-shadow .3s ease;
    isolation: isolate;
  }

  .public-raffle-card:active {
    transform: scale(.992);
  }

  .public-raffle-media-link:focus-visible,
  .public-raffle-copy:focus-visible,
  .public-raffle-arrow:focus-visible,
  .public-raffle-dot:focus-visible {
    outline: 3px solid rgba(37, 99, 235, .22);
    outline-offset: 3px;
  }

  .public-raffle-card.is-motion-ready {
    opacity: 0;
    transform: translateY(14px) scale(.992);
  }

  .public-raffle-card.is-revealed {
    animation: publicRaffleReveal 580ms cubic-bezier(.22, 1, .36, 1) both;
  }

  .public-raffle-ticket-bg {
    position: absolute;
    right: -18px;
    bottom: -18px;
    width: min(210px, 32%);
    color: #075bea;
    opacity: .065;
    pointer-events: none;
    z-index: 0;
  }

  .public-raffle-ticket-bg path,
  .public-raffle-ticket-bg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .public-raffle-media {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    display: block;
    border-radius: 18px;
    background: linear-gradient(145deg, #dbeafe, #eff6ff);
    border: 1px solid rgba(191, 219, 254, .9);
  }

  .public-raffle-media-link {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: inherit;
    overflow: hidden;
    z-index: 1;
  }

  .public-raffle-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateX(14px) scale(.992);
    transition:
      opacity .46s ease,
      transform .46s cubic-bezier(.22, 1, .36, 1);
    pointer-events: none;
  }

  .public-raffle-slide.is-active {
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
    z-index: 1;
  }

  .public-raffle-slide img {
    width: 100%;
    height: 100%;
    min-height: 100%;
    object-fit: contain;
    display: block;
    padding: 10px;
    transition: transform .55s cubic-bezier(.22, 1, .36, 1);
  }

  .public-raffle-prize-name,
  .public-raffle-preview-label {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    width: fit-content;
    max-width: calc(100% - 24px);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    border-radius: 999px;
    padding: 7px 10px;
    color: #0f172a;
    background: rgba(255, 255, 255, .82);
    border: 1px solid rgba(219, 231, 255, .95);
    box-shadow: 0 10px 20px rgba(15, 23, 42, .10);
    backdrop-filter: blur(8px);
    font-size: 12px;
    line-height: 1.2;
    font-weight: 950;
  }

  .public-raffle-preview-label {
    color: #1e3a8a;
    background: rgba(239, 246, 255, .88);
    border-color: rgba(147, 197, 253, .95);
  }

  .public-raffle-card[data-raffle-carousel-count="2"] .public-raffle-prize-name,
  .public-raffle-card[data-raffle-carousel-count="3"] .public-raffle-prize-name,
  .public-raffle-card[data-raffle-carousel-count="4"] .public-raffle-prize-name,
  .public-raffle-card[data-raffle-carousel-count="5"] .public-raffle-prize-name,
  .public-raffle-card[data-raffle-carousel-count="2"] .public-raffle-preview-label,
  .public-raffle-card[data-raffle-carousel-count="3"] .public-raffle-preview-label,
  .public-raffle-card[data-raffle-carousel-count="4"] .public-raffle-preview-label,
  .public-raffle-card[data-raffle-carousel-count="5"] .public-raffle-preview-label {
    bottom: 50px;
  }

  .public-raffle-featured-badge {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    border-radius: 999px;
    padding: 7px 10px;
    color: #1d4ed8;
    background: rgba(255, 255, 255, .86);
    border: 1px solid rgba(191, 219, 254, .95);
    box-shadow: 0 10px 22px rgba(15, 23, 42, .10);
    font-size: 11px;
    line-height: 1;
    font-weight: 1000;
  }

  .public-raffle-arrows {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
  }

  .public-raffle-arrow {
    position: absolute;
    top: 50%;
    width: 40px;
    height: 40px;
    display: inline-grid;
    place-items: center;
    border: 1px solid rgba(191, 219, 254, .88);
    border-radius: 999px;
    background: rgba(255, 255, 255, .78);
    color: #1d4ed8;
    box-shadow: 0 12px 24px rgba(15, 23, 42, .13);
    opacity: 0;
    transform: translateY(-50%) scale(.96);
    pointer-events: auto;
    transition: opacity .2s ease, transform .2s ease, background .2s ease;
  }

  .public-raffle-arrow.is-prev {
    left: 10px;
  }

  .public-raffle-arrow.is-next {
    right: 10px;
  }

  .public-raffle-arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .public-raffle-dots {
    position: absolute;
    left: 50%;
    bottom: 12px;
    z-index: 7;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .82);
    border: 1px solid rgba(219, 231, 255, .9);
    box-shadow: 0 10px 22px rgba(15, 23, 42, .10);
    transform: translateX(-50%);
  }

  .public-raffle-dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #93c5fd;
  }

  .public-raffle-dot.is-active,
  .public-raffle-dot[aria-current="true"] {
    width: 20px;
    background: #2563eb;
  }

  .public-raffle-celebration {
    position: absolute;
    inset: 0;
    z-index: 8;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
  }

  .public-raffle-card.is-celebrating .public-raffle-celebration {
    opacity: 1;
  }

  .public-raffle-card.is-celebration-complete .public-raffle-celebration {
    display: none;
  }

  .public-raffle-confetti,
  .public-raffle-streamer,
  .public-raffle-star {
    position: absolute;
    top: 0;
    left: var(--x);
    animation-fill-mode: both;
    animation-iteration-count: 1;
    will-change: transform, opacity;
  }

  .public-raffle-confetti {
    width: 5px;
    height: 15px;
    border-radius: 999px;
    background: var(--confetti-color);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .22);
  }

  .public-raffle-streamer {
    width: 13px;
    height: 46px;
    border-radius: 999px 999px 4px 4px;
    background:
      repeating-linear-gradient(
        180deg,
        var(--streamer-color) 0 8px,
        rgba(255, 255, 255, .82) 8px 13px
      );
    opacity: 0;
  }

  .public-raffle-star {
    width: 18px;
    height: 18px;
    background: var(--star-color);
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 56%, 79% 91%, 50% 70%, 21% 91%, 32% 56%, 2% 35%, 39% 35%);
    filter: drop-shadow(0 4px 8px rgba(15, 23, 42, .12));
    opacity: 0;
  }

  .public-raffle-card.is-celebrating .public-raffle-confetti {
    animation-name: publicRaffleConfettiFall;
    animation-duration: 3600ms;
    animation-delay: var(--delay);
    animation-timing-function: cubic-bezier(.2, .8, .22, 1);
  }

  .public-raffle-card.is-celebrating .public-raffle-streamer {
    animation-name: publicRaffleStreamerFall;
    animation-duration: 3600ms;
    animation-delay: var(--delay);
    animation-timing-function: cubic-bezier(.22, .7, .22, 1);
  }

  .public-raffle-card.is-celebrating .public-raffle-star {
    animation-name: publicRaffleStarFall;
    animation-duration: 3600ms;
    animation-delay: var(--delay);
    animation-timing-function: cubic-bezier(.22, .72, .28, 1);
  }

  .public-raffle-copy {
    position: relative;
    z-index: 1;
    min-width: 0;
    display: grid;
    align-content: center;
    gap: 12px;
    padding: 12px 4px;
    color: inherit;
    text-decoration: none;
  }

  .public-raffle-status {
    width: max-content;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 7px 10px;
    font-size: 11px;
    line-height: 1;
    font-weight: 1000;
    color: #1d4ed8;
    background: #dbeafe;
    border: 1px solid #bfdbfe;
  }

  .public-raffle-status.is-active {
    color: #166534;
    background: #dcfce7;
    border-color: #bbf7d0;
  }

  .public-raffle-status.is-closed,
  .public-raffle-status.is-pending {
    color: #92400e;
    background: #fef3c7;
    border-color: #fde68a;
  }

  .public-raffle-status.is-result {
    color: #581c87;
    background: #f3e8ff;
    border-color: #e9d5ff;
  }

  .public-raffle-title {
    min-width: 0;
    color: #0f172a;
    font-size: 28px;
    line-height: 1.08;
    font-weight: 1000;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .public-raffle-tagline {
    color: #334155;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 850;
  }

  .public-raffle-prize-total {
    width: fit-content;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    border-radius: 14px;
    color: #1e3a8a;
    background: rgba(239, 246, 255, .86);
    border: 1px solid rgba(191, 219, 254, .95);
    font-size: 12px;
    line-height: 1.25;
    font-weight: 900;
  }

  .public-raffle-prize-total svg {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    fill: none;
    stroke: #2563eb;
