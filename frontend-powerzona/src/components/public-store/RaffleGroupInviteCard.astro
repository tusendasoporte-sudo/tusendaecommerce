---
import { normalizeWhatsAppGroupInviteUrl } from '../../lib/raffles';

interface Props {
  href: string;
  wide?: boolean;
}

const {
  href,
  wide = false,
} = Astro.props;

const normalizedHref = normalizeWhatsAppGroupInviteUrl(href);
---

{normalizedHref && (
  <article
    class:list={[
      'pz-group-invite-card',
      wide && 'is-wide',
    ]}
  >
    <span class="pz-group-invite-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M22 21v-2a4 4 0 0 0-3-3.85"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
    </span>

    <div class="pz-group-invite-copy">
      <h2>¿Aún no eres miembro?</h2>

      <p>
        Únete a nuestro grupo de WhatsApp y prepárate para participar en la próxima rifa cuando cumplas los requisitos.
      </p>

      <small>
        La participación está sujeta a las condiciones de cada rifa.
      </small>
    </div>

    <a
      class="pz-group-invite-button"
      href={normalizedHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 11.6a8.3 8.3 0 0 1-12.3 7.3L4 20l1.2-4A8.3 8.3 0 1 1 20.5 11.6Z"></path>
        <path d="M9.4 8.2c.2-.45.45-.5.8-.5h.55c.18 0 .4.05.55.4.18.44.6 1.5.65 1.62.07.13.1.3.02.48-.1.2-.15.3-.3.48l-.42.48c-.14.14-.28.3-.12.58.16.3.72 1.16 1.55 1.88 1.07.95 1.95 1.25 2.24 1.4.3.15.48.13.66-.08.2-.22.76-.88.96-1.18.2-.3.4-.25.68-.15.28.1 1.76.83 2.06.98.3.15.5.23.58.36.08.13.08.78-.18 1.52-.25.75-1.48 1.44-2.07 1.49-.55.04-1.25.2-4.05-.95-3.42-1.4-5.58-4.9-5.75-5.13-.17-.23-1.38-1.84-1.38-3.5 0-1.68.88-2.5 1.2-2.84Z"></path>
      </svg>
      Unirme al grupo de WhatsApp
    </a>
  </article>
)}

<style>
  .pz-group-invite-card {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 18px;
    border: 1px solid rgba(22, 163, 74, .34);
    border-radius: 20px;
    background:
      linear-gradient(135deg, #ffffff 0%, #f7fffb 58%, #ecfdf3 100%);
    box-shadow: 0 18px 42px rgba(15, 23, 42, .08);
    color: #0f172a;
  }

  .pz-group-invite-card.is-wide {
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    padding: 20px;
  }

  .pz-group-invite-icon {
    width: 46px;
    height: 46px;
    display: inline-grid;
    place-items: center;
    border-radius: 16px;
    color: #15803d;
    background: #dcfce7;
    border: 1px solid #bbf7d0;
    box-shadow: 0 12px 24px rgba(22, 163, 74, .12);
  }

  .pz-group-invite-icon svg,
  .pz-group-invite-button svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pz-group-invite-copy {
    min-width: 0;
    display: grid;
    gap: 7px;
  }

  .pz-group-invite-copy h2 {
    margin: 0;
    color: #061642;
    font-size: 18px;
    line-height: 1.12;
    font-weight: 1000;
    letter-spacing: 0;
  }

  .pz-group-invite-copy p {
    margin: 0;
    color: #334155;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 780;
  }

  .pz-group-invite-copy small {
    color: #64748b;
    font-size: 12px;
    line-height: 1.35;
    font-weight: 800;
  }

  .pz-group-invite-button {
    grid-column: 1 / -1;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 14px;
    border-radius: 13px;
    background: linear-gradient(180deg, #16a34a, #0f8f3d);
    color: #ffffff;
    font-size: 13px;
    line-height: 1;
    font-weight: 1000;
    text-decoration: none;
    box-shadow: 0 14px 28px rgba(22, 163, 74, .20);
  }

  .pz-group-invite-button:focus-visible {
    outline: 3px solid rgba(22, 163, 74, .22);
    outline-offset: 3px;
  }

  .pz-group-invite-card.is-wide .pz-group-invite-button {
    grid-column: auto;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .pz-group-invite-card,
    .pz-group-invite-card.is-wide {
      grid-template-columns: 1fr;
      padding: 16px;
    }

    .pz-group-invite-icon {
      width: 42px;
      height: 42px;
    }

    .pz-group-invite-button,
    .pz-group-invite-card.is-wide .pz-group-invite-button {
      grid-column: auto;
      width: 100%;
      white-space: normal;
      text-align: center;
    }
  }
</style>
