<div
  class="pz-admin-refresh-toast"
  data-pz-admin-refresh-toast
  data-tone="success"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  hidden
>
  <span class="pz-admin-refresh-toast__icon" aria-hidden="true">✓</span>
  <span data-pz-admin-refresh-message>Datos actualizados</span>
</div>

<script is:inline>
  (() => {
    if (window.PZAdminRefreshFeedback) return;

    const toast = document.querySelector('[data-pz-admin-refresh-toast]');
    const message = toast?.querySelector('[data-pz-admin-refresh-message]');
    const active = new WeakMap();
    const navigationKey = 'pz:admin-refresh:navigation';
    let toastTimer = 0;
    let hideTimer = 0;

    const show = (text, tone = 'success') => {
      if (!toast || !message) return;
      window.clearTimeout(toastTimer);
      window.clearTimeout(hideTimer);
      message.textContent = String(text || (tone === 'error' ? 'No se pudieron actualizar los datos' : 'Datos actualizados'));
      toast.dataset.tone = tone === 'error' ? 'error' : 'success';
      const icon = toast.querySelector('.pz-admin-refresh-toast__icon');
      if (icon) icon.textContent = tone === 'error' ? '!' : '✓';
      toast.hidden = false;
      toast.classList.remove('is-leaving');
      requestAnimationFrame(() => toast.classList.add('is-visible'));
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
        toast.classList.add('is-leaving');
        hideTimer = window.setTimeout(() => {
          toast.hidden = true;
          toast.classList.remove('is-leaving');
        }, 180);
      }, tone === 'error' ? 4200 : 3000);
    };

    const begin = (button) => {
      if (!(button instanceof HTMLElement)) return null;
      const previous = active.get(button);
      if (previous) return previous;
      const spinner = document.createElement('span');
      spinner.className = 'pz-admin-refresh-spinner';
      spinner.classList.toggle('is-icon-only', !String(button.textContent || '').trim());
      spinner.setAttribute('aria-hidden', 'true');
      button.prepend(spinner);
      const state = {
        button,
        spinner,
        wasDisabled: button instanceof HTMLButtonElement ? button.disabled : false,
      };
      active.set(button, state);
      button.setAttribute('aria-busy', 'true');
      button.dataset.pzRefreshBusy = 'true';
      if (button instanceof HTMLButtonElement) button.disabled = true;
      return state;
    };

    const finish = (state) => {
      if (!state || active.get(state.button) !== state) return;
      active.delete(state.button);
      state.spinner.remove();
      state.button.removeAttribute('aria-busy');
      delete state.button.dataset.pzRefreshBusy;
      if (state.button instanceof HTMLButtonElement) state.button.disabled = state.wasDisabled;
    };

    const run = async (button, task, options = {}) => {
      const existing = button instanceof HTMLElement ? active.get(button) : null;
      if (existing?.promise) return existing.promise;
      const state = begin(button);
      const promise = Promise.resolve()
        .then(task)
        .then((result) => {
          finish(state);
          show(options.successMessage || 'Datos actualizados', 'success');
          return result;
        })
        .catch((error) => {
          finish(state);
          show(options.errorMessage || 'No se pudieron actualizar los datos', 'error');
          throw error;
        });
      if (state) state.promise = promise;
      return promise;
    };

    window.PZAdminRefreshFeedback = {
      run,
      success: (text) => show(text || 'Datos actualizados', 'success'),
      error: (text) => show(text || 'No se pudieron actualizar los datos', 'error'),
    };

    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest('[data-pz-refresh-navigation]')
        : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      try {
        sessionStorage.setItem(navigationKey, JSON.stringify({
          createdAt: Date.now(),
          message: link.dataset.pzRefreshSuccess || 'Datos actualizados',
        }));
      } catch {}
      begin(link);
    }, true);

    const restoreNavigationFeedback = () => {
      try {
        const saved = JSON.parse(sessionStorage.getItem(navigationKey) || 'null');
        sessionStorage.removeItem(navigationKey);
        if (!saved || Date.now() - Number(saved.createdAt || 0) >= 15000) return;
        const failed = document.querySelector('[data-pz-refresh-result="error"]');
        show(
          failed?.getAttribute('data-pz-refresh-error-message') || saved.message || 'Datos actualizados',
          failed ? 'error' : 'success',
        );
      } catch {}
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', restoreNavigationFeedback, { once: true });
    } else {
      restoreNavigationFeedback();
    }
  })();
</script>

<style is:global>
  .pz-admin-refresh-toast {
    position: fixed;
    right: 22px;
    bottom: 24px;
    z-index: 2200;
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(370px, calc(100vw - 30px));
    padding: 13px 15px;
    border: 1px solid #bbf7d0;
    border-radius: 14px;
    background: #f0fdf4;
    color: #166534;
    box-shadow: 0 18px 50px rgba(15, 23, 42, .18);
    font-family: inherit;
    font-size: 13px;
    line-height: 1.45;
    font-weight: 900;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .18s ease, transform .18s ease;
  }

  .pz-admin-refresh-toast[hidden] { display: none !important; }
  .pz-admin-refresh-toast.is-visible { opacity: 1; transform: translateY(0); }
  .pz-admin-refresh-toast.is-leaving { pointer-events: none; }
  .pz-admin-refresh-toast[data-tone="error"] { border-color: #fecaca; background: #fff1f2; color: #991b1b; }

  .pz-admin-refresh-toast__icon {
    display: inline-grid;
    flex: 0 0 25px;
    width: 25px;
    height: 25px;
    place-items: center;
    border-radius: 999px;
    background: #dcfce7;
    color: #15803d;
    font-size: 14px;
    font-weight: 1000;
  }

  .pz-admin-refresh-toast[data-tone="error"] .pz-admin-refresh-toast__icon { background: #fee2e2; color: #b91c1c; }

  .pz-admin-refresh-spinner {
    display: inline-block;
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    margin-right: 7px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 999px;
    vertical-align: -2px;
    animation: pz-admin-refresh-spin .7s linear infinite;
  }

  .pz-admin-refresh-spinner.is-icon-only { margin-right: 0; }
  [data-pz-refresh-busy="true"] > svg { display: none !important; }

  [data-pz-refresh-busy="true"] { cursor: wait !important; }

  @keyframes pz-admin-refresh-spin { to { transform: rotate(360deg); } }

  @media (max-width: 1023px) {
    .pz-admin-refresh-toast {
      right: 15px;
      bottom: calc(90px + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pz-admin-refresh-toast { transition: none; }
    .pz-admin-refresh-spinner { animation-duration: 1.4s; }
  }
</style>
