    }

    .table-body {
      display: grid;
      gap: 10px;
    }

    .customers-table .table-row,
    .activity-table .table-row,
    .activity-table.has-ip .table-row,
    .visitors-table .table-row,
    .visitors-table.has-ip .table-row,
    .blocks-table .table-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

    .table-cell {
      display: grid;
      grid-template-columns: minmax(96px, .42fr) minmax(0, 1fr);
      gap: 10px;
      align-items: start;
    }

    .table-cell::before {
      content: attr(data-label);
      color: #64748b;
      font-size: 11px;
      line-height: 1.2;
      font-weight: 1000;
      text-transform: uppercase;
    }

    .main-cell,
    .sensitive-cell {
      grid-template-columns: minmax(96px, .42fr) minmax(0, 1fr);
    }

    .main-cell strong,
    .main-cell span,
    .sensitive-cell strong,
    .sensitive-cell span {
      grid-column: 2;
    }

    .main-cell::before,
    .sensitive-cell::before {
      grid-row: 1 / span 2;
    }

    .action-cell {
      justify-content: stretch;
      grid-template-columns: 1fr;
    }

    .compact-actions {
      justify-content: stretch;
    }
  }

