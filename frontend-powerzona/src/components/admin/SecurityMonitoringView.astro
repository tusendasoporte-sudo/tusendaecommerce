                      class="icon-action customer-menu-trigger"
                      type="button"
                      aria-label="Acciones"
                      aria-haspopup="menu"
                      aria-controls="security-customer-actions-menu"
                      aria-expanded="false"
                      data-customer-id={customer.id}
                      data-customer-archived={customer.archived ? 'true' : 'false'}
                      data-lifecycle-label={lifecycleActionLabel(customer)}
                      data-lifecycle-action={lifecycleActionValue(customer)}
                      data-lifecycle-disabled={!customer.archived && customer.status === 'blocked' ? 'true' : 'false'}
