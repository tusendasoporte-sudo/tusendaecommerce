          <h4 id="admin-customer-title">Administrar cliente</h4>
          <p>{selectedCustomer.archived ? 'Esta ficha esta archivada.' : 'Acciones privadas sobre la ficha de Seguridad.'}</p>
        </div>
        <div class="admin-customer-actions">
          <button
            class="secondary-action customer-observation-trigger"
            type="button"
