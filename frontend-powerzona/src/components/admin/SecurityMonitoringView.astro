---
import {
  CAPTURE_STATUS_LABELS,
  CUSTOMER_STATUS_FILTERS,
  CUSTOMER_STATUS_LABELS,
  DELIVERY_METHOD_LABELS,
  EVENT_DECISION_LABELS,
  EVENT_RISK_FILTERS,
  EVENT_RISK_LABELS,
  EVENT_TYPE_FILTERS,
  EVENT_TYPE_LABELS,
  MODE_AT_EVENT_LABELS,
  ORDER_STATUS_LABELS,
  formatDateTime,
  formatMoneyUsd,
  formatNumber,
  getDisplayCustomerName,
  getIpDisplayValue,
  getIpUnavailableNote,
  getOrderTotal,
  getVisitorDisplayName,
  getVisitorPhone,
  labelFromMap,
  type CustomerStatusFilter,
  type EventRiskFilter,
  type EventTypeFilter,
  type PaginatedResult,
  type SecurityAvailableSignals,
  type SecurityAddressCandidate,
  type SecurityBlock,
  type SecurityBlockCapabilities,
  type SecurityBlockHistorySummary,
  type SecurityBlocksMetrics,
  type SecurityCustomer,
  type SecurityCustomerDevice,
  type SecurityCustomerLifecycleCounts,
  type SecurityCustomerLinksSummary,
  type SecurityCustomerPhone,
  type SecurityEventRow,
  type SecurityMonitoringParams,
  type SecurityOrder,
  type SecuritySettingsView,
  type SecuritySummary,
  type SecurityVisitorSessionRow,
  type ManualIpBlockDraft,
  type ManualIpDeviceLookupResult,
} from '../../lib/securityMonitoring';
import { getSecurityIpVisibilityLabel, getSecurityModeLabel, getSecurityVpnPolicyLabel } from '../../lib/security';

interface Props {
  context: 'store' | 'master';
  storeName: string;
  basePath: string;
  adminOrdersPath: string;
  backHref?: string;
  backLabel?: string;
  params: SecurityMonitoringParams;
  settings: SecuritySettingsView;
  summary: SecuritySummary | null;
  summaryError?: boolean;
  viewNotice?: string;
  viewError?: string;
  customerUnavailable?: boolean;
  customersResult?: PaginatedResult<SecurityCustomer> | null;
  activityResult?: PaginatedResult<SecurityEventRow> | null;
  visitorsResult?: PaginatedResult<SecurityVisitorSessionRow> | null;
  blocksResult?: PaginatedResult<SecurityBlock> | null;
  blocksMetrics?: SecurityBlocksMetrics | null;
  selectedCustomer?: SecurityCustomer | null;
  customerOrders?: PaginatedResult<SecurityOrder> | null;
  customerEvents?: PaginatedResult<SecurityEventRow> | null;
  customerPhones?: SecurityCustomerPhone[];
  customerDevices?: SecurityCustomerDevice[];
  customerLinksSummary?: SecurityCustomerLinksSummary | null;
  customerLifecycleCounts?: SecurityCustomerLifecycleCounts | null;
  activeBlocks?: SecurityBlock[];
  blockHistorySummary?: SecurityBlockHistorySummary | null;
  blockCapabilities?: SecurityBlockCapabilities | null;
  availableSignals?: SecurityAvailableSignals | null;
  addressCandidates?: SecurityAddressCandidate[];
  customerIdentityWarnings?: string[];
  mergeCandidates?: SecurityCustomer[];
  customerOrdersError?: boolean;
  customerEventsError?: boolean;
  actionsEnabled?: boolean;
  manualIpDraft?: ManualIpBlockDraft | null;
  manualIpDeviceLookup?: ManualIpDeviceLookupResult | null;
}

const {
  context,
  storeName,
  basePath,
  adminOrdersPath,
  backHref = '',
  backLabel = 'Volver',
  params,
  settings,
  summary,
  summaryError = false,
  viewNotice = '',
  viewError = '',
  customerUnavailable = false,
  customersResult = null,
  activityResult = null,
  visitorsResult = null,
  blocksResult = null,
  blocksMetrics = null,
  selectedCustomer = null,
  customerOrders = null,
  customerEvents = null,
  customerPhones = [],
  customerDevices = [],
  customerLinksSummary = null,
  customerLifecycleCounts = null,
  activeBlocks = [],
  blockHistorySummary = null,
  blockCapabilities = null,
  availableSignals = null,
  addressCandidates = [],
  customerIdentityWarnings = [],
  mergeCandidates = [],
  customerOrdersError = false,
  customerEventsError = false,
  actionsEnabled = true,
  manualIpDraft = null,
  manualIpDeviceLookup = null,
} = Astro.props;

const ipVisibility = String(settings.ip_visibility || 'hidden');
const showIp = ipVisibility !== 'hidden';
const isFullIp = ipVisibility === 'full';
const canCreateManualIpBlock = actionsEnabled
  && settings.mode === 'protection'
  && settings.manual_blocking_enabled === true;
const titlePrefix = context === 'master' ? 'Monitoreo Master' : 'Seguridad';
const modeLabel = getSecurityModeLabel(settings.mode);
const ipLabel = getSecurityIpVisibilityLabel(settings.ip_visibility);
const vpnPolicyLabel = getSecurityVpnPolicyLabel(settings.vpn_policy);
const manualIpPreviewReady = Boolean(manualIpDraft && manualIpDeviceLookup);
const statusOptions = [
  ['all', 'Todos'],
  ['normal', CUSTOMER_STATUS_LABELS.normal],
  ['watch', CUSTOMER_STATUS_LABELS.watch],
  ['blocked', CUSTOMER_STATUS_LABELS.blocked],
  ['archived', 'Archivados'],
] as const;
const blockStatusOptions = [
  ['active', 'Activos'],
  ['expired', 'Vencidos'],
  ['revoked', 'Revocados'],
  ['all', 'Todos'],
] as const;
const blockScopeOptions = [
  ['all', 'Todos los alcances'],
  ['orders', 'Pedidos'],
  ['reviews', 'Resenas'],
  ['raffles', 'Rifas'],
  ['all_interactions', 'Todas las interacciones'],
  ['full_access', 'Acceso completo'],
] as const;
const blockScopeCreateOptions = [
  ['orders', 'Pedidos'],
  ['reviews', 'Resenas'],
  ['raffles', 'Rifas'],
  ['all_interactions', 'Todas las interacciones'],
  ['full_access', 'Acceso completo'],
] as const;
const blockDurationOptions = [
  ['hours_24', '24 horas'],
  ['days_7', '7 dias'],
  ['days_30', '30 dias'],
  ['permanent', 'Permanente'],
] as const;

function queryString(entries: Record<string, string | number | undefined>) {
  const query = new URLSearchParams();
  Object.entries(entries).forEach(([key, value]) => {
    const text = String(value ?? '').trim();
    if (!text || text === 'all' || text === '1') return;
    query.set(key, text);
  });
  const serialized = query.toString();
  return serialized ? `?${serialized}` : '';
}

function sectionHref(section: string, extra: Record<string, string | number | undefined> = {}) {
  return `${basePath}${queryString({ section, ...extra })}`;
}

function customersHref(page = 1, extra: Record<string, string | number | undefined> = {}) {
  return sectionHref('customers', {
    customer_status: params.customerStatus,
    customers_page: page,
    customer: params.customerId,
    ...extra,
  });
}

function activityHref(page = 1, extra: Record<string, string | number | undefined> = {}) {
  return sectionHref('activity', {
    activity_page: page,
    event_type: params.eventType,
    risk: params.eventRisk,
    ...extra,
  });
}

function blockedHref(page = 1, extra: Record<string, string | number | undefined> = {}) {
  return sectionHref('blocked', {
    blocked_page: page,
    blocked_status: params.blockedStatus,
    blocked_scope: params.blockedScope,
    ...extra,
  });
}

function customerDetailHref(customerId: string, extra: Record<string, string | number | undefined> = {}) {
  return sectionHref('customers', {
    customer: customerId,
    customer_status: params.customerStatus,
    orders_page: params.customerOrdersPage,
    events_page: params.customerEventsPage,
    ...extra,
  });
}

function pageWindow(result: PaginatedResult<unknown> | null) {
  if (!result) return [];
  const start = Math.max(1, Math.min(result.page - 2, result.totalPages - 4));
  const end = Math.min(result.totalPages, start + 4);
  const pages = [];
  for (let page = start; page <= end; page += 1) pages.push(page);
  return pages;
}

function customerPageLabel(result: PaginatedResult<unknown> | null) {
  if (!result || result.totalItems === 0) return 'Sin resultados';
  const from = (result.page - 1) * result.perPage + 1;
  const to = Math.min(result.totalItems, result.page * result.perPage);
  return `Mostrando ${formatNumber(from)}-${formatNumber(to)} de ${formatNumber(result.totalItems)}`;
}

function isActiveSection(section: string) {
  return params.section === section;
}

function isActiveCustomerStatus(status: CustomerStatusFilter) {
  return params.customerStatus === status;
}

function isActiveEventType(value: EventTypeFilter) {
  return params.eventType === value;
}

function isActiveEventRisk(value: EventRiskFilter) {
  return params.eventRisk === value;
}

function isActiveBlockStatus(value: string) {
  return params.blockedStatus === value;
}

function isActiveBlockScope(value: string) {
  return params.blockedScope === value;
}

function paginationHref(kind: 'customers' | 'activity' | 'visitors' | 'blocked' | 'orders' | 'events', page: number) {
  if (kind === 'customers') return customersHref(page, { customer: params.customerId });
  if (kind === 'activity') return activityHref(page);
  if (kind === 'visitors') return sectionHref('visitors', { visitors_page: page });
  if (kind === 'blocked') return blockedHref(page);
  if (kind === 'orders') return customerDetailHref(params.customerId, { orders_page: page, events_page: params.customerEventsPage });
  return customerDetailHref(params.customerId, { events_page: page, orders_page: params.customerOrdersPage });
}

function orderHref(order: Pick<SecurityOrder, 'id'> | { id: string } | null | undefined) {
  return order?.id && adminOrdersPath ? `${adminOrdersPath}?order=${encodeURIComponent(order.id)}` : '';
}

function renderSummaryValue(value: number | undefined) {
  return summaryError ? 'No disponible' : formatNumber(value || 0);
}

function eventCustomerName(row: SecurityEventRow) {
  return getDisplayCustomerName(row.relatedCustomer);
}

function eventCustomerPhone(row: SecurityEventRow) {
  return String(row.relatedCustomer?.phone_normalized || '').trim() || 'No disponible';
}

function customerPrimaryPhone(customer: SecurityCustomer | null | undefined) {
  return String(customer?.primary_phone || customer?.phone_normalized || '').trim() || 'No disponible';
}

function pluralLabel(count: number, singular: string, plural: string) {
  return `${formatNumber(count)} ${count === 1 ? singular : plural}`;
}

function customerIdentitySummary(customer: SecurityCustomer) {
  return [
    pluralLabel(customer.orders_count, 'pedido', 'pedidos'),
    pluralLabel(customer.phones_count, 'telefono', 'telefonos'),
    pluralLabel(customer.devices_count, 'dispositivo', 'dispositivos'),
  ].join(' · ');
}

function visitorDetailHref(visitorSessionId: string) {
  return `${basePath}/visitors/${encodeURIComponent(visitorSessionId)}`;
}

function lifecycleCounts(customer: SecurityCustomer | null | undefined) {
  return customer?.lifecycle_counts || {
    orders_affected: customer?.orders_count || 0,
    events_affected: 0,
    phones_affected: customer?.phones_count || 0,
    devices_affected: customer?.devices_count || 0,
    sessions_affected: 0,
    pageviews_affected: 0,
  };
}

function selectedLifecycleCounts() {
  return customerLifecycleCounts || lifecycleCounts(selectedCustomer);
}

function lifecycleActionLabel(customer: SecurityCustomer) {
  return customer.archived ? 'Restaurar cliente' : 'Archivar cliente';
}

function lifecycleActionValue(customer: SecurityCustomer) {
  return customer.archived ? 'restore' : 'archive';
}

function lifecycleActionDescription(customer: SecurityCustomer) {
  return customer.archived ? 'La ficha volvera a la lista activa.' : 'El cliente dejara de aparecer en la lista activa y podra restaurarse despues.';
}

function lifecycleNoticeText(_customer: SecurityCustomer) {
  return 'Sus pedidos y datos de Seguridad se conservaran.';
}

const BLOCK_SCOPE_LABELS: Record<string, string> = {
  orders: 'Pedidos',
  reviews: 'Resenas',
  raffles: 'Rifas',
  all_interactions: 'Todas las interacciones',
  full_access: 'Acceso completo',
};

const BLOCK_SCOPE_ACTION_LABELS: Record<string, string> = {
  orders: 'Bloquear pedidos',
  reviews: 'Bloquear resenas',
  raffles: 'Bloquear rifas',
  all_interactions: 'Bloquear todas las interacciones',
  full_access: 'Bloquear acceso completo',
};

const BLOCK_DURATION_LABELS: Record<string, string> = {
  hours_24: '24 horas',
  days_7: '7 dias',
  days_30: '30 dias',
  permanent: 'Permanente',
};

const BLOCK_STATUS_LABELS: Record<string, string> = {
  active: 'Activo',
  expired: 'Vencido',
  revoked: 'Revocado',
};

function blockScopeLabel(scope: string) {
  return BLOCK_SCOPE_LABELS[scope] || scope || 'No disponible';
}

function blockDurationLabel(duration: string) {
  return BLOCK_DURATION_LABELS[duration] || duration || 'No disponible';
}

function blockStatusLabel(status: string) {
  return BLOCK_STATUS_LABELS[status] || status || 'No disponible';
}

function blockSignalsLabel(block: SecurityBlock) {
  const signals = [];
  if (block.signal_summary.phone) signals.push('Telefono');
  if (block.signal_summary.device) signals.push('Dispositivo');
  if (block.signal_summary.ip) signals.push('IP');
  const mode = block.signal_summary.mode === 'all' ? 'todas' : 'cualquiera';
  return signals.length ? `${signals.join(' + ')} (${mode})` : 'Sin senales';
}

function blockCustomerTitle(block: SecurityBlock) {
  if (block.manual_ip) return 'Bloqueo manual por IP';
  const name = String(block.customer_name || '').trim();
  const phone = String(block.primary_phone || '').trim();
  return name || phone || 'Cliente sin nombre';
}

function blockCustomerSubtitle(block: SecurityBlock) {
  if (block.manual_ip) {
    if (block.manual_ip_resolution_status === 'hidden') return 'IP protegida';
    return String(block.manual_ip_display || '').trim() || 'IP no disponible';
  }
  return String(block.primary_phone || '').trim() || 'Telefono no disponible';
}

function selectedBlocksMetrics() {
  return blocksMetrics || {
    active_blocks: 0,
    affected_customers: 0,
    manual_ip_blocks: 0,
    expires_today: 0,
    permanent_blocks: 0,
  };
}

function selectedBlockCapabilities() {
  return blockCapabilities || {
    can_observe: false,
    can_block: false,
    can_full_access: false,
    can_permanent: false,
    mode: settings.mode,
  };
}

function selectedAvailableSignals() {
  return availableSignals || { phone_count: 0, device_count: 0, ip_count: 0 };
}

function selectedBlockHistorySummary() {
  return blockHistorySummary || { active: 0, expired: 0, revoked: 0 };
}

function observationActionLabel(customer: SecurityCustomer) {
  if (customer.status === 'watch') return 'Quitar de observacion';
  return 'Poner en observacion';
}

function observationActionValue(customer: SecurityCustomer) {
  return customer.status === 'watch' ? 'disable' : 'enable';
}
---

<section class="security-monitoring" aria-label={`Monitoreo de seguridad de ${storeName}`}>
  <header class="monitoring-head">
    <div>
      <p class="monitoring-kicker">{titlePrefix}</p>
      <h2>{storeName}</h2>
      <p>Consulta privada de clientes, actividad y visitantes registrados hoy.</p>
    </div>
    {backHref && <a class="monitoring-back" href={backHref}>{backLabel}</a>}
  </header>

  <nav class="monitoring-tabs" aria-label="Secciones de seguridad">
    <a class:list={['monitoring-tab', { 'is-active': isActiveSection('summary') }]} href={sectionHref('summary')}>Resumen</a>
    <a class:list={['monitoring-tab', { 'is-active': isActiveSection('activity') }]} href={sectionHref('activity')}>Actividad</a>
    <a class:list={['monitoring-tab', { 'is-active': isActiveSection('customers') }]} href={sectionHref('customers')}>Clientes</a>
    <a class:list={['monitoring-tab', { 'is-active': isActiveSection('visitors') }]} href={sectionHref('visitors')}>Visitantes de hoy</a>
    <a class:list={['monitoring-tab', { 'is-active': isActiveSection('blocked') }]} href={sectionHref('blocked')}>Clientes bloqueados</a>
    <a class:list={['monitoring-tab', { 'is-active': isActiveSection('rules') }]} href={sectionHref('rules')}>Reglas</a>
  </nav>

  {viewNotice && <div class="monitoring-alert is-success" role="status">{viewNotice}</div>}
  {viewError && <div class="monitoring-alert" role="alert">{viewError}</div>}
  {customerUnavailable && <div class="monitoring-alert is-soft" role="status">Cliente no disponible.</div>}
  {!actionsEnabled && context === 'master' && (
    <div class="monitoring-alert is-soft" role="status">Seguridad está desactivada para esta tienda. El Master puede revisar el historial, pero no realizar acciones de protección.</div>
  )}

  {params.section === 'summary' && (
    <section class="metrics-grid" aria-label="Metricas de seguridad">
      <article class="metric-card">
        <span>Clientes registrados</span>
        <strong>{renderSummaryValue(summary?.customersCount)}</strong>
      </article>
      <article class="metric-card">
        <span>Clientes archivados</span>
        <strong>{renderSummaryValue(summary?.archivedCustomersCount)}</strong>
      </article>
      <article class="metric-card">
        <span>Eventos registrados</span>
        <strong>{renderSummaryValue(summary?.eventsCount)}</strong>
      </article>
      <article class="metric-card">
        <span>Visitantes registrados hoy</span>
        <strong>{renderSummaryValue(summary?.visitorsTodayCount)}</strong>
      </article>
      <article class="metric-card">
        <span>Clientes en observacion</span>
        <strong>{renderSummaryValue(summary?.watchCustomersCount)}</strong>
      </article>
      <article class="metric-card">
        <span>Clientes con estado bloqueado</span>
        <strong>{renderSummaryValue(summary?.blockedCustomersCount)}</strong>
      </article>
    </section>
  )}

  {(params.section === 'summary' || params.section === 'rules') && (
    <section class="info-grid" aria-label="Configuracion actual">
      <article class="monitoring-card">
        <h3>Resumen</h3>
        {context === 'store' && settings.id && (
          <span
            class="pz-last-modification"
            data-pz-last-modification
            data-resource-type="security_settings"
            data-resource-id={settings.id}
            data-show-actor="true"
            data-useful-empty="true"
          ><span class="pz-last-modification__skeleton">Cargando última modificación…</span></span>
        )}
        <div class="fact-grid">
          <div class="fact-box">
            <span>Modo actual</span>
            <strong>{modeLabel}</strong>
          </div>
          <div class="fact-box">
            <span>Retencion</span>
            <strong>{settings.retention_days} dias</strong>
          </div>
          <div class="fact-box">
            <span>Politica de IP</span>
            <strong>{ipLabel}</strong>
          </div>
          <div class="fact-box">
            <span>VPN y proxy</span>
            <strong>{vpnPolicyLabel}</strong>
          </div>
        </div>
        {isFullIp && <p class="monitoring-note">La IP completa se muestra directamente en las vistas privadas de Seguridad para usuarios autorizados.</p>}
      </article>

      <article class="monitoring-card">
        <h3>Capacidades administradas</h3>
        <div class="capability-list">
          <div class="capability-row"><span>Bloqueo manual</span><strong>{settings.manual_blocking_enabled ? 'Habilitada' : 'No habilitada'}</strong></div>
          <div class="capability-row"><span>Bloqueo de acceso completo</span><strong>{settings.full_access_blocking_enabled ? 'Habilitada' : 'No habilitada'}</strong></div>
          <div class="capability-row"><span>Bloqueos permanentes</span><strong>{settings.permanent_blocks_enabled ? 'Habilitada' : 'No habilitada'}</strong></div>
          <div class="capability-row"><span>Notificar intentos bloqueados</span><strong>{settings.notify_blocked_attempts ? 'Habilitada' : 'No habilitada'}</strong></div>
        </div>
      </article>

      {params.section === 'rules' && (
        <article class="monitoring-card">
          <h3>Acceso con VPN, proxy o Tor</h3>
          <p class="monitoring-note">Piloto gratuito con caché privada. Si la verificación externa no está disponible, el acceso se permite y el incidente queda registrado.</p>
          <form class="customer-search" method="POST" action={sectionHref('rules')}>
            <input type="hidden" name="section" value="rules" />
            <input type="hidden" name="security_action" value="vpn_policy_update" />
            <div class="field">
              <label for="security-vpn-policy">Politica</label>
              <select id="security-vpn-policy" name="vpn_policy" disabled={!actionsEnabled}>
                <option value="off" selected={settings.vpn_policy === 'off'}>Desactivada</option>
                <option value="monitor" selected={settings.vpn_policy === 'monitor'}>Solo detectar</option>
                <option value="block" selected={settings.vpn_policy === 'block'} disabled={settings.mode !== 'protection'}>Detectar y bloquear</option>
              </select>
            </div>
            <button class="primary-action" type="submit" disabled={!actionsEnabled}>Guardar politica</button>
          </form>
          <p class="modal-warning">La deteccion es probabilistica. No bloquea por red movil ni por centro de datos solamente.</p>
        </article>
      )}

      {params.section === 'rules' && (
        <article class="monitoring-card">
          <h3>Bloqueos privados</h3>
          <div class="capability-list">
            <div class="capability-row"><span>Clientes con bloqueo activo</span><strong>{renderSummaryValue(summary?.blockedCustomersCount)}</strong></div>
            <div class="capability-row"><span>Observacion privada</span><strong>{settings.mode === 'monitoring' || settings.mode === 'protection' ? 'Habilitada' : 'No habilitada'}</strong></div>
            <div class="capability-row"><span>Gestion de bloqueos</span><strong>{settings.mode === 'protection' && settings.manual_blocking_enabled ? 'Habilitada' : 'No habilitada'}</strong></div>
          </div>
        </article>
      )}
    </section>
  )}

  {params.section === 'customers' && (
    <section class="monitoring-card" aria-labelledby="customers-title">
      <div class="section-head">
        <div>
          <h3 id="customers-title">Clientes</h3>
          <p>{customerPageLabel(customersResult)}</p>
        </div>
      </div>

      <form class="customer-search" method="POST" action={sectionHref('customers')}>
        <input type="hidden" name="section" value="customers" />
        <input type="hidden" name="customers_page" value="1" />
        <div class="field">
          <label for="customer-search">Buscar por nombre o telefono</label>
          <input id="customer-search" name="customer_search" type="search" maxlength="80" value={params.customerSearch} autocomplete="off" />
        </div>
        <div class="field">
          <label for="customer-status">Estado</label>
          <select id="customer-status" name="customer_status">
            {statusOptions.map(([value, label]) => <option value={value} selected={isActiveCustomerStatus(value)}>{label}</option>)}
          </select>
        </div>
        <button class="primary-action" type="submit">Buscar</button>
        <a class="secondary-action" href={sectionHref('customers')}>Limpiar</a>
      </form>

      {!params.customerSearch && (
        <div class="filter-row" aria-label="Filtros rapidos de estado">
          {CUSTOMER_STATUS_FILTERS.map((status) => (
            <a class:list={['filter-chip', { 'is-active': isActiveCustomerStatus(status) }]} href={customersHref(1, { customer_status: status, customer: '' })}>
              {status === 'all' ? 'Todos' : labelFromMap(CUSTOMER_STATUS_LABELS, status)}
            </a>
          ))}
        </div>
      )}

      {customersResult && customersResult.items.length > 0 ? (
        <>
          <div class="monitoring-table customers-table" role="table" aria-label="Clientes registrados">
            <div class="table-head" role="row">
              <span role="columnheader">Cliente</span>
              <span role="columnheader">Telefono principal</span>
              <span role="columnheader">Pedidos</span>
              <span role="columnheader">Telefonos</span>
              <span role="columnheader">Dispositivos</span>
              <span role="columnheader">Ultima actividad</span>
              <span role="columnheader">Total confirmado</span>
              <span role="columnheader">Estado</span>
              <span role="columnheader">Accion</span>
            </div>
            <div class="table-body">
              {customersResult.items.map((customer) => (
                <article class="table-row" role="row">
                  <div class="table-cell main-cell" role="cell" data-label="Cliente">
                    <strong>{getDisplayCustomerName(customer)}</strong>
                    <span>{customerIdentitySummary(customer)}</span>
                  </div>
                  <div class="table-cell sensitive-cell" role="cell" data-label="Telefono principal">{customerPrimaryPhone(customer)}</div>
                  <div class="table-cell" role="cell" data-label="Pedidos">{formatNumber(customer.orders_count)}</div>
                  <div class="table-cell" role="cell" data-label="Telefonos">{formatNumber(customer.phones_count)}</div>
                  <div class="table-cell" role="cell" data-label="Dispositivos">{formatNumber(customer.devices_count)}</div>
                  <div class="table-cell" role="cell" data-label="Ultima actividad">{formatDateTime(customer.last_order_at || customer.updated)}</div>
                  <div class="table-cell" role="cell" data-label="Total confirmado">{formatMoneyUsd(customer.confirmed_total_usd)}</div>
