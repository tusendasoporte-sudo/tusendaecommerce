      width: calc(100vw - 24px);
      max-width: calc(100vw - 24px);
      max-height: calc(100dvh - 24px);
    }

    .security-modal-card {
      border-radius: 18px;
    }

    .security-modal-header {
      padding: 16px 16px 12px;
    }

    .security-modal-header h3 {
      font-size: 18px;
    }

    .security-modal-body {
      padding: 16px;
    }

    .security-modal-footer {
      display: grid;
      grid-template-columns: 1fr;
      padding: 12px 16px 16px;
    }

    .security-modal-footer .primary-action,
    .security-modal-footer .secondary-action,
    .security-modal-footer .danger-action {
      min-width: 0;
