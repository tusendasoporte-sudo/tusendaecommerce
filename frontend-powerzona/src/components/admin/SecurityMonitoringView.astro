            <div class="pagination-actions">
              {params.customerSearch ? (
                <>
                  <form method="POST" action={sectionHref('customers')}>
                    <input type="hidden" name="section" value="customers" />
                    <input type="hidden" name="customer_search" value={params.customerSearch} />
                    <input type="hidden" name="customer_status" value={params.customerStatus} />
                    <input type="hidden" name="customers_page" value={Math.max(1, customersResult.page - 1)} />
                    <button class="page-button" type="submit" disabled={customersResult.page <= 1}>Anterior</button>
                  </form>
                  <form method="POST" action={sectionHref('customers')}>
                    <input type="hidden" name="section" value="customers" />
                    <input type="hidden" name="customer_search" value={params.customerSearch} />
                    <input type="hidden" name="customer_status" value={params.customerStatus} />
                    <input type="hidden" name="customers_page" value={Math.min(customersResult.totalPages, customersResult.page + 1)} />
                    <button class="page-button" type="submit" disabled={customersResult.page >= customersResult.totalPages}>Siguiente</button>
                  </form>
                </>
              ) : (
                <>
                  <a class:list={['page-button', { disabled: customersResult.page <= 1 }]} href={paginationHref('customers', Math.max(1, customersResult.page - 1))}>Anterior</a>
                  {pageWindow(customersResult).map((page) => <a class:list={['page-button', { 'is-active': page === customersResult.page }]} href={paginationHref('customers', page)}>{page}</a>)}
                  <a class:list={['page-button', { disabled: customersResult.page >= customersResult.totalPages }]} href={paginationHref('customers', Math.min(customersResult.totalPages, customersResult.page + 1))}>Siguiente</a>
                </>
              )}
            </div>
          </div>
        </>
