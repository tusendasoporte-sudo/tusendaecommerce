    .primary-action,
    .secondary-action,
    .danger-action,
    .row-action,
    .icon-action,
    .filter-chip,
    .page-button {
      width: 100%;
      min-height: 46px;
    }

    .monitoring-tabs,
    .filter-row,
    .pagination-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .metrics-grid,
    .metrics-grid.compact,
    .metrics-grid.block-metrics,
    .customer-search,
    .block-filter-form,
    .signal-grid,
    .active-block-card dl {
