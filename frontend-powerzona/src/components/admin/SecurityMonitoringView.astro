<script>
  const customerMenu = document.querySelector('[data-customer-menu]');
  const visitorMenu = document.querySelector('[data-visitor-menu]');
  const lifecycleDialog = document.querySelector('[data-lifecycle-dialog]');
  const deleteDialog = document.querySelector('[data-delete-dialog]');
  const observationDialog = document.querySelector('[data-observation-dialog]');
  const blockCreateDialog = document.querySelector('[data-block-create-dialog]');
  const blockRevokeDialog = document.querySelector('[data-block-revoke-dialog]');
  const manualIpBlockDialog = document.querySelector('[data-manual-ip-block-dialog]');
  const blockDeviceReviewDialog = document.querySelector('[data-block-device-review-dialog]');
  const securityDialogs = [
    lifecycleDialog,
    deleteDialog,
    observationDialog,
    blockCreateDialog,
    blockRevokeDialog,
    manualIpBlockDialog,
    blockDeviceReviewDialog,
  ].filter(isDialogElement);
  const countFormatter = new Intl.NumberFormat('es-US');
  let activeCustomerMenuTrigger = null;
  let activeVisitorMenuTrigger = null;
  let lastDialogTrigger = null;

  function isDialogElement(value) {
    return typeof HTMLDialogElement !== 'undefined' && value instanceof HTMLDialogElement;
  }

  function closeCustomerMenu() {
    if (!(customerMenu instanceof HTMLElement)) return;
    customerMenu.classList.remove('is-open');
    customerMenu.setAttribute('aria-hidden', 'true');
    if (activeCustomerMenuTrigger instanceof HTMLElement) {
      activeCustomerMenuTrigger.setAttribute('aria-expanded', 'false');
    }
    activeCustomerMenuTrigger = null;
    customerMenu.hidden = true;
  }

  function closeVisitorMenu() {
    if (!(visitorMenu instanceof HTMLElement)) return;
    visitorMenu.classList.remove('is-open');
    visitorMenu.setAttribute('aria-hidden', 'true');
    if (activeVisitorMenuTrigger instanceof HTMLElement) {
      activeVisitorMenuTrigger.setAttribute('aria-expanded', 'false');
    }
    activeVisitorMenuTrigger = null;
    visitorMenu.hidden = true;
  }

  function closeInlineRowMenus(exceptTarget = null) {
    document.querySelectorAll('[data-inline-row-menu][open]').forEach((menu) => {
      if (!(menu instanceof HTMLDetailsElement)) return;
      if (exceptTarget instanceof Element && menu.contains(exceptTarget)) return;
      menu.open = false;
    });
  }

  function clampMenuPosition(value, min, max) {
    return Math.min(Math.max(value, min), max);
  }

  function positionCustomerMenu(trigger) {
    if (!(customerMenu instanceof HTMLElement)) return;
    const gap = 8;
    const edge = 12;
    const rect = trigger.getBoundingClientRect();
    const menuWidth = customerMenu.offsetWidth || 230;
    const menuHeight = customerMenu.offsetHeight || 136;
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;
    let left = rect.right - menuWidth;
    let top = rect.bottom + gap;

    if (top + menuHeight > viewportHeight - edge) {
      top = rect.top - menuHeight - gap;
    }
    if (left < edge) {
      left = rect.left;
    }
    if (left + menuWidth > viewportWidth - edge) {
      left = viewportWidth - menuWidth - edge;
    }

    customerMenu.style.left = `${clampMenuPosition(left, edge, Math.max(edge, viewportWidth - menuWidth - edge))}px`;
    customerMenu.style.top = `${clampMenuPosition(top, edge, Math.max(edge, viewportHeight - menuHeight - edge))}px`;
  }

  function positionVisitorMenu(trigger) {
    if (!(visitorMenu instanceof HTMLElement)) return;
    const gap = 8;
    const edge = 12;
    const rect = trigger.getBoundingClientRect();
    const menuWidth = visitorMenu.offsetWidth || 180;
    const menuHeight = visitorMenu.offsetHeight || 96;
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;
    let left = rect.right - menuWidth;
    let top = rect.bottom + gap;

    if (top + menuHeight > viewportHeight - edge) {
      top = rect.top - menuHeight - gap;
    }
    if (left < edge) {
      left = rect.left;
    }
    if (left + menuWidth > viewportWidth - edge) {
      left = viewportWidth - menuWidth - edge;
    }

    visitorMenu.style.left = `${clampMenuPosition(left, edge, Math.max(edge, viewportWidth - menuWidth - edge))}px`;
    visitorMenu.style.top = `${clampMenuPosition(top, edge, Math.max(edge, viewportHeight - menuHeight - edge))}px`;
  }

  function openCustomerMenu(trigger) {
    if (!(customerMenu instanceof HTMLElement)) return;
    closeVisitorMenu();
    const viewItem = customerMenu.querySelector('[data-customer-menu-view]');
    if (viewItem instanceof HTMLAnchorElement) {
      viewItem.href = trigger.dataset.customerHref || '#';
    }
    const lifecycleItem = customerMenu.querySelector('[data-menu-action="lifecycle"]');
    if (lifecycleItem instanceof HTMLButtonElement) {
      const canManageCustomer = trigger.dataset.actionsEnabled === 'true';
      lifecycleItem.textContent = trigger.dataset.lifecycleLabel || 'Archivar cliente';
      lifecycleItem.disabled = !canManageCustomer || trigger.dataset.lifecycleDisabled === 'true';
      lifecycleItem.title = !canManageCustomer
        ? 'No tienes permisos para administrar este cliente.'
        : lifecycleItem.disabled ? 'Desbloquea al cliente antes de archivarlo.' : '';
    }
    if (activeCustomerMenuTrigger && activeCustomerMenuTrigger !== trigger) {
      activeCustomerMenuTrigger.setAttribute('aria-expanded', 'false');
    }
    activeCustomerMenuTrigger = trigger;
    trigger.setAttribute('aria-expanded', 'true');
    customerMenu.hidden = false;
    customerMenu.classList.add('is-open');
    customerMenu.setAttribute('aria-hidden', 'false');
    positionCustomerMenu(trigger);
    const firstItem = customerMenu.querySelector('.floating-menu-item:not(:disabled)');
    if (firstItem instanceof HTMLElement) firstItem.focus();
  }

  function openVisitorMenu(trigger) {
    if (!(visitorMenu instanceof HTMLElement)) return;
    closeCustomerMenu();
    const viewItem = visitorMenu.querySelector('[data-visitor-menu-view]');
    if (viewItem instanceof HTMLAnchorElement) {
      viewItem.href = trigger.dataset.visitorHref || '#';
    }
    const blockItem = visitorMenu.querySelector('[data-visitor-menu-block]');
    if (blockItem instanceof HTMLButtonElement) {
      const canBlock = trigger.dataset.canBlock === 'true';
      blockItem.hidden = !canBlock;
      blockItem.dataset.visitorSessionId = trigger.dataset.visitorSessionId || '';
    }
    if (activeVisitorMenuTrigger && activeVisitorMenuTrigger !== trigger) {
      activeVisitorMenuTrigger.setAttribute('aria-expanded', 'false');
    }
    activeVisitorMenuTrigger = trigger;
    trigger.setAttribute('aria-expanded', 'true');
    visitorMenu.hidden = false;
    visitorMenu.classList.add('is-open');
    visitorMenu.setAttribute('aria-hidden', 'false');
    positionVisitorMenu(trigger);
    const firstItem = visitorMenu.querySelector('.floating-menu-item:not([hidden]):not(:disabled)');
    if (firstItem instanceof HTMLElement) firstItem.focus();
  }

  function numericData(value) {
    const parsed = Number.parseInt(String(value || '0'), 10);
    return Number.isFinite(parsed) ? Math.max(0, parsed) : 0;
  }

  function customerPayloadFromTrigger(trigger) {
    const archived = trigger.dataset.customerArchived === 'true';
    return {
      customerId: trigger.dataset.customerId || '',
      lifecycleLabel: trigger.dataset.lifecycleLabel || (archived ? 'Restaurar cliente' : 'Archivar cliente'),
      lifecycleAction: trigger.dataset.lifecycleAction || (archived ? 'restore' : 'archive'),
      lifecycleDescription: trigger.dataset.lifecycleDescription || (archived ? 'La ficha volvera a la lista activa.' : 'El cliente dejara de aparecer en la lista activa y podra restaurarse despues.'),
      lifecycleNotice: trigger.dataset.lifecycleNotice || 'Sus pedidos y datos de Seguridad se conservaran.',
      counts: {
        orders: numericData(trigger.dataset.ordersCount),
        phones: numericData(trigger.dataset.phonesCount),
        devices: numericData(trigger.dataset.devicesCount),
        events: numericData(trigger.dataset.eventsCount),
        sessions: numericData(trigger.dataset.sessionsCount),
        pageviews: numericData(trigger.dataset.pageviewsCount),
      },
    };
  }

  function setText(root, selector, value) {
    const element = root.querySelector(selector);
    if (element instanceof HTMLElement) element.textContent = value;
  }

  function setInputValue(root, selector, value) {
    const element = root.querySelector(selector);
    if (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement) {
      element.value = value;
    }
  }

  function setSelectValue(root, selector, value) {
    const element = root.querySelector(selector);
    if (element instanceof HTMLSelectElement) element.value = value;
  }

  function setOptionDisabled(root, selector, value, disabled) {
    const select = root.querySelector(selector);
    if (!(select instanceof HTMLSelectElement)) return;
    const option = Array.from(select.options).find((item) => item.value === value);
    if (option) option.disabled = disabled;
    if (select.value === value && disabled) {
      const fallback = Array.from(select.options).find((item) => !item.disabled);
      if (fallback) select.value = fallback.value;
    }
  }

  function countLabel(count, singular, plural) {
    return `${countFormatter.format(count)} ${count === 1 ? singular : plural}`;
  }

  function updateDeleteCount(root, key, count, singular, plural) {
    const element = root.querySelector(`[data-delete-count="${key}"]`);
    if (element instanceof HTMLElement) element.textContent = countLabel(count, singular, plural);
  }

  function closeDialog(dialog, restoreFocus = true) {
    if (!isDialogElement(dialog) || !dialog.open) return;
    if (!restoreFocus) dialog.dataset.skipFocusRestore = 'true';
    dialog.close();
  }

  function closeOpenDialogs(exceptDialog = null) {
    securityDialogs.forEach((dialog) => {
      if (dialog !== exceptDialog) closeDialog(dialog, false);
    });
  }

  function focusDialogField(dialog) {
    const field = dialog.querySelector('[data-dialog-focus]');
    if (field instanceof HTMLElement) {
      window.requestAnimationFrame(() => field.focus());
    }
  }

  function showSecurityDialog(dialog, trigger) {
    if (!isDialogElement(dialog)) return;
    lastDialogTrigger = trigger instanceof HTMLElement ? trigger : null;
    if (typeof dialog.showModal === 'function') {
      dialog.showModal();
    } else {
      dialog.setAttribute('open', '');
    }
    focusDialogField(dialog);
  }

  function openLifecycleDialog(trigger) {
    if (!(trigger instanceof HTMLElement) || !isDialogElement(lifecycleDialog)) return;
    const payload = customerPayloadFromTrigger(trigger);
    if (!payload.customerId) return;
    closeCustomerMenu();
    closeOpenDialogs(lifecycleDialog);
    setText(lifecycleDialog, '[data-lifecycle-title]', payload.lifecycleLabel);
    setText(lifecycleDialog, '[data-lifecycle-description]', payload.lifecycleDescription);
    setText(lifecycleDialog, '[data-lifecycle-notice]', payload.lifecycleNotice);
    setInputValue(lifecycleDialog, '[data-lifecycle-customer]', payload.customerId);
    setInputValue(lifecycleDialog, '[data-lifecycle-action-input]', payload.lifecycleAction);
    setText(lifecycleDialog, '[data-lifecycle-submit]', payload.lifecycleLabel);
    showSecurityDialog(lifecycleDialog, trigger);
  }

  function openDeleteDialog(trigger) {
    if (!(trigger instanceof HTMLElement) || !isDialogElement(deleteDialog)) return;
    const payload = customerPayloadFromTrigger(trigger);
    if (!payload.customerId) return;
    closeCustomerMenu();
    closeOpenDialogs(deleteDialog);
    setInputValue(deleteDialog, '[data-delete-customer]', payload.customerId);
    updateDeleteCount(deleteDialog, 'orders', payload.counts.orders, 'pedido vinculado', 'pedidos vinculados');
    updateDeleteCount(deleteDialog, 'phones', payload.counts.phones, 'telefono', 'telefonos');
    updateDeleteCount(deleteDialog, 'devices', payload.counts.devices, 'dispositivo', 'dispositivos');
    updateDeleteCount(deleteDialog, 'events', payload.counts.events, 'evento de Seguridad', 'eventos de Seguridad');
    updateDeleteCount(deleteDialog, 'sessions', payload.counts.sessions, 'sesion', 'sesiones');
    updateDeleteCount(deleteDialog, 'pageviews', payload.counts.pageviews, 'pagina navegada', 'paginas navegadas');
    showSecurityDialog(deleteDialog, trigger);
  }

  function truthyDataset(value) {
    return String(value || '') === 'true';
  }

  function setSignalState(dialog, signal, count, checked) {
    const checkbox = dialog.querySelector(`[data-signal-checkbox="${signal}"]`);
    const label = dialog.querySelector(`[data-signal-count="${signal}"]`);
    const available = count > 0;
    if (checkbox instanceof HTMLInputElement) {
      checkbox.disabled = !available;
      checkbox.checked = available && checked;
      checkbox.setCustomValidity('');
    }
    if (label instanceof HTMLElement) {
      label.textContent = countLabel(count, 'disponible', 'disponibles');
    }
  }

  function updateIpWarning(dialog) {
    const checkbox = dialog.querySelector('[data-signal-checkbox="ip"]');
    const warning = dialog.querySelector('[data-ip-warning]');
    if (!(warning instanceof HTMLElement)) return;
    warning.hidden = !(checkbox instanceof HTMLInputElement && checkbox.checked);
  }

  function openObservationDialog(trigger) {
    if (!(trigger instanceof HTMLElement) || !isDialogElement(observationDialog)) return;
    const customerId = trigger.dataset.customerId || '';
    const action = trigger.dataset.observationAction === 'disable' ? 'disable' : 'enable';
    const label = trigger.dataset.observationLabel || (action === 'disable' ? 'Quitar de observacion' : 'Poner en observacion');
    if (!customerId) return;
    closeCustomerMenu();
    closeOpenDialogs(observationDialog);
    setText(observationDialog, '[data-observation-title]', label);
    setText(
      observationDialog,
      '[data-observation-description]',
      action === 'disable'
        ? 'La ficha dejara de estar marcada para revision interna.'
        : 'La ficha quedara marcada para revision interna sin afectar pedidos ni acceso publico.'
    );
    setText(observationDialog, '[data-observation-submit]', label);
    setInputValue(observationDialog, '[data-observation-customer]', customerId);
    setInputValue(observationDialog, '[data-observation-action-input]', action);
    showSecurityDialog(observationDialog, trigger);
  }

  function openBlockCreateDialog(trigger) {
    if (!(trigger instanceof HTMLElement) || !isDialogElement(blockCreateDialog)) return;
    const customerId = trigger.dataset.customerId || '';
    if (!customerId) return;
    const phoneCount = numericData(trigger.dataset.phoneCount);
    const deviceCount = numericData(trigger.dataset.deviceCount);
    const ipCount = numericData(trigger.dataset.ipCount);
    closeCustomerMenu();
    closeOpenDialogs(blockCreateDialog);
    setInputValue(blockCreateDialog, '[data-block-create-customer]', customerId);
    setOptionDisabled(blockCreateDialog, '[data-block-scope-select]', 'full_access', !truthyDataset(trigger.dataset.canFullAccess));
    setOptionDisabled(blockCreateDialog, '[data-block-duration-select]', 'permanent', !truthyDataset(trigger.dataset.canPermanent));
    setSelectValue(blockCreateDialog, '[data-block-scope-select]', 'orders');
    setSelectValue(blockCreateDialog, '[data-block-duration-select]', 'days_7');
    setSelectValue(blockCreateDialog, '[data-block-match-mode]', 'any');
    setSignalState(blockCreateDialog, 'phone', phoneCount, phoneCount > 0);
    setSignalState(blockCreateDialog, 'device', deviceCount, phoneCount === 0 && deviceCount > 0);
    setSignalState(blockCreateDialog, 'ip', ipCount, phoneCount === 0 && deviceCount === 0 && ipCount > 0);
    const addressSelectAll = blockCreateDialog.querySelector('[data-address-select-all]');
    if (addressSelectAll instanceof HTMLButtonElement) addressSelectAll.textContent = 'Seleccionar todas';
    updateIpWarning(blockCreateDialog);
    showSecurityDialog(blockCreateDialog, trigger);
  }

  function openBlockRevokeDialog(trigger) {
    if (!(trigger instanceof HTMLElement) || !isDialogElement(blockRevokeDialog)) return;
    const blockId = trigger.dataset.blockId || '';
    const customerId = trigger.dataset.customerId || '';
    const returnSection = trigger.dataset.returnSection === 'blocked' ? 'blocked' : 'customers';
    const scope = trigger.dataset.blockScope || 'bloqueo activo';
    if (!blockId) return;
    closeInlineRowMenus();
    closeCustomerMenu();
    closeOpenDialogs(blockRevokeDialog);
    setText(blockRevokeDialog, '[data-block-revoke-title]', `Revocar ${scope}`);
    setText(blockRevokeDialog, '[data-block-revoke-description]', 'El bloqueo activo sera revocado y quedara visible en auditoria.');
    setInputValue(blockRevokeDialog, '[data-block-revoke-id]', blockId);
    setInputValue(blockRevokeDialog, '[data-block-revoke-customer]', customerId);
    setInputValue(blockRevokeDialog, '[data-block-revoke-section]', returnSection);
    setInputValue(blockRevokeDialog, '[data-block-revoke-return]', returnSection);
    showSecurityDialog(blockRevokeDialog, trigger);
  }

  function openManualIpBlockDialog(trigger) {
    if (!(trigger instanceof HTMLElement) || !isDialogElement(manualIpBlockDialog)) return;
    closeCustomerMenu();
    closeVisitorMenu();
    closeOpenDialogs(manualIpBlockDialog);
    if (manualIpBlockDialog.dataset.previewReady !== 'true') {
      const visitorSessionId = trigger.dataset.visitorSessionId || '';
      const visitorInput = manualIpBlockDialog.querySelector('[data-manual-visitor-session]');
      const ipInput = manualIpBlockDialog.querySelector('[name="manual_ip"]');
      const ipField = manualIpBlockDialog.querySelector('[data-manual-ip-field]');
      const visitorNote = manualIpBlockDialog.querySelector('[data-manual-visitor-source]');
      if (visitorInput instanceof HTMLInputElement) visitorInput.value = visitorSessionId;
      if (ipInput instanceof HTMLInputElement) {
        ipInput.value = '';
        ipInput.required = !visitorSessionId;
        ipInput.readOnly = Boolean(visitorSessionId);
      }
      if (ipField instanceof HTMLElement) ipField.hidden = Boolean(visitorSessionId);
      if (visitorNote instanceof HTMLElement) visitorNote.hidden = !visitorSessionId;
      setSelectValue(manualIpBlockDialog, '[name="block_scope"]', 'orders');
      setSelectValue(manualIpBlockDialog, '[name="block_duration"]', 'hours_24');
    }
    showSecurityDialog(manualIpBlockDialog, trigger);
  }

  function openBlockDeviceReviewDialog(trigger) {
    if (!(trigger instanceof HTMLElement) || !isDialogElement(blockDeviceReviewDialog)) return;
    const blockId = trigger.dataset.blockId || '';
    const candidateId = trigger.dataset.candidateId || '';
    const action = trigger.dataset.reviewAction === 'dismiss' ? 'dismiss' : 'confirm';
    const label = trigger.dataset.candidateLabel || 'Dispositivo pendiente';
    if (!blockId || !candidateId) return;
    closeInlineRowMenus();
    closeCustomerMenu();
    closeOpenDialogs(blockDeviceReviewDialog);
    setInputValue(blockDeviceReviewDialog, '[data-block-device-review-block]', blockId);
    setInputValue(blockDeviceReviewDialog, '[data-block-device-review-candidate]', candidateId);
    setInputValue(blockDeviceReviewDialog, '[data-block-device-review-action]', action);
    setText(blockDeviceReviewDialog, '[data-block-device-review-title]', action === 'confirm' ? 'Agregar dispositivo al bloqueo' : 'Descartar dispositivo');
    setText(
      blockDeviceReviewDialog,
      '[data-block-device-review-description]',
      action === 'confirm'
        ? `${label} quedara bloqueado aunque cambie de IP mientras conserve su identificador del navegador.`
        : `${label} no se agregara al bloqueo. La decision quedara registrada en auditoria.`
    );
    setText(blockDeviceReviewDialog, '[data-block-device-review-submit]', action === 'confirm' ? 'Agregar al bloqueo' : 'Descartar');
    showSecurityDialog(blockDeviceReviewDialog, trigger);
  }

  function openCustomerDialog(action, trigger) {
    if (action === 'delete') {
      openDeleteDialog(trigger);
      return;
    }
    openLifecycleDialog(trigger);
  }

  function resetDialogForm(dialog) {
    const form = dialog.querySelector('form');
    if (!(form instanceof HTMLFormElement)) return;
    form.reset();
    delete form.dataset.submitting;
    form.querySelectorAll('button[type="submit"]').forEach((button) => {
      if (button instanceof HTMLButtonElement) {
        button.removeAttribute('aria-busy');
        button.removeAttribute('aria-disabled');
      }
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    closeInlineRowMenus(target);

    const modalClose = target.closest('[data-modal-close], [data-modal-cancel]');
    if (modalClose instanceof HTMLButtonElement) {
      const dialog = modalClose.closest('dialog');
      closeDialog(dialog);
      return;
    }

    const trigger = target.closest('.customer-menu-trigger');
    if (trigger instanceof HTMLButtonElement) {
      event.preventDefault();
      if (activeCustomerMenuTrigger === trigger && customerMenu instanceof HTMLElement && customerMenu.classList.contains('is-open')) {
        closeCustomerMenu();
      } else {
        openCustomerMenu(trigger);
      }
      return;
    }

    const visitorTrigger = target.closest('.visitor-menu-trigger');
    if (visitorTrigger instanceof HTMLButtonElement) {
      event.preventDefault();
      if (activeVisitorMenuTrigger === visitorTrigger && visitorMenu instanceof HTMLElement && visitorMenu.classList.contains('is-open')) {
        closeVisitorMenu();
      } else {
        openVisitorMenu(visitorTrigger);
      }
      return;
    }

    const dialogTrigger = target.closest('.customer-dialog-trigger');
    if (dialogTrigger instanceof HTMLButtonElement) {
      event.preventDefault();
      openCustomerDialog(dialogTrigger.dataset.dialogAction || 'lifecycle', dialogTrigger);
      return;
    }

    const observationTrigger = target.closest('.customer-observation-trigger');
    if (observationTrigger instanceof HTMLButtonElement) {
      event.preventDefault();
      openObservationDialog(observationTrigger);
      return;
    }

    const blockCreateTrigger = target.closest('.customer-block-create-trigger');
    if (blockCreateTrigger instanceof HTMLButtonElement) {
      event.preventDefault();
      openBlockCreateDialog(blockCreateTrigger);
      return;
    }

    const manualIpBlockTrigger = target.closest('[data-manual-ip-block-trigger]');
    if (manualIpBlockTrigger instanceof HTMLButtonElement) {
      event.preventDefault();
      openManualIpBlockDialog(manualIpBlockTrigger);
      return;
    }

    const manualSelectAll = target.closest('[data-manual-select-all]');
    if (manualSelectAll instanceof HTMLButtonElement && isDialogElement(manualIpBlockDialog)) {
      const checkboxes = Array.from(manualIpBlockDialog.querySelectorAll('input[name="manual_device_session_ids"]'));
      const shouldSelect = checkboxes.some((item) => item instanceof HTMLInputElement && !item.checked);
      checkboxes.forEach((item) => { if (item instanceof HTMLInputElement) item.checked = shouldSelect; });
      manualSelectAll.textContent = shouldSelect ? 'Quitar seleccion' : 'Seleccionar todos';
      return;
    }

    const manualIpSelectAll = target.closest('[data-manual-ip-select-all]');
    if (manualIpSelectAll instanceof HTMLButtonElement && isDialogElement(manualIpBlockDialog)) {
      const checkboxes = Array.from(manualIpBlockDialog.querySelectorAll('input[name="manual_ip_source_ids"]'));
      const shouldSelect = checkboxes.some((item) => item instanceof HTMLInputElement && !item.checked);
      checkboxes.forEach((item) => {
        if (item instanceof HTMLInputElement) {
          item.checked = shouldSelect;
          item.setCustomValidity('');
        }
      });
      manualIpSelectAll.textContent = shouldSelect ? 'Quitar seleccion' : 'Seleccionar todas';
      return;
    }

    const addressSelectAll = target.closest('[data-address-select-all]');
    if (addressSelectAll instanceof HTMLButtonElement && isDialogElement(blockCreateDialog)) {
      const checkboxes = Array.from(blockCreateDialog.querySelectorAll('[data-address-checkbox]'));
      const shouldSelect = checkboxes.some((item) => item instanceof HTMLInputElement && !item.checked);
      checkboxes.forEach((item) => { if (item instanceof HTMLInputElement) item.checked = shouldSelect; });
      addressSelectAll.textContent = shouldSelect ? 'Quitar seleccion' : 'Seleccionar todas';
      return;
    }

    const blockDeviceReviewTrigger = target.closest('.block-device-review-trigger');
    if (blockDeviceReviewTrigger instanceof HTMLButtonElement) {
      event.preventDefault();
      openBlockDeviceReviewDialog(blockDeviceReviewTrigger);
      return;
    }

    const blockRevokeTrigger = target.closest('.block-revoke-trigger');
    if (blockRevokeTrigger instanceof HTMLButtonElement) {
      event.preventDefault();
      openBlockRevokeDialog(blockRevokeTrigger);
      return;
    }

    const menuAction = target.closest('[data-menu-action]');
    if (menuAction instanceof HTMLButtonElement && activeCustomerMenuTrigger instanceof HTMLElement) {
      const action = menuAction.dataset.menuAction || '';
      const triggerForDialog = activeCustomerMenuTrigger;
      openCustomerDialog(action, triggerForDialog);
      return;
    }

    if (customerMenu instanceof HTMLElement && customerMenu.contains(target)) return;
    if (visitorMenu instanceof HTMLElement && visitorMenu.contains(target)) return;
    closeCustomerMenu();
    closeVisitorMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeCustomerMenu();
      closeVisitorMenu();
      closeInlineRowMenus();
      return;
    }

    const target = event.target;
    if (
      event.key === 'ArrowDown'
      && target instanceof HTMLButtonElement
      && target.classList.contains('customer-menu-trigger')
    ) {
      event.preventDefault();
      openCustomerMenu(target);
      return;
    }

    if (
      event.key === 'ArrowDown'
      && target instanceof HTMLButtonElement
      && target.classList.contains('visitor-menu-trigger')
    ) {
      event.preventDefault();
      openVisitorMenu(target);
    }
  });

  function closeFloatingMenus() {
    closeCustomerMenu();
    closeVisitorMenu();
    closeInlineRowMenus();
  }

  window.addEventListener('resize', closeFloatingMenus);
  window.addEventListener('scroll', closeFloatingMenus, true);

  document.querySelectorAll('[data-activity-filter]').forEach((element) => {
    if (!(element instanceof HTMLSelectElement)) return;
    element.addEventListener('change', () => element.form?.requestSubmit());
  });

  const successNotice = document.querySelector('[data-auto-dismiss-success]');
  if (successNotice instanceof HTMLElement) {
    const currentUrl = new URL(window.location.href);
    if (currentUrl.searchParams.has('notice')) {
      currentUrl.searchParams.delete('notice');
      window.history.replaceState({}, '', `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`);
    }
    window.setTimeout(() => {
      successNotice.classList.add('is-leaving');
      window.setTimeout(() => successNotice.remove(), 220);
    }, 3800);
  }

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const checkbox = target.closest('[data-signal-checkbox="ip"]');
    if (!(checkbox instanceof HTMLInputElement)) return;
    const dialog = checkbox.closest('dialog');
    if (isDialogElement(dialog)) updateIpWarning(dialog);
  });

  securityDialogs.forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeDialog(dialog);
    });

    dialog.addEventListener('close', () => {
      const shouldRestoreFocus = dialog.dataset.skipFocusRestore !== 'true';
      delete dialog.dataset.skipFocusRestore;
      resetDialogForm(dialog);
      if (shouldRestoreFocus && lastDialogTrigger instanceof HTMLElement && document.contains(lastDialogTrigger)) {
        lastDialogTrigger.focus();
      }
      lastDialogTrigger = null;
    });
  });

  document.addEventListener('submit', (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.classList.contains('lifecycle-form')) return;
    if (form.hasAttribute('data-block-create-form')) {
      const checkboxes = Array.from(form.querySelectorAll('[data-signal-checkbox]')).filter((checkbox) => checkbox instanceof HTMLInputElement);
      const enabledCheckboxes = checkboxes.filter((checkbox) => checkbox instanceof HTMLInputElement && !checkbox.disabled);
      const hasSignal = enabledCheckboxes.some((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked);
      enabledCheckboxes.forEach((checkbox) => {
        if (checkbox instanceof HTMLInputElement) checkbox.setCustomValidity('');
      });
      if (!hasSignal) {
        event.preventDefault();
        const firstCheckbox = enabledCheckboxes[0];
        if (firstCheckbox instanceof HTMLInputElement) {
          firstCheckbox.setCustomValidity('Selecciona al menos una senal privada.');
          firstCheckbox.reportValidity();
        }
        return;
      }
      const addressCheckboxes = Array.from(form.querySelectorAll('[data-address-checkbox]'))
        .filter((checkbox) => checkbox instanceof HTMLInputElement);
      addressCheckboxes.forEach((checkbox) => {
        if (checkbox instanceof HTMLInputElement) checkbox.setCustomValidity('');
      });
      const hasAddress = addressCheckboxes.some((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked);
      if (addressCheckboxes.length > 0 && !hasAddress) {
        event.preventDefault();
        const firstAddress = addressCheckboxes[0];
        if (firstAddress instanceof HTMLInputElement) {
          firstAddress.setCustomValidity('Selecciona al menos una direccion para la alerta.');
          firstAddress.reportValidity();
        }
        return;
      }
    }
    if (form.hasAttribute('data-manual-ip-block-form')) {
      const visitorInput = form.querySelector('[data-manual-visitor-session]');
      const ipCheckboxes = Array.from(form.querySelectorAll('input[name="manual_ip_source_ids"]'))
        .filter((checkbox) => checkbox instanceof HTMLInputElement);
      ipCheckboxes.forEach((checkbox) => {
        if (checkbox instanceof HTMLInputElement) checkbox.setCustomValidity('');
      });
      const requiresHistoricalIp = visitorInput instanceof HTMLInputElement && Boolean(visitorInput.value) && ipCheckboxes.length > 0;
      const hasSelectedIp = ipCheckboxes.some((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked);
      if (requiresHistoricalIp && !hasSelectedIp) {
        event.preventDefault();
        const firstIp = ipCheckboxes[0];
        if (firstIp instanceof HTMLInputElement) {
          firstIp.setCustomValidity('Selecciona al menos una direccion IP para el bloqueo.');
          firstIp.reportValidity();
        }
        return;
      }
    }
    if (form.dataset.submitting === 'true') {
      event.preventDefault();
      return;
    }
    form.dataset.submitting = 'true';
    const submitter = event.submitter;
    form.querySelectorAll('button[type="submit"]').forEach((button) => {
      if (button instanceof HTMLButtonElement) button.setAttribute('aria-disabled', 'true');
    });
    if (submitter instanceof HTMLButtonElement) {
      submitter.setAttribute('aria-busy', 'true');
    }
  });

  if (isDialogElement(manualIpBlockDialog) && manualIpBlockDialog.dataset.previewReady === 'true') {
    window.requestAnimationFrame(() => showSecurityDialog(manualIpBlockDialog, null));
  }
</script>
