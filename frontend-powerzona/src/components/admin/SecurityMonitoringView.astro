                {mergeCandidates.map((candidate) => (
                  <option value={candidate.id}>{getDisplayCustomerName(candidate)} · {customerPrimaryPhone(candidate)}</option>
                ))}
              </select>
            </label>
            <label class="field" for="merge-reason">
              <span>Motivo interno</span>
              <textarea id="merge-reason" name="merge_reason" maxlength="500" required placeholder="Motivo privado de la union" disabled={!actionsEnabled}></textarea>
            </label>
            <button class="primary-action" type="submit" disabled={!actionsEnabled || mergeCandidates.length === 0}>Confirmar union</button>
            {mergeCandidates.length === 0 && <p class="merge-note">No hay candidatos canónicos para esa busqueda.</p>}
          </form>
        )}
      </section>

      <div class="detail-grid">
        <div class="fact-box">
          <span>Nombre mas reciente</span>
          <strong>{getDisplayCustomerName(selectedCustomer)}</strong>
        </div>
        <div class="fact-box">
          <span>Telefono principal</span>
          <strong>{customerPrimaryPhone(selectedCustomer)}</strong>
        </div>
        <div class="fact-box">
          <span>Primera compra</span>
          <strong>{formatDateTime(selectedCustomer.first_order_at)}</strong>
        </div>
        <div class="fact-box">
          <span>Ultima compra</span>
          <strong>{formatDateTime(selectedCustomer.last_order_at)}</strong>
        </div>
        <div class="fact-box">
          <span>Ultima direccion</span>
          <strong>{selectedCustomer.last_address || 'No disponible'}</strong>
        </div>
        <div class="fact-box">
          <span>Municipio</span>
          <strong>{selectedCustomer.last_municipality || 'No disponible'}</strong>
        </div>
        <div class="fact-box">
          <span>Estado</span>
          <strong>{labelFromMap(CUSTOMER_STATUS_LABELS, selectedCustomer.status)}</strong>
        </div>
        <div class="fact-box">
          <span>Telefonos usados</span>
          <strong>{formatNumber(selectedCustomer.phones_count)}</strong>
        </div>
        <div class="fact-box">
          <span>Dispositivos conocidos</span>
          <strong>{formatNumber(selectedCustomer.devices_count)}</strong>
        </div>
      </div>

      <div class="metrics-grid compact" aria-label="Historial comercial">
        <article class="metric-card"><span>Pedidos totales</span><strong>{formatNumber(selectedCustomer.orders_count)}</strong></article>
        <article class="metric-card"><span>Pendientes</span><strong>{formatNumber(selectedCustomer.pending_orders_count)}</strong></article>
        <article class="metric-card"><span>Confirmados</span><strong>{formatNumber(selectedCustomer.confirmed_orders_count)}</strong></article>
        <article class="metric-card"><span>Preparando</span><strong>{formatNumber(selectedCustomer.preparing_orders_count)}</strong></article>
        <article class="metric-card"><span>Entregados</span><strong>{formatNumber(selectedCustomer.delivered_orders_count)}</strong></article>
        <article class="metric-card"><span>Cancelados</span><strong>{formatNumber(selectedCustomer.cancelled_orders_count)}</strong></article>
        <article class="metric-card"><span>Total confirmado</span><strong>{formatMoneyUsd(selectedCustomer.confirmed_total_usd)}</strong></article>
      </div>

      <section class="subsection" aria-labelledby="customer-phones-title">
        <div class="section-head">
          <div>
            <h4 id="customer-phones-title">Telefonos utilizados</h4>
            <p>{customerPhones.length ? pluralLabel(customerPhones.length, 'telefono registrado', 'telefonos registrados') : 'Sin telefonos registrados'}</p>
          </div>
        </div>
        {customerPhones.length > 0 ? (
          <div class="compact-list">
            {customerPhones.map((phone) => (
              <article class="compact-row">
                <div>
                  <strong>{phone.phone_normalized}</strong>
                  <span>Primera vez: {formatDateTime(phone.first_seen_at)} | Ultima vez: {formatDateTime(phone.last_seen_at)}</span>
                </div>
                <div class="compact-actions">
                  <span>{pluralLabel(phone.orders_count, 'pedido', 'pedidos')}</span>
                  {phone.is_primary && <span class="status-pill">Principal</span>}
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">No hay telefonos vinculados a este cliente.</div>
        )}
      </section>

      <section class="subsection" aria-labelledby="customer-devices-title">
        <div class="section-head">
          <div>
            <h4 id="customer-devices-title">Dispositivos conocidos</h4>
            <p>{customerDevices.length ? pluralLabel(customerDevices.length, 'dispositivo registrado', 'dispositivos registrados') : 'Sin dispositivos registrados'}</p>
          </div>
        </div>
        {customerDevices.length > 0 ? (
          <div class="compact-list">
            {customerDevices.map((device) => (
              <article class="compact-row">
                <div>
                  <strong>{device.label}</strong>
                  <span>Primera actividad: {formatDateTime(device.first_seen_at)} | Ultima actividad: {formatDateTime(device.last_seen_at)}</span>
                  {showIp && <span>IP reciente: {getIpDisplayValue({ ip_masked: device.ip_display, resolved_ip: device.ip_resolution_status === 'full' ? device.ip_display : '', ip_resolution_status: device.ip_resolution_status })}</span>}
                </div>
                <div class="compact-actions">
                  <span>{pluralLabel(device.orders_count, 'pedido', 'pedidos')}</span>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">No hay dispositivos conocidos vinculados a este cliente.</div>
        )}
      </section>

      <section class="subsection" aria-labelledby="identity-warnings-title">
        <div class="section-head">
          <div>
            <h4 id="identity-warnings-title">Coincidencias de identidad</h4>
            <p>{customerLinksSummary?.active_links ? pluralLabel(customerLinksSummary.active_links, 'consolidacion registrada', 'consolidaciones registradas') : 'Señales sanitizadas'}</p>
          </div>
        </div>
        <div class="warning-list">
          {(customerIdentityWarnings.length ? customerIdentityWarnings : ['La IP es una señal de red y no confirma identidad.']).map((warning) => (
            <p>{warning}</p>
          ))}
        </div>
      </section>

      <section class="subsection" aria-labelledby="customer-orders-title">
        <div class="section-head">
          <div>
            <h4 id="customer-orders-title">Pedidos</h4>
            <p>{customerOrdersError ? 'No disponible' : customerPageLabel(customerOrders)}</p>
          </div>
        </div>
        {customerOrdersError ? (
          <div class="empty-state">No se pudieron cargar los pedidos de este cliente en este momento.</div>
        ) : customerOrders && customerOrders.items.length > 0 ? (
          <>
            <div class="compact-list">
              {customerOrders.items.map((order) => (
                <article class="compact-row">
                  <div>
                    <strong>{order.order_number || 'Orden sin numero'}</strong>
                    <span>{formatDateTime(order.created)} | {labelFromMap(ORDER_STATUS_LABELS, order.status)} | {labelFromMap(DELIVERY_METHOD_LABELS, order.delivery_method)}</span>
                  </div>
                  <div class="compact-actions">
                    <span>{formatMoneyUsd(getOrderTotal(order))}</span>
                    {orderHref(order) && <a class="row-action" href={orderHref(order)}>Ver orden</a>}
                  </div>
                </article>
              ))}
            </div>
            <div class="pagination-bar">
              <span>{customerPageLabel(customerOrders)}</span>
              <div class="pagination-actions">
                <a class:list={['page-button', { disabled: customerOrders.page <= 1 }]} href={paginationHref('orders', Math.max(1, customerOrders.page - 1))}>Anterior</a>
                {pageWindow(customerOrders).map((page) => <a class:list={['page-button', { 'is-active': page === customerOrders.page }]} href={paginationHref('orders', page)}>{page}</a>)}
                <a class:list={['page-button', { disabled: customerOrders.page >= customerOrders.totalPages }]} href={paginationHref('orders', Math.min(customerOrders.totalPages, customerOrders.page + 1))}>Próximo</a>
              </div>
            </div>
          </>
        ) : (
          <div class="empty-state">No hay pedidos vinculados a este cliente.</div>
        )}
      </section>

      <section class="subsection" aria-labelledby="customer-events-title">
        <div class="section-head">
          <div>
            <h4 id="customer-events-title">Seguridad</h4>
            <p>{customerEventsError ? 'No disponible' : customerPageLabel(customerEvents)}</p>
          </div>
        </div>
        {customerEventsError ? (
          <div class="empty-state">No se pudo cargar la actividad de seguridad de este cliente en este momento.</div>
        ) : customerEvents && customerEvents.items.length > 0 ? (
          <>
            <div class="compact-list">
              {customerEvents.items.map((event) => (
                <article class="compact-row">
                  <div>
                    <strong>{labelFromMap(EVENT_TYPE_LABELS, event.event_type)}</strong>
                    <span>{formatDateTime(event.occurred_at || event.created)} | {labelFromMap(EVENT_DECISION_LABELS, event.decision)} | {labelFromMap(EVENT_RISK_LABELS, event.risk_level)}</span>
                    <span>Modo: {labelFromMap(MODE_AT_EVENT_LABELS, event.mode_at_event)} | Captura: {labelFromMap(CAPTURE_STATUS_LABELS, event.capture_status)}</span>
                    {event.relatedOrder && <span>Orden: {event.relatedOrder.order_number || event.relatedOrder.id}</span>}
                    {showIp && (
                      <span>
                        IP: {getIpDisplayValue(event)}
                        {getIpUnavailableNote(event) && ` | ${getIpUnavailableNote(event)}`}
                      </span>
                    )}
                  </div>
                </article>
              ))}
            </div>
            <div class="pagination-bar">
              <span>{customerPageLabel(customerEvents)}</span>
              <div class="pagination-actions">
                <a class:list={['page-button', { disabled: customerEvents.page <= 1 }]} href={paginationHref('events', Math.max(1, customerEvents.page - 1))}>Anterior</a>
                {pageWindow(customerEvents).map((page) => <a class:list={['page-button', { 'is-active': page === customerEvents.page }]} href={paginationHref('events', page)}>{page}</a>)}
                <a class:list={['page-button', { disabled: customerEvents.page >= customerEvents.totalPages }]} href={paginationHref('events', Math.min(customerEvents.totalPages, customerEvents.page + 1))}>Próximo</a>
              </div>
            </div>
          </>
        ) : (
          <div class="empty-state">No hay actividad de seguridad registrada para este cliente.</div>
        )}
      </section>
    </section>
