          title={canCreateManualIpBlock ? '' : 'Activa el modo Proteccion y los bloqueos manuales para agregar una IP.'}
        >Agregar bloqueo por IP</button>
      </div>

      <section class="admin-compact-summary security-compact-summary security-inline-summary blocked-metrics-summary" aria-label="Resumen de bloqueos">
        <div class="admin-compact-summary__head">
          <span class="admin-compact-summary__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m5.6 5.6 12.8 12.8"></path></svg>
          </span>
          <div>
            <p class="admin-compact-summary__eyebrow">Resumen</p>
            <h4 class="admin-compact-summary__title">Bloqueos</h4>
            <p class="admin-compact-summary__subtitle">Estado actual de las restricciones privadas.</p>
          </div>
        </div>
        <div class="admin-compact-summary__list">
          <article class="admin-compact-summary__item is-danger"><p class="admin-compact-summary__label">Bloqueos activos</p><p class="admin-compact-summary__value">{formatNumber(selectedBlocksMetrics().active_blocks)}</p></article>
          <article class="admin-compact-summary__item is-purple"><p class="admin-compact-summary__label">Clientes afectados</p><p class="admin-compact-summary__value">{formatNumber(selectedBlocksMetrics().affected_customers)}</p></article>
          <article class="admin-compact-summary__item is-warn"><p class="admin-compact-summary__label">IPs manuales activas</p><p class="admin-compact-summary__value">{formatNumber(selectedBlocksMetrics().manual_ip_blocks)}</p></article>
          <article class="admin-compact-summary__item"><p class="admin-compact-summary__label">Vencen hoy</p><p class="admin-compact-summary__value">{formatNumber(selectedBlocksMetrics().expires_today)}</p></article>
          <article class="admin-compact-summary__item is-muted"><p class="admin-compact-summary__label">Permanentes</p><p class="admin-compact-summary__value">{formatNumber(selectedBlocksMetrics().permanent_blocks)}</p></article>
        </div>
      </section>

      <form class="block-filter-form" method="POST" action={sectionHref('blocked')}>
        <input type="hidden" name="section" value="blocked" />
        <input type="hidden" name="blocked_page" value="1" />
        <div class="field">
          <label for="blocked-search">Buscar bloqueo</label>
          <input id="blocked-search" name="blocked_search" type="search" maxlength="80" value={params.blockedSearch} autocomplete="off" placeholder="Cliente, telefono, IP o motivo" />
        </div>
        <div class="field">
          <label for="blocked-status">Estado</label>
          <select id="blocked-status" name="blocked_status">
            {blockStatusOptions.map(([value, label]) => <option value={value} selected={isActiveBlockStatus(value)}>{label}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="blocked-scope">Alcance</label>
          <select id="blocked-scope" name="blocked_scope">
            {blockScopeOptions.map(([value, label]) => <option value={value} selected={isActiveBlockScope(value)}>{label}</option>)}
          </select>
        </div>
        <button class="primary-action" type="submit">Filtrar</button>
        <a class="secondary-action" href={sectionHref('blocked')}>Limpiar</a>
      </form>

      {!params.blockedSearch && (
        <div class="filter-row" aria-label="Filtros rapidos de bloqueos">
          {blockStatusOptions.map(([value, label]) => (
            <a class:list={['filter-chip', { 'is-active': isActiveBlockStatus(value) }]} href={blockedHref(1, { blocked_status: value })}>
              {label}
            </a>
          ))}
        </div>
      )}

      {blocksResult && blocksResult.items.length > 0 ? (
        <>
          <div class="monitoring-table blocks-table" role="table" aria-label="Bloqueos de seguridad">
            <div class="table-head" role="row">
              <span role="columnheader">Cliente</span>
              <span role="columnheader">Alcance</span>
              <span role="columnheader">Senales</span>
              <span role="columnheader">Creado</span>
              <span role="columnheader">Vencimiento</span>
              <span role="columnheader">Estado</span>
              <span role="columnheader">Acciones</span>
            </div>
            <div class="table-body">
              {blocksResult.items.map((block) => (
                <article
                  id={`security-block-${block.id}`}
                  class:list={['table-row', { 'is-focused-block': params.blockedFocusId === block.id }]}
                  role="row"
                >
                  <div class="table-cell main-cell" role="cell" data-label="Cliente">
                    <strong>{blockCustomerTitle(block)}</strong>
                    <span>{blockCustomerSubtitle(block)}</span>
                    {context === 'store' && (
                      <span class="pz-last-modification" data-pz-last-modification data-resource-type="security_block" data-resource-id={block.id} data-show-actor="true" data-useful-empty="false"><span class="pz-last-modification__skeleton">Cargando última modificación…</span></span>
                    )}
                  </div>
                  <div class="table-cell" role="cell" data-label="Alcance">{blockScopeLabel(block.scope)}</div>
                  <div class="table-cell" role="cell" data-label="Senales">
                    <span>{blockSignalsLabel(block)}</span>
                    {block.review_device_candidates && (
                      <small class="block-review-summary">
                        {block.device_review.pending_count > 0
                          ? `${block.device_review.pending_count} dispositivo(s) pendiente(s)`
                          : block.device_review.confirmed_count > 0
                            ? `${block.device_review.confirmed_count} dispositivo(s) confirmado(s)`
                            : 'Deteccion de dispositivos activa'}
                      </small>
                    )}
                  </div>
                  <div class="table-cell" role="cell" data-label="Creado">{formatDateTime(block.created || block.starts_at)}</div>
                  <div class="table-cell" role="cell" data-label="Vencimiento">{block.expires_at ? formatDateTime(block.expires_at) : 'Permanente'}</div>
                  <div class="table-cell" role="cell" data-label="Estado"><span class={`status-pill status-${block.status}`}>{blockStatusLabel(block.status)}</span></div>
                  <div class="table-cell action-cell" role="cell" data-label="Acciones">
                    <details class="inline-row-menu" data-inline-row-menu>
                      <summary class="icon-action block-menu-trigger" aria-label={`Acciones de ${blockCustomerTitle(block)}`}><span aria-hidden="true">&#8942;</span></summary>
                      <div class="inline-row-menu-panel" role="menu">
                    <a class="floating-menu-item" href={blockHistoryHref(block.id)} role="menuitem">Ver historial</a>
                    {block.customer_id && <a class="row-action" href={customerDetailHref(block.customer_id, { orders_page: 1, events_page: 1 })}>Ver ficha</a>}
                    {block.status === 'active' && block.device_review.pending.map((candidate) => (
                      <div class="block-device-candidate-actions">
                        <span>{candidate.label} · {formatDateTime(candidate.last_seen_at)}</span>
                        <div>
                          <button
                            class="row-action block-device-review-trigger"
                            type="button"
                            data-review-action="confirm"
                            data-block-id={block.id}
                            data-candidate-id={candidate.id}
                            data-candidate-label={candidate.label}
                            disabled={!actionsEnabled}
                          >Agregar</button>
                          <button
                            class="secondary-action block-device-review-trigger"
                            type="button"
                            data-review-action="dismiss"
                            data-block-id={block.id}
                            data-candidate-id={candidate.id}
                            data-candidate-label={candidate.label}
                            disabled={!actionsEnabled}
                          >Descartar</button>
                        </div>
                      </div>
                    ))}
                    {block.status === 'active' ? (
                      <button
                        class="danger-action block-revoke-trigger"
                        type="button"
                        aria-haspopup="dialog"
                        aria-controls="security-block-revoke-dialog"
                        data-block-id={block.id}
                        data-customer-id={block.customer_id}
                        data-block-scope={blockScopeLabel(block.scope)}
                        data-return-section="blocked"
                        disabled={!actionsEnabled}
                      >Desbloquear</button>
                    ) : (
                      <span class="muted-cell">Sin accion</span>
                    )}
                      </div>
                    </details>
                  </div>
                </article>
              ))}
            </div>
          </div>

          {focusedBlock?.detail && (
            <section class="block-history-panel" aria-labelledby="block-history-title">
              <div class="section-head block-history-head">
                <div>
                  <span class={`status-pill status-${focusedBlock.status}`}>{blockStatusLabel(focusedBlock.status)}</span>
                  <h4 id="block-history-title">Historial del bloqueo</h4>
                  <p>{blockCustomerTitle(focusedBlock)}</p>
                </div>
                <a class="secondary-action" href={sectionHref('blocked')}>Cerrar historial</a>
              </div>

              <section class="admin-compact-summary security-compact-summary security-inline-summary block-history-summary" aria-label="Resumen del historial del bloqueo">
                <div class="admin-compact-summary__head">
                  <span class="admin-compact-summary__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  </span>
                  <div>
                    <p class="admin-compact-summary__eyebrow">Resumen</p>
                    <h5 class="admin-compact-summary__title">Detalle del bloqueo</h5>
                    <p class="admin-compact-summary__subtitle">Datos principales de la restricción seleccionada.</p>
                  </div>
                </div>
                <div class="admin-compact-summary__list">
                  <article class="admin-compact-summary__item"><p class="admin-compact-summary__label">Motivo</p><p class="admin-compact-summary__value is-text">{focusedBlock.reason || 'No disponible'}</p></article>
                  <article class="admin-compact-summary__item is-purple"><p class="admin-compact-summary__label">Alcance</p><p class="admin-compact-summary__value is-text">{blockScopeLabel(focusedBlock.scope)}</p></article>
                  <article class="admin-compact-summary__item"><p class="admin-compact-summary__label">Duración</p><p class="admin-compact-summary__value is-text">{blockDurationLabel(focusedBlock.duration)}</p></article>
                  <article class="admin-compact-summary__item"><p class="admin-compact-summary__label">Creado</p><p class="admin-compact-summary__value is-text">{formatDateTime(focusedBlock.created || focusedBlock.starts_at)}</p></article>
                  <article class="admin-compact-summary__item"><p class="admin-compact-summary__label">Creado por</p><p class="admin-compact-summary__value is-text">{focusedBlock.created_by_name || 'Sistema'}</p></article>
                  <article class="admin-compact-summary__item"><p class="admin-compact-summary__label">Vencimiento</p><p class="admin-compact-summary__value is-text">{focusedBlock.expires_at ? formatDateTime(focusedBlock.expires_at) : 'Permanente'}</p></article>
                  {focusedBlock.revoked_at && <article class="admin-compact-summary__item is-muted"><p class="admin-compact-summary__label">Revocado</p><p class="admin-compact-summary__value is-text">{formatDateTime(focusedBlock.revoked_at)} · {focusedBlock.revoked_by_name || 'Sistema'}</p></article>}
                  {focusedBlock.revoke_reason && <article class="admin-compact-summary__item is-muted"><p class="admin-compact-summary__label">Motivo de revocación</p><p class="admin-compact-summary__value is-text">{focusedBlock.revoke_reason}</p></article>}
                  <article class="admin-compact-summary__item is-ok"><p class="admin-compact-summary__label">Señales protegidas</p><p class="admin-compact-summary__value is-text">{blockSignalsLabel(focusedBlock)}</p></article>
                  <article class="admin-compact-summary__item is-purple"><p class="admin-compact-summary__label">Dispositivos relacionados</p><p class="admin-compact-summary__value">{formatNumber(focusedBlock.detail.related_device_count)}</p></article>
                  <article class="admin-compact-summary__item is-warn"><p class="admin-compact-summary__label">Direcciones protegidas</p><p class="admin-compact-summary__value">{formatNumber(focusedBlock.detail.related_address_count)}</p></article>
                </div>
              </section>

              <details class="block-history-disclosure" open>
                <summary>IPs relacionadas ({formatNumber(focusedBlock.detail.related_ip_count)})</summary>
                {focusedBlock.detail.related_ips.length > 0 ? (
                  <div class="block-related-ip-list">
                    {focusedBlock.detail.related_ips.map((ip) => (
                      <article class="block-related-ip-row">
                        <div class="block-related-ip-main">
                          <strong>{ip.ip_resolution_status === 'hidden' ? 'IP oculta por configuracion' : ip.ip_display || 'IP no disponible'}</strong>
                          <span>{blockIpSourceLabel(ip)}</span>
                          {blockVpnLabel(ip) && <small class="vpn-history-label">{blockVpnLabel(ip)}</small>}
                        </div>
                        <div><span>Estado</span><strong class={`status-pill status-${ip.state === 'blocked' ? 'active' : ip.state === 'observed' ? 'watch' : ip.state}`}>{blockIpStateLabel(ip)}</strong></div>
                        <div><span>Primera deteccion</span><strong>{ip.first_seen_at ? formatDateTime(ip.first_seen_at) : 'No disponible'}</strong></div>
                        <div><span>Ultima deteccion</span><strong>{ip.last_seen_at ? formatDateTime(ip.last_seen_at) : 'No disponible'}</strong></div>
                        <div><span>Intentos bloqueados</span><strong>{formatNumber(ip.blocked_attempts)}</strong></div>
                        <div class="block-related-ip-action">
                          {ip.visitor_session_id
                            ? <a class="row-action" href={visitorDetailHref(ip.visitor_session_id)}>Ver actividad</a>
                            : <span class="muted-cell">Sin historial navegable</span>}
                        </div>
                      </article>
                    ))}
                  </div>
                ) : (
                  <div class="empty-state">Todavia no hay una IP visible asociada a este bloqueo.</div>
                )}
                {focusedBlock.detail.related_ip_count > focusedBlock.detail.related_ips.length && (
                  <p class="block-history-limit-note">Se muestran las {formatNumber(focusedBlock.detail.related_ips.length)} IP relacionadas mas recientes.</p>
                )}
              </details>

              <details class="block-history-disclosure">
                <summary>Cronologia ({formatNumber(focusedBlock.detail.history_count)})</summary>
                {focusedBlock.detail.history.length > 0 ? (
                  <div class="block-history-timeline">
                    {focusedBlock.detail.history.map((entry) => {
                      const navigationHref = blockHistoryNavigationHref(entry);
                      return (
                        <article class="block-history-entry">
                          <div>
                            <strong>{blockHistoryActionLabel(entry)}</strong>
                            <span>{formatDateTime(entry.occurred_at)}</span>
                          </div>
                          <div class="block-history-entry-detail">
                            <span>{entry.actor_name || 'Sistema'}</span>
                            {entry.reason && <span>{entry.reason}</span>}
                            {showIp && entry.ip_display && <span>IP: {entry.ip_display}</span>}
                          </div>
                          {navigationHref && <a class="row-action" href={navigationHref}>Ver visitante</a>}
                        </article>
                      );
                    })}
                  </div>
                ) : (
                  <div class="empty-state">No hay eventos adicionales para este bloqueo.</div>
                )}
                {focusedBlock.detail.history_count > focusedBlock.detail.history.length && (
                  <p class="block-history-limit-note">Se muestran los {formatNumber(focusedBlock.detail.history.length)} eventos mas recientes.</p>
                )}
              </details>
            </section>
          )}

          <div class="pagination-bar" aria-label="Paginacion de bloqueos">
            <span>{customerPageLabel(blocksResult)}</span>
            <div class="pagination-actions">
              {params.blockedSearch ? (
                <>
                  <form method="POST" action={sectionHref('blocked')}>
                    <input type="hidden" name="section" value="blocked" />
                    <input type="hidden" name="blocked_search" value={params.blockedSearch} />
                    <input type="hidden" name="blocked_status" value={params.blockedStatus} />
                    <input type="hidden" name="blocked_scope" value={params.blockedScope} />
                    <input type="hidden" name="blocked_page" value={Math.max(1, blocksResult.page - 1)} />
                    <button class="page-button" type="submit" disabled={blocksResult.page <= 1}>Anterior</button>
                  </form>
                  <form method="POST" action={sectionHref('blocked')}>
                    <input type="hidden" name="section" value="blocked" />
                    <input type="hidden" name="blocked_search" value={params.blockedSearch} />
                    <input type="hidden" name="blocked_status" value={params.blockedStatus} />
                    <input type="hidden" name="blocked_scope" value={params.blockedScope} />
                    <input type="hidden" name="blocked_page" value={Math.min(blocksResult.totalPages, blocksResult.page + 1)} />
                    <button class="page-button" type="submit" disabled={blocksResult.page >= blocksResult.totalPages}>Próximo</button>
                  </form>
                </>
              ) : (
                <>
                  <a class:list={['page-button', { disabled: blocksResult.page <= 1 }]} href={paginationHref('blocked', Math.max(1, blocksResult.page - 1))}>Anterior</a>
                  {pageWindow(blocksResult).map((page) => <a class:list={['page-button', { 'is-active': page === blocksResult.page }]} href={paginationHref('blocked', page)}>{page}</a>)}
                  <a class:list={['page-button', { disabled: blocksResult.page >= blocksResult.totalPages }]} href={paginationHref('blocked', Math.min(blocksResult.totalPages, blocksResult.page + 1))}>Próximo</a>
                </>
              )}
            </div>
          </div>
        </>
      ) : (
        <div class="empty-state">No hay bloqueos para los filtros actuales.</div>
      )}
    </section>
  )}
</section>

<dialog id="security-manual-ip-block-dialog" class="security-modal" data-manual-ip-block-dialog data-preview-ready={manualIpPreviewReady ? 'true' : 'false'} aria-labelledby="security-manual-ip-block-title">
  <div class="security-modal-card">
    <header class="security-modal-header">
      <div>
        <h3 id="security-manual-ip-block-title">Agregar bloqueo por IP</h3>
        <p>La IP se normaliza y protege en el servidor antes de guardar el bloqueo.</p>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Cerrar dialogo"><span aria-hidden="true">&times;</span></button>
    </header>
    <form class="lifecycle-form security-modal-form" method="POST" action={sectionHref('blocked')} data-manual-ip-block-form>
      <div class="security-modal-body">
        <input type="hidden" name="section" value="blocked" />
        <input type="hidden" name="security_action" value={manualIpPreviewReady ? 'manual_ip_block_create' : 'manual_ip_device_preview'} />
        <input type="hidden" name="visitor_session_id" value={manualIpDraft?.visitorSessionId || ''} data-manual-visitor-session />
        <label class="field" for="security-manual-block-ip" data-manual-ip-field hidden={Boolean(manualIpDraft?.visitorSessionId)}>
          <span>IP publica exacta</span>
          <input
            id="security-manual-block-ip"
            name="manual_ip"
            type="text"
            maxlength="64"
            inputmode="text"
            autocomplete="off"
            spellcheck="false"
            required={!manualIpDraft?.visitorSessionId}
            readonly={manualIpPreviewReady}
            value={manualIpDraft?.ip || ''}
            data-dialog-focus
            placeholder="IPv4 o IPv6"
          />
          <small>No se admiten rangos, redes internas, loopback ni direcciones reservadas.</small>
        </label>
        <p class="monitoring-note" data-manual-visitor-source hidden={!manualIpDraft?.visitorSessionId}>Se revisaran las IP historicas protegidas de este visitante antes de crear el bloqueo.</p>
        <label class="field" for="security-manual-block-scope">
          <span>Alcance</span>
          <select id="security-manual-block-scope" name="block_scope" required>
            {blockScopeCreateOptions.map(([value, label]) => (
              <option value={value} selected={value === (manualIpDraft?.scope || 'orders')} disabled={value === 'full_access' && settings.full_access_blocking_enabled !== true}>{label}</option>
            ))}
          </select>
        </label>
        <label class="field" for="security-manual-block-duration">
          <span>Duracion</span>
          <select id="security-manual-block-duration" name="block_duration" required>
            {blockDurationOptions.map(([value, label]) => (
              <option value={value} selected={value === (manualIpDraft?.duration || 'hours_24')} disabled={value === 'permanent' && settings.permanent_blocks_enabled !== true}>{label}</option>
            ))}
          </select>
        </label>
        {manualIpPreviewReady ? (
          <>
            {manualIpDraft?.visitorSessionId && (
              <div class="field manual-ip-selection">
                <span>Direcciones IP que se bloquearan ahora</span>
                {manualIpDeviceLookup!.ip_candidates.length > 1 && (
                  <button class="secondary-action" type="button" data-manual-ip-select-all>Seleccionar todas</button>
                )}
                {manualIpDeviceLookup!.ip_candidates.map((candidate, index) => (
                  <label class="signal-option">
                    <input
                      type="checkbox"
                      name="manual_ip_source_ids"
                      value={candidate.source_id}
                      checked={candidate.preselected || manualIpDeviceLookup!.ip_candidates.length === 1}
                    />
                    <span>
                      <strong>{candidate.ip_display || `IP protegida ${index + 1}`}</strong>
                      <small>{candidate.preselected ? 'IP actual · ' : ''}Ultima actividad: {formatDateTime(candidate.last_seen_at)}</small>
                    </span>
                  </label>
                ))}
                <p class="modal-warning">Selecciona una, varias o todas. Las IP nuevas que aparezcan despues no se agregaran automaticamente y deberan revisarse por separado.</p>
              </div>
            )}
            <div class="field manual-device-selection">
              <span>Dispositivos que se bloquearan ahora</span>
              {manualIpDeviceLookup!.candidates.length > 1 && (
                <button class="secondary-action" type="button" data-manual-select-all>Seleccionar todos</button>
              )}
              {manualIpDeviceLookup!.candidates.length > 0 ? (
                manualIpDeviceLookup!.candidates.map((candidate) => (
                  <label class="signal-option">
                    <input
                      type="checkbox"
                      name="manual_device_session_ids"
                      value={candidate.session_id}
                      checked={candidate.preselected || manualIpDeviceLookup!.candidates.length === 1}
                    />
                    <span><strong>{candidate.label}</strong><small>Ultima actividad: {formatDateTime(candidate.last_seen_at)}</small></span>
                  </label>
                ))
              ) : (
                <p class="modal-warning">No hay un dispositivo conocido para estas IP. Puedes crear el bloqueo solo por IP; cualquier dispositivo nuevo detectado aparecera luego para revision.</p>
              )}
              <p class="modal-warning">Una IP puede ser compartida. Selecciona uno, varios o todos solamente cuando correspondan al bloqueo.</p>
            </div>
          </>
        ) : (
          <p class="monitoring-note">Primero buscaremos IP y dispositivos vistos anteriormente. Ningun bloqueo se creara en este paso.</p>
        )}
        <label class="field" for="security-manual-block-reason">
          <span>Motivo interno</span>
          <textarea id="security-manual-block-reason" name="block_reason" maxlength="500" required>{manualIpDraft?.reason || ''}</textarea>
        </label>
      </div>
      <footer class="security-modal-footer">
        <button class="secondary-action" type="button" data-modal-cancel>Cancelar</button>
        {manualIpPreviewReady && <a class="secondary-action" href={sectionHref('blocked')}>Cambiar IP</a>}
        <button class="danger-action" type="submit">{manualIpPreviewReady ? 'Crear bloqueo' : 'Buscar dispositivos'}</button>
      </footer>
    </form>
  </div>
</dialog>

<dialog id="security-block-device-review-dialog" class="security-modal" data-block-device-review-dialog aria-labelledby="security-block-device-review-title">
  <div class="security-modal-card">
    <header class="security-modal-header">
      <div>
        <h3 id="security-block-device-review-title" data-block-device-review-title>Revisar dispositivo</h3>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Cerrar dialogo"><span aria-hidden="true">&times;</span></button>
    </header>
    <form class="lifecycle-form security-modal-form" method="POST" action={sectionHref('blocked')} data-block-device-review-form>
      <div class="security-modal-body">
        <p data-block-device-review-description>Confirma o descarta el dispositivo detectado desde la IP bloqueada.</p>
        <input type="hidden" name="section" value="blocked" />
        <input type="hidden" name="security_action" value="block_device_candidate_review" />
        <input type="hidden" name="block_id" value="" data-block-device-review-block />
        <input type="hidden" name="candidate_id" value="" data-block-device-review-candidate />
        <input type="hidden" name="device_review_action" value="confirm" data-block-device-review-action />
        <label class="field" for="security-block-device-review-reason">
          <span>Motivo interno</span>
          <textarea id="security-block-device-review-reason" name="device_review_reason" maxlength="500" required data-dialog-focus></textarea>
        </label>
      </div>
      <footer class="security-modal-footer">
        <button class="secondary-action" type="button" data-modal-cancel>Cancelar</button>
        <button class="danger-action" type="submit" data-block-device-review-submit>Agregar al bloqueo</button>
      </footer>
    </form>
  </div>
</dialog>

<div id="security-customer-actions-menu" class="floating-actions-menu" data-customer-menu role="menu" aria-label="Acciones de cliente" aria-hidden="true" hidden>
  <a class="floating-menu-item" href="#" data-customer-menu-view role="menuitem">Ver ficha</a>
  <button class="floating-menu-item" type="button" data-menu-action="lifecycle" role="menuitem" disabled={!actionsEnabled}>Archivar cliente</button>
  <button class="floating-menu-item danger" type="button" data-menu-action="delete" role="menuitem" disabled={!actionsEnabled}>Eliminar ficha de Seguridad</button>
</div>

<div id="security-visitor-actions-menu" class="floating-actions-menu" data-visitor-menu role="menu" aria-label="Acciones de visitante" aria-hidden="true" hidden>
  <a class="floating-menu-item" href="#" data-visitor-menu-view role="menuitem">Ver visitante</a>
  <button class="floating-menu-item danger" type="button" data-visitor-menu-block data-manual-ip-block-trigger role="menuitem">Bloquear</button>
</div>

<dialog id="security-lifecycle-dialog" class="security-modal security-lifecycle-modal" data-lifecycle-dialog aria-labelledby="security-lifecycle-title">
  <div class="security-modal-card">
    <header class="security-modal-header">
      <div>
        <h3 id="security-lifecycle-title" data-lifecycle-title>Archivar cliente</h3>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Cerrar dialogo"><span aria-hidden="true">&times;</span></button>
    </header>
    <form class="lifecycle-form security-modal-form" method="POST" action={sectionHref('customers')} data-lifecycle-form>
      <div class="security-modal-body">
        <p data-lifecycle-description>El cliente dejara de aparecer en la lista activa y podra restaurarse despues.</p>
        <p data-lifecycle-notice>Sus pedidos y datos de Seguridad se conservaran.</p>
        <input type="hidden" name="section" value="customers" />
        <input type="hidden" name="customer" value="" data-lifecycle-customer />
        <input type="hidden" name="security_action" value="customer_lifecycle" />
        <input type="hidden" name="lifecycle_action" value="archive" data-lifecycle-action-input />
        <label class="field" for="security-lifecycle-reason">
          <span>Motivo interno</span>
          <textarea id="security-lifecycle-reason" name="lifecycle_reason" maxlength="500" required data-dialog-focus></textarea>
        </label>
      </div>
      <footer class="security-modal-footer">
        <button class="secondary-action" type="button" data-modal-cancel>Cancelar</button>
