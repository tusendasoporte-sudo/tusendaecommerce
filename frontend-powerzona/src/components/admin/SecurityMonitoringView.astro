            data-phone-count={selectedAvailableSignals().phone_count}
            data-device-count={selectedAvailableSignals().device_count}
            data-ip-count={selectedAvailableSignals().ip_count}
            disabled={!selectedBlockCapabilities().can_block || selectedCustomer.archived || (selectedAvailableSignals().phone_count + selectedAvailableSignals().device_count + selectedAvailableSignals().ip_count) === 0}
          >Crear bloqueo</button>
          <button
