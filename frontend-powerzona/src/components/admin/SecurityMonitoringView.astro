  {params.section === 'visitors' && (
    <section class="monitoring-card" aria-labelledby="visitors-title">
      <div class="section-head">
        <div>
          <h3 id="visitors-title">Visitantes</h3>
          <p>{visitorRangeDescriptions[params.visitorRange]}</p>
        </div>
      </div>

      <nav class="filter-row visitor-range-filters" aria-label="Periodo de visitantes">
        {VISITOR_RANGE_FILTERS.map((range) => (
          <a
            class:list={['filter-chip', { 'is-active': params.visitorRange === range }]}
            href={visitorsHref(1, { visitor_range: range })}
            aria-current={params.visitorRange === range ? 'page' : undefined}
          >{visitorRangeLabels[range]}</a>
        ))}
      </nav>

      {visitorsResult && visitorsResult.items.length > 0 ? (
        <>
          <div class:list={['monitoring-table', 'visitors-table', { 'has-ip': showIp }]} role="table" aria-label={`Visitantes: ${visitorRangeLabels[params.visitorRange]}`}>
            <div class="table-head" role="row">
              <span role="columnheader">Visitante</span>
              <span role="columnheader">Telefono</span>
              {showIp && <span role="columnheader">IP</span>}
              <span role="columnheader">Estado</span>
              <span role="columnheader">Ultima actividad</span>
              <span role="columnheader">Paginas</span>
              <span role="columnheader">Acciones</span>
            </div>
            <div class="table-body">
              {visitorsResult.items.map((visitor) => (
                <article class="table-row" role="row">
                  <div class="table-cell main-cell" role="cell" data-label="Visitante">
                    <div class="visitor-name-row">
                      <strong>{getVisitorDisplayName(visitor)}</strong>
                      {visitor.relatedCustomer && <span class="visitor-customer-pill">Cliente</span>}
                    </div>
                    <span>{visitor.relatedCustomer ? pluralLabel(visitor.relatedCustomer.orders_count, 'pedido realizado', 'pedidos realizados') : 'Visitante sin identificar'}</span>
                    <small>{visitor.entry_path || 'Ruta inicial no disponible'}</small>
                  </div>
                  <div class="table-cell sensitive-cell" role="cell" data-label="Telefono">{getVisitorPhone(visitor)}</div>
                  {showIp && (
                    <div class="table-cell ip-cell" role="cell" data-label="IP">
                      <span>{getIpDisplayValue(visitor)}</span>
                      {getIpUnavailableNote(visitor) && <small>{getIpUnavailableNote(visitor)}</small>}
                    </div>
                  )}
                  <div class="table-cell" role="cell" data-label="Estado">
                    <span class={`status-pill status-${visitor.security_status}`}>{visitorSecurityStatusLabels[visitor.security_status]}</span>
                    {visitor.vpn.event_type && <small>{labelFromMap(EVENT_TYPE_LABELS, visitor.vpn.event_type)}</small>}
                  </div>
                  <div class="table-cell" role="cell" data-label="Ultima actividad">{formatDateTime(visitor.last_seen_at)}</div>
                  <div class="table-cell" role="cell" data-label="Paginas">{formatNumber(visitor.pageviews_count)}</div>
                  <div class="table-cell action-cell" role="cell" data-label="Accion">
                    <button
                      class="icon-action visitor-menu-trigger"
                      type="button"
                      aria-label={`Acciones de ${getVisitorDisplayName(visitor)}`}
                      aria-haspopup="menu"
                      aria-controls="security-visitor-actions-menu"
                      aria-expanded="false"
                      data-visitor-href={visitorDetailHref(visitor.id)}
                      data-visitor-session-id={visitor.id}
                      data-can-block={canCreateManualIpBlock ? 'true' : 'false'}
                    ><span aria-hidden="true">&#8942;</span></button>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <div class="pagination-bar" aria-label="Paginacion de visitantes">
            <span>{customerPageLabel(visitorsResult)}</span>
            <div class="pagination-actions">
              <a class:list={['page-button', { disabled: visitorsResult.page <= 1 }]} href={paginationHref('visitors', Math.max(1, visitorsResult.page - 1))}>Anterior</a>
              {pageWindow(visitorsResult).map((page) => <a class:list={['page-button', { 'is-active': page === visitorsResult.page }]} href={paginationHref('visitors', page)}>{page}</a>)}
              <a class:list={['page-button', { disabled: visitorsResult.page >= visitorsResult.totalPages }]} href={paginationHref('visitors', Math.min(visitorsResult.totalPages, visitorsResult.page + 1))}>Próximo</a>
            </div>
          </div>
        </>
      ) : (
        <div class="empty-state">{visitorRangeEmptyMessages[params.visitorRange]}</div>
      )}
    </section>
  )}

  {params.section === 'activity' && (
    <section class="monitoring-card" aria-labelledby="activity-title">
      <div class="section-head">
        <div>
          <h3 id="activity-title">Actividad</h3>
          <p>{customerPageLabel(activityResult)}</p>
        </div>
      </div>

      <form class="activity-filter-grid" method="GET" action={basePath} aria-label="Filtros de actividad">
        <input type="hidden" name="section" value="activity" />
        <label class="filter-select-field">
          <span>Tipo de actividad</span>
          <select name="event_type" data-activity-filter>
            {EVENT_TYPE_FILTERS.map((value) => (
              <option value={value} selected={params.eventType === value}>
                {value === 'all' ? 'Todos los eventos' : labelFromMap(EVENT_TYPE_LABELS, value)}
              </option>
            ))}
          </select>
        </label>
        <label class="filter-select-field">
          <span>Nivel de riesgo</span>
          <select name="risk" data-activity-filter>
            {EVENT_RISK_FILTERS.map((value) => (
              <option value={value} selected={params.eventRisk === value}>
                {value === 'all' ? 'Todos los riesgos' : labelFromMap(EVENT_RISK_LABELS, value)}
              </option>
            ))}
          </select>
        </label>
        <noscript><button class="secondary-action" type="submit">Aplicar filtros</button></noscript>
      </form>

      {activityResult && activityEventGroups.length > 0 ? (
        <>
          <div class:list={['monitoring-table', 'activity-table', { 'has-ip': showIp }]} role="table" aria-label="Eventos de seguridad">
            <div class="table-head" role="row">
              <span role="columnheader">Actividad</span>
              <span role="columnheader">Cliente / pedido</span>
              <span role="columnheader">Resultado</span>
              {showIp && <span role="columnheader">IP</span>}
              <span role="columnheader">Accion</span>
            </div>
            <div class="table-body">
              {activityEventGroups.map((group) => {
                const event = group.event;
                const phone = eventCustomerPhoneValue(event);
                const decisionLabel = labelFromMap(EVENT_DECISION_LABELS, event.decision);
                const riskLabel = labelFromMap(EVENT_RISK_LABELS, event.risk_level);
                const actionHref = activityActionHref(event);
                const actionLabel = activityActionLabel(event);
                return (
                <article class="table-row" role="row">
                  <div class="table-cell main-cell activity-event-cell" role="cell" data-label="Actividad">
                    <strong>{activityEventTitle(group)}</strong>
                    <span>{formatDateTime(event.occurred_at || event.created)}</span>
                    {group.events.length > 1 && <small>{formatNumber(group.events.length)} registros consecutivos agrupados</small>}
                  </div>
                  <div class="table-cell sensitive-cell activity-customer-cell" role="cell" data-label="Cliente / pedido">
                    <strong>{eventCustomerName(event)}</strong>
                    {phone && <span>{phone}</span>}
                    {event.relatedOrder ? (
                      orderHref(event.relatedOrder) ? <a class="inline-link" href={orderHref(event.relatedOrder)}>{event.relatedOrder.order_number || event.relatedOrder.id}</a> : <span>{event.relatedOrder.order_number || event.relatedOrder.id}</span>
                    ) : <span>Sin pedido</span>}
                  </div>
                  <div class="table-cell activity-result-cell" role="cell" data-label="Resultado">
                    <div class="activity-result-badges">
                      <span class:list={['activity-result-pill', `is-${activityResultTone(event.decision)}`]}>{decisionLabel}</span>
                      {riskLabel !== decisionLabel && <span class:list={['activity-result-pill', `is-${activityResultTone(event.risk_level)}`]}>{riskLabel}</span>}
                    </div>
                    <span>{labelFromMap(MODE_AT_EVENT_LABELS, event.mode_at_event)}</span>
                  </div>
                  {showIp && (
                    <div class="table-cell ip-cell" role="cell" data-label="IP">
                      <span>{getIpDisplayValue(event)}</span>
                      {getIpUnavailableNote(event) && <small>{getIpUnavailableNote(event)}</small>}
                    </div>
                  )}
                  <div class="table-cell activity-action-cell" role="cell" data-label="Accion">
                    {actionHref ? (
                      <a class:list={['activity-context-action', { 'is-block': event.navigation.kind === 'block' }]} href={actionHref}>{actionLabel}</a>
                    ) : (
                      <span class="activity-action-unavailable" aria-label="Historial no disponible">No disponible</span>
                    )}
                  </div>
                </article>
                );
              })}
            </div>
          </div>
          <div class="pagination-bar activity-pagination" aria-label="Paginacion de actividad">
            <span>{customerPageLabel(activityResult)}</span>
            <div class="pagination-actions">
              <a class:list={['page-button', { disabled: activityResult.page <= 1 }]} href={paginationHref('activity', Math.max(1, activityResult.page - 1))}>Anterior</a>
              {pageWindow(activityResult).map((page) => <a class:list={['page-button', { 'is-active': page === activityResult.page }]} href={paginationHref('activity', page)}>{page}</a>)}
              <a class:list={['page-button', { disabled: activityResult.page >= activityResult.totalPages }]} href={paginationHref('activity', Math.min(activityResult.totalPages, activityResult.page + 1))}>Próximo</a>
            </div>
          </div>
        </>
      ) : (
        <div class="empty-state">No hay actividad de seguridad registrada.</div>
      )}
    </section>
  )}

  {params.section === 'blocked' && (
    <section class="monitoring-card" aria-labelledby="blocked-title">
      <div class="section-head">
        <div>
          <h3 id="blocked-title">Clientes bloqueados</h3>
          <p>{customerPageLabel(blocksResult)}</p>
        </div>
        <button
          class="primary-action"
          type="button"
          data-manual-ip-block-trigger
          aria-haspopup="dialog"
          aria-controls="security-manual-ip-block-dialog"
