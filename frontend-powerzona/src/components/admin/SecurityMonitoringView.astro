            data-customer-archived={selectedCustomer.archived ? 'true' : 'false'}
            data-lifecycle-label={lifecycleActionLabel(selectedCustomer)}
            data-lifecycle-action={lifecycleActionValue(selectedCustomer)}
            data-lifecycle-description={lifecycleActionDescription(selectedCustomer)}
            data-lifecycle-notice={lifecycleNoticeText(selectedCustomer)}
            data-orders-count={selectedLifecycleCounts().orders_affected}
            data-phones-count={selectedLifecycleCounts().phones_affected}
            data-devices-count={selectedLifecycleCounts().devices_affected}
            data-events-count={selectedLifecycleCounts().events_affected}
            data-sessions-count={selectedLifecycleCounts().sessions_affected}
            data-pageviews-count={selectedLifecycleCounts().pageviews_affected}
            disabled={!actionsEnabled || (!selectedCustomer.archived && activeBlocks.length > 0)}
          >{lifecycleActionLabel(selectedCustomer)}</button>
          <button
            class="danger-action customer-dialog-trigger"
            type="button"
            aria-haspopup="dialog"
            aria-controls="security-delete-dialog"
            data-dialog-action="delete"
            data-customer-id={selectedCustomer.id}
            data-customer-archived={selectedCustomer.archived ? 'true' : 'false'}
            data-lifecycle-label={lifecycleActionLabel(selectedCustomer)}
            data-lifecycle-action={lifecycleActionValue(selectedCustomer)}
            data-lifecycle-description={lifecycleActionDescription(selectedCustomer)}
            data-lifecycle-notice={lifecycleNoticeText(selectedCustomer)}
            data-orders-count={selectedLifecycleCounts().orders_affected}
            data-phones-count={selectedLifecycleCounts().phones_affected}
            data-devices-count={selectedLifecycleCounts().devices_affected}
            data-events-count={selectedLifecycleCounts().events_affected}
            data-sessions-count={selectedLifecycleCounts().sessions_affected}
            data-pageviews-count={selectedLifecycleCounts().pageviews_affected}
            disabled={!actionsEnabled}
          >Eliminar ficha de Seguridad</button>
        </div>
        {!selectedCustomer.archived && activeBlocks.length > 0 && <p class="action-unavailable-note">Desbloquea al cliente antes de archivarlo.</p>}
      </section>

      <section class="block-management-panel" aria-labelledby="active-blocks-title">
        <div class="block-management-head">
