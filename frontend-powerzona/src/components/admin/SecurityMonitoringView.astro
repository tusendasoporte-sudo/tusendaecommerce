                  )}
                </div>
                <dl>
                  <div><dt>Duracion</dt><dd>{blockDurationLabel(block.duration)}</dd></div>
                  <div><dt>Inicio</dt><dd>{formatDateTime(block.starts_at)}</dd></div>
                  <div><dt>Vencimiento</dt><dd>{block.expires_at ? formatDateTime(block.expires_at) : 'Permanente'}</dd></div>
                  <div><dt>Estado</dt><dd>{blockStatusLabel(block.status)}</dd></div>
