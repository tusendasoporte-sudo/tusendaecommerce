                      data-lifecycle-notice={lifecycleNoticeText(customer)}
                      data-orders-count={lifecycleCounts(customer).orders_affected}
                      data-phones-count={lifecycleCounts(customer).phones_affected}
                      data-devices-count={lifecycleCounts(customer).devices_affected}
                      data-events-count={lifecycleCounts(customer).events_affected}
                      data-sessions-count={lifecycleCounts(customer).sessions_affected}
                      data-pageviews-count={lifecycleCounts(customer).pageviews_affected}
                      disabled={!actionsEnabled}
                    >...</button>
                  </div>
                </article>
