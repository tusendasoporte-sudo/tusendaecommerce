                <a class:list={['page-button', { disabled: customerEvents.page >= customerEvents.totalPages }]} href={paginationHref('events', Math.min(customerEvents.totalPages, customerEvents.page + 1))}>Siguiente</a>
              </div>
            </div>
          </>
        ) : (
          <div class="empty-state">No hay actividad de seguridad registrada para este cliente.</div>
        )}
      </section>
