    async function calculateEditableAudience(options = {}) {
      const requestId = ++state.audienceRequestId;
      const result = one('[data-audience-result]');
      result.setAttribute('aria-busy', 'true');
      one('[data-audience-estimate]').textContent = 'Calculando…';
      one('[data-audience-note]').textContent = 'Validando instalaciones elegibles de esta tienda.';
      try {
        const audience = await previewStorefrontPushAudience(client, formValue());
        if (requestId !== state.audienceRequestId || state.editorReadonly) return null;
        state.audience = audience;
        renderAudienceEstimate(audience);
        if (!options.silent) showFormSuccess('Audiencia calculada y validada para esta tienda.');
        return audience;
      } catch (error) {
        if (requestId !== state.audienceRequestId || state.editorReadonly) return null;
        state.audience = null;
        one('[data-audience-estimate]').textContent = 'Completa la audiencia';
        one('[data-audience-note]').textContent = storefrontPushAdminErrorMessage(error?.code || error?.message);
        if (!options.silent) showFormError(error);
        return null;
      } finally {
        if (requestId === state.audienceRequestId) result.removeAttribute('aria-busy');
      }
    }
    async function calculateOpenedAudience(campaign) {
      const requestId = ++state.audienceRequestId;
      const result = one('[data-audience-result]');
      result.setAttribute('aria-busy', 'true');
      one('[data-audience-estimate]').textContent = 'Calculando…';
      one('[data-audience-note]').textContent = 'Validando instalaciones elegibles de esta tienda.';
      try {
        const audience = await previewStorefrontPushAudience(client, campaign.id);
        if (requestId !== state.audienceRequestId || state.editing?.id !== campaign.id) return;
        state.audience = audience;
        renderAudienceEstimate(audience);
      } catch (error) {
        if (requestId !== state.audienceRequestId || state.editing?.id !== campaign.id) return;
        one('[data-audience-estimate]').textContent = 'No disponible';
        one('[data-audience-note]').textContent = storefrontPushAdminErrorMessage(error?.code || error?.message);
      } finally {
        if (requestId === state.audienceRequestId) result.removeAttribute('aria-busy');
      }
    }
    async function calculateAudience(options = {}) {
      const requestId = ++state.audienceRequestId;
      const result = one('[data-audience-result]');
      result.setAttribute('aria-busy', 'true');
      one('[data-audience-estimate]').textContent = 'Calculando…';
      one('[data-audience-note]').textContent = 'Validando instalaciones elegibles de esta tienda.';
      try {
        let campaign = state.editing;
        if (!campaign || (campaign.status === 'draft' && !state.editorReadonly)) {
          campaign = await saveDraft({ silent: true });
        }
        const audience = await previewStorefrontPushAudience(client, campaign.id);
        if (requestId === state.audienceRequestId) {
          state.audience = audience;
          renderAudienceEstimate(audience);
        }
        if (!options.silent) showFormSuccess('Audiencia calculada y validada para esta tienda.');
        return { campaign, audience };
      } catch (error) {
        if (requestId === state.audienceRequestId) {
          state.audience = null;
          one('[data-audience-estimate]').textContent = 'No se pudo calcular';
          one('[data-audience-note]').textContent = storefrontPushAdminErrorMessage(error?.code || error?.message);
        }
        throw error;
      } finally {
        if (requestId === state.audienceRequestId) result.removeAttribute('aria-busy');
      }
    }
    function confirmation(details) {
      one('[data-confirm-title]').textContent = details.title;
      one('[data-confirm-message]').textContent = details.message;
      one('[data-confirm-warning]').textContent = details.warning || '';
      one('[data-confirm-submit]').textContent = details.confirmLabel || 'Confirmar';
      one('[data-confirm-submit]').dataset.tone = details.tone || 'primary';
      one('[data-confirm-summary]').innerHTML = (details.rows || []).map(([label, value]) =>
        `<div><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`).join('');
