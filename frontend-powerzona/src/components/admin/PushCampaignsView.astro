      if (!valid) {
        ['daily', 'monthly'].forEach((period) => {
          const icon = one(`[data-quota-${period}-remaining]`);
          const remaining = one(`[data-quota-${period}-remaining-text]`);
          const summary = one(`[data-quota-${period}-summary]`);
          if (icon) icon.textContent = '—';
          if (remaining) remaining.textContent = '—';
          if (summary) summary.textContent = 'No se pudo consultar la cuota.';
