      state.audienceRequestId += 1;
      state.audience = null;
      one('[data-audience-result]').removeAttribute('aria-busy');
      one('[data-audience-estimate]').textContent = 'Calculando…';
      one('[data-audience-note]').textContent = 'Actualizando automáticamente la audiencia elegible.';
      state.audienceTimer = window.setTimeout(() => calculateEditableAudience({ silent: true }), 250);
