    function metricRate(numerator, denominator) {
      const total = Number(denominator);
      if (!Number.isFinite(total) || total <= 0) return 'No aplica';
      return `${((Math.max(0, Number(numerator || 0)) / total) * 100).toFixed(1)}%`;
    }
    function renderCampaignMetrics(metrics) {
      const panel = one('[data-campaign-metrics]');
      if (!panel || !metrics) { if (panel) panel.hidden = true; return; }
      all('[data-metric]').forEach((element) => {
        const key = element.dataset.metric;
        if (Object.prototype.hasOwnProperty.call(metrics, key)) {
          element.textContent = Number(metrics[key] || 0).toLocaleString('es-US');
        }
      });
      one('[data-rate="accepted"]').textContent = metricRate(metrics.accepted, metrics.denominators?.acceptance);
      one('[data-rate="opened"]').textContent = metricRate(metrics.opened, metrics.denominators?.opened);
      one('[data-rate="destination_viewed"]').textContent = metricRate(metrics.destination_viewed, metrics.denominators?.destination_viewed);
      one('[data-rate="coupon_applied"]').textContent = metrics.coupon_applicable
        ? metricRate(metrics.coupon_applied, metrics.denominators?.coupon_applied)
        : 'No aplica';
      one('[data-rate="orders_attributed"]').textContent = `Conversión de instalaciones: ${metricRate(metrics.buyer_installations, metrics.denominators?.conversion)}`;
      one('[data-metrics-note]').textContent = metrics.measurement_note || '';
      panel.hidden = false;
