      } catch (error) {
        showFormError(error);
      } finally {
        setBusy(false);
      }
    }
    async function deleteCampaignSelection(campaignIds) {
      const requestedIds = new Set(campaignIds);
      const campaigns = state.campaigns.filter((campaign) => (
        requestedIds.has(campaign.id) && campaignIsDeletable(campaign)
      ));
      if (!campaigns.length) {
        showToast('No hay campañas disponibles para borrar.', 'error');
        return;
      }
      const titles = campaigns.slice(0, 3).map((campaign) => campaign.title || 'Sin título');
      if (campaigns.length > titles.length) titles.push(`y ${campaigns.length - titles.length} más`);
      const scheduledCount = campaigns.filter((campaign) => campaign.status === 'scheduled').length;
      const approved = await confirmation({
        title: campaigns.length === 1 ? '¿Borrar esta campaña?' : `¿Borrar ${campaigns.length} campañas?`,
        message: 'Se retirarán del panel y se eliminará su contenido visible. La evidencia técnica mínima se conserva hasta 90 días.',
        confirmLabel: campaigns.length === 1 ? 'Borrar campaña' : 'Borrar campañas',
        tone: 'danger',
        rows: [
          ['Cantidad', String(campaigns.length)],
          ['Campañas', titles.join(', ')],
        ],
        warning: `El contenido eliminado no se puede recuperar.${scheduledCount ? ' Las campañas programadas seleccionadas dejarán de enviarse.' : ''} Las cuotas permanentes 10/310 no se reinician.`,
      });
      if (!approved) return;
      setBusy(true, campaigns.length === 1 ? 'Borrando campaña…' : 'Borrando campañas…');
      try {
        const result = await deleteStorefrontPushCampaigns(client, campaigns.map((campaign) => campaign.id));
        result.deleted_ids.forEach((campaignId) => state.selectedCampaignIds.delete(campaignId));
        if (state.editing && result.deleted_ids.includes(state.editing.id)) {
          closeDialog(editor);
          state.editing = null;
        }
        await loadCampaigns();
        showToast(result.deleted_count === 1
          ? 'Campaña retirada y contenido redactado.'
          : `${result.deleted_count} campañas retiradas y redactadas.`);
      } catch (error) {
        showToast(storefrontPushAdminErrorMessage(error?.code || error?.message), 'error');
      } finally {
        setBusy(false);
      }
    }
    async function listAction(campaignId, action) {
