        const remaining = one(`[data-quota-${period}-remaining-text]`);
        const summary = one(`[data-quota-${period}-summary]`);
        if (icon) icon.textContent = String(part.remaining);
        if (remaining) remaining.textContent = String(part.remaining);
        if (summary) summary.textContent = `${part.used} utilizada${part.used === 1 ? '' : 's'} de ${part.limit}${suffix}`;
      };
