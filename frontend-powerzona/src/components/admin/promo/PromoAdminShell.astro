---
import Layout from '../../../layouts/Layout.astro';
import type { AdminStoreContext } from '../../../lib/storeContext';
import { getAdminSupportContact } from '../../../lib/adminSupport';
import { hasPromoAction, type PromoAccessContext } from '../../../lib/promoAccess';
import {
  normalizePromoAdminLocale,
  PROMO_ADMIN_LOCALE_COOKIE,
  promoAdminText,
} from '../../../lib/promoAdminI18n';
import PromoAppearanceEditor from './PromoAppearanceEditor.astro';
import PromoCmsEditor from './PromoCmsEditor.astro';
import PromoServiceProductsEditor from './PromoServiceProductsEditor.astro';
import PromoLocalesEditor from './PromoLocalesEditor.astro';
import PromoReviewsEditor from './PromoReviewsEditor.astro';
import {
  getPromoAdminModule,
  getPromoAdminSectionPath,
  visiblePromoAdminModules,
  type PromoAdminModule,
  type PromoAdminSection,
} from '../../../lib/promoAdminShell';
import '../../../styles/promo-admin-shell.css';

interface Props {
  adminContext: AdminStoreContext;
  accessContext: PromoAccessContext;
  section?: PromoAdminSection;
}

const {
  adminContext,
  accessContext,
  section = 'overview',
} = Astro.props;

const storeSlug = String(accessContext.store.slug || adminContext.store.slug || '').trim().toLowerCase();
const storeName = String(accessContext.store.name || adminContext.store.name || 'Tienda Promo').trim() || 'Tienda Promo';
const userName = String(accessContext.user.display_name || 'Usuario').trim() || 'Usuario';
const adminLocale = normalizePromoAdminLocale(Astro.cookies.get(PROMO_ADMIN_LOCALE_COOKIE)?.value);
const t = (value: unknown) => promoAdminText(adminLocale, value);
const homePath = getPromoAdminSectionPath(storeSlug, 'overview');
const visibleModules = visiblePromoAdminModules(accessContext);
const activeModule = section === 'overview' ? null : getPromoAdminModule(section);
const primaryModules = visibleModules.filter((module) => (
  ['content', 'gallery', 'appearance', 'languages', 'contact'] as PromoAdminModule['section'][]
).includes(module.section));
const contentModules = primaryModules.filter((module) => (
  ['content', 'gallery'] as PromoAdminModule['section'][]
).includes(module.section));
const siteModules = primaryModules.filter((module) => !contentModules.includes(module));
const audienceModules = visibleModules.filter((module) => !primaryModules.includes(module));
const isMasterSupport = adminContext.isMasterSupport || accessContext.access.is_master;
const masterReturnPath = `/master/stores/${encodeURIComponent(adminContext.storeId)}`;
const pocketbaseUrl = String(import.meta.env.PUBLIC_POCKETBASE_URL || '').trim();
const authToken = String(Astro.locals.adminAuthPb?.authStore.token || '').trim();
const supportContactResult = await getAdminSupportContact({
  baseUrl: pocketbaseUrl,
  token: authToken,
  supportStoreId: isMasterSupport ? adminContext.storeId : undefined,
});
const masterSupportHref = supportContactResult.contact.configured ? supportContactResult.contact.href : '';
const publicSlug = String(accessContext.site.public_slug || '').trim().toLowerCase();
const publicPagePath = /^[a-z0-9](?:[a-z0-9-]{0,118}[a-z0-9])?$/.test(publicSlug)
  ? `/promo/${encodeURIComponent(publicSlug)}`
  : '';

const siteStatusLabels: Record<string, string> = {
  draft: 'Configuración',
  active: 'Activo',
  paused: 'Pausado',
};
const siteStatus = String(accessContext.site.status || '').trim().toLowerCase();
const siteStatusLabel = t(siteStatusLabels[siteStatus] || 'No disponible');
const pageTitle = t(activeModule ? activeModule.label : 'Resumen Promo');
const pageDescription = activeModule
  ? t(activeModule.description)
  : t('Organiza el trabajo de tu presencia promocional desde módulos separados y autorizados.');
const cmsScope = section === 'content' || section === 'contact' ? section : null;
const canSaveCms = section === 'content'
  ? hasPromoAction(accessContext, 'promo.content.manage')
  : section === 'contact'
    ? hasPromoAction(accessContext, 'promo.content.manage')
      && hasPromoAction(accessContext, 'promo.contact.manage')
    : false;
const maxServices = Number(accessContext.capabilities.max_services || 0);
const canManagePromoMedia = hasPromoAction(accessContext, 'promo.media.manage');
const canManageAppearanceContent = hasPromoAction(accessContext, 'promo.content.manage');
const canSelectPromoTheme = hasPromoAction(accessContext, 'promo.theme.select');
const canCustomizePromoAppearance = hasPromoAction(accessContext, 'promo.appearance.manage');
const canManageLocaleContent = hasPromoAction(accessContext, 'promo.content.manage');
const canManagePromoTranslations = hasPromoAction(accessContext, 'promo.translations.manage');
const maxLocales = Number(accessContext.capabilities.max_locales || 0);
const canManagePromoReviews = hasPromoAction(accessContext, 'promo.reviews.manage');
const canConfigurePromoReviews = canManagePromoReviews && hasPromoAction(accessContext, 'promo.content.manage');

function modulePath(module: PromoAdminModule) {
  return getPromoAdminSectionPath(storeSlug, module.section);
}

function initials(value: string) {
  return value
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join('') || 'TP';
}
---

<Layout isMaster={true} htmlLang={adminLocale}>
  <div class="pz-promo-admin" data-promo-admin-root data-promo-admin-locale={adminLocale}>
    {isMasterSupport && (
      <section class="pz-promo-admin__support" role="status" aria-label={`Modo soporte Master para ${storeName}`}>
        <span class="pz-promo-admin__support-icon" aria-hidden="true">M</span>
        <span class="pz-promo-admin__support-copy">
          <strong>{t('Modo soporte Master')}</strong>
          <span>{t('Las acciones permitidas conservan auditoría y contexto explícito de tienda.')}</span>
        </span>
        <a href={masterReturnPath}>{t('Volver al control Master')}</a>
      </section>
    )}

    <header class="pz-promo-admin__mobile-header">
      <button
        class="pz-promo-admin__menu-button"
        type="button"
        aria-label="Abrir navegación Promo"
        aria-controls="pz-promo-admin-nav"
        aria-expanded="false"
        data-promo-admin-menu-open
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z"></path></svg>
      </button>
      <span>
        <small>{t('Tienda Promo')}</small>
        <strong>{pageTitle}</strong>
      </span>
      <span class:list={['pz-promo-admin__status', `is-${siteStatus || 'unknown'}`]}>{siteStatusLabel}</span>
    </header>

    <button class="pz-promo-admin__backdrop" type="button" aria-label="Cerrar navegación Promo" data-promo-admin-backdrop hidden></button>

    <aside id="pz-promo-admin-nav" class="pz-promo-admin__sidebar" aria-label="Navegación de Tienda Promo" data-promo-admin-sidebar>
      <div class="pz-promo-admin__brand">
        <span class="pz-promo-admin__brandmark" aria-hidden="true">{initials(storeName)}</span>
        <span class="pz-promo-admin__brandcopy">
          <strong title={storeName}>{storeName}</strong>
          <small>Admin Promo</small>
        </span>
        <button class="pz-promo-admin__close" type="button" aria-label="Cerrar navegación Promo" data-promo-admin-menu-close>×</button>
      </div>

      <nav class="pz-promo-admin__nav" aria-label="Módulos Promo">
        <a class:list={['pz-promo-admin__nav-link', { 'is-active': section === 'overview' }]} href={homePath} aria-current={section === 'overview' ? 'page' : undefined}>
          <span class="pz-promo-admin__nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z"></path></svg></span>
          <span>{t('Resumen')}</span>
        </a>

        {primaryModules.length > 0 && (
          <section class="pz-promo-admin__nav-group" aria-labelledby="promo-nav-site">
            <h2 id="promo-nav-site">{t('Sitio')}</h2>
            {contentModules.length > 0 && (
              <details class="pz-promo-admin__nav-tree" open={contentModules.some((module) => module.section === section)}>
                <summary>
                  <span class="pz-promo-admin__nav-dot" aria-hidden="true"></span>
                  <span>{t('Contenido')}</span>
                  <span class="pz-promo-admin__nav-chevron" aria-hidden="true">⌄</span>
                </summary>
                <div class="pz-promo-admin__nav-children">
                  {contentModules.map((module) => (
                    <a
                      class:list={['pz-promo-admin__nav-link', 'is-child', { 'is-active': section === module.section }]}
                      href={modulePath(module)}
                      aria-current={section === module.section ? 'page' : undefined}
                    >
                      <span class="pz-promo-admin__nav-dot" aria-hidden="true"></span>
                      <span>{t(module.shortLabel)}</span>
                    </a>
                  ))}
                </div>
              </details>
            )}
            {siteModules.map((module) => (
              <a
                class:list={['pz-promo-admin__nav-link', { 'is-active': section === module.section }]}
                href={modulePath(module)}
                aria-current={section === module.section ? 'page' : undefined}
              >
                <span class="pz-promo-admin__nav-dot" aria-hidden="true"></span>
                <span>{t(module.shortLabel)}</span>
              </a>
            ))}
          </section>
        )}

        {audienceModules.length > 0 && (
          <section class="pz-promo-admin__nav-group" aria-labelledby="promo-nav-growth">
            <h2 id="promo-nav-growth">{t('Audiencia y salida')}</h2>
            {audienceModules.map((module) => (
              <a
                class:list={['pz-promo-admin__nav-link', { 'is-active': section === module.section }]}
                href={modulePath(module)}
                aria-current={section === module.section ? 'page' : undefined}
              >
                <span class="pz-promo-admin__nav-dot" aria-hidden="true"></span>
                <span>{t(module.shortLabel)}</span>
              </a>
            ))}
          </section>
        )}
      </nav>

      <div class="pz-promo-admin__sidebar-footer">
        <label class="pz-promo-admin__language" for="promo-admin-language">
          <span>{adminLocale === 'en' ? 'Admin language' : 'Idioma del panel'}</span>
          <select id="promo-admin-language" data-promo-admin-locale-select aria-label={adminLocale === 'en' ? 'Admin language' : 'Idioma del panel'}>
            <option value="es" selected={adminLocale === 'es'}>Español</option>
            <option value="en" selected={adminLocale === 'en'}>English</option>
          </select>
          <small>{adminLocale === 'en' ? 'Only changes this administration panel.' : 'Solo cambia este panel de administración.'}</small>
        </label>
        <div class="pz-promo-admin__sidebar-actions" aria-label="Acciones de la Tienda Promo">
          {publicPagePath ? (
            <a href={publicPagePath} target="_blank" rel="noopener noreferrer">{t('Ver mi página')} <span aria-hidden="true">↗</span></a>
          ) : (
            <button type="button" disabled>{t('Ver mi página')}</button>
          )}
        </div>
        <section class="pz-promo-admin__support-card" aria-labelledby="promo-support-title">
          <div class="pz-promo-admin__support-card-heading">
            <span class="pz-promo-admin__support-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="presentation">
                <path d="M12 3a8 8 0 0 0-8 8v4a3 3 0 0 0 3 3h1v-7H6a6 6 0 0 1 12 0h-2v7h2v1h-5v2h5a2 2 0 0 0 2-2v-1.8a3 3 0 0 0 1-2.2v-4a8 8 0 0 0-8-8h-1Z"></path>
              </svg>
            </span>
            <span>
              <strong id="promo-support-title">{t('Contactar a Tu Senda 84')}</strong>
              <small>{t('¿Necesitas ayuda con tu página?')}</small>
            </span>
          </div>
          {masterSupportHref ? (
            <a class="pz-promo-admin__support-whatsapp" href={masterSupportHref} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4.1A8 8 0 1 1 20 11.7Zm-4.3 1.9c-.2-.1-1.3-.6-1.5-.7-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-1.5-.7-2.5-1.7-3.2-3.1-.1-.2 0-.4.1-.5l.5-.6c.1-.2.2-.3.1-.5l-.7-1.7c-.1-.3-.3-.3-.5-.3h-.4c-.2 0-.5.1-.7.3-.7.7-1 1.5-1 2.4 0 1.4 1 2.8 1.2 3 .2.2 2 3.1 5 4.2.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.5-.4l-1.5-.7Z"></path>
              </svg>
              <span>{t('Escribir por WhatsApp')}</span>
            </a>
          ) : (
            <button class="pz-promo-admin__support-whatsapp" type="button" disabled title="El Master aún no configuró WhatsApp">
              <span>{t('WhatsApp no configurado')}</span>
            </button>
          )}
        </section>
        <span class="pz-promo-admin__user">
          <span aria-hidden="true">{initials(userName)}</span>
          <span><strong>{userName}</strong><small>{accessContext.user.role || 'Usuario Promo'}</small></span>
        </span>
        {!isMasterSupport && <button type="button" data-promo-admin-logout>{t('Cerrar sesión')}</button>}
      </div>
    </aside>

    <div class="pz-promo-admin__main" id="contenido-principal">
      <div class="pz-promo-admin__content">
        <header class="pz-promo-admin__page-header">
          <div>
            <span class="pz-promo-admin__eyebrow">{t('Tienda Promo')}</span>
            <h1>{pageTitle}</h1>
            <p>{pageDescription}</p>
          </div>
          <span class:list={['pz-promo-admin__status', `is-${siteStatus || 'unknown'}`]} role="status">
            {adminLocale === 'en' ? 'Status' : 'Estado'}: {siteStatusLabel}
          </span>
        </header>

        {section === 'overview' ? (
          <>
            <section class="pz-promo-admin__summary" aria-labelledby="promo-summary-title">
              <div>
                <span class="pz-promo-admin__summary-icon" aria-hidden="true">{visibleModules.length}</span>
                <span><strong id="promo-summary-title">{t('Módulos disponibles')}</strong><small>{t('La lista responde a capacidades y permisos efectivos.')}</small></span>
              </div>
              <div>
                <span class="pz-promo-admin__summary-icon" aria-hidden="true">{siteStatusLabel.slice(0, 1)}</span>
                <span><strong>{t('Estado del sitio')}</strong><small>{siteStatusLabel}</small></span>
              </div>
              <div>
                <span class="pz-promo-admin__summary-icon" aria-hidden="true">{accessContext.access.is_primary_admin ? 'P' : 'G'}</span>
                <span><strong>{t('Nivel de acceso')}</strong><small>{t(accessContext.access.is_primary_admin ? 'Administrador principal' : 'Acceso granular')}</small></span>
              </div>
            </section>

            <section class="pz-promo-admin__modules" aria-labelledby="promo-modules-title">
              <div class="pz-promo-admin__section-heading">
                <div><h2 id="promo-modules-title">{t('Tus módulos Promo')}</h2><p>{t('Solo aparecen las áreas habilitadas por el backend para esta sesión.')}</p></div>
              </div>
              {visibleModules.length > 0 ? (
                <div class="pz-promo-admin__module-grid">
                  {visibleModules.map((module, index) => (
                    <article class="pz-promo-admin__module-card">
                      <span class="pz-promo-admin__module-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                      <div><h3>{t(module.label)}</h3><p>{t(module.description)}</p></div>
                      <a href={modulePath(module)} aria-label={`${adminLocale === 'en' ? 'Open' : 'Abrir'} ${t(module.label)}`}>{t('Abrir módulo')} <span aria-hidden="true">→</span></a>
                    </article>
                  ))}
                </div>
              ) : (
                <div class="pz-promo-admin__empty" role="status">
                  <strong>No hay módulos operativos disponibles.</strong>
                  <p>El acceso de lectura está activo, pero esta sesión no tiene otras acciones efectivas.</p>
                </div>
              )}
            </section>
          </>
        ) : activeModule && section === 'gallery' ? (
          <PromoServiceProductsEditor
            storeSlug={storeSlug}
            canSave={hasPromoAction(accessContext, 'promo.content.manage')}
            canManageMedia={canManagePromoMedia}
          />
        ) : activeModule && cmsScope ? (
          <PromoCmsEditor
            storeSlug={storeSlug}
            scope={cmsScope}
            maxServices={Number.isSafeInteger(maxServices) && maxServices >= 0 ? maxServices : 0}
            canSave={canSaveCms}
            canManageMedia={canManagePromoMedia}
          />
        ) : activeModule && section === 'appearance' ? (
          <PromoAppearanceEditor
            storeSlug={storeSlug}
            storeName={storeName}
            canManageContent={canManageAppearanceContent}
            canSelectTheme={canSelectPromoTheme}
            canManageAppearance={canCustomizePromoAppearance}
          />
        ) : activeModule && section === 'languages' ? (
          <PromoLocalesEditor
            storeSlug={storeSlug}
            maxLocales={Number.isSafeInteger(maxLocales) && maxLocales >= 0 ? maxLocales : 0}
            canManageContent={canManageLocaleContent}
            canManageTranslations={canManagePromoTranslations}
          />
        ) : activeModule && section === 'reviews' ? (
          <PromoReviewsEditor
            storeSlug={storeSlug}
            storeName={storeName}
            publicSlug={publicSlug}
            canModerate={canManagePromoReviews}
            canConfigure={canConfigurePromoReviews}
            canManageMedia={canManagePromoMedia}
          />
        ) : activeModule ? (
          <section class="pz-promo-admin__module-state" aria-labelledby="promo-module-state-title">
            <span class="pz-promo-admin__module-state-icon" aria-hidden="true">✓</span>
            <div>
              <span class="pz-promo-admin__module-state-kicker">Acceso validado</span>
              <h2 id="promo-module-state-title">La navegación de {activeModule.label} está lista</h2>
              <p>{activeModule.delivery}</p>
              <p class="pz-promo-admin__module-state-note">La autorización efectiva de cada cambio continúa validándose en el backend.</p>
              <a href={homePath}>Volver al resumen</a>
            </div>
          </section>
        ) : null}
      </div>
    </div>
  </div>

  <script>
    import {
      normalizePromoAdminLocale,
      observePromoAdminTranslations,
      PROMO_ADMIN_LOCALE_COOKIE,
    } from '../../../lib/promoAdminI18n';

    const root = document.querySelector('[data-promo-admin-root]');
    const adminLocale = normalizePromoAdminLocale(root instanceof HTMLElement ? root.dataset.promoAdminLocale : 'es');
    if (root instanceof HTMLElement) observePromoAdminTranslations(root, adminLocale);
    root?.querySelector<HTMLSelectElement>('[data-promo-admin-locale-select]')?.addEventListener('change', (event) => {
      const selected = normalizePromoAdminLocale(event.currentTarget instanceof HTMLSelectElement ? event.currentTarget.value : 'es');
      document.cookie = `${PROMO_ADMIN_LOCALE_COOKIE}=${selected}; Path=/; Max-Age=31536000; SameSite=Lax`;
      window.location.reload();
    });

    document.addEventListener('toggle', (event) => {
      const opened = event.target instanceof HTMLDetailsElement ? event.target : null;
      const group = opened?.dataset.promoAccordionGroup || '';
      if (!(root instanceof HTMLElement) || !opened?.open || !group || !root.contains(opened)) return;
      root.querySelectorAll<HTMLDetailsElement>('details[data-promo-accordion-group][open]').forEach((candidate) => {
        if (candidate !== opened && candidate.dataset.promoAccordionGroup === group) candidate.open = false;
      });
    }, true);

    const sidebar = root?.querySelector('[data-promo-admin-sidebar]');
    const openButton = root?.querySelector('[data-promo-admin-menu-open]');
    const closeButton = root?.querySelector('[data-promo-admin-menu-close]');
    const backdrop = root?.querySelector('[data-promo-admin-backdrop]');
    const mobileMedia = window.matchMedia('(max-width: 900px)');
    let returnFocus: HTMLElement | null = null;

    function focusableItems(): HTMLElement[] {
      if (!(sidebar instanceof HTMLElement)) return [];
      return Array.from(sidebar.querySelectorAll('a[href], button:not([disabled])'))
        .filter((item): item is HTMLElement => item instanceof HTMLElement && !item.hidden);
    }

    function setMenu(open: boolean) {
      if (!(root instanceof HTMLElement) || !(sidebar instanceof HTMLElement)) return;
      const mobile = mobileMedia.matches;
      const expanded = mobile && open;
      root.classList.toggle('is-nav-open', expanded);
      openButton?.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      sidebar.setAttribute('aria-hidden', mobile && !expanded ? 'true' : 'false');
      if ('inert' in sidebar) sidebar.inert = mobile && !expanded;
      if (backdrop instanceof HTMLButtonElement) backdrop.hidden = !expanded;
      document.documentElement.classList.toggle('pz-promo-admin-nav-open', expanded);
      if (expanded) {
        returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        const first = focusableItems()[0];
        first?.focus();
      } else if (open === false && returnFocus instanceof HTMLElement) {
        returnFocus.focus();
        returnFocus = null;
      }
    }

    openButton?.addEventListener('click', () => setMenu(true));
    closeButton?.addEventListener('click', () => setMenu(false));
    backdrop?.addEventListener('click', () => setMenu(false));
    sidebar?.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (event) => {
      if (!root?.classList.contains('is-nav-open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setMenu(false);
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusableItems();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });

    const onMediaChange = () => setMenu(false);
    mobileMedia.addEventListener?.('change', onMediaChange);
    setMenu(false);

    root?.querySelector('[data-promo-admin-logout]')?.addEventListener('click', () => {
      document.cookie = 'pb_auth=; Path=/; Max-Age=0; SameSite=Lax';
      window.location.assign('/login');
    });
  </script>
</Layout>
