---
import '../../../styles/promo-gallery.css';

interface Props {
  storeSlug: string;
  maxPageMedia: number;
  canSave: boolean;
  canManageMedia: boolean;
}

const {
  storeSlug,
  maxPageMedia,
  canSave,
  canManageMedia,
} = Astro.props;
---

<section
  class="pz-promo-gallery pz-promo-products"
  data-promo-service-products
  data-store-slug={storeSlug}
  data-max-page-media={maxPageMedia}
  data-can-save={canSave ? 'true' : 'false'}
  data-can-manage-media={canManageMedia ? 'true' : 'false'}
  aria-labelledby="promo-products-title"
>
  <header class="pz-promo-gallery__intro">
    <div>
      <span class="pz-promo-gallery__eyebrow">Contenido visual</span>
      <h2 id="promo-products-title">Galería y productos</h2>
      <p>Administra el carrusel, la foto del propietario, cada servicio, sus productos y los trabajos realizados.</p>
    </div>
    <span class="pz-promo-gallery__draft-badge">Cambios pendientes · guardado explícito</span>
  </header>

  <div class="pz-promo-gallery__metrics" aria-label="Uso y límites de imágenes">
    <article><strong data-products-image-count>—</strong><span>Imágenes almacenadas</span><small data-products-image-limit>de 150</small></article>
    <article><strong data-products-page-count>—</strong><span>Imágenes usadas en la página</span><small>de {maxPageMedia}</small></article>
  </div>

  {!canSave && (
    <aside class="pz-promo-gallery__permission" role="note">
      <strong>Contenido visual en modo lectura.</strong>
      <span>La sesión puede consultar, pero no actualizar estos medios.</span>
    </aside>
  )}

  <div class="pz-promo-gallery__alert" data-products-alert role="alert" tabindex="-1" hidden></div>
  <p class="pz-promo-gallery__status" data-products-status role="status" aria-live="polite">Cargando contenido y medios…</p>

  <form class="pz-promo-gallery__form" data-products-form hidden novalidate>
    <details class="pz-promo-gallery__section pz-promo-products__accordion" open>
      <summary>
        <span><span class="pz-promo-gallery__eyebrow">Portada</span><strong>Imagen principal o carrusel</strong></span>
        <span aria-hidden="true">⌄</span>
      </summary>
      <div class="pz-promo-products__body">
        <p>Usa hasta 3 imágenes: una crea una portada fija y dos o tres crean un carrusel accesible.</p>
        <div class="pz-promo-gallery__items" data-products-hero-media></div>
      </div>
    </details>

    <div data-products-owner></div>
    <div data-products-work></div>
    <div data-products-featured></div>
    <div class="pz-promo-gallery__section-list" data-products-services></div>

    <footer class="pz-promo-gallery__savebar">
      <span data-products-version>Versión de página: —</span>
      <button type="submit" data-products-save disabled>Guardar cambios</button>
    </footer>
  </form>
</section>

<script>
  import {
    buildPromoGalleryDocument,
    createPromoGalleryWorkspace,
    normalizePromoGalleryCatalog,
    normalizePromoGalleryDraft,
    promoGalleryErrorMessage,
    promoGalleryPreviewPath,
    PROMO_GALLERY_DRAFT_API_PATH,
    PROMO_GALLERY_MEDIA_API_PATH,
    PROMO_PRODUCT_MAX_MEDIA,
    PROMO_HERO_MAX_MEDIA,
  } from '../../../lib/promoGallery.ts';
  import { PROMO_CMS_WORK_GALLERY_KEY } from '../../../lib/promoCms.ts';
  import { optimizePromoUploadImageFile } from '../../../lib/promoImageOptimizationCore.js';

  type Catalog = ReturnType<typeof normalizePromoGalleryCatalog>;
  type Draft = ReturnType<typeof normalizePromoGalleryDraft>;
  type MediaModel = {
    useKey: string;
    assetId: string;
    alt: string;
    decorative: boolean;
    pendingFile?: File;
    pendingPurpose?: ImagePurpose;
    previewUrl?: string;
  };
  type ImagePurpose = 'hero' | 'gallery' | 'owner';
  type MediaSlotOptions = {
    maximum: number;
    purpose: ImagePurpose;
    label: string;
    slotKey: string;
    decorativeBackground?: boolean;
    onChange?: () => void;
  };
  type ProductModel = {
    key: string; featured: boolean; visible: boolean; name: string; summary: string; caption: string; media: MediaModel[];
  };
  type GalleryModel = {
    key: string; visible: boolean; navigationLabel: string; heading: string; summary: string;
    cover: MediaModel | null; coverIndependent: boolean; items: ProductModel[];
  };
  type ServiceModel = GalleryModel & { serviceKey: string; serviceName: string; serviceSummary: string };

  document.querySelectorAll<HTMLElement>('[data-promo-service-products]').forEach((root) => {
    const storeSlug = root.dataset.storeSlug || '';
    const maxPageMedia = Number(root.dataset.maxPageMedia || 0);
    const canSave = root.dataset.canSave === 'true';
    const canManageMedia = root.dataset.canManageMedia === 'true';
    const form = root.querySelector<HTMLFormElement>('[data-products-form]');
    const servicesElement = root.querySelector<HTMLElement>('[data-products-services]');
    const ownerElement = root.querySelector<HTMLElement>('[data-products-owner]');
    const workElement = root.querySelector<HTMLElement>('[data-products-work]');
    const featuredElement = root.querySelector<HTMLElement>('[data-products-featured]');
    const heroElement = root.querySelector<HTMLElement>('[data-products-hero-media]');
    const statusElement = root.querySelector<HTMLElement>('[data-products-status]');
    const alertElement = root.querySelector<HTMLElement>('[data-products-alert]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-products-save]');
    let draft: Draft | null = null;
    let catalog: Catalog | null = null;
    let locale = 'es';
    let heroMedia: MediaModel[] = [];
    let ownerMedia: MediaModel | null = null;
    let services: ServiceModel[] = [];
    let workGallery: GalleryModel = {
      key: PROMO_CMS_WORK_GALLERY_KEY,
      visible: false,
      navigationLabel: 'Trabajos realizados',
      heading: 'Trabajos realizados',
      summary: '',
      cover: null,
      coverIndependent: false,
      items: [],
    };
    let preservedGalleries: GalleryModel[] = [];
    let dirty = false;
    let busy = false;
    const slotMessages = new Map<string, { tone: 'pending' | 'error'; message: string }>();

    const endpoint = (path: string) => `${path}?store=${encodeURIComponent(storeSlug)}`;
    const text = (value: unknown) => String(value === null || value === undefined ? '' : value);
    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', value = '') => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (value) node.textContent = value;
      return node;
    };

    function newKey(prefix: string, maximum = 64) {
      const suffix = Array.from(crypto.getRandomValues(new Uint8Array(6)), (value) => value.toString(16).padStart(2, '0')).join('');
      return `${prefix}-${suffix}`.slice(0, maximum);
    }

    function setStatus(message: string) {
      if (statusElement) statusElement.textContent = message;
    }

    function showError(error: any) {
      if (!alertElement) return;
      alertElement.textContent = promoGalleryErrorMessage(error?.code || error?.message);
      alertElement.hidden = false;
      alertElement.focus();
    }

    function clearError() {
      if (alertElement) alertElement.hidden = true;
    }

    function markDirty(message = 'Hay cambios sin guardar.') {
      dirty = true;
      if (saveButton) saveButton.disabled = busy || !canSave;
      setStatus(`${message} Guardar actualizará la página pública.`);
    }

    function documentAssetIds(documentValue: any) {
      return new Set<string>(Object.values(documentValue?.media_refs || {})
        .map((reference: any) => text(reference?.asset_id))
        .filter((assetId) => /^[a-z0-9]{15}$/.test(assetId)));
    }

    function allMediaModels() {
      return [
        ...heroMedia,
        ...(ownerMedia ? [ownerMedia] : []),
        ...workGallery.items.flatMap((item) => item.media),
        ...services.flatMap((service) => [
          ...(service.cover ? [service.cover] : []),
          ...service.items.flatMap((item) => item.media),
        ]),
      ];
    }

    function revokePreview(media: MediaModel | null | undefined) {
      if (!media?.previewUrl) return;
      URL.revokeObjectURL(media.previewUrl);
      delete media.previewUrl;
    }

    function revokePendingPreviews() {
      allMediaModels().forEach(revokePreview);
    }

    async function requestJson(url: string, init?: RequestInit) {
      const response = await fetch(url, {
        ...init,
        headers: { Accept: 'application/json', ...(init?.headers || {}) },
        credentials: 'same-origin',
        cache: 'no-store',
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true) {
        const error = new Error(text(result?.error || 'promo_media_unavailable')) as Error & { code?: string };
        error.code = text(result?.error || 'promo_media_unavailable');
        throw error;
      }
      return result;
    }

    function mediaFromDocument(documentValue: any, useKey: string): MediaModel | null {
      const ref = documentValue.media_refs?.[useKey];
      if (!ref?.asset_id) return null;
      const copy = documentValue.content_by_locale?.[locale]?.media_alt?.[useKey] || {};
      return { useKey, assetId: text(ref.asset_id), alt: text(copy.alt), decorative: copy.decorative === true };
    }

    function galleryFromSection(documentValue: any, section: any): GalleryModel {
      const localized = documentValue.content_by_locale?.[locale] || {};
      const content = localized.sections?.[section.key] || {};
      const itemText = new Map((content.items || []).map((item: any) => [item.key, item]));
      const items = (section.config?.items || []).map((item: any) => {
        const copy: any = itemText.get(item.key) || {};
        return {
          key: text(item.key), featured: item.featured === true, visible: item.visible === true,
          name: text(copy.name), summary: text(copy.summary), caption: text(copy.caption),
          media: (item.media_use_keys || []).map((useKey: string) => mediaFromDocument(documentValue, useKey)).filter(Boolean),
        } as ProductModel;
      });
      const itemUseKeys = new Set(items.flatMap((item) => item.media.map((media) => media.useKey)));
      const coverKey = text(section.config?.cover_media_use_key);
      return {
        key: text(section.key), visible: section.visible === true,
        navigationLabel: text(localized.navigation?.[section.key] || content.heading || 'Productos'),
        heading: text(content.heading), summary: text(content.summary),
        cover: coverKey ? mediaFromDocument(documentValue, coverKey) : null,
        coverIndependent: Boolean(coverKey && !itemUseKeys.has(coverKey)),
        items,
      };
    }

    function modelFromDocument(documentValue: any) {
      const localized = documentValue.content_by_locale?.[locale] || {};
      const hero = documentValue.sections.find((section: any) => section.type === 'hero');
      heroMedia = (hero?.media_use_keys || [])
        .map((useKey: string) => mediaFromDocument(documentValue, useKey))
        .filter(Boolean)
        .map((media: MediaModel) => ({ ...media, alt: '', decorative: true }));
      const owner = documentValue.sections.find((section: any) => section.type === 'owner');
      ownerMedia = owner?.config?.media_use_key
        ? mediaFromDocument(documentValue, owner.config.media_use_key)
        : null;
      const gallerySections = documentValue.sections.filter((section: any) => section.type === 'gallery');
      const galleries = new Map(gallerySections.map((section: any) => [section.key, galleryFromSection(documentValue, section)]));
      const servicesSection = documentValue.sections.find((section: any) => section.type === 'services');
      const serviceContent = localized.sections?.[servicesSection?.key] || {};
      const serviceCopy = new Map((serviceContent.items || []).map((item: any) => [item.key, item]));
      workGallery = galleries.get(PROMO_CMS_WORK_GALLERY_KEY) || {
        key: PROMO_CMS_WORK_GALLERY_KEY,
        visible: false,
        navigationLabel: 'Trabajos realizados',
        heading: 'Trabajos realizados',
        summary: '',
        cover: null,
        coverIndependent: false,
        items: [],
      };
      const claimed = new Set<string>([PROMO_CMS_WORK_GALLERY_KEY]);
      const usedKeys = new Set(documentValue.sections.map((section: any) => text(section.key)));
      services = (servicesSection?.config?.item_keys || []).map((serviceKey: string, index: number) => {
        const copy: any = serviceCopy.get(serviceKey) || {};
        const existingKey = text(servicesSection.config.gallery_keys?.[index]);
        let galleryKey = existingKey;
        if (!galleryKey || !galleries.has(galleryKey)) {
          const base = `service-${serviceKey}-products`.slice(0, 64);
          galleryKey = base;
          for (let suffix = 2; usedKeys.has(galleryKey); suffix += 1) {
            const ending = `-${suffix}`;
            galleryKey = `${base.slice(0, 64 - ending.length)}${ending}`;
          }
          usedKeys.add(galleryKey);
        }
        claimed.add(galleryKey);
        const existing = galleries.get(galleryKey) || {
          key: galleryKey, visible: false, navigationLabel: text(copy.name || 'Productos'),
          heading: text(copy.name), summary: text(copy.summary), cover: null, coverIndependent: false, items: [],
        };
        return {
          ...existing,
          serviceKey: text(serviceKey),
          serviceName: text(copy.name || `Servicio ${index + 1}`),
          serviceSummary: text(copy.summary),
        } as ServiceModel;
      });
      preservedGalleries = gallerySections
        .filter((section: any) => !claimed.has(text(section.key)))
        .map((section: any) => galleryFromSection(documentValue, section));
    }

    function assetById(assetId: string) {
      return catalog?.assets.find((asset) => asset.assetId === assetId) || null;
    }

    function preview(media: MediaModel) {
      const frame = element('div', 'pz-promo-gallery__item-preview');
      if (media.previewUrl) {
        const image = document.createElement('img');
        image.src = media.previewUrl;
        image.alt = '';
        frame.append(image);
        return frame;
      }
      const asset = assetById(media.assetId);
      const src = promoGalleryPreviewPath(storeSlug, media.assetId);
      if (!asset || !src) return frame;
      if (asset.kind === 'video') {
        const video = document.createElement('video');
        video.src = src; video.controls = true; video.preload = 'metadata'; frame.append(video);
      } else {
        const image = document.createElement('img');
        image.src = src; image.alt = ''; image.loading = 'lazy'; frame.append(image);
      }
      return frame;
    }

    async function loadCatalog() {
      catalog = normalizePromoGalleryCatalog(await requestJson(endpoint(PROMO_GALLERY_MEDIA_API_PATH)));
    }

    async function uploadAsset(file: File, purpose: ImagePurpose) {
      const payload = new FormData();
      payload.append('file', file); payload.append('purpose', purpose); payload.append('poster_asset_id', '');
      const result = await requestJson(endpoint(PROMO_GALLERY_MEDIA_API_PATH), { method: 'POST', body: payload });
      const assetId = text(result?.asset?.asset_id);
      if (!/^[a-z0-9]{15}$/.test(assetId)) throw Object.assign(new Error('promo_media_unavailable'), { code: 'promo_media_unavailable' });
      return assetId;
    }

    async function prepareImageUpload(file: File, purpose: ImagePurpose) {
      return optimizePromoUploadImageFile(file, purpose) as Promise<File>;
    }


    const IMAGE_ACCEPT = 'image/jpeg,image/png,image/webp,image/avif';
    const IMAGE_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/avif']);
    const IMAGE_GUIDANCE: Record<ImagePurpose, string> = {
      hero: 'JPG, PNG, WebP o AVIF · horizontal 16:9 · ideal 1920×1080 px · mínimo 640×320 px',
      gallery: 'JPG, PNG, WebP o AVIF · horizontal 4:3 · ideal 1200×900 px · mínimo 320×240 px',
      owner: 'JPG, PNG, WebP o AVIF · vertical 4:5 · ideal 800×1000 px · mínimo 320×400 px',
    };
    const IMAGE_MINIMUMS: Record<ImagePurpose, { width: number; height: number }> = {
      hero: { width: 640, height: 320 },
      gallery: { width: 320, height: 240 },
      owner: { width: 320, height: 400 },
    };
    const SLOT_REORDER_TYPE = 'text/x-promo-media-index';

    const mediaError = (code: string) => Object.assign(new Error(code), { code });

    async function validateImageSource(file: File, purpose: ImagePurpose) {
      if (!IMAGE_TYPES.has(file.type)) throw mediaError('promo_media_type_invalid');
      let bitmap: ImageBitmap;
      try {
        bitmap = await window.createImageBitmap(file);
      } catch {
        throw mediaError('promo_media_type_mismatch');
      }
      try {
        const minimum = IMAGE_MINIMUMS[purpose];
        if (bitmap.width < minimum.width || bitmap.height < minimum.height
          || bitmap.width > 6000 || bitmap.height > 6000
          || bitmap.width * bitmap.height > 36_000_000) {
          throw mediaError('promo_media_dimensions_invalid');
        }
      } finally {
        bitmap.close();
      }
    }

    function slotChanged(options: MediaSlotOptions, message = 'Medios actualizados.') {
      options.onChange?.();
      markDirty(message);
      render();
    }

    async function setImageAt(
      file: File | undefined,
      target: MediaModel[],
      index: number,
      options: MediaSlotOptions,
    ) {
      if (!file || !canManageMedia || !canSave || busy || index > target.length || index >= options.maximum) return;
      const stateKey = `${options.slotKey}:${index}`;
      clearError();
      slotMessages.set(stateKey, { tone: 'pending', message: 'Optimizando localmente…' });
      busy = true;
      render();
      setStatus('Validando y optimizando imagen en este dispositivo…');
      try {
        await validateImageSource(file, options.purpose);
        const preparedFile = await prepareImageUpload(file, options.purpose);
        const previous = target[index];
        const media = {
          useKey: previous?.useKey || newKey(`${options.purpose}-media`, 120),
          assetId: '',
          alt: options.decorativeBackground === true ? '' : (previous?.alt || `Imagen de ${options.label}`),
          decorative: options.decorativeBackground === true,
          pendingFile: preparedFile,
          pendingPurpose: options.purpose,
          previewUrl: URL.createObjectURL(preparedFile),
        };
        if (index < target.length) {
          revokePreview(previous);
          target[index] = media;
        }
        else target.push(media);
        options.onChange?.();
        slotMessages.set(stateKey, { tone: 'pending', message: 'Lista para guardar.' });
        markDirty('Imagen preparada localmente.');
      } catch (error) {
        slotMessages.set(stateKey, { tone: 'error', message: promoGalleryErrorMessage((error as any)?.code || (error as any)?.message) });
        showError(error);
        setStatus('No se pudo preparar la imagen. Revisa formato y dimensiones.');
      } finally {
        busy = false;
        render();
      }
    }

    function renderMediaSlots(target: MediaModel[], options: MediaSlotOptions) {
      const decorativeBackground = options.decorativeBackground === true;
      const wrapper = element('section', 'pz-promo-media-slots');
      const header = element('header', 'pz-promo-media-slots__header');
      header.append(
        element('strong', '', `${options.label}`),
        element('span', '', `${Math.min(target.length, options.maximum)} de ${options.maximum} utilizados`),
      );
      const grid = element('div', 'pz-promo-media-slots__grid');

      for (let index = 0; index < options.maximum; index += 1) {
        const media = target[index];
        const asset = media ? assetById(media.assetId) : null;
        const stateKey = `${options.slotKey}:${index}`;
        const slotMessage = slotMessages.get(stateKey);
        const slot = element('article', `pz-promo-media-slot${media ? ' is-filled' : ' is-empty'}`);
        slot.classList.toggle('is-error', slotMessage?.tone === 'error');
        slot.classList.toggle('is-pending', Boolean(media?.pendingFile));
        slot.dataset.purpose = options.purpose;
        slot.dataset.mediaSlot = String(index);
        slot.draggable = Boolean(media && canSave && !busy && !decorativeBackground);

        const slotHeading = element('div', 'pz-promo-media-slot__heading');
        slotHeading.append(
          element('strong', '', `Espacio ${index + 1}`),
          element('span', '', slotMessage?.tone === 'error'
            ? 'Error'
            : (media?.pendingFile ? 'Pendiente' : (media ? 'Guardada' : 'Disponible'))),
        );
        slot.append(slotHeading);

        const imageInput = document.createElement('input');
        imageInput.type = 'file';
        imageInput.accept = IMAGE_ACCEPT;
        imageInput.className = 'pz-promo-media-slot__input';
        imageInput.disabled = busy || !canManageMedia || !canSave;
        imageInput.setAttribute('aria-label', `${media ? 'Cambiar' : 'Agregar'} imagen en ${options.label}, espacio ${index + 1}`);
        imageInput.addEventListener('change', () => setImageAt(imageInput.files?.[0], target, index, options));

        if (media) {
          slot.append(preview(media));
          if (!decorativeBackground) {
            const accessibility = element('div', 'pz-promo-media-slot__accessibility');
            const altLabel = element('label', 'pz-promo-gallery__field', asset?.kind === 'video' ? 'Descripción accesible del video' : 'Texto alternativo');
            const alt = document.createElement('input');
            alt.type = 'text'; alt.maxLength = 300; alt.value = media.alt; alt.required = !media.decorative; alt.disabled = !canSave;
            alt.addEventListener('input', () => { media.alt = alt.value; markDirty(); });
            altLabel.append(alt);
            const decorative = document.createElement('input');
            decorative.type = 'checkbox'; decorative.checked = media.decorative; decorative.disabled = !canSave;
            decorative.addEventListener('change', () => {
              media.decorative = decorative.checked;
              if (media.decorative) { media.alt = ''; alt.value = ''; }
              alt.required = !media.decorative;
              markDirty();
            });
            const decorativeLabel = element('label', 'pz-promo-gallery__check');
            decorativeLabel.append(decorative, element('span', '', 'Imagen decorativa'));
            accessibility.append(altLabel, decorativeLabel);
            slot.append(accessibility);
          }
        } else {
          const empty = element('div', 'pz-promo-media-slot__empty');
          empty.append(
            element('strong', '', 'Arrastra una imagen aquí'),
            element('span', '', 'o selecciónala desde tu dispositivo'),
          );
          slot.append(empty);
        }

        const actions = element('div', 'pz-promo-media-slot__actions');
        const choose = element('button', 'pz-promo-gallery__secondary', media ? 'Cambiar imagen' : 'Elegir imagen');
        choose.type = 'button'; choose.disabled = busy || !canManageMedia || !canSave;
        choose.addEventListener('click', () => imageInput.click());
        actions.append(choose, imageInput);

        if (media) {
          if (!decorativeBackground) {
            const up = element('button', 'pz-promo-gallery__secondary', '↑');
            up.type = 'button'; up.disabled = !canSave || busy || index === 0; up.ariaLabel = `Mover ${options.label} a la izquierda`;
            up.addEventListener('click', () => {
              [target[index - 1], target[index]] = [target[index], target[index - 1]];
              slotChanged(options, 'Orden actualizado.');
            });
            const down = element('button', 'pz-promo-gallery__secondary', '↓');
            down.type = 'button'; down.disabled = !canSave || busy || index === target.length - 1; down.ariaLabel = `Mover ${options.label} a la derecha`;
            down.addEventListener('click', () => {
              [target[index + 1], target[index]] = [target[index], target[index + 1]];
              slotChanged(options, 'Orden actualizado.');
            });
            actions.append(up, down);
          }
          const remove = element('button', 'is-danger', 'Quitar');
          remove.type = 'button'; remove.disabled = !canSave || !canManageMedia || busy;
          remove.addEventListener('click', () => {
            revokePreview(target[index]);
            target.splice(index, 1);
            Array.from(slotMessages.keys()).filter((key) => key.startsWith(`${options.slotKey}:`))
              .forEach((key) => slotMessages.delete(key));
            slotChanged(options);
          });
          actions.append(remove);
        }
        slot.append(actions);

        slot.append(element(
          'small',
          `pz-promo-media-slot__guidance${slotMessage?.tone === 'error' ? ' is-error' : ''}`,
          slotMessage?.message || `${IMAGE_GUIDANCE[options.purpose]} · WebP optimizado, comprimido y sin metadatos al guardar`,
        ));

        slot.addEventListener('dragstart', (event) => {
          if (decorativeBackground || !media || !event.dataTransfer) return;
          event.dataTransfer.effectAllowed = 'move';
          event.dataTransfer.setData(SLOT_REORDER_TYPE, String(index));
        });
        slot.addEventListener('dragover', (event) => {
          if (busy || !canSave) return;
          const types = Array.from(event.dataTransfer?.types || []);
          if (types.includes('Files') && !canManageMedia) return;
          if (!types.includes('Files') && (decorativeBackground || !types.includes(SLOT_REORDER_TYPE))) return;
          event.preventDefault();
          slot.classList.add('is-dragover');
        });
        slot.addEventListener('dragleave', () => slot.classList.remove('is-dragover'));
        slot.addEventListener('drop', (event) => {
          slot.classList.remove('is-dragover');
          if (busy || !event.dataTransfer) return;
          const source = event.dataTransfer.getData(SLOT_REORDER_TYPE);
          if (source !== '') {
            event.preventDefault();
            if (decorativeBackground) return;
            const from = Number(source);
            if (!canSave || !Number.isInteger(from) || from < 0 || from >= target.length || from === index) return;
            if (index < target.length) [target[from], target[index]] = [target[index], target[from]];
            else target.push(target.splice(from, 1)[0]);
            slotChanged(options, 'Orden actualizado.');
            return;
          }
          const file = event.dataTransfer.files?.[0];
          if (!file) return;
          event.preventDefault();
          setImageAt(file, target, index, options);
        });

        grid.append(slot);
      }

      wrapper.append(header, grid);
      return wrapper;
    }
    function renderProduct(service: ServiceModel, product: ProductModel, index: number) {
      const card = element('article', 'pz-promo-gallery__work pz-promo-products__product');
      const header = element('header');
      const heading = element('strong', '', product.name || `Producto ${index + 1}`);
      const flags = element('div', 'pz-promo-gallery__flags');
      const visible = document.createElement('input'); visible.type = 'checkbox'; visible.checked = product.visible; visible.disabled = !canSave;
      const visibleLabel = element('label', 'pz-promo-gallery__check'); visibleLabel.append(visible, element('span', '', 'Visible'));
      visible.addEventListener('change', () => { product.visible = visible.checked; if (!product.visible) product.featured = false; markDirty(); render(); });
      flags.append(visibleLabel); header.append(heading, flags); card.append(header);
      const fields = element('div', 'pz-promo-gallery__section-fields');
      const name = document.createElement('input'); name.type = 'text'; name.maxLength = 160; name.value = product.name; name.required = product.visible; name.disabled = !canSave;
      const summary = document.createElement('textarea'); summary.maxLength = 600; summary.rows = 3; summary.value = product.summary; summary.disabled = !canSave;
      const caption = document.createElement('input'); caption.type = 'text'; caption.maxLength = 500; caption.value = product.caption; caption.disabled = !canSave;
      name.addEventListener('input', () => { product.name = name.value; heading.textContent = name.value || `Producto ${index + 1}`; markDirty(); });
      summary.addEventListener('input', () => { product.summary = summary.value; markDirty(); });
      caption.addEventListener('input', () => { product.caption = caption.value; markDirty(); });
      const field = (label: string, control: HTMLElement, wide = false) => {
        const wrapper = element('label', `pz-promo-gallery__field${wide ? ' is-wide' : ''}`, label); wrapper.append(control); return wrapper;
      };
      fields.append(field('Nombre del producto o trabajo', name), field('Descripción', summary), field('Nota opcional', caption, true));
      card.append(fields);
      card.append(renderMediaSlots(product.media, {
        maximum: PROMO_PRODUCT_MAX_MEDIA,
        purpose: 'gallery',
        label: product.name || `Producto ${index + 1}`,
        slotKey: `product-${service.key}-${product.key}`,
        onChange: () => {
          if (!product.media.length) { product.visible = false; product.featured = false; }
        },
      }));
      const actions = element('div', 'pz-promo-gallery__work-actions');
      actions.append(element('span', 'pz-promo-products__quote-note', 'El botón «Cotizar» se añade automáticamente con el contacto principal.'));
      const remove = element('button', 'is-danger', 'Eliminar producto'); remove.type = 'button'; remove.disabled = !canSave;
      remove.addEventListener('click', () => {
        product.media.forEach(revokePreview);
        service.items.splice(index, 1);
        markDirty();
        render();
      });
      actions.append(remove); card.append(actions);
      return card;
    }

    function renderOwnerSection() {
      const details = element('details', 'pz-promo-gallery__section pz-promo-products__accordion') as HTMLDetailsElement;
      const summary = element('summary');
      const title = element('span');
      title.append(element('span', 'pz-promo-gallery__eyebrow', 'Propietario'), element('strong', '', 'Foto del dueño del negocio'));
      summary.append(title, element('span', '', '⌄')); details.append(summary);
      const body = element('div', 'pz-promo-products__body');
      body.append(element('p', '', 'Esta foto acompaña la presentación del propietario en la página pública.'));
      const holder: MediaModel[] = ownerMedia ? [ownerMedia] : [];
      body.append(renderMediaSlots(holder, {
        maximum: 1,
        purpose: 'owner',
        label: 'Foto del propietario',
        slotKey: 'owner',
        onChange: () => { ownerMedia = holder[0] || null; },
      }));
      details.append(body);
      return details;
    }

    function renderWorkItem(workItem: ProductModel, index: number) {
      const card = element('article', 'pz-promo-gallery__work pz-promo-products__product');
      const header = element('header');
      const heading = element('strong', '', workItem.name || `Trabajo ${index + 1}`);
      const flags = element('div', 'pz-promo-gallery__flags');
      const visible = document.createElement('input');
      visible.type = 'checkbox'; visible.checked = workItem.visible; visible.disabled = !canSave || workItem.media.length === 0;
      const visibleLabel = element('label', 'pz-promo-gallery__check');
      visibleLabel.append(visible, element('span', '', 'Visible'));
      visible.addEventListener('change', () => { workItem.visible = visible.checked; if (!workItem.visible) workItem.featured = false; markDirty(); render(); });
      flags.append(visibleLabel); header.append(heading, flags); card.append(header);

      const fields = element('div', 'pz-promo-gallery__section-fields');
      const name = document.createElement('input'); name.type = 'text'; name.maxLength = 160; name.value = workItem.name; name.disabled = !canSave;
      const description = document.createElement('textarea'); description.maxLength = 600; description.rows = 3; description.value = workItem.summary; description.disabled = !canSave;
      const caption = document.createElement('input'); caption.type = 'text'; caption.maxLength = 500; caption.value = workItem.caption; caption.disabled = !canSave;
      name.addEventListener('input', () => { workItem.name = name.value; heading.textContent = name.value || `Trabajo ${index + 1}`; markDirty(); });
      description.addEventListener('input', () => { workItem.summary = description.value; markDirty(); });
      caption.addEventListener('input', () => { workItem.caption = caption.value; markDirty(); });
      const field = (label: string, control: HTMLElement, wide = false) => {
        const wrapper = element('label', `pz-promo-gallery__field${wide ? ' is-wide' : ''}`, label);
        wrapper.append(control); return wrapper;
      };
      fields.append(field('Título del trabajo', name), field('Descripción', description), field('Nota opcional', caption, true));
      card.append(fields);

      card.append(renderMediaSlots(workItem.media, {
        maximum: PROMO_PRODUCT_MAX_MEDIA,
        purpose: 'gallery',
        label: workItem.name || `Trabajo ${index + 1}`,
        slotKey: `work-${workItem.key}`,
        onChange: () => {
          if (!workItem.media.length) { workItem.visible = false; workItem.featured = false; }
        },
      }));
      const actions = element('div', 'pz-promo-gallery__work-actions');
      actions.append(element('span', 'pz-promo-products__quote-note', 'Puede incluir hasta 3 fotos. Los destacados se administran en la sección independiente.'));
      const remove = element('button', 'is-danger', 'Eliminar trabajo'); remove.type = 'button'; remove.disabled = !canSave;
      remove.addEventListener('click', () => {
        workItem.media.forEach(revokePreview);
        workGallery.items.splice(index, 1);
        markDirty();
        render();
      });
      actions.append(remove); card.append(actions);
      return card;
    }

    function renderWorkSection() {
      const details = element('details', 'pz-promo-gallery__section pz-promo-products__accordion') as HTMLDetailsElement;
      const summary = element('summary');
      const title = element('span');
      title.append(element('span', 'pz-promo-gallery__eyebrow', 'Portafolio'), element('strong', '', `Trabajos realizados (${workGallery.items.length})`));
      summary.append(title, element('span', '', '⌄')); details.append(summary);
      const body = element('div', 'pz-promo-products__body');
      body.append(element('p', '', 'Publica fotos del resultado mientras realizas un trabajo. Cada trabajo admite hasta 3 fotos.'));
      const header = element('div', 'pz-promo-products__products-header');
      header.append(element('div', '', ''), element('strong', '', 'Trabajos'));
      const add = element('button', 'pz-promo-gallery__secondary', '+ Añadir trabajo');
      add.type = 'button'; add.disabled = !canSave || busy;
      add.addEventListener('click', () => {
        workGallery.items.push({ key: newKey('work'), featured: false, visible: false, name: '', summary: '', caption: '', media: [] });
        markDirty(); render();
      });
      header.append(add); body.append(header);
      const items = element('div', 'pz-promo-gallery__works');
      workGallery.items.forEach((item, index) => items.append(renderWorkItem(item, index)));
      if (!workGallery.items.length) items.append(element('p', 'pz-promo-gallery__empty', 'Todavía no hay trabajos realizados.'));
      body.append(items); details.append(body);
      return details;
    }

    function renderFeaturedSection() {
      const details = element('details', 'pz-promo-gallery__section pz-promo-products__accordion') as HTMLDetailsElement;
      const candidates = [
        ...workGallery.items.map((item, index) => ({ item, source: 'Trabajos realizados', fallback: `Trabajo ${index + 1}` })),
        ...services.flatMap((service) => service.items.map((item, index) => ({
          item,
          source: service.serviceName,
          fallback: `Producto ${index + 1}`,
        }))),
      ];
      const selectedCount = candidates.filter(({ item }) => item.featured).length;
      const summary = element('summary');
      const title = element('span');
      title.append(
        element('span', 'pz-promo-gallery__eyebrow', 'Selección pública'),
        element('strong', '', `Trabajos destacados (${selectedCount})`),
      );
      summary.append(title, element('span', '', '⌄')); details.append(summary);
      const body = element('div', 'pz-promo-products__body');
      body.append(element('p', '', 'Selecciona aquí los productos o trabajos existentes que aparecerán en la sección Trabajos destacados.'));
      const list = element('div', 'pz-promo-products__featured-list');
      candidates.forEach(({ item, source, fallback }) => {
        const option = element('label', 'pz-promo-products__featured-option');
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = item.featured;
        checkbox.disabled = !canSave || busy || (!item.featured && item.media.length === 0);
        checkbox.addEventListener('change', () => {
          item.featured = checkbox.checked;
          if (item.featured) item.visible = true;
          markDirty();
          render();
        });
        const copy = element('span');
        copy.append(
          element('strong', '', item.name || fallback),
          element('small', '', item.media.length
            ? `${source} · ${item.media.length} ${item.media.length === 1 ? 'foto' : 'fotos'}`
            : `${source} · agrega una foto antes de destacarlo`),
        );
        option.append(checkbox, copy); list.append(option);
      });
      if (!candidates.length) list.append(element('p', 'pz-promo-gallery__empty', 'Primero crea un producto o un trabajo realizado.'));
      body.append(list); details.append(body);
      return details;
    }

    function renderService(service: ServiceModel, index: number) {
      const details = element('details', 'pz-promo-gallery__section pz-promo-products__accordion') as HTMLDetailsElement;
      if (index === 0) details.open = true;
      const summary = element('summary');
      const title = element('span'); title.append(element('span', 'pz-promo-gallery__eyebrow', `Servicio ${index + 1}`), element('strong', '', service.serviceName));
      summary.append(title, element('span', '', '⌄')); details.append(summary);
      const body = element('div', 'pz-promo-products__body');
      if (service.serviceSummary) body.append(element('p', '', service.serviceSummary));
      const cover = element('section', 'pz-promo-products__cover');
      cover.append(element('h4', '', 'Foto de portada del servicio'));
      const holder: MediaModel[] = service.cover ? [service.cover] : [];
      cover.append(renderMediaSlots(holder, {
        maximum: 1,
        purpose: 'gallery',
        label: `Portada de ${service.serviceName}`,
        slotKey: `service-${service.serviceKey}`,
        onChange: () => {
          service.cover = holder[0] || null;
          service.coverIndependent = Boolean(service.cover);
        },
      }));
      body.append(cover);
      const productsHeader = element('div', 'pz-promo-products__products-header');
      productsHeader.append(element('div', '', ''), element('strong', '', `Productos o trabajos (${service.items.length})`));
      const add = element('button', 'pz-promo-gallery__secondary', '+ Añadir producto'); add.type = 'button'; add.disabled = !canSave;
      add.addEventListener('click', () => {
        service.items.push({ key: newKey('product'), featured: false, visible: true, name: '', summary: '', caption: '', media: [] });
        markDirty(); render();
      });
      productsHeader.append(add); body.append(productsHeader);
      const products = element('div', 'pz-promo-gallery__works');
      service.items.forEach((product, productIndex) => products.append(renderProduct(service, product, productIndex)));
      if (!service.items.length) products.append(element('p', 'pz-promo-gallery__empty', 'Este servicio todavía no tiene productos o trabajos.'));
      body.append(products); details.append(body);
      return details;
    }

    function pageMediaCount() {
      return heroMedia.length
        + (ownerMedia ? 1 : 0)
        + workGallery.items.reduce((total, item) => total + item.media.length, 0)
        + services.reduce((total, service) => (
          total + (service.cover?.useKey && service.coverIndependent ? 1 : 0)
          + service.items.reduce((sum, item) => sum + item.media.length, 0)
        ), 0);
    }

    function renderMetrics() {
      const images = root.querySelector<HTMLElement>('[data-products-image-count]');
      const imageLimit = root.querySelector<HTMLElement>('[data-products-image-limit]');
      const page = root.querySelector<HTMLElement>('[data-products-page-count]');
      if (images) images.textContent = String(catalog?.usage.images || 0);
      if (imageLimit) imageLimit.textContent = `de ${catalog?.limits.maxStoredImages || 150}`;
      if (page) page.textContent = String(pageMediaCount());
    }

    function render() {
      if (heroElement) {
        heroElement.replaceChildren(renderMediaSlots(heroMedia, {
          maximum: PROMO_HERO_MAX_MEDIA,
          purpose: 'hero',
          label: 'Imágenes de portada',
          slotKey: 'hero',
          decorativeBackground: true,
        }));
      }
      if (ownerElement) ownerElement.replaceChildren(renderOwnerSection());
      if (workElement) workElement.replaceChildren(renderWorkSection());
      if (featuredElement) featuredElement.replaceChildren(renderFeaturedSection());
      if (servicesElement) {
        servicesElement.replaceChildren();
        services.forEach((service, index) => servicesElement.append(renderService(service, index)));
        if (!services.length) servicesElement.append(element('p', 'pz-promo-gallery__empty', 'Primero crea y guarda un servicio en la sección superior de Contenido.'));
      }
      renderMetrics();
      const version = root.querySelector<HTMLElement>('[data-products-version]');
      if (version) version.textContent = `Versión de página: ${draft?.version || '—'}`;
      if (saveButton) saveButton.disabled = busy || !canSave || !dirty;
      root.setAttribute('aria-busy', busy ? 'true' : 'false');
    }

    function galleryPatch(gallery: GalleryModel, forceVisible?: boolean) {
      const complete = Boolean(gallery.cover) && gallery.items.every((item) => !item.visible || item.media.length > 0);
      const requestedVisible = forceVisible === undefined ? gallery.visible : forceVisible;
      const common = {
        key: gallery.key,
        visible: requestedVisible && complete,
        navigationLabel: gallery.navigationLabel || gallery.heading || 'Productos',
        heading: gallery.heading || gallery.navigationLabel || 'Productos',
        summary: gallery.summary,
        coverUseKey: gallery.cover?.useKey || '',
        items: gallery.items,
      };
      return gallery.cover?.useKey && gallery.coverIndependent
        ? { ...common, coverMedia: gallery.cover }
        : common;
    }

    async function deleteUnreferencedAssets(assetIds: Iterable<string>) {
      let failures = 0;
      for (const assetId of new Set(assetIds)) {
        if (!/^[a-z0-9]{15}$/.test(assetId)) continue;
        try {
          await requestJson(endpoint('/api/admin/promo-media-delete'), {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ asset_id: assetId }),
          });
        } catch (_) {
          failures += 1;
        }
      }
      return failures;
    }

    async function uploadPendingImages(state: { pending: MediaModel[]; createdAssetIds: Set<string> }) {
      const { pending, createdAssetIds } = state;
      const knownAssetIds = new Set(catalog?.assets.map((asset) => asset.assetId) || []);
      for (const media of pending) {
        const assetId = await uploadAsset(media.pendingFile!, media.pendingPurpose!);
        media.assetId = assetId;
        if (!knownAssetIds.has(assetId)) createdAssetIds.add(assetId);
      }
      if (pending.length) await loadCatalog();
    }

    async function loadAll() {
      clearError(); busy = true; render(); setStatus('Cargando contenido y medios…');
      try {
        const [draftResult] = await Promise.all([
          requestJson(endpoint(PROMO_GALLERY_DRAFT_API_PATH)),
          loadCatalog(),
        ]);
        draft = normalizePromoGalleryDraft(draftResult);
        const workspace = createPromoGalleryWorkspace(draft.document);
        draft = { version: draft.version, document: workspace.document };
        locale = workspace.locale;
        revokePendingPreviews();
        modelFromDocument(workspace.document);
        dirty = false;
        if (form) form.hidden = false;
        setStatus('Contenido visual cargado. Los cambios se aplicarán al guardar.');
      } catch (error) { showError(error); setStatus('No se pudo cargar el contenido visual.'); }
      finally { busy = false; render(); }
    }


    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!draft || !catalog || !canSave || busy || !form.reportValidity()) return;
      clearError(); busy = true; render(); setStatus('Optimizando medios y validando el guardado seguro…');
      const previousAssetIds = documentAssetIds(draft.document);
      const pendingUpload = {
        pending: allMediaModels().filter((media) => media.pendingFile && media.pendingPurpose),
        createdAssetIds: new Set<string>(),
      };
      try {
        await uploadPendingImages(pendingUpload);
        const linkedGalleries = services.map((service) => galleryPatch({
          ...service,
          visible: true,
          navigationLabel: service.serviceName || 'Productos',
          heading: service.serviceName || 'Productos',
          summary: service.serviceSummary,
        }, true));
        const firstWorkMedia = workGallery.items.flatMap((item) => item.media)[0] || null;
        const work = galleryPatch({
          ...workGallery,
          visible: workGallery.items.some((item) => item.visible && item.media.length > 0),
          navigationLabel: workGallery.navigationLabel || 'Trabajos realizados',
          heading: workGallery.heading || 'Trabajos realizados',
          cover: firstWorkMedia,
          coverIndependent: false,
        });
        const preserved = preservedGalleries.map((gallery) => galleryPatch(gallery));
        const nextDocument = buildPromoGalleryDocument(
          draft.document,
          { heroMedia, ownerMedia, galleries: [...linkedGalleries, work, ...preserved] },
          maxPageMedia,
          catalog.assets,
        );
        const serviceSection = nextDocument.sections.find((section: any) => section.type === 'services');
        if (!serviceSection || serviceSection.config.item_keys.length !== services.length
          || serviceSection.config.item_keys.some((key: string, index: number) => key !== services[index].serviceKey)) {
          throw Object.assign(new Error('promo_conflict'), { code: 'promo_conflict' });
        }
        serviceSection.config.gallery_keys = services.map((service, index) => (
          linkedGalleries[index]?.visible ? service.key : ''
        ));
        const internalProductSectionKeys = new Set(services.map((service) => service.key));
        nextDocument.sections.filter((section: any) => section.type === 'footer').forEach((section: any) => {
          section.config.navigation_section_keys = (section.config.navigation_section_keys || [])
            .filter((sectionKey: string) => !internalProductSectionKeys.has(sectionKey));
        });
        const result = await requestJson(endpoint(PROMO_GALLERY_DRAFT_API_PATH), {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ expected_version: draft.version, document: nextDocument }),
        });
        draft = normalizePromoGalleryDraft({ ok: result.ok, contract: result.contract, draft: result.draft });
        const workspace = createPromoGalleryWorkspace(draft.document);
        draft = { version: draft.version, document: workspace.document };
        const currentAssetIds = documentAssetIds(workspace.document);
        const replacedAssetIds = Array.from(previousAssetIds).filter((assetId) => !currentAssetIds.has(assetId));
        const cleanupFailures = canManageMedia ? await deleteUnreferencedAssets(replacedAssetIds) : replacedAssetIds.length;
        revokePendingPreviews();
        locale = workspace.locale;
        modelFromDocument(workspace.document);
        slotMessages.clear();
        dirty = false;
        setStatus(cleanupFailures
          ? `Contenido visual actualizado · versión ${draft.version}. ${cleanupFailures} archivo(s) reemplazado(s) quedaron protegidos porque aún no pudieron eliminarse.`
          : `Contenido visual actualizado · versión ${draft.version}.`);
        window.dispatchEvent(new CustomEvent('promo:document-updated', { detail: { source: 'products' } }));
      } catch (error) {
        if (pendingUpload.pending.length) {
          pendingUpload.pending.forEach((media) => { media.assetId = ''; });
          await deleteUnreferencedAssets(pendingUpload.createdAssetIds);
          await loadCatalog().catch(() => undefined);
        }
        showError(error);
        setStatus('No se guardaron cambios en la página pública. Las imágenes continúan pendientes para reintentar.');
      }
      finally { busy = false; render(); }
    });

    window.addEventListener('promo:document-updated', (event: Event) => {
      const source = (event as CustomEvent)?.detail?.source;
      if (source === 'cms' && !dirty) loadAll();
    });

    window.addEventListener('beforeunload', (event) => {
      if (!dirty) return;
      event.preventDefault();
    });

    window.addEventListener('pagehide', () => revokePendingPreviews(), { once: true });

    loadAll();
  });
</script>
