    function renderFeaturedSection() {
      const details = element('details', 'pz-promo-gallery__section pz-promo-products__accordion') as HTMLDetailsElement;
      const candidates = [
        ...workGallery.items.map((item, index) => ({ item, source: 'Trabajos realizados', fallback: `Trabajo ${index + 1}` })),
        ...services.flatMap((service) => service.items.map((item, index) => ({
          item,
          source: service.serviceName,
          fallback: `Producto ${index + 1}`,
        }))),
      ];
      const selectedCount = candidates.filter(({ item }) => item.featured).length;
      const summary = element('summary');
      const title = element('span');
      title.append(
        element('span', 'pz-promo-gallery__eyebrow', 'Selección pública'),
        element('strong', '', `Trabajos destacados (${selectedCount})`),
      );
      summary.append(title, element('span', '', '⌄')); details.append(summary);
      const body = element('div', 'pz-promo-products__body');
      body.append(element('p', '', 'Selecciona aquí los productos o trabajos existentes que aparecerán en la sección Trabajos destacados.'));
      const list = element('div', 'pz-promo-products__featured-list');
      candidates.forEach(({ item, source, fallback }) => {
        const option = element('label', 'pz-promo-products__featured-option');
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = item.featured;
        checkbox.disabled = !canSave || busy || (!item.featured && item.media.length === 0);
        checkbox.addEventListener('change', () => {
          item.featured = checkbox.checked;
          if (item.featured) item.visible = true;
          markDirty();
          render();
