---
import '../../../styles/promo-gallery.css';

interface Props {
  storeSlug: string;
  maxPageMedia: number;
  maxVideos: number;
  canSave: boolean;
  canManageMedia: boolean;
  canManageVideo: boolean;
}

const {
  storeSlug,
  maxPageMedia,
  maxVideos,
  canSave,
  canManageMedia,
  canManageVideo,
} = Astro.props;
const effectiveMaxVideos = Number.isSafeInteger(maxVideos) ? Math.min(3, Math.max(0, maxVideos)) : 0;
---

<section
  class="pz-promo-gallery pz-promo-products"
  data-promo-service-products
  data-store-slug={storeSlug}
  data-max-page-media={maxPageMedia}
  data-max-videos={effectiveMaxVideos}
  data-can-save={canSave ? 'true' : 'false'}
  data-can-manage-media={canManageMedia ? 'true' : 'false'}
  data-can-manage-video={canManageVideo ? 'true' : 'false'}
  aria-labelledby="promo-products-title"
>
  <header class="pz-promo-gallery__intro">
    <div>
      <span class="pz-promo-gallery__eyebrow">Contenido visual</span>
      <h2 id="promo-products-title">Galería y productos</h2>
      <p>Administra el carrusel, la foto del propietario, cada servicio, sus productos y los trabajos realizados.</p>
    </div>
    <span class="pz-promo-gallery__draft-badge">Guardado directo · página pública</span>
  </header>

  <div class="pz-promo-gallery__metrics" aria-label="Uso y límites de medios">
    <article><strong data-products-image-count>—</strong><span>Imágenes almacenadas</span><small data-products-image-limit>de 150</small></article>
    <article><strong data-products-video-count>—</strong><span>Videos almacenados</span><small data-products-video-limit>de {effectiveMaxVideos}</small></article>
    <article><strong data-products-page-count>—</strong><span>Medios usados en la página</span><small>de {maxPageMedia}</small></article>
  </div>

  {!canSave && (
    <aside class="pz-promo-gallery__permission" role="note">
      <strong>Contenido visual en modo lectura.</strong>
      <span>La sesión puede consultar, pero no actualizar estos medios.</span>
    </aside>
  )}

  <div class="pz-promo-gallery__alert" data-products-alert role="alert" tabindex="-1" hidden></div>
  <p class="pz-promo-gallery__status" data-products-status role="status" aria-live="polite">Cargando contenido y medios…</p>

  <form class="pz-promo-gallery__form" data-products-form hidden novalidate>
    <details class="pz-promo-gallery__section pz-promo-products__accordion" open>
      <summary>
        <span><span class="pz-promo-gallery__eyebrow">Portada</span><strong>Imagen principal o carrusel</strong></span>
        <span aria-hidden="true">⌄</span>
      </summary>
      <div class="pz-promo-products__body">
        <p>Usa hasta 3 imágenes: una crea una portada fija y dos o tres crean un carrusel accesible.</p>
        <div class="pz-promo-gallery__items" data-products-hero-media></div>
      </div>
    </details>

    <div data-products-owner></div>
    <div data-products-work></div>
    <div data-products-featured></div>
    <div class="pz-promo-gallery__section-list" data-products-services></div>

    <footer class="pz-promo-gallery__savebar">
      <span data-products-version>Versión de página: —</span>
      <button type="submit" data-products-save disabled>Guardar contenido visual</button>
    </footer>
  </form>
</section>

<script>
  import {
    buildPromoGalleryDocument,
    createPromoGalleryWorkspace,
    normalizePromoGalleryCatalog,
    normalizePromoGalleryDraft,
    promoGalleryErrorMessage,
    promoGalleryPreviewPath,
    PROMO_GALLERY_DRAFT_API_PATH,
    PROMO_GALLERY_MEDIA_API_PATH,
    PROMO_PRODUCT_MAX_MEDIA,
    PROMO_HERO_MAX_MEDIA,
  } from '../../../lib/promoGallery.ts';
  import { PROMO_CMS_WORK_GALLERY_KEY } from '../../../lib/promoCms.ts';

  type Catalog = ReturnType<typeof normalizePromoGalleryCatalog>;
  type Draft = ReturnType<typeof normalizePromoGalleryDraft>;
  type MediaModel = { useKey: string; assetId: string; alt: string; decorative: boolean };
  type ImagePurpose = 'hero' | 'gallery' | 'owner';
  type MediaSlotOptions = {
    maximum: number;
    purpose: ImagePurpose;
    label: string;
    allowVideo?: boolean;
    onChange?: () => void;
  };
  type ProductModel = {
    key: string; featured: boolean; visible: boolean; name: string; summary: string; caption: string; media: MediaModel[];
  };
  type GalleryModel = {
    key: string; visible: boolean; navigationLabel: string; heading: string; summary: string;
    cover: MediaModel | null; coverIndependent: boolean; items: ProductModel[];
  };
  type ServiceModel = GalleryModel & { serviceKey: string; serviceName: string; serviceSummary: string };

  document.querySelectorAll<HTMLElement>('[data-promo-service-products]').forEach((root) => {
    const storeSlug = root.dataset.storeSlug || '';
    const maxPageMedia = Number(root.dataset.maxPageMedia || 0);
    const maxVideos = Math.min(3, Math.max(0, Number(root.dataset.maxVideos || 0)));
    const canSave = root.dataset.canSave === 'true';
    const canManageMedia = root.dataset.canManageMedia === 'true';
    const canManageVideo = root.dataset.canManageVideo === 'true';
    const form = root.querySelector<HTMLFormElement>('[data-products-form]');
    const servicesElement = root.querySelector<HTMLElement>('[data-products-services]');
    const ownerElement = root.querySelector<HTMLElement>('[data-products-owner]');
    const workElement = root.querySelector<HTMLElement>('[data-products-work]');
    const featuredElement = root.querySelector<HTMLElement>('[data-products-featured]');
    const heroElement = root.querySelector<HTMLElement>('[data-products-hero-media]');
    const statusElement = root.querySelector<HTMLElement>('[data-products-status]');
    const alertElement = root.querySelector<HTMLElement>('[data-products-alert]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-products-save]');
    let draft: Draft | null = null;
    let catalog: Catalog | null = null;
    let locale = 'es';
    let heroMedia: MediaModel[] = [];
    let ownerMedia: MediaModel | null = null;
    let services: ServiceModel[] = [];
    let workGallery: GalleryModel = {
      key: PROMO_CMS_WORK_GALLERY_KEY,
      visible: false,
      navigationLabel: 'Trabajos realizados',
      heading: 'Trabajos realizados',
      summary: '',
      cover: null,
      coverIndependent: false,
      items: [],
    };
    let preservedGalleries: GalleryModel[] = [];
    let dirty = false;
    let busy = false;

    const endpoint = (path: string) => `${path}?store=${encodeURIComponent(storeSlug)}`;
    const text = (value: unknown) => String(value === null || value === undefined ? '' : value);
    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', value = '') => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (value) node.textContent = value;
      return node;
    };

    function newKey(prefix: string, maximum = 64) {
      const suffix = Array.from(crypto.getRandomValues(new Uint8Array(6)), (value) => value.toString(16).padStart(2, '0')).join('');
      return `${prefix}-${suffix}`.slice(0, maximum);
    }

    function setStatus(message: string) {
      if (statusElement) statusElement.textContent = message;
    }

    function showError(error: any) {
      if (!alertElement) return;
      alertElement.textContent = promoGalleryErrorMessage(error?.code || error?.message);
      alertElement.hidden = false;
      alertElement.focus();
    }

    function clearError() {
      if (alertElement) alertElement.hidden = true;
    }

    function markDirty(message = 'Hay cambios sin guardar.') {
      dirty = true;
      if (saveButton) saveButton.disabled = busy || !canSave;
      setStatus(`${message} Guardar actualizará la página pública.`);
    }

    async function requestJson(url: string, init?: RequestInit) {
      const response = await fetch(url, {
        ...init,
        headers: { Accept: 'application/json', ...(init?.headers || {}) },
        credentials: 'same-origin',
        cache: 'no-store',
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true) {
        const error = new Error(text(result?.error || 'promo_media_unavailable')) as Error & { code?: string };
        error.code = text(result?.error || 'promo_media_unavailable');
        throw error;
      }
      return result;
    }

    function mediaFromDocument(documentValue: any, useKey: string): MediaModel | null {
      const ref = documentValue.media_refs?.[useKey];
      if (!ref?.asset_id) return null;
      const copy = documentValue.content_by_locale?.[locale]?.media_alt?.[useKey] || {};
      return { useKey, assetId: text(ref.asset_id), alt: text(copy.alt), decorative: copy.decorative === true };
    }

    function galleryFromSection(documentValue: any, section: any): GalleryModel {
      const localized = documentValue.content_by_locale?.[locale] || {};
      const content = localized.sections?.[section.key] || {};
      const itemText = new Map((content.items || []).map((item: any) => [item.key, item]));
      const items = (section.config?.items || []).map((item: any) => {
        const copy: any = itemText.get(item.key) || {};
        return {
          key: text(item.key), featured: item.featured === true, visible: item.visible === true,
          name: text(copy.name), summary: text(copy.summary), caption: text(copy.caption),
          media: (item.media_use_keys || []).map((useKey: string) => mediaFromDocument(documentValue, useKey)).filter(Boolean),
        } as ProductModel;
      });
      const itemUseKeys = new Set(items.flatMap((item) => item.media.map((media) => media.useKey)));
      const coverKey = text(section.config?.cover_media_use_key);
      return {
        key: text(section.key), visible: section.visible === true,
        navigationLabel: text(localized.navigation?.[section.key] || content.heading || 'Productos'),
        heading: text(content.heading), summary: text(content.summary),
        cover: coverKey ? mediaFromDocument(documentValue, coverKey) : null,
        coverIndependent: Boolean(coverKey && !itemUseKeys.has(coverKey)),
        items,
      };
    }

    function modelFromDocument(documentValue: any) {
      const localized = documentValue.content_by_locale?.[locale] || {};
      const hero = documentValue.sections.find((section: any) => section.type === 'hero');
      heroMedia = (hero?.media_use_keys || []).map((useKey: string) => mediaFromDocument(documentValue, useKey)).filter(Boolean);
      const owner = documentValue.sections.find((section: any) => section.type === 'owner');
      ownerMedia = owner?.config?.media_use_key
        ? mediaFromDocument(documentValue, owner.config.media_use_key)
        : null;
      const gallerySections = documentValue.sections.filter((section: any) => section.type === 'gallery');
      const galleries = new Map(gallerySections.map((section: any) => [section.key, galleryFromSection(documentValue, section)]));
      const servicesSection = documentValue.sections.find((section: any) => section.type === 'services');
      const serviceContent = localized.sections?.[servicesSection?.key] || {};
      const serviceCopy = new Map((serviceContent.items || []).map((item: any) => [item.key, item]));
      workGallery = galleries.get(PROMO_CMS_WORK_GALLERY_KEY) || {
        key: PROMO_CMS_WORK_GALLERY_KEY,
        visible: false,
        navigationLabel: 'Trabajos realizados',
        heading: 'Trabajos realizados',
        summary: '',
        cover: null,
        coverIndependent: false,
        items: [],
      };
      const claimed = new Set<string>([PROMO_CMS_WORK_GALLERY_KEY]);
      const usedKeys = new Set(documentValue.sections.map((section: any) => text(section.key)));
      services = (servicesSection?.config?.item_keys || []).map((serviceKey: string, index: number) => {
        const copy: any = serviceCopy.get(serviceKey) || {};
        const existingKey = text(servicesSection.config.gallery_keys?.[index]);
        let galleryKey = existingKey;
        if (!galleryKey || !galleries.has(galleryKey)) {
          const base = `service-${serviceKey}-products`.slice(0, 64);
          galleryKey = base;
          for (let suffix = 2; usedKeys.has(galleryKey); suffix += 1) {
            const ending = `-${suffix}`;
            galleryKey = `${base.slice(0, 64 - ending.length)}${ending}`;
          }
          usedKeys.add(galleryKey);
        }
        claimed.add(galleryKey);
        const existing = galleries.get(galleryKey) || {
          key: galleryKey, visible: false, navigationLabel: text(copy.name || 'Productos'),
          heading: text(copy.name), summary: text(copy.summary), cover: null, coverIndependent: false, items: [],
        };
        return {
          ...existing,
          serviceKey: text(serviceKey),
          serviceName: text(copy.name || `Servicio ${index + 1}`),
          serviceSummary: text(copy.summary),
        } as ServiceModel;
      });
      preservedGalleries = gallerySections
        .filter((section: any) => !claimed.has(text(section.key)))
        .map((section: any) => galleryFromSection(documentValue, section));
    }

    function assetById(assetId: string) {
      return catalog?.assets.find((asset) => asset.assetId === assetId) || null;
    }

    function preview(media: MediaModel) {
      const frame = element('div', 'pz-promo-gallery__item-preview');
      const asset = assetById(media.assetId);
      const src = promoGalleryPreviewPath(storeSlug, media.assetId);
      if (!asset || !src) return frame;
      if (asset.kind === 'video') {
        const video = document.createElement('video');
        video.src = src; video.controls = true; video.preload = 'metadata'; frame.append(video);
      } else {
        const image = document.createElement('img');
        image.src = src; image.alt = ''; image.loading = 'lazy'; frame.append(image);
      }
      return frame;
    }

    function renderMedia(media: MediaModel, target: MediaModel[], index: number, label: string) {
      const card = element('article', 'pz-promo-gallery__item');
      card.append(preview(media));
      const main = element('div', 'pz-promo-gallery__item-main');
      const alt = document.createElement('input');
      alt.type = 'text'; alt.maxLength = 300; alt.value = media.alt; alt.required = !media.decorative; alt.disabled = !canSave;
      alt.setAttribute('aria-label', `Texto alternativo de ${label}`);
      alt.addEventListener('input', () => { media.alt = alt.value; markDirty(); });
      const decorative = document.createElement('input');
      decorative.type = 'checkbox'; decorative.checked = media.decorative; decorative.disabled = !canSave;
      decorative.addEventListener('change', () => {
        media.decorative = decorative.checked;
        if (media.decorative) { media.alt = ''; alt.value = ''; }
        alt.required = !media.decorative;
        markDirty();
      });
      const decorativeLabel = element('label', 'pz-promo-gallery__check');
      decorativeLabel.append(decorative, element('span', '', 'Imagen decorativa'));
      main.append(element('strong', '', assetById(media.assetId)?.kind === 'video' ? 'Video' : 'Imagen'), alt, decorativeLabel);
      const actions = element('div', 'pz-promo-gallery__item-actions');
      const up = element('button', '', '↑'); up.type = 'button'; up.disabled = !canSave || index === 0; up.ariaLabel = `Subir ${label}`;
      const down = element('button', '', '↓'); down.type = 'button'; down.disabled = !canSave || index === target.length - 1; down.ariaLabel = `Bajar ${label}`;
      const remove = element('button', 'is-danger', 'Quitar'); remove.type = 'button'; remove.disabled = !canSave;
      up.addEventListener('click', () => { [target[index - 1], target[index]] = [target[index], target[index - 1]]; markDirty(); render(); });
      down.addEventListener('click', () => { [target[index + 1], target[index]] = [target[index], target[index + 1]]; markDirty(); render(); });
      remove.addEventListener('click', () => { target.splice(index, 1); markDirty(); render(); });
      actions.append(up, down, remove); card.append(main, actions);
      return card;
    }

    async function loadCatalog() {
      catalog = normalizePromoGalleryCatalog(await requestJson(endpoint(PROMO_GALLERY_MEDIA_API_PATH)));
    }

    async function uploadAsset(file: File, purpose: 'hero' | 'gallery' | 'owner' | 'video_poster', posterAssetId = '') {
      const payload = new FormData();
      payload.append('file', file); payload.append('purpose', purpose); payload.append('poster_asset_id', posterAssetId);
      const result = await requestJson(endpoint(PROMO_GALLERY_MEDIA_API_PATH), { method: 'POST', body: payload });
      const assetId = text(result?.asset?.asset_id);
      if (!/^[a-z0-9]{15}$/.test(assetId)) throw Object.assign(new Error('promo_media_unavailable'), { code: 'promo_media_unavailable' });
      await loadCatalog();
      return assetId;
    }

    async function addImages(files: FileList | null, target: MediaModel[], purpose: 'hero' | 'gallery' | 'owner', maximum = 150) {
      if (!files?.length || !canManageMedia || busy) return;
      clearError(); busy = true; render(); setStatus('Procesando y subiendo imágenes…');
      try {
        const room = Math.max(0, maximum - target.length);
        for (const file of Array.from(files).slice(0, room)) {
          const assetId = await uploadAsset(file, purpose);
          target.push({ useKey: newKey(`${purpose}-media`, 120), assetId, alt: '', decorative: false });
        }
        markDirty('Imágenes listas.');
      } catch (error) { showError(error); setStatus('No se pudieron subir las imágenes.'); }
      finally { busy = false; render(); }
    }

    async function addVideo(video: File | undefined, poster: File | undefined, target: MediaModel[], purpose: 'gallery', maximum = 150) {
      if (!video || !poster || !canManageVideo || busy || target.length >= maximum) return;
      if ((catalog?.usage.videos || 0) >= maxVideos) return showError({ code: 'promo_capability_denied' });
      clearError(); busy = true; render(); setStatus('Procesando poster y video…');
      try {
        const posterId = await uploadAsset(poster, 'video_poster');
        const assetId = await uploadAsset(video, purpose, posterId);
        target.push({ useKey: newKey(`${purpose}-video`, 120), assetId, alt: '', decorative: false });
        markDirty('Video listo.');
      } catch (error) { showError(error); setStatus('No se pudo subir el video.'); }
      finally { busy = false; render(); }
    }

    function uploadControls(target: MediaModel[], purpose: 'gallery', maximum: number) {
      const controls = element('div', 'pz-promo-products__upload-row');
      const imageLabel = element('label', '', 'Agregar fotos');
      const images = document.createElement('input');
      images.type = 'file'; images.multiple = true; images.accept = 'image/jpeg,image/png,image/webp,image/avif';
      images.disabled = busy || !canManageMedia || target.length >= maximum;
      images.addEventListener('change', () => addImages(images.files, target, purpose, maximum));
      imageLabel.append(images); controls.append(imageLabel);
      if (canManageVideo) {
        const videoGroup = element('div', 'pz-promo-products__video-upload');
        const videoLabel = element('label', '', 'Video');
        const video = document.createElement('input'); video.type = 'file'; video.accept = 'video/mp4,video/webm'; video.disabled = busy;
        const posterLabel = element('label', '', 'Poster');
        const poster = document.createElement('input'); poster.type = 'file'; poster.accept = 'image/jpeg,image/png,image/webp,image/avif'; poster.disabled = busy;
        const add = element('button', 'pz-promo-gallery__secondary', 'Añadir video'); add.type = 'button'; add.disabled = busy || !canManageVideo || target.length >= maximum;
        add.addEventListener('click', () => addVideo(video.files?.[0], poster.files?.[0], target, purpose, maximum));
        videoLabel.append(video); posterLabel.append(poster); videoGroup.append(videoLabel, posterLabel, add); controls.append(videoGroup);
      }
      return controls;
    }


    const IMAGE_ACCEPT = 'image/jpeg,image/png,image/webp,image/avif';
    const IMAGE_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/avif']);
    const IMAGE_GUIDANCE: Record<ImagePurpose, string> = {
      hero: 'JPG, PNG, WebP o AVIF · horizontal 16:9 · ideal 1920×1080 px · mínimo 640×320 px',
      gallery: 'JPG, PNG, WebP o AVIF · horizontal 4:3 · ideal 1200×900 px · mínimo 320×240 px',
      owner: 'JPG, PNG, WebP o AVIF · vertical 4:5 · ideal 800×1000 px · mínimo 320×400 px',
    };
    const IMAGE_MINIMUMS: Record<ImagePurpose, { width: number; height: number }> = {
      hero: { width: 640, height: 320 },
      gallery: { width: 320, height: 240 },
      owner: { width: 320, height: 400 },
    };
    const SLOT_REORDER_TYPE = 'text/x-promo-media-index';

    const mediaError = (code: string) => Object.assign(new Error(code), { code });

    async function validateImageSource(file: File, purpose: ImagePurpose) {
      if (!IMAGE_TYPES.has(file.type)) throw mediaError('promo_media_type_invalid');
      let bitmap: ImageBitmap;
      try {
        bitmap = await window.createImageBitmap(file);
      } catch {
        throw mediaError('promo_media_type_mismatch');
      }
      try {
        const minimum = IMAGE_MINIMUMS[purpose];
        if (bitmap.width < minimum.width || bitmap.height < minimum.height
          || bitmap.width > 6000 || bitmap.height > 6000
          || bitmap.width * bitmap.height > 36_000_000) {
          throw mediaError('promo_media_dimensions_invalid');
        }
      } finally {
        bitmap.close();
      }
    }

    function slotChanged(options: MediaSlotOptions, message = 'Medios actualizados.') {
      options.onChange?.();
      markDirty(message);
      render();
    }

    async function setImageAt(
      file: File | undefined,
      target: MediaModel[],
      index: number,
      options: MediaSlotOptions,
    ) {
      if (!file || !canManageMedia || busy || index > target.length || index >= options.maximum) return;
      clearError(); busy = true; render(); setStatus('Validando y subiendo imagen…');
      try {
        await validateImageSource(file, options.purpose);
        const assetId = await uploadAsset(file, options.purpose);
        const media = { useKey: newKey(`${options.purpose}-media`, 120), assetId, alt: '', decorative: false };
        if (index < target.length) target[index] = media;
        else target.push(media);
        options.onChange?.();
        markDirty('Imagen lista.');
      } catch (error) {
        showError(error);
        setStatus('No se pudo subir la imagen. Revisa formato y dimensiones.');
      } finally {
        busy = false;
        render();
      }
    }

    async function setVideoAt(
      video: File | undefined,
      poster: File | undefined,
      target: MediaModel[],
      index: number,
      options: MediaSlotOptions,
    ) {
      if (!video || !poster || !options.allowVideo || !canManageVideo || busy
        || index > target.length || index >= options.maximum) return;
      if (!['video/mp4', 'video/webm'].includes(video.type)) return showError({ code: 'promo_media_type_invalid' });
      if ((catalog?.usage.videos || 0) >= maxVideos) return showError({ code: 'promo_capability_denied' });
      clearError(); busy = true; render(); setStatus('Validando poster y subiendo video…');
      try {
        await validateImageSource(poster, 'gallery');
        const posterId = await uploadAsset(poster, 'video_poster');
        const assetId = await uploadAsset(video, 'gallery', posterId);
        const media = { useKey: newKey('gallery-video', 120), assetId, alt: '', decorative: false };
        if (index < target.length) target[index] = media;
        else target.push(media);
        options.onChange?.();
        markDirty('Video listo.');
      } catch (error) {
        showError(error);
        setStatus('No se pudo subir el video. Revisa el archivo y su poster.');
      } finally {
        busy = false;
        render();
      }
    }

    function renderMediaSlots(target: MediaModel[], options: MediaSlotOptions) {
      const wrapper = element('section', 'pz-promo-media-slots');
      wrapper.dataset.maximum = String(options.maximum);
      const header = element('header', 'pz-promo-media-slots__header');
      header.append(
        element('strong', '', `${options.label}`),
        element('span', '', `${Math.min(target.length, options.maximum)} de ${options.maximum} utilizados`),
      );
      const grid = element('div', 'pz-promo-media-slots__grid');

      for (let index = 0; index < options.maximum; index += 1) {
        const media = target[index];
        const asset = media ? assetById(media.assetId) : null;
        const slot = element('article', `pz-promo-media-slot${media ? ' is-filled' : ' is-empty'}`);
        slot.dataset.purpose = options.purpose;
        slot.dataset.mediaSlot = String(index);
        slot.draggable = Boolean(media && canSave && !busy);

        const slotHeading = element('div', 'pz-promo-media-slot__heading');
        slotHeading.append(
          element('strong', '', `Espacio ${index + 1}`),
          element('span', '', media ? (asset?.kind === 'video' ? 'Video' : 'Imagen') : 'Disponible'),
        );
        slot.append(slotHeading);

        const imageInput = document.createElement('input');
        imageInput.type = 'file';
        imageInput.accept = IMAGE_ACCEPT;
        imageInput.className = 'pz-promo-media-slot__input';
        imageInput.disabled = busy || !canManageMedia;
        imageInput.setAttribute('aria-label', `${media ? 'Cambiar' : 'Agregar'} imagen en ${options.label}, espacio ${index + 1}`);
        imageInput.addEventListener('change', () => setImageAt(imageInput.files?.[0], target, index, options));

        if (media) {
          slot.append(preview(media));
          const accessibility = element('div', 'pz-promo-media-slot__accessibility');
          const altLabel = element('label', 'pz-promo-gallery__field', asset?.kind === 'video' ? 'Descripción accesible del video' : 'Texto alternativo');
          const alt = document.createElement('input');
          alt.type = 'text'; alt.maxLength = 300; alt.value = media.alt; alt.required = !media.decorative; alt.disabled = !canSave;
          alt.addEventListener('input', () => { media.alt = alt.value; markDirty(); });
          altLabel.append(alt);
          const decorative = document.createElement('input');
          decorative.type = 'checkbox'; decorative.checked = media.decorative; decorative.disabled = !canSave;
          decorative.addEventListener('change', () => {
            media.decorative = decorative.checked;
            if (media.decorative) { media.alt = ''; alt.value = ''; }
            alt.required = !media.decorative;
            markDirty();
          });
          const decorativeLabel = element('label', 'pz-promo-gallery__check');
          decorativeLabel.append(decorative, element('span', '', 'Medio decorativo'));
          accessibility.append(altLabel, decorativeLabel);
          slot.append(accessibility);
        } else {
          const empty = element('div', 'pz-promo-media-slot__empty');
          empty.append(
            element('strong', '', 'Arrastra una imagen aquí'),
            element('span', '', 'o selecciónala desde tu dispositivo'),
          );
          slot.append(empty);
        }

        const actions = element('div', 'pz-promo-media-slot__actions');
        const choose = element('button', 'pz-promo-gallery__secondary', media ? 'Cambiar imagen' : 'Elegir imagen');
        choose.type = 'button'; choose.disabled = busy || !canManageMedia;
        choose.addEventListener('click', () => imageInput.click());
        actions.append(choose, imageInput);

        if (media) {
          const up = element('button', 'pz-promo-gallery__secondary', '↑');
          up.type = 'button'; up.disabled = !canSave || busy || index === 0; up.ariaLabel = `Mover ${options.label} a la izquierda`;
          up.addEventListener('click', () => {
            [target[index - 1], target[index]] = [target[index], target[index - 1]];
            slotChanged(options, 'Orden actualizado.');
          });
          const down = element('button', 'pz-promo-gallery__secondary', '↓');
          down.type = 'button'; down.disabled = !canSave || busy || index === target.length - 1; down.ariaLabel = `Mover ${options.label} a la derecha`;
          down.addEventListener('click', () => {
            [target[index + 1], target[index]] = [target[index], target[index + 1]];
            slotChanged(options, 'Orden actualizado.');
          });
          const remove = element('button', 'is-danger', 'Quitar');
          remove.type = 'button'; remove.disabled = !canSave || busy;
          remove.addEventListener('click', () => {
            target.splice(index, 1);
            slotChanged(options);
          });
          actions.append(up, down, remove);
        }
        slot.append(actions);

        if (!media && options.allowVideo && canManageVideo) {
          const videoDetails = element('details', 'pz-promo-media-slot__video') as HTMLDetailsElement;
          const videoSummary = element('summary', '', 'Usar video');
          const videoBody = element('div');
          const videoLabel = element('label', 'pz-promo-gallery__field', 'Video MP4 o WebM');
          const videoInput = document.createElement('input');
          videoInput.type = 'file'; videoInput.accept = 'video/mp4,video/webm'; videoInput.disabled = busy;
          const posterLabel = element('label', 'pz-promo-gallery__field', 'Imagen poster');
          const posterInput = document.createElement('input');
          posterInput.type = 'file'; posterInput.accept = IMAGE_ACCEPT; posterInput.disabled = busy;
          const addVideoButton = element('button', 'pz-promo-gallery__secondary', 'Añadir video');
          addVideoButton.type = 'button'; addVideoButton.disabled = busy || !canManageVideo;
          addVideoButton.addEventListener('click', () => setVideoAt(
            videoInput.files?.[0],
            posterInput.files?.[0],
            target,
            index,
            options,
          ));
          videoLabel.append(videoInput); posterLabel.append(posterInput);
          videoBody.append(videoLabel, posterLabel, addVideoButton,
            element('small', 'pz-promo-media-slot__guidance', 'MP4 o WebM · recomendado 1280×720 px · poster horizontal 1200×900 px'));
          videoDetails.append(videoSummary, videoBody); slot.append(videoDetails);
        }

        slot.append(element('small', 'pz-promo-media-slot__guidance', IMAGE_GUIDANCE[options.purpose]));

        slot.addEventListener('dragstart', (event) => {
          if (!media || !event.dataTransfer) return;
          event.dataTransfer.effectAllowed = 'move';
          event.dataTransfer.setData(SLOT_REORDER_TYPE, String(index));
        });
        slot.addEventListener('dragover', (event) => {
          if (busy || (!canManageMedia && !canSave)) return;
          const types = Array.from(event.dataTransfer?.types || []);
          if (!types.includes('Files') && !types.includes(SLOT_REORDER_TYPE)) return;
          event.preventDefault();
          slot.classList.add('is-dragover');
        });
        slot.addEventListener('dragleave', () => slot.classList.remove('is-dragover'));
        slot.addEventListener('drop', (event) => {
          slot.classList.remove('is-dragover');
          if (busy || !event.dataTransfer) return;
          const source = event.dataTransfer.getData(SLOT_REORDER_TYPE);
          if (source !== '') {
            event.preventDefault();
            const from = Number(source);
            if (!canSave || !Number.isInteger(from) || from < 0 || from >= target.length || from === index) return;
            if (index < target.length) [target[from], target[index]] = [target[index], target[from]];
            else target.push(target.splice(from, 1)[0]);
            slotChanged(options, 'Orden actualizado.');
            return;
          }
          const file = event.dataTransfer.files?.[0];
          if (!file) return;
          event.preventDefault();
          setImageAt(file, target, index, options);
        });

        grid.append(slot);
      }

      wrapper.append(header, grid);
      return wrapper;
    }
    function renderProduct(service: ServiceModel, product: ProductModel, index: number) {
