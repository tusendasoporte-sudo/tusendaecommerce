    function pageMediaCount() {
      return heroMedia.length
        + (ownerMedia ? 1 : 0)
        + workGallery.items.reduce((total, item) => total + item.media.length, 0)
        + services.reduce((total, service) => (
          total + (service.cover?.useKey && service.coverIndependent ? 1 : 0)
          + service.items.reduce((sum, item) => sum + item.media.length, 0)
        ), 0);
    }

    function renderMetrics() {
      const images = root.querySelector<HTMLElement>('[data-products-image-count]');
      const imageLimit = root.querySelector<HTMLElement>('[data-products-image-limit]');
      const videos = root.querySelector<HTMLElement>('[data-products-video-count]');
      const page = root.querySelector<HTMLElement>('[data-products-page-count]');
      if (images) images.textContent = String(catalog?.usage.images || 0);
      if (imageLimit) imageLimit.textContent = `de ${catalog?.limits.maxStoredImages || 150}`;
      if (videos) videos.textContent = String(catalog?.usage.videos || 0);
      if (page) page.textContent = String(pageMediaCount());
