---
import type { PromoCmsScope } from '../../../lib/promoCms';
import '../../../styles/promo-cms.css';

interface Props {
  storeSlug: string;
  scope: PromoCmsScope;
  maxServices?: number;
  canSave: boolean;
  canManageMedia?: boolean;
}

const {
  storeSlug,
  scope,
  maxServices = 0,
  canSave,
  canManageMedia = false,
} = Astro.props;
const isContent = scope === 'content';
---

<section
  class="pz-promo-cms"
  data-promo-cms
  data-store-slug={storeSlug}
  data-scope={scope}
  data-max-services={maxServices}
  data-can-save={canSave ? 'true' : 'false'}
  data-can-manage-media={canManageMedia ? 'true' : 'false'}
  aria-labelledby="promo-cms-title"
>
  <header class="pz-promo-cms__intro">
    <div>
      <span class="pz-promo-cms__kicker">Página pública en vivo</span>
      <h2 id="promo-cms-title">{isContent ? 'Editor de contenido' : 'Canales de contacto'}</h2>
      <p>
        {isContent
          ? 'Organiza identidad, portada, servicios, propietario y pie del sitio. Guardar actualiza la página automáticamente.'
          : 'Configura el logo, canales, QR y el método principal. Guardar actualiza la página automáticamente.'}
      </p>
    </div>
    <div class="pz-promo-cms__draft-meta" aria-label="Estado de la página">
      <span data-cms-locale>Idioma base: —</span>
      <span data-cms-version>Versión: —</span>
    </div>
  </header>

  {!canSave && (
    <div class="pz-promo-cms__notice is-warning" role="status">
      <strong>Acceso de solo lectura</strong>
      <p>
        {isContent
          ? 'Esta sesión no puede guardar contenido Promo.'
          : 'Para guardar contacto se requieren conjuntamente Contenido y Contacto, tal como exige el backend.'}
      </p>
    </div>
  )}

  <div class="pz-promo-cms__notice" role="status" aria-live="polite" data-cms-status>
    <span class="pz-promo-cms__spinner" aria-hidden="true"></span>
    <span>Cargando la página segura…</span>
  </div>

  <div class="pz-promo-cms__error" role="alert" tabindex="-1" data-cms-error hidden>
    <strong>No se pudo continuar</strong>
    <p data-cms-error-message></p>
    <button type="button" data-cms-reload>Recargar página</button>
  </div>

  <form class="pz-promo-cms__form" data-cms-form hidden novalidate>
    {isContent ? (
      <>
        <section class="pz-promo-cms__panel" aria-labelledby="cms-identity-title">
          <div class="pz-promo-cms__panel-heading">
            <span class="pz-promo-cms__step" aria-hidden="true">01</span>
            <div>
              <h3 id="cms-identity-title">Identidad pública</h3>
              <p>Nombre y resumen del negocio en el idioma base. No modifica usuarios ni datos internos.</p>
            </div>
          </div>
          <div class="pz-promo-cms__fields two-columns">
            <label class="pz-promo-cms__field">
              <span>Nombre público</span>
              <input type="text" maxlength="140" autocomplete="organization" data-cms-identity-name />
              <small>Máximo 140 caracteres.</small>
            </label>
            <label class="pz-promo-cms__field">
              <span>Slogan</span>
              <input type="text" maxlength="120" data-cms-identity-slogan />
              <small>Frase opcional bajo el nombre; máximo 120 caracteres.</small>
            </label>
            <label class="pz-promo-cms__field is-wide">
              <span>Resumen del negocio</span>
              <textarea rows="4" maxlength="600" data-cms-identity-summary></textarea>
              <small>Texto plano, sin HTML, scripts ni URLs.</small>
            </label>
          </div>
        </section>

        <section class="pz-promo-cms__panel" aria-labelledby="cms-sections-title">
          <div class="pz-promo-cms__panel-heading">
            <span class="pz-promo-cms__step" aria-hidden="true">02</span>
            <div>
              <h3 id="cms-sections-title">Orden y contenido de secciones</h3>
              <p>Usa los botones de orden para mantener una experiencia accesible también por teclado.</p>
            </div>
          </div>
          <div class="pz-promo-cms__section-list" data-cms-sections></div>
        </section>
      </>
    ) : (
      <>
        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-cms-contact-panel="presentation">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">01</span>
            <div>
              <h3 id="cms-contact-section-title">Presentación de contacto</h3>
              <p>Controla la visibilidad y los textos que aparecen en la página pública.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-cms__fields two-columns">
            <label class="pz-promo-cms__switch is-wide">
              <input type="checkbox" data-cms-contact-section-visible />
              <span><strong>Mostrar sección de contacto</strong><small>Puede permanecer oculta hasta que completes la información.</small></span>
            </label>
            <label class="pz-promo-cms__field">
              <span>Etiqueta de navegación</span>
              <input type="text" required maxlength="80" data-cms-contact-navigation />
            </label>
            <label class="pz-promo-cms__field">
              <span>Título de la sección</span>
              <input type="text" maxlength="160" data-cms-contact-heading />
            </label>
            <label class="pz-promo-cms__field is-wide">
              <span>Resumen</span>
              <textarea rows="3" maxlength="600" data-cms-contact-summary></textarea>
            </label>
          </div>
        </details>

        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-cms-contact-panel="logo">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">02</span>
            <div>
              <h3 id="cms-contact-logo-title">Logo del negocio</h3>
              <p>Se reutiliza en la cabecera pública y como imagen de vista previa al compartir por WhatsApp.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-cms__qr-grid">
            <div class="pz-promo-cms__qr-preview" data-cms-logo-preview><span>Sin logo</span></div>
            <div class="pz-promo-cms__qr-upload">
              <label class="pz-promo-cms__field">
                <span>Imagen del logo</span>
                <input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-cms-logo-file disabled={!canManageMedia} />
                <small>Recomendado: imagen cuadrada de al menos 256×256. Se optimiza a WebP.</small>
              </label>
              <div class="pz-promo-cms__qr-actions">
                <button class="pz-promo-cms__secondary-button" type="button" data-cms-upload-logo disabled={!canManageMedia}>Procesar logo</button>
                <button class="pz-promo-cms__secondary-button" type="button" data-cms-remove-logo disabled={!canSave}>Quitar logo</button>
              </div>
            </div>
          </div>
        </details>

        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-cms-contact-panel="qr">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">03</span>
            <div>
              <h3 id="cms-contact-qr-title">Código QR propio</h3>
              <p>Sube una imagen de QR; se convertirá a WebP 512×512 con fondo blanco y sin recorte.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-cms__qr-grid">
            <div class="pz-promo-cms__qr-preview" data-cms-qr-preview><span>Sin QR</span></div>
            <div class="pz-promo-cms__qr-upload">
              <label class="pz-promo-cms__field">
                <span>Imagen del QR</span>
                <input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-cms-qr-file disabled={!canManageMedia} />
                <small>La carga queda asociada al guardar los cambios.</small>
              </label>
              <div class="pz-promo-cms__qr-actions">
                <button class="pz-promo-cms__secondary-button" type="button" data-cms-upload-qr disabled={!canManageMedia}>Procesar QR</button>
                <button class="pz-promo-cms__secondary-button" type="button" data-cms-remove-qr disabled={!canSave}>Quitar QR</button>
              </div>
            </div>
          </div>
        </details>

        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-cms-contact-panel="methods">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">04</span>
            <div>
              <h3 id="cms-contact-actions-title">Métodos permitidos</h3>
              <p>WhatsApp y teléfono exigen E.164; correo exige una dirección válida. No se aceptan URLs.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-cms__panel-toolbar">
            <button class="pz-promo-cms__secondary-button" type="button" data-cms-add-contact>Añadir método</button>
          </div>
          <label class="pz-promo-cms__switch pz-promo-cms__contact-master">
            <input type="checkbox" data-cms-contact-enabled />
            <span><strong>Habilitar contacto en la página</strong><small>Al habilitarlo debes elegir un método principal disponible.</small></span>
          </label>
          <div class="pz-promo-cms__action-list" data-cms-contact-actions></div>
        </details>
      </>
    )}

    <footer class="pz-promo-cms__actions">
      <div>
        <strong data-cms-unsaved>Sin cambios pendientes</strong>
        <small>Al guardar, la página pública se actualiza automáticamente después de validar permisos, medios y contenido.</small>
      </div>
      <button class="pz-promo-cms__save" type="submit" data-cms-save disabled>
        <span data-cms-save-label>Guardar cambios</span>
      </button>
    </footer>
  </form>
</section>

<script>
  import {
    buildPromoCmsContactDocument,
    buildPromoCmsContentDocument,
    createPromoCmsWorkspace,
    normalizePromoCmsDraftResponse,
    PROMO_CMS_API_PATH,
    PROMO_CMS_CONTACT_TYPES,
    PROMO_CMS_FOOTER_MAX_LINKS,
    PROMO_CMS_FOOTER_SOCIAL_NETWORKS,
    promoCmsErrorMessage,
  } from '../../../lib/promoCms';

  type CmsDocument = Record<string, any>;

  const sectionLabels: Record<string, string> = {
    hero: 'Portada',
    services: 'Servicios',
    featured_work: 'Trabajo destacado',
    gallery: 'Galería',
    owner: 'Propietario',
    store_rating: 'Reseñas de tienda',
    contact: 'Contacto',
    footer: 'Pie del sitio',
  };
  const contactLabels: Record<string, string> = {
    whatsapp: 'WhatsApp',
    phone: 'Teléfono',
    email: 'Correo',
    internal_form: 'Formulario interno',
    approved_live_chat: 'Live Chat aprobado',
  };

  document.querySelectorAll<HTMLElement>('[data-promo-cms]').forEach((root) => {
    const storeSlug = root.dataset.storeSlug || '';
    const scope = root.dataset.scope === 'contact' ? 'contact' : 'content';
    const maxServices = Number(root.dataset.maxServices || 0);
    const canSave = root.dataset.canSave === 'true';
    const canManageMedia = root.dataset.canManageMedia === 'true';
    const endpoint = `${PROMO_CMS_API_PATH}?store=${encodeURIComponent(storeSlug)}`;
    const mediaEndpoint = `/api/admin/promo-media?store=${encodeURIComponent(storeSlug)}`;
    const form = root.querySelector<HTMLFormElement>('[data-cms-form]');
    const status = root.querySelector<HTMLElement>('[data-cms-status]');
    const errorBox = root.querySelector<HTMLElement>('[data-cms-error]');
    const errorMessage = root.querySelector<HTMLElement>('[data-cms-error-message]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-cms-save]');
    const saveLabel = root.querySelector<HTMLElement>('[data-cms-save-label]');
    const unsaved = root.querySelector<HTMLElement>('[data-cms-unsaved]');
    let version = 0;
    let documentValue: CmsDocument | null = null;
    let locale = '';
    let dirty = false;
    let busy = false;
    let logoUseKey = '';
    let qrUseKey = '';

    function element<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className = '',
      text = '',
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    }

    function inputField(
      labelText: string,
      value: string,
      options: { textarea?: boolean; max?: number; required?: boolean; data?: string } = {},
    ) {
      const label = element('label', 'pz-promo-cms__field');
      label.append(element('span', '', labelText));
      const control = options.textarea ? element('textarea') : element('input');
      if (control instanceof HTMLTextAreaElement) control.rows = 3;
      if (control instanceof HTMLInputElement) control.type = 'text';
      control.value = value || '';
      if (options.max) control.maxLength = options.max;
      if (options.required) control.required = true;
      if (options.data) control.dataset.cmsField = options.data;
      label.append(control);
      return { label, control };
    }

    function setDirty(next = true) {
      dirty = next;
      if (unsaved) unsaved.textContent = dirty ? 'Cambios sin guardar' : 'Sin cambios pendientes';
      if (saveButton) saveButton.disabled = !canSave || !dirty || busy;
    }

    function setBusy(next: boolean, message: string) {
      busy = next;
      root.setAttribute('aria-busy', next ? 'true' : 'false');
      if (saveButton) saveButton.disabled = next || !canSave || !dirty;
      if (saveLabel) saveLabel.textContent = next ? message : 'Guardar cambios';
      form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((control) => {
        control.disabled = next || !canSave;
      });
      form?.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
        if (button !== saveButton) button.disabled = next || !canSave;
      });
      if (!next) {
        updateServiceQuota();
        root.querySelectorAll<HTMLElement>('[data-cms-contact-action]').forEach(setContactControlState);
        const logoFile = root.querySelector<HTMLInputElement>('[data-cms-logo-file]');
        const logoUpload = root.querySelector<HTMLButtonElement>('[data-cms-upload-logo]');
        if (logoFile) logoFile.disabled = !canManageMedia;
        if (logoUpload) logoUpload.disabled = !canManageMedia;
        const qrFile = root.querySelector<HTMLInputElement>('[data-cms-qr-file]');
        const qrUpload = root.querySelector<HTMLButtonElement>('[data-cms-upload-qr]');
        if (qrFile) qrFile.disabled = !canManageMedia;
        if (qrUpload) qrUpload.disabled = !canManageMedia;
      }
    }

    function showError(code: unknown) {
      if (errorMessage) errorMessage.textContent = promoCmsErrorMessage(code);
      if (errorBox) {
        errorBox.hidden = false;
        errorBox.focus();
      }
    }

    function clearError() {
      if (errorBox) errorBox.hidden = true;
      if (errorMessage) errorMessage.textContent = '';
    }

    function updateMeta() {
      const localeNode = root.querySelector<HTMLElement>('[data-cms-locale]');
      const versionNode = root.querySelector<HTMLElement>('[data-cms-version]');
      if (localeNode) localeNode.textContent = `Idioma base: ${locale || '—'}`;
      if (versionNode) versionNode.textContent = `Versión: ${version || '—'}`;
    }

    function serviceTotal() {
      return root.querySelectorAll('[data-cms-service-item]').length;
    }

    function updateServiceQuota() {
      const count = serviceTotal();
      root.querySelectorAll<HTMLElement>('[data-cms-service-count]').forEach((node) => {
        node.textContent = `${count} de ${maxServices}`;
      });
      root.querySelectorAll<HTMLButtonElement>('[data-cms-add-service]').forEach((button) => {
        button.disabled = busy || !canSave || count >= maxServices;
      });
    }

    function moveCard(card: HTMLElement, direction: -1 | 1) {
      const sibling = direction < 0 ? card.previousElementSibling : card.nextElementSibling;
      if (!(sibling instanceof HTMLElement)) return;
      if (direction < 0) card.parentElement?.insertBefore(card, sibling);
      else card.parentElement?.insertBefore(sibling, card);
      setDirty();
      card.querySelector<HTMLElement>('h4')?.focus();
    }

    function actionButtons(card: HTMLElement, label: string) {
      const controls = element('div', 'pz-promo-cms__order-controls');
      const up = element('button', '', 'Subir');
      up.type = 'button';
      up.setAttribute('aria-label', `Subir ${label}`);
      up.addEventListener('click', () => moveCard(card, -1));
      const down = element('button', '', 'Bajar');
      down.type = 'button';
      down.setAttribute('aria-label', `Bajar ${label}`);
      down.addEventListener('click', () => moveCard(card, 1));
      controls.append(up, down);
      return controls;
    }

    function createServiceItem(item: CmsDocument, sectionKey: string, galleryKey = '') {
      const card = element('article', 'pz-promo-cms__service-item');
      card.dataset.cmsServiceItem = item.key;
      card.dataset.cmsServicePortfolioKey = galleryKey;
      const header = element('header', 'pz-promo-cms__item-heading');
      const title = element('h5', '', item.name || 'Servicio sin nombre');
      title.tabIndex = -1;
      const controls = actionButtons(card, 'servicio');
      const remove = element('button', 'is-danger', 'Quitar');
      remove.type = 'button';
      remove.setAttribute('aria-label', `Quitar servicio ${item.name || item.key}`);
      remove.addEventListener('click', () => {
        card.remove();
        updateServiceQuota();
        setDirty();
      });
      controls.append(remove);
      header.append(title, controls);
      const fields = element('div', 'pz-promo-cms__fields two-columns');
      const name = inputField('Nombre del servicio', item.name || '', { max: 160, data: 'name' });
      const summary = inputField('Resumen', item.summary || '', { textarea: true, max: 600, data: 'summary' });
      const caption = inputField('Nota o caption', item.caption || '', { max: 500, data: 'caption' });
      const categoryNote = element('p', 'pz-promo-cms__scope-note', 'Este servicio funciona como categoría. Su portada y sus productos se administran en «Portada, servicios y productos», más abajo.');
      name.control.addEventListener('input', () => { title.textContent = name.control.value || 'Servicio sin nombre'; });
      fields.append(name.label, summary.label, caption.label, categoryNote);
      card.dataset.sectionKey = sectionKey;
      card.append(header, fields);
      return card;
    }

    function createSectionCard(section: CmsDocument, localized: CmsDocument) {
      const labelText = sectionLabels[section.type] || 'Sección';
      const sectionContent = localized.sections?.[section.key] || {};
      const card = element('article', 'pz-promo-cms__section-card');
      card.dataset.cmsSectionKey = section.key;
      card.dataset.cmsSectionType = section.type;
      const header = element('header', 'pz-promo-cms__section-card-heading');
      const titleGroup = element('div');
      titleGroup.append(element('span', 'pz-promo-cms__type', labelText));
      const title = element('h4', '', localized.navigation?.[section.key] || labelText);
      title.tabIndex = -1;
      titleGroup.append(title);
      const controls = actionButtons(card, `sección ${labelText}`);
      header.append(titleGroup, controls);

      const visible = element('label', 'pz-promo-cms__switch compact');
      const visibleInput = element('input');
      visibleInput.type = 'checkbox';
      visibleInput.checked = section.visible === true;
      visibleInput.dataset.cmsField = 'visible';
      visible.append(visibleInput, element('span', '', 'Visible en la página'));

      const fields = element('div', 'pz-promo-cms__fields two-columns');
      const navigation = inputField('Etiqueta de navegación', localized.navigation?.[section.key] || labelText, {
        max: 80, required: true, data: 'navigation',
      });
      navigation.control.addEventListener('input', () => { title.textContent = navigation.control.value || labelText; });
      fields.append(navigation.label);

      if (section.type === 'hero') {
        fields.append(
          inputField('Título de portada', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Resumen de portada', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
        );
      } else if (section.type === 'services') {
        fields.append(
          inputField('Título de servicios', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Resumen de servicios', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
        );
        const serviceHeader = element('div', 'pz-promo-cms__subheading');
        const serviceTitle = element('div');
        serviceTitle.append(element('strong', '', 'Servicios'));
        const count = element('small', '', '');
        count.dataset.cmsServiceCount = '';
        serviceTitle.append(count);
        const add = element('button', 'pz-promo-cms__secondary-button', 'Añadir servicio');
        add.type = 'button';
        add.dataset.cmsAddService = '';
        const list = element('div', 'pz-promo-cms__service-list');
        list.dataset.cmsServiceList = '';
        const localizedItems = Array.isArray(sectionContent.items) ? sectionContent.items : [];
        const itemByKey = new Map(localizedItems.map((item: CmsDocument) => [item.key, item]));
        const orderedKeys = [...new Set([...(section.config.item_keys || []), ...localizedItems.map((item: CmsDocument) => item.key)])];
        orderedKeys.forEach((itemKey, index) => list.append(createServiceItem(
          itemByKey.get(itemKey) || { key: itemKey, name: '', summary: '', caption: '' },
          section.key,
          section.config.gallery_keys?.[index] || '',
        )));
        add.addEventListener('click', () => {
          if (serviceTotal() >= maxServices) return;
          const random = crypto.getRandomValues(new Uint32Array(1))[0].toString(36);
          const item = { key: `service-${random}`.slice(0, 64), name: '', summary: '', caption: '' };
          const next = createServiceItem(item, section.key);
          list.append(next);
          updateServiceQuota();
          setDirty();
          next.querySelector<HTMLInputElement>('[data-cms-field="name"]')?.focus();
        });
        serviceHeader.append(serviceTitle, add);
        card.append(header, visible, fields, serviceHeader, list);
        return card;
      } else if (section.type === 'owner') {
        fields.append(
          inputField('Título de propietario', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Nombre público', sectionContent.name || '', { max: 140, data: 'name' }).label,
          inputField('Biografía', sectionContent.bio || '', { textarea: true, max: 4000, data: 'bio' }).label,
        );
      } else if (section.type === 'footer') {
        fields.append(
          inputField('Título del pie', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Resumen del pie', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
          inputField('Texto legal o de cierre', sectionContent.text || '', {
            textarea: true, max: 4000, data: 'text',
          }).label,
        );

        const footerLinks = element('fieldset', 'pz-promo-cms__footer-options');
        const linksLegend = element('legend', '', `Enlaces internos (máximo ${PROMO_CMS_FOOTER_MAX_LINKS})`);
        footerLinks.append(linksLegend);
        const selectedLinks = new Set(section.config.navigation_section_keys || []);
        const linkGrid = element('div', 'pz-promo-cms__footer-option-grid');
        (documentValue?.sections || []).filter((candidate: CmsDocument) => (
          candidate.type !== 'footer' && candidate.visible === true
        )).forEach((candidate: CmsDocument) => {
          const option = element('label', 'pz-promo-cms__check-option');
          const checkbox = element('input');
          checkbox.type = 'checkbox';
          checkbox.value = candidate.key;
          checkbox.checked = selectedLinks.has(candidate.key);
          checkbox.dataset.cmsFooterLink = '';
          option.append(checkbox, element('span', '', localized.navigation?.[candidate.key] || sectionLabels[candidate.type] || candidate.key));
          linkGrid.append(option);
        });
        footerLinks.append(linkGrid);

        const social = element('fieldset', 'pz-promo-cms__footer-options');
        social.append(element('legend', '', 'Redes sociales aprobadas'));
        social.append(element('p', 'pz-promo-cms__scope-note', 'Escribe solo el identificador público, sin @, dominio, URL ni protocolo.'));
        const socialByNetwork = new Map((section.config.social_profiles || []).map((profile: CmsDocument) => [profile.network, profile.handle]));
        const socialGrid = element('div', 'pz-promo-cms__footer-social-grid');
        PROMO_CMS_FOOTER_SOCIAL_NETWORKS.forEach((network) => {
          const field = inputField(`${network.label}: identificador`, socialByNetwork.get(network.key) || '', { max: 100 });
          field.control.dataset.cmsFooterSocial = network.key;
          field.control.setAttribute('autocomplete', 'off');
          socialGrid.append(field.label);
        });
        social.append(socialGrid);
        card.append(header, visible, fields, footerLinks, social);
        return card;
      } else {
        const note = element('p', 'pz-promo-cms__scope-note');
        note.textContent = section.type === 'contact'
          ? 'Los textos y métodos se editan en el módulo Contacto.'
          : 'CMS solo controla aquí el orden, la visibilidad y la etiqueta. Su contenido pertenece a un módulo posterior.';
        fields.append(note);
      }
      card.append(header, visible, fields);
      return card;
    }

    function renderContent() {
      if (!documentValue) return;
      const localized = documentValue.content_by_locale[locale];
      const name = root.querySelector<HTMLInputElement>('[data-cms-identity-name]');
      const slogan = root.querySelector<HTMLInputElement>('[data-cms-identity-slogan]');
      const summary = root.querySelector<HTMLTextAreaElement>('[data-cms-identity-summary]');
      if (name) name.value = localized.identity?.name || '';
      if (slogan) slogan.value = localized.identity?.slogan || '';
      if (summary) summary.value = localized.identity?.summary || '';
      const list = root.querySelector<HTMLElement>('[data-cms-sections]');
      if (!list) return;
      list.replaceChildren(...documentValue.sections.map((section: CmsDocument) => createSectionCard(section, localized)));
      updateServiceQuota();
    }

    function setContactControlState(card: HTMLElement) {
      const enabled = card.querySelector<HTMLInputElement>('[data-cms-action-enabled]')?.checked === true;
      card.querySelectorAll<HTMLInputElement>('[data-cms-primary], [data-cms-secondary]').forEach((control) => {
        control.disabled = !enabled || busy || !canSave;
        if (!enabled) control.checked = false;
      });
    }

    function updateDestination(card: HTMLElement) {
      const type = card.querySelector<HTMLSelectElement>('[data-cms-action-type]')?.value || 'phone';
      const destination = card.querySelector<HTMLInputElement>('[data-cms-action-destination]');
      if (!destination) return;
      destination.type = type === 'email' ? 'email' : 'tel';
      destination.placeholder = type === 'email' ? 'contacto@negocio.com' : '+13055550184';
      destination.pattern = type === 'email' ? '[^\\s@]+@[^\\s@]+\\.[^\\s@]+' : '\\+[1-9][0-9]{7,14}';
      destination.autocomplete = type === 'email' ? 'email' : 'tel';
    }

    function createContactAction(action: CmsDocument, localizedText: CmsDocument = {}) {
      const supported = PROMO_CMS_CONTACT_TYPES.includes(action.type);
      const card = element('article', 'pz-promo-cms__contact-action');
      card.dataset.cmsContactAction = action.key;
      card.dataset.preserve = supported ? 'false' : 'true';
      const header = element('header', 'pz-promo-cms__item-heading');
      const title = element('h4', '', localizedText.label || contactLabels[action.type] || 'Método de contacto');
      title.tabIndex = -1;
      header.append(title, element('span', 'pz-promo-cms__type', contactLabels[action.type] || action.type));
      card.append(header);
      if (!supported) {
        card.append(element('p', 'pz-promo-cms__scope-note', 'Este adaptador se conserva sin cambios y no puede habilitarse desde CMS.'));
        return card;
      }

      const fields = element('div', 'pz-promo-cms__fields two-columns');
      const typeLabel = element('label', 'pz-promo-cms__field');
      typeLabel.append(element('span', '', 'Tipo'));
      const select = element('select');
      select.dataset.cmsActionType = '';
      PROMO_CMS_CONTACT_TYPES.forEach((type) => {
        const option = element('option', '', contactLabels[type]);
        option.value = type;
        option.selected = action.type === type;
        select.append(option);
      });
      typeLabel.append(select);
      const destinationLabel = element('label', 'pz-promo-cms__field');
      destinationLabel.append(element('span', '', 'Destino'));
      const destination = element('input');
      destination.required = true;
      destination.maxLength = 254;
      destination.dataset.cmsActionDestination = '';
      destination.value = action.config?.phone_e164 || action.config?.email_address || '';
      destinationLabel.append(destination);
      const enabled = element('label', 'pz-promo-cms__switch compact');
      const enabledInput = element('input');
      enabledInput.type = 'checkbox';
      enabledInput.checked = action.enabled === true;
      enabledInput.dataset.cmsActionEnabled = '';
      enabled.append(enabledInput, element('span', '', 'Método disponible'));
      const label = inputField('Texto del botón', localizedText.label || '', { max: 80, data: 'label' });
      const aria = inputField('Nombre accesible', localizedText.aria_label || '', { max: 160, data: 'aria' });
      const message = inputField('Mensaje sugerido', localizedText.message || '', { textarea: true, max: 1000, data: 'message' });
      label.control.addEventListener('input', () => { title.textContent = label.control.value || contactLabels[select.value]; });
      fields.append(typeLabel, destinationLabel, enabled, label.label, aria.label, message.label);

      const choices = element('fieldset', 'pz-promo-cms__contact-priority');
      choices.append(element('legend', '', 'Prioridad'));
      const primaryLabel = element('label');
      const primary = element('input');
      primary.type = 'radio';
      primary.name = `promo-primary-${storeSlug}`;
      primary.value = action.key;
      primary.dataset.cmsPrimary = '';
      primaryLabel.append(primary, document.createTextNode(' Principal'));
      const secondaryLabel = element('label');
      const secondary = element('input');
      secondary.type = 'checkbox';
      secondary.value = action.key;
      secondary.dataset.cmsSecondary = '';
      secondaryLabel.append(secondary, document.createTextNode(' Secundario'));
      choices.append(primaryLabel, secondaryLabel);
      primary.addEventListener('change', () => { if (primary.checked) secondary.checked = false; });
      secondary.addEventListener('change', () => { if (secondary.checked) primary.checked = false; });
      enabledInput.addEventListener('change', () => setContactControlState(card));
      select.addEventListener('change', () => {
        updateDestination(card);
        title.textContent = label.control.value || contactLabels[select.value];
      });
      card.append(fields, choices);
      updateDestination(card);
      setContactControlState(card);
      return card;
    }

    function syncContactPriorities() {
      if (!documentValue) return;
      root.querySelectorAll<HTMLElement>('[data-cms-contact-action]').forEach((card) => {
        const key = card.dataset.cmsContactAction || '';
        const primary = card.querySelector<HTMLInputElement>('[data-cms-primary]');
        const secondary = card.querySelector<HTMLInputElement>('[data-cms-secondary]');
        if (primary) primary.checked = documentValue?.contact.primary_action_key === key;
        if (secondary) secondary.checked = documentValue?.contact.secondary_action_keys?.includes(key) === true;
      });
    }

    function renderQrPreview() {
      const preview = root.querySelector<HTMLElement>('[data-cms-qr-preview]');
      if (!preview || !documentValue) return;
      preview.replaceChildren();
      const assetId = documentValue.media_refs?.[qrUseKey]?.asset_id || '';
      if (!qrUseKey || !/^[a-z0-9]{15}$/.test(assetId)) {
        preview.append(element('span', '', 'Sin QR'));
        return;
      }
      const image = element('img');
      image.src = `${mediaEndpoint}&asset=${encodeURIComponent(assetId)}`;
      image.alt = 'Vista previa del código QR';
      image.width = 192;
      image.height = 192;
      preview.append(image);
    }

    function renderLogoPreview() {
      const preview = root.querySelector<HTMLElement>('[data-cms-logo-preview]');
      if (!preview || !documentValue) return;
      preview.replaceChildren();
      const assetId = documentValue.media_refs?.[logoUseKey]?.asset_id || '';
      if (!logoUseKey || !/^[a-z0-9]{15}$/.test(assetId)) {
        preview.append(element('span', '', 'Sin logo'));
        return;
      }
      const image = element('img');
      image.src = `${mediaEndpoint}&asset=${encodeURIComponent(assetId)}`;
      image.alt = 'Vista previa del logo del negocio';
      image.width = 192;
      image.height = 192;
      preview.append(image);
    }

    async function uploadLogo() {
      const file = root.querySelector<HTMLInputElement>('[data-cms-logo-file]')?.files?.[0];
      if (!documentValue || !file || !canManageMedia || busy) return;
      clearError();
      setBusy(true, 'Procesando logo…');
      try {
        const payload = new FormData();
        payload.append('file', file);
        payload.append('purpose', 'logo');
        payload.append('poster_asset_id', '');
        const response = await fetch(mediaEndpoint, {
          method: 'POST', body: payload, headers: { Accept: 'application/json' }, credentials: 'same-origin',
        });
        const result = await response.json().catch(() => null);
        const assetId = String(result?.asset?.asset_id || '');
        if (!response.ok || result?.ok !== true || !/^[a-z0-9]{15}$/.test(assetId)
          || result.asset?.purpose !== 'logo' || Number(result.asset?.width) < 256 || Number(result.asset?.height) < 256) {
          throw Object.assign(new Error('promo_media_upload_failed'), { code: result?.error });
        }
        if (!logoUseKey) {
          logoUseKey = 'logo-business';
          if (documentValue.media_refs[logoUseKey]) {
            const random = crypto.getRandomValues(new Uint32Array(1))[0].toString(36);
            logoUseKey = `logo-business-${random}`.slice(0, 120);
          }
        }
        documentValue.media_refs[logoUseKey] = { asset_id: assetId, purpose: 'logo' };
        Object.values(documentValue.content_by_locale).forEach((content: any) => {
          const businessName = String(content?.identity?.name || '').trim();
          content.media_alt[logoUseKey] = { alt: businessName ? `Logo de ${businessName}` : 'Logo del negocio', decorative: false };
        });
        documentValue.contact.logo_media_use_key = logoUseKey;
        renderLogoPreview();
        setDirty();
        if (status) {
          status.hidden = false;
          status.querySelector('span:last-child')!.textContent = 'Logo procesado. Guarda los cambios para actualizar la página y su vista previa social.';
        }
      } catch (error) {
        showError((error as { code?: string })?.code || 'promo_media_upload_failed');
      } finally {
        setBusy(false, '');
      }
    }

    function removeLogo() {
      if (!documentValue || !logoUseKey || !canSave) return;
      delete documentValue.media_refs[logoUseKey];
      Object.values(documentValue.content_by_locale).forEach((content: any) => delete content.media_alt[logoUseKey]);
      documentValue.contact.logo_media_use_key = '';
      logoUseKey = '';
      renderLogoPreview();
      setDirty();
    }

    async function uploadQr() {
      const file = root.querySelector<HTMLInputElement>('[data-cms-qr-file]')?.files?.[0];
      if (!documentValue || !file || !canManageMedia || busy) return;
      clearError();
      setBusy(true, 'Procesando QR…');
      try {
        const payload = new FormData();
        payload.append('file', file);
        payload.append('purpose', 'qr');
        payload.append('poster_asset_id', '');
        const response = await fetch(mediaEndpoint, {
          method: 'POST', body: payload, headers: { Accept: 'application/json' }, credentials: 'same-origin',
        });
        const result = await response.json().catch(() => null);
        const assetId = String(result?.asset?.asset_id || '');
        if (!response.ok || result?.ok !== true || !/^[a-z0-9]{15}$/.test(assetId)
          || result.asset?.purpose !== 'qr' || Number(result.asset?.width) !== 512 || Number(result.asset?.height) !== 512) {
          throw Object.assign(new Error('promo_media_upload_failed'), { code: result?.error });
        }
        if (!qrUseKey) {
          qrUseKey = 'qr-contact';
          if (documentValue.media_refs[qrUseKey]) {
