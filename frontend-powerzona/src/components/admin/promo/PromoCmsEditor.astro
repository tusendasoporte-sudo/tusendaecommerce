---
import type { PromoCmsScope } from '../../../lib/promoCms';
import '../../../styles/promo-gallery.css';
import '../../../styles/promo-cms.css';

interface Props {
  storeSlug: string;
  scope: PromoCmsScope;
  maxServices?: number;
  canSave: boolean;
  canManageMedia?: boolean;
}

const {
  storeSlug,
  scope,
  maxServices = 0,
  canSave,
  canManageMedia = false,
} = Astro.props;
const isContent = scope === 'content';
---

<section
  class="pz-promo-cms"
  data-promo-cms
  data-store-slug={storeSlug}
  data-scope={scope}
  data-max-services={maxServices}
  data-can-save={canSave ? 'true' : 'false'}
  data-can-manage-media={canManageMedia ? 'true' : 'false'}
  aria-labelledby="promo-cms-title"
>
  <header class="pz-promo-cms__intro">
    <div>
      <span class="pz-promo-cms__kicker">Página pública en vivo</span>
      <h2 id="promo-cms-title">{isContent ? 'Organización del contenido' : 'Canales de contacto'}</h2>
      <p>
        {isContent
          ? 'Organiza identidad, portada, servicios, propietario y pie del sitio. Guardar actualiza la página automáticamente.'
          : 'Configura el logo, canales, QR y el método principal. Guardar actualiza la página automáticamente.'}
      </p>
    </div>
    <div class="pz-promo-cms__draft-meta" aria-label="Estado de la página">
      <span data-cms-locale>Idioma base: —</span>
    </div>
  </header>

  {!canSave && (
    <div class="pz-promo-cms__notice is-warning" role="status">
      <strong>Acceso de solo lectura</strong>
      <p>
        {isContent
          ? 'Esta sesión no puede guardar contenido Promo.'
          : 'Para guardar contacto se requieren conjuntamente Contenido y Contacto, tal como exige el backend.'}
      </p>
    </div>
  )}

  <div class="pz-promo-cms__notice" role="status" aria-live="polite" data-cms-status data-promo-feedback>
    <span class="pz-promo-cms__spinner" aria-hidden="true"></span>
    <span>Cargando la página segura…</span>
  </div>

  <div class="pz-promo-cms__error" role="alert" tabindex="-1" data-cms-error hidden>
    <strong>No se pudo continuar</strong>
    <p data-cms-error-message></p>
    <a href={`/t/${storeSlug}/admin/promo/gallery`} data-cms-error-action hidden>Ir a Galería y productos</a>
    <button type="button" data-cms-reload>Recargar página</button>
  </div>

  <form class="pz-promo-cms__form" data-cms-form hidden novalidate>
    {isContent ? (
      <>
        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-promo-accordion-group="promo-cms-panels" open aria-labelledby="cms-identity-title">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">01</span>
            <div>
              <h3 id="cms-identity-title">Identidad pública</h3>
              <p>Nombre, slogan, botón global y resumen público del negocio.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-cms__fields two-columns">
            <label class="pz-promo-cms__field">
              <span>Nombre público</span>
              <input type="text" maxlength="140" autocomplete="organization" data-cms-identity-name />
              <small>Máximo 140 caracteres.</small>
            </label>
            <label class="pz-promo-cms__field">
              <span>Slogan</span>
              <input type="text" maxlength="120" data-cms-identity-slogan />
              <small>Frase opcional bajo el nombre; máximo 120 caracteres.</small>
            </label>
            <label class="pz-promo-cms__field is-wide">
              <span>Resumen del negocio</span>
              <textarea rows="4" maxlength="600" data-cms-identity-summary></textarea>
              <small>Texto plano, sin HTML, scripts ni URLs.</small>
            </label>
            <label class="pz-promo-cms__field is-wide">
              <span>Texto global del botón de contacto</span>
              <input type="text" maxlength="80" placeholder="Ej. Contáctame, Escríbeme por WhatsApp o WhatsApp" data-cms-identity-contact-cta />
              <small>Se usa en todos los botones de contacto y cotización de la página Promo. El destino continúa configurándose en Contacto.</small>
            </label>
          </div>
        </details>

        <div class="pz-promo-cms__section-list is-root" data-cms-sections></div>
      </>
    ) : (
      <>
        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-promo-accordion-group="promo-cms-panels" data-cms-contact-panel="presentation">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">01</span>
            <div>
              <h3 id="cms-contact-section-title">Presentación de contacto</h3>
              <p>Controla la visibilidad y los textos que aparecen en la página pública.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-cms__fields two-columns">
            <label class="pz-promo-cms__switch is-wide">
              <input type="checkbox" data-cms-contact-section-visible />
              <span><strong>Mostrar sección de contacto</strong><small>Puede permanecer oculta hasta que completes la información.</small></span>
            </label>
            <label class="pz-promo-cms__field">
              <span>Etiqueta de navegación</span>
              <input type="text" required maxlength="80" data-cms-contact-navigation />
            </label>
            <label class="pz-promo-cms__field">
              <span>Título de la sección</span>
              <input type="text" maxlength="160" data-cms-contact-heading />
            </label>
            <label class="pz-promo-cms__field is-wide">
              <span>Resumen</span>
              <textarea rows="3" maxlength="600" data-cms-contact-summary></textarea>
            </label>
          </div>
        </details>

        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-promo-accordion-group="promo-cms-panels" data-cms-contact-panel="logo">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">02</span>
            <div>
              <h3 id="cms-contact-logo-title">Logo del negocio</h3>
              <p>Se reutiliza en la cabecera pública y como imagen de vista previa al compartir por WhatsApp.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-gallery pz-promo-cms__media-slots">
            <section class="pz-promo-media-slots">
              <header class="pz-promo-media-slots__header">
                <strong>Imagen del logo</strong>
                <span data-cms-logo-count>0 de 1 utilizados</span>
              </header>
              <div class="pz-promo-media-slots__grid">
                <article class="pz-promo-media-slot pz-promo-cms__media-slot is-empty" data-cms-logo-slot>
                  <div class="pz-promo-media-slot__heading">
                    <strong>Espacio 1</strong>
                    <span data-cms-logo-state>Disponible</span>
                  </div>
                  <div class="pz-promo-media-slot__empty" data-cms-logo-preview>
                    <strong>Arrastra una imagen aquí</strong>
                    <span>o selecciónala desde tu dispositivo</span>
                  </div>
                  <div class="pz-promo-media-slot__actions">
                    <button class="pz-promo-gallery__secondary" type="button" data-cms-choose-logo disabled={!canManageMedia || !canSave}>Elegir imagen</button>
                    <input class="pz-promo-media-slot__input" type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-cms-logo-file disabled={!canManageMedia || !canSave} />
                    <button class="is-danger" type="button" data-cms-remove-logo disabled={!canManageMedia || !canSave}>Quitar</button>
                  </div>
                  <small class="pz-promo-media-slot__guidance" data-cms-logo-guidance>JPG, PNG, WebP o AVIF · ideal 2:1 · WebP 511×256, sin recorte ni metadatos al guardar</small>
                </article>
              </div>
            </section>
          </div>
        </details>

        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-promo-accordion-group="promo-cms-panels" data-cms-contact-panel="qr">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">03</span>
            <div>
              <h3 id="cms-contact-qr-title">Código QR propio</h3>
              <p>Sube una imagen de QR; se convertirá a WebP 512×512 con fondo blanco y sin recorte.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-gallery pz-promo-cms__media-slots">
            <section class="pz-promo-media-slots">
              <header class="pz-promo-media-slots__header">
                <strong>Imagen del QR</strong>
                <span data-cms-qr-count>0 de 1 utilizados</span>
              </header>
              <div class="pz-promo-media-slots__grid">
                <article class="pz-promo-media-slot pz-promo-cms__media-slot is-empty" data-cms-qr-slot>
                  <div class="pz-promo-media-slot__heading">
                    <strong>Espacio 1</strong>
                    <span data-cms-qr-state>Disponible</span>
                  </div>
                  <div class="pz-promo-media-slot__empty" data-cms-qr-preview>
                    <strong>Arrastra una imagen aquí</strong>
                    <span>o selecciónala desde tu dispositivo</span>
                  </div>
                  <div class="pz-promo-media-slot__actions">
                    <button class="pz-promo-gallery__secondary" type="button" data-cms-choose-qr disabled={!canManageMedia || !canSave}>Elegir imagen</button>
                    <input class="pz-promo-media-slot__input" type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-cms-qr-file disabled={!canManageMedia || !canSave} />
                    <button class="is-danger" type="button" data-cms-remove-qr disabled={!canManageMedia || !canSave}>Quitar</button>
                  </div>
                  <small class="pz-promo-media-slot__guidance" data-cms-qr-guidance>JPG, PNG, WebP o AVIF · QR cuadrado · WebP 512×512, fondo blanco, sin recorte ni metadatos</small>
                </article>
              </div>
            </section>
          </div>
        </details>

        <details class="pz-promo-cms__panel pz-promo-cms__accordion" data-promo-accordion-group="promo-cms-panels" data-cms-contact-panel="methods">
          <summary class="pz-promo-cms__panel-heading pz-promo-cms__accordion-summary">
            <span class="pz-promo-cms__step" aria-hidden="true">04</span>
            <div>
              <h3 id="cms-contact-actions-title">Métodos permitidos</h3>
              <p>WhatsApp y teléfono exigen E.164; correo exige una dirección válida. No se aceptan URLs.</p>
            </div>
            <span class="pz-promo-cms__accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="pz-promo-cms__panel-toolbar">
            <button class="pz-promo-cms__secondary-button" type="button" data-cms-add-contact>Añadir método</button>
          </div>
          <label class="pz-promo-cms__switch pz-promo-cms__contact-master">
            <input type="checkbox" data-cms-contact-enabled />
            <span><strong>Habilitar contacto en la página</strong><small>Al habilitarlo debes elegir un método principal disponible.</small></span>
          </label>
          <div class="pz-promo-cms__action-list" data-cms-contact-actions></div>
        </details>
      </>
    )}

    <footer class="pz-promo-cms__actions">
      <div>
        <strong data-cms-unsaved>Sin cambios pendientes</strong>
        <small>Al guardar, la página pública se actualiza automáticamente después de validar permisos, medios y contenido.</small>
      </div>
      <button class="pz-promo-cms__save" type="submit" data-cms-save disabled>
        <span data-cms-save-label>Guardar cambios</span>
      </button>
    </footer>
  </form>
</section>

<script>
  import {
    buildPromoCmsContactDocument,
    buildPromoCmsContentDocument,
    createPromoCmsWorkspace,
    isPromoCmsWorkGalleryReady,
    normalizePromoCmsDraftResponse,
    PROMO_CMS_API_PATH,
    PROMO_CMS_CONTACT_TYPES,
    PROMO_CMS_FOOTER_MAX_LINKS,
    PROMO_CMS_FOOTER_SOCIAL_NETWORKS,
    PROMO_CMS_HERO_BUTTON_TARGETS,
    PROMO_CMS_HERO_LAYOUTS,
    PROMO_CMS_HERO_MAX_BUTTONS,
    PROMO_CMS_HERO_MAX_HIGHLIGHTS,
    PROMO_CMS_WORK_GALLERY_KEY,
    promoCmsErrorMessage,
  } from '../../../lib/promoCms';
  import { PROMO_SERVICE_ICON_OPTIONS } from '../../../lib/promoServiceIcons';
  import { optimizePromoUploadImageFile } from '../../../lib/promoImageOptimizationCore.js';

  type CmsDocument = Record<string, any>;

  const sectionLabels: Record<string, string> = {
    hero: 'Portada',
    services: 'Servicios',
    featured_work: 'Trabajo destacado',
    gallery: 'Galería',
    owner: 'Propietario',
    store_rating: 'Reseñas de tienda',
    contact: 'Contacto y QR',
    footer: 'Pie del sitio',
  };
  const contactLabels: Record<string, string> = {
    whatsapp: 'WhatsApp',
    phone: 'Teléfono',
    email: 'Correo',
    internal_form: 'Formulario interno',
    approved_live_chat: 'Live Chat aprobado',
  };

  document.querySelectorAll<HTMLElement>('[data-promo-cms]').forEach((root) => {
    const storeSlug = root.dataset.storeSlug || '';
    const scope = root.dataset.scope === 'contact' ? 'contact' : 'content';
    const maxServices = Number(root.dataset.maxServices || 0);
    const canSave = root.dataset.canSave === 'true';
    const canManageMedia = root.dataset.canManageMedia === 'true';
    const endpoint = `${PROMO_CMS_API_PATH}?store=${encodeURIComponent(storeSlug)}`;
    const mediaEndpoint = `/api/admin/promo-media?store=${encodeURIComponent(storeSlug)}`;
    const form = root.querySelector<HTMLFormElement>('[data-cms-form]');
    const status = root.querySelector<HTMLElement>('[data-cms-status]');
    const errorBox = root.querySelector<HTMLElement>('[data-cms-error]');
    const errorMessage = root.querySelector<HTMLElement>('[data-cms-error-message]');
    const errorAction = root.querySelector<HTMLAnchorElement>('[data-cms-error-action]');
    const reloadButton = root.querySelector<HTMLButtonElement>('[data-cms-reload]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-cms-save]');
    const saveLabel = root.querySelector<HTMLElement>('[data-cms-save-label]');
    const unsaved = root.querySelector<HTMLElement>('[data-cms-unsaved]');
    let version = 0;
    let documentValue: CmsDocument | null = null;
    let locale = '';
    let dirty = false;
    let busy = false;
    let logoUseKey = '';
    let qrUseKey = '';
    let pendingLogoFile: File | null = null;
    let pendingQrFile: File | null = null;
    let pendingLogoPreviewUrl = '';
    let pendingQrPreviewUrl = '';
    let logoCardError = '';
    let qrCardError = '';

    function element<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className = '',
      text = '',
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    }

    function inputField(
      labelText: string,
      value: string,
      options: { textarea?: boolean; max?: number; required?: boolean; data?: string } = {},
    ) {
      const label = element('label', 'pz-promo-cms__field');
      label.append(element('span', '', labelText));
      const control = options.textarea ? element('textarea') : element('input');
      if (control instanceof HTMLTextAreaElement) control.rows = 3;
      if (control instanceof HTMLInputElement) control.type = 'text';
      control.value = value || '';
      if (options.max) control.maxLength = options.max;
      if (options.required) control.required = true;
      if (options.data) control.dataset.cmsField = options.data;
      label.append(control);
      return { label, control };
    }

    function setDirty(next = true) {
      dirty = next;
      if (unsaved) unsaved.textContent = dirty ? 'Cambios sin guardar' : 'Sin cambios pendientes';
      if (saveButton) saveButton.disabled = !canSave || !dirty || busy;
    }

    function setBusy(next: boolean, message: string) {
      busy = next;
      root.setAttribute('aria-busy', next ? 'true' : 'false');
      if (saveButton) saveButton.disabled = next || !canSave || !dirty;
      if (saveLabel) saveLabel.textContent = next ? message : 'Guardar cambios';
      form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((control) => {
        control.disabled = next || !canSave;
      });
      form?.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
        if (button !== saveButton) button.disabled = next || !canSave;
      });
      if (!next) {
        updateServiceQuota();
        root.querySelectorAll<HTMLElement>('[data-cms-contact-action]').forEach(setContactControlState);
        const logoFile = root.querySelector<HTMLInputElement>('[data-cms-logo-file]');
        if (logoFile) logoFile.disabled = !canManageMedia || !canSave;
        const logoChoose = root.querySelector<HTMLButtonElement>('[data-cms-choose-logo]');
        if (logoChoose) logoChoose.disabled = !canManageMedia || !canSave;
        const qrFile = root.querySelector<HTMLInputElement>('[data-cms-qr-file]');
        if (qrFile) qrFile.disabled = !canManageMedia || !canSave;
        const qrChoose = root.querySelector<HTMLButtonElement>('[data-cms-choose-qr]');
        if (qrChoose) qrChoose.disabled = !canManageMedia || !canSave;
        if (scope === 'contact' && documentValue) {
          renderLogoPreview();
          renderQrPreview();
        }
      }
    }

    function showError(code: unknown) {
      const workGalleryIncomplete = String(code || '') === 'promo_work_gallery_incomplete';
      if (errorMessage) errorMessage.textContent = promoCmsErrorMessage(code);
      if (errorAction) errorAction.hidden = !workGalleryIncomplete;
      if (reloadButton) reloadButton.hidden = workGalleryIncomplete;
      if (errorBox) {
        errorBox.hidden = false;
        errorBox.focus();
      }
    }

    function clearError() {
      if (errorBox) errorBox.hidden = true;
      if (errorMessage) errorMessage.textContent = '';
      if (errorAction) errorAction.hidden = true;
      if (reloadButton) reloadButton.hidden = false;
    }

    function updateMeta() {
      const localeNode = root.querySelector<HTMLElement>('[data-cms-locale]');
      if (localeNode) localeNode.textContent = `Idioma base: ${locale || '—'}`;
    }

    function serviceTotal() {
      return root.querySelectorAll('[data-cms-service-item]').length;
    }

    function updateServiceQuota() {
      const count = serviceTotal();
      root.querySelectorAll<HTMLElement>('[data-cms-service-count]').forEach((node) => {
        node.textContent = `${count} de ${maxServices}`;
      });
      root.querySelectorAll<HTMLButtonElement>('[data-cms-add-service]').forEach((button) => {
        button.disabled = busy || !canSave || count >= maxServices;
      });
    }

    function moveCard(card: HTMLElement, direction: -1 | 1) {
      const sibling = direction < 0 ? card.previousElementSibling : card.nextElementSibling;
      if (!(sibling instanceof HTMLElement)) return;
      if (direction < 0) card.parentElement?.insertBefore(card, sibling);
      else card.parentElement?.insertBefore(sibling, card);
      setDirty();
      card.querySelector<HTMLElement>('h4')?.focus();
    }

    function actionButtons(card: HTMLElement, label: string) {
      const controls = element('div', 'pz-promo-cms__order-controls');
      const up = element('button', '', 'Subir');
      up.type = 'button';
      up.setAttribute('aria-label', `Subir ${label}`);
      up.addEventListener('click', (event) => { event.preventDefault(); event.stopPropagation(); moveCard(card, -1); });
      const down = element('button', '', 'Bajar');
      down.type = 'button';
      down.setAttribute('aria-label', `Bajar ${label}`);
      down.addEventListener('click', (event) => { event.preventDefault(); event.stopPropagation(); moveCard(card, 1); });
      controls.append(up, down);
      return controls;
    }

    function updateSectionOrderControls() {
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cms-section-key]'));
      cards.forEach((card, index) => {
        const up = card.querySelector<HTMLButtonElement>('[data-cms-section-move="up"]');
        const down = card.querySelector<HTMLButtonElement>('[data-cms-section-move="down"]');
        if (up) up.hidden = index === 0 || cards[index - 1]?.dataset.cmsSectionType === 'hero';
        if (down) down.hidden = index === cards.length - 1 || cards[index + 1]?.dataset.cmsSectionType === 'footer';
      });
    }

    function sectionActionButtons(card: HTMLElement, label: string, sectionType: string) {
      if (sectionType === 'hero' || sectionType === 'footer') return null;
      const controls = element('div', 'pz-promo-cms__order-controls');
      const addMoveButton = (direction: -1 | 1, text: string) => {
        const button = element('button', '', text);
        button.type = 'button';
        button.dataset.cmsSectionMove = direction < 0 ? 'up' : 'down';
        button.setAttribute('aria-label', text + ' ' + label);
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const sibling = direction < 0 ? card.previousElementSibling : card.nextElementSibling;
          const fixedType = sibling instanceof HTMLElement ? sibling.dataset.cmsSectionType : '';
          if (fixedType === 'hero' || fixedType === 'footer') return;
          moveCard(card, direction);
          updateSectionOrderControls();
        });
        controls.append(button);
      };
      addMoveButton(-1, 'Subir');
      addMoveButton(1, 'Bajar');
      return controls;
    }
    function createServiceItem(item: CmsDocument, sectionKey: string, galleryKey = '', iconKey = '') {
      const card = element('details', 'pz-promo-cms__service-item pz-promo-cms__accordion') as HTMLDetailsElement;
      card.dataset.promoAccordionGroup = 'promo-cms-service-items';
      card.dataset.cmsServiceItem = item.key;
      card.dataset.cmsServicePortfolioKey = galleryKey;
      const header = element('summary', 'pz-promo-cms__item-heading pz-promo-cms__accordion-summary');
      const title = element('h5', '', item.name || 'Servicio sin nombre');
      title.tabIndex = -1;
      const controls = actionButtons(card, 'servicio');
      const remove = element('button', 'is-danger', 'Quitar');
      remove.type = 'button';
      remove.setAttribute('aria-label', `Quitar servicio ${item.name || item.key}`);
      remove.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        card.remove();
        updateServiceQuota();
        setDirty();
      });
      controls.append(remove);
      header.append(title, controls, element('span', 'pz-promo-cms__accordion-chevron', '⌄'));
      const fields = element('div', 'pz-promo-cms__fields two-columns');
      const name = inputField('Nombre del servicio', item.name || '', { max: 160, data: 'name' });
      const icon = element('label', 'pz-promo-cms__field');
      icon.append(element('span', '', 'Icono del servicio'));
      const iconSelect = element('select');
      iconSelect.dataset.cmsField = 'iconKey';
      const emptyIcon = element('option', '', 'Sin icono');
      emptyIcon.value = '';
      iconSelect.append(emptyIcon);
      PROMO_SERVICE_ICON_OPTIONS.forEach((iconOption) => {
        const option = element('option', '', iconOption.label);
        option.value = iconOption.key;
        option.selected = iconOption.key === iconKey;
        iconSelect.append(option);
      });
      icon.append(
        iconSelect,
        element('small', '', 'Elige un icono lineal aprobado. No consume la cuota de fotos.'),
      );
      const summary = inputField('Resumen', item.summary || '', { textarea: true, max: 600, data: 'summary' });
      const caption = inputField('Nota o caption', item.caption || '', { max: 500, data: 'caption' });
      const categoryNote = element('p', 'pz-promo-cms__scope-note', 'La foto, las ofertas y los productos de este servicio se administran en «Galería y productos».');
      name.control.addEventListener('input', () => { title.textContent = name.control.value || 'Servicio sin nombre'; });
      fields.append(name.label, icon, summary.label, caption.label, categoryNote);
      card.dataset.sectionKey = sectionKey;
      card.append(header, fields);
      return card;
    }

    function createSectionCard(section: CmsDocument, localized: CmsDocument) {
      const isWorkSection = section.key === PROMO_CMS_WORK_GALLERY_KEY;
      const labelText = isWorkSection ? 'Trabajos realizados' : (sectionLabels[section.type] || 'Sección');
      const sectionContent = localized.sections?.[section.key] || {};
      const card = element('details', 'pz-promo-cms__section-card pz-promo-cms__accordion') as HTMLDetailsElement;
      card.dataset.promoAccordionGroup = 'promo-cms-sections';
      card.dataset.cmsSectionKey = section.key;
      card.dataset.cmsSectionType = section.type;
      const header = element('summary', 'pz-promo-cms__section-card-heading pz-promo-cms__accordion-summary');
      const titleGroup = element('div');
      titleGroup.append(element('span', 'pz-promo-cms__type', labelText));
      const title = element('h4', '', localized.navigation?.[section.key] || labelText);
      title.tabIndex = -1;
      titleGroup.append(title);
      const controls = sectionActionButtons(card, `sección ${labelText}`, section.type);
      header.append(titleGroup);
      if (controls) header.append(controls);
      header.append(element('span', 'pz-promo-cms__accordion-chevron', '⌄'));

      const visible = element('label', 'pz-promo-cms__switch compact');
      const visibleInput = element('input');
      visibleInput.type = 'checkbox';
      visibleInput.checked = section.visible === true;
      visibleInput.dataset.cmsField = 'visible';
      visible.append(visibleInput, element('span', '', 'Visible en la página'));

      const fields = element('div', 'pz-promo-cms__fields two-columns');
      const navigation = inputField('Etiqueta de navegación', localized.navigation?.[section.key] || labelText, {
        max: 80, required: true, data: 'navigation',
      });
      navigation.control.addEventListener('input', () => { title.textContent = navigation.control.value || labelText; });
      fields.append(navigation.label);

      if (section.type === 'hero') {
        fields.append(
          inputField('Introducción de portada', sectionContent.intro || '', { max: 120, data: 'intro' }).label,
          inputField('Título de portada', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Resumen corto', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
        );
        const layouts = element('fieldset', 'pz-promo-cms__hero-layouts');
        layouts.append(element('legend', '', 'Diseño de portada'));
        const layoutLabels: Record<string, string> = {
          immersive: 'Inmersiva', split: 'Dividida', centered: 'Centrada', editorial: 'Editorial',
        };
        PROMO_CMS_HERO_LAYOUTS.forEach((layout) => {
          const option = element('label', 'pz-promo-cms__hero-layout');
          const input = element('input'); input.type = 'radio'; input.name = `hero-layout-${section.key}`;
          input.value = layout; input.dataset.cmsHeroLayout = '';
          input.checked = (section.config.layout || 'immersive') === layout;
          option.append(input, element('strong', '', layoutLabels[layout] || layout)); layouts.append(option);
        });
        const dynamicList = (className: string, dataName: string) => {
          const list = element('div', className); list.dataset[dataName] = ''; return list;
        };
        const highlights = dynamicList('pz-promo-cms__hero-list', 'cmsHeroHighlights');
        const addHighlight = (value = '') => {
          if (highlights.children.length >= PROMO_CMS_HERO_MAX_HIGHLIGHTS) return;
          const row = element('div', 'pz-promo-cms__hero-row');
          const input = element('input'); input.type = 'text'; input.maxLength = 80; input.value = value;
          input.placeholder = 'Ej. Alfombras'; input.dataset.cmsHeroHighlight = '';
          const remove = element('button', 'is-danger', 'Quitar'); remove.type = 'button';
          remove.addEventListener('click', () => { row.remove(); setDirty(); });
          row.append(input, remove); highlights.append(row);
        };
        (Array.isArray(sectionContent.highlights) ? sectionContent.highlights : []).forEach(addHighlight);
        const addHighlightButton = element('button', 'pz-promo-cms__secondary-button', 'Añadir especialidad');
        addHighlightButton.type = 'button'; addHighlightButton.addEventListener('click', () => { addHighlight(); setDirty(); });
        const highlightGroup = element('div', 'pz-promo-cms__hero-group');
        highlightGroup.append(element('strong', '', `Especialidades (máximo ${PROMO_CMS_HERO_MAX_HIGHLIGHTS})`), highlights, addHighlightButton);

        const buttonLabels: Record<string, string> = {
          'primary-contact': 'Contacto principal', 'contact-section': 'Sección Contacto',
          'services-section': 'Sección Servicios', 'work-section': 'Trabajos realizados',
        };
        const buttons = dynamicList('pz-promo-cms__hero-list', 'cmsHeroButtons');
        const localizedButtonLabels = Array.isArray(sectionContent.button_labels) ? sectionContent.button_labels : [];
        const defaultGlobalContactCta = String(localized.identity?.contact_cta_label || (
          locale.startsWith('es') ? 'Solicitar estimado' : 'Request an estimate'
        ));
        const globalContactCta = () => String(
          root.querySelector<HTMLInputElement>('[data-cms-identity-contact-cta]')?.value || defaultGlobalContactCta,
        );
        const addHeroButton = (target = 'primary-contact', label = '') => {
          if (buttons.children.length >= PROMO_CMS_HERO_MAX_BUTTONS) return;
          const row = element('div', 'pz-promo-cms__hero-row is-button');
          const select = element('select'); select.dataset.cmsHeroButtonTarget = '';
          PROMO_CMS_HERO_BUTTON_TARGETS.forEach((value) => {
            const option = element('option', '', buttonLabels[value] || value); option.value = value;
            option.selected = value === target; select.append(option);
          });
          const input = element('input'); input.type = 'text'; input.maxLength = 80; input.value = label;
          input.placeholder = 'Texto del botón'; input.dataset.cmsHeroButtonLabel = '';
          let customLabel = label;
          const syncLabelSource = () => {
            const usesGlobalLabel = select.value === 'primary-contact';
            input.disabled = usesGlobalLabel;
            input.value = usesGlobalLabel ? globalContactCta() : customLabel;
            input.placeholder = usesGlobalLabel ? 'Usa el texto global configurado arriba' : 'Texto del botón';
          };
          input.addEventListener('input', () => { if (!input.disabled) customLabel = input.value; });
          select.addEventListener('change', syncLabelSource);
          syncLabelSource();
          const remove = element('button', 'is-danger', 'Quitar'); remove.type = 'button';
          remove.addEventListener('click', () => { row.remove(); setDirty(); });
          row.append(select, input, remove); buttons.append(row);
        };
        (section.config.button_targets || ['primary-contact']).forEach((target: string, index: number) => (
          addHeroButton(target, localizedButtonLabels[index] || '')
        ));
        const addButton = element('button', 'pz-promo-cms__secondary-button', 'Añadir botón');
        addButton.type = 'button'; addButton.addEventListener('click', () => {
          const used = new Set(Array.from(buttons.querySelectorAll<HTMLSelectElement>('[data-cms-hero-button-target]')).map((select) => select.value));
          addHeroButton(PROMO_CMS_HERO_BUTTON_TARGETS.find((target) => !used.has(target)) || 'primary-contact'); setDirty();
        });
        const buttonGroup = element('div', 'pz-promo-cms__hero-group');
        buttonGroup.append(element('strong', '', `Botones (máximo ${PROMO_CMS_HERO_MAX_BUTTONS})`), buttons, addButton);
        fields.append(layouts, highlightGroup, buttonGroup,
          element('p', 'pz-promo-cms__scope-note', 'Las imágenes del carrusel se administran en «Galería y productos» y siempre aparecen detrás del texto en los diseños superpuestos.'));
      } else if (section.type === 'services') {
        fields.append(
          inputField('Título de servicios', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Resumen de servicios', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
        );
        const serviceHeader = element('div', 'pz-promo-cms__subheading');
        const serviceTitle = element('div');
        serviceTitle.append(element('strong', '', 'Servicios'));
        const count = element('small', '', '');
        count.dataset.cmsServiceCount = '';
        serviceTitle.append(count);
        const add = element('button', 'pz-promo-cms__secondary-button', 'Añadir servicio');
        add.type = 'button';
        add.dataset.cmsAddService = '';
        const list = element('div', 'pz-promo-cms__service-list');
        list.dataset.cmsServiceList = '';
        const localizedItems = Array.isArray(sectionContent.items) ? sectionContent.items : [];
        const itemByKey = new Map(localizedItems.map((item: CmsDocument) => [item.key, item]));
        const orderedKeys = [...new Set([...(section.config.item_keys || []), ...localizedItems.map((item: CmsDocument) => item.key)])];
        orderedKeys.forEach((itemKey, index) => list.append(createServiceItem(
          itemByKey.get(itemKey) || { key: itemKey, name: '', summary: '', caption: '' },
          section.key,
          section.config.gallery_keys?.[index] || '',
          section.config.icon_keys?.[index] || '',
        )));
        add.addEventListener('click', () => {
          if (serviceTotal() >= maxServices) return;
          const random = crypto.getRandomValues(new Uint32Array(1))[0].toString(36);
          const item = { key: `service-${random}`.slice(0, 64), name: '', summary: '', caption: '' };
          const next = createServiceItem(item, section.key);
          list.append(next);
          updateServiceQuota();
          setDirty();
          next.querySelector<HTMLInputElement>('[data-cms-field="name"]')?.focus();
        });
        serviceHeader.append(serviceTitle, add);
        card.append(header, visible, fields, serviceHeader, list);
        return card;
      } else if (section.type === 'gallery' && isWorkSection) {
        fields.append(
          inputField('Título de trabajos realizados', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Resumen de trabajos realizados', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
          element('p', 'pz-promo-cms__scope-note', 'Las fotos del proceso o resultado se administran en «Galería y productos». Cada trabajo admite hasta 3 fotos.'),
        );
      } else if (section.type === 'owner') {
        fields.append(
          inputField('Título de propietario', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Nombre público', sectionContent.name || '', { max: 140, data: 'name' }).label,
          inputField('Biografía', sectionContent.bio || '', { textarea: true, max: 4000, data: 'bio' }).label,
        );
      } else if (section.type === 'contact') {
        fields.append(
          inputField('Texto sobre el número', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Título de consulta', sectionContent.consultation_heading || '', { max: 160, data: 'consultationHeading' }).label,
          inputField('Texto de apoyo de la consulta', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
          inputField('Texto junto al QR', sectionContent.qr_heading || '', { max: 160, data: 'qrHeading' }).label,
          element('p', 'pz-promo-cms__scope-note', 'El número, el enlace y la imagen QR se reutilizan desde Contacto. Los iconos de teléfono, consulta y WhatsApp permanecen fijos.'),
        );
      } else if (section.type === 'footer') {
        fields.append(
          inputField('Título del pie', sectionContent.heading || '', { max: 160, data: 'heading' }).label,
          inputField('Resumen del pie', sectionContent.summary || '', { textarea: true, max: 600, data: 'summary' }).label,
          inputField('Texto legal o de cierre', sectionContent.text || '', {
            textarea: true, max: 4000, data: 'text',
          }).label,
        );

        const footerLinks = element('fieldset', 'pz-promo-cms__footer-options');
        const linksLegend = element('legend', '', `Enlaces internos (máximo ${PROMO_CMS_FOOTER_MAX_LINKS})`);
        footerLinks.append(linksLegend);
        const selectedLinks = new Set(section.config.navigation_section_keys || []);
        const linkGrid = element('div', 'pz-promo-cms__footer-option-grid');
        (documentValue?.sections || []).filter((candidate: CmsDocument) => (
          candidate.type !== 'footer' && candidate.visible === true
        )).forEach((candidate: CmsDocument) => {
          const option = element('label', 'pz-promo-cms__check-option');
          const checkbox = element('input');
          checkbox.type = 'checkbox';
          checkbox.value = candidate.key;
          checkbox.checked = selectedLinks.has(candidate.key);
          checkbox.dataset.cmsFooterLink = '';
          option.append(checkbox, element('span', '', localized.navigation?.[candidate.key] || sectionLabels[candidate.type] || candidate.key));
          linkGrid.append(option);
        });
        footerLinks.append(linkGrid);

        const social = element('fieldset', 'pz-promo-cms__footer-options');
        social.append(element('legend', '', 'Redes sociales aprobadas'));
        social.append(element('p', 'pz-promo-cms__scope-note', 'Escribe solo el identificador público, sin @, dominio, URL ni protocolo.'));
        const socialByNetwork = new Map((section.config.social_profiles || []).map((profile: CmsDocument) => [profile.network, profile.handle]));
        const socialGrid = element('div', 'pz-promo-cms__footer-social-grid');
        PROMO_CMS_FOOTER_SOCIAL_NETWORKS.forEach((network) => {
          const field = inputField(`${network.label}: identificador`, socialByNetwork.get(network.key) || '', { max: 100 });
          field.control.dataset.cmsFooterSocial = network.key;
          field.control.setAttribute('autocomplete', 'off');
          socialGrid.append(field.label);
        });
        social.append(socialGrid);
        card.append(header, visible, fields, footerLinks, social);
        return card;
      } else {
        const note = element('p', 'pz-promo-cms__scope-note');
        note.textContent = 'CMS solo controla aquí el orden, la visibilidad y la etiqueta. Su contenido pertenece a un módulo posterior.';
        fields.append(note);
      }
      card.append(header, visible, fields);
      return card;
    }

    function renderContent() {
      if (!documentValue) return;
      const localized = documentValue.content_by_locale[locale];
      const name = root.querySelector<HTMLInputElement>('[data-cms-identity-name]');
      const slogan = root.querySelector<HTMLInputElement>('[data-cms-identity-slogan]');
      const summary = root.querySelector<HTMLTextAreaElement>('[data-cms-identity-summary]');
      const contactCta = root.querySelector<HTMLInputElement>('[data-cms-identity-contact-cta]');
      if (name) name.value = localized.identity?.name || '';
      if (slogan) slogan.value = localized.identity?.slogan || '';
      if (summary) summary.value = localized.identity?.summary || '';
      if (contactCta) contactCta.value = localized.identity?.contact_cta_label || (
        locale.startsWith('es') ? 'Solicitar estimado' : 'Request an estimate'
      );
      const list = root.querySelector<HTMLElement>('[data-cms-sections]');
      if (!list) return;
      const organizationSections = documentValue.sections.filter((section: CmsDocument) => (
        section.type !== 'gallery' || section.key === PROMO_CMS_WORK_GALLERY_KEY
      ));
      list.replaceChildren(...organizationSections.map((section: CmsDocument) => createSectionCard(section, localized)));
      updateSectionOrderControls();
      updateServiceQuota();
    }

    function setContactControlState(card: HTMLElement) {
      const enabled = card.querySelector<HTMLInputElement>('[data-cms-action-enabled]')?.checked === true;
      card.querySelectorAll<HTMLInputElement>('[data-cms-primary], [data-cms-secondary]').forEach((control) => {
        control.disabled = !enabled || busy || !canSave;
        if (!enabled) control.checked = false;
      });
    }

    function updateDestination(card: HTMLElement) {
      const type = card.querySelector<HTMLSelectElement>('[data-cms-action-type]')?.value || 'phone';
      const destination = card.querySelector<HTMLInputElement>('[data-cms-action-destination]');
      if (!destination) return;
      destination.type = type === 'email' ? 'email' : 'tel';
      destination.placeholder = type === 'email' ? 'contacto@negocio.com' : '+13055550184';
      destination.pattern = type === 'email' ? '[^\\s@]+@[^\\s@]+\\.[^\\s@]+' : '\\+[1-9][0-9]{7,14}';
      destination.autocomplete = type === 'email' ? 'email' : 'tel';
    }

    function createContactAction(action: CmsDocument, localizedText: CmsDocument = {}) {
      const supported = PROMO_CMS_CONTACT_TYPES.includes(action.type);
      const card = element('article', 'pz-promo-cms__contact-action');
      card.dataset.cmsContactAction = action.key;
      card.dataset.preserve = supported ? 'false' : 'true';
      const header = element('header', 'pz-promo-cms__item-heading');
      const title = element('h4', '', localizedText.label || contactLabels[action.type] || 'Método de contacto');
      title.tabIndex = -1;
      header.append(title, element('span', 'pz-promo-cms__type', contactLabels[action.type] || action.type));
      card.append(header);
      if (!supported) {
        card.append(element('p', 'pz-promo-cms__scope-note', 'Este adaptador se conserva sin cambios y no puede habilitarse desde CMS.'));
        return card;
      }

      const fields = element('div', 'pz-promo-cms__fields two-columns');
      const typeLabel = element('label', 'pz-promo-cms__field');
      typeLabel.append(element('span', '', 'Tipo'));
      const select = element('select');
      select.dataset.cmsActionType = '';
      PROMO_CMS_CONTACT_TYPES.forEach((type) => {
        const option = element('option', '', contactLabels[type]);
        option.value = type;
        option.selected = action.type === type;
        select.append(option);
      });
      typeLabel.append(select);
      const destinationLabel = element('label', 'pz-promo-cms__field');
      destinationLabel.append(element('span', '', 'Destino'));
      const destination = element('input');
      destination.required = true;
      destination.maxLength = 254;
      destination.dataset.cmsActionDestination = '';
      destination.value = action.config?.phone_e164 || action.config?.email_address || '';
      destinationLabel.append(destination);
      const enabled = element('label', 'pz-promo-cms__switch compact');
      const enabledInput = element('input');
      enabledInput.type = 'checkbox';
      enabledInput.checked = action.enabled === true;
      enabledInput.dataset.cmsActionEnabled = '';
      enabled.append(enabledInput, element('span', '', 'Método disponible'));
      const label = inputField('Texto del botón', localizedText.label || '', { max: 80, data: 'label' });
      const aria = inputField('Nombre accesible', localizedText.aria_label || '', { max: 160, data: 'aria' });
      const message = inputField('Mensaje sugerido', localizedText.message || '', { textarea: true, max: 1000, data: 'message' });
      label.control.addEventListener('input', () => { title.textContent = label.control.value || contactLabels[select.value]; });
      fields.append(typeLabel, destinationLabel, enabled, label.label, aria.label, message.label);

      const choices = element('fieldset', 'pz-promo-cms__contact-priority');
      choices.append(element('legend', '', 'Prioridad'));
      const primaryLabel = element('label');
      const primary = element('input');
      primary.type = 'radio';
      primary.name = `promo-primary-${storeSlug}`;
      primary.value = action.key;
      primary.dataset.cmsPrimary = '';
      primaryLabel.append(primary, document.createTextNode(' Principal'));
      const secondaryLabel = element('label');
      const secondary = element('input');
      secondary.type = 'checkbox';
      secondary.value = action.key;
      secondary.dataset.cmsSecondary = '';
      secondaryLabel.append(secondary, document.createTextNode(' Secundario'));
      choices.append(primaryLabel, secondaryLabel);
      primary.addEventListener('change', () => { if (primary.checked) secondary.checked = false; });
      secondary.addEventListener('change', () => { if (secondary.checked) primary.checked = false; });
      enabledInput.addEventListener('change', () => setContactControlState(card));
      select.addEventListener('change', () => {
        updateDestination(card);
        title.textContent = label.control.value || contactLabels[select.value];
      });
      card.append(fields, choices);
      updateDestination(card);
      setContactControlState(card);
      return card;
    }

    function syncContactPriorities() {
      if (!documentValue) return;
      root.querySelectorAll<HTMLElement>('[data-cms-contact-action]').forEach((card) => {
        const key = card.dataset.cmsContactAction || '';
        const primary = card.querySelector<HTMLInputElement>('[data-cms-primary]');
        const secondary = card.querySelector<HTMLInputElement>('[data-cms-secondary]');
        if (primary) primary.checked = documentValue?.contact.primary_action_key === key;
        if (secondary) secondary.checked = documentValue?.contact.secondary_action_keys?.includes(key) === true;
      });
    }

    function releaseObjectUrl(value: string) {
      if (value) URL.revokeObjectURL(value);
    }

    function documentAssetIds(documentValue: CmsDocument | null) {
      return new Set<string>(Object.values(documentValue?.media_refs || {})
        .map((reference: any) => String(reference?.asset_id || ''))
        .filter((assetId) => /^[a-z0-9]{15}$/.test(assetId)));
    }

    function renderQrPreview() {
      const preview = root.querySelector<HTMLElement>('[data-cms-qr-preview]');
      const slot = root.querySelector<HTMLElement>('[data-cms-qr-slot]');
      const state = root.querySelector<HTMLElement>('[data-cms-qr-state]');
      const count = root.querySelector<HTMLElement>('[data-cms-qr-count]');
      const choose = root.querySelector<HTMLButtonElement>('[data-cms-choose-qr]');
      const input = root.querySelector<HTMLInputElement>('[data-cms-qr-file]');
      const remove = root.querySelector<HTMLButtonElement>('[data-cms-remove-qr]');
      const guidance = root.querySelector<HTMLElement>('[data-cms-qr-guidance]');
      if (!preview || !documentValue) return;
      preview.replaceChildren();
      const assetId = documentValue.media_refs?.[qrUseKey]?.asset_id || '';
      const filled = Boolean(pendingQrFile || (qrUseKey && /^[a-z0-9]{15}$/.test(assetId)));
      slot?.classList.toggle('is-filled', filled);
      slot?.classList.toggle('is-empty', !filled);
      slot?.classList.toggle('is-pending', Boolean(pendingQrFile));
      slot?.classList.toggle('is-error', Boolean(qrCardError));
      preview.className = filled ? 'pz-promo-gallery__item-preview' : 'pz-promo-media-slot__empty';
      if (state) state.textContent = qrCardError ? 'Error' : (pendingQrFile ? 'Pendiente' : (filled ? 'Guardada' : 'Disponible'));
      if (count) count.textContent = `${filled ? 1 : 0} de 1 utilizados`;
      if (choose) choose.textContent = filled ? 'Cambiar imagen' : 'Elegir imagen';
      if (input) input.setAttribute('aria-label', `${filled ? 'Cambiar' : 'Agregar'} imagen del código QR`);
      if (remove) remove.disabled = !canSave || !canManageMedia || !filled || busy;
      if (guidance) {
        guidance.textContent = qrCardError
          || 'JPG, PNG, WebP o AVIF · QR cuadrado · WebP 512×512, fondo blanco, sin recorte ni metadatos';
        guidance.classList.toggle('is-error', Boolean(qrCardError));
      }
      if (!filled) {
        preview.append(
          element('strong', '', 'Arrastra una imagen aquí'),
          element('span', '', 'o selecciónala desde tu dispositivo'),
        );
        return;
      }
      const image = element('img');
      image.src = pendingQrPreviewUrl || `${mediaEndpoint}&asset=${encodeURIComponent(assetId)}`;
      image.alt = 'Vista previa del código QR';
      image.width = 192;
      image.height = 192;
      preview.append(image);
    }

    function renderLogoPreview() {
      const preview = root.querySelector<HTMLElement>('[data-cms-logo-preview]');
      const slot = root.querySelector<HTMLElement>('[data-cms-logo-slot]');
      const state = root.querySelector<HTMLElement>('[data-cms-logo-state]');
      const count = root.querySelector<HTMLElement>('[data-cms-logo-count]');
      const choose = root.querySelector<HTMLButtonElement>('[data-cms-choose-logo]');
      const input = root.querySelector<HTMLInputElement>('[data-cms-logo-file]');
      const remove = root.querySelector<HTMLButtonElement>('[data-cms-remove-logo]');
      const guidance = root.querySelector<HTMLElement>('[data-cms-logo-guidance]');
      if (!preview || !documentValue) return;
      preview.replaceChildren();
      const assetId = documentValue.media_refs?.[logoUseKey]?.asset_id || '';
      const filled = Boolean(pendingLogoFile || (logoUseKey && /^[a-z0-9]{15}$/.test(assetId)));
      slot?.classList.toggle('is-filled', filled);
      slot?.classList.toggle('is-empty', !filled);
      slot?.classList.toggle('is-pending', Boolean(pendingLogoFile));
      slot?.classList.toggle('is-error', Boolean(logoCardError));
      preview.className = filled ? 'pz-promo-gallery__item-preview' : 'pz-promo-media-slot__empty';
      if (state) state.textContent = logoCardError ? 'Error' : (pendingLogoFile ? 'Pendiente' : (filled ? 'Guardada' : 'Disponible'));
      if (count) count.textContent = `${filled ? 1 : 0} de 1 utilizados`;
      if (choose) choose.textContent = filled ? 'Cambiar imagen' : 'Elegir imagen';
      if (input) input.setAttribute('aria-label', `${filled ? 'Cambiar' : 'Agregar'} imagen del logo del negocio`);
      if (remove) remove.disabled = !canSave || !canManageMedia || !filled || busy;
      if (guidance) {
        guidance.textContent = logoCardError
          || 'JPG, PNG, WebP o AVIF · ideal 2:1 · WebP 511×256, sin recorte ni metadatos al guardar';
        guidance.classList.toggle('is-error', Boolean(logoCardError));
      }
      if (!filled) {
        preview.append(
          element('strong', '', 'Arrastra una imagen aquí'),
          element('span', '', 'o selecciónala desde tu dispositivo'),
        );
        return;
      }
      const image = element('img');
      image.src = pendingLogoPreviewUrl || `${mediaEndpoint}&asset=${encodeURIComponent(assetId)}`;
      image.alt = 'Vista previa del logo del negocio';
      image.width = 192;
      image.height = 192;
      preview.append(image);
    }

    async function selectLogo(selectedFile?: File) {
      const file = selectedFile || root.querySelector<HTMLInputElement>('[data-cms-logo-file]')?.files?.[0];
      if (!documentValue || !file || !canManageMedia || !canSave || busy) return;
      clearError();
      logoCardError = '';
      setBusy(true, 'Optimizando logo…');
      try {
        const prepared = await optimizePromoUploadImageFile(file, 'logo') as File;
        releaseObjectUrl(pendingLogoPreviewUrl);
        pendingLogoFile = prepared;
        pendingLogoPreviewUrl = URL.createObjectURL(prepared);
        if (!logoUseKey) {
          logoUseKey = 'logo-business';
          if (documentValue.media_refs[logoUseKey]) {
            const random = crypto.getRandomValues(new Uint32Array(1))[0].toString(36);
            logoUseKey = `logo-business-${random}`.slice(0, 120);
          }
        }
        documentValue.contact.logo_media_use_key = logoUseKey;
        renderLogoPreview();
        setDirty();
        if (status) {
          status.hidden = false;
          status.querySelector('span:last-child')!.textContent = 'Logo preparado localmente. Se subirá únicamente al guardar los cambios.';
        }
      } catch (error) {
        logoCardError = promoCmsErrorMessage((error as { code?: string; message?: string })?.code || (error as Error)?.message || 'promo_media_upload_failed');
        renderLogoPreview();
        showError((error as { code?: string; message?: string })?.code || (error as Error)?.message || 'promo_media_upload_failed');
      } finally {
        setBusy(false, '');
      }
    }

    function removeLogo() {
      if (!documentValue || !logoUseKey || !canSave || !canManageMedia) return;
      releaseObjectUrl(pendingLogoPreviewUrl);
      pendingLogoFile = null;
      pendingLogoPreviewUrl = '';
      logoCardError = '';
      delete documentValue.media_refs[logoUseKey];
      Object.values(documentValue.content_by_locale).forEach((content: any) => delete content.media_alt[logoUseKey]);
      documentValue.contact.logo_media_use_key = '';
      logoUseKey = '';
      renderLogoPreview();
      setDirty();
    }

