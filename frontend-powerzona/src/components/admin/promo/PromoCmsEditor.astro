    function renderContact() {
      if (!documentValue) return;
      releaseObjectUrl(pendingLogoPreviewUrl);
      releaseObjectUrl(pendingQrPreviewUrl);
      pendingLogoFile = null;
      pendingQrFile = null;
      pendingLogoPreviewUrl = '';
      pendingQrPreviewUrl = '';
      logoCardError = '';
      qrCardError = '';
      const localized = documentValue.content_by_locale[locale];
      const section = documentValue.sections.find((entry: CmsDocument) => entry.type === 'contact');
      const sectionContent = localized.sections?.[section.key] || {};
      const visible = root.querySelector<HTMLInputElement>('[data-cms-contact-section-visible]');
      const navigation = root.querySelector<HTMLInputElement>('[data-cms-contact-navigation]');
      const heading = root.querySelector<HTMLInputElement>('[data-cms-contact-heading]');
      const summary = root.querySelector<HTMLTextAreaElement>('[data-cms-contact-summary]');
      const enabled = root.querySelector<HTMLInputElement>('[data-cms-contact-enabled]');
      if (visible) visible.checked = section.visible === true;
      if (navigation) navigation.value = localized.navigation?.[section.key] || 'Contacto';
      if (heading) heading.value = sectionContent.heading || '';
      if (summary) summary.value = sectionContent.summary || '';
      if (enabled) enabled.checked = documentValue.contact.enabled === true;
      logoUseKey = documentValue.contact.logo_media_use_key || '';
      renderLogoPreview();
      qrUseKey = documentValue.contact.qr_media_use_key || '';
      renderQrPreview();
      const list = root.querySelector<HTMLElement>('[data-cms-contact-actions]');
      if (list) list.replaceChildren(...documentValue.contact.actions.map((action: CmsDocument) => (
        createContactAction(action, localized.contact?.[action.key] || {})
      )));
      syncContactPriorities();
    }

    function collectContentPatch() {
      const identityName = root.querySelector<HTMLInputElement>('[data-cms-identity-name]')?.value || '';
      const identitySlogan = root.querySelector<HTMLInputElement>('[data-cms-identity-slogan]')?.value || '';
      const identitySummary = root.querySelector<HTMLTextAreaElement>('[data-cms-identity-summary]')?.value || '';
      const identityContactCta = root.querySelector<HTMLInputElement>('[data-cms-identity-contact-cta]')?.value || '';
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cms-section-key]'));
      const renderedSections = cards.map((card) => {
        const type = card.dataset.cmsSectionType || '';
        const field = (name: string) => card.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-cms-field="${name}"]`)?.value || '';
        const result: CmsDocument = {
          key: card.dataset.cmsSectionKey || '',
          visible: card.querySelector<HTMLInputElement>('[data-cms-field="visible"]')?.checked === true,
          navigationLabel: field('navigation'),
        };
        if (type === 'hero') Object.assign(result, {
          heading: field('heading'),
          intro: field('intro'),
          summary: field('summary'),
          heroLayout: card.querySelector<HTMLInputElement>('[data-cms-hero-layout]:checked')?.value || 'immersive',
          highlights: Array.from(card.querySelectorAll<HTMLInputElement>('[data-cms-hero-highlight]'))
            .map((input) => input.value.trim()).filter(Boolean),
          buttons: Array.from(card.querySelectorAll<HTMLElement>('[data-cms-hero-button-target]')).map((select) => ({
            target: (select as HTMLSelectElement).value,
            label: (select as HTMLSelectElement).value === 'primary-contact'
              ? ''
              : select.parentElement?.querySelector<HTMLInputElement>('[data-cms-hero-button-label]')?.value || '',
          })),
        });
        if (type === 'gallery') Object.assign(result, { heading: field('heading'), summary: field('summary') });
        if (type === 'owner') Object.assign(result, { heading: field('heading'), name: field('name'), bio: field('bio') });
        if (type === 'contact') Object.assign(result, {
          heading: field('heading'),
          consultationHeading: field('consultationHeading'),
          summary: field('summary'),
          qrHeading: field('qrHeading'),
        });
        if (type === 'footer') Object.assign(result, {
          heading: field('heading'),
          summary: field('summary'),
          text: field('text'),
          navigationSectionKeys: Array.from(card.querySelectorAll<HTMLInputElement>('[data-cms-footer-link]:checked'))
            .map((input) => input.value),
          socialProfiles: Array.from(card.querySelectorAll<HTMLInputElement>('[data-cms-footer-social]'))
            .map((input) => ({ network: input.dataset.cmsFooterSocial || '', handle: input.value }))
            .filter((profile) => profile.handle.trim()),
        });
        if (type === 'services') {
          Object.assign(result, {
            heading: field('heading'),
            summary: field('summary'),
            items: Array.from(card.querySelectorAll<HTMLElement>('[data-cms-service-item]')).map((item) => ({
              key: item.dataset.cmsServiceItem || '',
              name: item.querySelector<HTMLInputElement>('[data-cms-field="name"]')?.value || '',
              summary: item.querySelector<HTMLTextAreaElement>('[data-cms-field="summary"]')?.value || '',
              caption: item.querySelector<HTMLInputElement>('[data-cms-field="caption"]')?.value || '',
              galleryKey: item.dataset.cmsServicePortfolioKey || '',
              iconKey: item.querySelector<HTMLSelectElement>('[data-cms-field="iconKey"]')?.value || '',
            })),
          });
        }
        return result;
      });
      const renderedByKey = new Map(renderedSections.map((section) => [section.key, section]));
      const renderedOrder = renderedSections.map((section) => section.key);
      let renderedIndex = 0;
      const sectionOrder = (documentValue?.sections || []).map((section: CmsDocument) => {
        if (section.type === 'gallery' && section.key !== PROMO_CMS_WORK_GALLERY_KEY) return section.key;
        return renderedOrder[renderedIndex++] || section.key;
      });
      const localized = documentValue?.content_by_locale?.[locale] || {};
      const sections = (documentValue?.sections || []).map((section: CmsDocument) => (
        renderedByKey.get(section.key) || {
          key: section.key,
          visible: section.visible === true,
          navigationLabel: localized.navigation?.[section.key] || sectionLabels[section.type] || section.key,
          heading: localized.sections?.[section.key]?.heading || '',
          summary: localized.sections?.[section.key]?.summary || '',
        }
      ));
      return {
        identity: {
          name: identityName,
          slogan: identitySlogan,
          summary: identitySummary,
          contactCtaLabel: identityContactCta,
        },
        sectionOrder,
        sections,
      };
    }
    function collectContactPatch() {
      const section = documentValue?.sections.find((entry: CmsDocument) => entry.type === 'contact');
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cms-contact-action]'));
      return {
        enabled: root.querySelector<HTMLInputElement>('[data-cms-contact-enabled]')?.checked === true,
        logoMediaUseKey: logoUseKey,
        qrMediaUseKey: qrUseKey,
        primaryActionKey: root.querySelector<HTMLInputElement>('[data-cms-primary]:checked')?.value || '',
        secondaryActionKeys: Array.from(root.querySelectorAll<HTMLInputElement>('[data-cms-secondary]:checked')).map((input) => input.value),
        section: {
          key: section?.key || '',
          visible: root.querySelector<HTMLInputElement>('[data-cms-contact-section-visible]')?.checked === true,
          navigationLabel: root.querySelector<HTMLInputElement>('[data-cms-contact-navigation]')?.value || '',
          heading: root.querySelector<HTMLInputElement>('[data-cms-contact-heading]')?.value || '',
          summary: root.querySelector<HTMLTextAreaElement>('[data-cms-contact-summary]')?.value || '',
        },
        actions: cards.map((card) => ({
          key: card.dataset.cmsContactAction || '',
          type: card.querySelector<HTMLSelectElement>('[data-cms-action-type]')?.value
            || documentValue?.contact.actions.find((action: CmsDocument) => action.key === card.dataset.cmsContactAction)?.type
            || '',
          enabled: card.querySelector<HTMLInputElement>('[data-cms-action-enabled]')?.checked === true,
          destination: card.querySelector<HTMLInputElement>('[data-cms-action-destination]')?.value || '',
          label: card.querySelector<HTMLInputElement>('[data-cms-field="label"]')?.value || '',
          ariaLabel: card.querySelector<HTMLInputElement>('[data-cms-field="aria"]')?.value || '',
          message: card.querySelector<HTMLTextAreaElement>('[data-cms-field="message"]')?.value || '',
          preserve: card.dataset.preserve === 'true',
        })),
      };
    }

    async function mediaResponse(response: Response) {
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true) {
        throw Object.assign(new Error('promo_media_upload_failed'), { code: result?.error || 'promo_media_upload_failed' });
      }
      return result;
    }

    async function uploadContactMedia(file: File, purpose: 'logo' | 'qr') {
      const payload = new FormData();
      payload.append('file', file);
      payload.append('purpose', purpose);
      payload.append('poster_asset_id', '');
      const result = await mediaResponse(await fetch(mediaEndpoint, {
        method: 'POST',
        body: payload,
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      }));
      const assetId = String(result?.asset?.asset_id || '');
      const validDimensions = purpose === 'qr'
        ? Number(result?.asset?.width) === 512 && Number(result?.asset?.height) === 512
        : Number(result?.asset?.width) === 511 && Number(result?.asset?.height) === 256;
      if (!/^[a-z0-9]{15}$/.test(assetId) || result?.asset?.purpose !== purpose
        || result?.asset?.kind !== 'image' || !validDimensions) {
        throw Object.assign(new Error('promo_media_upload_failed'), { code: 'promo_media_upload_failed' });
      }
      return assetId;
    }

    async function deleteUnreferencedAssets(assetIds: Iterable<string>) {
      let failures = 0;
      for (const assetId of new Set(assetIds)) {
        if (!/^[a-z0-9]{15}$/.test(assetId)) continue;
        try {
          await mediaResponse(await fetch(`/api/admin/promo-media-delete?store=${encodeURIComponent(storeSlug)}`, {
            method: 'DELETE',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify({ asset_id: assetId }),
            credentials: 'same-origin',
          }));
        } catch (_) {
          failures += 1;
        }
      }
      return failures;
    }

    async function knownMediaAssetIds() {
      const result = await mediaResponse(await fetch(mediaEndpoint, {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
        credentials: 'same-origin',
      }));
      return new Set<string>((Array.isArray(result?.assets) ? result.assets : [])
        .map((asset: any) => String(asset?.asset_id || ''))
        .filter((assetId: string) => /^[a-z0-9]{15}$/.test(assetId)));
    }

    async function uploadPendingContactMedia(created: Set<string>) {
      if (!documentValue) throw new Error('promo_cms_unavailable');
      const known = await knownMediaAssetIds();
      if (pendingLogoFile) {
        const assetId = await uploadContactMedia(pendingLogoFile, 'logo');
        if (!known.has(assetId)) created.add(assetId);
        documentValue.media_refs[logoUseKey] = { asset_id: assetId, purpose: 'logo' };
        Object.entries(documentValue.content_by_locale).forEach(([candidate, content]: [string, any]) => {
          const name = String(content?.identity?.name || '').trim();
          content.media_alt[logoUseKey] = {
            alt: candidate === 'en' ? `Logo of ${name || 'the business'}` : `Logo de ${name || 'el negocio'}`,
            decorative: false,
          };
        });
      }
      if (pendingQrFile) {
        const assetId = await uploadContactMedia(pendingQrFile, 'qr');
        if (!known.has(assetId)) created.add(assetId);
        documentValue.media_refs[qrUseKey] = { asset_id: assetId, purpose: 'qr' };
        Object.entries(documentValue.content_by_locale).forEach(([candidate, content]: [string, any]) => {
          const name = String(content?.identity?.name || '').trim();
          content.media_alt[qrUseKey] = {
            alt: candidate === 'en'
              ? `Contact QR code for ${name || 'the business'}`
              : `Código QR de contacto de ${name || 'el negocio'}`,
            decorative: false,
          };
        });
      }
    }

    function render() {
      if (!form || !documentValue) return;
      if (scope === 'content') renderContent();
      else renderContact();
      form.hidden = false;
      if (!canSave) {
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((control) => {
          control.disabled = true;
        });
        form.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
          button.disabled = true;
        });
      } else if (scope === 'contact') {
        root.querySelectorAll<HTMLElement>('[data-cms-contact-action]').forEach(setContactControlState);
      }
      updateMeta();
      setDirty(false);
      if (status) status.hidden = true;
    }

    async function loadDraft() {
      clearError();
      if (status) {
        status.hidden = false;
        status.classList.remove('is-success');
        status.querySelector('span:last-child')!.textContent = 'Cargando la página segura…';
      }
      if (form) form.hidden = true;
      setBusy(true, 'Cargando…');
      try {
        const response = await fetch(endpoint, { headers: { Accept: 'application/json' }, cache: 'no-store', credentials: 'same-origin' });
        const result = await response.json().catch(() => null);
        if (!response.ok || result?.ok !== true) throw Object.assign(new Error('promo_cms_unavailable'), { code: result?.error });
        const draft = normalizePromoCmsDraftResponse(result);
        const workspace = createPromoCmsWorkspace(draft.document, scope);
        version = draft.version;
        documentValue = workspace.document;
        locale = workspace.locale;
        render();
      } catch (error) {
        showError((error as { code?: string })?.code || 'promo_cms_unavailable');
        if (status) status.hidden = true;
      } finally {
        setBusy(false, '');
      }
    }

    root.querySelector('[data-cms-reload]')?.addEventListener('click', loadDraft);
    const logoFileInput = root.querySelector<HTMLInputElement>('[data-cms-logo-file]');
    root.querySelector('[data-cms-choose-logo]')?.addEventListener('click', () => logoFileInput?.click());
    logoFileInput?.addEventListener('change', () => {
      void selectLogo(logoFileInput.files?.[0]).finally(() => { logoFileInput.value = ''; });
    });
    root.querySelector('[data-cms-remove-logo]')?.addEventListener('click', removeLogo);
    const qrFileInput = root.querySelector<HTMLInputElement>('[data-cms-qr-file]');
    root.querySelector('[data-cms-choose-qr]')?.addEventListener('click', () => qrFileInput?.click());
    qrFileInput?.addEventListener('change', () => {
      void selectQr(qrFileInput.files?.[0]).finally(() => { qrFileInput.value = ''; });
    });
    root.querySelector('[data-cms-remove-qr]')?.addEventListener('click', removeQr);

    function bindContactMediaDrop(
      selector: string,
      upload: (file?: File) => Promise<void>,
    ) {
      const slot = root.querySelector<HTMLElement>(selector);
      if (!slot) return;
      slot.addEventListener('dragover', (event) => {
        if (!canManageMedia || !canSave || busy || !Array.from(event.dataTransfer?.types || []).includes('Files')) return;
        event.preventDefault();
        slot.classList.add('is-dragover');
      });
      slot.addEventListener('dragleave', () => slot.classList.remove('is-dragover'));
      slot.addEventListener('drop', (event) => {
        slot.classList.remove('is-dragover');
        const file = event.dataTransfer?.files?.[0];
        if (!file || !canManageMedia || !canSave || busy) return;
        event.preventDefault();
        upload(file);
      });
    }

    bindContactMediaDrop('[data-cms-logo-slot]', selectLogo);
    bindContactMediaDrop('[data-cms-qr-slot]', selectQr);
    root.querySelector('[data-cms-add-contact]')?.addEventListener('click', () => {
      const list = root.querySelector<HTMLElement>('[data-cms-contact-actions]');
      if (!list || list.children.length >= 32) return;
      const random = crypto.getRandomValues(new Uint32Array(1))[0].toString(36);
      const action = { key: `contact-${random}`.slice(0, 64), type: 'phone', enabled: true, config: { phone_e164: '' } };
      const card = createContactAction(action, { label: 'Llamar', aria_label: 'Llamar a la tienda', message: '' });
      list.append(card);
      setDirty();
      card.querySelector<HTMLInputElement>('[data-cms-action-destination]')?.focus();
    });

    form?.addEventListener('input', () => setDirty());
    form?.addEventListener('change', () => setDirty());
    root.querySelector('[data-cms-identity-contact-cta]')?.addEventListener('input', (event) => {
      const value = event.currentTarget instanceof HTMLInputElement ? event.currentTarget.value : '';
      root.querySelectorAll<HTMLSelectElement>('[data-cms-hero-button-target]').forEach((select) => {
        if (select.value !== 'primary-contact') return;
        const input = select.parentElement?.querySelector<HTMLInputElement>('[data-cms-hero-button-label]');
        if (input) input.value = value;
      });
    });
    form?.addEventListener('invalid', (event) => {
      const control = event.target instanceof HTMLElement ? event.target : null;
      const accordion = control?.closest<HTMLDetailsElement>('.pz-promo-cms__accordion');
      if (accordion) accordion.open = true;
    }, true);
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearError();
      if (!documentValue || !canSave || busy) return;
      if (!form.reportValidity()) return;
      const contentPatch = scope === 'content' ? collectContentPatch() : null;
      const workSectionPatch = contentPatch?.sections.find((section: CmsDocument) => (
        section.key === PROMO_CMS_WORK_GALLERY_KEY
      ));
      if (workSectionPatch?.visible === true && !isPromoCmsWorkGalleryReady(documentValue)) {
        showError('promo_work_gallery_incomplete');
        return;
      }
      if (status) {
        status.hidden = true;
        status.classList.remove('is-success');
      }
      setBusy(true, 'Guardando…');
      const previousAssetIds = documentAssetIds(documentValue);
      const documentBeforeMedia = structuredClone(documentValue);
      const createdAssetIds = new Set<string>();
      try {
        if (scope === 'contact' && (pendingLogoFile || pendingQrFile)) {
          if (!canManageMedia) throw Object.assign(new Error('promo_permission_denied'), { code: 'promo_permission_denied' });
          await uploadPendingContactMedia(createdAssetIds);
        }
        const nextDocument = contentPatch
          ? buildPromoCmsContentDocument(documentValue, contentPatch, maxServices)
          : buildPromoCmsContactDocument(documentValue, collectContactPatch());
        const response = await fetch(endpoint, {
          method: 'PUT',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ expected_version: version, document: nextDocument }),
          cache: 'no-store',
          credentials: 'same-origin',
        });
        const result = await response.json().catch(() => null);
        if (!response.ok || result?.ok !== true) throw Object.assign(new Error('promo_cms_unavailable'), { code: result?.error });
        const draft = normalizePromoCmsDraftResponse({ ok: result.ok, contract: result.contract, draft: result.draft });
        const workspace = createPromoCmsWorkspace(draft.document, scope);
        version = draft.version;
        documentValue = workspace.document;
        locale = workspace.locale;
        const currentAssetIds = documentAssetIds(workspace.document);
        const replacedAssetIds = Array.from(previousAssetIds).filter((assetId) => !currentAssetIds.has(assetId));
        const cleanupFailures = canManageMedia ? await deleteUnreferencedAssets(replacedAssetIds) : replacedAssetIds.length;
        render();
        if (status) {
          status.hidden = false;
          status.classList.add('is-success');
          status.querySelector('span:last-child')!.textContent = cleanupFailures
            ? `Página pública actualizada. ${cleanupFailures} archivo(s) anterior(es) siguen protegidos porque aún no pudieron eliminarse.`
            : result.changed === true
              ? 'Página pública actualizada correctamente.'
            : 'No había cambios nuevos para guardar.';
        }
        window.dispatchEvent(new CustomEvent('promo:document-updated', { detail: { source: 'cms' } }));
      } catch (error) {
        documentValue = documentBeforeMedia;
        await deleteUnreferencedAssets(createdAssetIds);
        showError((error as { code?: string })?.code || 'promo_cms_unavailable');
      } finally {
        setBusy(false, '');
      }
    });

    window.addEventListener('beforeunload', (event) => {
      if (!dirty) return;
      event.preventDefault();
    });

    window.addEventListener('pagehide', () => {
      releaseObjectUrl(pendingLogoPreviewUrl);
      releaseObjectUrl(pendingQrPreviewUrl);
    }, { once: true });

    window.addEventListener('promo:document-updated', (event: Event) => {
      const source = (event as CustomEvent)?.detail?.source;
      if (source === 'products' && !dirty) loadDraft();
    });

    loadDraft();
  });
</script>
