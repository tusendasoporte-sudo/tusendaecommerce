            qrUseKey = `qr-contact-${random}`.slice(0, 120);
          }
        }
        documentValue.media_refs[qrUseKey] = { asset_id: assetId, purpose: 'qr' };
        Object.values(documentValue.content_by_locale).forEach((content: any) => {
          content.media_alt[qrUseKey] = { alt: 'Código QR de contacto', decorative: false };
        });
        documentValue.contact.qr_media_use_key = qrUseKey;
        renderQrPreview();
        setDirty();
        if (status) {
          status.hidden = false;
          status.querySelector('span:last-child')!.textContent = 'QR procesado. Guarda los cambios para actualizar la página.';
        }
      } catch (error) {
        showError((error as { code?: string })?.code || 'promo_media_upload_failed');
      } finally {
        setBusy(false, '');
      }
