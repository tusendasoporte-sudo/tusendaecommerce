---
import '../../../styles/promo-reviews-admin.css';
import '../../../styles/promo-gallery.css';

interface Props {
  storeSlug: string;
  storeName: string;
  publicSlug: string;
  canModerate: boolean;
  canConfigure: boolean;
  canManageMedia: boolean;
}

const { storeSlug, storeName, publicSlug, canModerate, canConfigure, canManageMedia } = Astro.props;
---

<section
  class="pz-promo-reviews-admin"
  data-promo-reviews-editor
  data-store-slug={storeSlug}
  data-store-name={storeName}
  data-public-slug={publicSlug}
  data-can-moderate={canModerate ? 'true' : 'false'}
  data-can-configure={canConfigure ? 'true' : 'false'}
  data-can-manage-media={canManageMedia ? 'true' : 'false'}
  aria-labelledby="promo-reviews-editor-title"
>
  <header class="pz-promo-reviews-admin__header">
    <div>
      <span class="pz-promo-reviews-admin__kicker">Reseñas de tienda</span>
      <h2 id="promo-reviews-editor-title">Presentación pública y moderación</h2>
      <p>Solo se gestionan reseñas generales de esta tienda. Productos y pedidos permanecen fuera de Promo.</p>
    </div>
    <button type="button" class="pz-promo-reviews-admin__refresh" data-reviews-refresh>Actualizar</button>
  </header>

  <div class="pz-promo-reviews-admin__alert" data-reviews-alert role="status" aria-live="polite" hidden></div>

  <section class="pz-promo-reviews-admin__config" aria-labelledby="promo-reviews-config-title">
    <div>
      <span class="pz-promo-reviews-admin__section-label">Página pública en vivo</span>
      <h3 id="promo-reviews-config-title">Sección de reseñas</h3>
      <p>Al guardar, la sección y su título se actualizan automáticamente en la página pública.</p>
    </div>
    <label class="pz-promo-reviews-admin__switch">
      <input type="checkbox" data-reviews-enabled disabled={!canConfigure} />
      <span>Mostrar reseñas aprobadas</span>
    </label>
    <label class="pz-promo-reviews-admin__field">
      <span>Título en el idioma principal</span>
      <input type="text" maxlength="160" data-reviews-heading disabled={!canConfigure} />
    </label>
    <button type="button" data-reviews-save-config disabled>Guardar cambios</button>
    {!canConfigure && (
      <p class="pz-promo-reviews-admin__permission-note" role="note">
        Para cambiar la presentación se requieren `promo.content.manage` y `promo.reviews.manage`.
      </p>
    )}
  </section>

  <details class="pz-promo-reviews-admin__requests" open>
    <summary>
      <span><span class="pz-promo-reviews-admin__section-label">Después de un trabajo</span><strong>Solicitar una reseña</strong></span>
      <span>Enlace privado · hasta 3 fotos</span>
    </summary>
    <div class="pz-promo-reviews-admin__request-body">
      <p>Crea un enlace de un solo uso. El cliente verá las fotos en privado y decidirá si autoriza mostrarlas junto a la reseña.</p>
      <form data-review-request-form class="pz-promo-reviews-admin__request-form">
        <label class="pz-promo-reviews-admin__field"><span>Idioma del cliente</span><select data-review-request-locale required></select></label>
        <label class="pz-promo-reviews-admin__field"><span>Nombre o referencia del cliente (opcional)</span><input data-review-request-customer type="text" maxlength="120" /></label>
        <label class="pz-promo-reviews-admin__field is-wide"><span>Descripción privada del trabajo (opcional)</span><input data-review-request-work type="text" maxlength="240" placeholder="Ej.: Limpieza de alfombra de sala" /></label>
        <label class="pz-promo-reviews-admin__field"><span>Vigencia</span><select data-review-request-expiry><option value="7">7 días</option><option value="14">14 días</option><option value="30" selected>30 días</option></select></label>
        <section class="pz-promo-gallery pz-promo-media-slots pz-promo-reviews-admin__photo-uploader is-wide" aria-labelledby="review-request-photos-title">
          <header class="pz-promo-media-slots__header">
            <strong id="review-request-photos-title">Fotos del trabajo (opcional)</strong>
            <span data-review-request-photo-count>0 de 3 utilizadas</span>
          </header>
          <div class="pz-promo-media-slots__grid" data-review-request-photo-slots></div>
        </section>
        <button type="submit" data-review-request-create disabled={!canModerate}>Generar enlace privado</button>
      </form>
      {!canManageMedia && <p class="pz-promo-reviews-admin__permission-note">Puedes crear la solicitud sin fotos; para adjuntarlas se requiere `promo.media.manage`.</p>}
      <section class="pz-promo-reviews-admin__generated" data-review-request-generated hidden aria-labelledby="review-generated-title">
        <h4 id="review-generated-title">Enlace creado</h4>
        <input type="text" readonly data-review-request-link aria-label="Enlace privado de reseña" />
        <div class="pz-promo-reviews-admin__generated-actions">
          <button type="button" data-review-copy-link>Copiar enlace</button>
          <button type="button" data-review-share-link>Compartir</button>
          <a data-review-whatsapp-link target="_blank" rel="noopener noreferrer">Abrir WhatsApp</a>
        </div>
        <p>WhatsApp abrirá el mensaje con el enlace. Las fotos solo se adjuntan con el menú Compartir cuando el dispositivo lo permite.</p>
        <img data-review-request-qr alt="Código QR del enlace privado de reseña" width="220" height="220" />
      </section>
      <div class="pz-promo-reviews-admin__request-summary" data-review-request-summary></div>
      <div class="pz-promo-reviews-admin__request-list" data-review-request-list><p class="pz-promo-reviews-admin__empty">Cargando solicitudes…</p></div>
    </div>
  </details>

  <section class="pz-promo-reviews-admin__moderation" aria-labelledby="promo-reviews-moderation-title">
    <div class="pz-promo-reviews-admin__toolbar">
      <div>
        <span class="pz-promo-reviews-admin__section-label">Datos operativos</span>
        <h3 id="promo-reviews-moderation-title">Moderación</h3>
      </div>
      <label>
        <span>Estado</span>
        <select data-reviews-filter disabled={!canModerate}>
          <option value="all">Todas</option>
          <option value="pending">Pendientes</option>
          <option value="approved">Aprobadas</option>
          <option value="hidden">Ocultas</option>
          <option value="rejected">Rechazadas</option>
        </select>
      </label>
    </div>

    <dl class="pz-promo-reviews-admin__metrics" data-reviews-metrics>
      <div><dt>Promedio aprobado</dt><dd data-review-metric="average">—</dd></div>
      <div><dt>Pendientes</dt><dd data-review-metric="pending">—</dd></div>
      <div><dt>Aprobadas</dt><dd data-review-metric="approved">—</dd></div>
      <div><dt>Total tienda</dt><dd data-review-metric="total">—</dd></div>
    </dl>

    <div class="pz-promo-reviews-admin__list" data-reviews-list aria-live="polite">
      <p class="pz-promo-reviews-admin__empty">Cargando reseñas…</p>
    </div>

    <nav class="pz-promo-reviews-admin__pagination" aria-label="Paginación de reseñas">
      <button type="button" data-reviews-previous disabled>Anterior</button>
      <span data-reviews-page>1 de 1</span>
      <button type="button" data-reviews-next disabled>Siguiente</button>
    </nav>
  </section>
</section>

<script>
  import QRCode from 'qrcode';
  import { normalizePromoCmsDraftResponse } from '../../../lib/promoCms';
  import {
    normalizePromoReviewRequestCreated,
    normalizePromoReviewRequestRevoked,
    normalizePromoReviewRequestsPage,
    promoPublicPageLink,
    promoReviewRequestLink,
    PROMO_REVIEW_REQUESTS_API_PATH,
    promoReviewRequestsErrorMessage,
  } from '../../../lib/promoReviewRequests';
  import {
    buildPromoReviewsDisplayDocument,
    normalizePromoReviewModeration,
    normalizePromoReviewsPage,
    PROMO_REVIEWS_API_PATH,
    promoReviewsErrorMessage,
  } from '../../../lib/promoReviews';
  import { optimizePromoUploadImageFile } from '../../../lib/promoImageOptimizationCore.js';

  document.querySelectorAll<HTMLElement>('[data-promo-reviews-editor]').forEach((root) => {
    const storeSlug = String(root.dataset.storeSlug || '');
    const storeName = String(root.dataset.storeName || 'esta tienda');
    const publicSlug = String(root.dataset.publicSlug || '');
    const canModerate = root.dataset.canModerate === 'true';
    const canConfigure = root.dataset.canConfigure === 'true';
    const canManageMedia = root.dataset.canManageMedia === 'true';
    const alertBox = root.querySelector<HTMLElement>('[data-reviews-alert]');
    const list = root.querySelector<HTMLElement>('[data-reviews-list]');
    const filter = root.querySelector<HTMLSelectElement>('[data-reviews-filter]');
    const enabled = root.querySelector<HTMLInputElement>('[data-reviews-enabled]');
    const heading = root.querySelector<HTMLInputElement>('[data-reviews-heading]');
    const saveConfig = root.querySelector<HTMLButtonElement>('[data-reviews-save-config]');
    const refresh = root.querySelector<HTMLButtonElement>('[data-reviews-refresh]');
    const previous = root.querySelector<HTMLButtonElement>('[data-reviews-previous]');
    const next = root.querySelector<HTMLButtonElement>('[data-reviews-next]');
    const pageLabel = root.querySelector<HTMLElement>('[data-reviews-page]');
    const requestForm = root.querySelector<HTMLFormElement>('[data-review-request-form]');
    const requestLocale = root.querySelector<HTMLSelectElement>('[data-review-request-locale]');
    const requestCustomer = root.querySelector<HTMLInputElement>('[data-review-request-customer]');
    const requestWork = root.querySelector<HTMLInputElement>('[data-review-request-work]');
    const requestExpiry = root.querySelector<HTMLSelectElement>('[data-review-request-expiry]');
    const requestPhotoSlots = root.querySelector<HTMLElement>('[data-review-request-photo-slots]');
    const requestPhotoCount = root.querySelector<HTMLElement>('[data-review-request-photo-count]');
    const requestCreate = root.querySelector<HTMLButtonElement>('[data-review-request-create]');
    const requestGenerated = root.querySelector<HTMLElement>('[data-review-request-generated]');
    const requestLink = root.querySelector<HTMLInputElement>('[data-review-request-link]');
    const requestQr = root.querySelector<HTMLImageElement>('[data-review-request-qr]');
    const requestList = root.querySelector<HTMLElement>('[data-review-request-list]');
    const requestSummary = root.querySelector<HTMLElement>('[data-review-request-summary]');
    let currentPage = 1;
    let totalPages = 1;
    let requestPage = 1;
    let draftVersion = 0;
    let draftDocument: Record<string, any> | null = null;
    let selectedPhotos: File[] = [];
    let generatedAssetIds: string[] = [];
    let generatedLink = '';
    let generatedPublicLink = '';
    let generatedShareText = '';
    const photoObjectUrls = new Map<File, string>();
    const photoErrors = new Map<number, string>();
    let configDirty = false;
    let requestDirty = false;
    const requestByReviewId = new Map<string, ReturnType<typeof normalizePromoReviewRequestsPage>['requests'][number]>();

    function show(message: string, tone: 'success' | 'error' | 'info' = 'info') {
      if (!alertBox) return;
      alertBox.hidden = !message;
      alertBox.textContent = message;
      alertBox.dataset.tone = tone;
    }

    async function responseJson(response: Response) {
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true) {
        const error = new Error(String(result?.error || 'promo_reviews_unavailable')) as Error & { code?: string };
        error.code = String(result?.error || 'promo_reviews_unavailable');
        throw error;
      }
      return result;
    }

    function clearStaleError() {
      if (alertBox?.dataset.tone === 'error') show('');
    }

    function setConfigDirty(value = true) {
      configDirty = value;
      if (saveConfig) saveConfig.disabled = !canConfigure || !configDirty;
    }

    function requestEndpoint(page?: number) {
      const url = new URL(PROMO_REVIEW_REQUESTS_API_PATH, window.location.origin);
      url.searchParams.set('store', storeSlug);
      if (page) url.searchParams.set('page', String(page));
      return url.toString();
    }

    function mediaEndpoint(assetId = '') {
      const url = new URL('/api/admin/promo-media', window.location.origin);
      url.searchParams.set('store', storeSlug);
      if (assetId) url.searchParams.set('asset', assetId);
      return url.toString();
    }

    function setRequestDirty(value = true) {
      requestDirty = value;
    }

    function releasePhoto(file: File | undefined) {
      if (!file) return;
      const objectUrl = photoObjectUrls.get(file);
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      photoObjectUrls.delete(file);
    }

    async function selectReviewPhoto(file: File | undefined, index: number) {
      if (!file || !canManageMedia || !canModerate || index < 0 || index > selectedPhotos.length || index >= 3) return;
      photoErrors.delete(index);
      renderSelectedPhotos();
      try {
        const prepared = await optimizePromoUploadImageFile(file, 'review') as File;
        if (selectedPhotos[index]) releasePhoto(selectedPhotos[index]);
        if (index < selectedPhotos.length) selectedPhotos[index] = prepared;
        else selectedPhotos.push(prepared);
        photoObjectUrls.set(prepared, URL.createObjectURL(prepared));
        setRequestDirty();
        clearStaleError();
      } catch (error) {
        const code = (error as { code?: string; message?: string })?.code || (error as Error)?.message;
        photoErrors.set(index, promoReviewRequestsErrorMessage(code));
        show(promoReviewRequestsErrorMessage(code), 'error');
      }
      renderSelectedPhotos();
    }

    function renderSelectedPhotos() {
      if (!requestPhotoSlots) return;
      requestPhotoSlots.replaceChildren();
      if (requestPhotoCount) requestPhotoCount.textContent = `${selectedPhotos.length} de 3 utilizadas`;
      for (let index = 0; index < 3; index += 1) {
        const file = selectedPhotos[index];
        const error = photoErrors.get(index) || '';
        const card = document.createElement('article');
        card.className = `pz-promo-media-slot${file ? ' is-filled is-pending' : ' is-empty'}${error ? ' is-error' : ''}`;
        const heading = document.createElement('div'); heading.className = 'pz-promo-media-slot__heading';
        const title = document.createElement('strong'); title.textContent = `Espacio ${index + 1}`;
        const state = document.createElement('span'); state.textContent = error ? 'Error' : (file ? 'Pendiente' : 'Disponible');
        heading.append(title, state); card.append(heading);
        if (file) {
          const preview = document.createElement('div'); preview.className = 'pz-promo-gallery__item-preview';
          const image = document.createElement('img');
          image.src = photoObjectUrls.get(file) || URL.createObjectURL(file);
          photoObjectUrls.set(file, image.src);
          image.alt = `Vista previa privada de la foto ${index + 1} del trabajo`;
          preview.append(image); card.append(preview);
        } else {
          const empty = document.createElement('div'); empty.className = 'pz-promo-media-slot__empty';
          const strong = document.createElement('strong'); strong.textContent = 'Arrastra una imagen aquí';
          const copy = document.createElement('span'); copy.textContent = 'o selecciónala desde tu dispositivo';
          empty.append(strong, copy); card.append(empty);
        }
        const input = document.createElement('input');
        input.type = 'file'; input.accept = 'image/jpeg,image/png,image/webp,image/avif';
        input.className = 'pz-promo-media-slot__input'; input.disabled = !canManageMedia || !canModerate;
        input.setAttribute('aria-label', `${file ? 'Reemplazar' : 'Elegir'} foto ${index + 1} del trabajo`);
        input.addEventListener('change', () => {
          void selectReviewPhoto(input.files?.[0], index).finally(() => { input.value = ''; });
        });
        const actions = document.createElement('div'); actions.className = 'pz-promo-media-slot__actions';
        const choose = document.createElement('button'); choose.type = 'button'; choose.className = 'pz-promo-gallery__secondary';
        choose.textContent = file ? 'Cambiar imagen' : 'Elegir imagen'; choose.disabled = input.disabled;
        choose.addEventListener('click', () => input.click()); actions.append(choose, input);
        if (file) {
          const up = document.createElement('button'); up.type = 'button'; up.className = 'pz-promo-gallery__secondary';
          up.textContent = '↑'; up.ariaLabel = 'Mover foto hacia la izquierda'; up.disabled = index === 0;
          up.addEventListener('click', () => {
            [selectedPhotos[index - 1], selectedPhotos[index]] = [selectedPhotos[index], selectedPhotos[index - 1]];
            photoErrors.clear(); setRequestDirty(); renderSelectedPhotos();
          });
          const down = document.createElement('button'); down.type = 'button'; down.className = 'pz-promo-gallery__secondary';
          down.textContent = '↓'; down.ariaLabel = 'Mover foto hacia la derecha'; down.disabled = index === selectedPhotos.length - 1;
          down.addEventListener('click', () => {
            [selectedPhotos[index + 1], selectedPhotos[index]] = [selectedPhotos[index], selectedPhotos[index + 1]];
            photoErrors.clear(); setRequestDirty(); renderSelectedPhotos();
          });
          const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'is-danger'; remove.textContent = 'Quitar';
          remove.addEventListener('click', () => {
            releasePhoto(selectedPhotos[index]); selectedPhotos.splice(index, 1); photoErrors.clear(); setRequestDirty(); renderSelectedPhotos();
          });
          actions.append(up, down, remove);
        }
        card.append(actions);
        const guidance = document.createElement('small'); guidance.className = `pz-promo-media-slot__guidance${error ? ' is-error' : ''}`;
        guidance.textContent = error || 'JPG, PNG, WebP o AVIF · horizontal 4:3 · mínimo 320×240 px · WebP comprimido y sin metadatos';
        card.append(guidance);
        card.addEventListener('dragover', (event) => {
          if (!canManageMedia || !canModerate || !Array.from(event.dataTransfer?.types || []).includes('Files')) return;
          event.preventDefault(); card.classList.add('is-dragover');
        });
        card.addEventListener('dragleave', () => card.classList.remove('is-dragover'));
        card.addEventListener('drop', (event) => {
          card.classList.remove('is-dragover');
          const dropped = event.dataTransfer?.files?.[0];
          if (!dropped || !canManageMedia || !canModerate) return;
          event.preventDefault(); void selectReviewPhoto(dropped, index);
        });
        requestPhotoSlots.append(card);
      }
    }

    async function uploadPhoto(file: File) {
      const body = new FormData();
      body.append('file', file); body.append('purpose', 'review'); body.append('poster_asset_id', '');
      const result = await responseJson(await fetch(mediaEndpoint(), { method: 'POST', body }));
      const id = String(result?.asset?.asset_id || '');
      if (!/^[a-z0-9]{15}$/.test(id) || result?.asset?.purpose !== 'review' || result?.asset?.kind !== 'image') {
        throw new Error('promo_media_backend_mismatch');
      }
      return id;
    }

    async function cleanupAssets(assetIds: string[]) {
      await Promise.allSettled(assetIds.map((assetId) => fetch(mediaEndpoint(), {
        method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ asset_id: assetId }),
      })));
    }

    function requestStatusLabel(status: string) {
      return ({ pending: 'Pendiente de uso', received: 'Reseña recibida', expired: 'Vencida', revoked: 'Revocada' } as Record<string, string>)[status] || status;
    }

    function renderRequestCard(item: ReturnType<typeof normalizePromoReviewRequestsPage>['requests'][number]) {
      const article = document.createElement('article'); article.className = 'pz-promo-reviews-admin__request-card';
      const header = document.createElement('header');
      const title = document.createElement('strong'); title.textContent = item.customerLabel || item.workLabel || 'Solicitud de reseña';
      const badge = document.createElement('span'); badge.dataset.status = item.status; badge.textContent = requestStatusLabel(item.status); header.append(title, badge);
      const info = document.createElement('p');
      const expiry = new Intl.DateTimeFormat('es', { dateStyle: 'medium' }).format(new Date(item.expiresAt));
      info.textContent = `${item.locale.toUpperCase()} · ${item.photoAssetIds.length} foto${item.photoAssetIds.length === 1 ? '' : 's'} · vence ${expiry}`;
      article.append(header, info);
      if (item.workLabel && item.workLabel !== title.textContent) { const work = document.createElement('p'); work.textContent = item.workLabel; article.append(work); }
      if (item.photoAssetIds.length) {
        const photos = document.createElement('div');
        photos.className = 'pz-promo-reviews-admin__request-thumbnails';
        photos.setAttribute('aria-label', 'Fotos privadas asociadas a la solicitud');
        item.photoAssetIds.forEach((assetId, index) => {
          const image = document.createElement('img');
          image.src = mediaEndpoint(assetId);
          image.alt = `Foto ${index + 1} del trabajo ${item.workLabel || item.customerLabel || 'solicitado'}`;
          image.loading = 'lazy';
          image.width = 120;
          image.height = 90;
          photos.append(image);
        });
        article.append(photos);
      }
      if (item.status === 'pending') {
        const revoke = document.createElement('button'); revoke.type = 'button'; revoke.textContent = 'Revocar enlace'; revoke.dataset.requestRevoke = item.id; revoke.dataset.tone = 'danger'; revoke.disabled = !canModerate; article.append(revoke);
      }
      return article;
    }

    async function loadRequests() {
      if (!canModerate) return;
      const page = normalizePromoReviewRequestsPage(await responseJson(await fetch(requestEndpoint(requestPage), { cache: 'no-store' })));
      requestByReviewId.clear();
      page.requests.forEach((item) => { if (item.reviewId) requestByReviewId.set(item.reviewId, item); });
      if (requestSummary) requestSummary.textContent = `${page.summary.pending} pendientes · ${page.summary.received} recibidas · ${page.summary.expired} vencidas · ${page.summary.revoked} revocadas`;
      if (requestList) {
        requestList.replaceChildren();
        if (!page.requests.length) { const empty = document.createElement('p'); empty.className = 'pz-promo-reviews-admin__empty'; empty.textContent = 'Todavía no hay solicitudes.'; requestList.append(empty); }
        else page.requests.forEach((item) => requestList.append(renderRequestCard(item)));
      }
      clearStaleError();
    }

    async function requestPhotoFiles(assetIds: string[]) {
      const files: File[] = [];
      for (let index = 0; index < assetIds.length; index += 1) {
        const response = await fetch(mediaEndpoint(assetIds[index]), { cache: 'no-store' });
        if (!response.ok) continue;
        files.push(new File([await response.blob()], `trabajo-${index + 1}.webp`, { type: 'image/webp' }));
      }
      return files;
    }

    async function displayGeneratedLink(token: string, locale: string, assetIds: string[]) {
      generatedPublicLink = promoPublicPageLink(publicSlug, locale, window.location.origin);
      generatedLink = promoReviewRequestLink(publicSlug, locale, token, window.location.origin);
      generatedShareText = `Hola. Gracias por confiar en ${storeName}.\n\nConoce nuestra página: ${generatedPublicLink}\n\nDeja tu reseña privada de este trabajo aquí: ${generatedLink}`;
      generatedAssetIds = assetIds.slice();
      if (requestLink) requestLink.value = generatedLink;
      const whatsapp = root.querySelector<HTMLAnchorElement>('[data-review-whatsapp-link]');
      if (whatsapp) whatsapp.href = `https://wa.me/?text=${encodeURIComponent(generatedShareText)}`;
      if (requestQr) {
        try {
          requestQr.src = await QRCode.toDataURL(generatedLink, { width: 220, margin: 1, errorCorrectionLevel: 'M' });
          requestQr.hidden = false;
        } catch (_) {
          requestQr.removeAttribute('src');
          requestQr.hidden = true;
        }
      }
      if (requestGenerated) requestGenerated.hidden = false;
      requestGenerated?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function createRequest() {
      if (!canModerate || !requestCreate || !requestLocale) return;
      requestCreate.disabled = true; requestCreate.textContent = 'Preparando solicitud…';
      const uploaded: string[] = [];
      let requestCreated = false;
      try {
        for (const file of selectedPhotos) uploaded.push(await uploadPhoto(file));
        const result = normalizePromoReviewRequestCreated(await responseJson(await fetch(requestEndpoint(), {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            locale: requestLocale.value,
            customer_label: requestCustomer?.value || '',
            work_label: requestWork?.value || '',
            photo_asset_ids: uploaded,
            expires_days: Number(requestExpiry?.value || 30),
          }),
        })));
        requestCreated = true;
        await displayGeneratedLink(result.token, result.request.locale, uploaded);
        selectedPhotos.forEach(releasePhoto);
        selectedPhotos = [];
        photoObjectUrls.clear();
        photoErrors.clear();
        requestDirty = false;
        renderSelectedPhotos();
        if (requestCustomer) requestCustomer.value = ''; if (requestWork) requestWork.value = '';
        show('Solicitud creada. El token solo se muestra en este enlace.', 'success');
        await loadRequests();
      } catch (error) {
        if (uploaded.length && !requestCreated) await cleanupAssets(uploaded);
        const candidate = error as { code?: string; message?: string };
        show(promoReviewRequestsErrorMessage(candidate.code || candidate.message), 'error');
      } finally { requestCreate.disabled = !canModerate; requestCreate.textContent = 'Generar enlace privado'; }
    }

    function statusLabel(status: string) {
      return ({ pending: 'Pendiente', approved: 'Aprobada', hidden: 'Oculta', rejected: 'Rechazada' } as Record<string, string>)[status] || status;
    }

    function actionButton(label: string, action: string, review: Record<string, any>, tone = '') {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = label;
      button.dataset.reviewAction = action;
      button.dataset.reviewId = review.id;
      button.dataset.reviewUpdated = review.updated;
      if (tone) button.dataset.tone = tone;
      button.disabled = !canModerate;
      return button;
    }

    function reviewCard(review: Record<string, any>) {
      const article = document.createElement('article');
      article.className = 'pz-promo-reviews-admin__card';
      article.dataset.reviewId = review.id;
      const top = document.createElement('div');
      top.className = 'pz-promo-reviews-admin__card-top';
      const identity = document.createElement('div');
      const name = document.createElement('h4');
      name.textContent = review.name;
      const meta = document.createElement('p');
      meta.textContent = `${'★'.repeat(review.rating)}${'☆'.repeat(5 - review.rating)} · ${statusLabel(review.status)}`;
      meta.setAttribute('aria-label', `${review.rating} de 5 estrellas. Estado: ${statusLabel(review.status)}`);
      identity.append(name, meta);
      const badge = document.createElement('span');
      badge.className = 'pz-promo-reviews-admin__status';
      badge.dataset.status = review.status;
      badge.textContent = review.featured ? 'Destacada' : statusLabel(review.status);
      top.append(identity, badge);
      article.append(top);
      const request = requestByReviewId.get(review.id);
      if (request) {
        const verified = document.createElement('p');
        verified.className = 'pz-promo-reviews-admin__verified';
        verified.textContent = `Trabajo verificado · ${request.photoAssetIds.length} foto${request.photoAssetIds.length === 1 ? '' : 's'}${request.photoAssetIds.length ? (request.photoConsent ? ' autorizadas' : ' privadas') : ''}`;
        article.append(verified);
      }
      if (review.comment) {
        const comment = document.createElement('p');
        comment.className = 'pz-promo-reviews-admin__comment';
        comment.textContent = review.comment;
        article.append(comment);
      }
      const footer = document.createElement('footer');
      const date = document.createElement('time');
      date.textContent = review.created ? new Intl.DateTimeFormat('es', { dateStyle: 'medium' }).format(new Date(review.created)) : 'Sin fecha';
      const actions = document.createElement('div');
      actions.className = 'pz-promo-reviews-admin__actions';
      if (review.status !== 'approved') actions.append(actionButton('Aprobar', 'approve', review));
      if (review.status !== 'rejected') actions.append(actionButton('Rechazar', 'reject', review, 'danger'));
      if (review.status === 'approved') {
        actions.append(actionButton('Ocultar', 'hide', review));
        actions.append(actionButton(review.featured ? 'Quitar destacado' : 'Destacar', review.featured ? 'unfeature' : 'feature', review));
      }
      footer.append(date, actions);
      article.append(footer);
      return article;
    }

    function renderPage(page: ReturnType<typeof normalizePromoReviewsPage>) {
      totalPages = page.totalPages;
      root.querySelector<HTMLElement>('[data-review-metric="average"]')!.textContent = page.summary.approvedAverage.toFixed(1);
      root.querySelector<HTMLElement>('[data-review-metric="pending"]')!.textContent = String(page.summary.pending);
      root.querySelector<HTMLElement>('[data-review-metric="approved"]')!.textContent = String(page.summary.approved);
      root.querySelector<HTMLElement>('[data-review-metric="total"]')!.textContent = String(page.summary.total);
      if (list) {
        list.replaceChildren();
        if (!page.reviews.length) {
          const empty = document.createElement('p');
          empty.className = 'pz-promo-reviews-admin__empty';
          empty.textContent = 'No hay reseñas de tienda para este filtro.';
          list.append(empty);
        } else page.reviews.forEach((review) => list.append(reviewCard(review)));
      }
      if (pageLabel) pageLabel.textContent = `${page.page} de ${page.totalPages}`;
      if (previous) previous.disabled = page.page <= 1;
      if (next) next.disabled = page.page >= page.totalPages;
    }

    async function loadReviews() {
      if (!canModerate) {
        if (list) {
          const empty = document.createElement('p');
          empty.className = 'pz-promo-reviews-admin__empty';
          empty.textContent = 'Tu sesión no tiene acceso a moderación.';
          list.replaceChildren(empty);
        }
        return;
      }
      const url = new URL(PROMO_REVIEWS_API_PATH, window.location.origin);
      url.searchParams.set('store', storeSlug);
      url.searchParams.set('status', filter?.value || 'all');
      url.searchParams.set('page', String(currentPage));
      renderPage(normalizePromoReviewsPage(await responseJson(await fetch(url, { cache: 'no-store' }))));
      clearStaleError();
    }

    async function loadConfig() {
      const result = await responseJson(await fetch(`/api/admin/promo-cms?store=${encodeURIComponent(storeSlug)}`, { cache: 'no-store' }));
      const draft = normalizePromoCmsDraftResponse(result);
      draftVersion = draft.version;
      draftDocument = draft.document;
      const section = draft.document.sections.find((item: Record<string, any>) => item.type === 'store_rating');
      const active = draft.document.adapters.store_rating.enabled === true && section?.visible === true;
      if (enabled) enabled.checked = active;
      const locale = draft.document.locales.default;
      if (heading) heading.value = String(section && draft.document.content_by_locale[locale]?.sections?.[section.key]?.heading || '');
      if (requestLocale) {
        const current = requestLocale.value;
        requestLocale.replaceChildren();
        draft.document.locales.published.forEach((candidate: string) => {
          const option = document.createElement('option'); option.value = candidate; option.textContent = candidate.toUpperCase();
          option.selected = candidate === current || (!current && candidate === locale); requestLocale.append(option);
        });
      }
      setConfigDirty(false);
      clearStaleError();
    }

    async function saveDisplayConfig() {
      if (!canConfigure || !configDirty || !draftDocument || !draftVersion) return;
      if (saveConfig) saveConfig.disabled = true;
      try {
        const document = buildPromoReviewsDisplayDocument(draftDocument, {
          enabled: enabled?.checked === true,
          heading: String(heading?.value || ''),
        });
        const result = await responseJson(await fetch(`/api/admin/promo-cms?store=${encodeURIComponent(storeSlug)}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ expected_version: draftVersion, document }),
        }));
        const draft = normalizePromoCmsDraftResponse(result);
        draftVersion = draft.version;
        draftDocument = draft.document;
        setConfigDirty(false);
        show('Configuración guardada y página pública actualizada.', 'success');
      } catch (error) {
        show(promoReviewsErrorMessage((error as { code?: string })?.code), 'error');
      } finally { if (saveConfig) saveConfig.disabled = !canConfigure || !configDirty; }
    }

    async function moderate(button: HTMLButtonElement) {
      button.disabled = true;
      try {
        const result = await responseJson(await fetch(`${PROMO_REVIEWS_API_PATH}?store=${encodeURIComponent(storeSlug)}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            review_id: button.dataset.reviewId,
            action: button.dataset.reviewAction,
            expected_updated: button.dataset.reviewUpdated,
          }),
        }));
        normalizePromoReviewModeration(result);
        show('Reseña actualizada correctamente.', 'success');
        await loadReviews();
      } catch (error) {
        show(promoReviewsErrorMessage((error as { code?: string })?.code), 'error');
        button.disabled = false;
      }
    }

    async function loadWorkspace() {
      await Promise.all([loadConfig(), loadRequests()]);
      await loadReviews();
    }

    filter?.addEventListener('change', () => { currentPage = 1; void loadReviews().catch((error) => show(promoReviewsErrorMessage(error?.code), 'error')); });
    previous?.addEventListener('click', () => { if (currentPage > 1) { currentPage -= 1; void loadReviews(); } });
    next?.addEventListener('click', () => { if (currentPage < totalPages) { currentPage += 1; void loadReviews(); } });
    refresh?.addEventListener('click', () => {
      if (configDirty || requestDirty) {
        show('Guarda o completa los cambios pendientes antes de actualizar los datos.', 'error');
        return;
      }
      void loadWorkspace().catch((error) => show(promoReviewsErrorMessage(error?.code), 'error'));
    });
    saveConfig?.addEventListener('click', () => { void saveDisplayConfig(); });
    enabled?.addEventListener('change', () => setConfigDirty());
    heading?.addEventListener('input', () => setConfigDirty());
    list?.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-review-action]') : null;
      if (button) void moderate(button);
    });

    requestForm?.addEventListener('input', () => setRequestDirty());
    requestForm?.addEventListener('change', () => setRequestDirty());
    requestForm?.addEventListener('submit', (event) => { event.preventDefault(); void createRequest(); });
    root.querySelector('[data-review-copy-link]')?.addEventListener('click', () => {
      if (!generatedLink) return;
      void navigator.clipboard.writeText(generatedLink).then(() => show('Enlace copiado.', 'success')).catch(() => show('No se pudo copiar el enlace.', 'error'));
    });
    root.querySelector('[data-review-share-link]')?.addEventListener('click', () => {
      if (!generatedLink || typeof navigator.share !== 'function') {
        void navigator.clipboard.writeText(generatedLink).then(() => show('Enlace copiado para compartir.', 'success'));
        return;
      }
      void (async () => {
        try {
          const files = await requestPhotoFiles(generatedAssetIds);
          const payload: ShareData = {
            title: `Solicitud de reseña · ${storeName}`,
            text: `Gracias por confiar en ${storeName}. Conoce nuestra página: ${generatedPublicLink}`,
            url: generatedLink,
          };
          if (files.length && typeof navigator.canShare === 'function' && navigator.canShare({ files })) payload.files = files;
          await navigator.share(payload);
        } catch (error) {
          if ((error as DOMException)?.name !== 'AbortError') show('No se pudo abrir el menú Compartir.', 'error');
        }
      })();
    });
    requestList?.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-request-revoke]') : null;
      if (!button) return;
      button.disabled = true;
      void fetch(requestEndpoint(), {
        method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ request_id: button.dataset.requestRevoke }),
      }).then(responseJson).then((value) => {
        normalizePromoReviewRequestRevoked(value); show('Enlace revocado y fotos retiradas.', 'success'); return loadRequests();
      }).catch((error) => { show(promoReviewRequestsErrorMessage(error?.code), 'error'); button.disabled = false; });
    });

    renderSelectedPhotos();
    void loadWorkspace().catch((error) => show(promoReviewsErrorMessage(error?.code), 'error'));
    window.addEventListener('beforeunload', (event) => {
      if (!configDirty && !requestDirty) return;
      event.preventDefault();
    });
    window.addEventListener('pagehide', () => {
      photoObjectUrls.forEach((url) => URL.revokeObjectURL(url)); photoObjectUrls.clear();
    }, { once: true });
  });
</script>
