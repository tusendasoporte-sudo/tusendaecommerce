---
import '../../../styles/promo-gallery.css';

interface Props {
  storeSlug: string;
  maxGalleryAssets: number;
  maxVideos: number;
  maxStorageBytes: number;
  canSave: boolean;
  canManageMedia: boolean;
  canManageVideo: boolean;
}

const {
  storeSlug,
  maxGalleryAssets,
  maxVideos,
  maxStorageBytes,
  canSave,
  canManageMedia,
  canManageVideo,
} = Astro.props;
---

<section
  class="pz-promo-gallery"
  data-promo-gallery-editor
  data-store-slug={storeSlug}
  data-max-gallery={maxGalleryAssets}
  data-max-videos={maxVideos}
  data-max-storage={maxStorageBytes}
  data-can-save={canSave ? 'true' : 'false'}
  data-can-manage-media={canManageMedia ? 'true' : 'false'}
  data-can-manage-video={canManageVideo ? 'true' : 'false'}
  aria-labelledby="promo-gallery-title"
>
  <header class="pz-promo-gallery__intro">
    <div>
      <span class="pz-promo-gallery__eyebrow">Página pública en vivo</span>
      <h2 id="promo-gallery-title">Portada, galerías y trabajos</h2>
      <p>Crea galerías como categorías, agrega varios medios por trabajo y marca los que aparecerán como destacados.</p>
    </div>
    <span class="pz-promo-gallery__draft-badge">Guardado directo · CAS</span>
  </header>

  {!canSave && (
    <aside class="pz-promo-gallery__permission" role="note">
      <strong>Composición en modo lectura.</strong>
      <span>Tu sesión puede consultar el contenido, pero no actualizar la página pública.</span>
    </aside>
  )}

  <div class="pz-promo-gallery__metrics" aria-label="Uso y límites de medios">
    <article><strong data-gallery-count>—</strong><span>Medios usados en galerías</span><small data-gallery-limit>de {maxGalleryAssets}</small></article>
    <article><strong data-gallery-video-count>—</strong><span>Videos almacenados</span><small data-gallery-video-limit>de {maxVideos}</small></article>
    <article><strong data-gallery-storage>—</strong><span>Almacenamiento</span><small data-gallery-storage-limit>de la cuota asignada</small></article>
  </div>

  <div class="pz-promo-gallery__alert" data-gallery-alert role="alert" tabindex="-1" hidden></div>
  <p class="pz-promo-gallery__status" data-gallery-status role="status" aria-live="polite">Cargando página y biblioteca…</p>

  <div data-gallery-workspace hidden>
    <form class="pz-promo-gallery__form" data-gallery-form novalidate>
      <section class="pz-promo-gallery__section" aria-labelledby="promo-hero-media-title">
        <header>
          <div><span class="pz-promo-gallery__eyebrow">Portada</span><h3 id="promo-hero-media-title">Carrusel principal</h3></div>
          <button type="button" class="pz-promo-gallery__secondary" data-hero-add disabled={!canSave}>+ Añadir imagen o video</button>
        </header>
        <p>Un medio muestra una portada fija; dos o más activan el carrusel accesible.</p>
        <div class="pz-promo-gallery__items" data-hero-media></div>
      </section>

      <div class="pz-promo-gallery__section-list" data-gallery-sections></div>
      <button type="button" class="pz-promo-gallery__add" data-gallery-add disabled={!canSave}>+ Crear otra galería</button>

      <footer class="pz-promo-gallery__savebar">
        <span data-gallery-version>Versión de página: —</span>
        <button type="submit" data-gallery-save disabled>Guardar y actualizar página</button>
      </footer>
    </form>

    <section class="pz-promo-gallery__library" aria-labelledby="promo-media-library-title">
      <header>
        <div>
          <span class="pz-promo-gallery__eyebrow">Biblioteca privada de la tienda</span>
          <h3 id="promo-media-library-title">Medios disponibles</h3>
          <p>Las imágenes se optimizan a WebP y el backend vuelve a validar tipo, tamaño y tenant.</p>
        </div>
        <button type="button" class="pz-promo-gallery__secondary" data-gallery-refresh>Actualizar</button>
      </header>

      <form class="pz-promo-gallery__upload" data-gallery-upload-form>
        <div class="pz-promo-gallery__field">
          <label for="promo-gallery-upload-kind">Destino</label>
          <select id="promo-gallery-upload-kind" data-gallery-upload-kind disabled={!canManageMedia}>
            <option value="gallery_image">Imagen para galería</option>
            <option value="hero_image">Imagen para portada</option>
            <option value="video_poster">Poster para video</option>
            {canManageVideo && <option value="gallery_video">Video para galería</option>}
            {canManageVideo && <option value="hero_video">Video para portada</option>}
          </select>
        </div>
        <div class="pz-promo-gallery__field">
          <label for="promo-gallery-file">Archivo</label>
          <input id="promo-gallery-file" data-gallery-file type="file" accept="image/jpeg,image/png,image/webp,image/avif" required disabled={!canManageMedia} />
          <small data-gallery-file-help>JPEG, PNG, WebP o AVIF; se almacena WebP normalizado.</small>
        </div>
        <div class="pz-promo-gallery__field" data-gallery-poster-field hidden>
          <label for="promo-gallery-poster">Poster del video</label>
          <select id="promo-gallery-poster" data-gallery-poster disabled={!canManageVideo}></select>
        </div>
        <button type="submit" data-gallery-upload disabled={!canManageMedia}>Procesar y subir</button>
      </form>
      <p class="pz-promo-gallery__upload-note">Los videos requieren poster, controles visibles, carga diferida y nunca usan reproducción automática.</p>
      <div class="pz-promo-gallery__asset-grid" data-gallery-assets></div>
    </section>
  </div>
</section>

<script>
  import {
    buildPromoGalleryDocument,
    createPromoGalleryWorkspace,
    normalizePromoGalleryCatalog,
    normalizePromoGalleryDraft,
    promoGalleryErrorMessage,
    promoGalleryPreviewPath,
    PROMO_GALLERY_DRAFT_API_PATH,
    PROMO_GALLERY_MEDIA_API_PATH,
  } from '../../../lib/promoGallery.ts';

  type Catalog = ReturnType<typeof normalizePromoGalleryCatalog>;
  type Draft = ReturnType<typeof normalizePromoGalleryDraft>;
  type MediaModel = { useKey: string; assetId: string; alt: string; decorative: boolean };
  type WorkModel = {
    key: string; featured: boolean; visible: boolean; name: string; summary: string; caption: string; media: MediaModel[];
  };
  type GalleryModel = {
    key: string; visible: boolean; navigationLabel: string; heading: string; summary: string;
    coverUseKey: string; items: WorkModel[];
  };
  type EditorModel = { heroMedia: MediaModel[]; galleries: GalleryModel[] };

  const root = document.querySelector<HTMLElement>('[data-promo-gallery-editor]');
  if (root) {
    const storeSlug = root.dataset.storeSlug || '';
    const maxGallery = Number(root.dataset.maxGallery || 0);
    const canSave = root.dataset.canSave === 'true';
    const canManageMedia = root.dataset.canManageMedia === 'true';
    const canManageVideo = root.dataset.canManageVideo === 'true';
    const workspaceElement = root.querySelector<HTMLElement>('[data-gallery-workspace]');
    const form = root.querySelector<HTMLFormElement>('[data-gallery-form]');
    const heroElement = root.querySelector<HTMLElement>('[data-hero-media]');
    const sectionsElement = root.querySelector<HTMLElement>('[data-gallery-sections]');
    const assetsElement = root.querySelector<HTMLElement>('[data-gallery-assets]');
    const statusElement = root.querySelector<HTMLElement>('[data-gallery-status]');
    const alertElement = root.querySelector<HTMLElement>('[data-gallery-alert]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-gallery-save]');
    const uploadForm = root.querySelector<HTMLFormElement>('[data-gallery-upload-form]');
    const uploadKind = root.querySelector<HTMLSelectElement>('[data-gallery-upload-kind]');
    const fileInput = root.querySelector<HTMLInputElement>('[data-gallery-file]');
    const fileHelp = root.querySelector<HTMLElement>('[data-gallery-file-help]');
    const posterField = root.querySelector<HTMLElement>('[data-gallery-poster-field]');
    const posterSelect = root.querySelector<HTMLSelectElement>('[data-gallery-poster]');
    let draft: Draft | null = null;
    let catalog: Catalog | null = null;
    let model: EditorModel = { heroMedia: [], galleries: [] };
    let dirty = false;
    let busy = false;

    const endpoint = (path: string) => `${path}?store=${encodeURIComponent(storeSlug)}`;
    const text = (value: unknown) => String(value === null || value === undefined ? '' : value);

    function element<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', value = '') {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (value) node.textContent = value;
      return node;
    }

    function newKey(prefix: string, maximum = 64) {
      const bytes = crypto.getRandomValues(new Uint8Array(6));
      const suffix = Array.from(bytes, (value) => value.toString(16).padStart(2, '0')).join('');
      return `${prefix}-${suffix}`.slice(0, maximum);
    }

    function setStatus(message: string) {
      if (statusElement) statusElement.textContent = message;
    }

    function showError(error: any) {
      if (!alertElement) return;
      alertElement.textContent = promoGalleryErrorMessage(error?.code || error?.message);
      alertElement.hidden = false;
      alertElement.focus();
    }

    function clearError() {
      if (alertElement) alertElement.hidden = true;
    }

    function markDirty() {
      dirty = true;
      if (saveButton) saveButton.disabled = busy || !canSave;
      setStatus('Hay cambios sin guardar. Guardar actualizará la página pública.');
    }

    async function requestJson(url: string, init?: RequestInit) {
      const response = await fetch(url, { ...init, headers: { Accept: 'application/json', ...(init?.headers || {}) } });
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true) {
        const error = new Error(text(result?.error || 'promo_media_unavailable')) as Error & { code?: string };
        error.code = text(result?.error || 'promo_media_unavailable');
        throw error;
      }
      return result;
    }

    function mediaFromDocument(documentValue: any, locale: string, useKey: string): MediaModel | null {
      const ref = documentValue.media_refs?.[useKey];
      if (!ref?.asset_id) return null;
      const alt = documentValue.content_by_locale?.[locale]?.media_alt?.[useKey] || {};
      return { useKey, assetId: text(ref.asset_id), alt: text(alt.alt), decorative: alt.decorative === true };
    }

    function modelFromDocument(documentValue: any, locale: string): EditorModel {
      const localized = documentValue.content_by_locale?.[locale] || {};
      const hero = documentValue.sections.find((section: any) => section.type === 'hero');
      const heroMedia = (hero?.media_use_keys || []).map((useKey: string) => mediaFromDocument(documentValue, locale, useKey)).filter(Boolean);
      const galleries = documentValue.sections.filter((section: any) => section.type === 'gallery').map((section: any) => {
        const content = localized.sections?.[section.key] || {};
        const itemText = new Map((content.items || []).map((item: any) => [item.key, item]));
        return {
          key: section.key,
          visible: section.visible === true,
          navigationLabel: text(localized.navigation?.[section.key] || 'Galería'),
          heading: text(content.heading),
          summary: text(content.summary),
          coverUseKey: text(section.config?.cover_media_use_key),
          items: (section.config?.items || []).map((item: any) => {
            const localizedItem: any = itemText.get(item.key) || {};
            return {
              key: item.key,
              featured: item.featured === true,
              visible: item.visible === true,
              name: text(localizedItem.name),
              summary: text(localizedItem.summary),
              caption: text(localizedItem.caption),
              media: (item.media_use_keys || []).map((useKey: string) => mediaFromDocument(documentValue, locale, useKey)).filter(Boolean),
            };
          }),
        };
      });
      return { heroMedia: heroMedia as MediaModel[], galleries };
    }

    function assetById(assetId: string) {
      return catalog?.assets.find((asset) => asset.assetId === assetId) || null;
    }

    function readyAssets(purpose: string) {
      return (catalog?.assets || []).filter((asset) => asset.status === 'ready' && asset.purpose === purpose);
    }

    function fillAssetSelect(select: HTMLSelectElement, purpose: string, current: string) {
      const empty = element('option', '', 'Selecciona un medio');
      empty.value = '';
      select.append(empty);
      readyAssets(purpose).forEach((asset) => {
        const option = element('option', '', `${asset.kind === 'video' ? 'Video' : 'Imagen'} · ${asset.width}×${asset.height}`);
        option.value = asset.assetId;
        option.selected = asset.assetId === current;
        select.append(option);
      });
      select.required = true;
    }

    function preview(assetId: string) {
      const frame = element('div', 'pz-promo-gallery__item-preview');
      const asset = assetById(assetId);
      const src = promoGalleryPreviewPath(storeSlug, assetId);
      if (!asset || !src) {
        frame.append(element('span', '', 'Selecciona un medio'));
      } else if (asset.kind === 'video') {
        const video = document.createElement('video');
        video.src = src;
        video.controls = true;
        video.preload = 'none';
        video.muted = false;
        frame.append(video);
      } else {
        const image = document.createElement('img');
        image.src = src;
        image.alt = '';
        image.loading = 'lazy';
        frame.append(image);
      }
      return frame;
    }

    function field(labelText: string, control: HTMLElement, wide = false) {
      const wrapper = element('div', `pz-promo-gallery__field${wide ? ' is-wide' : ''}`);
      const label = element('label', '', labelText);
      label.append(control);
      wrapper.append(label);
      return wrapper;
    }

    function mediaRow(media: MediaModel, purpose: 'hero' | 'gallery', items: MediaModel[], index: number) {
      const card = element('article', 'pz-promo-gallery__item');
      card.append(preview(media.assetId));
      const main = element('div', 'pz-promo-gallery__item-main');
      const assetSelect = document.createElement('select');
      fillAssetSelect(assetSelect, purpose, media.assetId);
      assetSelect.disabled = !canSave;
      assetSelect.addEventListener('change', () => { media.assetId = assetSelect.value; markDirty(); render(); });
      const altInput = document.createElement('input');
      altInput.type = 'text'; altInput.maxLength = 300; altInput.value = media.alt; altInput.required = !media.decorative; altInput.disabled = !canSave;
      altInput.addEventListener('input', () => { media.alt = altInput.value; markDirty(); });
      const decorative = document.createElement('input');
      decorative.type = 'checkbox'; decorative.checked = media.decorative; decorative.disabled = !canSave;
      decorative.addEventListener('change', () => {
        media.decorative = decorative.checked;
        if (media.decorative) media.alt = '';
        markDirty(); render();
      });
      const decorativeLabel = element('label', 'pz-promo-gallery__check');
      decorativeLabel.append(decorative, element('span', '', 'Es decorativo; usar texto alternativo vacío'));
      main.append(field('Medio de la biblioteca', assetSelect), field('Texto alternativo', altInput), decorativeLabel);
      card.append(main);
      const actions = element('div', 'pz-promo-gallery__item-actions');
      const up = element('button', '', '↑'); up.type = 'button'; up.ariaLabel = 'Subir medio'; up.disabled = !canSave || index === 0;
      const down = element('button', '', '↓'); down.type = 'button'; down.ariaLabel = 'Bajar medio'; down.disabled = !canSave || index === items.length - 1;
      const remove = element('button', 'is-danger', 'Quitar'); remove.type = 'button'; remove.disabled = !canSave;
      up.addEventListener('click', () => { [items[index - 1], items[index]] = [items[index], items[index - 1]]; markDirty(); render(); });
      down.addEventListener('click', () => { [items[index + 1], items[index]] = [items[index], items[index + 1]]; markDirty(); render(); });
      remove.addEventListener('click', () => { items.splice(index, 1); markDirty(); render(); });
      actions.append(up, down, remove);
      card.append(actions);
      return card;
    }

    function addMedia(target: MediaModel[], purpose: 'hero' | 'gallery') {
      const first = readyAssets(purpose)[0];
      if (!first) return showError({ code: 'invalid_promo_media_reference' });
      target.push({ useKey: newKey(`${purpose}-media`, 120), assetId: first.assetId, alt: '', decorative: false });
      markDirty(); render();
    }

    function renderHero() {
      if (!heroElement) return;
      heroElement.replaceChildren();
      model.heroMedia.forEach((media, index) => heroElement.append(mediaRow(media, 'hero', model.heroMedia, index)));
      if (!model.heroMedia.length) heroElement.append(element('p', 'pz-promo-gallery__empty', 'Aún no hay medios en la portada.'));
    }

    function renderWork(gallery: GalleryModel, work: WorkModel, index: number) {
      const card = element('article', 'pz-promo-gallery__work');
      const header = element('header');
      header.append(element('strong', '', `Trabajo ${index + 1}`));
      const flags = element('div', 'pz-promo-gallery__flags');
      const visible = document.createElement('input'); visible.type = 'checkbox'; visible.checked = work.visible; visible.disabled = !canSave;
      const featured = document.createElement('input'); featured.type = 'checkbox'; featured.checked = work.featured; featured.disabled = !canSave;
      const visibleLabel = element('label', 'pz-promo-gallery__check'); visibleLabel.append(visible, element('span', '', 'Visible'));
      const featuredLabel = element('label', 'pz-promo-gallery__check'); featuredLabel.append(featured, element('span', '', 'Destacado'));
      visible.addEventListener('change', () => { work.visible = visible.checked; markDirty(); });
      featured.addEventListener('change', () => { work.featured = featured.checked; markDirty(); });
      flags.append(visibleLabel, featuredLabel); header.append(flags); card.append(header);
      const fields = element('div', 'pz-promo-gallery__section-fields');
      const name = document.createElement('input'); name.type = 'text'; name.maxLength = 160; name.required = work.visible; name.value = work.name; name.disabled = !canSave;
      const summary = document.createElement('textarea'); summary.maxLength = 600; summary.rows = 2; summary.value = work.summary; summary.disabled = !canSave;
      const caption = document.createElement('textarea'); caption.maxLength = 500; caption.rows = 2; caption.value = work.caption; caption.disabled = !canSave;
      name.addEventListener('input', () => { work.name = name.value; markDirty(); });
      summary.addEventListener('input', () => { work.summary = summary.value; markDirty(); });
      caption.addEventListener('input', () => { work.caption = caption.value; markDirty(); });
      fields.append(field('Nombre del trabajo', name), field('Descripción breve', summary), field('Leyenda', caption, true));
      card.append(fields);
      const mediaList = element('div', 'pz-promo-gallery__items');
      work.media.forEach((media, mediaIndex) => mediaList.append(mediaRow(media, 'gallery', work.media, mediaIndex)));
      if (!work.media.length) mediaList.append(element('p', 'pz-promo-gallery__empty', 'Añade una o varias fotos para este trabajo.'));
      card.append(mediaList);
      const actions = element('div', 'pz-promo-gallery__work-actions');
      const add = element('button', 'pz-promo-gallery__secondary', '+ Añadir foto o video'); add.type = 'button'; add.disabled = !canSave;
      const remove = element('button', 'is-danger', 'Eliminar trabajo'); remove.type = 'button'; remove.disabled = !canSave;
      add.addEventListener('click', () => addMedia(work.media, 'gallery'));
      remove.addEventListener('click', () => { gallery.items.splice(index, 1); markDirty(); render(); });
      actions.append(add, remove); card.append(actions);
      return card;
    }

    function renderGalleries() {
      if (!sectionsElement) return;
      sectionsElement.replaceChildren();
      model.galleries.forEach((gallery, galleryIndex) => {
        const section = element('article', 'pz-promo-gallery__section');
        const header = element('header');
        const title = element('div'); title.append(element('span', 'pz-promo-gallery__eyebrow', `Galería ${galleryIndex + 1}`), element('h3', '', gallery.heading || 'Nueva galería'));
        const visible = document.createElement('input'); visible.type = 'checkbox'; visible.checked = gallery.visible; visible.disabled = !canSave;
        const visibleLabel = element('label', 'pz-promo-gallery__toggle'); visibleLabel.append(visible, element('span', '', 'Visible en la página'));
        visible.addEventListener('change', () => { gallery.visible = visible.checked; markDirty(); });
        header.append(title, visibleLabel); section.append(header);
        const fields = element('div', 'pz-promo-gallery__section-fields');
        const navigation = document.createElement('input'); navigation.type = 'text'; navigation.maxLength = 80; navigation.required = true; navigation.value = gallery.navigationLabel; navigation.disabled = !canSave;
        const heading = document.createElement('input'); heading.type = 'text'; heading.maxLength = 160; heading.required = gallery.visible; heading.value = gallery.heading; heading.disabled = !canSave;
        const summary = document.createElement('textarea'); summary.maxLength = 600; summary.rows = 2; summary.value = gallery.summary; summary.disabled = !canSave;
        navigation.addEventListener('input', () => { gallery.navigationLabel = navigation.value; markDirty(); });
        heading.addEventListener('input', () => { gallery.heading = heading.value; markDirty(); });
        summary.addEventListener('input', () => { gallery.summary = summary.value; markDirty(); });
        fields.append(field('Nombre en navegación', navigation), field('Título de la galería', heading), field('Descripción', summary, true));
        section.append(fields);
        const cover = document.createElement('select');
        const empty = element('option', '', 'Selecciona la portada'); empty.value = ''; cover.append(empty);
        gallery.items.flatMap((item) => item.media).forEach((media, mediaIndex) => {
          const option = element('option', '', `${assetById(media.assetId)?.kind === 'video' ? 'Video' : 'Imagen'} ${mediaIndex + 1}`);
          option.value = media.useKey; option.selected = media.useKey === gallery.coverUseKey; cover.append(option);
        });
        cover.required = gallery.visible; cover.disabled = !canSave;
        cover.addEventListener('change', () => { gallery.coverUseKey = cover.value; markDirty(); });
        section.append(field('Imagen de portada de la galería', cover, true));
        const works = element('div', 'pz-promo-gallery__works');
        gallery.items.forEach((work, index) => works.append(renderWork(gallery, work, index)));
        if (!gallery.items.length) works.append(element('p', 'pz-promo-gallery__empty', 'Esta galería aún no contiene trabajos.'));
        section.append(works);
        const actions = element('div', 'pz-promo-gallery__work-actions');
        const addWork = element('button', 'pz-promo-gallery__secondary', '+ Añadir trabajo'); addWork.type = 'button'; addWork.disabled = !canSave;
        const removeGallery = element('button', 'is-danger', 'Eliminar galería'); removeGallery.type = 'button'; removeGallery.disabled = !canSave;
        addWork.addEventListener('click', () => {
          gallery.items.push({ key: newKey('work'), featured: false, visible: true, name: '', summary: '', caption: '', media: [] });
          markDirty(); render();
        });
        removeGallery.addEventListener('click', () => { model.galleries.splice(galleryIndex, 1); markDirty(); render(); });
        actions.append(addWork, removeGallery); section.append(actions);
        sectionsElement.append(section);
      });
      if (!model.galleries.length) sectionsElement.append(element('p', 'pz-promo-gallery__empty', 'Crea una galería para comenzar.'));
    }

    function updateMetrics() {
      const used = model.galleries.reduce((total, gallery) => total + gallery.items.reduce((sum, item) => sum + item.media.length, 0), 0);
      const count = root.querySelector<HTMLElement>('[data-gallery-count]');
      const videos = root.querySelector<HTMLElement>('[data-gallery-video-count]');
      const storage = root.querySelector<HTMLElement>('[data-gallery-storage]');
      if (count) count.textContent = String(used);
      if (videos) videos.textContent = String(catalog?.usage.videos || 0);
      if (storage) storage.textContent = `${((catalog?.usage.bytes || 0) / 1048576).toFixed(1)} MB`;
    }

    function render() {
      renderHero(); renderGalleries(); updateMetrics();
      const version = root.querySelector<HTMLElement>('[data-gallery-version]');
      if (version) version.textContent = `Versión de página: ${draft?.version || '—'}`;
      if (saveButton) saveButton.disabled = busy || !canSave || !dirty;
    }

    function renderLibrary() {
      if (!assetsElement) return;
      assetsElement.replaceChildren();
      const assets = catalog?.assets || [];
      if (!assets.length) {
        assetsElement.append(element('p', 'pz-promo-gallery__empty', 'La biblioteca está vacía.'));
        return;
      }
      assets.forEach((asset) => {
        const card = element('article', 'pz-promo-gallery__asset');
        const frame = preview(asset.assetId); frame.className = 'pz-promo-gallery__asset-preview';
        const copy = element('div');
        copy.append(element('strong', '', `${asset.kind === 'video' ? 'Video' : 'Imagen'} · ${asset.purpose}`), element('span', '', `${asset.width}×${asset.height}`), element('small', '', `${(asset.bytes / 1024).toFixed(0)} KB · ${asset.status}`));
        const retire = element('button', 'pz-promo-gallery__retire', 'Retirar'); retire.type = 'button'; retire.disabled = !canManageMedia || asset.status !== 'ready';
        retire.addEventListener('click', async () => {
          clearError(); busy = true; retire.disabled = true;
          try {
            await requestJson(endpoint(PROMO_GALLERY_MEDIA_API_PATH), {
              method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ asset_id: asset.assetId }),
            });
            await loadCatalog();
            setStatus('Medio retirado de la biblioteca.');
          } catch (error) { showError(error); } finally { busy = false; render(); }
        });
        card.append(frame, copy, retire); assetsElement.append(card);
      });
    }

    function updateUploadControls() {
      const kind = uploadKind?.value || 'gallery_image';
      const video = kind.endsWith('_video');
      if (fileInput) fileInput.accept = video ? 'video/mp4,video/webm' : 'image/jpeg,image/png,image/webp,image/avif';
      if (fileHelp) fileHelp.textContent = video ? 'MP4 o WebM optimizado; máximo 25 MB.' : 'JPEG, PNG, WebP o AVIF; se guarda WebP normalizado.';
      if (posterField) posterField.hidden = !video;
      if (posterSelect) {
        posterSelect.replaceChildren();
        const empty = element('option', '', 'Selecciona un poster'); empty.value = ''; posterSelect.append(empty);
        readyAssets('video_poster').forEach((asset) => {
          const option = element('option', '', `${asset.width}×${asset.height}`); option.value = asset.assetId; posterSelect.append(option);
        });
        posterSelect.required = video;
      }
    }

    async function loadCatalog() {
      catalog = normalizePromoGalleryCatalog(await requestJson(endpoint(PROMO_GALLERY_MEDIA_API_PATH)));
      renderLibrary(); updateUploadControls(); updateMetrics();
    }

    async function loadAll() {
      clearError(); busy = true; setStatus('Cargando página y biblioteca…');
      try {
        const [draftResult] = await Promise.all([
          requestJson(endpoint(PROMO_GALLERY_DRAFT_API_PATH)),
          loadCatalog(),
        ]);
        draft = normalizePromoGalleryDraft(draftResult);
        const workspace = createPromoGalleryWorkspace(draft.document);
        draft = { version: draft.version, document: workspace.document };
        model = modelFromDocument(workspace.document, workspace.locale);
        dirty = false;
        if (workspaceElement) workspaceElement.hidden = false;
        setStatus('Página cargada. Guardar aplicará los cambios públicos inmediatamente.');
      } catch (error) { showError(error); setStatus('No se pudo cargar el editor.'); }
      finally { busy = false; render(); }
    }

    root.querySelector('[data-hero-add]')?.addEventListener('click', () => addMedia(model.heroMedia, 'hero'));
    root.querySelector('[data-gallery-add]')?.addEventListener('click', () => {
      model.galleries.push({
        key: newKey('gallery'), visible: false, navigationLabel: 'Galería', heading: '', summary: '', coverUseKey: '', items: [],
      });
      markDirty(); render();
    });
    root.querySelector('[data-gallery-refresh]')?.addEventListener('click', () => loadAll());
    uploadKind?.addEventListener('change', updateUploadControls);

    uploadForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!canManageMedia || busy || !uploadForm.reportValidity() || !fileInput?.files?.[0]) return;
      clearError(); busy = true;
      const kind = uploadKind?.value || 'gallery_image';
      const purpose = kind.startsWith('hero_') ? 'hero' : (kind === 'video_poster' ? 'video_poster' : 'gallery');
      const payload = new FormData();
      payload.append('file', fileInput.files[0]); payload.append('purpose', purpose);
      payload.append('poster_asset_id', kind.endsWith('_video') ? text(posterSelect?.value) : '');
      setStatus('Procesando y subiendo el medio…');
      try {
        await requestJson(endpoint(PROMO_GALLERY_MEDIA_API_PATH), { method: 'POST', body: payload });
        uploadForm.reset(); await loadCatalog(); setStatus('Medio listo en la biblioteca.');
      } catch (error) { showError(error); setStatus('No se pudo subir el medio.'); }
      finally { busy = false; updateUploadControls(); render(); }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!draft || !catalog || !canSave || busy || !form.reportValidity()) return;
      clearError(); busy = true; render(); setStatus('Validando y actualizando la página pública…');
      try {
        const documentValue = buildPromoGalleryDocument(draft.document, model, maxGallery, catalog.assets);
        const result = await requestJson(endpoint(PROMO_GALLERY_DRAFT_API_PATH), {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ expected_version: draft.version, document: documentValue }),
        });
        draft = normalizePromoGalleryDraft({ ok: result.ok, contract: result.contract, draft: result.draft });
        const workspace = createPromoGalleryWorkspace(draft.document);
        draft = { version: draft.version, document: workspace.document };
        model = modelFromDocument(workspace.document, workspace.locale);
        dirty = false;
        setStatus(`Página pública actualizada · versión ${draft.version}.`);
      } catch (error) { showError(error); setStatus('No se guardaron los cambios.'); }
      finally { busy = false; render(); }
    });

    loadAll();
  }
</script>
