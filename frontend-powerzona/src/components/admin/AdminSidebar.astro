---
import AdminDialog from './AdminDialog.astro';
import AdminRefreshFeedback from './AdminRefreshFeedback.astro';
import StorePlanIndicator from '../shared/StorePlanIndicator.astro';
import { getPublicStorePath, getStoreAdminPath } from '../../lib/adminRoutes';
import { getStoreSecuritySettingsForToken, isStoreSecurityEnabled } from '../../lib/security';
import { resolveStorePlanPresentation, type StorePlanValues } from '../../lib/storePlanPresentation';
import { getStoreAccessContext, type StoreAccessContext } from '../../lib/storeTeam';
import { hasStorePermission, type StorePermission } from '../../lib/storeTeamPermissions';
import { resolveStoreCapabilityAccess } from '../../lib/storeCapabilities';
import { getStoreInitials } from '../../lib/storeIdentity';
import { isMasterAdmin, loadAuthClientFromCookie } from '../../lib/auth';
import { getAdminSupportContact } from '../../lib/adminSupport';

const tuSenda84SupportIconUrl = '/brand/tu-senda-84-admin-icon-512.png';

interface Props {
  storeSlug?: string;
  storeName?: string;
  activeSection?: string;
  activeSubsection?: string;
  storePlanValues?: StorePlanValues;
  mobileTitle?: string;
  mobileActionLabel?: string;
  mobileActionHref?: string;
  mobileActionTarget?: string;
  mobileActionEvent?: string;
  mobileActionAriaLabel?: string;
  mobileBackHref?: string;
  mobileBackLabel?: string;
  mobileBackVariant?: 'card' | 'plain-end';
  storeId?: string;
  pocketbaseUrl?: string;
  authToken?: string;
  storeAccessContext?: StoreAccessContext | null;
}

const {
  storeSlug = 'powerzona',
  storeName = 'PowerZona',
  activeSection = '',
  activeSubsection = '',
  storePlanValues,
  mobileTitle = '',
  mobileActionLabel = '',
  mobileActionHref = '',
  mobileActionTarget = '',
  mobileActionEvent = '',
  mobileActionAriaLabel = '',
  mobileBackHref = '',
  mobileBackLabel = '',
  mobileBackVariant = 'card',
  storeId = '',
  pocketbaseUrl = '',
  authToken = '',
  storeAccessContext,
} = Astro.props;

const planPresentation = resolveStorePlanPresentation(storePlanValues);
const resolvedStoreName = String(storeName || 'Tienda').trim() || 'Tienda';
const storeInitials = getStoreInitials(resolvedStoreName);
const sidebarAuth = loadAuthClientFromCookie(Astro.request.headers.get('cookie') || '');
const isMasterSupportMode = Boolean(storeId && isMasterAdmin(sidebarAuth.authStore.record as any));
const masterSupportReturnPath = storeId
  ? `/master/stores/${encodeURIComponent(storeId)}`
  : '/master/stores';

const adminBasePath = getStoreAdminPath(storeSlug);
const adminPageviewsPath = getStoreAdminPath(storeSlug, 'pageviews');
const adminCatalogPath = getStoreAdminPath(storeSlug, 'catalog');
const adminProductsPath = getStoreAdminPath(storeSlug, 'products');
const adminOrdersPath = getStoreAdminPath(storeSlug, 'orders');
const adminStoreSettingsPath = getStoreAdminPath(storeSlug, 'store-settings');
const adminGiftsPath = getStoreAdminPath(storeSlug, 'gifts');
const adminShippingPath = getStoreAdminPath(storeSlug, 'shipping');
const adminPromosPath = getStoreAdminPath(storeSlug, 'promos');
const adminOrganizationPath = getStoreAdminPath(storeSlug, 'organization');
const adminRafflesPath = getStoreAdminPath(storeSlug, 'promos/raffles');
const adminPushCampaignsPath = getStoreAdminPath(storeSlug, 'push-campaigns');
const adminNotificationsPath = getStoreAdminPath(storeSlug, 'notifications');
const adminSecurityPath = getStoreAdminPath(storeSlug, 'security');
const adminAccountPath = getStoreAdminPath(storeSlug, 'account');
const adminMobileAppPath = getStoreAdminPath(storeSlug, 'mobile-app');
const adminTeamPath = getStoreAdminPath(storeSlug, 'team');
const publicStorePath = getPublicStorePath(storeSlug);
const notificationsAdminOrdersPath = adminOrdersPath;
const notificationsAdminProductsPath = adminProductsPath;
const currentAdminPath = Astro.url.pathname.replace(/\/+$/, '');
const adminAppPolicy = Astro.locals.adminAppPolicy;
const showAdminAppUpdate = !isMasterSupportMode && adminAppPolicy?.update_available === true;
const isMarketingRafflesPath = /\/admin\/promos\/raffles$/.test(currentAdminPath);

const defaultMobileTitleBySection: Record<string, string> = {
  overview: 'Resumen',
  orders: 'Pedidos',
  catalog: 'Categorías',
  products: 'Productos',
  gifts: 'Regalos',
  shipping: 'Envíos',
  security: 'Seguridad',
  settings: 'Ajustes',
  marketing: 'Promociones',
  team: 'Mi equipo',
  account: 'Mi cuenta',
};

const resolvedMobileTitle =
  mobileTitle ||
  defaultMobileTitleBySection[activeSection || ''] ||
  storeName ||
  'Admin';

const hasMobileAction = Boolean(
  mobileActionLabel &&
  (mobileActionHref || mobileActionTarget || mobileActionEvent)
);

const mobileTopbarClass = `pz-admin-mobile-topbar${hasMobileAction ? ' has-action' : ' no-action'}`;
const resolvedMobileActionAriaLabel = mobileActionAriaLabel || mobileActionLabel || 'Acción principal';
const hasMobileBack = Boolean(mobileBackHref && mobileBackLabel);
const mobileBackClass = `pz-admin-mobile-back-link${mobileBackVariant === 'plain-end' ? ' is-plain-end' : ''}`;

type MobileBottomTarget =
  | 'overview'
  | 'orders'
  | 'shipping'
  | 'settings'
  | 'catalog'
  | 'products'
  | 'gifts'
  | 'marketing'
  | 'security'
  | 'notifications'
  | 'team'
  | 'account'
  | 'activity'
  | 'public';

const mobileBottomTargetIsActive = (target: MobileBottomTarget) =>
    (target === 'overview' && activeSection === 'overview') ||
    (target === 'orders' && activeSection === 'orders') ||
    (target === 'shipping' && activeSection === 'shipping') ||
    (target === 'settings' && activeSection === 'settings') ||
    (target === 'catalog' && activeSection === 'catalog') ||
    (target === 'products' && activeSection === 'products') ||
    (target === 'gifts' && activeSection === 'gifts') ||
    (target === 'marketing' && ['marketing', 'organization'].includes(activeSection || '')) ||
    (target === 'security' && activeSection === 'security') ||
    (target === 'notifications' && activeSection === 'notifications') ||
    (target === 'team' && activeSection === 'team') ||
    (target === 'account' && activeSection === 'account');

const mobileBottomClass = (target: MobileBottomTarget) => {
  const directMatch = mobileBottomTargetIsActive(target);
  const hasSelectedSpecificMatch = mobileBottomItems.some((item) => (
    item.target !== 'settings' && mobileBottomTargetIsActive(item.target)
  ));

  const fallbackSettingsActive =
    target === 'settings' &&
    !hasSelectedSpecificMatch &&
    !['overview', 'orders', 'shipping', 'settings', 'security', 'team', 'account'].includes(activeSection || '');

  return `pz-admin-mobile-bottom-nav__link${directMatch || fallbackSettingsActive ? ' is-active' : ''}`;
};

const normalizedSubsection = activeSubsection === 'schedule' ? 'horario' : activeSubsection;
const isSettingsActive = activeSection === 'settings';
const isAudienceSettingsActive = isSettingsActive && ['rating', 'landing'].includes(normalizedSubsection);
const isStoreSettingsActive = isSettingsActive && !isAudienceSettingsActive;
const isMarketingVisualActive = activeSection === 'marketing' || activeSection === 'organization';
const isPushCampaignsActive = activeSection === 'push-campaigns';
const isAudienceSectionActive = isPushCampaignsActive || isAudienceSettingsActive;
const isPrincipalSectionActive = ['overview', 'orders'].includes(activeSection || '');
const isStoreSectionActive = ['catalog', 'products', 'gifts', 'shipping', 'security'].includes(activeSection || '') || isStoreSettingsActive;
const isPersonalDataActive = ['team', 'account'].includes(activeSection || '');
const supportContactResult = isMasterSupportMode
  ? null
  : await getAdminSupportContact({ baseUrl: pocketbaseUrl, token: authToken });
const masterSupportHref = supportContactResult?.contact.configured
  ? supportContactResult.contact.href
  : '';

const requestStoreAccessContext = Astro.locals.storeAccessContext;
let resolvedStoreAccess: StoreAccessContext | null = storeAccessContext
  ?? requestStoreAccessContext
  ?? null;
if (storeAccessContext === undefined && requestStoreAccessContext === undefined && pocketbaseUrl && authToken) {
  try {
    resolvedStoreAccess = await getStoreAccessContext({
      baseUrl: pocketbaseUrl,
      token: authToken,
      supportStoreId: isMasterSupportMode ? storeId : undefined,
    });
  } catch (_) {
    resolvedStoreAccess = null;
  }
}

const isPrimaryAdmin = resolvedStoreAccess?.access.is_primary_admin === true;
const permissionContext = resolvedStoreAccess
  ? {
      permissions: resolvedStoreAccess.access.permissions,
      is_primary_admin: resolvedStoreAccess.access.is_primary_admin,
      blocked_by_plan: resolvedStoreAccess.access.blocked_by_plan,
    }
  : { permissions: [], blocked_by_plan: true };
const canShowModule = (permission: StorePermission) =>
  hasStorePermission(permissionContext, permission);
const canShowOrdersNav = canShowModule('orders.view');
const canShowCatalogNav = canShowModule('catalog.view');
const canShowOverviewNav = canShowModule('analytics.view');
const canShowOperationalOverview = canShowOverviewNav && canShowOrdersNav && canShowCatalogNav;
const adminOverviewPath = canShowOperationalOverview ? adminBasePath : adminPageviewsPath;
const adminOverviewLabel = canShowOperationalOverview ? 'Resumen' : 'Analíticas';
const canShowGiftsNav = canShowModule('gifts.manage');
const canShowShippingNav = canShowModule('shipping.manage');
const canShowStoreSettingsNav = canShowModule('store.settings.manage');
const canShowReviewsNav = canShowModule('reviews.manage');
const landingQrAccess = resolveStoreCapabilityAccess(
  storePlanValues,
  'landing_qr_enabled',
  { enforceExpiration: true },
);
const canShowLandingQrNav = canShowModule('landing_qr.manage')
  || (isPrimaryAdmin && !landingQrAccess.allowed);
const canShowSettingsGroup = canShowStoreSettingsNav;
const canShowPromotionsNav = canShowModule('promotions.manage');
const canShowCouponsNav = canShowModule('coupons.manage');
const rafflesAccess = resolveStoreCapabilityAccess(
  storePlanValues,
  'raffles_enabled',
  { enforceExpiration: true },
);
const canManageRaffles = canShowModule('raffles.manage');
const canShowRafflesNav = canManageRaffles
  || (isPrimaryAdmin && !rafflesAccess.allowed);
const pushCampaignsAccess = resolveStoreCapabilityAccess(
  storePlanValues,
  'push_campaigns_enabled',
  { enforceExpiration: true },
);
const canManagePushCampaigns = canShowModule('marketing.push.manage');
const canShowPushCampaignsNav = canManagePushCampaigns
  || isMasterSupportMode
  || (isPrimaryAdmin && !pushCampaignsAccess.allowed);
const canShowAudienceGroup = canShowReviewsNav || canShowLandingQrNav || canShowPushCampaignsNav;
const canGenerateRaffleNotifications = isPrimaryAdmin
  && rafflesAccess.allowed
  && canManageRaffles;
const canShowProductVisibilityNav = canShowModule('catalog.products.visibility');
const canShowMarketingGroup = canShowPromotionsNav || canShowCouponsNav || canShowRafflesNav || canShowProductVisibilityNav;
const adminMarketingLandingPath = canShowPromotionsNav || canShowCouponsNav || canShowProductVisibilityNav
  ? adminPromosPath
  : canShowRafflesNav
    ? adminRafflesPath
    : adminPromosPath;
const canShowNotificationsNav = canShowModule('notifications.view');

const securityAccess = resolveStoreCapabilityAccess(
  storePlanValues,
  'security_enabled',
  { enforceExpiration: true },
);
const canViewSecurity = canShowModule('security.view');
let canShowSecurityNav = isPrimaryAdmin && !securityAccess.allowed;
if (securityAccess.allowed && canViewSecurity) {
  try {
    const securitySettings = await getStoreSecuritySettingsForToken(storeId, pocketbaseUrl, authToken, {
      fields: 'id,store,enabled,mode',
    });
    canShowSecurityNav = securitySettings.exists && isStoreSecurityEnabled(securitySettings);
  } catch (_) {
    canShowSecurityNav = false;
  }
}
const canShowPrincipalGroup = canShowOverviewNav || canShowOrdersNav;
const canShowStoreGroup = canShowCatalogNav || canShowGiftsNav || canShowShippingNav || canShowSecurityNav || canShowSettingsGroup;
const fastAdminNavigationPaths = new Set([
  adminOverviewPath,
  adminPageviewsPath,
  adminCatalogPath,
  adminProductsPath,
  adminOrdersPath,
  adminStoreSettingsPath,
  adminGiftsPath,
  adminShippingPath,
  adminPromosPath,
  adminOrganizationPath,
  adminRafflesPath,
  adminPushCampaignsPath,
  adminNotificationsPath,
  adminSecurityPath,
  adminAccountPath,
  adminTeamPath,
]);
const fastPrefetchStrategy = (href: string, mobile = false) =>
  fastAdminNavigationPaths.has(String(href || '').split('#', 1)[0])
    ? (mobile ? 'tap' : 'hover')
    : undefined;

type MobileBottomItem = {
  target: MobileBottomTarget;
  href: string;
  label: string;
  iconPath: string;
  external?: boolean;
};

const mobileBottomCandidates: Array<MobileBottomItem | false> = [
  canShowOverviewNav && {
    target: 'overview', href: adminOverviewPath, label: adminOverviewLabel,
    iconPath: 'M4 19V9h4v10H4Zm6 0V5h4v14h-4Zm6 0v-7h4v7h-4Z',
  },
  canShowOrdersNav && {
    target: 'orders', href: adminOrdersPath, label: 'Pedidos',
    iconPath: 'M6 3h12a1 1 0 0 1 1 1v17l-3-2-2 2-2-2-2 2-2-2-3 2V4a1 1 0 0 1 1-1Zm3 5h6V6H9v2Zm0 4h6v-2H9v2Zm0 4h4v-2H9v2Z',
  },
  canShowShippingNav && {
    target: 'shipping', href: adminShippingPath, label: 'Envíos',
    iconPath: 'M3 7a2 2 0 0 1 2-2h10v9h2.2l1.5-3H21v5h-2a3 3 0 0 1-6 0H9a3 3 0 0 1-6 0H2V9a2 2 0 0 1 1-1.73V7Zm2 0v7.17A3 3 0 0 1 8.83 16H13V7H5Zm12 6h2v1h-2v-1ZM6 17a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm10 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z',
  },
  canShowSettingsGroup && {
    target: 'settings', href: adminStoreSettingsPath, label: 'Ajustes',
    iconPath: 'M19.4 13.5c.1-.5.1-1 .1-1.5s0-1-.1-1.5l2-1.5-2-3.5-2.4 1a7.5 7.5 0 0 0-2.6-1.5L14 2h-4l-.4 2.5A7.5 7.5 0 0 0 7 6L4.6 5l-2 3.5 2 1.5c-.1.5-.1 1-.1 1.5s0 1 .1 1.5l-2 1.5 2 3.5 2.4-1a7.5 7.5 0 0 0 2.6 1.5L10 22h4l.4-2.5A7.5 7.5 0 0 0 17 18l2.4 1 2-3.5-2-1.5ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z',
  },
  canShowCatalogNav && {
    target: 'catalog', href: adminCatalogPath, label: 'Categorías',
    iconPath: 'M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v1H3V6Zm0 5h18v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7Z',
  },
  canShowCatalogNav && {
    target: 'products', href: adminProductsPath, label: 'Productos',
    iconPath: 'M21 7.5 12 3 3 7.5l9 4.5 9-4.5ZM5 10.7V17l6 3v-6.3l-6-3Zm8 9.3 6-3v-6.3l-6 3V20Z',
  },
  canShowGiftsNav && {
    target: 'gifts', href: adminGiftsPath, label: 'Regalos',
    iconPath: 'M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7H3V8h18v4h-1ZM5 10h14V9H5v1Zm1 2v7h12v-7H6Z',
  },
  canShowMarketingGroup && {
    target: 'marketing', href: adminMarketingLandingPath, label: 'Promos',
    iconPath: 'M5 4h14v4H5V4Zm0 6h9v4H5v-4Zm0 6h14v4H5v-4Z',
  },
  canShowSecurityNav && {
    target: 'security', href: adminSecurityPath, label: 'Seguridad',
    iconPath: 'M12 2 5 5v6c0 4.4 2.9 8.5 7 9.9 4.1-1.4 7-5.5 7-9.9V5l-7-3Zm0 2.2 5 2.2V11c0 3.3-2 6.5-5 7.7-3-1.2-5-4.4-5-7.7V6.4l5-2.2Z',
  },
  canShowNotificationsNav && {
    target: 'notifications', href: adminNotificationsPath, label: 'Avisos',
    iconPath: 'M12 22a2.8 2.8 0 0 0 2.7-2h-5.4A2.8 2.8 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5-6.7V3a2 2 0 1 0-4 0v1.3A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z',
  },
  isPrimaryAdmin && {
    target: 'team', href: adminTeamPath, label: 'Equipo',
    iconPath: 'M8 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm8.5 1a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7ZM1 21v-2a6 6 0 0 1 12 0v2H1Z',
  },
  !isMasterSupportMode && {
    target: 'account', href: adminAccountPath, label: 'Cuenta',
    iconPath: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9a8 8 0 0 1 16 0H4Z',
  },
  !isMasterSupportMode && {
    target: 'activity', href: `${adminAccountPath}#my-activity`, label: 'Actividad',
    iconPath: 'M4 4h16v2H4V4Zm0 7h10v2H4v-2Zm0 7h16v2H4v-2Zm13-8 4 3-4 3v-6Z',
  },
  {
    target: 'public', href: publicStorePath, label: 'Tienda', external: true,
    iconPath: 'M12 5c5 0 9 5.2 9 7s-4 7-9 7-9-5.2-9-7 4-7 9-7Zm0 3.5A3.5 3.5 0 1 0 12 15.5 3.5 3.5 0 0 0 12 8.5Z',
  },
];
const mobileBottomItems = mobileBottomCandidates
  .filter((item): item is MobileBottomItem => item !== false)
  .slice(0, 4);

const navClass = (section: string) => `pz-admin-sidebar__nav-item${activeSection === section ? ' is-active' : ''}`;
const settingsToggleClass = `pz-admin-sidebar__nav-item pz-admin-sidebar__settings-toggle${isStoreSettingsActive ? ' is-active' : ''}`;
const settingsSubnavClass = `pz-admin-sidebar__settings-subnav${isStoreSettingsActive ? '' : ' is-collapsed'}`;
const sectionToggleClass = (isActive: boolean) => `pz-admin-sidebar__section-toggle${isActive ? ' is-active' : ''}`;
const sectionPanelClass = (isOpen: boolean) => `pz-admin-sidebar__section-panel${isOpen ? '' : ' is-collapsed'}`;
const subClass = (subsection: string) => {
  const isGeneral = subsection === 'generales' && ['general', 'generales', ''].includes(normalizedSubsection);
  return `pz-admin-sidebar__settings-subitem${isStoreSettingsActive && (normalizedSubsection === subsection || isGeneral) ? ' is-active' : ''}`;
};
const marketingVisualSubClass = (subsection: string) => {
  const isActive =
    isMarketingVisualActive &&
    (
      (subsection === 'rifas' && isMarketingRafflesPath) ||
      (subsection === 'destacados' && !isMarketingRafflesPath)
    );
  return `pz-admin-sidebar__settings-subitem${isActive ? ' is-active' : ''}`;
};
const audienceSubClass = (subsection: string) => {
  const isActive = subsection === 'push-campaigns'
    ? isPushCampaignsActive
    : isSettingsActive && normalizedSubsection === subsection;
  return `pz-admin-sidebar__settings-subitem${isActive ? ' is-active' : ''}`;
};
---

{showAdminAppUpdate && (
  <aside class="pz-admin-app-update-banner" role="status" aria-label="Actualización de Mobile Admin disponible">
    <span>
      <strong>Nueva versión {adminAppPolicy?.latest_version_name}</strong>
      <small>Actualiza Mobile Admin para recibir las mejoras más recientes.</small>
    </span>
    <a href={adminMobileAppPath}>Actualizar aplicación</a>
  </aside>
)}

{isMasterSupportMode && (
  <section class="pz-master-support-bar" role="status" aria-label={`Modo soporte Master para ${resolvedStoreName}`}>
    <span class="pz-master-support-bar__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 2 4.5 5.2v5.9c0 4.7 3.1 9 7.5 10.4 4.4-1.4 7.5-5.7 7.5-10.4V5.2L12 2Zm0 3 4.7 2v4.1c0 3.2-1.9 6.2-4.7 7.4-2.8-1.2-4.7-4.2-4.7-7.4V7L12 5Zm-1 3v4.2l3.1 1.8 1-1.7-2.1-1.2V8h-2Z"/></svg>
    </span>
    <span class="pz-master-support-bar__copy">
      <strong>Modo soporte Master</strong>
      <span>{resolvedStoreName}</span>
    </span>
    <span class="pz-master-support-bar__audit">Tus cambios quedan registrados como Master Admin.</span>
    <a class="pz-master-support-bar__exit" href={masterSupportReturnPath}>
      <span aria-hidden="true">←</span> Volver al panel Master
    </a>
  </section>
)}

<aside
  id="pz-admin-sidebar"
  class="pz-admin-sidebar"
  data-admin-sidebar-root
  aria-label="Panel lateral de administración"
  aria-hidden="true"
>
  <div class="pz-admin-sidebar__inner">
    <div class="pz-admin-sidebar__brand">
      <div class="pz-admin-sidebar__brand-row">
        <span class="pz-admin-sidebar__brand-logo" aria-hidden="true">{storeInitials}</span>
        <div class="pz-admin-sidebar__brand-copy">
          <p class="pz-admin-sidebar__brand-title" title={resolvedStoreName}>{resolvedStoreName}</p>
          <p class="pz-admin-sidebar__brand-subtitle">Admin Panel</p>
        </div>
        <button class="pz-admin-sidebar__close" type="button" aria-label="Cerrar menú" data-sidebar-close>&times;</button>
      </div>
      <StorePlanIndicator presentation={planPresentation} variant="store-sidebar" />
    </div>

    {canShowPrincipalGroup && <section class:list={['pz-admin-sidebar__section-group', { 'is-current': isPrincipalSectionActive }]} data-sidebar-section-group="principal">
      <button class={sectionToggleClass(isPrincipalSectionActive)} type="button" title="Principal" aria-expanded={isPrincipalSectionActive ? 'true' : 'false'} aria-controls="pz-admin-sidebar-principal" data-sidebar-section-toggle>
        <span class="pz-admin-sidebar__section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V9h4v10H4Zm6 0V5h4v14h-4Zm6 0v-7h4v7h-4Z"/></svg></span>
        <span>Principal</span>
        <span class="pz-admin-sidebar__section-chevron" aria-hidden="true">v</span>
      </button>
      <div id="pz-admin-sidebar-principal" class={sectionPanelClass(isPrincipalSectionActive)} data-sidebar-section-panel>
        <nav class="pz-admin-sidebar__nav-list">
      {canShowOverviewNav && <a class={navClass('overview')} href={adminOverviewPath} data-astro-prefetch={fastPrefetchStrategy(adminOverviewPath)} title={adminOverviewLabel}><span class="pz-admin-sidebar__nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V9h4v10H4Zm6 0V5h4v14h-4Zm6 0v-7h4v7h-4Z"/></svg></span><span>{adminOverviewLabel}</span></a>}
      {canShowOrdersNav && <a class={navClass('orders')} href={adminOrdersPath} data-astro-prefetch={fastPrefetchStrategy(adminOrdersPath)} title="Pedidos"><span class="pz-admin-sidebar__nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-3-2-2 2-2-2-2 2-2-2-3 2V4a1 1 0 0 1 1-1Zm3 5h6V6H9v2Zm0 4h6v-2H9v2Zm0 4h4v-2H9v2Z"/></svg></span><span>Pedidos</span></a>}
        </nav>
      </div>
    </section>}

    {canShowStoreGroup && <section class:list={['pz-admin-sidebar__section-group', { 'is-current': isStoreSectionActive }]} data-sidebar-section-group="store">
      <button class={sectionToggleClass(isStoreSectionActive)} type="button" title="Tienda" aria-expanded={isStoreSectionActive ? 'true' : 'false'} aria-controls="pz-admin-sidebar-store" data-sidebar-section-toggle>
        <span class="pz-admin-sidebar__section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 4h16l1 5H3l1-5Zm0 7h16v9h-6v-6h-4v6H4v-9Z"/></svg></span>
        <span>Tienda</span>
        <span class="pz-admin-sidebar__section-chevron" aria-hidden="true">v</span>
      </button>
      <div id="pz-admin-sidebar-store" class={sectionPanelClass(isStoreSectionActive)} data-sidebar-section-panel>
        <nav class="pz-admin-sidebar__nav-list">
      {canShowCatalogNav && <a class={navClass('catalog')} href={adminCatalogPath} data-astro-prefetch={fastPrefetchStrategy(adminCatalogPath)} title="Categorías"><span class="pz-admin-sidebar__nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v1H3V6Zm0 5h18v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7Z"/></svg></span><span>Categorías</span></a>}
