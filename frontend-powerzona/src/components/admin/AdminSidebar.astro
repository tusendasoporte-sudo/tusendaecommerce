<script define:vars={{ storeId, pocketbaseUrl, notificationsAdminOrdersPath, notificationsAdminProductsPath, adminBasePath, adminNotificationsPath, adminStoreSettingsPath, adminRafflesPath, canShowNotificationsNav, isPrimaryAdmin, canGenerateRaffleNotifications, isMasterSupportMode }}>
  window.PZ_MASTER_SUPPORT_CONTEXT = isMasterSupportMode === true
    ? { storeId: String(storeId || '') }
    : null;
  document.body.classList.toggle('pz-master-support-mode', isMasterSupportMode === true);
  window.PZ_ADMIN_NOTIFICATIONS_CONFIG = {
    storeId: String(storeId || ''),
    pocketbaseUrl: String(pocketbaseUrl || '').replace(/\/$/, ''),
    ordersPath: String(notificationsAdminOrdersPath || ''),
    productsPath: String(notificationsAdminProductsPath || ''),
    rafflesPath: String(adminRafflesPath || ''),
    adminBasePath: String(adminBasePath || ''),
    notificationsPath: String(adminNotificationsPath || ''),
    settingsPath: String(adminStoreSettingsPath || ''),
    enabled: canShowNotificationsNav === true,
    canGenerate: isPrimaryAdmin === true,
    canGenerateRaffles: canGenerateRaffleNotifications === true,
  };
</script>

<script>
  import PocketBase from 'pocketbase';
  import { safeAdminNotificationTarget } from '../../lib/adminNotificationTarget.js';
  import {
    loadNotifications,
    loadVisibleNotificationCount,
    loadUnreadNotificationPrioritySummary,
    markNotificationRead,
    archiveNotification,
    archiveAllNotifications,
    markAllNotificationsRead,
    normalizeNotification,
    ensureStoreNotificationAnyStatus,
    findStoreNotificationAnyStatus,
    ensureStoreNotificationAfterSourceChange,
    deleteArchivedNotificationsBefore,
    getNotificationVisualPriority,
    isV7E9RedNotification,
  } from '../../lib/adminNotifications.js';

  (() => {
    if (window.__pzAdminNotificationsReady) return;
    window.__pzAdminNotificationsReady = true;

    if (window.PZAndroidPush || String(navigator.userAgent || '').includes('TuSenda84Admin/')) {
      document.documentElement.classList.add('pz-android-app');
    }

    function readCookieValue(name) {
      const prefix = `${name}=`;
      const cookies = String(document.cookie || '').split(';');
      for (const cookie of cookies) {
        const value = cookie.trim();
        if (value.startsWith(prefix)) return value.slice(prefix.length);
      }
      return '';
    }

    function readAuthTokenFromCookie() {
      const raw = readCookieValue('pb_auth');
      if (!raw) return '';
      try {
        const parsed = JSON.parse(decodeURIComponent(raw));
        return typeof parsed?.token === 'string' ? parsed.token : '';
      } catch (error) {
        return '';
      }
    }

    const config = window.PZ_ADMIN_NOTIFICATIONS_CONFIG || {};
    if (config.enabled === false) return;
    const storeId = String(config.storeId || '');
    const baseUrl = String(config.pocketbaseUrl || '').replace(/\/$/, '');
    const token = readAuthTokenFromCookie();
    const adminDeviceToken = readCookieValue('pz_admin_device');
    const ordersPath = String(config.ordersPath || '');
    const productsPath = String(config.productsPath || '');
    const rafflesPath = String(config.rafflesPath || '');
    const tenantAdminBasePath = String(config.adminBasePath || '');
    const notificationsPath = String(config.notificationsPath || '');
    const settingsPath = String(config.settingsPath || '');
    const canGenerateNotifications = config.canGenerate === true;
    const canGenerateRaffleNotifications = config.canGenerateRaffles === true;
    const pb = { baseUrl, token };
    const panel = document.querySelector('[data-pz-admin-notifications-panel]');
    const list = document.querySelector('[data-pz-admin-notifications-list]');
    const markAllButton = document.querySelector('[data-pz-admin-mark-all]');
    const viewAllLink = document.querySelector('[data-pz-admin-notifications-view-all]');
    const archiveAllButton = document.querySelector('[data-pz-admin-archive-all]');
    const panelSummary = document.querySelector('[data-pz-admin-notifications-summary]');
    const browserNotificationsButton = document.querySelector('[data-pz-admin-browser-notifications]');
    const nativePushOnboarding = document.querySelector('[data-pz-native-push-onboarding]');
    const nativePushOnboardingButton = document.querySelector('[data-pz-native-push-onboarding-action]');
    const nativePushOnboardingStatus = document.querySelector('[data-pz-native-push-onboarding-status]');
    const originalDocumentTitle = String(document.title || '').replace(/^\((?:99\+|\d+)\)\s+/, '');
    const browserNotificationsStorageKey = 'pz_admin_browser_notifications_enabled';
    const liveNotificationIdMemoryLimit = 300;
    const processedLiveNotificationIds = new Set();
    const knownNotificationIds = new Set();
    let isOpen = false;
    let isLoading = false;
    let hasLoadedInitialNotifications = false;
    let realtimePb = null;
    let realtimeUnsubscribe = null;
    let realtimeRefreshTimer = null;
    let nativeRegistrationSyncTimer = null;
    let nativePushState = null;
    let audioContext = null;

    if (!panel || !list || !storeId || !baseUrl) return;

    function escapeHtml(value) {
      return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    function escapeFilterValue(value) {
      return String(value || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
    }

    async function api(path, options = {}) {
      const headers = Object.assign({}, options.headers || {});
      if (token) headers.Authorization = `Bearer ${token}`;
      if (/^[A-Za-z0-9_-]{43}$/.test(adminDeviceToken)) {
        headers['X-PZ-Admin-Device'] = adminDeviceToken;
      }
      const response = await fetch(`${baseUrl}${path}`, Object.assign({}, options, { headers }));
      const result = await response.json().catch(() => null);
      if (!response.ok) throw new Error(result?.message || 'PocketBase request failed.');
      return result;
    }

    function setButtonsExpanded(value) {
      document.querySelectorAll('[data-pz-admin-notification-trigger]').forEach((button) => {
        button.setAttribute('aria-expanded', value ? 'true' : 'false');
      });
    }

    function setDocumentUnreadTitle(count) {
      const value = Math.max(0, Number(count || 0));
      if (value <= 0) {
        document.title = originalDocumentTitle;
        return;
      }
      document.title = `(${value > 99 ? '99+' : value}) ${originalDocumentTitle}`;
    }

    function getNativePushBridge() {
      try {
        const bridge = window.PZAndroidPush;
        return bridge && typeof bridge.isAvailable === 'function' && bridge.isAvailable()
          ? bridge
          : null;
      } catch (error) {
        return null;
      }
    }

    function browserNotificationsSupported() {
      return !!getNativePushBridge() || 'Notification' in window;
    }

    function getBrowserNotificationsEnabled() {
      try {
        return window.localStorage?.getItem(browserNotificationsStorageKey) === 'true';
      } catch (error) {
        return false;
      }
    }

    function setBrowserNotificationsEnabled(value) {
      try {
        window.localStorage?.setItem(browserNotificationsStorageKey, value ? 'true' : 'false');
      } catch (error) {
      }
    }

    function renderNativePushOnboarding() {
      if (!nativePushOnboarding) return;
      const nativeBridge = getNativePushBridge();
      if (!nativeBridge) {
        nativePushOnboarding.hidden = true;
        nativePushOnboarding.setAttribute('aria-hidden', 'true');
        return;
      }

      const permission = String(nativePushState?.permission || nativeBridge.permissionState?.() || 'prompt');
      const notificationsEnabled = getBrowserNotificationsEnabled();
      const isActive = permission === 'granted' && notificationsEnabled;
      nativePushOnboarding.hidden = isActive;
      nativePushOnboarding.setAttribute('aria-hidden', isActive ? 'true' : 'false');
      if (isActive || !nativePushOnboardingButton || !nativePushOnboardingStatus) return;

      nativePushOnboardingButton.disabled = false;
      if (permission === 'denied') {
        nativePushOnboardingButton.textContent = 'Abrir ajustes de notificaciones';
        nativePushOnboardingStatus.textContent = 'Android tiene los avisos desactivados. Abre los ajustes para permitirlos y no perder alertas importantes.';
        return;
      }

      nativePushOnboardingButton.textContent = 'Activar notificaciones';
      nativePushOnboardingStatus.textContent = permission === 'granted'
        ? 'Los avisos est\u00e1n pausados. Act\u00edvalos para volver a recibir pedidos, inventario y alertas de seguridad.'
        : 'Recibe avisos de pedidos, inventario y accesos sospechosos aunque la app est\u00e9 cerrada.';
    }

    function ensureAudioContext() {
      if (!audioContext) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return null;
        audioContext = new AudioContextClass();
      }
      if (audioContext.state === 'suspended') audioContext.resume().catch(() => {});
      return audioContext;
    }

    function playSoftNotificationSound() {
      try {
        if (!getBrowserNotificationsEnabled()) return;
        const context = ensureAudioContext();
        if (!context) return;
        const oscillator = context.createOscillator();
        const gain = context.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(660, context.currentTime);
        gain.gain.setValueAtTime(0.0001, context.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.035, context.currentTime + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.0001, context.currentTime + 0.18);
        oscillator.connect(gain);
        gain.connect(context.destination);
        oscillator.start();
        oscillator.stop(context.currentTime + 0.2);
      } catch (error) {
      }
    }

    function renderBrowserNotificationsButton() {
      renderNativePushOnboarding();
      if (!browserNotificationsButton) return;
      const nativeBridge = getNativePushBridge();
      if (nativeBridge) {
        const permission = String(nativePushState?.permission || nativeBridge.permissionState?.() || 'prompt');
        browserNotificationsButton.disabled = false;
        if (permission === 'denied') {
          browserNotificationsButton.textContent = 'Abrir permisos de avisos en Android';
          return;
        }
        browserNotificationsButton.textContent = permission === 'granted' && getBrowserNotificationsEnabled()
          ? 'Pausar avisos de Android'
          : 'Activar avisos de Android';
        return;
      }
      if (!browserNotificationsSupported()) {
        browserNotificationsButton.textContent = 'Avisos no compatibles';
        browserNotificationsButton.disabled = true;
        return;
      }
      const permission = Notification.permission;
      if (permission === 'denied') {
        browserNotificationsButton.textContent = 'Permiso bloqueado en el navegador';
        browserNotificationsButton.disabled = true;
        setBrowserNotificationsEnabled(false);
        return;
      }
      browserNotificationsButton.disabled = false;
      browserNotificationsButton.textContent = permission === 'granted' && getBrowserNotificationsEnabled()
        ? 'Pausar avisos del navegador'
        : 'Activar avisos del navegador';
    }

    function toastMessageForNotification(item) {
      const type = String(item?.type || '');
      if (type === 'security_blocked_attempt') return 'Seguridad bloqueó un intento';
      if (type === 'security_address_match') return 'Dirección vinculada a un cliente bloqueado';
      if (type === 'review_pending') return 'Nueva reseña pendiente';
      if (type === 'new_order') return 'Nuevo pedido recibido';
      if (type === 'pending_order') return 'Pedido pendiente sin atender';
      if (type === 'low_stock' || type === 'out_of_stock') return 'Revisa el inventario';
      if (type.includes('expired') || type.includes('expiring')) return 'Producto con vencimiento';
      return item?.title || 'Nueva notificación';
    }

    function browserNotificationBodyFor(item) {
      const type = String(item?.type || '');
      if (type === 'security_blocked_attempt') return 'Revisa la actividad reciente de Seguridad.';
      if (type === 'security_address_match') return 'Un pedido necesita revisión de Seguridad.';
      if (type === 'review_pending') return 'Una reseña necesita aprobación.';
      if (type === 'new_order') return 'Tienes un pedido nuevo pendiente de revisar.';
      if (type === 'pending_order') return 'Hay un pedido pendiente sin atender.';
      if (type === 'low_stock' || type === 'out_of_stock' || type.includes('expired') || type.includes('expiring')) {
        return 'Hay un aviso de inventario que necesita revisión.';
      }
      return 'Tienes una nueva notificación en el admin.';
    }

    function shouldShowBrowserNotification() {
      return !getNativePushBridge()
        && browserNotificationsSupported()
        && Notification.permission === 'granted'
        && getBrowserNotificationsEnabled()
        && (document.hidden || !document.hasFocus());
    }

    function showInternalRealtimeToast(item) {
      const message = toastMessageForNotification(item);
      if (typeof window.adminToast === 'function') window.adminToast(message, isV7E9RedNotification(item) ? 'error' : 'info');
    }

    function showBrowserRealtimeNotification(item) {
      try {
        if (!shouldShowBrowserNotification()) return;
        const baseTitle = toastMessageForNotification(item) || 'Nueva notificación';
        const title = isV7E9RedNotification(item) ? `Alerta: ${baseTitle}` : baseTitle;
        const notification = new Notification(title, {
          body: browserNotificationBodyFor(item),
          tag: `pz-admin-${item?.id || Date.now()}`,
          silent: true,
        });
        notification.onclick = () => {
          notification.close();
          window.focus();
          const targetUrl = getOrderNotificationUrl(item) || notificationsPath || '';
          if (targetUrl) window.location.assign(targetUrl);
        };
      } catch (error) {
      }
    }

    function rememberNotificationId(collection, id) {
      const safeId = String(id || '');
      if (!safeId) return false;
      if (collection.has(safeId)) return false;
      collection.add(safeId);
      while (collection.size > liveNotificationIdMemoryLimit) {
        const firstId = collection.values().next().value;
        collection.delete(firstId);
      }
      return true;
    }

    function rememberLiveNotificationId(id) {
      return rememberNotificationId(processedLiveNotificationIds, id);
    }

    function rememberKnownNotificationId(id) {
      return rememberNotificationId(knownNotificationIds, id);
    }

    function scheduleRealtimeRefresh() {
      if (realtimeRefreshTimer) window.clearTimeout(realtimeRefreshTimer);
      realtimeRefreshTimer = window.setTimeout(() => {
        realtimeRefreshTimer = null;
        if (isLoading) {
          scheduleRealtimeRefresh();
          return;
        }
        loadAll().catch(() => {});
      }, 500);
    }

    function deliverLiveNotification(item, source = 'realtime') {
      try {
        if (!item?.id) return false;
        if (item.status === 'archived') return false;
        if (!rememberLiveNotificationId(item.id)) return false;

        rememberKnownNotificationId(item.id);
        showInternalRealtimeToast(item);
        showBrowserRealtimeNotification(item);
        playSoftNotificationSound();
        if (source === 'realtime') scheduleRealtimeRefresh();
        return true;
      } catch (error) {
        return false;
      }
    }

    function syncLoadedNotificationIds(items) {
      const safeItems = Array.isArray(items) ? items : [];

      if (!hasLoadedInitialNotifications) {
        safeItems.forEach((item) => {
          if (!item?.id) return;
          rememberKnownNotificationId(item.id);
          rememberLiveNotificationId(item.id);
        });
        hasLoadedInitialNotifications = true;
        return;
      }

      safeItems.forEach((item) => {
        if (!item?.id) return;
        const id = String(item.id || '');
        const wasKnown = knownNotificationIds.has(id);
        if (!wasKnown && item.status !== 'archived') {
          deliverLiveNotification(item, 'polling');
        }
        rememberKnownNotificationId(id);
      });
    }

    function timeAgo(value) {
      const date = value ? new Date(value) : null;
      const diff = date && !Number.isNaN(date.getTime()) ? Date.now() - date.getTime() : 0;
      const minutes = Math.max(0, Math.floor(diff / 60000));
      if (minutes < 1) return 'Ahora';
      if (minutes < 60) return `Hace ${minutes} min`;
      const hours = Math.floor(minutes / 60);
      if (hours < 24) return `Hace ${hours} h`;
      const days = Math.floor(hours / 24);
      return `Hace ${days} d`;
    }

    function iconFor(type) {
      if (type === 'security_blocked_attempt') return '\u26e8';
      if (type === 'security_address_match') return '!';
      if (type === 'review_pending') return '\u2605';
      if (type === 'new_order') return '$';
      if (type === 'pending_order') return '!';
      if (type === 'low_stock') return '📦';
      if (type === 'out_of_stock') return '⛔';
      if (String(type || '').includes('expired')) return '⚠️';
      if (String(type || '').includes('expiring')) return '⏳';
      return 'i';
    }

    function normalizePriority(priority) {
      return ['normal', 'important', 'critical'].includes(priority) ? priority : 'normal';
    }

    function priorityLabel(priority) {
      const value = normalizePriority(priority);
      if (value === 'critical') return 'Alta prioridad';
      if (value === 'important') return 'Importante';
      return 'Normal';
    }

    function formatNotificationUsd(value) {
      const amount = Math.max(0, Number(value || 0));
      return `$${amount.toFixed(2)} USD`;
    }

    function getOrderProductsSubtotalUSD(order) {
      const candidates = [
        order?.subtotal_after_discount_usd,
        order?.subtotal,
        order?.subtotal_original_usd,
      ];

      for (const candidate of candidates) {
        const value = Number(candidate || 0);
        if (value > 0) return value;
      }

      const total = Number(order?.usd_total || order?.total || 0);
      const shipping = Number(order?.shipping || order?.shipping_usd || order?.shipping_original_usd || 0);
      return Math.max(0, total - shipping);
    }

    function getNotificationPrioritySettings(settings = {}) {
      const importantMin = Math.max(0, Number(settings?.notification_priority_important_min_usd ?? 50));
      const criticalRaw = Math.max(0, Number(settings?.notification_priority_critical_min_usd ?? 100));
      const criticalMin = Math.max(importantMin, criticalRaw);

      return {
        enabled: settings?.notification_priority_enabled !== false,
        importantMin,
        criticalMin,
        showOrderSubtotal: settings?.notification_show_order_subtotal !== false,
        bellPriorityColors: settings?.notification_bell_priority_colors !== false,
      };
    }

    function getOrderNotificationPriority(order, settings, fallback = 'important') {
      const config = getNotificationPrioritySettings(settings);
      if (!config.enabled) return normalizePriority(fallback);

      const subtotal = getOrderProductsSubtotalUSD(order);
      if (subtotal >= config.criticalMin) return 'critical';
      if (subtotal >= config.importantMin) return 'important';
      return 'normal';
    }

    function buildOrderProductsText(order, settings) {
      const config = getNotificationPrioritySettings(settings);
      if (!config.showOrderSubtotal) return '';

      const subtotal = getOrderProductsSubtotalUSD(order);
      if (subtotal <= 0) return '';

      return ` - Productos: ${formatNotificationUsd(subtotal)} sin envio`;
    }

    function buildOrderUrl(orderId) {
      if (!orderId) return ordersPath || '';
      return `${ordersPath.replace(/\/$/, '')}/${encodeURIComponent(orderId)}`;
    }

    function getOrderNotificationUrl(item) {
      if (item?.type === 'review_pending' && item?.targetUrl) {
        return safeAdminNotificationTarget(item.targetUrl, tenantAdminBasePath, window.location.origin);
      }
      const entityCollection = String(item?.entityCollection || item?.raw?.entity_collection || '');
      const entityId = String(item?.entityId || item?.raw?.entity_id || '');

      if (entityCollection === 'orders' && entityId) {
        return safeAdminNotificationTarget(buildOrderUrl(entityId), tenantAdminBasePath, window.location.origin);
      }

      return safeAdminNotificationTarget(item?.targetUrl, tenantAdminBasePath, window.location.origin);
    }

    function buildRatingPendingUrl() {
      return settingsPath ? `${settingsPath.replace(/#.*$/, '')}#rating-pending` : '';
    }

    function getInventoryNotificationSettings(settings = {}) {
      const lowStockThreshold = Math.max(1, Number(settings?.low_stock_threshold ?? 3));

      return {
        lowStock: settings?.notify_low_stock !== false,
        outOfStock: settings?.notify_out_of_stock !== false,
        lowStockThreshold,
      };
    }

    function productTracksStockRecord(product = {}) {
      if (Object.prototype.hasOwnProperty.call(product, 'track_stock')) return product.track_stock !== false;
      return true;
    }

    function stockNumber(value) {
      return Math.max(0, Math.floor(Number(value || 0)));
    }

    function buildProductAdminUrl(productId) {
      if (!productId || !productsPath) return productsPath || '';
      return `${productsPath}?product=${encodeURIComponent(productId)}`;
    }

    function buildVariationAdminUrl(productId, variationId) {
      if (!productId || !productsPath) return productsPath || '';
      const url = new URL(productsPath, window.location.origin);
      url.searchParams.set('product', productId);
      if (variationId) url.searchParams.set('variation', variationId);
      return `${url.pathname}${url.search}`;
    }

    function parseDateTime(value) {
      const date = new Date(value || '');
      return Number.isNaN(date.getTime()) ? null : date;
    }

    function raffleHasPublishedResult(raffle = {}) {
      const status = String(raffle.status || '');
      return status === 'winner_published'
        || status === 'no_winner_published'
        || status === 'finalized'
        || Boolean(raffle.winner_number)
        || Boolean(raffle.no_winner_number)
        || Boolean(raffle.result_published_at);
    }

    function raffleDrawNotificationKey(raffle = {}) {
      return String(raffle.draw_at || '').replace(/[^0-9TZ]/g, '').slice(0, 32) || 'sinfecha';
    }

    function buildRaffleAdminUrl() {
      return rafflesPath || notificationsPath || '';
    }

    async function loadAllCollectionRecords(collectionName, query = {}) {
      const params = new URLSearchParams();
      Object.entries(query || {}).forEach(([key, value]) => {
        if (value !== undefined && value !== null && String(value) !== '') {
          params.set(key, String(value));
        }
      });

      params.set('page', '1');
      params.set('perPage', String(query.perPage || 200));

      let page = 1;
      let totalPages = 1;
      const items = [];

      do {
        params.set('page', String(page));
        const result = await api(`/api/collections/${collectionName}/records?${params.toString()}`);
        items.push(...(result.items || []));
        totalPages = Number(result.totalPages || 1);
        page += 1;
      } while (page <= totalPages && page <= 20);

      return items;
    }

    function setUnreadState(summary, settings = {}) {
      const count = Number(summary?.count || 0);
      const config = getNotificationPrioritySettings(settings);
      const hasV7E9Red = summary?.hasV7E9Red === true;
      const highestPriority = count > 0 && (config.bellPriorityColors || hasV7E9Red)
        ? hasV7E9Red ? 'critical' : normalizePriority(summary?.highestPriority || 'normal')
        : 'normal';

      setDocumentUnreadTitle(count);

      const paintedPriority = highestPriority === 'important' || highestPriority === 'critical'
        ? highestPriority
        : '';

      document.querySelectorAll('[data-pz-admin-notification-trigger]').forEach((button) => {
        button.classList.remove('priority-normal', 'priority-important', 'priority-critical');
        button.classList.toggle('has-unread', count > 0);

        if (paintedPriority) {
          button.classList.add(`priority-${paintedPriority}`);
          button.setAttribute('data-pz-notification-priority', paintedPriority);
        } else {
          button.removeAttribute('data-pz-notification-priority');
        }
      });

      document.querySelectorAll('[data-pz-admin-notification-count]').forEach((badge) => {
        badge.classList.remove('priority-normal', 'priority-important', 'priority-critical');
        badge.textContent = count > 99 ? '99+' : String(count);
        badge.classList.toggle('hidden', count <= 0);

        if (paintedPriority) {
          badge.classList.add(`priority-${paintedPriority}`);
          badge.setAttribute('data-pz-notification-priority', paintedPriority);
        } else {
          badge.removeAttribute('data-pz-notification-priority');
        }
      });
    }

    function setPanelSummary({ total = 0, shown = 0 } = {}) {
      const totalValue = Number(total || 0);
      const shownValue = Number(shown || 0);

      if (panelSummary) {
        panelSummary.textContent = totalValue > 12
          ? `Mostrando ${shownValue} de ${totalValue}`
          : 'Avisos importantes de tu tienda';
      }

      if (viewAllLink) {
        viewAllLink.classList.toggle('hidden', totalValue <= 12);
        if (notificationsPath) viewAllLink.setAttribute('href', notificationsPath);
      }
    }

    function render(items) {
      if (!items.length) {
        list.innerHTML = '<p class="pz-admin-notifications-empty">No hay notificaciones nuevas.</p>';
        return;
      }
      list.innerHTML = items.map((item) => {
        const priority = getNotificationVisualPriority(item);
        const unreadClass = item.status === 'unread' ? ' is-unread' : '';
        const priorityClass = ` priority-${priority}`;
        const openUrl = getOrderNotificationUrl(item);
        const openAction = openUrl
          ? `<a href="${escapeHtml(openUrl)}" data-pz-notification-open="${escapeHtml(item.id)}">Abrir</a>`
          : '';
        const readAction = item.status === 'unread'
          ? `<button type="button" data-pz-notification-read="${escapeHtml(item.id)}">Marcar leida</button>`
          : '';
        const archiveAction = `<button type="button" class="pz-admin-notification-delete" data-pz-notification-archive="${escapeHtml(item.id)}" aria-label="Eliminar notificacion">Eliminar</button>`;
        const priorityBadge = `<span class="pz-admin-notification-priority is-${escapeHtml(priority)}">${escapeHtml(priorityLabel(priority))}</span>`;
        return `
          <article class="pz-admin-notification-item${unreadClass}${priorityClass}" data-pz-notification-id="${escapeHtml(item.id)}">
            <span class="pz-admin-notification-icon" aria-hidden="true">${escapeHtml(iconFor(item.type))}</span>
            <div class="pz-admin-notification-content">
              <h3 class="pz-admin-notification-title">${escapeHtml(item.title)}</h3>
              <p class="pz-admin-notification-message">${escapeHtml(item.message)}</p>
              <div class="pz-admin-notification-meta">
                ${priorityBadge}
                <span class="pz-admin-notification-time">${escapeHtml(timeAgo(item.created))}</span>
              </div>
              <div class="pz-admin-notification-actions">${openAction}${readAction}${archiveAction}</div>
            </div>
          </article>
        `;
      }).join('');
    }

    async function loadAll({ detectNewOrders = false, detectPending = false } = {}) {
      if (isLoading) return;
      isLoading = true;
      try {
        const settings = await loadSettings();

        if (canGenerateNotifications && (detectNewOrders || detectPending)) {
          await detectMissingNewOrderNotifications(settings);
        }
        if (canGenerateNotifications && detectPending) {
          await runNotificationCleanup(settings);
          await detectPendingOrders(settings);
          await detectPendingReviewNotifications(settings);
          if (canGenerateRaffleNotifications) await detectDueRaffleResults(settings);
          await detectInventoryNotifications(settings);
        }

        const [items, unreadSummary, visibleCount] = await Promise.all([
          loadNotifications({ pb, storeId, limit: 12 }),
          loadUnreadNotificationPrioritySummary({ pb, storeId }),
          loadVisibleNotificationCount({ pb, storeId }),
        ]);

        syncLoadedNotificationIds(items);
        render(items);
        setUnreadState(unreadSummary, settings);
        setPanelSummary({ total: visibleCount, shown: items.length });
      } catch (error) {
        list.innerHTML = '<p class="pz-admin-notifications-empty">No se pudieron cargar las notificaciones.</p>';
      } finally {
        isLoading = false;
      }
    }

    async function loadSettings() {
      const filter = encodeURIComponent(`active = true && store="${escapeFilterValue(storeId)}"`);
      const result = await api(`/api/collections/settings/records?filter=${filter}&sort=-updated&perPage=1`);
      return (result.items || [])[0] || null;
    }

    function handleRealtimeNotification(event) {
      try {
        if (event?.action !== 'create') return;
        const record = event.record || null;
        if (!record?.id) return;
        if (String(record.store || '') !== storeId) return;
        if (record.status === 'archived') return;

        deliverLiveNotification(normalizeNotification(record), 'realtime');
      } catch (error) {
      }
    }

    async function setupRealtimeNotifications() {
      try {
        realtimePb = new PocketBase(baseUrl);
        if (token) realtimePb.authStore.save(token, null);
        realtimeUnsubscribe = await realtimePb.collection('store_notifications').subscribe(
          '*',
          handleRealtimeNotification,
          { filter: `store="${escapeFilterValue(storeId)}" && status!="archived"` }
        );
      } catch (error) {
        realtimePb = null;
        realtimeUnsubscribe = null;
      }
    }

    function cleanupRealtimeNotifications() {
      if (realtimeRefreshTimer) {
        window.clearTimeout(realtimeRefreshTimer);
        realtimeRefreshTimer = null;
      }
      if (nativeRegistrationSyncTimer) {
        window.clearTimeout(nativeRegistrationSyncTimer);
        nativeRegistrationSyncTimer = null;
      }
      window.removeEventListener('pz:android-push-state', handleNativePushState);
      try {
        if (typeof realtimeUnsubscribe === 'function') realtimeUnsubscribe();
        else realtimePb?.collection('store_notifications')?.unsubscribe('*');
      } catch (error) {
      }
      realtimeUnsubscribe = null;
      realtimePb = null;
    }

    function nativePushPayload(state) {
      return {
        installation_id: String(state?.installation_id || '').trim(),
        app_id: String(state?.app_id || '').trim(),
        device_label: String(state?.device_label || '').trim().slice(0, 120),
        os_version: String(state?.os_version || '').trim().slice(0, 40),
        app_version: String(state?.app_version || '').trim().slice(0, 40),
      };
    }

    function handleNativePushState(event) {
      const detail = event?.detail;
      if (!detail || typeof detail !== 'object' || Array.isArray(detail)) return;
      nativePushState = {
        permission: String(detail.permission || 'prompt'),
        installation_id: String(detail.installation_id || ''),
        app_id: String(detail.app_id || ''),
        device_label: String(detail.device_label || ''),
        os_version: String(detail.os_version || ''),
        app_version: String(detail.app_version || ''),
      };
      renderBrowserNotificationsButton();
    }

    function requestNativePushState(bridge, timeoutMs = 900) {
      return new Promise((resolve) => {
        let completed = false;
        const finish = () => {
          if (completed) return;
          completed = true;
          window.removeEventListener('pz:android-push-state', onState);
          resolve(nativePushState);
        };
        const onState = () => finish();
        window.addEventListener('pz:android-push-state', onState, { once: true });
        window.setTimeout(finish, timeoutMs);
        try { bridge.requestState?.(); } catch (error) { finish(); }
      });
    }

    function scheduleNativePushSync(attempt) {
      if (nativeRegistrationSyncTimer) window.clearTimeout(nativeRegistrationSyncTimer);
      nativeRegistrationSyncTimer = window.setTimeout(() => {
        nativeRegistrationSyncTimer = null;
        syncNativePushRegistration(attempt).catch(() => {});
      }, 1000);
    }

    async function syncNativePushRegistration(attempt = 0) {
      const bridge = getNativePushBridge();
      if (!bridge || !getBrowserNotificationsEnabled()) return false;
      const state = await requestNativePushState(bridge);
      const permission = String(state?.permission || bridge.permissionState?.() || 'prompt');
      renderBrowserNotificationsButton();
      if (permission !== 'granted') {
        if (permission === 'prompt' && attempt < 30) scheduleNativePushSync(attempt + 1);
        return false;
      }
      const installationId = String(state?.installation_id || '').trim();
      if (!installationId) {
        if (attempt < 30) scheduleNativePushSync(attempt + 1);
        return false;
      }
      const payload = nativePushPayload(state);
      if (!payload.app_id) return false;
      await api('/api/pz/store-push/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      renderBrowserNotificationsButton();
      return true;
    }

    async function disableNativePushRegistration(bridge) {
      const state = await requestNativePushState(bridge);
      const installationId = String(state?.installation_id || '').trim();
      const appId = String(state?.app_id || '').trim();
      if (!installationId || !appId) return;
      await api('/api/pz/store-push/disable', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ installation_id: installationId, app_id: appId }),
      });
    }

    function shouldRunNotificationCleanup(settings = {}) {
      if (!settings || settings.notification_cleanup_enabled === false) return false;

      const lastRun = settings.notification_cleanup_last_run_at
        ? new Date(settings.notification_cleanup_last_run_at)
        : null;

      if (!lastRun || Number.isNaN(lastRun.getTime())) return true;

      const elapsed = Date.now() - lastRun.getTime();
      return elapsed >= 23 * 60 * 60 * 1000;
    }

    async function updateNotificationCleanupLastRun(settingsId, dateIso) {
      if (!settingsId) return;

      await api(`/api/collections/settings/records/${encodeURIComponent(settingsId)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          notification_cleanup_last_run_at: dateIso,
        }),
      });
    }

    async function runNotificationCleanup(settings = {}) {
      try {
        if (!settings?.id) return;
        if (!shouldRunNotificationCleanup(settings)) return;

        const days = Math.max(1, Math.min(365, Number(settings.notification_cleanup_days || 15)));
        const cutoffIso = new Date(Date.now() - days * 24 * 60 * 60 * 1000).toISOString();

        await deleteArchivedNotificationsBefore({
          pb,
          storeId,
          cutoffIso,
        });

        await updateNotificationCleanupLastRun(settings.id, new Date().toISOString());
      } catch (error) {
      }
    }

    async function detectPendingOrders(settingsRecord = null) {
      try {
        const settings = settingsRecord || await loadSettings();
        if (!settings || settings.notifications_enabled === false || settings.notify_pending_order === false) return;

        const hours = Math.max(1, Number(settings.pending_order_hours || 2));
        const cutoff = new Date(Date.now() - hours * 60 * 60 * 1000).toISOString();
        const filter = encodeURIComponent(`store="${escapeFilterValue(storeId)}" && status="pending" && created <= "${cutoff}"`);
        const result = await api(`/api/collections/orders/records?filter=${filter}&sort=created&perPage=50`);
        const orders = result.items || [];

        await Promise.all(orders.map(async (order) => {
          const existingNewOrderNotification = await findStoreNotificationAnyStatus({
            pb,
            storeId,
            type: 'new_order',
            entityCollection: 'orders',
            entityId: order.id,
          });

          if (existingNewOrderNotification) return null;

          const orderNumber = order.order_number || order.id;
          const productsSubtotalUSD = getOrderProductsSubtotalUSD(order);
          const priority = getOrderNotificationPriority(order, settings, 'important');
          const productsText = buildOrderProductsText(order, settings);

          return ensureStoreNotificationAnyStatus({
            pb,
            storeId,
            type: 'pending_order',
            entityCollection: 'orders',
            entityId: order.id,
            title: 'Pedido pendiente sin atender',
            message: `Pedido #${orderNumber} lleva mas de ${hours} horas pendiente${productsText}.`,
            priority,
            targetUrl: buildOrderUrl(order.id),
            metadata: {
              order_number: order.order_number || '',
              hours,
              products_subtotal_usd: productsSubtotalUSD,
              shipping_excluded: true,
              priority_rule: priority,
            },
          });
        }));
      } catch (error) {
      }
    }

    async function detectMissingNewOrderNotifications(settingsRecord = null) {
      try {
        const settings = settingsRecord || await loadSettings();

        if (settings?.notifications_enabled === false || settings?.notify_new_order === false) return;

        const since = new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString();
        const filter = encodeURIComponent(`store="${escapeFilterValue(storeId)}" && created >= "${since}"`);
        const result = await api(`/api/collections/orders/records?filter=${filter}&sort=-created&perPage=50`);
        const orders = result.items || [];

        await Promise.all(orders.map((order) => {
          const orderNumber = order.order_number || order.id;
          const customerName = order.customer_name || order.name || 'cliente';
          const productsSubtotalUSD = getOrderProductsSubtotalUSD(order);
          const priority = getOrderNotificationPriority(order, settings, 'important');
          const productsText = buildOrderProductsText(order, settings);

          return ensureStoreNotificationAnyStatus({
            pb,
            storeId,
            type: 'new_order',
            entityCollection: 'orders',
            entityId: order.id,
            title: 'Nuevo pedido recibido',
            message: `Pedido #${orderNumber} por ${customerName}${productsText}`,
            priority,
            targetUrl: buildOrderUrl(order.id),
            metadata: {
              order_number: order.order_number || '',
              customer_name: customerName,
              products_subtotal_usd: productsSubtotalUSD,
              shipping_excluded: true,
              priority_rule: priority,
            },
          });
        }));
      } catch (error) {
      }
    }

    async function detectPendingReviewNotifications(settingsRecord = null) {
      try {
        const settings = settingsRecord || await loadSettings();
        if (!settings || settings.notifications_enabled === false || settings.notify_review_pending === false) return;

        const since = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
        const filter = encodeURIComponent(`store="${escapeFilterValue(storeId)}" && status="pending" && created >= "${since}"`);
        const result = await api(`/api/collections/reviews/records?filter=${filter}&sort=-created&perPage=50&expand=order,product`);
        const reviews = result.items || [];
        const orderReviews = new Map();
        const publicReviews = [];

        reviews.forEach((review) => {
          const orderId = String(review.order || review.expand?.order?.id || '');
          if (review.source === 'order_review_link' && orderId) {
            if (!orderReviews.has(orderId)) orderReviews.set(orderId, []);
            orderReviews.get(orderId).push(review);
            return;
          }
          publicReviews.push(review);
        });

        const targetUrl = buildRatingPendingUrl();
        const tasks = [];

        orderReviews.forEach((items, orderId) => {
          const firstReview = items[0] || {};
          const order = firstReview.expand?.order || {};
          const orderNumber = order.order_number || orderId;
          const customerName = firstReview.customer_name || order.customer_name || 'Cliente';
          tasks.push(ensureStoreNotificationAnyStatus({
            pb,
            storeId,
            type: 'review_pending',
            entityCollection: 'orders',
            entityId: orderId,
            title: 'Nueva reseña pendiente',
            message: `${customerName} dejó ${items.length} reseña${items.length === 1 ? '' : 's'} de la orden #${orderNumber}.`,
            priority: 'important',
            targetUrl,
            metadata: {
              order_id: orderId,
              order_number: order.order_number || '',
              customer_name: customerName,
              review_count: items.length,
              review_ids: items.map((review) => review.id).filter(Boolean),
              source: 'order_review_link',
            },
          }));
        });

        publicReviews.forEach((review) => {
          if (!review?.id) return;
          const isProductReview = review.type === 'product';
          const product = review.expand?.product || {};
          const customerName = review.customer_name || 'Cliente';
          const rating = Number(review.rating || 0);
          const metadata = {
            review_id: review.id,
            customer_name: customerName,
            rating,
            source: review.source || (isProductReview ? 'public_product' : 'public_store'),
          };
          if (isProductReview) {
            metadata.product_id = review.product || '';
            metadata.product_name = product.name || '';
          }
          tasks.push(ensureStoreNotificationAnyStatus({
            pb,
            storeId,
            type: 'review_pending',
            entityCollection: 'reviews',
            entityId: review.id,
            title: 'Nueva reseña pendiente',
            message: `${customerName} dejó una reseña de ${isProductReview ? 'producto' : 'tienda'} con ${rating} estrellas.`,
            priority: 'important',
            targetUrl,
            metadata,
          }));
        });

        await Promise.all(tasks);
      } catch (error) {
      }
    }

    async function countActiveRaffleEntries(raffleId) {
      if (!raffleId) return 0;
      const filter = encodeURIComponent(`store="${escapeFilterValue(storeId)}" && raffle="${escapeFilterValue(raffleId)}" && status="active"`);
      const result = await api(`/api/collections/raffle_entries/records?filter=${filter}&page=1&perPage=1&fields=id`);
      return Number(result.totalItems || (result.items || []).length || 0);
    }

    async function detectDueRaffleResults(settingsRecord = null) {
      try {
        if (!canGenerateRaffleNotifications) return;
        const settings = settingsRecord || await loadSettings();
        if (!settings || settings.notifications_enabled === false) return;

        const raffles = await loadAllCollectionRecords('raffles', {
          filter: `store="${escapeFilterValue(storeId)}" && is_configured=true`,
          sort: 'draw_at',
          perPage: 50,
        });
        const now = Date.now();
        const dueRaffles = raffles.filter((raffle) => {
          if (!raffle?.id || raffle.is_configured !== true) return false;
          const status = String(raffle.status || '');
          if (status === 'archived' || raffleHasPublishedResult(raffle)) return false;
          const drawDate = parseDateTime(raffle.draw_at);
          return Boolean(drawDate && drawDate.getTime() <= now);
        });

        await Promise.all(dueRaffles.map(async (raffle) => {
          const activeEntriesCount = await countActiveRaffleEntries(raffle.id);
          const drawKey = raffleDrawNotificationKey(raffle);
          const raffleName = raffle.title || `Rifa ${raffle.slot_number || ''}`.trim() || 'Rifa';
          const message = activeEntriesCount > 0
            ? `La fecha del sorteo de ${raffleName} ya llegó. Revisa y publica el resultado.`
            : `La fecha del sorteo de ${raffleName} ya llegó. Publica el número sorteado para cerrar la rifa.`;

          return ensureStoreNotificationAnyStatus({
            pb,
            storeId,
            type: 'system_warning',
            entityCollection: 'raffles',
            entityId: `${raffle.id}_${drawKey}`,
            title: 'Resultado de rifa pendiente',
            message,
            priority: 'critical',
            targetUrl: buildRaffleAdminUrl(),
            metadata: {
              subtype: 'raffle_result_due',
              raffle_id: raffle.id,
              raffle_title: raffle.title || '',
              draw_at: raffle.draw_at || '',
              active_entries: activeEntriesCount,
            },
          });
        }));
      } catch (error) {
      }
    }

    async function detectProductStockNotifications(settingsRecord = null, products = []) {
      const settings = settingsRecord || await loadSettings();
      if (!settings || settings.notifications_enabled === false) return;

      const config = getInventoryNotificationSettings(settings);
      if (!config.lowStock && !config.outOfStock) return;

      await Promise.all(products.map((product) => {
        if (!productTracksStockRecord(product)) return null;
        if (product.has_variations === true) return null;

        const stock = stockNumber(product.stock);
        const name = product.name || 'Producto sin nombre';
        const visible = product.active !== false;
        const preorder = Boolean(product.allow_preorder);

        if (stock <= 0) {
          if (!config.outOfStock) return null;

          return ensureStoreNotificationAfterSourceChange({
            pb,
            storeId,
            type: 'out_of_stock',
            entityCollection: 'products',
            entityId: product.id,
            title: 'Producto agotado',
            message: `${name} está agotado${preorder ? ' y permite preorder' : ''}${visible ? ' · Visible en tienda.' : ' · Oculto.'}`,
            priority: visible && !preorder ? 'critical' : 'important',
            targetUrl: buildProductAdminUrl(product.id),
            sourceUpdated: product.updated || product.created || '',
            metadata: {
              product_id: product.id,
              product_name: name,
              stock,
              visible,
              preorder,
            },
          });
        }

        if (stock <= config.lowStockThreshold) {
          if (!config.lowStock) return null;

          return ensureStoreNotificationAfterSourceChange({
            pb,
            storeId,
            type: 'low_stock',
            entityCollection: 'products',
            entityId: product.id,
            title: 'Stock bajo',
            message: `${name} tiene ${stock} unidad${stock === 1 ? '' : 'es'} disponible${stock === 1 ? '' : 's'}.`,
            priority: 'important',
            targetUrl: buildProductAdminUrl(product.id),
            sourceUpdated: product.updated || product.created || '',
            metadata: {
              product_id: product.id,
              product_name: name,
              stock,
              threshold: config.lowStockThreshold,
              visible,
            },
          });
        }

        return null;
      }));
    }

    async function detectVariationStockNotifications(settingsRecord = null, products = [], variations = []) {
      const settings = settingsRecord || await loadSettings();
      if (!settings || settings.notifications_enabled === false) return;

      const config = getInventoryNotificationSettings(settings);
      if (!config.lowStock && !config.outOfStock) return;

      const productById = new Map(products.map((product) => [product.id, product]));

      await Promise.all(variations.map((variation) => {
        const product = productById.get(variation.product) || variation.expand?.product || null;
        if (!product) return null;
        if (product.has_variations !== true) return null;
        if (!productTracksStockRecord(product)) return null;

        const stock = stockNumber(variation.stock);
        const productName = product.name || 'Producto';
        const variationName = `${variation.variation_type || 'Variación'}: ${variation.value || 'Sin valor'}`;
        const visible = product.active !== false && variation.active !== false;
        const preorder = Boolean(variation.allow_preorder);

        if (stock <= 0) {
          if (!config.outOfStock) return null;

          return ensureStoreNotificationAfterSourceChange({
            pb,
            storeId,
            type: 'out_of_stock',
            entityCollection: 'product_variations',
            entityId: variation.id,
            title: 'Variación agotada',
            message: `${productName} · ${variationName} está agotada${preorder ? ' y permite preorder' : ''}${visible ? ' · Visible en tienda.' : ' · Oculta.'}`,
            priority: visible && !preorder ? 'critical' : 'important',
            targetUrl: buildVariationAdminUrl(product.id, variation.id),
            sourceUpdated: variation.updated || variation.created || '',
            metadata: {
              product_id: product.id,
              product_name: productName,
              variation_id: variation.id,
              variation_name: variationName,
              stock,
              visible,
              preorder,
            },
          });
        }

        if (stock <= config.lowStockThreshold) {
          if (!config.lowStock) return null;

          return ensureStoreNotificationAfterSourceChange({
            pb,
            storeId,
            type: 'low_stock',
            entityCollection: 'product_variations',
            entityId: variation.id,
            title: 'Stock bajo de variación',
            message: `${productName} · ${variationName} tiene ${stock} unidad${stock === 1 ? '' : 'es'} disponible${stock === 1 ? '' : 's'}.`,
            priority: 'important',
            targetUrl: buildVariationAdminUrl(product.id, variation.id),
            sourceUpdated: variation.updated || variation.created || '',
            metadata: {
              product_id: product.id,
              product_name: productName,
              variation_id: variation.id,
              variation_name: variationName,
              stock,
              threshold: config.lowStockThreshold,
              visible,
            },
          });
        }

        return null;
      }));
    }

    async function detectInventoryNotifications(settingsRecord = null) {
      try {
        const settings = settingsRecord || await loadSettings();
        if (!settings || settings.notifications_enabled === false) return;

        const products = await loadAllCollectionRecords('products', {
          filter: `store="${escapeFilterValue(storeId)}"`,
          sort: 'name',
          fields: 'id,name,store,active,track_stock,has_variations,stock,allow_preorder,updated,created',
          perPage: 200,
        });

        const productIds = new Set(products.map((product) => product.id).filter(Boolean));

        const variationsRaw = await loadAllCollectionRecords('product_variations', {
          sort: 'product,sort_order',
          fields: 'id,product,variation_type,value,active,stock,allow_preorder,updated,created,expand.product.store',
          expand: 'product',
          perPage: 200,
        });

        const variations = variationsRaw.filter((variation) => {
          if (productIds.has(variation.product)) return true;
          return variation.expand?.product?.store === storeId;
        });

        await detectProductStockNotifications(settings, products);
        await detectVariationStockNotifications(settings, products, variations);
      } catch (error) {
      }
    }

    function positionPanel(button) {
      const isMobile = window.matchMedia('(max-width: 1023px)').matches;
      if (isMobile || !button) {
        panel.style.top = '';
        panel.style.left = '';
        panel.style.right = '';
        return;
      }
      const rect = button.getBoundingClientRect();
      const width = Math.min(360, window.innerWidth - 24);
      const left = Math.max(12, Math.min(window.innerWidth - width - 12, rect.right - width));
      panel.style.top = `${Math.round(rect.bottom + 10)}px`;
      panel.style.left = `${Math.round(left)}px`;
      panel.style.right = 'auto';
    }

    function openPanel(button) {
      isOpen = true;
      positionPanel(button);
      panel.classList.remove('hidden');
      panel.setAttribute('aria-hidden', 'false');
      setButtonsExpanded(true);
      loadAll({ detectNewOrders: true, detectPending: true }).catch((error) => {
      });
    }

    function closePanel() {
      isOpen = false;
      panel.classList.add('hidden');
      panel.setAttribute('aria-hidden', 'true');
      setButtonsExpanded(false);
    }

    window.addEventListener('pz:admin-back-request', (event) => {
      if (event.defaultPrevented || !isOpen) return;
      event.preventDefault();
      closePanel();
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const trigger = target?.closest('[data-pz-admin-notification-trigger]');
      if (trigger) {
        event.preventDefault();
        event.stopPropagation();
        isOpen ? closePanel() : openPanel(trigger);
        return;
      }
      if (target?.closest('[data-pz-admin-notifications-panel]')) return;
      if (isOpen) closePanel();
    });

    list.addEventListener('click', async (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const readButton = target?.closest('[data-pz-notification-read]');
      const archiveButton = target?.closest('[data-pz-notification-archive]');
      const openLink = target?.closest('[data-pz-notification-open]');
      if (readButton) {
        event.preventDefault();
        await markNotificationRead({ pb, notificationId: readButton.getAttribute('data-pz-notification-read') || '' });
        await loadAll();
      } else if (archiveButton) {
        event.preventDefault();
        await archiveNotification({ pb, notificationId: archiveButton.getAttribute('data-pz-notification-archive') || '' });
        await loadAll();
      } else if (openLink) {
        await markNotificationRead({ pb, notificationId: openLink.getAttribute('data-pz-notification-open') || '' });
      }
    });

    markAllButton?.addEventListener('click', async () => {
      await markAllNotificationsRead({ pb, storeId });
      await loadAll();
    });

    archiveAllButton?.addEventListener('click', async () => {
      const confirmed = await window.AdminDialog.confirm({
        title: 'Eliminar notificaciones',
        message: 'Se archivaran todas las notificaciones y dejaran de mostrarse en la campana.',
        confirmText: 'Eliminar todas',
        cancelText: 'Cancelar',
        tone: 'danger',
      });
      if (!confirmed) return;

      archiveAllButton.disabled = true;
      archiveAllButton.textContent = 'Eliminando...';

      try {
        await archiveAllNotifications({ pb, storeId });
        await loadAll();
      } finally {
        archiveAllButton.disabled = false;
        archiveAllButton.textContent = 'Eliminar todas';
      }
    });

    browserNotificationsButton?.addEventListener('click', async () => {
      try {
        if (!browserNotificationsSupported()) return;
        const nativeBridge = getNativePushBridge();
        if (nativeBridge) {
          const permission = String(nativePushState?.permission || nativeBridge.permissionState?.() || 'prompt');
          if (permission === 'denied') {
            nativeBridge.openSettings?.();
            return;
          }
          if (permission === 'granted' && getBrowserNotificationsEnabled()) {
            setBrowserNotificationsEnabled(false);
            await disableNativePushRegistration(nativeBridge);
            if (typeof window.adminToast === 'function') window.adminToast('Avisos de Android pausados', 'info');
          } else {
            setBrowserNotificationsEnabled(true);
            nativeBridge.requestPermission?.();
            scheduleNativePushSync(0);
            if (typeof window.adminToast === 'function') window.adminToast('Activando avisos de Android...', 'info');
          }
          return;
        }
        let permission = Notification.permission;
        if (permission === 'default') permission = await Notification.requestPermission();
        if (permission === 'granted') {
          const nextEnabled = !getBrowserNotificationsEnabled();
          setBrowserNotificationsEnabled(nextEnabled);
          if (nextEnabled) ensureAudioContext();
          if (typeof window.adminToast === 'function') {
            window.adminToast(nextEnabled ? 'Avisos del navegador activados' : 'Avisos del navegador pausados', 'info');
          }
        } else {
          setBrowserNotificationsEnabled(false);
        }
      } catch (error) {
        setBrowserNotificationsEnabled(false);
      } finally {
        renderBrowserNotificationsButton();
      }
    });

    nativePushOnboardingButton?.addEventListener('click', () => {
      const nativeBridge = getNativePushBridge();
      if (!nativeBridge) return;
      const permission = String(nativePushState?.permission || nativeBridge.permissionState?.() || 'prompt');
      if (permission === 'denied') {
        nativeBridge.openSettings?.();
        return;
      }

      setBrowserNotificationsEnabled(true);
      nativePushOnboardingButton.disabled = true;
      nativeBridge.requestPermission?.();
      scheduleNativePushSync(0);
      if (typeof window.adminToast === 'function') {
        window.adminToast('Activando avisos de Android...', 'info');
      }
      window.setTimeout(() => {
        nativePushOnboardingButton.disabled = false;
        renderBrowserNotificationsButton();
      }, 700);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) closePanel();
    });
    window.addEventListener('resize', () => {
      if (isOpen) positionPanel(document.querySelector('[data-pz-admin-notification-trigger][aria-expanded="true"]'));
    });
    window.addEventListener('focus', () => {
      renderBrowserNotificationsButton();
      syncNativePushRegistration().catch(() => {});
      loadAll({ detectNewOrders: true, detectPending: true }).catch((error) => {
      });
    });
    window.addEventListener('pagehide', cleanupRealtimeNotifications);
    window.addEventListener('beforeunload', cleanupRealtimeNotifications);
    window.addEventListener('pz:android-push-state', handleNativePushState);

    renderBrowserNotificationsButton();
    syncNativePushRegistration().catch(() => {});
    setupRealtimeNotifications().catch(() => {});
    loadAll({ detectNewOrders: true, detectPending: true }).catch((error) => {
    });
    window.setInterval(() => {
      loadAll({ detectNewOrders: true, detectPending: false }).catch((error) => {
      });
    }, 30000);
  })();
</script>

<script is:inline>
  (() => {
    if (window.__pzAdminSidebarReady) return;
    window.__pzAdminSidebarReady = true;

    const getSidebar = () => document.querySelector('[data-admin-sidebar-root]');
    const getOverlay = () => {
      let overlay = document.getElementById('sidebar-overlay');
      if (!overlay && document.body) {
        overlay = document.createElement('div');
        overlay.id = 'sidebar-overlay';
        overlay.className = 'sidebar-overlay';
        overlay.hidden = true;
        overlay.setAttribute('aria-hidden', 'true');
        document.body.appendChild(overlay);
      }
      return overlay;
    };
    const openButtons = ['#sidebar-open', '#sidebar-open-legacy', '#sidebar-open-btn', '[data-sidebar-open]'];
    const isMobileSidebar = () => window.matchMedia('(max-width: 1023px)').matches;
    const setExpanded = (value) => {
      openButtons.forEach((selector) => {
        document.querySelectorAll(selector).forEach((button) => button.setAttribute('aria-expanded', value ? 'true' : 'false'));
      });
    };

    const moveFocusOutOfSidebar = (sidebar) => {
      if (!sidebar || !sidebar.contains(document.activeElement)) return;

      const mobileButton = document.getElementById('sidebar-open')
        || document.querySelector('[data-admin-sidebar-toggle]')
        || document.querySelector('.pz-admin-mobile-topbar__menu')
        || document.querySelector('.pz-admin-mobile-menu-btn');

      if (mobileButton && typeof mobileButton.focus === 'function') {
        mobileButton.focus({ preventScroll: true });
      } else if (document.activeElement instanceof HTMLElement) {
        document.activeElement.blur();
      }
    };

    const syncSidebarA11y = () => {
      const sidebar = getSidebar();
      if (!sidebar) return;

      if (isMobileSidebar() && !document.body.classList.contains('sidebar-open')) {
        moveFocusOutOfSidebar(sidebar);
        sidebar.setAttribute('aria-hidden', 'true');
        sidebar.setAttribute('inert', '');
      } else {
        sidebar.setAttribute('aria-hidden', 'false');
        sidebar.removeAttribute('inert');
      }
    };

    const openSidebar = () => {
      const sidebar = getSidebar();
      const overlay = getOverlay();
      document.body.classList.add('sidebar-open');
      sidebar?.removeAttribute('inert');
      sidebar?.setAttribute('aria-hidden', 'false');
      if (overlay) {
        overlay.hidden = false;
        overlay.setAttribute('aria-hidden', 'false');
      }
      setExpanded(true);
    };

    const closeSidebar = () => {
      const sidebar = getSidebar();
      const overlay = getOverlay();
      moveFocusOutOfSidebar(sidebar);
      document.body.classList.remove('sidebar-open');
      syncSidebarA11y();
      setExpanded(false);
      if (overlay) {
        overlay.hidden = true;
        overlay.setAttribute('aria-hidden', 'true');
      }
    };

    const isVisibleBackTarget = (element) => {
      if (!(element instanceof HTMLElement)) return false;
      if (element.hidden || element.classList.contains('hidden')) return false;
      if (element.getAttribute('aria-hidden') === 'true') return false;
      return element.getClientRects().length > 0;
    };

    const closeSharedAdminDialog = () => {
      const overlay = document.getElementById('pz-admin-dialog-overlay');
      if (!isVisibleBackTarget(overlay)) return false;
      const cancel = document.getElementById('pz-admin-dialog-cancel')
        || document.getElementById('pz-admin-dialog-close');
      if (!(cancel instanceof HTMLElement)) return false;
      cancel.click();
      return true;
    };

    const closeTopVisibleDialog = () => {
      const dialogs = Array.from(document.querySelectorAll('[role="dialog"], dialog[open]'))
        .filter(isVisibleBackTarget);
      const dialog = dialogs[dialogs.length - 1];
      if (!(dialog instanceof HTMLElement)) return false;
      const closeControl = dialog.querySelector(
        '[data-pz-admin-back-close], [data-variation-modal-close], [aria-label^="Cerrar"], .modal-close, [id$="-cancel-btn"], [id$="-cancel"]'
      );
      if (closeControl instanceof HTMLElement) {
        closeControl.click();
        return true;
      }
      if (typeof HTMLDialogElement !== 'undefined' && dialog instanceof HTMLDialogElement) {
        const cancelEvent = new Event('cancel', { cancelable: true });
        if (dialog.dispatchEvent(cancelEvent) && dialog.open) dialog.close();
        return true;
      }
      return false;
    };

    const followExplicitMobileBack = () => {
      const backLinks = Array.from(document.querySelectorAll('[data-pz-admin-mobile-back]'))
        .filter(isVisibleBackTarget);
      const backLink = backLinks[backLinks.length - 1];
      if (!(backLink instanceof HTMLElement)) return false;
      backLink.click();
      return true;
    };

    const handleAdminBackNavigation = () => {
      if (closeSharedAdminDialog()) return true;
      if (closeTopVisibleDialog()) return true;
      const request = new CustomEvent('pz:admin-back-request', {
        cancelable: true,
        detail: { source: 'android' },
      });
      if (!window.dispatchEvent(request)) return true;
      return followExplicitMobileBack();
    };

    window.PZAdminBackNavigation = Object.freeze({
      handle: handleAdminBackNavigation,
    });

    window.addEventListener('pz:admin-back-request', (event) => {
      if (event.defaultPrevented || !document.body.classList.contains('sidebar-open')) return;
      event.preventDefault();
      closeSidebar();
    });

    const isOpenButton = (target) => target instanceof Element && openButtons.some((selector) => target.closest(selector));
    const hydrateOpenButtons = () => {
      openButtons.forEach((selector) => {
        document.querySelectorAll(selector).forEach((button) => {
          button.setAttribute('aria-controls', 'pz-admin-sidebar');
          button.setAttribute('aria-expanded', document.body.classList.contains('sidebar-open') ? 'true' : 'false');
        });
      });
    };

    const hydrateMobileBackLink = () => {
      document.body.classList.toggle(
        'has-pz-admin-mobile-back',
        Boolean(document.querySelector('[data-pz-admin-mobile-back]'))
      );
    };

    hydrateOpenButtons();
    hydrateMobileBackLink();
    syncSidebarA11y();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', hydrateOpenButtons, { once: true });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', hydrateMobileBackLink, { once: true });
    window.addEventListener('resize', syncSidebarA11y);
    window.addEventListener('pz:admin-sidebar-close', closeSidebar);

    document.addEventListener('click', (event) => {
      if (isOpenButton(event.target)) {
        event.preventDefault();
        event.stopImmediatePropagation();
        openSidebar();
        return;
      }

      const closeButton = event.target instanceof Element ? event.target.closest('[data-sidebar-close]') : null;
      if (closeButton) {
        event.preventDefault();
        closeSidebar();
        return;
      }

      const sidebarLink = event.target instanceof Element
        ? event.target.closest('[data-admin-sidebar-root] a[href]')
        : null;

      if (sidebarLink && document.body.classList.contains('sidebar-open')) {
        if (isMobileSidebar()) {
          window.setTimeout(() => {
            closeSidebar();
          }, 0);
        }
      }
    }, true);

    getOverlay()?.addEventListener('click', closeSidebar);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeSidebar();
    });

    document.addEventListener('click', (event) => {
      const actionButton = event.target instanceof Element
        ? event.target.closest('[data-pz-mobile-action]')
        : null;

      if (!actionButton) return;

      const targetSelector = actionButton.getAttribute('data-pz-mobile-action-target') || '';
      const eventName = actionButton.getAttribute('data-pz-mobile-action-event') || '';

      if (targetSelector) {
        const target = document.querySelector(targetSelector);
        if (target && typeof target.click === 'function') {
          event.preventDefault();
          target.click();
          return;
        }
      }

      if (eventName) {
        event.preventDefault();
        window.dispatchEvent(new CustomEvent(eventName, {
          bubbles: true,
          detail: {
            source: 'pz-admin-mobile-topbar',
          },
        }));
      }
    }, true);

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      document.cookie = 'pb_auth=; Path=/; Max-Age=0; SameSite=Lax';
      window.location.assign('/login');
    });

    const settingsToggle = document.querySelector('[data-settings-sidebar-toggle]');
    const settingsSubnav = document.getElementById('pz-admin-sidebar-settings-subnav');
    settingsToggle?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopImmediatePropagation();
      const willOpen = settingsSubnav?.classList.contains('is-collapsed');
      settingsSubnav?.classList.toggle('is-collapsed', !willOpen);
      settingsToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    }, true);

    const sidebarSectionToggles = Array.from(document.querySelectorAll('[data-sidebar-section-toggle]'));
    const setSidebarSectionOpen = (toggle, open) => {
      const panelId = toggle.getAttribute('aria-controls') || '';
      const panel = panelId ? document.getElementById(panelId) : null;
      panel?.classList.toggle('is-collapsed', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    sidebarSectionToggles.forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopImmediatePropagation();
        const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
        sidebarSectionToggles.forEach((candidate) => setSidebarSectionOpen(candidate, candidate === toggle && willOpen));
      }, true);
    });

    const syncMarketingVisualActiveItem = () => {
      const items = document.querySelectorAll('[data-marketing-visual-subitem]');
      if (!items.length) return;
      const path = window.location.pathname.replace(/\/+$/, '');
      const hashMap = {
        '#destacados': 'destacados',
        '#promociones': 'promociones',
        '#cupones': 'cupones',
        '#cintillo': 'cintillo',
        '#visuales': 'visuales',
      };
      const isPromos = /\/admin\/promos$/.test(path);
      const isRaffles = /\/admin\/promos\/raffles$/.test(path);
      const activeKey = isRaffles ? 'rifas' : (isPromos ? (hashMap[window.location.hash] || 'destacados') : '');
      items.forEach((item) => item.classList.toggle('is-active', item.getAttribute('data-marketing-visual-subitem') === activeKey));
    };

    const syncSettingsActiveItem = () => {
      const items = document.querySelectorAll('[data-settings-subitem]');
      if (!items.length) return;

      const path = window.location.pathname.replace(/\/+$/, '');
      const isSettings = /\/admin\/store-settings$/.test(path);

      const hashMap = {
        '#generales': 'generales',
        '#general': 'generales',
        '#footer': 'footer',
        '#monedas': 'monedas',
        '#horario': 'horario',
        '#schedule': 'horario',
      };

      const audienceHashes = new Set(['#rating', '#rating-pending', '#landing']);
      const activeKey = isSettings && !audienceHashes.has(window.location.hash)
        ? (hashMap[window.location.hash] || 'generales')
        : '';

      items.forEach((item) => {
        item.classList.toggle(
          'is-active',
          item.getAttribute('data-settings-subitem') === activeKey
        );
      });
    };

    const syncAudienceActiveItem = () => {
      const items = document.querySelectorAll('[data-audience-subitem]');
      if (!items.length) return;

      const path = window.location.pathname.replace(/\/+$/, '');
      const isSettings = /\/admin\/store-settings$/.test(path);
      const isRatingSettings = /\/admin\/store-settings\/rating$/.test(path);
      const isPushCampaigns = /\/admin\/push-campaigns$/.test(path);
      const hashMap = {
        '#rating': 'rating',
        '#rating-pending': 'rating',
        '#landing': 'landing',
      };
      const activeKey = isPushCampaigns
        ? 'push-campaigns'
        : isRatingSettings
          ? 'rating'
          : (isSettings ? (hashMap[window.location.hash] || '') : '');

      items.forEach((item) => {
        item.classList.toggle(
          'is-active',
          item.getAttribute('data-audience-subitem') === activeKey
        );
      });

      if (!activeKey) {
        if (isSettings) {
          const storeToggle = document.querySelector('[aria-controls="pz-admin-sidebar-store"]');
          if (storeToggle) {
            sidebarSectionToggles.forEach((candidate) => setSidebarSectionOpen(candidate, candidate === storeToggle));
            document.querySelectorAll('[data-sidebar-section-group]').forEach((group) => {
              group.classList.toggle('is-current', group.getAttribute('data-sidebar-section-group') === 'store');
            });
            settingsToggle?.classList.add('is-active');
            settingsSubnav?.classList.remove('is-collapsed');
            settingsToggle?.setAttribute('aria-expanded', 'true');
          }
        }
        return;
      }
      const audienceToggle = document.querySelector('[aria-controls="pz-admin-sidebar-audience"]');
      if (!audienceToggle) return;
      sidebarSectionToggles.forEach((candidate) => setSidebarSectionOpen(candidate, candidate === audienceToggle));
      document.querySelectorAll('[data-sidebar-section-group]').forEach((group) => {
        group.classList.toggle('is-current', group.getAttribute('data-sidebar-section-group') === 'audience');
      });
      settingsToggle?.classList.remove('is-active');
      settingsSubnav?.classList.add('is-collapsed');
      settingsToggle?.setAttribute('aria-expanded', 'false');
    };

    syncMarketingVisualActiveItem();
    syncSettingsActiveItem();
    syncAudienceActiveItem();
    window.addEventListener('hashchange', syncMarketingVisualActiveItem);
    window.addEventListener('hashchange', syncSettingsActiveItem);
    window.addEventListener('hashchange', syncAudienceActiveItem);

  })();
</script>

<script is:inline>
  (() => {
    if (window.__pzAdminScrollHintReady) return;
    window.__pzAdminScrollHintReady = true;

    const SELECTORS = [
      '[data-pz-scroll-hint]',
      '.summary-period-actions',
      '.period-tabs',
      '.analytics-tabs',
      '.visit-analytics-tabs',
      '.business-summary-tabs',
      '.expiration-tabs',
      '.profits-period-tabs',
      '.settings-tabs',
      '.marketing-tabs',
      '.rating-reviews-table-wrap',
      '.hours-table-wrap'
    ];

    const enhanced = new WeakSet();
    const updaters = new WeakMap();

    const shouldEnhance = (track) => {
      if (!(track instanceof HTMLElement)) return false;
      if (track.closest('.pz-scroll-hint-shell')) return false;
      if (track.closest('#pz-admin-sidebar')) return false;
      if (track.closest('.pz-admin-mobile-bottom-nav')) return false;
      if (track.closest('.pz-admin-mobile-topbar')) return false;
      if (track.matches('.tabs')) return false;
      return true;
    };

    const scrollTrackByArrow = (track, side, update) => {
      if (!(track instanceof HTMLElement)) return;

      const distance = Math.max(140, Math.floor(track.clientWidth * 0.72));
      const left = side === 'right' ? distance : -distance;

      track.scrollBy({
        left,
        behavior: 'smooth'
      });

      window.setTimeout(update, 80);
      window.setTimeout(update, 240);
      window.setTimeout(update, 520);
    };

    const createArrow = (side, track, update) => {
      const arrow = document.createElement('button');
      arrow.type = 'button';
      arrow.className = `pz-scroll-hint-arrow pz-scroll-hint-arrow--${side}`;
      arrow.setAttribute('aria-label', side === 'right' ? 'Desplazar a la derecha' : 'Desplazar a la izquierda');
      arrow.setAttribute('tabindex', '-1');

      arrow.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        scrollTrackByArrow(track, side, update);
      });

      arrow.addEventListener('touchend', (event) => {
        event.preventDefault();
        event.stopPropagation();
        scrollTrackByArrow(track, side, update);
      }, { passive: false });

      return arrow;
    };

    const updateShellState = (shell, track) => {
      if (!shell || !track) return;

      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
      const hasOverflow = maxScroll > 6;
      const canLeft = hasOverflow && track.scrollLeft > 3;
      const canRight = hasOverflow && track.scrollLeft < maxScroll - 3;

      shell.dataset.hasOverflow = hasOverflow ? 'true' : 'false';
      shell.dataset.canLeft = canLeft ? 'true' : 'false';
      shell.dataset.canRight = canRight ? 'true' : 'false';
    };

    const enhanceTrack = (track) => {
      if (!shouldEnhance(track) || enhanced.has(track)) return;

      const parent = track.parentNode;
      if (!parent) return;

      const shell = document.createElement('div');
      shell.className = 'pz-scroll-hint-shell';
      shell.dataset.hasOverflow = 'false';
      shell.dataset.canLeft = 'false';
      shell.dataset.canRight = 'false';

      parent.insertBefore(shell, track);
      shell.appendChild(track);

      track.classList.add('pz-scroll-hint-track');
      enhanced.add(track);

      const update = () => updateShellState(shell, track);
      updaters.set(track, update);

      shell.appendChild(createArrow('left', track, update));
      shell.appendChild(createArrow('right', track, update));

      track.addEventListener('scroll', update, { passive: true });

      window.requestAnimationFrame(update);
      window.setTimeout(update, 150);
      window.setTimeout(update, 450);
      window.setTimeout(update, 1000);

      if ('ResizeObserver' in window) {
        const observer = new ResizeObserver(update);
        observer.observe(track);
        observer.observe(shell);
      }
    };

    const initScrollHints = () => {
      const tracks = new Set();

      SELECTORS.forEach((selector) => {
        document.querySelectorAll(selector).forEach((track) => tracks.add(track));
      });

      tracks.forEach((track) => enhanceTrack(track));

      window.requestAnimationFrame(() => {
        document.querySelectorAll('.pz-scroll-hint-track').forEach((track) => {
          const update = updaters.get(track);
          if (typeof update === 'function') update();
        });
      });
    };

    const refreshScrollHints = () => {
      window.requestAnimationFrame(() => {
        document.querySelectorAll('.pz-scroll-hint-track').forEach((track) => {
          const update = updaters.get(track);
          if (typeof update === 'function') update();
        });
      });
    };

    const boot = () => {
      initScrollHints();

      window.addEventListener('resize', refreshScrollHints, { passive: true });
      window.addEventListener('orientationchange', () => window.setTimeout(refreshScrollHints, 250), { passive: true });
      window.addEventListener('hashchange', () => window.setTimeout(refreshScrollHints, 150), { passive: true });

      document.addEventListener('click', () => {
        window.setTimeout(initScrollHints, 80);
        window.setTimeout(refreshScrollHints, 220);
      }, true);

      if ('MutationObserver' in window) {
        const observer = new MutationObserver(() => {
          window.requestAnimationFrame(initScrollHints);
        });

        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
  })();
</script>

