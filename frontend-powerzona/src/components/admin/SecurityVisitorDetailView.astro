---
import {
  formatDateTime,
  formatMoneyUsd,
  formatNumber,
  getOrderTotal,
  getIpDisplayValue,
  getIpUnavailableNote,
  getPageTypeLabel,
  getVisitorDisplayName,
  getVisitorPhone,
  labelFromMap,
  DELIVERY_METHOD_LABELS,
  ORDER_STATUS_LABELS,
  type PaginatedResult,
  type SecurityOrder,
  type SecuritySettingsView,
  type SecurityVisitorPageviewRow,
  type SecurityVisitorSessionRow,
} from '../../lib/securityMonitoring';

interface Props {
  storeName: string;
  basePath: string;
  adminOrdersPath?: string;
  backHref?: string;
  settings: SecuritySettingsView;
  visitor: SecurityVisitorSessionRow;
  orders: PaginatedResult<SecurityOrder>;
  ordersError?: boolean;
  pageviews: PaginatedResult<SecurityVisitorPageviewRow>;
  viewError?: string;
}

const {
  storeName,
  basePath,
  adminOrdersPath = '',
  backHref = `${basePath}?section=visitors`,
  settings,
  visitor,
  orders,
  ordersError = false,
  pageviews,
  viewError = '',
} = Astro.props;

const showIp = String(settings.ip_visibility || 'hidden') !== 'hidden';
const relatedCustomer = visitor.relatedCustomer;
const ordersOpen = Boolean(relatedCustomer && (orders.page > 1 || Astro.url.searchParams.get('orders_open') === '1'));
const customerHref = relatedCustomer
  ? `${basePath}?section=customers&customer=${encodeURIComponent(relatedCustomer.id)}&orders_page=1&events_page=1`
  : '';

function pageWindow(result: PaginatedResult<unknown>) {
  const start = Math.max(1, Math.min(result.page - 2, result.totalPages - 4));
  const end = Math.min(result.totalPages, start + 4);
  const pages = [];
  for (let page = start; page <= end; page += 1) pages.push(page);
  return pages;
}

function pageLabel(result: PaginatedResult<unknown>) {
  if (!result || result.totalItems === 0) return 'Sin resultados';
  const from = (result.page - 1) * result.perPage + 1;
  const to = Math.min(result.totalItems, result.page * result.perPage);
  return `Mostrando ${formatNumber(from)}-${formatNumber(to)} de ${formatNumber(result.totalItems)}`;
}

function detailHref(page: number, ordersPage: number, keepOrdersOpen = false) {
  const query = new URLSearchParams();
  if (page > 1) query.set('page', String(page));
  if (ordersPage > 1) query.set('orders_page', String(ordersPage));
  if (keepOrdersOpen) query.set('orders_open', '1');
  const suffix = query.toString();
  return `${basePath}/visitors/${encodeURIComponent(visitor.id)}${suffix ? `?${suffix}` : ''}`;
}

function detailPageHref(page: number) {
  return detailHref(page, orders.page, Boolean(ordersOpen));
}

function ordersPageHref(page: number) {
  return detailHref(pageviews.page, page, true);
}

function orderHref(order: SecurityOrder) {
  return adminOrdersPath && order.id ? `${adminOrdersPath}?order=${encodeURIComponent(order.id)}` : '';
}
---

<section class="visitor-detail" aria-label={`Detalle de visitante de ${storeName}`}>
  <header class="detail-head">
    <div>
      <p class="detail-kicker">Visitantes de hoy</p>
      <div class="detail-title-row">
        <h2>{getVisitorDisplayName(visitor)}</h2>
        {relatedCustomer && <span class="identity-pill is-customer">Cliente identificado</span>}
      </div>
      <p>{storeName}</p>
    </div>
    <a class="secondary-action" href={backHref}>Volver a visitantes</a>
  </header>

  {viewError && <div class="detail-alert" role="alert">{viewError}</div>}

  <section class="detail-card" aria-labelledby="visitor-summary-title">
    <div class="section-head">
      <div>
        <h3 id="visitor-summary-title">Resumen del visitante</h3>
        <p>Actividad registrada durante el dia actual de la tienda.</p>
      </div>
    </div>

    <div class="summary-list">
      <div class="summary-row">
        <span>Identificacion</span>
        <strong><span class:list={['identity-pill', { 'is-customer': relatedCustomer }]}>{relatedCustomer ? 'Cliente identificado' : 'Visitante sin identificar'}</span></strong>
      </div>
      <div class="summary-row">
        <span>Cliente relacionado</span>
        <strong>{relatedCustomer ? getVisitorDisplayName(visitor) : 'No relacionado'}</strong>
      </div>
      <div class="summary-row">
        <span>Telefono</span>
        <strong>{getVisitorPhone(visitor)}</strong>
      </div>
      {showIp && (
        <div class="summary-row">
          <span>IP actual</span>
          <strong>
            {getIpDisplayValue(visitor)}
            {getIpUnavailableNote(visitor) && <small>{getIpUnavailableNote(visitor)}</small>}
          </strong>
        </div>
      )}
      <div class="summary-row">
        <span>Primera visita</span>
        <strong>{formatDateTime(visitor.first_seen_at)}</strong>
      </div>
      <div class="summary-row">
        <span>Ultima actividad</span>
        <strong>{formatDateTime(visitor.last_seen_at)}</strong>
      </div>
      <div class="summary-row">
        <span>Paginas visitadas</span>
        <strong>{formatNumber(visitor.pageviews_count)}</strong>
      </div>
      {relatedCustomer && (
        <div class="summary-row">
          <span>Pedidos realizados</span>
          <strong>{formatNumber(relatedCustomer.orders_count)}</strong>
        </div>
      )}
    </div>

    {customerHref && (
      <div class="summary-actions">
        <a class="row-action" href={customerHref}>Ver ficha del cliente</a>
      </div>
    )}
  </section>

  {relatedCustomer && (
    <details class="detail-card customer-orders-disclosure" open={ordersOpen}>
      <summary>
        <div>
          <h3>Pedidos del cliente</h3>
          <p>{formatNumber(relatedCustomer.orders_count)} {relatedCustomer.orders_count === 1 ? 'pedido realizado' : 'pedidos realizados'}</p>
        </div>
        <span class="disclosure-label">Ver pedidos</span>
      </summary>

      <div class="orders-content">
        {ordersError ? (
          <div class="empty-state">No se pudieron cargar los pedidos de este cliente en este momento.</div>
        ) : orders.items.length > 0 ? (
          <>
            <div class="orders-list" aria-label="Pedidos del cliente">
              {orders.items.map((order) => (
                <article class="order-row">
                  <div class="order-main">
                    <strong>{order.order_number || 'Pedido sin numero'}</strong>
                    <span>{formatDateTime(order.created)}</span>
                  </div>
                  <div class="order-meta">
                    <span>{formatMoneyUsd(getOrderTotal(order))}</span>
                    <span>{labelFromMap(DELIVERY_METHOD_LABELS, order.delivery_method)}</span>
                  </div>
                  <span class={`order-status status-${order.status || 'pending'}`}>{labelFromMap(ORDER_STATUS_LABELS, order.status)}</span>
                  <div class="order-action">
                    {orderHref(order) ? <a class="row-action" href={orderHref(order)}>Ver pedido</a> : <span>Consulta desde la tienda</span>}
                  </div>
                </article>
              ))}
            </div>

            {orders.totalPages > 1 && (
              <div class="pagination-bar" aria-label="Paginacion de pedidos del cliente">
                <span>{pageLabel(orders)}</span>
                <div class="pagination-actions">
                  <a class:list={['page-button', { disabled: orders.page <= 1 }]} href={ordersPageHref(Math.max(1, orders.page - 1))}>Anterior</a>
                  {pageWindow(orders).map((page) => <a class:list={['page-button', { 'is-active': page === orders.page }]} href={ordersPageHref(page)}>{page}</a>)}
                  <a class:list={['page-button', { disabled: orders.page >= orders.totalPages }]} href={ordersPageHref(Math.min(orders.totalPages, orders.page + 1))}>Siguiente</a>
                </div>
              </div>
            )}
          </>
        ) : (
          <div class="empty-state">No hay pedidos vinculados a este cliente.</div>
        )}
      </div>
    </details>
  )}

  <section class="detail-card" aria-labelledby="visitor-pages-title">
    <div class="section-head">
      <div>
        <h3 id="visitor-pages-title">Paginas navegadas</h3>
        <p>{pageLabel(pageviews)}</p>
      </div>
    </div>

    {pageviews.items.length > 0 ? (
      <>
        <div class:list={['pages-table', { 'has-ip': showIp }]} role="table" aria-label="Paginas navegadas por visitante">
          <div class="table-head" role="row">
            <span role="columnheader">Hora</span>
            <span role="columnheader">Tipo</span>
            <span role="columnheader">Nombre</span>
            <span role="columnheader">Ruta interna</span>
            {showIp && <span role="columnheader">IP</span>}
            <span role="columnheader">Accion</span>
          </div>
          <div class="table-body">
            {pageviews.items.map((pageview) => {
              const canOpen = pageview.canOpen && Boolean(pageview.openPath);
              return (
                <article class="table-row" role="row">
                  <div class="table-cell" role="cell" data-label="Hora">{formatDateTime(pageview.occurred_at || pageview.created)}</div>
                  <div class="table-cell" role="cell" data-label="Tipo">{getPageTypeLabel(pageview.page_type)}</div>
                  <div class="table-cell main-cell" role="cell" data-label="Nombre"><strong>{pageview.readableName}</strong></div>
                  <div class="table-cell path-cell" role="cell" data-label="Ruta interna">{pageview.path || 'No disponible'}</div>
                  {showIp && (
                    <div class="table-cell ip-cell" role="cell" data-label="IP">
                      <span>{getIpDisplayValue(pageview)}</span>
                      {getIpUnavailableNote(pageview) && <small>{getIpUnavailableNote(pageview)}</small>}
                    </div>
                  )}
                  <div class="table-cell action-cell" role="cell" data-label="Accion">
                    {canOpen ? <a class="row-action" href={pageview.openPath} target="_blank" rel="noreferrer">Abrir pagina</a> : <span>No disponible</span>}
                  </div>
                </article>
              );
            })}
          </div>
        </div>

        <div class="pagination-bar" aria-label="Paginacion de paginas navegadas">
          <span>{pageLabel(pageviews)}</span>
          <div class="pagination-actions">
            <a class:list={['page-button', { disabled: pageviews.page <= 1 }]} href={detailPageHref(Math.max(1, pageviews.page - 1))}>Anterior</a>
            {pageWindow(pageviews).map((page) => <a class:list={['page-button', { 'is-active': page === pageviews.page }]} href={detailPageHref(page)}>{page}</a>)}
            <a class:list={['page-button', { disabled: pageviews.page >= pageviews.totalPages }]} href={detailPageHref(Math.min(pageviews.totalPages, pageviews.page + 1))}>Siguiente</a>
          </div>
        </div>
      </>
    ) : (
      <div class="empty-state">No hay paginas registradas para este visitante.</div>
    )}
  </section>
</section>

<style>
  .visitor-detail {
    display: grid;
    gap: 16px;
    color: #0f172a;
  }

  .detail-head,
  .detail-card {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
  }

  .detail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px;
  }

  .detail-kicker {
    margin: 0 0 8px;
    width: max-content;
    max-width: 100%;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    padding: 7px 11px;
    font-size: 12px;
    line-height: 1;
    font-weight: 1000;
  }

  .detail-head h2,
  .detail-card h3 {
    margin: 0;
    color: #0f172a;
    font-weight: 1000;
    letter-spacing: 0;
  }

  .detail-head h2 {
    font-size: clamp(26px, 4vw, 42px);
    line-height: 1.02;
  }

  .detail-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .detail-head p:not(.detail-kicker),
  .section-head p {
    margin: 8px 0 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 780;
  }

  .detail-card {
    display: grid;
    gap: 16px;
    padding: 18px;
  }

  .section-head,
  .pagination-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .summary-list {
    display: grid;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
  }

  .summary-row {
    display: grid;
    grid-template-columns: minmax(150px, .7fr) minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    min-width: 0;
    padding: 13px 15px;
    border-top: 1px solid #e2e8f0;
  }

  .summary-row:first-child {
    border-top: 0;
  }

  .summary-row > span,
  .summary-row small {
    color: #64748b;
    font-size: 12px;
    line-height: 1.25;
    font-weight: 950;
  }

  .summary-row small {
    display: block;
    margin-top: 4px;
    color: #9a3412;
  }

  .summary-row > strong {
    min-width: 0;
    color: #0f172a;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 1000;
    overflow-wrap: anywhere;
  }

  .identity-pill,
  .order-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    max-width: 100%;
    border-radius: 999px;
    background: #f1f5f9;
    color: #475569;
    padding: 6px 10px;
    font-size: 12px;
    line-height: 1;
    font-weight: 1000;
  }

  .identity-pill.is-customer {
    background: #dcfce7;
    color: #166534;
  }

  .summary-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
  }

  .customer-orders-disclosure {
    padding: 0;
  }

  .customer-orders-disclosure > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
    padding: 18px;
    cursor: pointer;
    list-style: none;
  }

  .customer-orders-disclosure > summary::-webkit-details-marker {
    display: none;
  }

  .customer-orders-disclosure > summary p {
    margin: 6px 0 0;
    color: #64748b;
    font-size: 13px;
    font-weight: 820;
  }

  .disclosure-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #1d4ed8;
    font-size: 13px;
    font-weight: 1000;
  }

  .disclosure-label::after {
    content: '⌄';
    font-size: 18px;
    line-height: 1;
    transition: transform .18s ease;
  }

  .customer-orders-disclosure[open] .disclosure-label::after {
    transform: rotate(180deg);
  }

  .orders-content {
    display: grid;
    gap: 14px;
    border-top: 1px solid #e2e8f0;
    padding: 0 18px 18px;
  }

  .orders-list {
    display: grid;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
  }

  .order-row {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(190px, 1fr) minmax(105px, .5fr) minmax(110px, .55fr);
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 13px 14px;
    border-top: 1px solid #e2e8f0;
  }

  .order-row:first-child {
    border-top: 0;
  }

  .order-main,
  .order-meta {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .order-main strong {
    color: #0f172a;
    font-size: 14px;
    font-weight: 1000;
  }

  .order-main span,
  .order-meta span,
  .order-action > span {
    color: #64748b;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 820;
  }

  .order-status.status-confirmed {
    background: #dbeafe;
    color: #1d4ed8;
  }

  .order-status.status-preparing,
  .order-status.status-pending {
    background: #fef3c7;
    color: #92400e;
  }

  .order-status.status-delivered {
    background: #dcfce7;
    color: #166534;
  }

  .order-status.status-cancelled {
    background: #fee2e2;
    color: #991b1b;
  }

  .order-action {
    display: flex;
    justify-content: flex-end;
  }

  .secondary-action,
  .row-action,
  .page-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 8px;
    padding: 10px 13px;
    border: 1px solid #dbeafe;
    background: #ffffff;
    color: #1d4ed8;
    font: inherit;
    font-size: 13px;
    line-height: 1.1;
    font-weight: 1000;
    text-decoration: none;
  }

  .secondary-action {
    color: #334155;
    border-color: #e2e8f0;
    background: #f8fafc;
  }

  .pages-table {
    display: grid;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #f8fafc;
  }

  .table-head,
  .table-row {
    display: grid;
    grid-template-columns: minmax(120px, .8fr) minmax(110px, .7fr) minmax(150px, 1fr) minmax(170px, 1.1fr) minmax(96px, .55fr);
    gap: 10px;
    align-items: center;
    min-width: 0;
  }

  .pages-table.has-ip .table-head,
  .pages-table.has-ip .table-row {
    grid-template-columns: minmax(120px, .8fr) minmax(110px, .7fr) minmax(150px, 1fr) minmax(170px, 1.1fr) minmax(120px, .75fr) minmax(96px, .55fr);
  }

  .table-head {
    padding: 12px 14px;
    color: #64748b;
    font-size: 11px;
    line-height: 1.1;
    font-weight: 1000;
    text-transform: uppercase;
  }

  .table-row {
    padding: 14px;
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
  }

  .table-cell {
    min-width: 0;
    color: #334155;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 820;
    overflow-wrap: anywhere;
  }

  .main-cell strong {
    color: #0f172a;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 1000;
  }

  .path-cell {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
  }

  .ip-cell {
    display: grid;
    gap: 4px;
  }

  .ip-cell small {
    color: #9a3412;
    font-size: 11px;
    line-height: 1.25;
    font-weight: 850;
  }

  .action-cell,
  .pagination-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pagination-bar > span {
    color: #64748b;
    font-size: 13px;
    font-weight: 850;
  }

  .page-button.disabled {
    opacity: .45;
    pointer-events: none;
  }

  .page-button.is-active {
    border-color: #2563eb;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .detail-alert,
  .empty-state {
    border-radius: 8px;
    padding: 14px;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 900;
  }

  .detail-alert {
    border: 1px solid #fecaca;
    background: #fee2e2;
    color: #991b1b;
  }

  .empty-state {
    min-height: 118px;
    display: grid;
    place-items: center;
    border: 1px dashed #cbd5e1;
    background: #f8fafc;
    color: #64748b;
    text-align: center;
  }

  @media (max-width: 1120px) {
    .order-row {
      grid-template-columns: minmax(145px, 1fr) minmax(170px, 1fr) minmax(105px, .55fr);
    }

    .order-action {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .detail-head,
    .section-head,
    .pagination-bar {
      align-items: stretch;
      flex-direction: column;
    }

    .secondary-action,
    .row-action,
    .page-button {
      width: 100%;
      min-height: 46px;
    }

    .detail-title-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .summary-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .summary-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .customer-orders-disclosure > summary {
      align-items: flex-start;
    }

    .orders-content {
      padding: 0 14px 14px;
    }

    .order-row {
      grid-template-columns: 1fr;
      gap: 9px;
    }

    .order-action {
      grid-column: auto;
      justify-content: stretch;
    }

    .pages-table {
      border: 0;
      background: transparent;
      overflow: visible;
    }

    .table-head {
      display: none;
    }

    .table-body {
      display: grid;
      gap: 10px;
    }

    .table-row,
    .pages-table.has-ip .table-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

    .table-cell {
      display: grid;
      grid-template-columns: minmax(96px, .42fr) minmax(0, 1fr);
      gap: 10px;
      align-items: start;
    }

    .table-cell::before {
      content: attr(data-label);
      color: #64748b;
      font-size: 11px;
      line-height: 1.2;
      font-weight: 1000;
      text-transform: uppercase;
    }

    .action-cell,
    .pagination-actions {
      display: grid;
      grid-template-columns: 1fr;
      justify-content: stretch;
    }
  }

  /* Escala cómoda exclusiva del Master; Store Admin conserva su escala propia. */
  :global(.master-app) .visitor-detail {
    font-size: var(--master-font-body);
    line-height: var(--master-line-normal);
  }

  :global(.master-app) .visitor-detail .detail-kicker,
  :global(.master-app) .visitor-detail .summary-row > span,
  :global(.master-app) .visitor-detail .summary-row small,
  :global(.master-app) .visitor-detail .table-head,
  :global(.master-app) .visitor-detail .path-cell,
  :global(.master-app) .visitor-detail .ip-cell small,
  :global(.master-app) .visitor-detail .table-cell::before {
    font-size: var(--master-font-caption);
  }

  :global(.master-app) .visitor-detail .detail-head h2 {
    font-size: var(--master-font-page-title);
  }

  :global(.master-app) .visitor-detail .detail-card h3 {
    font-size: var(--master-font-card-title);
