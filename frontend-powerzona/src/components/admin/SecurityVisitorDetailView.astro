---
import {
  formatDateTime,
  formatMoneyUsd,
  formatNumber,
  getOrderTotal,
  getIpDisplayValue,
  getIpUnavailableNote,
  getPageTypeLabel,
  getVisitorDisplayName,
  getVisitorPhone,
  labelFromMap,
  DELIVERY_METHOD_LABELS,
  EVENT_DECISION_LABELS,
  EVENT_RISK_LABELS,
  EVENT_TYPE_LABELS,
  ORDER_STATUS_LABELS,
  type PaginatedResult,
  type SecurityOrder,
  type SecuritySettingsView,
  type SecurityVisitorNetworkHistoryRow,
  type SecurityVisitorPageviewRow,
  type SecurityVisitorSessionRow,
  type VisitorRangeFilter,
} from '../../lib/securityMonitoring';

interface Props {
  storeName: string;
  basePath: string;
  adminOrdersPath?: string;
  backHref?: string;
  visitorRange?: VisitorRangeFilter;
  fullHistory?: boolean;
  settings: SecuritySettingsView;
  visitor: SecurityVisitorSessionRow;
  orders: PaginatedResult<SecurityOrder>;
  ordersError?: boolean;
  networkHistory: PaginatedResult<SecurityVisitorNetworkHistoryRow>;
  pageviews: PaginatedResult<SecurityVisitorPageviewRow>;
  viewError?: string;
}

const {
  storeName,
  basePath,
  adminOrdersPath = '',
  backHref = '',
  visitorRange = 'today',
  fullHistory = false,
  settings,
  visitor,
  orders,
  ordersError = false,
  networkHistory,
  pageviews,
  viewError = '',
} = Astro.props;

const rangeLabels: Record<VisitorRangeFilter, string> = {
  today: 'Hoy',
  days_7: 'Últimos 7 días',
  days_30: 'Últimos 30 días',
};
const rangeDescriptions: Record<VisitorRangeFilter, string> = {
  today: 'Actividad registrada durante el día actual de la tienda.',
  days_7: 'Actividad registrada durante los últimos 7 días.',
  days_30: 'Actividad registrada durante los últimos 30 días.',
};
const visitorsBackHref = backHref || `${basePath}?section=visitors${visitorRange === 'today' ? '' : `&visitor_range=${encodeURIComponent(visitorRange)}`}`;
const detailScopeLabel = fullHistory ? 'Historial completo' : rangeLabels[visitorRange];
const detailScopeDescription = fullHistory
  ? 'Resumen e IP relacionadas conservadas hasta 90 días. La navegación detallada se conserva hasta 30 días.'
  : rangeDescriptions[visitorRange];

const showIp = String(settings.ip_visibility || 'hidden') !== 'hidden';
const relatedCustomer = visitor.relatedCustomer;
const vpnInfo = visitor.vpn;
const hasVpnSignal = vpnInfo.status !== 'none';
const networkSummary = visitor.network_summary;
const vpnStatusLabel = vpnInfo.event_type
  ? labelFromMap(EVENT_TYPE_LABELS, vpnInfo.event_type)
  : (vpnInfo.status === 'unavailable' ? 'Verificacion no disponible' : 'Sin deteccion registrada');
const isVpnEvent = vpnInfo.event_type === 'vpn_detected' || vpnInfo.event_type === 'vpn_blocked';
const isAbuseEvent = vpnInfo.event_type === 'abusive_ip_detected' || vpnInfo.event_type === 'abusive_ip_blocked';
const vpnBadgeStatus = vpnInfo.status === 'blocked' ? 'detected' : vpnInfo.status;
const securityStatusLabels = {
  normal: 'Normal',
  watch: 'En observacion',
  blocked: 'Bloqueado',
};
const networkStatusLabels = {
  normal: 'Normal',
  suspected: 'Red sospechosa',
  detected: 'Riesgo de red confirmado',
  blocked: 'Red bloqueada',
  unavailable: 'Verificacion no disponible',
};
const currentIpBadgeStatus = networkSummary.current_ip_status === 'blocked' ? 'detected' : networkSummary.current_ip_status;
const ordersOpen = Boolean(relatedCustomer && (orders.page > 1 || Astro.url.searchParams.get('orders_open') === '1'));
const customerHref = relatedCustomer
  ? `${basePath}?section=customers&customer=${encodeURIComponent(relatedCustomer.id)}&orders_page=1&events_page=1`
  : '';

function pageWindow(result: PaginatedResult<unknown>) {
  const start = Math.max(1, Math.min(result.page - 2, result.totalPages - 4));
  const end = Math.min(result.totalPages, start + 4);
  const pages = [];
  for (let page = start; page <= end; page += 1) pages.push(page);
  return pages;
}

function pageLabel(result: PaginatedResult<unknown>) {
  if (!result || result.totalItems === 0) return 'Sin resultados';
  const from = (result.page - 1) * result.perPage + 1;
  const to = Math.min(result.totalItems, result.page * result.perPage);
  return `Mostrando ${formatNumber(from)}-${formatNumber(to)} de ${formatNumber(result.totalItems)}`;
}

function detailHref(page: number, ordersPage: number, keepOrdersOpen = false) {
  const query = new URLSearchParams();
  if (visitorRange !== 'today') query.set('visitor_range', visitorRange);
  if (fullHistory) query.set('history', 'full');
  if (page > 1) query.set('page', String(page));
  if (ordersPage > 1) query.set('orders_page', String(ordersPage));
  if (fullHistory && networkHistory.page > 1) query.set('network_page', String(networkHistory.page));
  if (keepOrdersOpen) query.set('orders_open', '1');
  const suffix = query.toString();
  return `${basePath}/visitors/${encodeURIComponent(visitor.id)}${suffix ? `?${suffix}` : ''}`;
}

function detailPageHref(page: number) {
  return detailHref(page, orders.page, Boolean(ordersOpen));
}

function ordersPageHref(page: number) {
  return detailHref(pageviews.page, page, true);
}

function networkPageHref(page: number) {
  const query = new URLSearchParams();
  if (visitorRange !== 'today') query.set('visitor_range', visitorRange);
  query.set('history', 'full');
  if (pageviews.page > 1) query.set('page', String(pageviews.page));
  if (orders.page > 1) query.set('orders_page', String(orders.page));
  if (page > 1) query.set('network_page', String(page));
  if (ordersOpen) query.set('orders_open', '1');
  return `${basePath}/visitors/${encodeURIComponent(visitor.id)}?${query.toString()}`;
}

function historyModeHref(showFullHistory: boolean) {
  const query = new URLSearchParams();
  if (visitorRange !== 'today') query.set('visitor_range', visitorRange);
  if (showFullHistory) query.set('history', 'full');
  const suffix = query.toString();
  return `${basePath}/visitors/${encodeURIComponent(visitor.id)}${suffix ? `?${suffix}` : ''}`;
}

function orderHref(order: SecurityOrder) {
  return adminOrdersPath && order.id ? `${adminOrdersPath}?order=${encodeURIComponent(order.id)}` : '';
}

function pluralIp(value: number) {
  return `${formatNumber(value)} ${value === 1 ? 'IP registrada' : 'IP registradas'}`;
}
---

<section class="visitor-detail" aria-label={`Detalle de visitante de ${storeName}`}>
  <header class="detail-head">
    <div>
      <p class="detail-kicker">Visitantes · {detailScopeLabel}</p>
      <div class="detail-title-row">
        <h2>{getVisitorDisplayName(visitor)}</h2>
        {relatedCustomer && <span class="identity-pill is-customer">Cliente identificado</span>}
      </div>
      <p>{storeName}</p>
    </div>
    <a class="secondary-action" href={visitorsBackHref}>Volver a visitantes</a>
  </header>

  {viewError && <div class="detail-alert" role="alert">{viewError}</div>}

  <section class="admin-compact-summary security-detail-summary" aria-labelledby="visitor-summary-title">
    <div class="admin-compact-summary__head">
      <span class="admin-compact-summary__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 20c.8-4.2 3.3-6.3 7.5-6.3s6.7 2.1 7.5 6.3"></path></svg>
      </span>
      <div>
        <p class="admin-compact-summary__eyebrow">Resumen</p>
        <h3 id="visitor-summary-title" class="admin-compact-summary__title">Visitante</h3>
        <p class="admin-compact-summary__subtitle">{detailScopeDescription}</p>
      </div>
    </div>

    <div class="admin-compact-summary__list">
      <article class:list={['admin-compact-summary__item', visitor.security_status === 'blocked' ? 'is-danger' : visitor.security_status === 'watch' ? 'is-warn' : 'is-ok']}>
        <p class="admin-compact-summary__label">Estado actual</p>
        <p class="admin-compact-summary__value is-text"><span class:list={['security-status-pill', `is-${visitor.security_status}`]}>{securityStatusLabels[visitor.security_status]}</span></p>
      </article>
      <article class="admin-compact-summary__item">
        <p class="admin-compact-summary__label">Identidad</p>
        <p class="admin-compact-summary__value is-text summary-value-stack">
          <span class:list={['identity-pill', { 'is-customer': relatedCustomer }]}>{relatedCustomer ? 'Cliente identificado' : 'Visitante sin identificar'}</span>
          <span>{relatedCustomer ? getVisitorDisplayName(visitor) : 'No relacionado'}</span>
          {relatedCustomer && <small>{getVisitorPhone(visitor)} · Pedidos realizados: {formatNumber(relatedCustomer.orders_count)}</small>}
        </p>
      </article>
      <article class="admin-compact-summary__item is-purple">
        <p class="admin-compact-summary__label">Actividad</p>
        <p class="admin-compact-summary__value is-text summary-value-stack">
          <span>{formatNumber(visitor.pageviews_count)} {visitor.pageviews_count === 1 ? 'pagina visitada' : 'paginas visitadas'}</span>
          <small>Primera visita: {formatDateTime(visitor.first_seen_at)} · Ultima actividad: {formatDateTime(visitor.last_seen_at)}</small>
        </p>
      </article>
      <article class="admin-compact-summary__item is-warn">
        <p class="admin-compact-summary__label">Red conocida</p>
        <p class="admin-compact-summary__value is-text summary-value-stack">
          <span>{pluralIp(networkSummary.ip_count)} relacionadas · {formatNumber(networkSummary.vpn_ip_count)} con riesgo de red confirmado</span>
          {networkSummary.suspected_ip_count > 0 && <small>{formatNumber(networkSummary.suspected_ip_count)} sospechosas sin confirmar VPN</small>}
          {networkSummary.unavailable_ip_count > 0 && <small>{formatNumber(networkSummary.unavailable_ip_count)} sin verificacion disponible</small>}
          <small>Historial del mismo visitante conservado hasta 90 días</small>
        </p>
      </article>
      {showIp && (
        <article class="admin-compact-summary__item">
          <p class="admin-compact-summary__label">IP actual</p>
          <p class="admin-compact-summary__value is-text summary-value-stack">
            <span>{getIpDisplayValue(visitor)}</span>
            <span class:list={['network-status-pill', `is-${currentIpBadgeStatus}`]}>{networkStatusLabels[networkSummary.current_ip_status]}</span>
            {getIpUnavailableNote(visitor) && <small>{getIpUnavailableNote(visitor)}</small>}
          </p>
        </article>
      )}
    </div>

    {hasVpnSignal && (
      <details class="security-details-disclosure">
        <summary>
          <span>Detalles de la IP actual</span>
          <small>Ver evaluacion, decision y riesgo</small>
        </summary>
        <div class="security-details-content">
          <div class="admin-compact-summary__list security-detail-list">
            <article class:list={['admin-compact-summary__item', vpnInfo.status === 'blocked' ? 'is-danger' : 'is-warn']}>
              <p class="admin-compact-summary__label">{isVpnEvent ? 'VPN o proxy' : 'Senal de red'}</p>
              <p class="admin-compact-summary__value is-text"><span class:list={['vpn-status-pill', `is-${vpnBadgeStatus}`]}>{vpnStatusLabel}</span></p>
            </article>
            {vpnInfo.observed_at && (
              <article class="admin-compact-summary__item">
                <p class="admin-compact-summary__label">
                  {vpnInfo.status === 'unavailable'
                    ? 'Última verificación'
                    : (vpnInfo.status === 'suspected' ? 'Última observación' : 'Última detección')}
                </p>
                <p class="admin-compact-summary__value is-text">{formatDateTime(vpnInfo.observed_at)}</p>
              </article>
            )}
            {vpnInfo.decision && (
              <article class="admin-compact-summary__item is-purple">
                <p class="admin-compact-summary__label">Decisión aplicada</p>
                <p class="admin-compact-summary__value is-text">{labelFromMap(EVENT_DECISION_LABELS, vpnInfo.decision)}</p>
              </article>
            )}
            {vpnInfo.risk_level && (
              <article class="admin-compact-summary__item is-warn">
                <p class="admin-compact-summary__label">Riesgo registrado</p>
                <p class="admin-compact-summary__value is-text">{labelFromMap(EVENT_RISK_LABELS, vpnInfo.risk_level)}</p>
              </article>
            )}
            {vpnInfo.provider && (
              <article class="admin-compact-summary__item">
                <p class="admin-compact-summary__label">Proveedores</p>
                <p class="admin-compact-summary__value is-text">{vpnInfo.provider.split(':').join(' + ')}</p>
              </article>
            )}
            {vpnInfo.provider_confidence !== null && (
              <article class="admin-compact-summary__item">
                <p class="admin-compact-summary__label">Confianza proxycheck</p>
                <p class="admin-compact-summary__value is-text">{formatNumber(vpnInfo.provider_confidence)}%</p>
              </article>
            )}
            {vpnInfo.hosting_consensus && (
              <article class="admin-compact-summary__item is-warn">
                <p class="admin-compact-summary__label">Hosting / datacenter</p>
                <p class="admin-compact-summary__value is-text">Confirmado por ambos proveedores</p>
              </article>
            )}
            {vpnInfo.abuse_available && vpnInfo.abuse_score !== null && (
              <article class="admin-compact-summary__item is-warn">
                <p class="admin-compact-summary__label">Puntuacion de abuso</p>
                <p class="admin-compact-summary__value is-text">
                  {formatNumber(vpnInfo.abuse_score)}/100
                  <small>{formatNumber(vpnInfo.abuse_total_reports)} reportes · {formatNumber(vpnInfo.abuse_distinct_users)} reportantes</small>
                  {vpnInfo.abuse_last_reported_at && <small>Ultimo reporte: {formatDateTime(vpnInfo.abuse_last_reported_at)}</small>}
                </p>
              </article>
            )}
          </div>
          {isVpnEvent && (
            <p class="vpn-info-note">Ultima evaluacion de riesgo registrada para la IP actual. Las IP anteriores permanecen en Red conocida y en el historial completo.</p>
          )}
          {isAbuseEvent && (
            <p class="vpn-info-note">La IP alcanzo el umbral de abuso configurado para PowerZona. El bloqueo se registra como IP abusiva, no como VPN.</p>
          )}
          {vpnInfo.event_type === 'hosting_blocked' && (
            <p class="vpn-info-note">ipapi.is y proxycheck.io coincidieron en que la conexion usa hosting o datacenter.</p>
          )}
          {vpnInfo.status === 'suspected' && (
            <p class="vpn-info-note">La red presenta contexto de datacenter o abuso, pero no alcanzo una regla activa de bloqueo.</p>
          )}
        </div>
      </details>
    )}

    <div class="summary-actions">
      <a class="row-action" href={historyModeHref(!fullHistory)}>{fullHistory ? `Volver a ${rangeLabels[visitorRange]}` : 'Ver historial completo'}</a>
      {customerHref && (
        <a class="row-action" href={customerHref}>Ver ficha del cliente</a>
      )}
    </div>
  </section>

  {fullHistory && (
    <section class="detail-card" aria-labelledby="visitor-network-history-title">
      <div class="section-head">
        <div>
          <h3 id="visitor-network-history-title">Historial de red</h3>
          <p>IP relacionadas con este visitante durante los últimos 90 días.</p>
        </div>
      </div>

      {networkHistory.items.length > 0 ? (
        <>
          <div class="network-history-table" role="table" aria-label="Historial de IP relacionadas con el visitante">
            <div class="table-head" role="row">
              <span role="columnheader">IP</span>
              <span role="columnheader">Estado</span>
              <span role="columnheader">Primera detección</span>
              <span role="columnheader">Última detección</span>
              <span role="columnheader">Registros</span>
            </div>
            <div class="table-body">
              {networkHistory.items.map((networkEntry) => {
                const historyBadgeStatus = networkEntry.networkStatus === 'blocked' ? 'detected' : networkEntry.networkStatus;
                return (
                  <article class="table-row" role="row">
                    <div class="table-cell ip-cell" role="cell" data-label="IP">
                      <strong>{getIpDisplayValue(networkEntry)}</strong>
                      {getIpUnavailableNote(networkEntry) && <small>{getIpUnavailableNote(networkEntry)}</small>}
                    </div>
                    <div class="table-cell" role="cell" data-label="Estado">
                      <span class:list={['network-status-pill', `is-${historyBadgeStatus}`]}>{networkStatusLabels[networkEntry.networkStatus]}</span>
                    </div>
                    <div class="table-cell" role="cell" data-label="Primera detección">{formatDateTime(networkEntry.first_seen_at)}</div>
                    <div class="table-cell" role="cell" data-label="Última detección">{formatDateTime(networkEntry.last_seen_at)}</div>
                    <div class="table-cell" role="cell" data-label="Registros">{formatNumber(networkEntry.sightings_count)}</div>
                  </article>
                );
              })}
            </div>
          </div>

          {networkHistory.totalPages > 1 && (
            <div class="pagination-bar" aria-label="Paginación del historial de red">
              <span>{pageLabel(networkHistory)}</span>
              <div class="pagination-actions">
                <a class:list={['page-button', { disabled: networkHistory.page <= 1 }]} href={networkPageHref(Math.max(1, networkHistory.page - 1))}>Anterior</a>
                {pageWindow(networkHistory).map((page) => <a class:list={['page-button', { 'is-active': page === networkHistory.page }]} href={networkPageHref(page)}>{page}</a>)}
                <a class:list={['page-button', { disabled: networkHistory.page >= networkHistory.totalPages }]} href={networkPageHref(Math.min(networkHistory.totalPages, networkHistory.page + 1))}>Siguiente</a>
              </div>
            </div>
          )}
        </>
      ) : (
        <div class="empty-state">No hay IP relacionadas disponibles para este visitante.</div>
      )}
    </section>
  )}

  {relatedCustomer && (
    <details class="detail-card customer-orders-disclosure" open={ordersOpen}>
      <summary>
        <div>
          <h3>Pedidos del cliente</h3>
          <p>{formatNumber(relatedCustomer.orders_count)} {relatedCustomer.orders_count === 1 ? 'pedido realizado' : 'pedidos realizados'}</p>
        </div>
        <span class="disclosure-label">Ver pedidos</span>
      </summary>

      <div class="orders-content">
        {ordersError ? (
          <div class="empty-state">No se pudieron cargar los pedidos de este cliente en este momento.</div>
        ) : orders.items.length > 0 ? (
          <>
            <div class="orders-list" aria-label="Pedidos del cliente">
              {orders.items.map((order) => (
                <article class="order-row">
                  <div class="order-main">
                    <strong>{order.order_number || 'Pedido sin numero'}</strong>
                    <span>{formatDateTime(order.created)}</span>
                  </div>
                  <div class="order-meta">
                    <span>{formatMoneyUsd(getOrderTotal(order))}</span>
                    <span>{labelFromMap(DELIVERY_METHOD_LABELS, order.delivery_method)}</span>
                  </div>
                  <span class={`order-status status-${order.status || 'pending'}`}>{labelFromMap(ORDER_STATUS_LABELS, order.status)}</span>
                  <div class="order-action">
                    {orderHref(order) ? <a class="row-action" href={orderHref(order)}>Ver pedido</a> : <span>Consulta desde la tienda</span>}
                  </div>
                </article>
              ))}
            </div>

            {orders.totalPages > 1 && (
              <div class="pagination-bar" aria-label="Paginacion de pedidos del cliente">
                <span>{pageLabel(orders)}</span>
                <div class="pagination-actions">
                  <a class:list={['page-button', { disabled: orders.page <= 1 }]} href={ordersPageHref(Math.max(1, orders.page - 1))}>Anterior</a>
                  {pageWindow(orders).map((page) => <a class:list={['page-button', { 'is-active': page === orders.page }]} href={ordersPageHref(page)}>{page}</a>)}
                  <a class:list={['page-button', { disabled: orders.page >= orders.totalPages }]} href={ordersPageHref(Math.min(orders.totalPages, orders.page + 1))}>Siguiente</a>
                </div>
              </div>
            )}
          </>
        ) : (
          <div class="empty-state">No hay pedidos vinculados a este cliente.</div>
        )}
      </div>
    </details>
  )}

  <section class="detail-card" aria-labelledby="visitor-pages-title">
    <div class="section-head">
      <div>
        <h3 id="visitor-pages-title">Paginas navegadas</h3>
        <p>{pageLabel(pageviews)}</p>
        {fullHistory && <p>Detalle disponible dentro de la retención de 30 días.</p>}
      </div>
    </div>

    {pageviews.items.length > 0 ? (
      <>
        <div class:list={['pages-table', { 'has-ip': showIp }]} role="table" aria-label="Paginas navegadas por visitante">
          <div class="table-head" role="row">
            <span role="columnheader">Hora</span>
            <span role="columnheader">Tipo</span>
            <span role="columnheader">Nombre</span>
            <span role="columnheader">Ruta interna</span>
            {showIp && <span role="columnheader">IP</span>}
            <span role="columnheader">Accion</span>
          </div>
          <div class="table-body">
            {pageviews.items.map((pageview) => {
              const canOpen = pageview.canOpen && Boolean(pageview.openPath);
              const networkBadgeStatus = pageview.networkStatus === 'blocked' ? 'detected' : pageview.networkStatus;
              return (
                <article class="table-row" role="row">
                  <div class="table-cell" role="cell" data-label="Hora">{formatDateTime(pageview.occurred_at || pageview.created)}</div>
                  <div class="table-cell" role="cell" data-label="Tipo">{getPageTypeLabel(pageview.page_type)}</div>
                  <div class="table-cell main-cell" role="cell" data-label="Nombre"><strong>{pageview.readableName}</strong></div>
                  <div class="table-cell path-cell" role="cell" data-label="Ruta interna">{pageview.path || 'No disponible'}</div>
                  {showIp && (
                    <div class="table-cell ip-cell" role="cell" data-label="IP">
                      <span>{getIpDisplayValue(pageview)}</span>
                      <span class:list={['network-status-pill', `is-${networkBadgeStatus}`]}>{networkStatusLabels[pageview.networkStatus]}</span>
                      {getIpUnavailableNote(pageview) && <small>{getIpUnavailableNote(pageview)}</small>}
                    </div>
                  )}
                  <div class="table-cell action-cell" role="cell" data-label="Accion">
                    {canOpen ? (
                      <details class="row-menu">
                        <summary class="row-menu-trigger" aria-label="Acciones de pagina"><span aria-hidden="true">⋮</span></summary>
                        <div class="row-menu-content">
                          <a href={pageview.openPath} target="_blank" rel="noreferrer">Abrir pagina</a>
                        </div>
                      </details>
                    ) : <span>No disponible</span>}
                  </div>
                </article>
              );
            })}
          </div>
        </div>

        <div class="pagination-bar" aria-label="Paginacion de paginas navegadas">
          <span>{pageLabel(pageviews)}</span>
          <div class="pagination-actions">
            <a class:list={['page-button', { disabled: pageviews.page <= 1 }]} href={detailPageHref(Math.max(1, pageviews.page - 1))}>Anterior</a>
            {pageWindow(pageviews).map((page) => <a class:list={['page-button', { 'is-active': page === pageviews.page }]} href={detailPageHref(page)}>{page}</a>)}
            <a class:list={['page-button', { disabled: pageviews.page >= pageviews.totalPages }]} href={detailPageHref(Math.min(pageviews.totalPages, pageviews.page + 1))}>Siguiente</a>
          </div>
        </div>
      </>
    ) : (
      <div class="empty-state">No hay paginas registradas para este visitante.</div>
    )}
  </section>
</section>

<style>
  .visitor-detail {
    display: grid;
    gap: 16px;
    color: #0f172a;
  }

  .detail-head,
  .detail-card {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
  }

  .detail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px;
  }

  .detail-kicker {
    margin: 0 0 8px;
    width: max-content;
    max-width: 100%;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    padding: 7px 11px;
    font-size: 12px;
    line-height: 1;
    font-weight: 1000;
  }

