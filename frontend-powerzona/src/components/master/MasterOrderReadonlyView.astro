---
import type { MasterReadonlyOrderDetail } from '../../lib/masterStoreAnalytics';
import MasterIcon from './MasterIcon.astro';

interface Props {
  detail: MasterReadonlyOrderDetail;
  analyticsPath: string;
}

const { detail, analyticsPath } = Astro.props;
const { order, store } = detail;
const statusLabels: Record<string, string> = {
  pending: 'Pendiente',
  confirmed: 'Confirmado',
  preparing: 'Preparando',
  delivered: 'Entregado',
  cancelled: 'Cancelado',
};
const deliveryLabels: Record<string, string> = {
  delivery: 'Domicilio',
  pickup: 'Recogida',
  coordinate: 'A coordinar',
};

function formatUsd(value: unknown) {
  return new Intl.NumberFormat('es-US', { style: 'currency', currency: 'USD' }).format(Number(value || 0));
}

function formatDate(value: string) {
  const date = new Date(value);
  if (!Number.isFinite(date.getTime())) return 'Fecha no disponible';
  return new Intl.DateTimeFormat('es', {
    timeZone: 'America/Havana',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(date);
}
---

<main class="readonly-shell">
  <header class="readonly-hero">
    <div>
      <a class="back-link" href={analyticsPath}><MasterIcon name="back" size={16} /> Volver a Analíticas</a>
      <span class="readonly-kicker">Pedido · Solo lectura</span>
      <h1>{order.order_number || order.id}</h1>
      <p>{store.name}</p>
    </div>
    <div class="hero-badges">
      <span class:list={['store-status', store.status === 'active' ? 'is-active' : 'is-suspended']}>
        {store.status === 'active' ? 'Tienda activa' : 'Tienda suspendida'}
      </span>
      <span class={`order-status is-${order.status}`}>{statusLabels[order.status]}</span>
    </div>
  </header>

  <section class="order-summary" aria-label="Resumen del pedido">
    <article><span>Cliente</span><strong>{order.customer_name}</strong></article>
    <article><span>Fecha</span><strong>{formatDate(order.created)}</strong></article>
    <article><span>Estado</span><strong>{statusLabels[order.status]}</strong></article>
    <article><span>Entrega</span><strong>{deliveryLabels[order.delivery_method]}</strong></article>
    <article><span>Total USD</span><strong>{formatUsd(order.usd_total)}</strong></article>
    <article><span>Pago</span><strong>{order.mixed_payment ? 'Pago mixto' : 'Pago regular'}</strong></article>
  </section>

  <section class="items-card">
    <header>
      <div>
        <span>Contenido</span>
        <h2>Productos del pedido</h2>
      </div>
      <strong>{order.items.length} {order.items.length === 1 ? 'línea' : 'líneas'}</strong>
    </header>

    {order.items.length ? (
      <div class="items-list">
        <div class="items-head item-grid" aria-hidden="true">
          <span>Producto</span><span>Cantidad</span><span>Precio unitario</span><span>Total</span>
        </div>
        {order.items.map((item) => (
          <article class="item-row item-grid">
            <div class="product-cell" data-label="Producto">
              {item.item_image_url ? (
                <img src={item.item_image_url} alt="" width="62" height="62" loading="lazy" referrerpolicy="no-referrer" />
              ) : (
                <span class="image-placeholder" aria-hidden="true">PZ</span>
              )}
              <div>
                <strong>{item.product_name}</strong>
                {(item.variation_label || item.variation_name) && <small>{item.variation_label || item.variation_name}</small>}
                {item.is_gift && <span class="gift-badge">Regalo</span>}
              </div>
            </div>
            <div data-label="Cantidad"><strong>{item.quantity}</strong></div>
            <div data-label="Precio unitario"><span>{item.is_gift ? 'Gratis' : formatUsd(item.unit_price_usd)}</span></div>
            <div data-label="Total"><strong>{item.is_gift ? 'Gratis' : formatUsd(item.line_total_usd)}</strong></div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">Este pedido no tiene productos visibles.</p>
    )}
  </section>

  <aside class="readonly-note">
    <strong>Vista privada de consulta</strong>
    <p>Esta página no permite cambiar estado, editar cliente, eliminar, confirmar, entregar ni modificar inventario.</p>
  </aside>
</main>

<style>
  .readonly-shell { display: grid; gap: 18px; min-width: 0; padding: 6px 0 42px; color: #0f172a; }
  .readonly-hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 22px; border: 1px solid #dbeafe; border-radius: 18px; background: radial-gradient(circle at 88% 12%, rgba(96, 165, 250, .2), transparent 34%), linear-gradient(135deg, #fff, #f8fafc 60%, #eff6ff); padding: clamp(22px, 5vw, 36px); box-shadow: 0 20px 52px rgba(30, 64, 175, .08); }
  .readonly-hero > div:first-child { display: grid; gap: 9px; min-width: 0; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; width: max-content; max-width: 100%; color: #1d4ed8; font-size: 12px; font-weight: 900; text-decoration: none; }
  .readonly-kicker { color: #64748b; font-size: 10px; font-weight: 950; letter-spacing: .08em; text-transform: uppercase; }
  .readonly-hero h1 { margin: 0; overflow-wrap: anywhere; font-size: clamp(32px, 6vw, 52px); line-height: 1; font-weight: 1000; }
  .readonly-hero p { margin: 0; color: #475569; font-size: 15px; font-weight: 800; }
  .hero-badges { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  .store-status, .order-status, .gift-badge { display: inline-flex; align-items: center; width: max-content; border: 1px solid; border-radius: 999px; padding: 6px 10px; font-size: 10px; line-height: 1; font-weight: 950; white-space: nowrap; }
  .store-status.is-active { border-color: #a7f3d0; background: #ecfdf5; color: #047857; }
  .store-status.is-suspended { border-color: #fecaca; background: #fff1f2; color: #be123c; }
  .order-status.is-pending { border-color: #fde68a; background: #fffbeb; color: #92400e; }
  .order-status.is-confirmed { border-color: #bfdbfe; background: #eff6ff; color: #1d4ed8; }
  .order-status.is-preparing { border-color: #ddd6fe; background: #f5f3ff; color: #6d28d9; }
  .order-status.is-delivered { border-color: #a7f3d0; background: #ecfdf5; color: #047857; }
  .order-status.is-cancelled { border-color: #fecaca; background: #fff1f2; color: #be123c; }
  .order-summary { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  .order-summary article { display: grid; gap: 7px; min-width: 0; min-height: 104px; border: 1px solid #e2e8f0; border-radius: 13px; background: #fff; padding: 15px; box-shadow: 0 12px 30px rgba(15, 23, 42, .045); }
  .order-summary span { color: #64748b; font-size: 10px; font-weight: 950; letter-spacing: .04em; text-transform: uppercase; }
  .order-summary strong { align-self: end; overflow-wrap: anywhere; font-size: 14px; line-height: 1.35; font-weight: 950; }
  .items-card { overflow: hidden; border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; box-shadow: 0 18px 44px rgba(15, 23, 42, .06); }
  .items-card > header { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; padding: 18px 20px; }
  .items-card > header span { color: #1d4ed8; font-size: 10px; font-weight: 950; letter-spacing: .07em; text-transform: uppercase; }
  .items-card > header h2 { margin: 4px 0 0; font-size: 22px; line-height: 1.1; font-weight: 1000; }
  .items-card > header > strong { color: #475569; font-size: 12px; font-weight: 900; }
  .item-grid { display: grid; grid-template-columns: minmax(260px, 1.5fr) 100px 150px 130px; align-items: center; gap: 14px; }
  .items-head { border-bottom: 1px solid #e2e8f0; color: #64748b; padding: 11px 18px; font-size: 10px; font-weight: 950; text-transform: uppercase; }
  .item-row { border-bottom: 1px solid #eef2f7; padding: 13px 18px; }
  .item-row:last-child { border-bottom: 0; }
  .item-row > div { min-width: 0; font-size: 13px; }
  .product-cell { display: flex; align-items: center; gap: 12px; }
  .product-cell img, .image-placeholder { flex: 0 0 62px; width: 62px; height: 62px; border-radius: 11px; object-fit: cover; }
  .image-placeholder { display: grid; place-items: center; background: #eef2ff; color: #4338ca; font-size: 12px; font-weight: 1000; }
  .product-cell > div { display: grid; justify-items: start; gap: 4px; min-width: 0; }
  .product-cell strong { overflow-wrap: anywhere; font-size: 14px; font-weight: 950; }
  .product-cell small { color: #64748b; font-size: 11px; font-weight: 750; }
  .gift-badge { border-color: #fbcfe8; background: #fdf2f8; color: #be185d; padding: 4px 7px; }
  .empty-state { margin: 18px; border-radius: 12px; background: #f8fafc; color: #64748b; padding: 24px; text-align: center; font-size: 13px; font-weight: 750; }
  .readonly-note { border: 1px solid #cbd5e1; border-radius: 13px; background: #f8fafc; padding: 15px 17px; }
  .readonly-note strong { color: #334155; font-size: 13px; font-weight: 950; }
  .readonly-note p { margin: 5px 0 0; color: #64748b; font-size: 12px; line-height: 1.45; font-weight: 700; }

  @media (max-width: 1120px) {
    .order-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .readonly-hero { align-items: stretch; flex-direction: column; }
    .hero-badges { justify-content: flex-start; }
    .order-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .items-head { display: none; }
    .item-row { grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 10px; border: 1px solid #eef2f7; border-radius: 12px; padding: 13px; }
    .item-row:last-child { border-bottom: 1px solid #eef2f7; }
    .product-cell { grid-column: 1 / -1; }
    .item-row > div:not(.product-cell) { display: grid; gap: 4px; }
    .item-row > div:not(.product-cell)::before { content: attr(data-label); color: #94a3b8; font-size: 9px; font-weight: 950; text-transform: uppercase; }
  }

  @media (max-width: 520px) {
    .readonly-hero { padding: 20px 17px; }
    .order-summary { grid-template-columns: 1fr; }
    .order-summary article { min-height: 88px; }
    .items-card > header { align-items: flex-start; flex-direction: column; }
    .item-row { grid-template-columns: 1fr; }
    .product-cell { grid-column: auto; align-items: flex-start; }
  }
</style>
