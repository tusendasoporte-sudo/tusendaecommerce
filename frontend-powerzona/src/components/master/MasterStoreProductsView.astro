<script>
  import { pb } from '../../lib/pocketbase';
  import { runMasterProductWatchAction } from '../../lib/masterProductWatches';

  const shell = document.querySelector<HTMLElement>('[data-master-products-store]');
  const pocketbaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
  if (shell && pocketbaseUrl) {
    pb.authStore.loadFromCookie(document.cookie, 'pb_auth');
    shell.querySelectorAll<HTMLButtonElement>('[data-watch-enable]').forEach((button) => {
      button.addEventListener('click', async () => {
        const productId = String(button.dataset.watchEnable || '');
        const storeId = String(shell.dataset.masterProductsStore || '');
        if (!pb.authStore.isValid || !pb.authStore.token) return;
        button.disabled = true;
        button.textContent = 'Activando…';
        const result = await runMasterProductWatchAction(pocketbaseUrl, pb.authStore.token, storeId, productId, 'enable');
        if (result.available) window.location.reload();
        else {
          button.disabled = false;
          button.textContent = 'Seguir precio';
        }
      });
    });
  }
</script>
