---
import MasterIcon from './MasterIcon.astro';
import MasterStoreContextHeader from './MasterStoreContextHeader.astro';
import { proposeFirebaseProjectId, type MasterStoreAppBuilds } from '../../lib/masterStoreAppBuilds';
import { POWERZONA_EXISTING_APP_BASELINE, powerZonaStorefrontDefaults } from '../../lib/storefrontAppDefaults';
import type { StorePlanPresentation } from '../../lib/storePlanPresentation';

interface Props {
  data: MasterStoreAppBuilds;
  planPresentation: StorePlanPresentation;
  channel?: 'prepare' | 'publication' | 'analytics' | 'health';
}

const { data, planPresentation, channel = 'prepare' } = Astro.props;
const { store, profile, jobs, artifacts, brand_assets: brandAssets } = data;
const downloadAnalytics = data.download_analytics;
const downloadSummary = downloadAnalytics.summary;
const appHealth = data.app_health;
const healthSummary = appHealth.summary;
const premiumBuildAllowed = planPresentation.code === 'premium' && planPresentation.state !== 'expired';
const appLifecycleActive = !profile || profile.lifecycle_status === 'active';
const buildActionsAllowed = premiumBuildAllowed && appLifecycleActive;
const engineReleaseReady = /^[a-f0-9]{40}$/.test(data.engine_release.revision);
const activeExecutionJob = jobs.find((job) => ['queued', 'claimed'].includes(job.status)) || null;
const legacyBrandJob = jobs.find((job) => job.status === 'needs_attention'
  && job.failure_code === 'brand_assets_required' && !job.runner_id) || null;
const cancelableJob = activeExecutionJob?.status === 'queued' && !activeExecutionJob.runner_id
  ? activeExecutionJob : legacyBrandJob;
const queueNoticeJob = activeExecutionJob || legacyBrandJob;
const runnerControl = data.runner_control;
const compatibleOnlineRunner = runnerControl.agents.find((runner) => runner.online && runner.compatible) || null;
const compatibleRegisteredRunner = compatibleOnlineRunner
  || runnerControl.agents.find((runner) => runner.compatible) || null;
const anyOnlineRunner = runnerControl.agents.find((runner) => runner.online) || null;
const anyRegisteredRunner = runnerControl.agents[0] || null;
const runnerAuthorizationActive = runnerControl.authorization_state === 'authorized';
const runnerCanStart = activeExecutionJob?.status === 'queued'
  && ['pending', 'expired'].includes(runnerControl.authorization_state)
  && !!compatibleRegisteredRunner;
const brandAssetUrl = (asset: typeof brandAssets.icon) => asset
  ? `/api/master/store-app-brand-assets?asset_id=${encodeURIComponent(asset.id)}&file_name=${encodeURIComponent(asset.file_name)}`
  : '';
const belongsToCurrentProfile = (job: (typeof jobs)[number]) => !profile || job.profile_id === profile.id;
const currentActionJob = jobs.find((job) => belongsToCurrentProfile(job)
  && job.status === 'preview'
  && new Date(job.preview_expires_at).getTime() > Date.now())
  || jobs.find((job) => belongsToCurrentProfile(job)
    && ['failed', 'needs_attention'].includes(job.status)
    && !(job.failure_code === 'brand_assets_required' && !job.runner_id))
  || null;
const currentPreviewEngineReady = buildActionsAllowed
  && engineReleaseReady
  && !!currentActionJob?.preview
  && currentActionJob.preview.engine.target_version === data.engine_release.version
  && currentActionJob.preview.engine.target_revision === data.engine_release.revision;
const retryMode = currentActionJob ? ['failed', 'needs_attention'].includes(currentActionJob.status) : false;
const isPowerZona = store.slug === 'powerzona';
const powerZonaDefaults = powerZonaStorefrontDefaults();
const canAdoptPowerZona = isPowerZona && (!profile || (
  profile.package_name === POWERZONA_EXISTING_APP_BASELINE.packageName
  && profile.current_version_code === POWERZONA_EXISTING_APP_BASELINE.versionCode
  && profile.branding_mode !== 'inherit_existing'
));
const proposedFirebaseProjectId = isPowerZona
  ? powerZonaDefaults.firebaseProjectId
  : proposeFirebaseProjectId(store.name, store.id);
const manualDelivery = data.manual_whatsapp_delivery;
const latestApk = artifacts.find((artifact) => artifact.kind === 'apk'
  && artifact.visibility === 'store_delivery' && artifact.lifecycle_status === 'available'
  && artifact.release_status === 'published') || null;
const candidateApk = artifacts.find((artifact) => artifact.kind === 'apk'
  && artifact.visibility === 'store_delivery' && artifact.lifecycle_status === 'available'
  && ['candidate', 'approved'].includes(artifact.release_status)) || null;
const candidateAab = candidateApk
  ? artifacts.find((artifact) => artifact.job_id === candidateApk.job_id
    && artifact.kind === 'aab' && artifact.lifecycle_status === 'available') || null
  : null;
const publishedAab = latestApk
  ? artifacts.find((artifact) => artifact.job_id === latestApk.job_id
    && artifact.kind === 'aab' && artifact.lifecycle_status === 'available') || null
  : null;
const engineUpdate = profile?.engine_update || null;
const engineNeedsUpdate = engineUpdate?.available === true && !candidateApk;
const engineSeverityLabel = engineUpdate?.severity === 'critical'
  ? 'Crítica'
  : engineUpdate?.severity === 'normal' ? 'Normal' : 'Recomendada';
const nextVersionCode = profile
  ? Math.max(profile.current_version_code, profile.last_allocated_version_code) + 1
  : 1;
const latestApkJob = latestApk ? jobs.find((job) => job.id === latestApk.job_id) || null : null;
const whatsappReady = manualDelivery.sender.configured
  && manualDelivery.recipient.status === 'ready'
  && !!latestApk
  && latestApkJob?.status === 'succeeded'
  && !!latestApk?.download_url
  && profile?.downloads_allowed === true
  && premiumBuildAllowed;
const latestApkMarkedSent = latestApkJob?.delivery_status === 'marked_sent';
const pendingAdminAction = data.admin_actions.find((action) => ['queued', 'scheduled', 'claimed'].includes(action.status)) || null;
const deletableBinaryArtifacts = artifacts.filter((artifact) => ['apk', 'aab'].includes(artifact.kind)
  && artifact.lifecycle_status !== 'deleted');
const retryArtifactDeletion = deletableBinaryArtifacts.some((artifact) => artifact.lifecycle_status === 'deletion_queued');
const distributionLabel = profile?.distribution_status === 'withdrawn' ? 'Retirada' : 'Activa';
const lifecycleLabel = profile?.lifecycle_status === 'deletion_scheduled'
  ? 'Eliminación programada'
  : profile?.lifecycle_status === 'deleted' ? 'Eliminada' : 'Activa';
const updateReleaseState = latestApk?.update_delivery_status || data.update_policy.release_state;
const latestUpdateRequired = !!latestApk
  && data.update_policy.minimum_supported_version_code === latestApk.version_code;
const publicDownloadPagePath = `/app/${encodeURIComponent(store.slug)}`;

const statusLabels: Record<string, string> = {
  preview: 'Vista previa', queued: 'En cola', claimed: 'En ejecución', succeeded: 'Completado',
  failed: 'Falló', needs_attention: 'Requiere atención', canceled: 'Cancelado',
};

function dateTime(value: string) {
  const parsed = new Date(value);
  return Number.isFinite(parsed.getTime())
    ? new Intl.DateTimeFormat('es', { dateStyle: 'medium', timeStyle: 'short' }).format(parsed)
    : 'Pendiente';
}

function activityDateTime(value: string) {
  return value ? dateTime(value) : 'Sin actividad';
}

function healthLabel(value: string) {
  if (value === 'healthy') return 'Operativo';
  if (value === 'warning') return 'Con avisos';
  if (value === 'critical') return 'Requiere atención';
  if (value === 'inactive') return 'Inactivo';
  return 'Sin datos';
}

function healthPill(value: string) {
  if (value === 'healthy') return 'master-pill--success';
  if (value === 'critical') return 'master-pill--danger';
  if (value === 'warning') return 'master-pill--warning';
  return '';
}

function healthImportance(value: string) {
  if (value === 'core') return 'Servicio esencial';
  if (value === 'accelerator') return 'Acelerador';
  if (value === 'optional') return 'Opcional';
  if (value === 'user_setting') return 'Depende del usuario';
  return 'Observabilidad';
}

function permissionLabel(value: string) {
  if (value === 'granted') return 'Concedido';
  if (value === 'denied') return 'Denegado';
  return 'Sin confirmar';
}

function firebaseLabel(value: string) {
  if (value === 'registered') return 'Registrado';
  if (value === 'failed') return 'Falló';
  if (value === 'unavailable') return 'No disponible';
  if (value === 'registering') return 'Registrando';
  return 'Sin confirmar';
}
---

<section class="master-store-page master-app-build-page" data-store-app-build data-store-id={store.id} data-store-slug={store.slug} data-profile-id={profile?.id || ''} data-build-actions-allowed={String(buildActionsAllowed)} data-engine-release-ready={String(engineReleaseReady)} data-preview-engine-ready={String(currentPreviewEngineReady)} data-runner-watch={String(!!activeExecutionJob)} data-health-watch={String(channel === 'health')} data-channel={channel}>
  <MasterStoreContextHeader
    store={{
      id: store.id,
      name: store.name,
      slug: store.slug,
      status: store.status,
      featured: false,
      security_label: 'Seguridad no consultada',
    }}
    planPresentation={planPresentation}
  />

  <header class="master-app-build-heading">
    <div>
      <p class="master-app-build-eyebrow">Runner Android aislado</p>
      <h1>App Android</h1>
      <p>Crea una vista previa, revísala y confírmala antes de autorizar cualquier operación sensible.</p>
    </div>
    <span class="master-pill master-pill--info"><MasterIcon name="lock" size={16} /> Solo Master</span>
  </header>

  <nav class="master-app-build-channels" aria-label="Flujo de la app Android">
    <a class:list={[{ 'is-active': channel === 'prepare' }]} href={`/master/stores/${store.id}/app?channel=prepare`}>1. Preparar y probar</a>
    <a class:list={[{ 'is-active': channel === 'publication' }]} href={`/master/stores/${store.id}/app?channel=publication`}>2. Publicación</a>
    <a class:list={[{ 'is-active': channel === 'analytics' }]} href={`/master/stores/${store.id}/app?channel=analytics`}>3. Instalaciones y analítica</a>
    <a class:list={[{ 'is-active': channel === 'health' }]} href={`/master/stores/${store.id}/app?channel=health`}>4. Estado y diagnóstico</a>
  </nav>

  <div class="master-app-build-policy" role="note">
    <MasterIcon name="security" size={22} />
    <div>
      <strong>Tu Senda 84 conserva credenciales y firmas.</strong>
      <span>El administrador de tienda recibe únicamente APK, checksum e instrucciones. El panel nunca compila ni guarda secretos.</span>
    </div>
  </div>

  {!premiumBuildAllowed && (
    <section class="master-app-build-queue-lock" role="status">
      <MasterIcon name="alert" size={22} />
      <div>
        <strong>La administración Android permanece disponible, pero los builds requieren Premium</strong>
        <span>Una bajada a Básico retira la distribución Android. No elimina la app, sus archivos o identidad y tampoco suspende la tienda web.</span>
      </div>
    </section>
  )}

  {!engineReleaseReady && (
    <section class="master-app-build-queue-lock" role="alert">
      <MasterIcon name="alert" size={22} />
      <div>
        <strong>Falta fijar la revisión exacta del motor aprobado</strong>
        <span>Configura PZ_STOREFRONT_ENGINE_VERSION y PZ_STOREFRONT_ENGINE_REVISION en el backend. No se puede crear, confirmar ni reintentar una vista previa hasta fijar el commit de 40 caracteres.</span>
      </div>
    </section>
  )}

  {engineReleaseReady && currentActionJob && !currentPreviewEngineReady && (
    <section class="master-app-build-queue-lock" role="alert">
      <MasterIcon name="alert" size={22} />
      <div>
        <strong>Esta vista previa pertenece a otra release del motor</strong>
        <span>No puede confirmarse ni reintentarse. Crea una vista previa nueva para fijar la versión y el commit actualmente aprobados.</span>
      </div>
    </section>
  )}

  {queueNoticeJob && (
    <section class="master-app-build-queue-lock" role="alert">
      <MasterIcon name="alert" size={22} />
      <div>
        <strong>{queueNoticeJob.status === 'claimed' ? 'El runner ya está ejecutando este trabajo' : legacyBrandJob ? 'Este trabajo anterior necesita cancelarse' : 'Hay un trabajo confirmado en cola'}</strong>
        <span>{legacyBrandJob ? 'Fue creado antes de incorporar icono y splash. Cancélalo y crea una vista previa nueva con ambos hashes.' : 'Para garantizar que el icono y el splash coincidan con la vista previa aprobada, no pueden cambiar mientras exista este trabajo.'}</span>
      </div>
      {cancelableJob && (
        <button class="master-btn master-btn--secondary" type="button" data-app-cancel-job data-job-id={cancelableJob.id}>
          <MasterIcon name="close" size={18} /> Cancelar trabajo en cola
        </button>
      )}
      <p class="master-form-alert" data-app-cancel-alert hidden></p>
    </section>
  )}

  {activeExecutionJob && (
    <section class="master-card master-app-runner-control" data-prepare-only>
      <header class="master-card-header">
        <div>
          <h2 class="master-card-title">Ejecución privada</h2>
          <p class="master-card-subtitle">Autoriza este trabajo exacto y luego abre el acceso directo del runner en la PC de compilación.</p>
        </div>
        <span class:list={['master-pill', activeExecutionJob.status === 'claimed' || compatibleOnlineRunner ? 'master-pill--success' : 'master-pill--warning']}>
          {activeExecutionJob.status === 'claimed'
            ? 'En ejecución'
            : runnerAuthorizationActive
              ? 'Esperando apertura manual'
              : compatibleOnlineRunner ? 'Runner abierto' : compatibleRegisteredRunner ? 'Runner preparado' : 'Runner no registrado'}
        </span>
      </header>
      <div class="master-card-body master-app-runner-control__body">
        <div class="master-app-runner-control__status">
          <MasterIcon name={compatibleRegisteredRunner ? 'check' : 'alert'} size={21} />
          <div>
            <strong>{compatibleOnlineRunner
              ? 'Runner manual abierto y conectado'
              : compatibleRegisteredRunner ? 'Runner manual registrado; no permanece abierto'
                : anyOnlineRunner ? 'Hay un runner abierto, pero no es compatible' : 'Falta registrar el runner manual'}</strong>
            <span>{compatibleOnlineRunner
              ? `Motor ${compatibleOnlineRunner.engine_version} · ${compatibleOnlineRunner.engine_revision.slice(0, 7)} · última señal ${dateTime(compatibleOnlineRunner.last_seen_at)}`
              : compatibleRegisteredRunner
                ? `Motor ${compatibleRegisteredRunner.engine_version} · ${compatibleRegisteredRunner.engine_revision.slice(0, 7)} · último registro ${dateTime(compatibleRegisteredRunner.last_seen_at)}. Después de autorizar, abre el acceso directo en la PC.`
                : anyOnlineRunner || anyRegisteredRunner
                ? 'Debe coincidir con la release aprobada y permitir localmente las capacidades solicitadas.'
                : 'Ejecuta una vez el registro inicial desde la PC del runner para vincular su release y capacidades.'}</span>
          </div>
        </div>
        <div class="master-app-runner-control__contract">
          <span>Trabajo <code>{activeExecutionJob.id}</code></span>
          <span>Vista previa <code>{activeExecutionJob.preview_hash}</code></span>
          <span>Permisos: {runnerControl.required_capabilities.firebase ? 'Firebase' : 'sin cambios Firebase'} · {runnerControl.required_capabilities.signing ? 'firma' : 'sin generar firma'}</span>
        </div>
        {runnerAuthorizationActive && activeExecutionJob.status === 'queued' && (
          <p class="master-app-runner-control__waiting">Autorización de un solo uso preparada para {runnerControl.authorized_runner_id}. Abre ahora el acceso directo “Tu Senda 84 – Ejecutar runner”; debe hacerse antes de que pasen 10 minutos.</p>
        )}
        <p class="master-form-alert" data-app-runner-alert hidden></p>
        {activeExecutionJob.status === 'queued' && !runnerAuthorizationActive && (
          <div class="master-app-build-actions">
            <button class="master-btn master-btn--primary" type="button" data-app-runner-start data-job-id={activeExecutionJob.id} data-preview-hash={activeExecutionJob.preview_hash} disabled={!runnerCanStart}>
              <MasterIcon name="external" size={18} /> Autorizar ejecución manual
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="master-card master-app-brand-assets" data-prepare-only>
    <header class="master-card-header">
      <div>
        <h2 class="master-card-title">Icono y pantalla de inicio</h2>
        <p class="master-card-subtitle">En una app nueva ambas imágenes son obligatorias. En una app existente puedes conservar las actuales o reemplazar solo la que necesites.</p>
      </div>
      <span class:list={['master-pill', brandAssets.ready ? 'master-pill--success' : 'master-pill--warning']}>
        {brandAssets.inherited ? 'Se conservarán las actuales' : brandAssets.ready ? 'Listos para vista previa' : 'Configuración pendiente'}
      </span>
    </header>
    <div class="master-card-body">
      <div class="master-app-brand-assets__notice" role="note">
        <MasterIcon name="security" size={20} />
        <span>Formatos admitidos: JPG, PNG o WebP de hasta 12 MB. Icono final: 1024 × 1024 PNG. Splash final: 1080 × 1920 PNG. Se ajustan espacios para conservar toda la imagen.</span>
      </div>
      <div class="master-app-brand-assets__grid">
        {(['icon', 'splash'] as const).map((kind) => {
          const asset = brandAssets[kind];
          const label = kind === 'icon' ? 'Icono de la app' : 'Splash de inicio';
          const output = kind === 'icon' ? '1024 × 1024' : '1080 × 1920';
          return (
            <article class:list={['master-app-brand-asset', { 'is-ready': !!asset }]}>
              <div class:list={['master-app-brand-asset__preview', `is-${kind}`]}>
                {asset
                  ? <img src={brandAssetUrl(asset)} alt={`Vista normalizada: ${label}`} loading="lazy" />
                  : <span><MasterIcon name="eye" size={28} /> {brandAssets.inherited ? 'Conservar la actual' : 'Sin imagen'}</span>}
              </div>
              <div class="master-app-brand-asset__content">
                <div>
                  <h3>{label}</h3>
                  <p>Salida automática: {output} PNG</p>
                </div>
                {asset && (
                  <dl>
                    <div><dt>Origen</dt><dd>{asset.source_width} × {asset.source_height} · {asset.source_format.toUpperCase()}</dd></div>
                    <div><dt>SHA-256</dt><dd>{asset.sha256}</dd></div>
                  </dl>
                )}
                <form data-app-brand-form data-kind={kind}>
                  <label class="master-app-brand-asset__file">
                    <span>{asset || brandAssets.inherited ? 'Elegir reemplazo opcional' : 'Elegir imagen'}</span>
                    <input type="file" name="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" required disabled={!!activeExecutionJob || !buildActionsAllowed} />
                  </label>
                  <button class="master-btn master-btn--primary" type="submit" disabled={!!activeExecutionJob || !buildActionsAllowed}>
                    <MasterIcon name="save" size={18} /> {asset ? 'Convertir y reemplazar' : 'Convertir y guardar'}
                  </button>
                  <p class="master-form-alert" data-app-brand-alert hidden></p>
                </form>
              </div>
            </article>
          );
        })}
      </div>
      {!brandAssets.ready && <p class="master-app-brand-assets__required">Como esta app aún no existe, debes completar ambas imágenes antes de crear una vista previa. Nada se envía a Firebase ni al runner al guardarlas.</p>}
      {brandAssets.inherited && <p class="master-app-brand-assets__required">Si no subes reemplazos, la siguiente APK reutilizará exactamente el icono y el splash versionados de PowerZona.</p>}
    </div>
  </section>

  {profile && engineNeedsUpdate && (
    <section class:list={['master-app-engine-alert', { 'is-critical': engineUpdate.severity === 'critical' }]} data-prepare-only role="alert" aria-live="polite">
      <span class="master-app-engine-alert__icon"><MasterIcon name="bell" size={24} /></span>
      <div>
        <strong>Actualización del motor {engineSeverityLabel.toLowerCase()} disponible</strong>
        <span>
          Esta app usa {engineUpdate.current_version || 'una versión sin trazabilidad'} y el motor aprobado es {engineUpdate.target_version}.
          Solo una nueva APK/AAB confirmada puede incorporar cambios nativos comunes.
        </span>
      </div>
      <a class="master-btn master-btn--primary" href="#generar-actualizacion-motor">Preparar actualización</a>
    </section>
  )}

  {profile ? (
    <section class="master-card" data-prepare-only>
      <header class="master-card-header">
        <div><h2 class="master-card-title">Identidad aprovisionada</h2><p class="master-card-subtitle">El paquete, Firebase y la firma quedan bloqueados. El nombre visible puede cambiarse al generar una actualización.</p></div>
        <span class:list={['master-pill', profile.status === 'provisioned' ? 'master-pill--success' : 'master-pill--warning']}>{profile.status}</span>
      </header>
      <div class="master-card-body master-app-build-identity">
        <div><span>Nombre</span><strong>{profile.display_name}</strong></div>
        <div><span>Paquete</span><strong>{profile.package_name}</strong></div>
        <div><span>App key</span><strong>{profile.app_key}</strong></div>
        <div><span>Proyecto Firebase</span><strong>{profile.firebase_project_id || 'Pendiente del runner'}</strong></div>
        <div><span>Distribución</span><strong>{profile.distribution === 'play_and_direct' ? 'APK + AAB manual para Google Play' : 'APK directo'}</strong></div>
        <div><span>Versión actual</span><strong>{profile.current_version_name || 'Pendiente'} ({profile.current_version_code || '—'})</strong></div>
        <div><span>Motor instalado</span><strong>{profile.current_engine_version || 'Sin trazabilidad'}</strong></div>
        <div><span>Motor aprobado</span><strong>{data.engine_release.version}</strong></div>
      </div>
    </section>
  ) : (
    <>
    {canAdoptPowerZona && (
      <section class="master-card" data-prepare-only>
        <header class="master-card-header">
          <div><h2 class="master-card-title">Adoptar la app PowerZona existente</h2><p class="master-card-subtitle">Registra la identidad ya instalada sin reconstruir la APK 0.2.8 ni crear otro Firebase o certificado.</p></div>
          <span class="master-pill master-pill--info">Recomendado</span>
        </header>
        <form class="master-card-body master-form" data-app-adopt-form>
          <input type="hidden" name="app_key" value={powerZonaDefaults.appKey} />
          <input type="hidden" name="brand_key" value="powerzona" />
          <input type="hidden" name="store_url" value="https://tusenda84.com/t/powerzona" />
          <input type="hidden" name="current_version_code" value={POWERZONA_EXISTING_APP_BASELINE.versionCode} />
          <input type="hidden" name="current_version_name" value={POWERZONA_EXISTING_APP_BASELINE.versionName} />
          <div class="master-field-grid">
            <div class="master-field master-field--full">
              <label for="adopt-display-name">Nombre visible en la próxima APK</label>
              <input id="adopt-display-name" name="display_name" maxlength="60" required value="Power Zona" />
              <small>Este nombre no altera el paquete, Firebase ni el certificado. La app instalada lo mostrará después de actualizarse.</small>
            </div>
            <div class="master-field"><label>Paquete existente</label><input name="package_name" readonly value={POWERZONA_EXISTING_APP_BASELINE.packageName} /></div>
            <div class="master-field"><label>Versión instalada</label><input readonly value={`${POWERZONA_EXISTING_APP_BASELINE.versionName} (${POWERZONA_EXISTING_APP_BASELINE.versionCode})`} /></div>
            <div class="master-field master-field--full"><label>Firebase que se conserva</label><input name="firebase_project_id" readonly value={powerZonaDefaults.firebaseProjectId} /></div>
            <div class="master-field master-field--full"><label>Certificado de firma que se conserva</label><input name="signing_cert_sha256" readonly value={POWERZONA_EXISTING_APP_BASELINE.signingCertSha256} /></div>
          </div>
          <p class="master-form-alert" data-app-form-alert hidden></p>
          <div class="master-app-build-actions"><button class="master-btn master-btn--primary" type="submit" disabled={!!queueNoticeJob || !engineReleaseReady || !buildActionsAllowed}><MasterIcon name="check" size={18} /> Adoptar identidad existente</button></div>
        </form>
      </section>
    )}
    <section class="master-card" data-prepare-only>
      <header class="master-card-header"><div><h2 class="master-card-title">Crear una app nueva</h2><p class="master-card-subtitle">Aprovisionar por primera vez requiere icono y splash. La vista previa todavía no crea Firebase, registra paquetes ni genera firmas.</p></div></header>
      <form class="master-card-body master-form" data-app-provision-form>
        <div class="master-field-grid">
          <div class="master-field"><label for="app-display-name">Nombre visible</label><input id="app-display-name" name="display_name" maxlength="60" required value={isPowerZona ? 'Power Zona' : store.name} /></div>
          <div class="master-field"><label for="app-brand-key">Clave de marca</label><input id="app-brand-key" name="brand_key" pattern={'[a-z0-9][a-z0-9\\-]{1,62}[a-z0-9]'} required value={store.slug} /></div>
          <div class="master-field"><label for="app-key">App key</label><input id="app-key" name="app_key" required value={isPowerZona ? powerZonaDefaults.appKey : `${store.slug}-storefront`} /></div>
          <div class="master-field"><label for="app-package">Paquete Android exclusivo</label><input id="app-package" name="package_name" required value={`com.tusenda84.${store.slug.replaceAll('-', '')}`} /></div>
          <div class="master-field master-field--full"><label for="app-store-url">URL pública</label><input id="app-store-url" name="store_url" type="url" required value={`https://tusenda84.com/t/${store.slug}`} /></div>
          <div class="master-field master-field--full">
            <label for="app-firebase-project">ID propuesto del proyecto Firebase exclusivo</label>
            <input id="app-firebase-project" name="firebase_project_id" minlength="6" maxlength="30" pattern={'[a-z][a-z0-9\\-]{4,28}[a-z0-9]'} required value={proposedFirebaseProjectId} aria-describedby="app-firebase-project-help" />
            <small id="app-firebase-project-help">Generado desde el nombre de la tienda y un sufijo estable. Puedes editarlo antes de crear la vista previa; Firebase todavía no se crea.</small>
          </div>
          <div class="master-field"><label for="app-version-code">versionCode inicial</label><input id="app-version-code" name="version_code" type="number" min="1" max="2147483647" required value={isPowerZona ? 10 : 1} readonly /></div>
          <div class="master-field"><label for="app-version-name">versionName inicial</label><input id="app-version-name" name="version_name" required pattern={'[0-9]+\\.[0-9]+\\.[0-9]+'} value={isPowerZona ? '0.2.8' : '1.0.0'} /></div>
        </div>
        <label class="master-app-build-aab-option">
          <input type="checkbox" name="include_aab" checked={isPowerZona} />
          <span><strong>Incluir AAB para Google Play</strong><small>El mismo trabajo genera una sola APK final y, además, un AAB privado para descarga manual desde el Master. No se publica automáticamente.</small></span>
        </label>
        <div class="master-app-build-fixed-policy">
          <span>Motor común aprobado</span>
          <strong>{data.engine_release.version} · toda app nueva parte de esta versión</strong>
        </div>
        <p class="master-form-alert" data-app-form-alert hidden></p>
        <div class="master-app-build-actions"><button class="master-btn master-btn--primary" type="submit" disabled={!brandAssets.ready || !!queueNoticeJob || !engineReleaseReady || !buildActionsAllowed}><MasterIcon name="eye" size={18} /> Crear vista previa</button></div>
      </form>
    </section>
    </>
  )}

  {profile && (
    <section class="master-card master-app-admin" id="estados-administrativos-android" data-publication-only>
      <header class="master-card-header">
        <div>
          <h2 class="master-card-title">Estados y acciones administrativas</h2>
          <p class="master-card-subtitle">La distribución Android y la tienda web son estados independientes.</p>
        </div>
        <span class:list={['master-pill', profile.downloads_allowed ? 'master-pill--success' : 'master-pill--warning']}>
          Descargas {profile.downloads_allowed ? 'permitidas' : 'bloqueadas'}
        </span>
      </header>
      <div class="master-card-body master-app-admin__body">
        <div class="master-app-admin__states">
          <article><span>Distribución Android</span><strong>{distributionLabel}</strong><small>{profile.distribution_reason === 'plan_downgrade' ? 'Retirada automáticamente por bajada de Premium' : 'Controlada desde este panel'}</small></article>
          <article><span>Estado de la app</span><strong>{lifecycleLabel}</strong><small>{profile.lifecycle_status === 'deletion_scheduled' ? `Recuperable hasta ${dateTime(profile.deletion_recover_until)}` : 'Identidad y firma custodiadas por Tu Senda 84'}</small></article>
          <article><span>Tienda web</span><strong>{store.status === 'active' ? 'Activa' : 'Suspendida'}</strong><small>No cambia con ninguna acción Android</small></article>
        </div>

        {pendingAdminAction && (
          <div class="master-app-admin__pending" role="status">
            <MasterIcon name="clock" size={20} />
            <div>
              <strong>{pendingAdminAction.type === 'delete_app' ? 'Eliminación de app pendiente' : 'Eliminación de artefactos pendiente'}</strong>
              <span>Estado: {pendingAdminAction.status}{pendingAdminAction.not_before ? ` · no se ejecutará antes de ${dateTime(pendingAdminAction.not_before)}` : ''}</span>
            </div>
          </div>
        )}

        <div class="master-app-admin__actions">
          {profile.lifecycle_status === 'active' && profile.distribution_status === 'active' && (
            <button class="master-btn master-btn--secondary" type="button" data-app-admin-action="withdraw" disabled={!!pendingAdminAction}>
              <MasterIcon name="close" size={18} /> Retirar distribución
            </button>
          )}
          {profile.lifecycle_status === 'active' && profile.distribution_status === 'withdrawn' && (
            <button class="master-btn master-btn--primary" type="button" data-app-admin-action="reactivate" disabled={!!pendingAdminAction || !premiumBuildAllowed || !latestApk}>
              <MasterIcon name="check" size={18} /> Reactivar distribución
            </button>
          )}
          {profile.lifecycle_status === 'active' && (
            <button class="master-btn master-btn--secondary" type="button" data-app-admin-action="delete_artifacts" disabled={!!pendingAdminAction || !deletableBinaryArtifacts.length || !!activeExecutionJob}>
              <MasterIcon name="trash" size={18} /> {retryArtifactDeletion ? 'Reintentar eliminación APK/AAB' : 'Eliminar APK/AAB'}
            </button>
          )}
          {profile.lifecycle_status === 'active' && (
            <button class="master-btn master-btn--danger" type="button" data-app-admin-action="delete_app" data-delete-confirmation={`ELIMINAR APP ${profile.package_name}`} disabled={!!pendingAdminAction || !!activeExecutionJob}>
              <MasterIcon name="trash" size={18} /> Eliminar app
            </button>
          )}
          {profile.lifecycle_status === 'deletion_scheduled' && profile.can_recover && (
            <button class="master-btn master-btn--primary" type="button" data-app-admin-action="recover_app" disabled={pendingAdminAction?.status !== 'scheduled'}>
              <MasterIcon name="unlock" size={18} /> Recuperar app
            </button>
          )}
        </div>
        <p class="master-app-admin__help">
          Retirar es reversible y conserva archivos e identidad. Eliminar APK/AAB conserva Firebase, firma e identidad.
          Eliminar la app exige escribir su paquete exacto y concede 30 días para recuperarla.
        </p>
        <p class="master-form-alert" data-app-admin-alert hidden></p>
        {data.admin_actions.length > 0 && (
          <div class="master-app-admin__history">
            <h3>Historial administrativo</h3>
            {data.admin_actions.slice(0, 8).map((action) => (
              <article><div><strong>{action.type === 'delete_app' ? 'Eliminar app' : 'Eliminar APK/AAB'}</strong><span>{dateTime(action.created)}</span></div><span class="master-pill">{action.status}</span></article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {profile && (
    <section class="master-card" id="generar-actualizacion-motor" data-prepare-only>
      <header class="master-card-header"><div><h2 class="master-card-title">Generar actualización</h2><p class="master-card-subtitle">Reutiliza el paquete, proyecto Firebase y certificado de firma existentes. La vista previa fijará el motor {data.engine_release.version}.</p></div>{engineNeedsUpdate && <span class:list={['master-pill', engineUpdate?.severity === 'critical' ? 'master-pill--danger' : 'master-pill--warning']}>Motor pendiente</span>}</header>
      <form class="master-card-body master-form" data-app-update-form>
        <div class="master-field-grid">
          <div class="master-field master-field--full">
            <label for="update-display-name">Nombre visible</label>
            <input id="update-display-name" name="display_name" maxlength="60" required value={profile.display_name} />
            <small>Puedes cambiarlo sin crear otro paquete, proyecto Firebase ni certificado. Se aplicará únicamente a la nueva APK/AAB.</small>
          </div>
          <div class="master-field"><label for="update-version-code">Nuevo versionCode</label><input id="update-version-code" name="version_code" type="number" min={nextVersionCode} max="2147483647" required value={nextVersionCode} readonly /></div>
          <div class="master-field"><label for="update-version-name">Nuevo versionName</label><input id="update-version-name" name="version_name" required pattern={'[0-9]+\\.[0-9]+\\.[0-9]+'} placeholder="1.0.1" value={isPowerZona && profile.current_version_code === 10 ? '0.2.9' : undefined} /></div>
        </div>
        <label class="master-app-build-aab-option">
          <input type="checkbox" name="include_aab" checked={profile.distribution === 'play_and_direct'} disabled={profile.distribution === 'play_and_direct'} />
          <span>
            <strong>Incluir AAB para Google Play</strong>
            <small>{profile.distribution === 'play_and_direct' ? 'Google Play ya está habilitado para esta app; sus futuras versiones conservarán APK + AAB.' : 'Opcional. Al activarlo, se crea el AAB privado junto con esta misma APK final.'}</small>
          </span>
        </label>
        {candidateApk && <p class="master-app-build-candidate-warning">Primero resuelve el APK candidato {candidateApk.version_name} ({candidateApk.version_code}) en Publicación.</p>}
        <p class="master-form-alert" data-app-form-alert hidden></p>
        <div class="master-app-build-actions"><button class="master-btn master-btn--primary" type="submit" disabled={!brandAssets.ready || !!queueNoticeJob || !engineReleaseReady || !buildActionsAllowed || !!candidateApk}><MasterIcon name="eye" size={18} /> Crear vista previa de actualización</button></div>
      </form>
    </section>
  )}

  <section class="master-card master-app-build-preview-collapsed" data-app-preview-collapsed data-prepare-only hidden>
    <div class="master-app-build-preview-collapsed__summary">
      <span class="master-app-build-preview-collapsed__icon"><MasterIcon name="eye" size={20} /></span>
      <div>
        <strong>Vista previa pendiente cerrada</strong>
        <span>El trabajo continúa sin ejecutar. Ábrelo cuando quieras revisarlo o confirmarlo.</span>
        <small data-app-preview-collapsed-hash>{currentActionJob?.preview_hash ? `SHA-256 ${currentActionJob.preview_hash}` : ''}</small>
      </div>
    </div>
    <button class="master-btn master-btn--secondary" type="button" data-app-preview-open aria-controls="vista-previa-app">
      <MasterIcon name="eye" size={18} /> Abrir vista previa
    </button>
  </section>

  <section class="master-card master-app-build-preview" id="vista-previa-app" data-app-preview-card data-prepare-only hidden={!currentActionJob}>
    <header class="master-card-header">
      <div><h2 class="master-card-title">{retryMode ? 'Reanudar trabajo con la misma vista previa' : 'Vista previa pendiente de confirmación'}</h2><p class="master-card-subtitle">Verifica cada efecto antes de enviarlo al runner.</p></div>
      <div class="master-app-build-preview__header-actions">
        <span class="master-pill master-pill--warning">{retryMode ? 'Requiere atención' : 'No ejecutado'}</span>
        <button class="master-btn master-btn--secondary" type="button" data-app-preview-close aria-controls="vista-previa-app">
          <MasterIcon name="close" size={18} /> Cerrar vista previa
        </button>
      </div>
    </header>
    <div class="master-card-body">
      <pre data-app-preview-json>{currentActionJob?.preview ? JSON.stringify(currentActionJob.preview, null, 2) : ''}</pre>
      <p class="master-app-build-hash">SHA-256 de la vista previa: <code data-app-preview-hash>{currentActionJob?.preview_hash || ''}</code></p>
      <label class="master-app-build-confirm"><input type="checkbox" data-app-confirm-check disabled={!currentPreviewEngineReady} /> He revisado la identidad, Firebase, paquete, firma y artefactos descritos arriba.</label>
      <p class="master-form-alert" data-app-confirm-alert hidden></p>
      <div class="master-app-build-actions"><button class="master-btn master-btn--primary" type="button" data-app-confirm data-job-id={currentActionJob?.id || ''} data-mode={retryMode ? 'retry' : 'confirm'} disabled><MasterIcon name="check" size={18} /> {retryMode ? 'Confirmar reanudación' : 'Confirmar y poner en cola'}</button></div>
    </div>
  </section>

  <section class="master-card master-app-release" data-publication-only>
    <header class="master-card-header">
      <div>
        <h2 class="master-card-title">Publicar la misma APK probada</h2>
        <p class="master-card-subtitle">La compilación queda privada hasta que la descargues, la pruebes, la apruebes y finalmente la publiques. No se vuelve a construir.</p>
      </div>
      <span class="master-pill master-pill--info">Una sola APK</span>
    </header>
    <div class="master-card-body master-app-release__body">
      {candidateApk ? (
        <article class="master-app-release__candidate">
          <div>
            <span>APK candidata</span>
            <strong>{candidateApk.file_name}</strong>
            <small>Versión {candidateApk.version_name} ({candidateApk.version_code}) · SHA-256 {candidateApk.sha256}</small>
            <small>{candidateApk.release_status === 'approved' ? 'Aprobada y lista para publicar.' : 'Privada: el administrador de tienda todavía no puede descargarla.'}</small>
          </div>
          <div class="master-app-release__actions">
            <button class="master-btn master-btn--secondary" type="button" data-app-master-download data-download-path={candidateApk.master_download_path} data-file-name={candidateApk.file_name}><MasterIcon name="download" size={18} /> Descargar APK para probar</button>
            {candidateAab && <button class="master-btn master-btn--secondary" type="button" data-app-master-download data-download-path={candidateAab.master_download_path} data-file-name={candidateAab.file_name}><MasterIcon name="download" size={18} /> Descargar AAB</button>}
            <button class="master-btn master-btn--secondary" type="button" data-app-release-action="discard_candidate" data-artifact-id={candidateApk.id}><MasterIcon name="trash" size={18} /> Descartar candidata</button>
            {candidateApk.release_status === 'candidate' && <button class="master-btn master-btn--primary" type="button" data-app-release-action="approve_candidate" data-artifact-id={candidateApk.id}><MasterIcon name="check" size={18} /> Marcar APK como aprobada</button>}
            {candidateApk.release_status === 'approved' && <button class="master-btn master-btn--primary" type="button" data-app-release-action="publish_candidate" data-artifact-id={candidateApk.id}><MasterIcon name="external" size={18} /> Publicar APK aprobada</button>}
          </div>
        </article>
      ) : (
        <p class="master-empty">No hay una APK candidata pendiente. Prepárala en el paso 1 cuando necesites una primera versión o actualización.</p>
      )}
      {latestApk && (
        <article class="master-app-release__published">
          <div><span>Publicación actual · {updateReleaseState === 'paused' ? 'Pausada' : updateReleaseState === 'withdrawn' ? 'Retirada' : latestUpdateRequired ? 'Obligatoria' : 'Opcional'}</span><strong>{latestApk.file_name}</strong><small>Versión {latestApk.version_name} ({latestApk.version_code}) · SHA-256 {latestApk.sha256}</small></div>
          <div class="master-app-release__actions">
            <a class="master-btn master-btn--secondary" href={publicDownloadPagePath} target="_blank" rel="noreferrer"><MasterIcon name="external" size={18} /> Ver página de descarga</a>
            {latestApk.download_url && <a class="master-btn" href={latestApk.download_url} target="_blank" rel="noreferrer"><MasterIcon name="download" size={18} /> Abrir enlace publicado</a>}
            {publishedAab && <button class="master-btn master-btn--secondary" type="button" data-app-master-download data-download-path={publishedAab.master_download_path} data-file-name={publishedAab.file_name}><MasterIcon name="download" size={18} /> Descargar AAB para Google Play</button>}
            {updateReleaseState === 'active' && !latestUpdateRequired && <button class="master-btn master-btn--primary" type="button" data-app-release-action="require_update" data-artifact-id={latestApk.id}>Hacer obligatoria</button>}
            {updateReleaseState === 'active' && latestUpdateRequired && <button class="master-btn master-btn--secondary" type="button" data-app-release-action="optional_update" data-artifact-id={latestApk.id}>Volver a opcional</button>}
            {updateReleaseState === 'active' && <button class="master-btn master-btn--secondary" type="button" data-app-release-action="pause_update" data-artifact-id={latestApk.id}>Pausar descargas</button>}
            {updateReleaseState === 'paused' && <button class="master-btn master-btn--primary" type="button" data-app-release-action="resume_update" data-artifact-id={latestApk.id}>Reanudar descargas</button>}
            {['active', 'paused'].includes(updateReleaseState) && <button class="master-btn master-btn--danger" type="button" data-app-release-action="withdraw_update" data-artifact-id={latestApk.id}>Retirar publicación</button>}
          </div>
        </article>
      )}
      <p class="master-form-alert" data-app-release-alert hidden></p>
    </div>
  </section>

  <section class="master-card master-app-whatsapp" id="entrega-whatsapp" data-publication-only>
    <header class="master-card-header">
      <div>
        <h2 class="master-card-title">Entrega manual por WhatsApp</h2>
        <p class="master-card-subtitle">El panel prepara el mensaje; tú lo revisas y lo envías desde tu sesión de WhatsApp.</p>
      </div>
      <span class="master-pill master-pill--info">Sin Cloud API</span>
    </header>
    <div class="master-card-body master-app-whatsapp__body">
      <div class="master-app-whatsapp__notice" role="note">
        <MasterIcon name="lock" size={20} />
        <span>No se guardan sesiones, códigos QR ni credenciales. El mensaje incluye el enlace permanente de esta versión, su SHA-256 y las instrucciones de instalación.</span>
      </div>

      {!manualDelivery.sender.configured && (
        <div class="master-app-whatsapp__global-warning" role="alert">
          <MasterIcon name="alert" size={20} />
          <div>
            <strong>Falta el número global del Master</strong>
            <span>Configúralo una sola vez en la sección Master para habilitar las entregas de todas las tiendas.</span>
          </div>
          <a class="master-btn" href="/master/settings#whatsapp-master">Configurar en Master</a>
        </div>
      )}

      <div class="master-app-whatsapp__contacts">
        <article class="master-app-whatsapp__contact">
          <div>
            <span>Destinatario</span>
            <strong>{manualDelivery.recipient.display_name || 'Sin administrador principal'}</strong>
            <small>
              {manualDelivery.recipient.status === 'ready'
                ? `WhatsApp +${manualDelivery.recipient.whatsapp_number}`
                : manualDelivery.recipient.status === 'missing_primary'
                  ? 'Designa primero al administrador principal de la tienda.'
                  : manualDelivery.recipient.status === 'invalid_primary'
                    ? 'El administrador principal no está activo o no pertenece a la tienda.'
                    : 'Agrega su número completo, incluido el código de país.'}
            </small>
          </div>
          <a
            class="master-btn"
            href={manualDelivery.recipient.user_id
              ? `/master/stores/${store.id}/users/${manualDelivery.recipient.user_id}`
              : `/master/stores/${store.id}/users`}
          ><MasterIcon name="edit" size={17} /> Revisar administrador</a>
        </article>
      </div>

      {latestApk ? (
        <article class="master-app-whatsapp__artifact">
          <div>
            <span>APK custodiado en el servidor privado</span>
            <strong>{latestApk.file_name}</strong>
            <small>Versión {latestApk.version_name} ({latestApk.version_code}) · SHA-256 {latestApk.sha256}</small>
            {latestApk.download_url && <small>Enlace permanente e inmutable de esta versión.</small>}
          </div>
          <div class="master-app-whatsapp__artifact-actions">
            {latestApk.master_download_path && <button class="master-btn" type="button" data-app-master-download data-download-path={latestApk.master_download_path} data-file-name={latestApk.file_name}><MasterIcon name="download" size={17} /> Descargar APK</button>}
            <span class:list={['master-pill', latestApkMarkedSent ? 'master-pill--success' : 'master-pill--warning']}>
              {latestApkMarkedSent ? 'Marcado como enviado' : 'Pendiente de envío'}
            </span>
          </div>
        </article>
      ) : (
        <p class="master-empty">WhatsApp se habilitará después de probar, aprobar y publicar la APK candidata.</p>
      )}

      <p class="master-form-alert" data-app-whatsapp-alert hidden></p>
      <div class="master-app-build-actions">
        <button
          class="master-btn master-btn--primary"
          type="button"
          data-app-whatsapp-preview
          data-artifact-id={latestApk?.id || ''}
          disabled={!whatsappReady}
        ><MasterIcon name="eye" size={18} /> Vista previa del mensaje</button>
      </div>

      <section class="master-app-whatsapp__preview" data-app-whatsapp-preview-card hidden>
        <header>
          <div><span>Vista previa</span><strong>WhatsApp no se ha abierto todavía</strong></div>
          <span class="master-pill master-pill--warning">Revisión obligatoria</span>
        </header>
        <textarea rows="15" readonly data-app-whatsapp-message aria-label="Vista previa del mensaje de WhatsApp"></textarea>
        <p data-app-whatsapp-sender-warning></p>
        <label class="master-app-build-confirm">
          <input type="checkbox" data-app-whatsapp-account-check /> Confirmo que la sesión abierta de WhatsApp corresponde al número oficial configurado en la sección Master.
        </label>
        <div class="master-app-whatsapp__preview-actions">
          <button class="master-btn master-btn--primary" type="button" data-app-whatsapp-open disabled><MasterIcon name="external" size={18} /> Abrir WhatsApp</button>
        </div>
        <div class="master-app-whatsapp__mark" data-app-whatsapp-mark-card hidden>
          <strong>Confirmación posterior</strong>
          <p>Marca el envío únicamente después de revisar el enlace, el checksum y presionar Enviar en WhatsApp.</p>
          <label><input type="checkbox" data-app-whatsapp-sent-check /> Confirmo que envié el mensaje con el enlace permanente y SHA-256 indicados.</label>
          <button class="master-btn" type="button" data-app-whatsapp-mark-sent disabled><MasterIcon name="check" size={18} /> Marcar como enviado</button>
        </div>
      </section>
    </div>
  </section>

  <section class="master-card" data-publication-only>
    <header class="master-card-header"><div><h2 class="master-card-title">Historial de trabajos</h2><p class="master-card-subtitle">La cola solo puede ejecutarla el runner Android privado.</p></div></header>
    <div class="master-card-body master-app-build-history">
      {jobs.length ? jobs.map((job) => (
        <article><div><strong>{job.operation === 'provision' ? 'Aprovisionamiento' : 'Actualización'}</strong><span>{dateTime(job.created)}</span>{job.status === 'succeeded' && <span>{job.delivery_status === 'marked_sent' ? `WhatsApp marcado como enviado · ${dateTime(job.delivery_marked_at)}` : 'Entrega al administrador pendiente'}</span>}</div><span class="master-pill">{statusLabels[job.status] || job.status}</span></article>
      )) : <p class="master-empty">Todavía no hay trabajos.</p>}
    </div>
  </section>

  <section class="master-card master-app-download-analytics" data-analytics-only>
    <header class="master-card-header">
      <div>
        <h2 class="master-card-title">Instalaciones y analítica</h2>
        <p class="master-card-subtitle">Historial completo por versión. Las pruebas Master permanecen separadas de la actividad de clientes.</p>
      </div>
      <span class:list={['master-pill', downloadAnalytics.available ? 'master-pill--success' : 'master-pill--warning']}>
        {downloadAnalytics.available ? 'Medición activa' : 'Medición pendiente'}
      </span>
    </header>
    <div class="master-card-body master-app-download-analytics__body">
      <div class="master-app-download-analytics__summary">
        <article><span>Descargas clientes</span><strong>{downloadSummary.customer_downloads.toLocaleString('es-US')}</strong><small>Enlace compartido + privadas.</small></article>
        <article><span>Descargas Master</span><strong>{downloadSummary.master_downloads.toLocaleString('es-US')}</strong><small>Pruebas, fuera del total cliente.</small></article>
        <article><span>Privadas verificadas</span><strong>{downloadSummary.verified_updates.toLocaleString('es-US')}</strong><small>APK validada por la app.</small></article>
        <article><span>Instalaciones confirmadas</span><strong>{downloadSummary.activated_installations.toLocaleString('es-US')}</strong><small>Dispositivos únicos que abrieron una versión.</small></article>
        <article><span>Activas estimadas</span><strong>{downloadSummary.active_installations.toLocaleString('es-US')}</strong><small>Actividad durante 30 días.</small></article>
        <article><span>Pendientes</span><strong>{downloadSummary.pending_installations.toLocaleString('es-US')}</strong><small>Por debajo de la publicación activa.</small></article>
        <article><span>Última actividad</span><strong>{downloadSummary.last_activity_at ? 'Registrada' : '—'}</strong><small>{activityDateTime(downloadSummary.last_activity_at)}</small></article>
      </div>
      {downloadAnalytics.versions.length ? (
        <div class="master-app-download-analytics__table-wrap">
          <table class="master-app-download-analytics__table">
            <thead><tr><th>Versión</th><th>Estado</th><th>Enlace/WhatsApp</th><th>Privadas</th><th>Verificadas</th><th>Instaladas</th><th>Activas</th><th>Pendientes</th><th>Master</th><th>Total general</th><th>Última actividad</th></tr></thead>
            <tbody>
              {downloadAnalytics.versions.map((item) => (
                <tr>
                  <td><span class="master-app-download-analytics__version"><strong>{item.version_name}</strong><small>Código {item.version_code}</small></span></td>
                  <td>{item.release_status === 'published' ? 'Publicada' : item.release_status === 'approved' ? 'Aprobada' : item.release_status === 'candidate' ? 'Candidata' : 'Histórica'}</td>
                  <td>{item.shared_link_downloads.toLocaleString('es-US')}</td>
                  <td>{item.private_update_downloads.toLocaleString('es-US')}</td>
                  <td>{item.verified_updates.toLocaleString('es-US')}</td>
                  <td>{item.activated_installations.toLocaleString('es-US')}</td>
                  <td>{item.active_installations.toLocaleString('es-US')}</td>
                  <td>{item.pending_installations.toLocaleString('es-US')}</td>
                  <td>{item.master_downloads.toLocaleString('es-US')}</td>
                  <td>{item.all_downloads.toLocaleString('es-US')}</td>
                  <td>{activityDateTime(item.last_activity_at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : <p class="master-empty">La lista comenzará cuando exista una versión administrada o una instalación activa.</p>}
      <p class="master-app-download-analytics__note">{downloadAnalytics.measurement_note}</p>
    </div>
  </section>

  <section class="master-card master-app-health" data-health-only>
    <header class="master-card-header">
      <div>
        <h2 class="master-card-title">Estado y diagnóstico</h2>
        <p class="master-card-subtitle">Salud técnica de los canales Android y de cada instalación, actualizada automáticamente cada minuto.</p>
      </div>
      <span class:list={['master-pill', healthPill(appHealth.overall_status)]}>
        {healthLabel(appHealth.overall_status)}
      </span>
    </header>
    <div class="master-card-body master-app-health__body">
      <div class="master-app-health__toolbar">
        <div>
          <strong>Última comprobación: {dateTime(appHealth.generated_at)}</strong>
          <span>Actividad reciente: últimas {appHealth.fresh_window_hours} horas · telemetría conservada {appHealth.retention_days} días.</span>
        </div>
        <a class="master-btn master-btn--secondary" href={`/master/stores/${store.id}/app?channel=health`}>
          <MasterIcon name="analytics" size={17} /> Actualizar ahora
        </a>
      </div>

      {!appHealth.available ? (
        <div class="master-app-health__empty" role="status">
          <MasterIcon name="alert" size={24} />
          <div><strong>La telemetría detallada todavía no está disponible</strong><span>Las instalaciones continuarán funcionando; vuelve a comprobar después de desplegar el backend actualizado.</span></div>
        </div>
      ) : (
        <>
          <div class="master-app-health__summary" aria-label="Resumen del diagnóstico Android">
            <article><span>Mostradas</span><strong>{healthSummary.total.toLocaleString('es-US')}</strong><small>{healthSummary.active} activas en esta vista</small></article>
            <article><span>Recientes</span><strong>{healthSummary.recent.toLocaleString('es-US')}</strong><small>Actividad en 30 días</small></article>
            <article><span>Saludables</span><strong>{healthSummary.healthy.toLocaleString('es-US')}</strong><small>Sin fallos activos</small></article>
            <article><span>Con avisos</span><strong>{healthSummary.warning.toLocaleString('es-US')}</strong><small>Requieren observación</small></article>
            <article><span>Críticas</span><strong>{healthSummary.critical.toLocaleString('es-US')}</strong><small>Requieren soporte</small></article>
            <article><span>Monitoreadas</span><strong>{healthSummary.monitored.toLocaleString('es-US')}</strong><small>Con telemetría nueva</small></article>
          </div>

          <section class="master-app-health__services" aria-labelledby="app-health-services-title">
            <div class="master-app-health__section-heading">
              <div><h3 id="app-health-services-title">Servicios de la aplicación</h3><p>Un acelerador con avisos no invalida el canal nativo ni el registro de instalaciones.</p></div>
            </div>
            <div class="master-app-health__service-grid">
              {appHealth.services.map((service) => (
                <article class:list={['master-app-health__service', `is-${service.status}`]}>
                  <header>
                    <span class="master-app-health__service-icon">
                      <MasterIcon name={service.status === 'healthy' ? 'check' : service.status === 'critical' ? 'close' : service.status === 'warning' ? 'alert' : 'clock'} size={19} />
                    </span>
                    <div><strong>{service.label}</strong><small>{healthImportance(service.importance)}</small></div>
                    <span class:list={['master-pill', healthPill(service.status)]}>{healthLabel(service.status)}</span>
                  </header>
                  <p>{service.detail}</p>
                  <time datetime={service.checked_at}>Comprobado {dateTime(service.checked_at)}</time>
                </article>
              ))}
            </div>
          </section>

          <section class="master-app-health__devices" aria-labelledby="app-health-devices-title">
            <div class="master-app-health__section-heading">
              <div><h3 id="app-health-devices-title">Instalaciones observadas</h3><p>Las referencias sirven para soporte y no contienen el UUID real del teléfono.</p></div>
              <span class="master-pill master-pill--info">Hasta 100 recientes</span>
            </div>
            {appHealth.installations.length ? (
              <div class="master-app-health__table-wrap">
                <table class="master-app-health__table">
                  <thead>
                    <tr><th>Dispositivo</th><th>Estado</th><th>Versión</th><th>Backend</th><th>Firebase / FCM</th><th>Permiso</th><th>Último contacto</th><th>Push / error</th></tr>
                  </thead>
                  <tbody>
                    {appHealth.installations.map((installation) => (
                      <tr>
                        <td>
                          <span class="master-app-health__device">
                            <strong>{installation.device_model}</strong>
                            <code>{installation.support_ref}</code>
                            <small>{installation.country_code || 'País no confirmado'}{installation.region_code ? ` · ${installation.region_code}` : ''}</small>
                          </span>
                        </td>
                        <td><span class:list={['master-pill', healthPill(installation.health_status)]}>{healthLabel(installation.health_status)}</span><small class="master-app-health__substatus">{installation.monitoring_active ? 'Telemetría activa' : 'Telemetría anterior'}</small></td>
                        <td><strong>{installation.app_version || 'Sin dato'} ({installation.app_version_code || '—'})</strong><small class="master-app-health__substatus">Android {installation.android_version || 'sin dato'}</small></td>
                        <td><span class:list={['master-pill', healthPill(installation.backend_status)]}>API {healthLabel(installation.backend_status)}</span><small class="master-app-health__substatus">Registro {healthLabel(installation.registration_status).toLowerCase()}</small></td>
                        <td><strong>{firebaseLabel(installation.firebase_status)}</strong><small class="master-app-health__substatus">Registro FCM (FID) {installation.fcm_registration_present ? 'presente' : 'no presente'} · {installation.identity_source === 'app_uuid' ? 'UUID propio' : installation.identity_source === 'firebase_fid' ? 'Identidad Firebase anterior' : 'Migrada'}</small></td>
                        <td><span class:list={['master-pill', installation.notification_permission === 'granted' ? 'master-pill--success' : installation.notification_permission === 'denied' ? 'master-pill--warning' : '']}>{permissionLabel(installation.notification_permission)}</span></td>
                        <td><strong>{activityDateTime(installation.last_contact_at)}</strong><small class="master-app-health__substatus">Sync {healthLabel(installation.native_sync_status).toLowerCase()}</small></td>
                        <td>
                          <strong>{installation.last_push_at ? dateTime(installation.last_push_at) : 'Sin push confirmado'}</strong>
                          <small class:list={['master-app-health__substatus', { 'is-error': installation.last_error?.active }]}>{
                            installation.last_error
                              ? `${installation.last_error.active ? 'Error activo' : 'Recuperado'}: ${installation.last_error.code}`
                              : 'Sin errores registrados'
                          }</small>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : <p class="master-empty">No existen instalaciones registradas para esta tienda.</p>}
          </section>

          <div class="master-app-health__privacy" role="note">
            <MasterIcon name="lock" size={20} />
            <span>{appHealth.privacy_note} El estado cambia únicamente cuando la APK puede comunicarse; “sin datos” no equivale automáticamente a una caída.</span>
          </div>
        </>
      )}
    </div>
  </section>

  <section class="master-card" data-publication-only>
    <header class="master-card-header"><div><h2 class="master-card-title">Artefactos registrados</h2><p class="master-card-subtitle">Los archivos privados no se almacenan en Git.</p></div></header>
    <div class="master-card-body master-app-build-history">
      {artifacts.length ? artifacts.map((artifact) => (
        <article><div><strong>{artifact.file_name}</strong><span>SHA-256 {artifact.sha256}</span>{artifact.master_download_path && <button class="master-btn" type="button" data-app-master-download data-download-path={artifact.master_download_path} data-file-name={artifact.file_name}><MasterIcon name="download" size={16} /> Descargar esta versión</button>}</div><span class="master-pill">{artifact.lifecycle_status === 'staged' ? 'Subida en validación' : artifact.lifecycle_status === 'deleted' ? 'Eliminado' : artifact.lifecycle_status === 'deletion_queued' ? 'Eliminación pendiente' : artifact.visibility === 'store_delivery' ? 'Entregable' : 'Solo Master'}</span></article>
      )) : <p class="master-empty">No hay artefactos generados.</p>}
    </div>
  </section>
</section>

<script>
  import PocketBase from 'pocketbase';
  import {
    adoptExistingMasterStoreApp,
    cancelMasterStoreAppBuild,
    confirmMasterStoreAppBuild,
    downloadMasterStoreAppArtifact,
    getMasterAppBuildErrorMessage,
    markMasterStoreAppWhatsappSent,
    previewMasterStoreAppBuild,
    previewMasterStoreAppWhatsappDelivery,
    retryMasterStoreAppBuild,
    runMasterStoreAppAdminAction,
    runMasterStoreAppReleaseAction,
    startMasterStoreAppRunner,
  } from '../../lib/masterStoreAppBuilds';

  function initializeStoreAppBuildPanel() {
    const root = document.querySelector<HTMLElement>('[data-store-app-build]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);
    pb.authStore.loadFromCookie(document.cookie, 'pb_auth');
    pb.autoCancellation(false);
    const storeId = String(root.dataset.storeId || '');
    const profileId = String(root.dataset.profileId || '');
    const buildActionsAllowed = root.dataset.buildActionsAllowed === 'true';
    const engineReleaseReady = root.dataset.engineReleaseReady === 'true';
    let previewEngineReady = root.dataset.previewEngineReady === 'true';
    const previewCard = root.querySelector<HTMLElement>('[data-app-preview-card]');
    const previewJson = root.querySelector<HTMLElement>('[data-app-preview-json]');
    const previewHash = root.querySelector<HTMLElement>('[data-app-preview-hash]');
    const previewCollapsed = root.querySelector<HTMLElement>('[data-app-preview-collapsed]');
    const previewCollapsedHash = root.querySelector<HTMLElement>('[data-app-preview-collapsed-hash]');
    const previewOpenButton = root.querySelector<HTMLButtonElement>('[data-app-preview-open]');
    const previewCloseButton = root.querySelector<HTMLButtonElement>('[data-app-preview-close]');
    const confirmCheck = root.querySelector<HTMLInputElement>('[data-app-confirm-check]');
    const confirmButton = root.querySelector<HTMLButtonElement>('[data-app-confirm]');
    const confirmAlert = root.querySelector<HTMLElement>('[data-app-confirm-alert]');
    const whatsappAlert = root.querySelector<HTMLElement>('[data-app-whatsapp-alert]');
    const whatsappPreviewButton = root.querySelector<HTMLButtonElement>('[data-app-whatsapp-preview]');
    const whatsappPreviewCard = root.querySelector<HTMLElement>('[data-app-whatsapp-preview-card]');
    const whatsappMessage = root.querySelector<HTMLTextAreaElement>('[data-app-whatsapp-message]');
    const whatsappSenderWarning = root.querySelector<HTMLElement>('[data-app-whatsapp-sender-warning]');
    const whatsappAccountCheck = root.querySelector<HTMLInputElement>('[data-app-whatsapp-account-check]');
    const whatsappOpenButton = root.querySelector<HTMLButtonElement>('[data-app-whatsapp-open]');
    const whatsappMarkCard = root.querySelector<HTMLElement>('[data-app-whatsapp-mark-card]');
    const whatsappSentCheck = root.querySelector<HTMLInputElement>('[data-app-whatsapp-sent-check]');
    const whatsappMarkButton = root.querySelector<HTMLButtonElement>('[data-app-whatsapp-mark-sent]');
    const cancelJobButton = root.querySelector<HTMLButtonElement>('[data-app-cancel-job]');
    const cancelJobAlert = root.querySelector<HTMLElement>('[data-app-cancel-alert]');
    const runnerStartButton = root.querySelector<HTMLButtonElement>('[data-app-runner-start]');
    const runnerAlert = root.querySelector<HTMLElement>('[data-app-runner-alert]');
    const adminAlert = root.querySelector<HTMLElement>('[data-app-admin-alert]');
    const releaseAlert = root.querySelector<HTMLElement>('[data-app-release-alert]');
    const previewDismissalKey = `pz-master-app-preview-closed:${storeId}`;
    let currentWhatsappPreview: any = null;
    if (root.dataset.runnerWatch === 'true') {
      window.setTimeout(() => window.location.reload(), 15_000);
    }
    if (root.dataset.healthWatch === 'true') {
      const refreshHealth = () => {
        if (!root.isConnected || root.dataset.healthWatch !== 'true') return;
        if (document.visibilityState === 'visible') {
          window.location.reload();
          return;
        }
        window.setTimeout(refreshHealth, 30_000);
      };
      window.setTimeout(refreshHealth, 60_000);
    }

    const setAlert = (element: HTMLElement | null, message = '') => {
      if (!element) return;
      element.textContent = message;
      element.hidden = !message;
    };
    const previewToken = () => {
      const jobId = String(confirmButton?.dataset.jobId || '');
      const hash = String(previewHash?.textContent || '').trim();
      return jobId && hash ? `${jobId}:${hash}` : '';
    };
    const readPreviewDismissal = () => {
      try { return window.sessionStorage.getItem(previewDismissalKey) || ''; } catch { return ''; }
    };
    const savePreviewDismissal = (token: string) => {
      try { window.sessionStorage.setItem(previewDismissalKey, token); } catch { /* Preferencia visual opcional. */ }
    };
    const clearPreviewDismissal = () => {
      try { window.sessionStorage.removeItem(previewDismissalKey); } catch { /* Preferencia visual opcional. */ }
    };
    const resetPreviewConfirmation = () => {
      if (confirmCheck) confirmCheck.checked = false;
      if (confirmButton) confirmButton.disabled = true;
      setAlert(confirmAlert);
    };
    const collapsePreview = (persist: boolean, moveFocus: boolean) => {
      const token = previewToken();
      if (!previewCard || !previewCollapsed || !token) return;
      previewCard.hidden = true;
      previewCollapsed.hidden = false;
      if (previewCollapsedHash) previewCollapsedHash.textContent = `SHA-256 ${String(previewHash?.textContent || '').trim()}`;
      resetPreviewConfirmation();
      if (persist) savePreviewDismissal(token);
      if (moveFocus) previewOpenButton?.focus({ preventScroll: true });
    };
    const openPreview = (moveFocus: boolean) => {
      if (!previewCard || !previewCollapsed || !previewToken()) return;
      clearPreviewDismissal();
      previewCollapsed.hidden = true;
      previewCard.hidden = false;
      resetPreviewConfirmation();
      if (moveFocus) {
        previewCloseButton?.focus({ preventScroll: true });
        previewCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };
    const showPreview = (job: any) => {
      if (!previewCard || !previewJson || !previewHash || !confirmButton) return;
      previewEngineReady = true;
      if (confirmCheck) confirmCheck.disabled = false;
      clearPreviewDismissal();
      previewJson.textContent = JSON.stringify(job.preview, null, 2);
      previewHash.textContent = job.preview_hash;
      if (previewCollapsedHash) previewCollapsedHash.textContent = `SHA-256 ${job.preview_hash}`;
      confirmButton.dataset.jobId = job.id;
      confirmButton.dataset.mode = 'confirm';
      if (previewCollapsed) previewCollapsed.hidden = true;
      resetPreviewConfirmation();
      previewCard.hidden = false;
      previewCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const submitPreview = async (form: HTMLFormElement, body: Record<string, unknown>) => {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const alert = form.querySelector<HTMLElement>('[data-app-form-alert]');
      setAlert(alert);
      if (button) button.disabled = true;
      const result = await previewMasterStoreAppBuild(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, body as any);
      if (result.data) showPreview(result.data);
      else setAlert(alert, getMasterAppBuildErrorMessage(result.error));
      if (button) button.disabled = !engineReleaseReady || !buildActionsAllowed;
    };

    root.querySelectorAll<HTMLFormElement>('[data-app-brand-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const alert = form.querySelector<HTMLElement>('[data-app-brand-alert]');
        const file = fileInput?.files?.[0] || null;
        if (!file) return;
        setAlert(alert);
        if (button) button.disabled = true;
        if (fileInput) fileInput.disabled = true;
        const payload = new FormData();
        payload.append('store_id', storeId);
        payload.append('kind', String(form.dataset.kind || ''));
        payload.append('file', file, file.name);
        try {
          const response = await fetch('/api/master/store-app-brand-assets', {
            method: 'POST', body: payload, credentials: 'same-origin', headers: { Accept: 'application/json' },
          });
          const result = await response.json().catch(() => null);
          if (!response.ok || result?.ok !== true) {
            setAlert(alert, getMasterAppBuildErrorMessage(String(result?.error || 'brand_asset_upload_failed')));
            if (button) button.disabled = false;
            if (fileInput) fileInput.disabled = false;
            return;
          }
          window.location.reload();
        } catch {
          setAlert(alert, 'No se pudo convertir y guardar la imagen. Inténtalo nuevamente.');
          if (button) button.disabled = false;
          if (fileInput) fileInput.disabled = false;
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-app-admin-action]').forEach((button) => {
      button.addEventListener('click', async () => {
        const action = String(button.dataset.appAdminAction || '') as 'withdraw' | 'reactivate' | 'delete_artifacts' | 'delete_app' | 'recover_app';
        let confirmation = '';
        if (action === 'withdraw' && !window.confirm('Retirar la distribución Android bloqueará las descargas, pero conservará archivos, Firebase, firma e identidad. ¿Continuar?')) return;
        if (action === 'reactivate' && !window.confirm('Reactivar la distribución volverá a permitir las descargas Android. La tienda web no cambiará. ¿Continuar?')) return;
        if (action === 'delete_artifacts') {
          confirmation = window.prompt('Esta acción eliminará físicamente los APK/AAB y conservará Firebase, firma e identidad. Escribe ELIMINAR ARTEFACTOS') || '';
          if (confirmation !== 'ELIMINAR ARTEFACTOS') {
            if (confirmation) setAlert(adminAlert, 'La confirmación escrita no coincide exactamente.');
            return;
          }
        }
        if (action === 'delete_app') {
          const expected = String(button.dataset.deleteConfirmation || '');
          confirmation = window.prompt(`La app quedará retirada y podrá recuperarse durante 30 días. Escribe exactamente: ${expected}`) || '';
          if (!expected || confirmation !== expected) {
            if (confirmation) setAlert(adminAlert, 'La confirmación escrita no coincide exactamente con el paquete.');
            return;
          }
        }
        if (action === 'recover_app') {
          confirmation = window.prompt('Escribe RECUPERAR APP para cancelar la eliminación. La distribución seguirá retirada hasta reactivarla.') || '';
          if (confirmation !== 'RECUPERAR APP') return;
        }
        const reason = window.prompt('Motivo administrativo (opcional):') ?? '';
        setAlert(adminAlert);
        const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-app-admin-action]')];
        const enabled = buttons.filter((item) => !item.disabled);
        buttons.forEach((item) => { item.disabled = true; });
        const result = await runMasterStoreAppAdminAction(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, {
          store_id: storeId, action, confirmation, reason,
        });
        if (result.data) window.location.reload();
        else {
          setAlert(adminAlert, getMasterAppBuildErrorMessage(result.error));
          enabled.forEach((item) => { item.disabled = false; });
        }
      });
    });

    cancelJobButton?.addEventListener('click', async () => {
      const jobId = String(cancelJobButton.dataset.jobId || '');
      if (!jobId || !window.confirm('Este trabajo todavía no fue ejecutado. ¿Quieres cancelarlo para configurar el icono y el splash?')) return;
      cancelJobButton.disabled = true;
      setAlert(cancelJobAlert);
      const result = await cancelMasterStoreAppBuild(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, {
        job_id: jobId,
        confirmation: 'CANCELAR TRABAJO',
      });
      if (result.data) window.location.reload();
      else {
        setAlert(cancelJobAlert, getMasterAppBuildErrorMessage(result.error));
        cancelJobButton.disabled = false;
      }
    });

    runnerStartButton?.addEventListener('click', async () => {
      const jobId = String(runnerStartButton.dataset.jobId || '');
      const hash = String(runnerStartButton.dataset.previewHash || '');
      if (!jobId || !hash || !window.confirm(
        `Se autorizará durante 10 minutos una sola ejecución para el trabajo ${jobId}. Después debes abrir el acceso directo del runner en la PC. Solo podrá usar la vista previa SHA-256 ${hash}. ¿Continuar?`,
      )) return;
      runnerStartButton.disabled = true;
      setAlert(runnerAlert);
      const result = await startMasterStoreAppRunner(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, {
        job_id: jobId,
        preview_hash: hash,
        confirmation: 'INICIAR RUNNER PRIVADO',
      });
      if (result.data) window.location.reload();
      else {
        setAlert(runnerAlert, getMasterAppBuildErrorMessage(result.error));
        runnerStartButton.disabled = false;
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-app-master-download]').forEach((button) => {
      button.addEventListener('click', async () => {
        const downloadPath = String(button.dataset.downloadPath || '');
        const fileName = String(button.dataset.fileName || '');
        if (!downloadPath || !fileName) return;
        const enabledButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-app-master-download]')]
          .filter((item) => !item.disabled);
        enabledButtons.forEach((item) => { item.disabled = true; });
        setAlert(releaseAlert);
        const result = await downloadMasterStoreAppArtifact(
          import.meta.env.PUBLIC_POCKETBASE_URL,
          pb.authStore.token,
          { master_download_path: downloadPath, file_name: fileName },
        );
        if (result.data) {
          const objectUrl = URL.createObjectURL(result.data.blob);
          const link = document.createElement('a');
          link.href = objectUrl;
          link.download = result.data.fileName;
          document.body.append(link);
          link.click();
          link.remove();
          window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
        } else {
          setAlert(releaseAlert, getMasterAppBuildErrorMessage(result.error));
        }
        enabledButtons.forEach((item) => { item.disabled = false; });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-app-release-action]').forEach((button) => {
      button.addEventListener('click', async () => {
        const action = String(button.dataset.appReleaseAction || '') as
          | 'discard_candidate' | 'approve_candidate' | 'publish_candidate' | 'require_update' | 'optional_update'
          | 'pause_update' | 'resume_update' | 'withdraw_update';
        const artifactId = String(button.dataset.artifactId || '');
        const contracts = {
          discard_candidate: ['DESCARTAR APK CANDIDATA', 'La candidata quedará privada como histórico y podrás crear otra versión. La publicación actual no cambiará. ¿Descartarla?'],
          approve_candidate: ['APROBAR APK CLIENTES', 'Confirma que descargaste e instalaste esta misma APK y que la prueba fue satisfactoria. ¿Marcarla como aprobada?'],
          publish_candidate: ['PUBLICAR APK CLIENTES', 'Se publicará esta misma APK como actualización opcional. ¿Continuar?'],
          require_update: ['EXIGIR ACTUALIZACION CLIENTES', 'Las versiones anteriores quedarán bloqueadas hasta actualizar. ¿Hacer obligatoria esta versión?'],
          optional_update: ['HACER OPCIONAL ACTUALIZACION CLIENTES', 'La app volverá a permitir posponer esta actualización. ¿Continuar?'],
          pause_update: ['PAUSAR ACTUALIZACION CLIENTES', 'Se pausarán de inmediato las nuevas descargas y se desactivará cualquier obligación. ¿Continuar?'],
          resume_update: ['REANUDAR ACTUALIZACION CLIENTES', '¿Reanudar las descargas privadas de esta publicación?'],
          withdraw_update: ['RETIRAR ACTUALIZACION CLIENTES', 'Esta publicación quedará retirada definitivamente; las apps instaladas no se borrarán. ¿Continuar?'],
        } as const;
        const contract = contracts[action];
        if (!contract) return;
        const [confirmation, question] = contract;
        if (!artifactId || !window.confirm(question)) return;
        const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-app-release-action]')];
        buttons.forEach((item) => { item.disabled = true; });
        setAlert(releaseAlert);
        const result = await runMasterStoreAppReleaseAction(
          import.meta.env.PUBLIC_POCKETBASE_URL,
          pb.authStore.token,
          { store_id: storeId, artifact_id: artifactId, action, confirmation },
        );
        if (result.data) window.location.reload();
        else {
          setAlert(releaseAlert, getMasterAppBuildErrorMessage(result.error));
          buttons.forEach((item) => { item.disabled = false; });
        }
      });
    });

    root.querySelector<HTMLFormElement>('[data-app-adopt-form]')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (!form.reportValidity()) return;
      if (!window.confirm('Se registrará la identidad exacta de PowerZona 0.2.8 sin construir ni publicar una APK. ¿Continuar?')) return;
      const values = new FormData(form);
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const alert = form.querySelector<HTMLElement>('[data-app-form-alert]');
      if (button) button.disabled = true;
      setAlert(alert);
      const result = await adoptExistingMasterStoreApp(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, {
        store_id: storeId,
        app_key: String(values.get('app_key') || ''),
        brand_key: String(values.get('brand_key') || ''),
        display_name: String(values.get('display_name') || ''),
        include_aab: true,
        firebase_project_id: String(values.get('firebase_project_id') || ''),
        package_name: String(values.get('package_name') || ''),
        store_url: String(values.get('store_url') || ''),
        current_version_code: Number(values.get('current_version_code')),
        current_version_name: String(values.get('current_version_name') || ''),
        signing_cert_sha256: String(values.get('signing_cert_sha256') || ''),
        confirmation: 'ADOPTAR APP EXISTENTE',
      });
      if (result.data) window.location.reload();
      else {
        setAlert(alert, getMasterAppBuildErrorMessage(result.error));
        if (button) button.disabled = false;
      }
    });

    root.querySelector<HTMLFormElement>('[data-app-provision-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (!form.reportValidity()) return;
      const values = new FormData(form);
      submitPreview(form, {
        store_id: storeId,
        operation: 'provision',
        app_key: values.get('app_key'),
        brand_key: values.get('brand_key'),
        display_name: values.get('display_name'),
        include_aab: values.get('include_aab') === 'on',
        firebase_project_id: values.get('firebase_project_id'),
        package_name: values.get('package_name'),
        store_url: values.get('store_url'),
        version_code: Number(values.get('version_code')),
        version_name: values.get('version_name'),
      });
    });
    root.querySelector<HTMLFormElement>('[data-app-update-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (!form.reportValidity()) return;
      const values = new FormData(form);
      submitPreview(form, {
        store_id: storeId,
        operation: 'update',
        profile_id: profileId,
        display_name: String(values.get('display_name') || ''),
        include_aab: form.querySelector<HTMLInputElement>('[name="include_aab"]')?.checked === true,
        version_code: Number(values.get('version_code')),
        version_name: values.get('version_name'),
      });
    });
    confirmCheck?.addEventListener('change', () => {
      if (confirmButton) confirmButton.disabled = !previewEngineReady || confirmCheck.checked !== true;
    });
    if (previewToken() && readPreviewDismissal() === previewToken()) collapsePreview(false, false);
    previewCloseButton?.addEventListener('click', () => collapsePreview(true, true));
    previewOpenButton?.addEventListener('click', () => openPreview(true));
    confirmButton?.addEventListener('click', async () => {
      if (!previewEngineReady || !confirmCheck?.checked || !previewHash?.textContent || !confirmButton.dataset.jobId) return;
      confirmButton.disabled = true;
      setAlert(confirmAlert);
      const action = confirmButton.dataset.mode === 'retry' ? retryMasterStoreAppBuild : confirmMasterStoreAppBuild;
      const result = await action(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, {
        job_id: confirmButton.dataset.jobId,
        preview_hash: previewHash.textContent.trim(),
      });
      if (result.data) window.location.reload();
      else {
        setAlert(confirmAlert, getMasterAppBuildErrorMessage(result.error));
        confirmButton.disabled = false;
      }
    });

    whatsappPreviewButton?.addEventListener('click', async () => {
      const artifactId = String(whatsappPreviewButton.dataset.artifactId || '');
      if (!artifactId) return;
      whatsappPreviewButton.disabled = true;
      setAlert(whatsappAlert);
      const result = await previewMasterStoreAppWhatsappDelivery(
        import.meta.env.PUBLIC_POCKETBASE_URL,
        pb.authStore.token,
        { store_id: storeId, artifact_id: artifactId },
      );
      if (!result.data) {
        setAlert(whatsappAlert, getMasterAppBuildErrorMessage(result.error));
        whatsappPreviewButton.disabled = false;
        return;
      }
      currentWhatsappPreview = result.data.preview;
      if (whatsappMessage) whatsappMessage.value = currentWhatsappPreview.message;
      if (whatsappSenderWarning) whatsappSenderWarning.textContent = currentWhatsappPreview.sender_warning;
      if (whatsappAccountCheck) whatsappAccountCheck.checked = false;
      if (whatsappOpenButton) whatsappOpenButton.disabled = true;
      if (whatsappSentCheck) whatsappSentCheck.checked = false;
      if (whatsappMarkButton) whatsappMarkButton.disabled = true;
      if (whatsappMarkCard) whatsappMarkCard.hidden = true;
      if (whatsappPreviewCard) {
        whatsappPreviewCard.hidden = false;
        whatsappPreviewCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      whatsappPreviewButton.disabled = false;
    });

    whatsappAccountCheck?.addEventListener('change', () => {
      if (whatsappOpenButton) whatsappOpenButton.disabled = !currentWhatsappPreview || whatsappAccountCheck.checked !== true;
    });
    whatsappOpenButton?.addEventListener('click', () => {
      if (!currentWhatsappPreview || whatsappAccountCheck?.checked !== true) return;
      window.open(currentWhatsappPreview.whatsapp_url, '_blank', 'noopener,noreferrer');
      if (whatsappMarkCard) whatsappMarkCard.hidden = false;
    });
    whatsappSentCheck?.addEventListener('change', () => {
      if (whatsappMarkButton) whatsappMarkButton.disabled = !currentWhatsappPreview || whatsappSentCheck.checked !== true;
    });
    whatsappMarkButton?.addEventListener('click', async () => {
      if (!currentWhatsappPreview || whatsappSentCheck?.checked !== true) return;
      whatsappMarkButton.disabled = true;
      setAlert(whatsappAlert);
      const result = await markMasterStoreAppWhatsappSent(
        import.meta.env.PUBLIC_POCKETBASE_URL,
        pb.authStore.token,
        {
          store_id: storeId,
          artifact_id: currentWhatsappPreview.artifact_id,
          message_sha256: currentWhatsappPreview.message_sha256,
          confirmation: 'MARCAR ENVIADO',
        },
      );
      if (result.data) window.location.reload();
      else {
        setAlert(whatsappAlert, getMasterAppBuildErrorMessage(result.error));
        whatsappMarkButton.disabled = false;
      }
    });
  }
  document.addEventListener('astro:page-load', initializeStoreAppBuildPanel);
  initializeStoreAppBuildPanel();
</script>

