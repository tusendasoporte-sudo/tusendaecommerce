---
import MasterIcon from './MasterIcon.astro';
import StorePlanIndicator from '../shared/StorePlanIndicator.astro';
import type { StorePlanPresentation } from '../../lib/storePlanPresentation';

interface Props {
  store: {
    id: string;
    name: string;
    slug: string;
    status: 'active' | 'suspended';
    featured: boolean;
    security_label: string;
  };
  planPresentation: StorePlanPresentation;
}

const { store, planPresentation } = Astro.props;

function initials(value: string) {
  return value.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase() || '').join('') || 'TS';
}
---

<header class="master-store-heading">
  <div class="master-store-heading__identity">
    <span class="master-store-heading__avatar" aria-hidden="true">{initials(store.name)}</span>
    <div class="master-store-heading__copy">
      <div class="master-store-heading__title-row">
        <h2>{store.name}</h2>
        <span class:list={['master-pill', store.status === 'active' ? 'master-pill--success' : 'master-pill--danger']}>
          {store.status === 'active' ? 'Activa' : 'Suspendida'}
        </span>
        {store.featured && <span class="master-pill master-pill--warning">Destacada</span>}
        <span class:list={['master-pill', store.security_label === 'Protección activa' ? 'master-pill--info' : '']} data-security-status-pill>
          <span data-security-status-label>
          {store.security_label}
          </span>
        </span>
        <StorePlanIndicator presentation={planPresentation} variant="master-header" />
      </div>
    </div>
  </div>
  <div class="master-store-heading__actions">
    <a class="master-btn master-btn--primary" href={`/t/${encodeURIComponent(store.slug)}/admin`}>
      <MasterIcon name="settings" size={19} /> Administrar tienda
    </a>
    <a class="master-btn master-btn--secondary" href={`/t/${encodeURIComponent(store.slug)}`} target="_blank" rel="noreferrer">
      <MasterIcon name="external" size={19} /> Ver tienda pública
    </a>
    <button class="master-btn master-btn--secondary" type="button" data-action-edit-store>
      <MasterIcon name="edit" size={19} /> Editar tienda
    </button>
    <a class="master-btn master-btn--secondary" href={`/master/stores/${encodeURIComponent(store.id)}/users?create=1`}>
      <MasterIcon name="user-plus" size={19} /> Crear usuario
    </a>
    <button class="master-icon-btn" type="button" data-action-more aria-label="Más acciones" aria-haspopup="menu" aria-expanded="false">
      <MasterIcon name="more" size={21} />
    </button>
  </div>
</header>
