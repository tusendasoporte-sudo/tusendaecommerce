---
import MasterAnalyticsChart from './MasterAnalyticsChart.astro';
import type {
  MasterAnalyticsRange,
  MasterAnalyticsStore,
  MasterSellingProduct,
  MasterStoreAnalytics,
  MasterVisitedPage,
} from '../../lib/masterStoreAnalytics';

interface Props {
  analytics: MasterStoreAnalytics | null;
  store: MasterAnalyticsStore;
  currentRange: MasterAnalyticsRange;
  basePath: string;
  viewError?: string;
}

const { analytics, store, currentRange, basePath, viewError = '' } = Astro.props;
const rangeOptions: Array<[MasterAnalyticsRange, string]> = [
  ['today', 'Hoy'],
  ['7', '7 días'],
  ['15', '15 días'],
  ['30', '30 días'],
];
const statusLabels: Record<string, string> = {
  pending: 'Pendiente',
  confirmed: 'Confirmado',
  preparing: 'Preparando',
  delivered: 'Entregado',
  cancelled: 'Cancelado',
};
const deliveryLabels: Record<string, string> = {
  delivery: 'Domicilio',
  pickup: 'Recogida',
  coordinate: 'A coordinar',
};
const productStateLabels: Record<MasterSellingProduct['state'], string> = {
  available: 'Disponible',
  hidden: 'Oculto',
  sold_out: 'Agotado',
  deleted: 'Producto eliminado',
};

function formatNumber(value: unknown) {
  return new Intl.NumberFormat('es-US').format(Math.max(0, Number(value || 0)));
}

function formatUsd(value: unknown) {
  return new Intl.NumberFormat('es-US', { style: 'currency', currency: 'USD' }).format(Number(value || 0));
}

function formatDate(value: string) {
  if (!value) return 'Fecha no disponible';
  const date = new Date(value);
  if (!Number.isFinite(date.getTime())) return 'Fecha no disponible';
  return new Intl.DateTimeFormat('es', {
    timeZone: analytics?.time_zone || 'America/Havana',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(date).replace(/\./g, '');
}

function publicStorePath() {
  return store.slug ? `/t/${encodeURIComponent(store.slug)}` : '';
}

function productPath(product: { slug: string; active: boolean }) {
  return store.slug && product.active && product.slug
    ? `/t/${encodeURIComponent(store.slug)}/producto/${encodeURIComponent(product.slug)}`
    : '';
}

function rangeHref(range: MasterAnalyticsRange) {
  return `${basePath}?range=${encodeURIComponent(range)}`;
}

function pagesHref(page: number) {
  return `${basePath}?range=${encodeURIComponent(currentRange)}&pages_page=${page}#paginas-visitadas`;
}

function rankingWidth(value: number, max: number) {
  if (max <= 0) return 0;
  return Math.max(6, Math.round((value / max) * 100));
}

function pageKey(page: MasterVisitedPage, index: number) {
  return `${page.page_type}-${page.entity_id || index}`.replace(/[^a-z0-9-]/gi, '-');
}

const topViewedMax = Math.max(1, ...(analytics?.top_viewed_products || []).map((item) => item.views));
const topButtonMax = Math.max(1, ...(analytics?.landing_qr.top_buttons || []).map((item) => item.clicks));
const sellerMaxUnits = Math.max(1, ...(analytics?.top_selling_products_by_units || []).map((item) => item.units_sold));
const sellerMaxRevenue = Math.max(1, ...(analytics?.top_selling_products_by_revenue || []).map((item) => item.revenue_usd));
---

<main class="analytics-shell">
  <header class="analytics-hero">
    <div class="analytics-hero-copy">
      <span class="analytics-kicker">Analíticas</span>
      <div class="analytics-title-line">
        <h1>{store.name}</h1>
        <span class:list={['store-status', store.status === 'active' ? 'is-active' : 'is-suspended']}>
          {store.status === 'active' ? 'Activa' : 'Suspendida'}
        </span>
      </div>
      <p>Rendimiento privado de esta tienda</p>
    </div>
    <div class="analytics-hero-actions">
      <a class="secondary-action" href={`/master/stores/${encodeURIComponent(store.id)}`}>Volver al resumen</a>
      <a class="secondary-action" href={`/master/products/${encodeURIComponent(store.id)}`}>Ver productos</a>
      {publicStorePath() && <a class="primary-action" href={publicStorePath()}>Ver tienda</a>}
    </div>
  </header>

  <nav class="range-card" aria-label="Filtrar período de analíticas">
    <div>
      <strong>Período</strong>
      <span>Horario de Cuba · {analytics?.time_zone || 'America/Havana'}</span>
    </div>
    <div class="range-tabs">
      {rangeOptions.map(([value, label]) => (
        <a class:list={['range-tab', { 'is-active': currentRange === value }]} href={rangeHref(value)} aria-current={currentRange === value ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </div>
  </nav>

  {viewError && (
    <section class="analytics-error" role="alert">
      <strong>Analíticas temporalmente no disponibles</strong>
      <p>{viewError}</p>
    </section>
  )}

  {analytics ? (
    <>
      <section class="kpi-grid" aria-label="Métricas del período">
        <article class="kpi-card is-blue">
          <span>Visitantes</span>
          <strong>{formatNumber(analytics.metrics.visitors)}</strong>
          <small>Personas únicas con páginas vistas</small>
        </article>
        <article class="kpi-card is-violet">
          <span>Páginas vistas</span>
          <strong>{formatNumber(analytics.metrics.pageviews)}</strong>
          <small>Solo eventos pageview</small>
        </article>
        <article class="kpi-card is-slate">
          <span>Pedidos del período</span>
          <strong>{formatNumber(analytics.metrics.orders_period)}</strong>
          <small>Todos los estados</small>
        </article>
        <article class="kpi-card is-cyan">
          <span>Visitantes recurrentes</span>
          <strong>{formatNumber(analytics.metrics.recurrent_visitors)}</strong>
          <small>Dos o más sesiones</small>
        </article>
        <article class="kpi-card is-emerald">
          <span>Unidades vendidas</span>
          <strong>{formatNumber(analytics.metrics.sold_units)}</strong>
          <small>{formatUsd(analytics.metrics.product_revenue_usd)} en productos</small>
        </article>
      </section>

      <MasterAnalyticsChart
        chartId="master-traffic"
        title="Tráfico por día"
        description="Visitantes, páginas vistas y recurrencia dentro del período seleccionado."
        rows={analytics.daily}
        metrics={[
          { key: 'visitors', label: 'Visitantes', singular: 'visitante', plural: 'visitantes', color: '#2563eb' },
          { key: 'pageviews', label: 'Páginas vistas', singular: 'página vista', plural: 'páginas vistas', color: '#7c3aed' },
          { key: 'recurrent_visitors', label: 'Recurrentes', singular: 'recurrente', plural: 'recurrentes', color: '#0891b2' },
        ]}
      />

      <section class="orders-chart-grid">
        <MasterAnalyticsChart
          chartId="master-orders"
          title="Pedidos por día"
          description="Pedidos recibidos por fecha, sin excluir estados."
          rows={analytics.daily}
          metrics={[
            { key: 'orders', label: 'Pedidos', singular: 'pedido', plural: 'pedidos', color: '#059669' },
          ]}
        />
        <aside class="status-card" aria-label="Pedidos por estado">
          <div>
            <span>Distribución</span>
            <h2>Estados de pedidos</h2>
          </div>
          <div class="status-list">
            {Object.entries(analytics.order_statuses).map(([status, count]) => (
              <div class="status-row">
                <span class={`order-status is-${status}`}>{statusLabels[status] || status}</span>
                <strong>{formatNumber(count)}</strong>
              </div>
            ))}
          </div>
        </aside>
      </section>

      <section class="two-column-sections">
        <article class="section-card">
          <header class="section-head">
            <div>
              <span class="section-eyebrow">Interés</span>
              <h2>Productos más vistos</h2>
              <p>Máximo cinco productos con más páginas vistas.</p>
            </div>
          </header>
          {analytics.top_viewed_products.length ? (
            <div class="ranking-list">
              {analytics.top_viewed_products.map((product, index) => (
                <article class="ranking-row">
                  <span class="rank-number">{index + 1}</span>
                  <div class="ranking-copy">
                    <strong>{product.name}</strong>
                    <div class="ranking-bar" aria-hidden="true"><span style={`width:${rankingWidth(product.views, topViewedMax)}%`}></span></div>
                  </div>
                  <div class="ranking-value">
                    <strong>{formatNumber(product.views)}</strong>
                    <span>{product.views === 1 ? 'vista' : 'vistas'}</span>
                  </div>
                  {productPath(product) && <a class="row-action" href={productPath(product)}>Ver producto</a>}
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">Todavía no hay productos vistos en este período.</p>
          )}
        </article>

        <article class="section-card">
          <header class="section-head">
            <div>
              <span class="section-eyebrow">Landing QR</span>
              <h2>Actividad de enlaces</h2>
              <p>Visitas deduplicadas y clics por botón, sin exponer destinos.</p>
            </div>
          </header>
          <div class="landing-metrics">
            <div><span>Visitas</span><strong>{formatNumber(analytics.landing_qr.views)}</strong></div>
            <div><span>Clics</span><strong>{formatNumber(analytics.landing_qr.clicks)}</strong></div>
            <div><span>Más usado</span><strong>{analytics.landing_qr.top_buttons[0]?.link_label || 'Sin datos'}</strong></div>
          </div>
          {analytics.landing_qr.top_buttons.length ? (
            <div class="button-ranking">
              {analytics.landing_qr.top_buttons.map((button) => (
                <div class="button-row">
                  <div><strong>{button.link_label}</strong><span>{button.link_type || 'Enlace'}</span></div>
                  <div class="ranking-bar is-orange" aria-hidden="true"><span style={`width:${rankingWidth(button.clicks, topButtonMax)}%`}></span></div>
                  <strong>{formatNumber(button.clicks)}</strong>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-state">Todavía no hay clics en Landing QR para este período.</p>
          )}
        </article>
      </section>

      <section class="section-card selling-card" data-selling-card>
        <header class="section-head is-split">
          <div>
            <span class="section-eyebrow">Ventas confirmadas</span>
            <h2>Productos más vendidos</h2>
            <p>Confirmed, preparing y delivered; pending, cancelled y regalos quedan fuera.</p>
          </div>
          <div class="seller-tabs" role="tablist" aria-label="Ordenar productos vendidos">
            <button type="button" class="seller-tab is-active" role="tab" aria-selected="true" data-seller-tab="units">Más unidades</button>
            <button type="button" class="seller-tab" role="tab" aria-selected="false" data-seller-tab="revenue">Más ingresos</button>
          </div>
        </header>

        {(['units', 'revenue'] as const).map((rankingType, rankingIndex) => {
          const products = rankingType === 'units'
            ? analytics.top_selling_products_by_units
            : analytics.top_selling_products_by_revenue;
          const max = rankingType === 'units' ? sellerMaxUnits : sellerMaxRevenue;
          return (
            <div class="seller-panel" data-seller-panel={rankingType} hidden={rankingIndex !== 0}>
              {products.length ? (
                <div class="seller-list">
                  {products.map((product, index) => {
                    const barValue = rankingType === 'units' ? product.units_sold : product.revenue_usd;
                    return (
                      <article class="seller-row">
                        <span class="rank-number">{index + 1}</span>
                        <div class="seller-product">
                          <div class="seller-name-line">
                            <strong>{product.name}</strong>
                            <span class={`product-state is-${product.state}`}>{productStateLabels[product.state]}</span>
                          </div>
                          <div class="ranking-bar is-emerald" aria-hidden="true"><span style={`width:${rankingWidth(barValue, max)}%`}></span></div>
                          <small>{product.top_variation ? `Variación principal: ${product.top_variation} (${formatNumber(product.top_variation_units)})` : 'Sin variación registrada'}</small>
                        </div>
                        <dl class="seller-stats">
                          <div><dt>Unidades</dt><dd>{formatNumber(product.units_sold)}</dd></div>
                          <div><dt>Pedidos</dt><dd>{formatNumber(product.orders_count)}</dd></div>
                          <div><dt>Ingresos</dt><dd>{formatUsd(product.revenue_usd)}</dd></div>
                        </dl>
                        {productPath(product) && <a class="row-action" href={productPath(product)}>Ver producto</a>}
                      </article>
                    );
                  })}
                </div>
              ) : (
                <p class="empty-state">Todavía no hay ventas confirmadas en este período.</p>
              )}
            </div>
          );
        })}
      </section>

      <section class="section-card">
        <header class="section-head">
          <div>
            <span class="section-eyebrow">Actividad reciente</span>
            <h2>Pedidos recientes</h2>
            <p>Últimos 10 pedidos de la tienda, independientes del filtro de período.</p>
          </div>
        </header>
        {analytics.recent_orders.length ? (
          <div class="responsive-table orders-table">
            <div class="table-head orders-grid" aria-hidden="true">
              <span>Pedido</span><span>Cliente</span><span>Fecha</span><span>Estado</span><span>Total USD</span><span>Entrega</span><span>Acción</span>
            </div>
            {analytics.recent_orders.map((order) => (
              <article class="table-row orders-grid">
                <div data-label="Pedido"><strong>{order.order_number || order.id}</strong></div>
                <div data-label="Cliente"><span>{order.customer_name}</span></div>
                <div data-label="Fecha"><span>{formatDate(order.created)}</span></div>
                <div data-label="Estado"><span class={`order-status is-${order.status}`}>{statusLabels[order.status]}</span></div>
                <div data-label="Total USD"><strong>{formatUsd(order.usd_total)}</strong></div>
                <div data-label="Entrega"><span>{deliveryLabels[order.delivery_method]}</span></div>
                <div data-label="Acción"><a class="row-action" href={`${basePath}/orders/${encodeURIComponent(order.id)}`}>Ver pedido</a></div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state">Esta tienda todavía no tiene pedidos.</p>
        )}
      </section>

      <section class="section-card">
        <header class="section-head">
          <div>
            <span class="section-eyebrow">Tráfico</span>
            <h2>Páginas principales</h2>
            <p>Las cinco páginas públicas con más visitas en el período.</p>
          </div>
        </header>
        {analytics.top_pages.length ? (
          <div class="top-pages-grid">
            {analytics.top_pages.map((page, index) => (
              <article class="top-page-card">
                <span>{index + 1}</span>
                <div><strong>{page.name}</strong><small>{page.detail}</small></div>
                <strong>{formatNumber(page.visits)}</strong>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state">Todavía no hay páginas visitadas en este período.</p>
        )}
      </section>

      <section id="paginas-visitadas" class="section-card pages-card">
        <header class="section-head is-split">
          <div>
            <span class="section-eyebrow">Listado completo</span>
            <h2>Páginas visitadas</h2>
            <p>{formatNumber(analytics.pages.total_items)} páginas agrupadas · 10 por página.</p>
          </div>
          <span class="page-indicator">Página {analytics.pages.page} de {analytics.pages.total_pages}</span>
        </header>
        {analytics.pages.items.length ? (
          <div class="responsive-table pages-table">
            <div class="table-head pages-grid" aria-hidden="true">
              <span>Página</span><span>Detalle</span><span>Visitas</span><span>Última visita</span><span>Acción</span>
            </div>
            {analytics.pages.items.map((page, index) => {
              const key = pageKey(page, index);
              return (
                <article class="table-row pages-grid">
                  <div data-label="Página"><strong>{page.name}</strong></div>
                  <div data-label="Detalle"><span>{page.detail}</span></div>
                  <div data-label="Visitas"><strong>{formatNumber(page.visits)}</strong></div>
                  <div data-label="Última visita"><span>{formatDate(page.last_visited_at)}</span></div>
                  <div data-label="Acción">
                    {page.public_path ? (
                      <details class="route-details">
                        <summary class="row-action">Ver ruta</summary>
                        <div class="route-popover">
                          <code>{page.public_path}</code>
                          <div>
                            <button type="button" class="route-button" data-copy-route={page.public_path} data-copy-key={key}>Copiar ruta</button>
                            <a class="route-button is-primary" href={page.public_path}>Abrir página</a>
                          </div>
                        </div>
                      </details>
                    ) : (
                      <span class="route-unavailable">Ruta no disponible</span>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="empty-state">Todavía no hay páginas visitadas en este período.</p>
        )}
        <footer class="pagination">
          {analytics.pages.page > 1
            ? <a class="pagination-button" href={pagesHref(analytics.pages.page - 1)}>Anterior</a>
            : <span class="pagination-button is-disabled">Anterior</span>}
          <span>{analytics.pages.page} / {analytics.pages.total_pages}</span>
          {analytics.pages.page < analytics.pages.total_pages
            ? <a class="pagination-button" href={pagesHref(analytics.pages.page + 1)}>Siguiente</a>
            : <span class="pagination-button is-disabled">Siguiente</span>}
        </footer>
      </section>
    </>
  ) : (
    <section class="section-card unavailable-card">
      <h2>No se pudieron cargar las analíticas</h2>
      <p>La tienda sigue disponible en el Panel Master. Intenta nuevamente cuando PocketBase esté listo.</p>
      <a class="secondary-action" href={rangeHref(currentRange)}>Reintentar</a>
    </section>
  )}
</main>

<style>
  .analytics-shell { display: grid; gap: 18px; min-width: 0; padding: 6px 0 42px; color: #0f172a; }
  .analytics-hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; min-width: 0; overflow: hidden; border: 1px solid #dbeafe; border-radius: 18px; background: radial-gradient(circle at 90% 10%, rgba(96, 165, 250, .22), transparent 36%), linear-gradient(135deg, #fff 0%, #f8fafc 58%, #eff6ff 100%); padding: clamp(22px, 5vw, 38px); box-shadow: 0 20px 55px rgba(30, 64, 175, .08); }
  .analytics-hero-copy { display: grid; gap: 10px; min-width: 0; }
  .analytics-kicker, .section-eyebrow { width: max-content; max-width: 100%; color: #1d4ed8; font-size: var(--master-font-caption); font-weight: 950; letter-spacing: .08em; text-transform: uppercase; }
  .analytics-title-line { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; min-width: 0; }
  .analytics-title-line h1 { margin: 0; overflow-wrap: anywhere; font-size: var(--master-font-page-title); line-height: 1; font-weight: 1000; }
  .analytics-hero-copy p { margin: 0; color: #475569; font-size: var(--master-font-body); font-weight: 750; }
  .store-status, .order-status, .product-state { display: inline-flex; align-items: center; width: max-content; border-radius: 999px; border: 1px solid; padding: 6px 9px; font-size: var(--master-font-caption); line-height: 1; font-weight: 950; white-space: nowrap; }
  .store-status.is-active { border-color: #a7f3d0; background: #ecfdf5; color: #047857; }
  .store-status.is-suspended { border-color: #fecaca; background: #fff1f2; color: #be123c; }
  .analytics-hero-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 9px; }
  .primary-action, .secondary-action, .row-action, .pagination-button, .route-button { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; border-radius: 10px; padding: 10px 14px; font-size: var(--master-font-control); line-height: 1; font-weight: 950; text-decoration: none; cursor: pointer; }
  .primary-action { border: 1px solid #1d4ed8; background: #1d4ed8; color: #fff; }
  .secondary-action { border: 1px solid #cbd5e1; background: #fff; color: #334155; }
  .range-card { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-width: 0; border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; padding: 14px 16px; box-shadow: 0 10px 28px rgba(15, 23, 42, .04); }
  .range-card > div:first-child { display: grid; gap: 2px; }
  .range-card strong { font-size: var(--master-font-control); font-weight: 950; }
  .range-card span { color: #64748b; font-size: var(--master-font-meta); font-weight: 700; }
  .range-tabs, .seller-tabs { display: flex; max-width: 100%; gap: 5px; overflow-x: auto; border-radius: 11px; background: #f1f5f9; padding: 4px; scrollbar-width: thin; }
  .range-tab, .seller-tab { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; border: 0; border-radius: 8px; background: transparent; color: #64748b; padding: 9px 13px; font: inherit; font-size: var(--master-font-control); font-weight: 900; text-decoration: none; white-space: nowrap; cursor: pointer; }
  .range-tab.is-active, .seller-tab.is-active { background: #fff; color: #1d4ed8; box-shadow: 0 4px 14px rgba(15, 23, 42, .09); }
  .analytics-error { border: 1px solid #fed7aa; border-radius: 13px; background: #fff7ed; color: #9a3412; padding: 15px 17px; }
  .analytics-error strong { font-size: var(--master-font-control); font-weight: 950; }
  .analytics-error p { margin: 5px 0 0; font-size: var(--master-font-meta); line-height: var(--master-line-normal); font-weight: 700; }
  .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .kpi-card { --accent: #2563eb; display: grid; gap: 7px; min-width: 0; min-height: 150px; overflow: hidden; position: relative; border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; padding: 20px; box-shadow: 0 14px 34px rgba(15, 23, 42, .05); }
  .kpi-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--accent); }
  .kpi-card.is-violet { --accent: #7c3aed; }
  .kpi-card.is-slate { --accent: #334155; }
  .kpi-card.is-cyan { --accent: #0891b2; }
  .kpi-card.is-emerald { --accent: #059669; }
  .kpi-card span { color: #64748b; font-size: var(--master-font-meta); font-weight: 900; text-transform: uppercase; letter-spacing: .045em; }
  .kpi-card strong { color: #0f172a; font-size: var(--master-font-kpi); line-height: 1; font-weight: 1000; }
  .kpi-card small { align-self: end; color: #64748b; font-size: var(--master-font-caption); line-height: 1.35; font-weight: 700; }
  .orders-chart-grid { display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(250px, .7fr); gap: 18px; min-width: 0; }
  .status-card, .section-card { min-width: 0; border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; box-shadow: 0 18px 44px rgba(15, 23, 42, .06); }
  .status-card { display: grid; align-content: start; gap: 18px; padding: 20px; }
  .status-card > div:first-child span { color: #059669; font-size: var(--master-font-caption); font-weight: 950; text-transform: uppercase; letter-spacing: .07em; }
