---
import MasterDialog from './MasterDialog.astro';
import MasterIcon from './MasterIcon.astro';
import MasterStoreContextHeader from './MasterStoreContextHeader.astro';
import type { MasterPlanAudit, MasterPlanCode, MasterStorePlan } from '../../lib/masterStorePlans';
import {
  commercialMonthsLabel,
  commercialPlan,
  commercialPlanDurationLabel,
  formatCommercialCup,
  type CommercialOptionalCapability,
  type CommercialPlanDefinition,
  type CommercialStoreTypeDefinition,
} from '../../lib/commercialPlanCatalog';
import { resolveStorePlanPresentation } from '../../lib/storePlanPresentation';
import { productQuotaLabel, productQuotaMessage } from '../../lib/productQuota';

interface Props {
  data: MasterStorePlan;
  catalog: CommercialStoreTypeDefinition;
  currencyDecimals: number;
  securityPolicy: CommercialOptionalCapability;
  storeMeta: {
    featured: boolean;
    protected: boolean;
    updated: string;
    securityExists: boolean;
    securityLabel: string;
  };
}

const { data, catalog, currencyDecimals, securityPolicy, storeMeta } = Astro.props;
const { store, plan, usage, last_change: lastChange, history } = data;
const definitions = catalog.plans;
const currentDefinition = commercialPlan(catalog, plan.plan) as CommercialPlanDefinition;
const expirationCleanup = data.expiration_cleanup;
const productQuota = data.product_quota;
const headerStore = { ...store, featured: storeMeta.featured, security_label: storeMeta.securityLabel };
const planPresentation = resolveStorePlanPresentation(plan, data.generated_at || new Date());
const cup = (value: unknown) => formatCommercialCup(value, currencyDecimals);
const planData = Object.fromEntries(definitions.map((definition) => [definition.code, {
  name: definition.name,
  trialDays: definition.pricing.trial?.days || 0,
  trialTotalCup: definition.pricing.trial?.total_cup || 0,
  supportsPermanent: definition.supports_permanent,
  expirationToolsEnabled: definition.capabilities.product_expiration_tools_enabled === true,
  periods: definition.pricing.periods,
}]));

function planName(code: MasterPlanCode | '') {
  if (!code) return 'Sin plan';
  return commercialPlan(catalog, code)?.name || code;
}

function date(value: string) {
  const parsed = new Date(value);
  return Number.isFinite(parsed.getTime())
    ? new Intl.DateTimeFormat('es', { dateStyle: 'medium' }).format(parsed)
    : 'Sin fecha';
}

function dateTime(value: string) {
  const parsed = new Date(value);
  return Number.isFinite(parsed.getTime())
    ? new Intl.DateTimeFormat('es', { dateStyle: 'medium', timeStyle: 'short' }).format(parsed)
    : 'Sin fecha';
}

function stateLabel(value: string, daysRemaining: number | null) {
  if (value === 'active') return 'Activo';
  if (value === 'expiring') return 'Próximo a vencer';
  if (value === 'critical') return daysRemaining === 0 ? 'Vence hoy' : 'Vence pronto';
  if (value === 'expired') return 'Vencido';
  return 'No configurado';
}

function stateTone(value: string) {
  if (value === 'active') return 'master-pill--success';
  if (value === 'expired') return 'master-pill--danger';
  if (value === 'expiring' || value === 'critical') return 'master-pill--warning';
  return '';
}

function trialDays(code: MasterPlanCode | '') {
  return code ? commercialPlan(catalog, code)?.pricing.trial?.days || 0 : 0;
}

function validityLabel(entry: MasterPlanAudit | null) {
  if (!entry) return 'Sin registro';
  if (entry.new_is_permanent) return 'Permanente';
  const trial = trialDays(entry.new_plan);
  if (trial) return `${trial} días`;
  return entry.duration_months ? commercialMonthsLabel(entry.duration_months) : 'Temporal';
}

const currentTrialDays = currentDefinition.pricing.trial?.days || 0;
const durationLabel = plan.plan_is_permanent
  ? 'Permanente'
  : currentTrialDays
    ? `${currentTrialDays} días`
    : plan.plan_duration_months
      ? commercialMonthsLabel(plan.plan_duration_months)
      : 'Sin configurar';
const validityValue = plan.plan_is_permanent
  ? 'Sin vencimiento'
  : plan.days_remaining === null
    ? 'Sin configurar'
    : plan.days_remaining === 0
      ? plan.state === 'expired' ? 'Vencido' : 'Vence hoy'
      : `${plan.days_remaining} ${plan.days_remaining === 1 ? 'día' : 'días'}`;

function numericCapability(definition: CommercialPlanDefinition, key: string) {
  const value = definition.capabilities[key];
  return Number.isSafeInteger(value) ? Number(value) : 0;
}

function booleanCapability(definition: CommercialPlanDefinition, key: string) {
  return definition.capabilities[key] === true;
}

const currentCapabilities = [
  { label: 'Productos', value: productQuotaLabel(productQuota), icon: 'products' as const },
  { label: 'Usuarios', value: `${usage.active_users} / ${numericCapability(currentDefinition, 'max_active_users')}`, icon: 'users' as const },
  { label: 'Dispositivos por usuario', value: `${usage.max_devices_per_user} / ${numericCapability(currentDefinition, 'max_devices_per_user')}`, icon: 'security' as const },
  { label: 'Dispositivos por tienda', value: `${usage.store_devices} / ${numericCapability(currentDefinition, 'max_store_devices')}`, icon: 'stores' as const },
  { label: 'Fotos por producto', value: numericCapability(currentDefinition, 'max_product_images'), icon: 'products' as const },
  { label: 'Categorías y subcategorías', included: booleanCapability(currentDefinition, 'categories_enabled') && booleanCapability(currentDefinition, 'subcategories_enabled'), icon: 'check' as const },
  { label: 'Android administrativo', included: booleanCapability(currentDefinition, 'admin_android_app_enabled'), icon: 'stores' as const },
  { label: 'Android de clientes', included: booleanCapability(currentDefinition, 'customer_android_app_enabled'), icon: 'external' as const },
  { label: 'Rifas', included: booleanCapability(currentDefinition, 'raffles_enabled'), icon: 'check' as const },
  { label: 'Landing QR', included: booleanCapability(currentDefinition, 'landing_qr_enabled'), icon: 'external' as const },
  { label: 'Vencimientos y alertas', included: booleanCapability(currentDefinition, 'product_expiration_tools_enabled'), icon: 'alert' as const },
  { label: 'Campañas push', included: booleanCapability(currentDefinition, 'push_campaigns_enabled'), icon: 'external' as const },
];

function planFeatures(definition: CommercialPlanDefinition) {
  const maxUsers = numericCapability(definition, 'max_active_users');
  return [
    `${numericCapability(definition, 'max_products')} productos`,
    `${numericCapability(definition, 'max_product_images')} fotos por producto`,
    `${maxUsers} ${maxUsers === 1 ? 'usuario' : 'usuarios'}`,
    booleanCapability(definition, 'categories_enabled') && booleanCapability(definition, 'subcategories_enabled') ? 'Categorías y subcategorías' : 'Sin categorías y subcategorías',
    booleanCapability(definition, 'admin_android_app_enabled') ? 'Android administrativo' : 'Sin Android administrativo',
    booleanCapability(definition, 'customer_android_app_enabled') ? 'Android de clientes' : 'Sin Android de clientes',
    booleanCapability(definition, 'raffles_enabled') ? 'Rifas' : 'Sin rifas',
    booleanCapability(definition, 'landing_qr_enabled') ? 'Landing QR' : 'Sin Landing QR',
    booleanCapability(definition, 'product_expiration_tools_enabled') ? 'Vencimientos y alertas' : 'Sin herramientas de vencimiento',
    booleanCapability(definition, 'push_campaigns_enabled') ? 'Campañas push' : 'Sin campañas push',
  ];
}
---

<section
  class="master-store-page master-plan-page"
  data-store-context
  data-store-overview="true"
  data-store-id={store.id}
  data-store-name={store.name}
  data-store-slug={store.slug}
  data-store-status={store.status}
  data-store-featured={storeMeta.featured ? 'true' : 'false'}
  data-store-protected={storeMeta.protected ? 'true' : 'false'}
  data-store-updated={storeMeta.updated}
  data-store-security-exists={storeMeta.securityExists ? 'true' : 'false'}
  data-plan-page
  data-current-plan={plan.plan}
  data-current-permanent={plan.plan_is_permanent ? 'true' : 'false'}
  data-current-expiration={plan.plan_expires_at}
  data-commercial-plans={JSON.stringify(planData)}
  data-currency-decimals={String(currencyDecimals)}
  data-expiration-products={expirationCleanup.products}
  data-expiration-variations={expirationCleanup.variations}
  data-expiration-notifications={expirationCleanup.notifications}
  data-expiration-cycles={expirationCleanup.cycles}
>
  <MasterStoreContextHeader store={headerStore} planPresentation={planPresentation} />

  <header class="master-plan-heading">
    <div><h1>Plan y límites</h1><p>Gestiona el plan activo, la vigencia y las capacidades de {catalog.name}.</p></div>
  </header>

  {productQuota.state !== 'available' && (
    <section class:list={['master-notice', productQuota.state === 'near_limit' ? 'master-notice--warning' : 'master-notice--danger']} role="status">
      <strong>{productQuotaLabel(productQuota)}</strong><br />
      {productQuotaMessage(productQuota)}
    </section>
  )}

  <div class="master-plan-kpis" aria-label="Resumen del plan">
    <article class="master-store-kpi"><span class="master-store-kpi__label">Plan actual</span><strong class="master-store-kpi__value">{planName(plan.plan)}</strong><span class="master-store-kpi__meta">{plan.plan_name}</span></article>
    <article class="master-store-kpi"><span class="master-store-kpi__label">Tipo de vigencia</span><strong class="master-store-kpi__value">{durationLabel}</strong><span class="master-store-kpi__meta">{plan.plan_is_permanent ? 'Compatibilidad permanente' : 'Período actual'}</span></article>
    <article class="master-store-kpi"><span class="master-store-kpi__label">Vigencia</span><strong class="master-store-kpi__value">{validityValue}</strong><span class="master-store-kpi__meta">{plan.plan_is_permanent ? 'Sin fecha límite' : plan.plan_expires_at ? `Hasta ${date(plan.plan_expires_at)}` : 'Pendiente de configurar'}</span></article>
    <article class="master-store-kpi"><span class="master-store-kpi__label">Estado</span><strong class="master-store-kpi__value"><span class:list={['master-pill', stateTone(plan.state)]}>{stateLabel(plan.state, plan.days_remaining)}</span></strong><span class="master-store-kpi__meta">{plan.plan_is_permanent ? 'Vigencia permanente' : 'Vigencia temporal'}</span></article>
  </div>

  <section class="master-card master-plan-summary">
    <header class="master-card-header">
      <div><h3 class="master-card-title">Resumen del plan</h3><p class="master-card-subtitle">Información vigente registrada para esta tienda.</p></div>
      <div class="master-plan-summary__actions">
        <button class="master-btn master-btn--secondary" type="button" data-open-plan-change><MasterIcon name="edit" size={19} /> Cambiar plan</button>
        {plan.can_renew && <button class="master-btn master-btn--primary" type="button" data-open-plan-renew><MasterIcon name="clock" size={19} /> Renovar plan</button>}
      </div>
    </header>
    <div class="master-card-body master-plan-summary__grid">
      <div><span>Tienda</span><strong>{store.name}</strong></div>
      <div><span>Plan actual</span><strong>{planName(plan.plan)}</strong></div>
      <div><span>Fecha de inicio</span><strong>{date(plan.plan_started_at)}</strong></div>
      <div><span>{plan.plan_is_permanent ? 'Vigencia' : 'Fecha de vencimiento'}</span><strong>{plan.plan_is_permanent ? 'Sin vencimiento' : date(plan.plan_expires_at)}</strong></div>
      <div><span>{plan.plan_is_permanent ? 'Estado temporal' : 'Días restantes'}</span><strong>{plan.plan_is_permanent ? 'No aplica' : validityValue}</strong></div>
    </div>
  </section>

  <section class="master-card">
    <header class="master-card-header"><div><h3 class="master-card-title">Capacidades y límites</h3><p class="master-card-subtitle">Valores entregados por el catálogo para {planName(plan.plan)}.</p></div></header>
    <div class="master-card-body master-plan-capabilities">
      {currentCapabilities.map((item) => (
        <article class="master-plan-capability">
          <span class="master-plan-capability__icon"><MasterIcon name={item.icon} size={20} /></span>
          <div><span>{item.label}</span>{'value' in item ? <strong>{item.value}</strong> : <span class:list={['master-pill', item.included ? 'master-pill--success' : '']}>{item.included ? 'Incluido' : 'No incluido'}</span>}</div>
        </article>
      ))}
      <article class="master-plan-capability master-plan-capability--optional">
        <span class="master-plan-capability__icon"><MasterIcon name="security" size={20} /></span>
        <div><span>{securityPolicy.name}</span><strong>{storeMeta.securityLabel}</strong><small>Opcional por tienda · solo Master · apagada por defecto</small></div>
      </article>
    </div>
  </section>

  <div class="master-plan-bottom-grid">
    <section class="master-card">
      <header class="master-card-header"><div><h3 class="master-card-title">Planes disponibles</h3><p class="master-card-subtitle">Importes oficiales en CUP. Los periodos comerciales son los publicados por el backend.</p></div></header>
      <div class="master-card-body master-plan-options">
        {definitions.map((definition) => {
          const current = definition.code === plan.plan;
          const trial = definition.pricing.trial;
          const firstPeriod = definition.pricing.periods[0];
          return (
            <article class:list={['master-plan-option', { 'is-current': current }]}>
              <div class="master-plan-option__heading">
                <div><h4>{definition.name}</h4><strong>{trial ? `${cup(trial.total_cup)} total` : `${cup(firstPeriod?.monthly_equivalent_cup)}/mes`}</strong><span>{commercialPlanDurationLabel(definition)}{definition.supports_permanent ? ' · permanente compatible' : ''}</span></div>
                {current && <span class="master-pill master-pill--info">Actual</span>}
              </div>
              {trial ? (
                <div class="master-plan-pricing"><strong>{trial.days} días</strong><span>Total {cup(trial.total_cup)} · uso único por tienda</span></div>
              ) : (
                <div class="master-plan-pricing" aria-label={`Precios de ${definition.name}`}>
                  {definition.pricing.periods.map((period) => <div><strong>{commercialMonthsLabel(period.months)}</strong><span>{cup(period.monthly_equivalent_cup)}/mes equivalente · total {cup(period.total_cup)} · ahorro {cup(period.savings_cup)} ({period.savings_percent}%)</span></div>)}
                </div>
              )}
              <ul>{planFeatures(definition).map((feature) => <li><MasterIcon name="check" size={17} /> {feature}</li>)}</ul>
              <button class:list={['master-btn', current ? 'master-btn--secondary' : 'master-btn--primary']} type="button" data-plan-target={definition.code} disabled={current}>{current ? (plan.plan_is_permanent ? 'Plan permanente actual' : 'Plan actual') : `Asignar ${definition.name}`}</button>
            </article>
          );
        })}
      </div>
    </section>

    <section class="master-card master-plan-last-change">
      <header class="master-card-header"><h3 class="master-card-title">Último cambio de plan</h3></header>
      <div class="master-card-body">
        {lastChange ? <dl class="master-plan-change-list"><div><dt>Acción</dt><dd>{lastChange.action_label}</dd></div><div><dt>Cambiado por</dt><dd>{lastChange.actor_name}</dd></div><div><dt>Plan anterior</dt><dd>{planName(lastChange.previous_plan)}</dd></div><div><dt>Nuevo plan</dt><dd>{planName(lastChange.new_plan)}</dd></div><div><dt>Duración</dt><dd>{validityLabel(lastChange)}</dd></div><div><dt>Fecha</dt><dd>{dateTime(lastChange.created)}</dd></div></dl> : <p class="master-empty">Todavía no hay cambios de plan registrados.</p>}
      </div>
      <footer class="master-plan-card-footer"><button class="master-btn master-btn--secondary" type="button" data-open-plan-history disabled={!history.length}><MasterIcon name="clock" size={19} /> Ver historial completo</button></footer>
    </section>
  </div>

  <MasterDialog id="master-plan-change-dialog" title="Cambiar plan" description="Asigna un plan y define una vigencia comercial o permanente compatible." tone="primary" size="lg">
    <form class="master-form" data-plan-change-form>
      <div class="master-field-grid"><div class="master-field master-field--full"><label for="master-plan-destination">Plan destino</label><select id="master-plan-destination" name="plan" required>{definitions.map((definition) => <option value={definition.code}>{definition.name} — {definition.pricing.trial ? `${definition.pricing.trial.days} días · total ${cup(definition.pricing.trial.total_cup)}` : `desde ${cup(definition.pricing.periods[0]?.monthly_equivalent_cup)}/mes`}</option>)}</select></div></div>
      <fieldset class="master-fieldset"><legend>Tipo de vigencia</legend><div class="master-choice-grid"><label class="master-choice"><input name="validity" type="radio" value="temporary" checked /><span><strong>Temporal</strong><br />Usa uno de los periodos comerciales.</span></label><label class="master-choice" data-permanent-choice><input name="validity" type="radio" value="permanent" /><span><strong>Permanente compatible</strong><br />Conserva contratos sin vencimiento existentes.</span></label></div></fieldset>
      <div class="master-field" data-change-months-field><label for="master-plan-months">Duración comercial</label><select id="master-plan-months" name="duration_months">{definitions.find((definition) => definition.duration.allowed_months.length)?.duration.allowed_months.map((month) => <option value={month}>{commercialMonthsLabel(month)}</option>)}</select></div>
      <div class="master-field"><label for="master-plan-reason">Motivo interno (opcional)</label><textarea id="master-plan-reason" name="reason" maxlength="500" placeholder="Contexto para la auditoría del cambio"></textarea></div>
      <aside class="master-form-alert master-expiration-cleanup-warning" data-expiration-cleanup-warning role="alert" hidden><strong>Esta acción es irreversible.</strong><span data-expiration-cleanup-copy></span><span><strong>App Android:</strong> su distribución se retirará de forma reversible. No se eliminará la app, Firebase, firma o APK/AAB y la tienda web no será suspendida.</span><label class="master-choice"><input name="confirm_expiration_cleanup" type="checkbox" /><span>Confirmo que se eliminen definitivamente las fechas, notificaciones y ciclos de vencimiento de esta tienda.</span></label></aside>
      <aside class="master-plan-form-summary" data-change-summary aria-live="polite"></aside>
      <p class="master-form-alert" data-plan-change-alert role="alert" hidden></p>
    </form>
    <div slot="footer"><button class="master-btn master-btn--secondary" type="button" data-master-dialog-close>Cancelar</button><button class="master-btn master-btn--primary" type="button" data-plan-change-save><MasterIcon name="save" size={19} /> Confirmar cambio</button></div>
  </MasterDialog>

  {plan.can_renew && <MasterDialog id="master-plan-renew-dialog" title="Renovar plan" description="Agrega uno de los periodos comerciales al vencimiento actual." tone="primary">
    <form class="master-form" data-plan-renew-form>
      <div class="master-plan-renew-current"><span>Plan actual</span><strong>{planName(plan.plan)}</strong><span>Vencimiento actual: {date(plan.plan_expires_at)}</span></div>
      <div class="master-field"><label for="master-renew-months">Periodo a agregar</label><select id="master-renew-months" name="months">{currentDefinition.duration.allowed_months.map((month) => <option value={month}>{commercialMonthsLabel(month)}</option>)}</select></div>
      <div class="master-field"><label for="master-renew-reason">Motivo interno (opcional)</label><textarea id="master-renew-reason" name="reason" maxlength="500" placeholder="Contexto para la auditoría de la renovación"></textarea></div>
      <aside class="master-plan-form-summary" data-renew-summary aria-live="polite"></aside><p class="master-form-alert" data-plan-renew-alert role="alert" hidden></p>
    </form>
    <div slot="footer"><button class="master-btn master-btn--secondary" type="button" data-master-dialog-close>Cancelar</button><button class="master-btn master-btn--primary" type="button" data-plan-renew-save><MasterIcon name="clock" size={19} /> Confirmar renovación</button></div>
  </MasterDialog>}

  <MasterDialog id="master-plan-history-dialog" title="Historial de planes" description="Últimos movimientos registrados para esta tienda." size="lg">
    {history.length ? <div class="master-table-wrap"><table class="master-table master-plan-history-table"><thead><tr><th>Fecha</th><th>Acción</th><th>Cambio</th><th>Vigencia</th><th>Actor</th><th>Motivo</th></tr></thead><tbody>{history.map((entry) => <tr><td>{dateTime(entry.created)}</td><td>{entry.action_label}</td><td>{planName(entry.previous_plan)} → {planName(entry.new_plan)}</td><td>{validityLabel(entry)}</td><td>{entry.actor_name}</td><td>{entry.reason || 'Sin motivo'}</td></tr>)}</tbody></table></div> : <p class="master-empty">No hay movimientos registrados.</p>}
    <div slot="footer"><button class="master-btn master-btn--secondary" type="button" data-master-dialog-close>Cerrar</button></div>
  </MasterDialog>
</section>

<script>
  import { pb } from '../../lib/pocketbase';
  import { changeMasterStorePlan, getMasterPlanErrorMessage, renewMasterStorePlan, type MasterPlanCode } from '../../lib/masterStorePlans';

  type UiPlan = { name: string; trialDays: number; trialTotalCup: number; supportsPermanent: boolean; expirationToolsEnabled: boolean; periods: Array<{ months: number; monthly_equivalent_cup: number; total_cup: number; savings_cup: number; savings_percent: number }> };
  const root = document.querySelector<HTMLElement>('[data-plan-page]');
  if (root && root.dataset.planInitialized !== 'true') {
    root.dataset.planInitialized = 'true';
    pb.authStore.loadFromCookie(document.cookie, 'pb_auth');
    const plans = JSON.parse(String(root.dataset.commercialPlans || '{}')) as Record<MasterPlanCode, UiPlan>;
    const storeId = String(root.dataset.storeId || '');
    const currentPlan = String(root.dataset.currentPlan || 'free') as MasterPlanCode;
    const currentExpiration = String(root.dataset.currentExpiration || '');
    const currencyDecimals = Math.max(0, Number(root.dataset.currencyDecimals || 0));
    const expirationCleanup = { products: Math.max(0, Number(root.dataset.expirationProducts || 0)), variations: Math.max(0, Number(root.dataset.expirationVariations || 0)), notifications: Math.max(0, Number(root.dataset.expirationNotifications || 0)), cycles: Math.max(0, Number(root.dataset.expirationCycles || 0)) };
    const changeForm = root.querySelector<HTMLFormElement>('[data-plan-change-form]');
    const changePlan = changeForm?.querySelector<HTMLSelectElement>('[name="plan"]');
    const changeMonths = changeForm?.querySelector<HTMLSelectElement>('[name="duration_months"]');
    const changeReason = changeForm?.querySelector<HTMLTextAreaElement>('[name="reason"]');
    const changeMonthsField = changeForm?.querySelector<HTMLElement>('[data-change-months-field]');
    const permanentInput = changeForm?.querySelector<HTMLInputElement>('[name="validity"][value="permanent"]');
    const temporaryInput = changeForm?.querySelector<HTMLInputElement>('[name="validity"][value="temporary"]');
    const permanentChoice = changeForm?.querySelector<HTMLElement>('[data-permanent-choice]');
    const changeSummary = changeForm?.querySelector<HTMLElement>('[data-change-summary]');
    const expirationCleanupWarning = changeForm?.querySelector<HTMLElement>('[data-expiration-cleanup-warning]');
    const expirationCleanupCopy = changeForm?.querySelector<HTMLElement>('[data-expiration-cleanup-copy]');
    const expirationCleanupConfirmation = changeForm?.querySelector<HTMLInputElement>('[name="confirm_expiration_cleanup"]');
    const renewForm = root.querySelector<HTMLFormElement>('[data-plan-renew-form]');
    const renewMonths = renewForm?.querySelector<HTMLSelectElement>('[name="months"]');
    const renewReason = renewForm?.querySelector<HTMLTextAreaElement>('[name="reason"]');
    const renewSummary = renewForm?.querySelector<HTMLElement>('[data-renew-summary]');
    const cup = (value: number) => `${new Intl.NumberFormat('es-CU', { minimumFractionDigits: currencyDecimals, maximumFractionDigits: currencyDecimals }).format(Math.max(0, value))} CUP`;
    const periodFor = (planCode: MasterPlanCode, months: number) => plans[planCode]?.periods.find((period) => period.months === months);
    const setAlert = (target: HTMLElement | null, message = '') => { if (target) { target.textContent = message; target.hidden = !message; } };
    function addMonthsClamped(value: Date, months: number) { const originalDay = value.getUTCDate(); const result = new Date(value); result.setUTCDate(1); result.setUTCMonth(result.getUTCMonth() + months); const lastDay = new Date(result); lastDay.setUTCMonth(lastDay.getUTCMonth() + 1); lastDay.setUTCDate(0); result.setUTCDate(Math.min(originalDay, lastDay.getUTCDate())); return result; }
    const formatDate = (value: Date) => new Intl.DateTimeFormat('es', { dateStyle: 'medium' }).format(value);
    const selectedPermanent = () => permanentInput?.checked === true;
    const requiresExpirationCleanup = (selected: MasterPlanCode) => plans[currentPlan]?.expirationToolsEnabled === true && plans[selected]?.expirationToolsEnabled !== true;

    function updateChangeSummary() {
      if (!changePlan || !changeMonths || !changeSummary) return;
      const selected = changePlan.value as MasterPlanCode; const selectedPlan = plans[selected]; if (!selectedPlan) return;
      const isTrial = selectedPlan.trialDays > 0; const supportsPermanent = selectedPlan.supportsPermanent && !isTrial;
      if (permanentInput) permanentInput.disabled = !supportsPermanent; permanentChoice?.classList.toggle('is-disabled', !supportsPermanent);
      if (!supportsPermanent && permanentInput?.checked && temporaryInput) temporaryInput.checked = true;
      const permanent = selectedPermanent(); if (changeMonthsField) changeMonthsField.hidden = permanent || isTrial;
      const months = Number(changeMonths.value); const expiration = isTrial ? new Date(Date.now() + selectedPlan.trialDays * 86400000) : addMonthsClamped(new Date(), months); const period = periodFor(selected, months);
      const pricing = permanent ? 'No aplica a la vigencia permanente compatible' : isTrial ? `Total ${cup(selectedPlan.trialTotalCup)}` : period ? `${cup(period.monthly_equivalent_cup)}/mes equivalente · total ${cup(period.total_cup)} · ahorro ${cup(period.savings_cup)} (${period.savings_percent}%)` : 'Periodo no disponible';
      changeSummary.innerHTML = `<span>Nuevo plan</span><strong>${selectedPlan.name}</strong><span>Vigencia</span><strong>${permanent ? 'Permanente · sin vencimiento' : isTrial ? `${selectedPlan.trialDays} días · hasta ${formatDate(expiration)}` : `${months} ${months === 1 ? 'mes' : 'meses'} · hasta ${formatDate(expiration)}`}</strong><span>Importe</span><strong>${pricing}</strong>`;
      const needsCleanup = requiresExpirationCleanup(selected); if (expirationCleanupWarning) expirationCleanupWarning.hidden = !needsCleanup;
      if (expirationCleanupCopy) expirationCleanupCopy.textContent = `Al cambiar a un plan sin vencimientos se eliminarán ${expirationCleanup.products} fechas generales de producto, ${expirationCleanup.variations} fechas de variación, ${expirationCleanup.notifications} notificaciones y ${expirationCleanup.cycles} ciclos de alertas. Un cambio posterior no restaurará estos datos.`;
      if (!needsCleanup && expirationCleanupConfirmation) expirationCleanupConfirmation.checked = false;
    }
    function updateRenewSummary() {
      if (!renewMonths || !renewSummary) return; const months = Number(renewMonths.value); const period = periodFor(currentPlan, months); const now = new Date(); const expiration = new Date(currentExpiration); const base = Number.isFinite(expiration.getTime()) && expiration > now ? expiration : now;
      renewSummary.innerHTML = `<span>Periodo</span><strong>${months} ${months === 1 ? 'mes' : 'meses'}</strong><span>Mensual equivalente</span><strong>${cup(period?.monthly_equivalent_cup || 0)}</strong><span>Total</span><strong>${cup(period?.total_cup || 0)}</strong><span>Ahorro</span><strong>${cup(period?.savings_cup || 0)}${period ? ` (${period.savings_percent}%)` : ''}</strong><span>Nuevo vencimiento</span><strong>${formatDate(addMonthsClamped(base, months))}</strong>`;
    }
    function openDialog(id: string, trigger: HTMLElement) { setAlert(root.querySelector<HTMLElement>(id === 'master-plan-change-dialog' ? '[data-plan-change-alert]' : '[data-plan-renew-alert]')); window.PZMasterDialog?.open(id, trigger); }
    root.querySelectorAll<HTMLButtonElement>('[data-plan-target]').forEach((button) => button.addEventListener('click', () => { if (changePlan) changePlan.value = String(button.dataset.planTarget || currentPlan); if (temporaryInput) temporaryInput.checked = true; updateChangeSummary(); openDialog('master-plan-change-dialog', button); }));
    root.querySelector<HTMLButtonElement>('[data-open-plan-change]')?.addEventListener('click', (event) => { if (changePlan) changePlan.value = currentPlan; const permanent = root.dataset.currentPermanent === 'true'; if (permanentInput) permanentInput.checked = permanent; if (temporaryInput) temporaryInput.checked = !permanent; updateChangeSummary(); openDialog('master-plan-change-dialog', event.currentTarget as HTMLElement); });
    root.querySelector<HTMLButtonElement>('[data-open-plan-renew]')?.addEventListener('click', (event) => { updateRenewSummary(); openDialog('master-plan-renew-dialog', event.currentTarget as HTMLElement); });
    root.querySelector<HTMLButtonElement>('[data-open-plan-history]')?.addEventListener('click', (event) => window.PZMasterDialog?.open('master-plan-history-dialog', event.currentTarget as HTMLElement));
    changeForm?.addEventListener('change', updateChangeSummary); renewMonths?.addEventListener('change', updateRenewSummary);
    root.querySelector<HTMLButtonElement>('[data-plan-change-save]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement; const alert = root.querySelector<HTMLElement>('[data-plan-change-alert]'); if (button.disabled) return; if (!changePlan || !changeMonths || !changeReason) return;
      const selected = changePlan.value as MasterPlanCode; const selectedPlan = plans[selected]; if (!selectedPlan) return; const needsCleanup = requiresExpirationCleanup(selected);
      if (needsCleanup && expirationCleanupConfirmation?.checked !== true) { setAlert(alert, 'Confirma la eliminación irreversible de fechas y alertas de vencimiento.'); expirationCleanupConfirmation?.focus(); return; }
      button.disabled = true; setAlert(alert); const permanent = selectedPermanent(); const result = await changeMasterStorePlan(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, { store_id: storeId, plan: selected, is_permanent: permanent, duration_months: permanent || selectedPlan.trialDays > 0 ? 0 : Number(changeMonths.value), reason: changeReason.value.trim(), confirm_expiration_cleanup: needsCleanup && expirationCleanupConfirmation?.checked === true });
      if (result.available) window.location.reload(); else { setAlert(alert, getMasterPlanErrorMessage(result.error)); button.disabled = false; }
    });
    root.querySelector<HTMLButtonElement>('[data-plan-renew-save]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement; const alert = root.querySelector<HTMLElement>('[data-plan-renew-alert]'); if (button.disabled) return; if (!renewMonths || !renewReason) return; button.disabled = true; setAlert(alert);
      const result = await renewMasterStorePlan(import.meta.env.PUBLIC_POCKETBASE_URL, pb.authStore.token, { store_id: storeId, months: Number(renewMonths.value), reason: renewReason.value.trim() }); if (result.available) window.location.reload(); else { setAlert(alert, getMasterPlanErrorMessage(result.error)); button.disabled = false; }
    });
    updateChangeSummary(); updateRenewSummary();
  }
</script>
