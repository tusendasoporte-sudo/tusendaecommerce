---
import MasterIcon from './MasterIcon.astro';
import StorePlanIndicator from '../shared/StorePlanIndicator.astro';
import type { StorePlanPresentation } from '../../lib/storePlanPresentation';

export interface MasterSidebarStoreContext {
  id: string;
  name: string;
  slug: string;
  status: string;
  planPresentation: StorePlanPresentation;
  storeType?: 'commerce' | 'promo';
  promoSiteStatus?: string;
}

interface Props {
  currentPath: string;
  displayName: string;
  currentStore?: MasterSidebarStoreContext | null;
  priceWatchStoreId?: string;
}

const {
  currentPath,
  displayName,
  currentStore = null,
  priceWatchStoreId = '',
} = Astro.props;

const normalizedPath = currentPath.replace(/\/+$/, '') || '/master';

function isActive(href: string) {
  const normalizedHref = href.replace(/\/+$/, '') || '/master';
  if (normalizedHref === '/master') return normalizedPath === '/master';
  return normalizedPath === normalizedHref || normalizedPath.startsWith(`${normalizedHref}/`);
}

function initials(value: string, fallback: string) {
  return value
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() || '')
    .join('') || fallback;
}
---

<aside class="master-sidebar" data-master-sidebar aria-label="Navegación Master">
  <div class="master-sidebar__brand">
    <img
      src="/master-samurai-mark.png"
      width="46"
      height="46"
      alt=""
      aria-hidden="true"
      class="master-sidebar__brand-mark"
    />
    <div class="master-sidebar__brand-copy">
      <strong>Tu Senda 84</strong>
      <span>MASTER ADMIN</span>
    </div>
    <button class="master-sidebar__mobile-close" type="button" aria-label="Cerrar menú" data-master-sidebar-close>
      <MasterIcon name="close" size={22} />
    </button>
  </div>

  <section
    class="master-sidebar__server-monitor"
    aria-label="Estado del servidor"
    aria-busy="true"
    data-master-server-monitor
  >
    <header class="master-sidebar__server-header">
      <span>ESTADO DEL SERVIDOR</span>
      <i class="master-sidebar__server-dot" aria-hidden="true" data-server-status-dot></i>
    </header>

    <div class="master-sidebar__server-metric" data-server-metric="memory">
      <div class="master-sidebar__server-metric-copy">
        <span>Memoria</span>
        <strong data-server-metric-value>—</strong>
        <b data-server-metric-percent>—</b>
      </div>
      <div
        class="master-sidebar__server-track"
        role="progressbar"
        aria-label="Uso de memoria"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuetext="Información temporalmente no disponible"
        data-server-metric-progress
      ><span data-server-metric-bar></span></div>
    </div>

    <div class="master-sidebar__server-metric" data-server-metric="disk">
      <div class="master-sidebar__server-metric-copy">
        <span>Disco</span>
        <strong data-server-metric-value>—</strong>
        <b data-server-metric-percent>—</b>
      </div>
      <div
        class="master-sidebar__server-track"
        role="progressbar"
        aria-label="Uso de disco"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuetext="Información temporalmente no disponible"
        data-server-metric-progress
      ><span data-server-metric-bar></span></div>
    </div>

    <p class="master-sidebar__server-status" data-server-status>Conectando…</p>
  </section>

  <nav class="master-sidebar__nav">
    <section class="master-sidebar__section">
      <p class="master-sidebar__label">PRINCIPAL</p>
      <a class:list={['master-sidebar__link', { 'is-active': isActive('/master') }]} href="/master">
        <MasterIcon name="home" size={20} /><span>Resumen</span>
      </a>
      <a class:list={['master-sidebar__link', { 'is-active': isActive('/master/stores') }]} href="/master/stores">
        <MasterIcon name="stores" size={20} /><span>Tiendas</span>
      </a>
      <a
        class:list={['master-sidebar__link', { 'is-active': isActive('/master/price-watch') && !priceWatchStoreId }]}
        href="/master/price-watch"
      >
        <MasterIcon name="price" size={20} /><span>Seguimiento de precios</span>
      </a>
      <a class:list={['master-sidebar__link', { 'is-active': isActive('/master/notifications') }]} href="/master/notifications">
        <MasterIcon name="bell" size={20} /><span>Notificaciones</span>
        <span class="master-sidebar__notification-dot" data-master-sidebar-unread hidden></span>
      </a>
      <a class:list={['master-sidebar__link', { 'is-active': isActive('/master/settings') }]} href="/master/settings">
        <MasterIcon name="settings" size={20} /><span>Master</span>
      </a>
      <a class:list={['master-sidebar__link', { 'is-active': isActive('/master/homepage') }]} href="/master/homepage">
        <MasterIcon name="eye" size={20} /><span>Portada</span>
      </a>
      <a class:list={['master-sidebar__link', { 'is-active': isActive('/master/mobile-admin') }]} href="/master/mobile-admin">
        <MasterIcon name="security" size={20} /><span>Mobile Admin</span>
      </a>
    </section>

    {currentStore && (
      <section class="master-sidebar__section master-sidebar__section--store">
        <p class="master-sidebar__label">TIENDA ACTUAL</p>
        <div class="master-sidebar__store-card">
          <span class="master-sidebar__store-avatar" aria-hidden="true">{initials(currentStore.name, 'TS')}</span>
          <span class="master-sidebar__store-copy">
            <strong>{currentStore.name}</strong>
            <span class:list={['master-sidebar__store-status', {
              'is-active': currentStore.status === 'active',
              'is-suspended': currentStore.status !== 'active',
            }]}>{currentStore.status === 'active' ? 'Activa' : 'Suspendida'}</span>
            {currentStore.storeType === 'promo'
              ? <span class="master-sidebar__store-status is-active">Promo · {currentStore.promoSiteStatus || 'no disponible'}</span>
              : <StorePlanIndicator presentation={currentStore.planPresentation} variant="master-sidebar" />}
          </span>
        </div>

        <a
          class:list={['master-sidebar__link', { 'is-active': normalizedPath === `/master/stores/${currentStore.id}` }]}
          href={`/master/stores/${encodeURIComponent(currentStore.id)}`}
        >
          <MasterIcon name="home" size={20} /><span>Resumen de tienda</span>
        </a>
        <a
          class:list={['master-sidebar__link', { 'is-active': isActive(`/master/stores/${currentStore.id}/users`) }]}
          href={`/master/stores/${encodeURIComponent(currentStore.id)}/users`}
        >
          <MasterIcon name="users" size={20} /><span>Usuarios</span>
        </a>
        {currentStore.storeType === 'promo' && (
          <a
            class:list={['master-sidebar__link', { 'is-active': isActive(`/master/stores/${currentStore.id}/plan`) }]}
            href={`/master/stores/${encodeURIComponent(currentStore.id)}/plan`}
          >
            <MasterIcon name="plan" size={20} /><span>Plan y límites</span>
          </a>
        )}
        {currentStore.storeType !== 'promo' && (
          <>
            <a
              class:list={['master-sidebar__link', { 'is-active': isActive(`/master/analytics/${currentStore.id}`) }]}
              href={`/master/analytics/${encodeURIComponent(currentStore.id)}`}
            >
              <MasterIcon name="analytics" size={20} /><span>Analíticas</span>
            </a>
            <a
              class:list={['master-sidebar__link', { 'is-active': isActive(`/master/products/${currentStore.id}`) }]}
              href={`/master/products/${encodeURIComponent(currentStore.id)}`}
            >
              <MasterIcon name="products" size={20} /><span>Productos</span>
            </a>
            <a
              class:list={['master-sidebar__link', {
                'is-active': normalizedPath === '/master/price-watch' && priceWatchStoreId === currentStore.id,
              }]}
              href={`/master/price-watch?store_id=${encodeURIComponent(currentStore.id)}`}
            >
              <MasterIcon name="price" size={20} /><span>Seguimiento de precios</span>
            </a>
            <a
              class:list={['master-sidebar__link', { 'is-active': isActive(`/master/security/${currentStore.id}`) }]}
              href={`/master/security/${encodeURIComponent(currentStore.id)}`}
            >
              <MasterIcon name="security" size={20} /><span>Seguridad</span>
            </a>
            <a
              class:list={['master-sidebar__link', { 'is-active': isActive(`/master/stores/${currentStore.id}/plan`) }]}
              href={`/master/stores/${encodeURIComponent(currentStore.id)}/plan`}
            >
              <MasterIcon name="plan" size={20} /><span>Plan y límites</span>
            </a>
            <a
              class:list={['master-sidebar__link', { 'is-active': isActive(`/master/stores/${currentStore.id}/app`) }]}
              href={`/master/stores/${encodeURIComponent(currentStore.id)}/app`}
            >
              <MasterIcon name="settings" size={20} /><span>App Android</span>
            </a>
          </>
        )}
        <a class="master-sidebar__link master-sidebar__link--back" href="/master/stores">
          <MasterIcon name="back" size={20} /><span>Volver a tiendas</span>
        </a>
      </section>
    )}
  </nav>

  <div class="master-sidebar__profile" aria-label="Usuario Master activo">
    <span class="master-sidebar__profile-avatar" aria-hidden="true">{initials(displayName, 'MA')}</span>
    <span class="master-sidebar__profile-copy">
      <strong>{displayName || 'Master Admin'}</strong>
      <span>Administrador</span>
    </span>
  </div>
</aside>

<div class="master-sidebar-overlay" data-master-sidebar-overlay></div>

<script>
  type ServerMetric = {
    total_bytes: number;
    used_bytes: number;
    available_bytes: number;
    percent: number;
  };

  type ServerMetricsPayload = {
    ok?: boolean;
    sampled_at?: string;
    memory?: ServerMetric;
    disk?: ServerMetric;
  };

  const BYTE_GIB = 1024 ** 3;
  const REFRESH_MS = 30_000;

  document.querySelectorAll<HTMLElement>('[data-master-server-monitor]').forEach((monitor) => {
    if (monitor.dataset.bound === 'true') return;
    monitor.dataset.bound = 'true';

    const status = monitor.querySelector<HTMLElement>('[data-server-status]');
    const statusDot = monitor.querySelector<HTMLElement>('[data-server-status-dot]');
    let sampledAt = 0;
    let loading = false;

    function formatBytes(value: number) {
      const gibibytes = Math.max(0, Number(value || 0)) / BYTE_GIB;
      const maximumFractionDigits = gibibytes >= 10 ? 0 : 1;
      return `${new Intl.NumberFormat('es', {
        minimumFractionDigits: maximumFractionDigits,
        maximumFractionDigits,
      }).format(gibibytes)} GB`;
    }

    function level(percent: number) {
      if (percent >= 85) return 'danger';
      if (percent >= 70) return 'warning';
      return 'healthy';
    }

    function updateMetric(name: 'memory' | 'disk', metric: ServerMetric) {
      const row = monitor.querySelector<HTMLElement>(`[data-server-metric="${name}"]`);
      if (!row) return;
      const value = row.querySelector<HTMLElement>('[data-server-metric-value]');
      const percent = row.querySelector<HTMLElement>('[data-server-metric-percent]');
      const progress = row.querySelector<HTMLElement>('[data-server-metric-progress]');
      const bar = row.querySelector<HTMLElement>('[data-server-metric-bar]');
      const safePercent = Math.min(100, Math.max(0, Number(metric.percent || 0)));
      if (value) value.textContent = `${formatBytes(metric.used_bytes)} / ${formatBytes(metric.total_bytes)}`;
      if (percent) percent.textContent = `${new Intl.NumberFormat('es', { maximumFractionDigits: 1 }).format(safePercent)}%`;
      if (bar) bar.style.width = `${safePercent}%`;
      row.dataset.level = level(safePercent);
      progress?.setAttribute('aria-valuenow', String(safePercent));
      progress?.setAttribute('aria-valuetext', `${safePercent}% utilizado`);
    }

    function setUnavailable() {
      monitor.setAttribute('aria-busy', 'false');
      monitor.dataset.state = 'unavailable';
      sampledAt = 0;
      monitor.querySelectorAll<HTMLElement>('[data-server-metric]').forEach((row) => {
        delete row.dataset.level;
        const value = row.querySelector<HTMLElement>('[data-server-metric-value]');
        const percent = row.querySelector<HTMLElement>('[data-server-metric-percent]');
        const progress = row.querySelector<HTMLElement>('[data-server-metric-progress]');
        const bar = row.querySelector<HTMLElement>('[data-server-metric-bar]');
        if (value) value.textContent = 'No disponible';
        if (percent) percent.textContent = '—';
        if (bar) bar.style.width = '0%';
        progress?.removeAttribute('aria-valuenow');
        progress?.setAttribute('aria-valuetext', 'Información temporalmente no disponible');
      });
      if (status) status.textContent = 'Información temporalmente no disponible';
      if (statusDot) statusDot.title = 'Sin conexión con el monitor';
    }

    function updateFreshness() {
      if (!sampledAt || !status) return;
      const seconds = Math.max(0, Math.floor((Date.now() - sampledAt) / 1000));
      if (seconds < 10) status.textContent = 'Actualizado ahora';
      else if (seconds < 60) status.textContent = `Actualizado hace ${seconds} s`;
      else status.textContent = `Actualizado hace ${Math.floor(seconds / 60)} min`;
    }

    async function loadMetrics() {
      if (loading || document.visibilityState === 'hidden') return;
      loading = true;
      monitor.setAttribute('aria-busy', 'true');
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 7000);
      try {
        const response = await fetch('/api/master/server-metrics', {
          method: 'GET',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { Accept: 'application/json' },
          signal: controller.signal,
        });
        const payload = await response.json() as ServerMetricsPayload;
        if (!response.ok || payload.ok !== true || !payload.memory || !payload.disk) throw new Error('metrics_unavailable');
        updateMetric('memory', payload.memory);
        updateMetric('disk', payload.disk);
        const parsedSample = new Date(String(payload.sampled_at || '')).getTime();
        sampledAt = Number.isFinite(parsedSample) ? parsedSample : Date.now();
        monitor.dataset.state = 'ready';
        monitor.setAttribute('aria-busy', 'false');
        if (statusDot) statusDot.title = 'Monitor conectado';
        updateFreshness();
      } catch (_) {
        setUnavailable();
      } finally {
        window.clearTimeout(timeout);
        loading = false;
      }
    }

    void loadMetrics();
    window.setInterval(loadMetrics, REFRESH_MS);
    window.setInterval(updateFreshness, 5000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void loadMetrics();
    });
  });
</script>
