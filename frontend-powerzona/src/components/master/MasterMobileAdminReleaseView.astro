---
import type { MasterAdminAppDetail } from '../../lib/mobileAdminReleases';

interface Props { data: MasterAdminAppDetail; channel: 'staging' | 'production' }
const { data, channel } = Astro.props;
const profile = data.profile;
const apks = data.artifacts.filter((item) => item.kind === 'apk' && item.lifecycle_status === 'available');
const latestApk = apks[0] || null;
const previewJob = data.jobs.find((item) => item.status === 'preview') || null;
const approved = !!latestApk && data.events.some((event) => ['test_approved', 'pilot_validated'].includes(event.action) && event.artifact_id === latestApk.id);
const published = !!latestApk && data.events.some((event) => event.action === 'release_published' && event.artifact_id === latestApk.id);
const defaultPackage = channel === 'staging' ? 'com.tusenda84.admin.staging' : 'com.tusenda84.admin';
const defaultAdminUrl = channel === 'staging' ? new URL('/admin', Astro.url.origin).toString() : 'https://tusenda84.com/admin';
const baselineCode = profile?.latest_version_code ?? (channel === 'staging' ? 0 : 3);
const baselineName = profile?.latest_version_name ?? (channel === 'staging' ? '' : '1.0.2');
---

<main class="admin-release" data-admin-release-root data-channel={channel} data-profile-id={profile?.id || ''}
  data-latest-version-code={latestApk?.version_code || 0} data-latest-artifact={latestApk?.id || ''}
  data-latest-file={latestApk?.file_name || ''}>
  <header class="admin-release__hero">
    <div>
      <span class="admin-release__eyebrow">TU SENDA 84 ADMIN · {channel.toUpperCase()}</span>
      <h1>Crear y publicar Mobile Admin</h1>
      <p>Configura la aplicación, crea una versión, pruébala en un dispositivo y publícala cuando esté lista.</p>
    </div>
    <span class:list={['status', `status--${profile?.status || 'unconfigured'}`]}>{profile ? 'Configurada' : 'Sin configurar'}</span>
  </header>

  <nav class="channel-tabs" aria-label="Entorno de Mobile Admin">
    <a href="?channel=staging" aria-current={channel === 'staging' ? 'page' : undefined}>Pruebas</a>
    <a href="?channel=production" aria-current={channel === 'production' ? 'page' : undefined}>Producción</a>
  </nav>

  <aside class="engine-card" aria-label="Motor de construcción">
    <div><small>Motor de construcción</small><strong>{data.engine.name} {data.engine.version}</strong></div>
    <div><small>Contrato</small><strong>{data.engine.contract_version}</strong></div>
    <div><small>Próximo código Android</small><strong>{profile ? profile.next_version_code : channel === 'staging' ? 1 : 4} · automático</strong></div>
  </aside>

  <div class="notice" data-admin-release-notice role="status" hidden></div>

  <section class="panel">
    <div class="panel__title"><div><span>Paso 1</span><h2>Configurar la aplicación</h2></div><small>La identidad Android se protege al confirmar la primera compilación.</small></div>
    <form class="form-grid" data-profile-form>
      <fieldset class="group">
        <legend>Identidad Android</legend>
        <label>Paquete<input name="package_name" required readonly={profile?.identity_locked} value={profile?.package_name || defaultPackage} /></label>
        <label>Huella SHA-256 de la firma<input name="signing_cert_sha256" readonly={profile?.identity_locked} value={profile?.signing_cert_sha256 || ''} autocomplete="off" placeholder={channel === 'staging' ? 'Firma de pruebas' : 'Firma existente de producción'} /></label>
        <div class="baseline">
          <label>Versión base<input name="current_version_name" readonly={profile?.identity_locked} value={baselineName} placeholder={channel === 'staging' ? 'Vacía para una app nueva' : '1.0.2'} /></label>
          <label>Código base<input name="current_version_code" readonly={profile?.identity_locked} type="number" min="0" value={baselineCode} /></label>
        </div>
        <p>{profile?.identity_locked ? 'Identidad protegida. Las versiones futuras conservan paquete y firma.' : 'En una app nueva el código base es 0; la primera APK recibirá 1.'}</p>
      </fieldset>
      <fieldset class="group">
        <legend>Nombre y dirección</legend>
        <label>Nombre visible<input name="display_name" required value={profile?.display_name || 'Tu Senda 84 Admin'} /></label>
        <label>Dirección del panel<input name="admin_url" required type="url" value={profile?.admin_url || defaultAdminUrl} /></label>
        <label>Color de la pantalla de inicio<input name="splash_background_color" required type="color" value={profile?.splash_background_color || '#FFFFFF'} /></label>
        <details>
          <summary>Notificaciones Firebase (opcional)</summary>
          <label>Firebase project ID<input name="firebase_project_id" value="" autocomplete="off" placeholder={profile?.firebase_configured ? 'Configurado; vacío lo conserva' : 'Todavía no configurado'} /></label>
          <label>Firebase app ID<input name="firebase_app_id" value="" autocomplete="off" placeholder={profile?.firebase_configured ? 'Configurado; vacío lo conserva' : 'Todavía no configurado'} /></label>
        </details>
      </fieldset>
      <button type="submit">Guardar configuración</button>
    </form>
  </section>

  <section class="panel">
    <div class="panel__title"><div><span>Paso 2</span><h2>Elegir la apariencia</h2></div><small>PNG cuadrada de 512 a 2048 px, máximo 2 MiB.</small></div>
    <div class="brand-grid">
      <form class="brand-card" data-brand-form data-kind="icon">
        <h3>Icono de la aplicación</h3>
        <div class="brand-preview"><img alt="Vista previa del icono" data-brand-preview data-server-path={profile?.icon?.download_path || ''} /></div>
        <span>{profile?.icon ? `Revisión ${profile.icon.revision} · ${profile.icon.sha256.slice(0, 12)}…` : 'Se utilizará el icono incluido actualmente.'}</span>
        <input name="file" type="file" accept="image/png" required disabled={!profile} />
        <button type="submit" disabled={!profile}>Cambiar icono</button>
      </form>
      <form class="brand-card" data-brand-form data-kind="splash">
        <h3>Pantalla de inicio</h3>
        <div class="brand-preview brand-preview--phone" style={`background:${profile?.splash_background_color || '#FFFFFF'}`}><img alt="Vista previa de la pantalla de inicio" data-brand-preview data-server-path={profile?.splash?.download_path || ''} /></div>
        <span>{profile?.splash ? `Revisión ${profile.splash.revision} · ${profile.splash.sha256.slice(0, 12)}…` : 'Se utilizará la pantalla incluida actualmente.'}</span>
        <input name="file" type="file" accept="image/png" required disabled={!profile} />
        <button type="submit" disabled={!profile}>Cambiar pantalla</button>
      </form>
    </div>
  </section>

  <section class="panel">
    <div class="panel__title"><div><span>Paso 3</span><h2>Crear una nueva versión</h2></div><small>El código Android lo asigna el sistema.</small></div>
    <form class="form-grid form-grid--compact" data-build-preview-form>
      <label>Versión visible<input name="version_name" required pattern="[0-9]+\.[0-9]+\.[0-9]+" placeholder="1.0.3" /></label>
      <label>Código Android<output>{profile?.next_version_code || (channel === 'staging' ? 1 : 4)} · automático</output></label>
      <button type="submit" disabled={!profile}>Revisar nueva versión</button>
    </form>
    {previewJob && (
      <article class="preview" data-preview-job data-job-id={previewJob.id} data-preview-hash={previewJob.preview_hash}>
        <strong>{previewJob.version_name} ({previewJob.version_code})</strong>
        <span>Se construirá con {previewJob.engine.name} {previewJob.engine.version}. Paquete, firma, apariencia y dirección quedarán registrados.</span>
        <button type="button" data-confirm-build>Confirmar compilación</button>
      </article>
    )}
    <div class="inventory">{data.jobs.slice(0, 8).map((job) => <span><strong>{job.version_name} ({job.version_code})</strong>{job.status}</span>)}</div>
  </section>

  <section class="panel">
    <div class="panel__title"><div><span>Paso 4</span><h2>Probar y publicar</h2></div><small>Solo el Master aprueba la versión antes de entregarla.</small></div>
    {latestApk ? (
      <article class="release-ready">
        <div>
          <small>APK más reciente</small>
          <strong>{latestApk.version_name} ({latestApk.version_code})</strong>
          <span>{latestApk.file_name} · SHA-256 {latestApk.sha256.slice(0, 16)}…</span>
        </div>
        <div class="release-actions">
          <button type="button" data-download-test>1. Descargar APK de prueba</button>
          <button type="button" class="secondary" data-approve-test disabled={approved}>2. {approved ? 'APK aprobada' : 'Aprobar APK'}</button>
          <button type="button" data-publish-general disabled={!approved || published}>3. {published ? 'Actualización publicada' : 'Publicar actualización'}</button>
        </div>
      </article>
    ) : <p>Primero crea una versión y espera a que finalice la compilación.</p>}
    <p class="hint">Descárgala e instálala manualmente en tu teléfono. Apruébala únicamente después de comprobar que abre, inicia sesión y funciona correctamente.</p>
    {published && <p class="success">Esta versión está disponible automáticamente para todos los administradores activos que usen un dispositivo autorizado, incluidos los que se creen después.</p>}
  </section>

  <section class="panel">
    <div class="panel__title"><div><span>Paso 5</span><h2>Solicitar la actualización</h2></div><small>Solo después de aprobar y publicar.</small></div>
    {profile ? <div class="policy-grid">
      <div><small>Última versión</small><strong>{profile.latest_version_name || 'Sin APK'} ({profile.latest_version_code})</strong></div>
      <div><small>Versión mínima</small><strong>{profile.minimum_supported_version_code || 'No obligatoria'}</strong></div>
      <button type="button" data-require-latest disabled={!published || !latestApk}>Hacer actualización obligatoria</button>
      <button type="button" class="secondary" data-disable-minimum disabled={!profile.minimum_supported_version_code}>Dejar de exigir actualización</button>
    </div> : <p>Configura primero la aplicación.</p>}
  </section>
</main>

<script>
  import { pb } from '../../lib/pocketbase';
  import { configureMasterAdminApp, confirmMasterAdminAppBuild, getAdminAppErrorMessage, previewMasterAdminAppBuild, runMasterAdminAppAction, uploadMasterAdminAppBrandAsset } from '../../lib/mobileAdminReleases';
  const root = document.querySelector('[data-admin-release-root]') as HTMLElement | null;
  const notice = root?.querySelector('[data-admin-release-notice]') as HTMLElement | null;
  const baseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
  const channel = (root?.dataset.channel || 'staging') as 'staging' | 'production';
  pb.authStore.loadFromCookie(document.cookie, 'pb_auth');
  function show(message: string, error = false) { if (!notice) return; notice.hidden = false; notice.textContent = message; notice.classList.toggle('notice--error', error); notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
  function value(form: HTMLFormElement, name: string) { return String(new FormData(form).get(name) || '').trim(); }
  function reloadSoon() { window.setTimeout(() => window.location.reload(), 650); }
  async function loadBrandPreview(image: HTMLImageElement) { const path = image.dataset.serverPath || ''; if (!path) { image.hidden = true; return; } try { const response = await fetch(`${baseUrl}${path}`, { headers: { Authorization: `Bearer ${pb.authStore.token}` }, cache: 'no-store' }); if (!response.ok) throw new Error(); image.src = URL.createObjectURL(await response.blob()); } catch (_) { image.hidden = true; } }
  root?.querySelectorAll<HTMLImageElement>('[data-brand-preview]').forEach((image) => void loadBrandPreview(image));
  root?.querySelectorAll<HTMLFormElement>('[data-brand-form]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type=file]'); const image = form.querySelector<HTMLImageElement>('[data-brand-preview]');
    input?.addEventListener('change', () => { const file = input.files?.[0]; if (file && image) { image.hidden = false; image.src = URL.createObjectURL(file); } });
    form.addEventListener('submit', async (event) => { event.preventDefault(); const file = input?.files?.[0]; if (!file) return show('Selecciona una imagen PNG.', true); const kind = form.dataset.kind as 'icon' | 'splash'; const result = await uploadMasterAdminAppBrandAsset(baseUrl, pb.authStore.token, channel, kind, file); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show(kind === 'icon' ? 'Icono guardado.' : 'Pantalla de inicio guardada.'); reloadSoon(); });
  });
  root?.querySelector<HTMLFormElement>('[data-profile-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault(); const form = event.currentTarget as HTMLFormElement; if (!window.confirm('¿Guardar esta configuración para la próxima versión?')) return;
    const result = await configureMasterAdminApp(baseUrl, pb.authStore.token, { channel, display_name: value(form, 'display_name'), package_name: value(form, 'package_name'), current_version_name: value(form, 'current_version_name'), current_version_code: Number(value(form, 'current_version_code')), admin_url: value(form, 'admin_url'), firebase_project_id: value(form, 'firebase_project_id'), firebase_app_id: value(form, 'firebase_app_id'), signing_cert_sha256: value(form, 'signing_cert_sha256'), splash_background_color: value(form, 'splash_background_color').toUpperCase(), confirmation: 'CONFIGURAR MOBILE ADMIN' });
    if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('Configuración guardada.'); reloadSoon();
  });
  root?.querySelector<HTMLFormElement>('[data-build-preview-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const result = await previewMasterAdminAppBuild(baseUrl, pb.authStore.token, { channel, version_name: value(form, 'version_name') }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('Revisión preparada.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-confirm-build]')?.addEventListener('click', async () => { if (!window.confirm('¿Confirmas la creación de esta APK con la configuración mostrada?')) return; const card = root?.querySelector('[data-preview-job]') as HTMLElement; const result = await confirmMasterAdminAppBuild(baseUrl, pb.authStore.token, { job_id: card.dataset.jobId || '', preview_hash: card.dataset.previewHash || '', confirmation: 'CONFIRMAR BUILD MOBILE ADMIN' }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('Compilación enviada al runner.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-download-test]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement; const artifact = root?.dataset.latestArtifact || ''; const filename = root?.dataset.latestFile || '';
    if (!artifact || !filename) return show('No hay una APK disponible.', true); button.disabled = true;
    try { const response = await fetch(`${baseUrl}/api/pz/master/admin-app-artifacts/${encodeURIComponent(artifact)}/${encodeURIComponent(filename)}`, { headers: { Authorization: `Bearer ${pb.authStore.token}` }, cache: 'no-store' }); if (!response.ok) throw new Error(); const url = URL.createObjectURL(await response.blob()); const link = document.createElement('a'); link.href = url; link.download = filename; document.body.append(link); link.click(); link.remove(); window.setTimeout(() => URL.revokeObjectURL(url), 10_000); show('APK descargada. Instálala y comprueba su funcionamiento antes de aprobar.'); } catch (_) { show('No se pudo descargar la APK de prueba.', true); } finally { button.disabled = false; }
  });
  root?.querySelector<HTMLButtonElement>('[data-approve-test]')?.addEventListener('click', async () => { if (!window.confirm('¿Confirmas que instalaste esta APK y que abre, inicia sesión y funciona correctamente?')) return; const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'approve_test', artifact_id: root?.dataset.latestArtifact || '', confirmation: 'APROBAR APK MOBILE ADMIN' }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('APK aprobada para publicación.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-publish-general]')?.addEventListener('click', async () => { if (!window.confirm('¿Publicar esta actualización para todos los administradores activos con un dispositivo autorizado?')) return; const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'publish_general', artifact_id: root?.dataset.latestArtifact || '', confirmation: 'PUBLICAR MOBILE ADMIN PARA TODOS' }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('Actualización publicada para todos los administradores autorizados.'); reloadSoon(); });
  async function setMinimum(versionCode: number) { const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'set_minimum', profile_id: root?.dataset.profileId || '', version_code: versionCode, confirmation: `EXIGIR VERSION ${versionCode}` }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show(versionCode ? 'La actualización será solicitada por la app.' : 'La actualización dejó de ser obligatoria.'); reloadSoon(); }
  root?.querySelector<HTMLButtonElement>('[data-require-latest]')?.addEventListener('click', () => { const code = Number(root?.dataset.latestVersionCode || 0); if (code && window.confirm('¿Solicitar esta versión a las instalaciones anteriores?')) void setMinimum(code); });
  root?.querySelector<HTMLButtonElement>('[data-disable-minimum]')?.addEventListener('click', () => { if (window.confirm('¿Dejar de exigir temporalmente la actualización?')) void setMinimum(0); });
</script>

<style>
  .admin-release{display:grid;gap:18px;color:#0f172a}.admin-release__hero{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;padding:24px;border-radius:20px;background:linear-gradient(135deg,#111827,#312e81);color:#fff}.admin-release__hero h1{margin:6px 0;font-size:clamp(28px,5vw,42px)}.admin-release__hero p{max-width:760px;margin:0;color:#c7d2fe;line-height:1.55}.admin-release__eyebrow{font-size:11px;font-weight:900;letter-spacing:.12em}.channel-tabs{display:flex;gap:8px}.channel-tabs a{border:1px solid #cbd5e1;border-radius:999px;background:#fff;color:#334155;padding:9px 14px;text-decoration:none;font-size:13px;font-weight:900}.channel-tabs a[aria-current="page"]{border-color:#312e81;background:#eef2ff;color:#3730a3}.status{border-radius:999px;padding:7px 11px;font-size:12px;font-weight:900;background:#e2e8f0;color:#334155}.status--active{background:#dcfce7;color:#166534}.engine-card{display:grid;grid-template-columns:2fr .6fr 1fr;gap:12px;border:1px solid #c7d2fe;border-radius:16px;background:#eef2ff;padding:15px}.engine-card div,.policy-grid>div{display:grid;gap:4px}.engine-card small,.policy-grid small{color:#64748b}.panel{display:grid;gap:16px;border:1px solid #dbe3ef;border-radius:18px;background:#fff;padding:20px;box-shadow:0 12px 35px rgba(15,23,42,.06)}.panel__title{display:flex;justify-content:space-between;gap:12px;align-items:start}.panel__title div{display:grid;gap:4px}.panel__title h2{margin:0;font-size:20px}.panel__title span{font-size:12px;font-weight:900;color:#4338ca}.panel__title small,.hint{color:#64748b}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.group{display:grid;gap:12px;min-width:0;border:1px solid #e2e8f0;border-radius:14px;padding:16px}.group legend{padding:0 7px;font-weight:900}.group p,.brand-card span{margin:0;color:#64748b;font-size:12px}.baseline{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid label,.brand-card label{display:grid;gap:6px;color:#475569;font-size:12px;font-weight:900}.form-grid>button{grid-column:1/-1}.form-grid--compact{grid-template-columns:1fr 1fr auto;align-items:end}.form-grid output{display:flex;align-items:center;min-height:42px;border:1px solid #cbd5e1;border-radius:10px;background:#f8fafc;padding:9px 11px;font-weight:900}.brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.brand-card{display:grid;gap:11px;border:1px solid #e2e8f0;border-radius:14px;padding:16px}.brand-card h3{margin:0}.brand-preview{display:grid;place-items:center;width:132px;height:132px;border-radius:28px;background:#f1f5f9;overflow:hidden}.brand-preview--phone{width:150px;height:220px;border:5px solid #111827;border-radius:24px}.brand-preview img{width:82%;height:82%;object-fit:contain}input,select,button{min-height:42px;border-radius:10px;border:1px solid #cbd5e1;padding:9px 11px;font:inherit}input[readonly]{background:#f1f5f9;color:#475569}button{background:#111827;color:#fff;border-color:#111827;font-weight:900;cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}.secondary{background:#fff;color:#334155}.notice{border:1px solid #bbf7d0;border-radius:12px;background:#f0fdf4;color:#166534;padding:13px;overflow-wrap:anywhere}.notice--error{border-color:#fecaca;background:#fff1f2;color:#991b1b}.preview{display:grid;gap:10px;border:1px solid #c7d2fe;border-radius:14px;background:#eef2ff;padding:15px}.inventory{display:grid;gap:9px}.inventory span{display:flex;justify-content:space-between;border-top:1px solid #eef2f7;padding-top:8px}.release-ready{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;border:1px solid #c7d2fe;border-radius:15px;background:#f8faff;padding:16px}.release-ready>div:first-child{display:grid;gap:5px}.release-ready small,.release-ready span{color:#64748b}.release-actions{display:flex;flex-wrap:wrap;gap:9px}.success{border-radius:12px;background:#dcfce7;color:#166534;padding:12px}.policy-grid{display:grid;grid-template-columns:1fr 1fr auto auto;gap:12px;align-items:end}@media(max-width:900px){.form-grid,.form-grid--compact,.brand-grid,.engine-card,.policy-grid,.release-ready{grid-template-columns:1fr}.release-actions{display:grid}.admin-release__hero,.panel__title{flex-direction:column}.baseline{grid-template-columns:1fr}.form-grid>button{grid-column:auto}}
</style>
