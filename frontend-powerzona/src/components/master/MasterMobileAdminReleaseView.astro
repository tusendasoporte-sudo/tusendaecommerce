---
import type { MasterAdminAppDetail } from '../../lib/mobileAdminReleases';

interface Props { data: MasterAdminAppDetail; channel: 'prepare' | 'publication' }
const { data, channel } = Astro.props;
const preparing = channel === 'prepare';
const profile = data.profile;
const releaseActions = ['release_published', 'release_resumed', 'release_paused', 'release_withdrawn'];
const stateFor = (artifactId: string) => {
  const action = data.events.find((event) => event.artifact_id === artifactId && releaseActions.includes(event.action))?.action || '';
  if (action === 'release_paused') return 'paused';
  if (action === 'release_withdrawn') return 'withdrawn';
  if (action === 'release_published' || action === 'release_resumed') return 'published';
  return 'draft';
};
const approvedFor = (artifactId: string) => data.events.some((event) => ['test_approved', 'pilot_validated'].includes(event.action) && event.artifact_id === artifactId);
const apks = data.artifacts
  .filter((item) => item.kind === 'apk' && item.lifecycle_status === 'available')
  .sort((left, right) => right.version_code - left.version_code);
const currentRelease = apks.find((item) => stateFor(item.id) !== 'draft') || null;
const currentState = currentRelease ? stateFor(currentRelease.id) : 'none';
const testApk = apks.find((item) => stateFor(item.id) === 'draft') || null;
const testApproved = !!testApk && approvedFor(testApk.id);
const candidate = testApproved ? testApk : null;
const previewJob = data.jobs.find((item) => item.status === 'preview') || null;
const candidateJob = candidate ? data.jobs.find((item) => item.id === candidate.job_id) : null;
const currentJob = currentRelease ? data.jobs.find((item) => item.id === currentRelease.job_id) : null;
const engineReady = data.engine.ready === true;
const activeExecutionJob = data.jobs.find((item) => ['queued', 'claimed'].includes(item.status)) || null;
const retryableJob = data.jobs.find((item) => ['failed', 'needs_attention'].includes(item.status)) || null;
const runnerControl = data.runner_control;
const compatibleRegisteredRunner = runnerControl.agents.find((agent) => agent.compatible) || null;
const compatibleOnlineRunner = runnerControl.agents.find((agent) => agent.compatible && agent.online) || null;
const runnerAuthorizationActive = runnerControl.authorization_state === 'authorized';
const runnerCanStart = activeExecutionJob?.status === 'queued' && !!compatibleRegisteredRunner;
const pushHealth = data.notification_health;
const pushSummary = pushHealth.summary;
const defaultPackage = 'com.tusenda84.admin';
const defaultAdminUrl = 'https://tusenda84.com/admin';
const baselineCode = profile?.latest_version_code ?? 3;
const baselineName = profile?.latest_version_name ?? '1.0.2';
const customBranding = !!(profile?.icon || profile?.splash);
const existingApp = !!currentRelease || candidateJob?.operation === 'update' || baselineCode > 0;
const publishLabel = existingApp ? 'Publicar actualización' : 'Publicar primera versión';
const stateLabel = currentState === 'published' ? 'Publicada' : currentState === 'paused' ? 'Pausada temporalmente' : currentState === 'withdrawn' ? 'Retirada' : 'Sin publicación';
---

<main class="admin-release" data-admin-release-root data-channel={channel} data-profile-id={profile?.id || ''}
  data-test-artifact={testApk?.id || ''} data-test-file={testApk?.file_name || ''}
  data-publish-artifact={candidate?.id || ''} data-current-artifact={currentRelease?.id || ''}
  data-current-file={currentRelease?.file_name || ''} data-current-version-code={currentRelease?.version_code || 0}
  data-custom-branding={customBranding ? 'true' : 'false'}>
  <header class="admin-release__hero">
    <div>
      <span class="admin-release__eyebrow">TU SENDA 84 ADMIN</span>
      <h1>{preparing ? 'Preparar y probar' : 'Publicación'}</h1>
      <p>{preparing
        ? 'Configura la próxima versión y construye una única APK final desde el panel Master de producción.'
        : 'Publica exactamente la APK aprobada, sin reconstruirla, y controla su disponibilidad para los administradores.'}</p>
    </div>
    <span class:list={['status', profile && 'status--active']}>{profile ? 'Identidad configurada' : 'Sin configurar'}</span>
  </header>

  <nav class="channel-tabs" aria-label="Flujo de Mobile Admin">
    <a href="?channel=prepare" aria-current={preparing ? 'page' : undefined}>Preparar y probar</a>
    <a href="?channel=publication" aria-current={!preparing ? 'page' : undefined}>Publicación</a>
  </nav>

  <aside class="single-apk-policy" role="note">
    <strong>Una sola APK Admin</strong>
    <span>Staging sirve para desarrollar y validar cambios de código. La APK se construye desde Master en producción; descargarla, probarla, aprobarla y publicarla siempre reutiliza el mismo archivo y el mismo SHA-256.</span>
  </aside>

  <aside class="engine-card" aria-label="Motor de construcción">
    <div><small>Motor que construirá la APK</small><strong>{data.engine.name} {data.engine.version}</strong></div>
    <div><small>Revisión aprobada</small><strong>{data.engine.revision ? data.engine.revision.slice(0, 12) : 'Sin configurar'}</strong></div>
    <div><small>API fijada dentro de la app</small><strong>{data.engine.api_base_url}</strong></div>
    <div><small>Próximo código Android</small><strong>{profile?.next_version_code || 4} · automático</strong></div>
    <div><small>Notificaciones Firebase</small><strong>{data.engine.firebase_required ? 'Obligatorias · verificadas al construir' : 'Configuración inválida'}</strong></div>
  </aside>

  {!engineReady && (
    <aside class="engine-warning" role="alert">
      El motor Admin todavía no tiene una revisión Git exacta aprobada en el backend. El panel permite configurar la identidad, pero bloquea nuevas vistas previas hasta completar esa configuración.
    </aside>
  )}

  <section class="notification-health" aria-label="Salud de notificaciones Mobile Admin">
    <div class="notification-health__title">
      <div><small>Notificaciones de la app Admin</small><strong>Firebase + recuperación automática</strong></div>
      <span class:list={['health-state', pushHealth.available && 'health-state--ready']}>{pushHealth.available ? 'Monitoreo activo' : 'Pendiente de migración'}</span>
    </div>
    <div class="notification-health__metrics">
      <div><small>Instalaciones activas</small><strong>{pushSummary.active_installations}</strong></div>
      <div><small>Credencial protegida</small><strong>{pushSummary.credential_ready}</strong></div>
      <div><small>Firebase registrado</small><strong>{pushSummary.firebase_registered}</strong></div>
      <div><small>Permiso concedido</small><strong>{pushSummary.permission_granted}</strong></div>
      <div><small>Avisos habilitados</small><strong>{pushSummary.notifications_enabled}</strong></div>
      <div><small>Sincronizadas en 24 h</small><strong>{pushSummary.synced_24h}</strong></div>
    </div>
    <p>Entregas observadas en 7 días: Firebase {pushSummary.delivery_triggers.fcm}, apertura {pushSummary.delivery_triggers.foreground_poll}, reanudación {pushSummary.delivery_triggers.resume_sync} y segundo plano {pushSummary.delivery_triggers.workmanager}.</p>
  </section>

  <div class="notice" data-admin-release-notice role="status" hidden></div>

  {preparing ? (
    <>
      <section class="panel">
        <div class="panel__title"><div><span>Paso 1</span><h2>Configurar la aplicación</h2></div><small>Una sola identidad para la APK de producción.</small></div>
        <form class="form-grid" data-profile-form>
          <fieldset class="group">
            <legend>Identidad Android</legend>
            <label>Paquete<input name="package_name" required readonly={profile?.identity_locked} value={profile?.package_name || defaultPackage} /></label>
            <label>Huella SHA-256 de la firma existente<input name="signing_cert_sha256" readonly={profile?.identity_locked} value={profile?.signing_cert_sha256 || ''} autocomplete="off" placeholder="Firma de la aplicación instalada" /></label>
            <div class="baseline">
              <label>Versión instalada<input name="current_version_name" readonly={profile?.identity_locked} value={baselineName} /></label>
              <label>Código instalado<input name="current_version_code" readonly={profile?.identity_locked} type="number" min="0" value={baselineCode} /></label>
            </div>
            <p>{profile?.identity_locked ? 'Paquete, firma y secuencia protegidos después de la primera construcción.' : 'Estos datos deben coincidir con la aplicación que ya está instalada.'}</p>
          </fieldset>
          <fieldset class="group">
            <legend>Nombre y dirección</legend>
            <label>Nombre visible<input name="display_name" required value={profile?.display_name || 'Tu Senda 84 Admin'} /></label>
            <label>Dirección del panel<input name="admin_url" required type="url" value={profile?.admin_url || defaultAdminUrl} /></label>
            <label>Color de la pantalla de inicio<input name="splash_background_color" required type="color" value={profile?.splash_background_color || '#FFFFFF'} /></label>
            <div class="required-capability"><strong>Notificaciones Firebase incluidas</strong><span>El motor impide construir si falta la configuración existente.</span></div>
          </fieldset>
          <button type="submit">Guardar configuración</button>
        </form>
      </section>

      <section class="panel">
        <div class="panel__title"><div><span>Paso 2</span><h2>Elegir la apariencia</h2></div><small>Las imágenes del motor se usan por defecto.</small></div>
        <label class="branding-toggle">
          <input type="checkbox" data-branding-toggle checked={customBranding} disabled={!profile} />
          <span><strong>Personalizar icono y pantalla de inicio</strong><small>Desactivado usa las imágenes de {data.engine.name} {data.engine.version}.</small></span>
        </label>
        <div class="engine-brand" data-engine-brand hidden={customBranding}>
          <strong>Apariencia incluida en el motor</strong>
          <span>No necesitas cargar imágenes para construir la aplicación.</span>
        </div>
        <div class="brand-grid" data-brand-controls hidden={!customBranding}>
          <form class="brand-card" data-brand-form data-kind="icon">
            <h3>Icono de la aplicación</h3>
            <div class="brand-preview"><img alt="Vista previa del icono" data-brand-preview data-server-path={profile?.icon?.download_path || ''} /></div>
            <span>{profile?.icon ? `Revisión ${profile.icon.revision} · ${profile.icon.sha256.slice(0, 12)}…` : 'Sin personalizar; se usará el icono del motor.'}</span>
            <input name="file" type="file" accept="image/png" required disabled={!profile} />
            <button type="submit" disabled={!profile}>Cambiar icono</button>
          </form>
          <form class="brand-card" data-brand-form data-kind="splash">
            <h3>Pantalla de inicio</h3>
            <div class="brand-preview brand-preview--phone" style={`background:${profile?.splash_background_color || '#FFFFFF'}`}><img alt="Vista previa de la pantalla de inicio" data-brand-preview data-server-path={profile?.splash?.download_path || ''} /></div>
            <span>{profile?.splash ? `Revisión ${profile.splash.revision} · ${profile.splash.sha256.slice(0, 12)}…` : 'Sin personalizar; se usará la pantalla del motor.'}</span>
            <input name="file" type="file" accept="image/png" required disabled={!profile} />
            <button type="submit" disabled={!profile}>Cambiar pantalla</button>
          </form>
        </div>
      </section>

      <section class="panel">
        <div class="panel__title"><div><span>Paso 3</span><h2>Preparar una nueva versión</h2></div><small>La revisión no construye ni consume el código.</small></div>
        <form class="form-grid form-grid--compact" data-build-preview-form>
          <label>Versión visible<input name="version_name" required pattern="[0-9]+\.[0-9]+\.[0-9]+" placeholder="1.0.3" /></label>
          <label>Código Android<output>{profile?.next_version_code || 4} · automático</output></label>
          <button type="submit" disabled={!profile || !engineReady || !!previewJob || !!activeExecutionJob}>Revisar configuración</button>
        </form>
        {previewJob && (
          <article class="preview" data-preview-job data-job-id={previewJob.id} data-preview-hash={previewJob.preview_hash}>
            <strong>{previewJob.version_name} ({previewJob.version_code})</strong>
            <span>Se construirá la única APK candidata con {previewJob.engine.name} {previewJob.engine.version} · revisión {previewJob.engine.revision.slice(0, 12)}, Firebase obligatorio y la apariencia seleccionada.</span>
            <div class="release-actions">
              <button type="button" data-confirm-build disabled={!engineReady}>Confirmar trabajo</button>
              <button type="button" class="secondary" data-cancel-build data-job-id={previewJob.id}>Cancelar vista previa</button>
            </div>
          </article>
        )}
        <div class="inventory">{data.jobs.slice(0, 8).map((job) => <span><strong>{job.version_name} ({job.version_code})</strong>{job.status}</span>)}</div>
      </section>

      <section class="panel runner-panel">
        <div class="panel__title"><div><span>Constructor privado</span><h2>Runner Admin independiente</h2></div><small>Solo puede reclamar el trabajo que autorices expresamente.</small></div>
        {activeExecutionJob ? (
          <article class="runner-status">
            <div>
              <small>Trabajo {activeExecutionJob.id}</small>
              <strong>{activeExecutionJob.status === 'claimed' ? 'Compilación en curso' : runnerAuthorizationActive ? 'Autorizado; esperando al Runner Admin' : 'Confirmado; falta autorizar el Runner Admin'}</strong>
              <span>Motor {activeExecutionJob.engine.version} · revisión {activeExecutionJob.engine.revision.slice(0, 12)}</span>
              <span>{compatibleOnlineRunner
                ? 'Runner compatible conectado.'
                : compatibleRegisteredRunner
                  ? 'Runner compatible registrado. Abre el acceso directo de la PC después de autorizar.'
                  : 'Falta registrar un Runner Admin compatible desde la PC de compilación.'}</span>
            </div>
            <div class="release-actions">
              {activeExecutionJob.status === 'queued' && !runnerAuthorizationActive && (
                <button type="button" data-start-admin-runner data-job-id={activeExecutionJob.id} data-preview-hash={activeExecutionJob.preview_hash} disabled={!runnerCanStart}>
                  Autorizar Runner Admin
                </button>
              )}
              {activeExecutionJob.status === 'queued' && (
                <button type="button" class="secondary" data-cancel-build data-job-id={activeExecutionJob.id}>Cancelar trabajo</button>
              )}
            </div>
            {runnerAuthorizationActive && (
              <p class="runner-instruction">Autorización de un solo uso preparada para <strong>{runnerControl.authorized_runner_id}</strong>. Si es manual, abre ahora “Tu Senda 84 - Construir App Admin”; caduca en {Math.round(runnerControl.authorization_ttl_seconds / 60)} minutos.</p>
            )}
          </article>
        ) : retryableJob ? (
          <article class="runner-status runner-status--error">
            <div><small>Último intento</small><strong>{retryableJob.version_name} ({retryableJob.version_code}) necesita atención</strong><span>Código: {retryableJob.failure_code || 'runner_failed'}</span></div>
            <button type="button" data-retry-build data-job-id={retryableJob.id} data-preview-hash={retryableJob.preview_hash}>Reintentar el mismo trabajo</button>
          </article>
        ) : (
          <p>Al confirmar una vista previa aparecerá aquí la autorización del Runner Admin. El runner de clientes no puede reclamar estos trabajos.</p>
        )}
      </section>

      <section class="panel">
        <div class="panel__title"><div><span>Paso 4</span><h2>Probar y aprobar</h2></div><small>Publicar después no genera otra APK.</small></div>
        {testApk ? (
          <article class="release-ready">
            <div><small>APK candidata</small><strong>{testApk.version_name} ({testApk.version_code})</strong><span>{testApk.file_name} · SHA-256 {testApk.sha256.slice(0, 16)}…</span></div>
            <div class="release-actions">
              <button type="button" data-download-test>Descargar APK de prueba</button>
              <button type="button" class="secondary" data-approve-test disabled={testApproved}>{testApproved ? 'APK aprobada' : 'Aprobar APK'}</button>
              {!testApproved && <button type="button" class="danger" data-discard-candidate>Descartar candidata</button>}
            </div>
          </article>
        ) : <p>Cuando construyas una APK candidata aparecerá aquí para descargarla y probarla.</p>}
        <p class="hint">Esta es la única APK. La aprobación no publica ni recompila nada; después podrás publicar exactamente este mismo checksum.</p>
      </section>
    </>
  ) : (
    <>
      <section class="panel">
        <div class="panel__title"><div><span>Versión actual</span><h2>Aplicación publicada</h2></div><span class:list={['release-state', `release-state--${currentState}`]}>{stateLabel}</span></div>
        {currentRelease ? (
          <article class="publication-card">
            <div class="publication-summary">
              <strong>{currentRelease.version_name} ({currentRelease.version_code})</strong>
              <span>{currentRelease.file_name}</span>
              <span class="checksum">SHA-256 {currentRelease.sha256}</span>
              <small>{Math.max(1, Math.round(currentRelease.bytes / 1024))} KiB · {new Date(currentRelease.created).toLocaleString('es')}</small>
            </div>
            <button type="button" class="secondary" data-download-current>Descargar APK publicada</button>
            <details class="technical-details">
              <summary>Detalles técnicos</summary>
              <dl><div><dt>Motor</dt><dd>{currentJob?.engine.name || data.engine.name} {currentJob?.engine.version || data.engine.version}</dd></div><div><dt>API nativa</dt><dd>{currentJob?.engine.api_base_url || data.engine.api_base_url}</dd></div><div><dt>Paquete</dt><dd>{profile?.package_name}</dd></div><div><dt>Firebase</dt><dd>Incluido obligatoriamente</dd></div></dl>
            </details>
          </article>
        ) : profile && baselineCode > 0 ? (
          <article class="empty-publication"><strong>Versión instalada registrada: {baselineName} ({baselineCode})</strong><span>La APK actual todavía no ha sido incorporada al almacenamiento privado.</span></article>
        ) : <p>Todavía no hay una versión publicada.</p>}
      </section>

      <section class="panel">
        <div class="panel__title"><div><span>Siguiente versión</span><h2>Lista para publicar</h2></div><small>Se utiliza el mismo archivo y SHA-256 aprobados en la prueba.</small></div>
        {candidate ? (
          <article class="release-ready">
            <div><strong>{candidate.version_name} ({candidate.version_code})</strong><span>{candidate.file_name}</span><span class="checksum">SHA-256 {candidate.sha256}</span></div>
            <button type="button" data-publish-general>{publishLabel}</button>
          </article>
        ) : testApk ? <p>La APK {testApk.version_name} ({testApk.version_code}) todavía debe aprobarse en <a href="?channel=prepare">Preparar y probar</a>.</p>
          : <p>No hay una APK aprobada pendiente de publicación.</p>}
      </section>

      {currentRelease && (
        <section class="panel">
          <div class="panel__title"><div><span>Control</span><h2>Actualización</h2></div><small>Estas acciones no modifican ni reconstruyen la APK.</small></div>
          {currentState === 'published' && (
            <div class="policy-grid">
              <div><small>Entrega</small><strong>Disponible</strong></div>
              <div><small>Actualización obligatoria</small><strong>{profile?.minimum_supported_version_code === currentRelease.version_code ? 'Sí' : 'No'}</strong></div>
              <button type="button" data-require-latest disabled={profile?.minimum_supported_version_code === currentRelease.version_code}>Hacer actualización obligatoria</button>
              {profile?.minimum_supported_version_code === currentRelease.version_code && <button type="button" class="secondary" data-disable-minimum>Volver a opcional</button>}
              <details class="more-actions"><summary>Más acciones</summary><button type="button" class="secondary" data-pause-release>Pausar temporalmente</button><button type="button" class="danger" data-withdraw-release>Retirar publicación</button></details>
            </div>
          )}
          {currentState === 'paused' && <div class="paused-actions"><p>Las nuevas descargas están pausadas. Las aplicaciones instaladas no se eliminan.</p><button type="button" data-resume-release>Reanudar publicación</button><details class="more-actions"><summary>Más acciones</summary><button type="button" class="danger" data-withdraw-release>Retirar publicación</button></details></div>}
          {currentState === 'withdrawn' && <p class="withdrawn-message">Esta publicación fue retirada. Para volver a distribuir la aplicación prepara y aprueba una versión posterior.</p>}
        </section>
      )}
    </>
  )}
</main>

<script>
  import { pb } from '../../lib/pocketbase';
  import { configureMasterAdminApp, confirmMasterAdminAppBuild, getAdminAppErrorMessage, previewMasterAdminAppBuild, runMasterAdminAppAction, startMasterAdminAppRunner, uploadMasterAdminAppBrandAsset } from '../../lib/mobileAdminReleases';
  const root = document.querySelector('[data-admin-release-root]') as HTMLElement | null;
  const notice = root?.querySelector('[data-admin-release-notice]') as HTMLElement | null;
  const baseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
  pb.authStore.loadFromCookie(document.cookie, 'pb_auth');
  function show(message: string, error = false) { if (!notice) return; notice.hidden = false; notice.textContent = message; notice.classList.toggle('notice--error', error); notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
  function value(form: HTMLFormElement, name: string) { return String(new FormData(form).get(name) || '').trim(); }
  function reloadSoon() { window.setTimeout(() => window.location.reload(), 650); }
  async function loadBrandPreview(image: HTMLImageElement) { const path = image.dataset.serverPath || ''; if (!path) { image.hidden = true; return; } try { const response = await fetch(`${baseUrl}${path}`, { headers: { Authorization: `Bearer ${pb.authStore.token}` }, cache: 'no-store' }); if (!response.ok) throw new Error(); image.src = URL.createObjectURL(await response.blob()); } catch (_) { image.hidden = true; } }
  async function downloadArtifact(artifact: string, filename: string, success: string) { if (!artifact || !filename) return show('No hay una APK disponible.', true); try { const response = await fetch(`${baseUrl}/api/pz/master/admin-app-artifacts/${encodeURIComponent(artifact)}/${encodeURIComponent(filename)}`, { headers: { Authorization: `Bearer ${pb.authStore.token}` }, cache: 'no-store' }); if (!response.ok) throw new Error(); const url = URL.createObjectURL(await response.blob()); const link = document.createElement('a'); link.href = url; link.download = filename; document.body.append(link); link.click(); link.remove(); window.setTimeout(() => URL.revokeObjectURL(url), 10_000); show(success); } catch (_) { show('No se pudo descargar la APK.', true); } }
  root?.querySelectorAll<HTMLImageElement>('[data-brand-preview]').forEach((image) => void loadBrandPreview(image));
  root?.querySelectorAll<HTMLFormElement>('[data-brand-form]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type=file]'); const image = form.querySelector<HTMLImageElement>('[data-brand-preview]');
    input?.addEventListener('change', () => { const file = input.files?.[0]; if (file && image) { image.hidden = false; image.src = URL.createObjectURL(file); } });
    form.addEventListener('submit', async (event) => { event.preventDefault(); const file = input?.files?.[0]; if (!file) return show('Selecciona una imagen PNG.', true); const kind = form.dataset.kind as 'icon' | 'splash'; const result = await uploadMasterAdminAppBrandAsset(baseUrl, pb.authStore.token, kind, file); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show(kind === 'icon' ? 'Icono guardado.' : 'Pantalla de inicio guardada.'); reloadSoon(); });
  });
  root?.querySelector<HTMLInputElement>('[data-branding-toggle]')?.addEventListener('change', async (event) => {
    const toggle = event.currentTarget as HTMLInputElement; const controls = root?.querySelector<HTMLElement>('[data-brand-controls]'); const engineBrand = root?.querySelector<HTMLElement>('[data-engine-brand]');
    if (toggle.checked) { if (controls) controls.hidden = false; if (engineBrand) engineBrand.hidden = true; return; }
    if (root?.dataset.customBranding === 'true') {
      if (!window.confirm('¿Volver a usar el icono y la pantalla incluidos en el motor?')) { toggle.checked = true; return; }
      const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'use_engine_brand', profile_id: root?.dataset.profileId || '', confirmation: 'USAR IMAGENES DEL MOTOR' });
      if (!result.available) { toggle.checked = true; return show(getAdminAppErrorMessage(result.error), true); }
      show('Las próximas versiones usarán las imágenes del motor.'); return reloadSoon();
    }
    if (controls) controls.hidden = true; if (engineBrand) engineBrand.hidden = false;
  });
  root?.querySelector<HTMLFormElement>('[data-profile-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault(); const form = event.currentTarget as HTMLFormElement; if (!window.confirm('¿Guardar esta configuración para la próxima versión?')) return;
    const result = await configureMasterAdminApp(baseUrl, pb.authStore.token, { display_name: value(form, 'display_name'), package_name: value(form, 'package_name'), current_version_name: value(form, 'current_version_name'), current_version_code: Number(value(form, 'current_version_code')), admin_url: value(form, 'admin_url'), signing_cert_sha256: value(form, 'signing_cert_sha256'), splash_background_color: value(form, 'splash_background_color').toUpperCase(), confirmation: 'CONFIGURAR MOBILE ADMIN' });
    if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('Configuración guardada.'); reloadSoon();
  });
  root?.querySelector<HTMLFormElement>('[data-build-preview-form]')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const result = await previewMasterAdminAppBuild(baseUrl, pb.authStore.token, { version_name: value(form, 'version_name') }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('Configuración revisada sin construir la APK.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-confirm-build]')?.addEventListener('click', async () => { if (!window.confirm('¿Crear la APK candidata con esta configuración?')) return; const card = root?.querySelector('[data-preview-job]') as HTMLElement; const result = await confirmMasterAdminAppBuild(baseUrl, pb.authStore.token, { job_id: card.dataset.jobId || '', preview_hash: card.dataset.previewHash || '', confirmation: 'CONFIRMAR BUILD MOBILE ADMIN' }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('Compilación enviada al constructor.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-start-admin-runner]')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; if (!window.confirm('¿Autorizar al Runner Admin para ejecutar únicamente este trabajo durante los próximos 10 minutos?')) return; button.disabled = true; const result = await startMasterAdminAppRunner(baseUrl, pb.authStore.token, { job_id: button.dataset.jobId || '', preview_hash: button.dataset.previewHash || '', confirmation: 'INICIAR RUNNER ADMIN' }); if (!result.available) { button.disabled = false; return show(getAdminAppErrorMessage(result.error), true); } show(result.data?.runner.online ? 'Runner Admin autorizado y conectado.' : 'Runner Admin autorizado. Abre ahora el acceso directo en la PC de compilación.'); reloadSoon(); });
  root?.querySelectorAll<HTMLButtonElement>('[data-cancel-build]').forEach((button) => button.addEventListener('click', async () => { if (!window.confirm('¿Cancelar este trabajo de Mobile Admin?')) return; button.disabled = true; const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'cancel_build', job_id: button.dataset.jobId || '', confirmation: 'CANCELAR BUILD MOBILE ADMIN' }); if (!result.available) { button.disabled = false; return show(getAdminAppErrorMessage(result.error), true); } show('Trabajo cancelado.'); reloadSoon(); }));
  root?.querySelector<HTMLButtonElement>('[data-retry-build]')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; if (!window.confirm('¿Reintentar exactamente el mismo trabajo de Mobile Admin?')) return; button.disabled = true; const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'retry_build', job_id: button.dataset.jobId || '', preview_hash: button.dataset.previewHash || '', confirmation: 'REINTENTAR BUILD MOBILE ADMIN' }); if (!result.available) { button.disabled = false; return show(getAdminAppErrorMessage(result.error), true); } show('Trabajo preparado nuevamente. Falta autorizar el Runner Admin.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-download-test]')?.addEventListener('click', () => void downloadArtifact(root?.dataset.testArtifact || '', root?.dataset.testFile || '', 'APK descargada. Instálala y comprueba su funcionamiento antes de aprobar.'));
  root?.querySelector<HTMLButtonElement>('[data-download-current]')?.addEventListener('click', () => void downloadArtifact(root?.dataset.currentArtifact || '', root?.dataset.currentFile || '', 'APK publicada descargada.'));
  root?.querySelector<HTMLButtonElement>('[data-approve-test]')?.addEventListener('click', async () => { if (!window.confirm('¿Confirmas que instalaste esta APK y que abre, inicia sesión, recibe notificaciones y funciona correctamente?')) return; const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'approve_test', artifact_id: root?.dataset.testArtifact || '', confirmation: 'APROBAR APK MOBILE ADMIN' }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('APK aprobada. Ya puedes publicarla sin reconstruirla.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-discard-candidate]')?.addEventListener('click', async () => { if (!window.confirm('¿Descartar esta APK candidata? La versión publicada no se modificará.')) return; const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'discard_candidate', artifact_id: root?.dataset.testArtifact || '', confirmation: 'DESCARTAR APK MOBILE ADMIN' }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('APK candidata descartada.'); reloadSoon(); });
  root?.querySelector<HTMLButtonElement>('[data-publish-general]')?.addEventListener('click', async () => { if (!window.confirm('¿Publicar exactamente esta APK como actualización opcional?')) return; const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'publish_general', artifact_id: root?.dataset.publishArtifact || '', confirmation: 'PUBLICAR MOBILE ADMIN PARA TODOS' }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show('APK publicada como actualización opcional.'); reloadSoon(); });
  async function setMinimum(versionCode: number) { const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action: 'set_minimum', profile_id: root?.dataset.profileId || '', version_code: versionCode, confirmation: `EXIGIR VERSION ${versionCode}` }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show(versionCode ? 'La actualización ahora es obligatoria.' : 'La actualización volvió a ser opcional.'); reloadSoon(); }
  root?.querySelector<HTMLButtonElement>('[data-require-latest]')?.addEventListener('click', () => { const code = Number(root?.dataset.currentVersionCode || 0); if (code && window.confirm('¿Hacer obligatoria esta actualización para versiones anteriores?')) void setMinimum(code); });
  root?.querySelector<HTMLButtonElement>('[data-disable-minimum]')?.addEventListener('click', () => { if (window.confirm('¿Volver a ofrecer esta actualización como opcional?')) void setMinimum(0); });
  async function controlRelease(action: string, confirmation: string, success: string) { const result = await runMasterAdminAppAction(baseUrl, pb.authStore.token, { action, artifact_id: root?.dataset.currentArtifact || '', confirmation }); if (!result.available) return show(getAdminAppErrorMessage(result.error), true); show(success); reloadSoon(); }
  root?.querySelector<HTMLButtonElement>('[data-pause-release]')?.addEventListener('click', () => { if (window.confirm('¿Pausar temporalmente las nuevas descargas?')) void controlRelease('pause_release', 'PAUSAR PUBLICACION MOBILE ADMIN', 'Publicación pausada temporalmente.'); });
  root?.querySelector<HTMLButtonElement>('[data-resume-release]')?.addEventListener('click', () => { if (window.confirm('¿Reanudar las descargas de esta publicación?')) void controlRelease('resume_release', 'REANUDAR PUBLICACION MOBILE ADMIN', 'Publicación reanudada.'); });
  root?.querySelector<HTMLButtonElement>('[data-withdraw-release]')?.addEventListener('click', () => { if (window.confirm('¿Retirar definitivamente esta publicación? Las aplicaciones instaladas no se eliminarán.')) void controlRelease('withdraw_release', 'RETIRAR PUBLICACION MOBILE ADMIN', 'Publicación retirada.'); });
</script>

