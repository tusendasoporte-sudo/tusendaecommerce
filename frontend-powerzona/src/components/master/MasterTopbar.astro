---
import MasterIcon from './MasterIcon.astro';
import MasterNotificationsBell from './MasterNotificationsBell.astro';
import MasterNotificationsDeleteAllDialog from './MasterNotificationsDeleteAllDialog.astro';

interface Props {
  displayName: string;
  title: string;
  showCreateStore?: boolean;
}

const { displayName, title, showCreateStore = false } = Astro.props;
const initials = displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() || '')
  .join('') || 'MA';
---

<header class="master-topbar" aria-label="Cabecera global del Master">
  <div class="master-topbar__inner">
    <div class="master-topbar__leading">
      <button
        class="master-topbar__menu"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        data-master-sidebar-open
      >
        <MasterIcon name="menu" size={23} />
      </button>
      <h1 class="master-topbar__title">{title}</h1>
    </div>

    <div class="master-topbar__actions">
      {showCreateStore && (
        <button id="create-store" class="master-btn master-btn--primary" type="button">
          <MasterIcon name="stores" size={19} />
          <span>Crear tienda</span>
        </button>
      )}

      <MasterNotificationsBell />

      <div class="master-profile-menu">
        <button
          class="master-profile-menu__trigger"
          type="button"
          aria-expanded="false"
          aria-haspopup="menu"
          data-master-profile-trigger
        >
          <span class="master-profile-menu__avatar">{initials}</span>
          <span class="master-profile-menu__copy">
            <strong>{displayName || 'Master Admin'}</strong>
            <span>Administrador</span>
          </span>
          <MasterIcon name="chevron-down" size={17} />
        </button>

        <div class="master-profile-menu__panel" role="menu" hidden data-master-profile-panel>
          <button type="button" role="menuitem" data-master-global-logout>
            <MasterIcon name="logout" size={19} />
            Cerrar sesión
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<MasterNotificationsDeleteAllDialog />

<script>
  import { logout } from '../../lib/auth';

  const profileTrigger = document.querySelector<HTMLButtonElement>('[data-master-profile-trigger]');
  const profilePanel = document.querySelector<HTMLElement>('[data-master-profile-panel]');

  function closeProfileMenu(restoreFocus = false) {
    if (!profilePanel || !profileTrigger || profilePanel.hidden) return;
    profilePanel.hidden = true;
    profileTrigger.setAttribute('aria-expanded', 'false');
    if (restoreFocus) profileTrigger.focus();
  }

  profileTrigger?.addEventListener('click', () => {
    if (!profilePanel) return;
    const shouldOpen = profilePanel.hidden;
    profilePanel.hidden = !shouldOpen;
    profileTrigger.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
  });

  document.addEventListener('pointerdown', (event) => {
    const target = event.target as Node | null;
    if (!target || !profilePanel || !profileTrigger) return;
    if (profilePanel.contains(target) || profileTrigger.contains(target)) return;
    closeProfileMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeProfileMenu(true);
  });

  window.addEventListener('scroll', () => closeProfileMenu(), true);
  window.addEventListener('resize', () => closeProfileMenu());

  document.querySelectorAll<HTMLButtonElement>('[data-master-global-logout]').forEach((button) => {
    if (button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      logout();
      document.cookie = 'pb_auth=; Path=/; Max-Age=0; SameSite=Lax';
      window.location.assign('/master-login');
    });
  });
</script>
