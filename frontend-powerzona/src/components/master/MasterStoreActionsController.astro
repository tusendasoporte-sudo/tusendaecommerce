---
import MasterActionMenu from './MasterActionMenu.astro';
import MasterDialog from './MasterDialog.astro';
import MasterIcon from './MasterIcon.astro';
import MasterStoreDeleteDialog from './MasterStoreDeleteDialog.astro';
import {
  commercialMonthsLabel,
  formatCommercialCup,
  type CommercialPlanCatalog,
  type CommercialPlanDefinition,
} from '../../lib/commercialPlanCatalog';

interface Props { catalog: CommercialPlanCatalog | null }
const { catalog } = Astro.props;
const storeTypes = catalog?.store_types || [];
const promoType = storeTypes.find((item) => item.storage_code === 'promo') || null;
const ecommerceType = storeTypes.find((item) => item.storage_code === 'commerce') || null;
const ecommerceInitialPlan = ecommerceType?.plans.find((plan) => plan.code === 'free') || null;
const commercialPlanData = Object.fromEntries(storeTypes.map((storeType) => [storeType.storage_code, {
  name: storeType.name,
  plans: Object.fromEntries(storeType.plans.map((plan) => [plan.code, {
    name: plan.name,
    trialDays: plan.pricing.trial?.days || 0,
    trialTotalCup: plan.pricing.trial?.total_cup || 0,
    supportsPermanent: plan.supports_permanent,
    imageLimit: Number(plan.capabilities.max_total_images || 0),
    periods: plan.pricing.periods,
  }])),
}]));
const currencyDecimals = catalog?.currency.decimals || 0;
const cup = (value: unknown) => formatCommercialCup(value, currencyDecimals);
function planCapability(plan: CommercialPlanDefinition, key: string) {
  const value = plan.capabilities[key];
  return Number.isSafeInteger(value) ? Number(value) : value === true;
}
---

<div data-master-store-actions-controller data-commercial-plans={JSON.stringify(commercialPlanData)} data-currency-decimals={String(currencyDecimals)}>
  <MasterActionMenu id="master-security-actions" label="Acciones de Seguridad">
    <a class="master-action-menu__item" data-menu-security-view role="menuitem">
      <MasterIcon name="security" size={19} /> Ver seguridad
    </a>
    <button class="master-action-menu__item" type="button" data-menu-security-configure role="menuitem">
      <MasterIcon name="settings" size={19} /> Configurar seguridad
    </button>
  </MasterActionMenu>

  <MasterActionMenu id="master-store-actions" label="Acciones de tienda">
    <a class="master-action-menu__item" data-menu-view-store data-promo-only data-list-only role="menuitem" target="_blank" rel="noreferrer"><MasterIcon name="external" size={19} /> Ver tienda</a>
    <a class="master-action-menu__item" data-menu-analytics data-promo-only data-list-only role="menuitem"><MasterIcon name="analytics" size={19} /> Analíticas</a>
    <a class="master-action-menu__item" data-menu-products data-commerce-only data-list-only role="menuitem"><MasterIcon name="products" size={19} /> Ver productos</a>
    <button class="master-action-menu__item" type="button" data-menu-edit data-list-only role="menuitem"><MasterIcon name="edit" size={19} /> Editar</button>
    <button class="master-action-menu__item" type="button" data-menu-create-user data-list-only role="menuitem"><MasterIcon name="user-plus" size={19} /> Crear usuario</button>
    <button class="master-action-menu__item" type="button" data-menu-configure-security data-commerce-only data-overview-only role="menuitem"><MasterIcon name="settings" size={19} /> Configurar Seguridad</button>
    <button class="master-action-menu__item" type="button" data-menu-featured data-commerce-only role="menuitem"><MasterIcon name="check" size={19} /><span data-featured-label>Destacar</span></button>
    <div class="master-action-menu__separator" data-promo-only aria-hidden="true"></div>
    <button class="master-action-menu__item" type="button" data-menu-status role="menuitem"><MasterIcon name="archive" size={19} /><span data-status-label>Suspender</span></button>
    <div class="master-action-menu__separator" data-commerce-only aria-hidden="true"></div>
    <button class="master-action-menu__item master-action-menu__item--danger" type="button" data-menu-delete role="menuitem"><MasterIcon name="trash" size={19} /> Eliminar tienda</button>
    <span class="master-action-menu__item" data-menu-protected role="menuitem" aria-disabled="true" hidden><MasterIcon name="lock" size={19} /> Tienda protegida</span>
  </MasterActionMenu>

  <MasterDialog id="master-store-dialog" title="Crear tienda" description="Datos principales para publicar y administrar la tienda." tone="primary">
    <form class="master-form" data-store-form>
      <input type="hidden" name="store_id" data-store-id-input />
      <div class="master-field-grid">
        <div class="master-field master-field--full" data-store-type-field>
          <label for="master-store-type">Tipo de tienda</label>
          <select id="master-store-type" name="store_type">
            {storeTypes.map((storeType) => <option value={storeType.storage_code}>{storeType.name}</option>)}
          </select>
          <span class="master-muted">El tipo se fija al crear y mantiene sus contratos administrativos independientes.</span>
        </div>
        <div class="master-field master-field--full"><label for="master-store-name">Nombre de tienda</label><input id="master-store-name" name="name" type="text" maxlength="140" autocomplete="off" required /></div>
        <div class="master-field"><label for="master-store-slug">Slug público</label><input id="master-store-slug" name="slug" type="text" maxlength="80" autocomplete="off" required /></div>
        <div class="master-field" data-store-commerce-only><label for="master-store-phone">WhatsApp</label><input id="master-store-phone" name="owner_phone" type="tel" maxlength="60" autocomplete="off" /></div>
        {ecommerceInitialPlan && <div class="master-field master-field--full" data-store-commerce-plan hidden>
          <label>Plan inicial</label>
          <span class="master-muted">Las nuevas tiendas comienzan con {ecommerceInitialPlan.name}: {ecommerceInitialPlan.pricing.trial?.days} días, total {cup(ecommerceInitialPlan.pricing.trial?.total_cup)}. Después puedes asignar otro plan desde Plan y límites.</span>
        </div>}
        {promoType && <div class="master-field" data-store-promo-only hidden>
          <label for="master-store-promo-plan">Plan inicial</label>
          <select id="master-store-promo-plan" name="promo_plan">
            {promoType.plans.map((plan) => <option value={plan.code}>{plan.name} — {plan.pricing.trial ? `${plan.pricing.trial.days} días · ${planCapability(plan, 'max_total_images')} imágenes · total ${cup(plan.pricing.trial.total_cup)}` : `desde ${cup(plan.pricing.periods[0]?.monthly_equivalent_cup)}/mes · ${planCapability(plan, 'max_total_images')} imágenes`}</option>)}
          </select>
          <span class="master-muted">Los límites e importes se aplican desde el catálogo comercial vigente.</span>
        </div>}
        <div class="master-field" data-store-promo-basic hidden>
          <label for="master-store-promo-validity">Tipo de vigencia</label>
          <select id="master-store-promo-validity" name="promo_validity">
            <option value="temporary">Temporal</option>
            <option value="permanent">Permanente compatible · sin vencimiento</option>
          </select>
        </div>
        <div class="master-field" data-store-promo-months hidden>
          <label for="master-store-promo-months">Vigencia comercial</label>
          <select id="master-store-promo-months" name="promo_duration_months">
            {catalog?.commercial_period_months.map((months) => <option value={String(months)}>{commercialMonthsLabel(months)}</option>)}
          </select>
        </div>
        <div class="master-field master-field--full" data-store-promo-only hidden>
          <label for="master-store-promo-theme">Tema inicial</label>
          <select id="master-store-promo-theme" name="promo_theme_id">
            <option value="promo.black-gold" selected>Promo Black Gold</option>
            <option value="promo.minimal">Minimal</option>
            <option value="promo.artisan">Artesanal cálida</option>
            <option value="promo.vibrant">Vibrante moderna</option>
            <option value="promo.professional">Profesional corporativa</option>
            <option value="promo.portfolio">Portafolio editorial</option>
          </select>
          <span class="master-muted">Black Gold es el tema predeterminado. El Admin Promo puede cambiarlo después.</span>
        </div>
        <div class="master-field master-field--full" data-store-status-field><label for="master-store-status">Estado</label><select id="master-store-status" name="status"><option value="active">Activa</option><option value="suspended">Suspendida</option></select></div>
      </div>
      {catalog && <section class="master-commercial-create-summary" aria-live="polite">
        {storeTypes.flatMap((storeType) => storeType.plans.map((plan) => <article data-create-plan-summary data-summary-store-type={storeType.storage_code} data-summary-plan={plan.code} hidden>
          <strong>{storeType.name} · {plan.name}</strong>
          {plan.pricing.trial ? <p>{plan.pricing.trial.days} días · total {cup(plan.pricing.trial.total_cup)} · {planCapability(plan, storeType.storage_code === 'promo' ? 'max_total_images' : 'max_products')} {storeType.storage_code === 'promo' ? 'imágenes' : 'productos'}</p> : <div>{plan.pricing.periods.map((period) => <p>{commercialMonthsLabel(period.months)}: {cup(period.monthly_equivalent_cup)}/mes equivalente · total {cup(period.total_cup)} · ahorro {cup(period.savings_cup)} ({period.savings_percent}%)</p>)}</div>}
        </article>))}
        <p><strong>Seguridad avanzada:</strong> capacidad opcional por tienda, solo Master y apagada por defecto.</p>
      </section>}
      {!catalog && <p class="master-form-alert" role="alert">El catálogo comercial no está disponible. La creación de tiendas permanece cerrada para evitar aplicar valores locales.</p>}
      <p class="master-form-alert" data-store-form-alert role="alert" hidden></p>
    </form>
    <div slot="footer">
      <button class="master-btn master-btn--secondary" type="button" data-master-dialog-close>Cancelar</button>
      <button class="master-btn master-btn--primary" type="button" data-store-save><MasterIcon name="save" size={19} /> Guardar tienda</button>
    </div>
  </MasterDialog>

  <MasterDialog id="master-security-dialog" title="Configurar seguridad" description="Configuración privada de Seguridad para la tienda." tone="warning" size="lg">
    <form class="master-form" data-security-form>
      <input type="hidden" name="store_id" data-security-store />
      <label class="master-switch" for="master-security-enabled"><span><strong>Seguridad habilitada</strong><br /><span class="master-muted">Permite revisar y proteger la actividad de la tienda.</span></span><input id="master-security-enabled" name="enabled" type="checkbox" /></label>
      <fieldset class="master-fieldset" data-security-dependent>
        <legend>Modo</legend>
        <div class="master-choice-grid">
          <label class="master-choice"><input name="mode" type="radio" value="monitoring" /><span><strong>Solo monitoreo</strong><br />Historial visible sin protección activa.</span></label>
          <label class="master-choice"><input name="mode" type="radio" value="protection" /><span><strong>Protección activa</strong><br />Habilita las capacidades aprobadas de bloqueo.</span></label>
        </div>
      </fieldset>
      <div class="master-field-grid" data-security-dependent>
        <label class="master-switch"><span>Permitir bloqueo manual</span><input name="manual_blocking_enabled" type="checkbox" /></label>
        <label class="master-switch"><span>Bloqueo de acceso completo</span><input name="full_access_blocking_enabled" type="checkbox" data-manual-dependent /></label>
        <label class="master-switch"><span>Permitir bloqueos permanentes</span><input name="permanent_blocks_enabled" type="checkbox" data-manual-dependent /></label>
        <label class="master-switch"><span>Notificar intentos bloqueados</span><input name="notify_blocked_attempts" type="checkbox" /></label>
        <div class="master-field"><label for="master-security-retention">Retención</label><select id="master-security-retention" name="retention_days"><option value="30">30 días</option><option value="60">60 días</option><option value="90">90 días</option></select></div>
        <div class="master-field"><label for="master-security-ip">Visibilidad de IP</label><select id="master-security-ip" name="ip_visibility"><option value="hidden">Oculta</option><option value="partial">Parcial</option><option value="full">Completa</option></select></div>
        <div class="master-field"><label for="master-security-vpn">VPN, proxy y Tor</label><select id="master-security-vpn" name="vpn_policy"><option value="off">Desactivada</option><option value="monitor">Solo detectar</option><option value="block">Detectar y bloquear</option></select></div>
      </div>
      <p class="master-form-alert" data-security-form-alert role="alert" hidden></p>
    </form>
    <div slot="footer">
      <a class="master-btn master-btn--secondary" data-security-history hidden><MasterIcon name="security" size={19} /> Ver seguridad</a>
      <button class="master-btn master-btn--secondary" type="button" data-master-dialog-close>Cancelar</button>
      <button class="master-btn master-btn--primary" type="button" data-security-save><MasterIcon name="save" size={19} /> Guardar</button>
    </div>
  </MasterDialog>

  <MasterDialog id="master-store-status-dialog" title="Suspender tienda" description="Confirma el cambio de disponibilidad de esta tienda." tone="warning">
    <p class="master-card-subtitle" data-store-status-copy></p>
    <p class="master-form-alert" data-store-status-alert role="alert" hidden></p>
    <div slot="footer">
      <button class="master-btn master-btn--secondary" type="button" data-master-dialog-close>Cancelar</button>
      <button class="master-btn master-btn--danger-solid" type="button" data-store-status-confirm>Suspender tienda</button>
    </div>
  </MasterDialog>

  <MasterStoreDeleteDialog />
</div>

<script>
  import { pb } from '../../lib/pocketbase';
  import {
    createStoreFromMaster,
    normalizeStoreSlug,
    setStoreFeaturedFromMaster,
    setStoreStatusFromMaster,
    updateStoreFromMaster,
  } from '../../lib/stores';
  import {
    getDefaultSecuritySettings,
    getStoreSecuritySettings,
    normalizeSecuritySettingsPayload,
    upsertStoreSecuritySettings,
  } from '../../lib/security';
  import { navigateToMasterStoreList } from '../../lib/masterStoreNavigation';

  const controller = document.querySelector<HTMLElement>('[data-master-store-actions-controller]');
  if (controller && controller.dataset.initialized !== 'true') {
    controller.dataset.initialized = 'true';
    pb.authStore.loadFromCookie(document.cookie, 'pb_auth');

    type CreatePlan = { name: string; trialDays: number; trialTotalCup: number; supportsPermanent: boolean; imageLimit: number; periods: Array<{ months: number }> };
    type CreateCatalog = Record<'commerce' | 'promo', { name: string; plans: Record<string, CreatePlan> }>;
    const commercialCatalog = JSON.parse(String(controller.dataset.commercialPlans || '{}')) as Partial<CreateCatalog>;

    const storeMenu = controller.querySelector<HTMLElement>('#master-store-actions');
    const securityMenu = controller.querySelector<HTMLElement>('#master-security-actions');
    const storeDialog = controller.querySelector<HTMLDialogElement>('#master-store-dialog');
    const securityDialog = controller.querySelector<HTMLDialogElement>('#master-security-dialog');
    const statusDialog = controller.querySelector<HTMLDialogElement>('#master-store-status-dialog');
    const storeForm = controller.querySelector<HTMLFormElement>('[data-store-form]');
    const securityForm = controller.querySelector<HTMLFormElement>('[data-security-form]');
    let activeMenu: HTMLElement | null = null;
    let activeTrigger: HTMLButtonElement | null = null;
    let activeContext: HTMLElement | null = null;
    let pendingStatusContext: HTMLElement | null = null;
    let slugEdited = false;

    function contextFor(element: Element | null) {
      return element?.closest<HTMLElement>('[data-store-context]') || null;
    }

    function storeId(context: HTMLElement | null) {
      return String(context?.dataset.storeId || '').trim();
    }

    function setAlert(target: HTMLElement | null, message = '', success = false) {
      if (!target) return;
      target.textContent = message;
      target.hidden = !message;
      target.classList.toggle('is-success', success);
    }

    function syncCreateStoreType() {
      if (!storeForm) return;
      const id = String((storeForm.elements.namedItem('store_id') as HTMLInputElement | null)?.value || '');
      const type = String((storeForm.elements.namedItem('store_type') as HTMLSelectElement | null)?.value || 'commerce');
      const commerce = Boolean(id) || type === 'commerce';
      storeForm.querySelectorAll<HTMLElement>('[data-store-commerce-only]').forEach((field) => {
        field.hidden = !commerce;
        field.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.disabled = !commerce;
          if (!commerce) input.value = '';
        });
      });
      storeForm.querySelectorAll<HTMLElement>('[data-store-commerce-plan]').forEach((field) => { field.hidden = Boolean(id) || !commerce; });
      const promo = !id && type === 'promo';
      storeForm.querySelectorAll<HTMLElement>('[data-store-promo-only]').forEach((field) => {
        field.hidden = !promo;
        field.querySelectorAll<HTMLSelectElement>('select').forEach((input) => {
          input.disabled = !promo;
          if (!promo) input.selectedIndex = 0;
        });
      });
      syncCreatePromoPlan();
      const statusField = storeForm.querySelector<HTMLElement>('[data-store-status-field]');
      const statusInput = storeForm.elements.namedItem('status') as HTMLSelectElement | null;
      if (statusField) statusField.hidden = !commerce;
      if (statusInput) {
        statusInput.disabled = !commerce;
        if (!commerce) statusInput.value = 'active';
      }
      syncCreatePlanSummary();
    }

    function syncCreatePromoPlan() {
      if (!storeForm) return;
      const type = String((storeForm.elements.namedItem('store_type') as HTMLSelectElement | null)?.value || 'commerce');
      const plan = String((storeForm.elements.namedItem('promo_plan') as HTMLSelectElement | null)?.value || 'free');
      const definition = commercialCatalog.promo?.plans[plan];
      const paid = !storeForm.dataset.storeId && type === 'promo' && Boolean(definition) && definition.trialDays === 0;
      const validity = storeForm.elements.namedItem('promo_validity') as HTMLSelectElement | null;
      const permanentOption = validity?.querySelector<HTMLOptionElement>('option[value="permanent"]');
      if (permanentOption) permanentOption.disabled = definition?.supportsPermanent !== true;
      if (validity && definition?.supportsPermanent !== true && validity.value === 'permanent') validity.value = 'temporary';
      const permanent = paid && definition?.supportsPermanent === true && validity?.value === 'permanent';
      storeForm.querySelectorAll<HTMLElement>('[data-store-promo-basic]').forEach((field) => {
        field.hidden = !paid;
        field.querySelectorAll<HTMLSelectElement>('select').forEach((input) => {
          input.disabled = !paid;
        });
      });
      storeForm.querySelectorAll<HTMLElement>('[data-store-promo-months]').forEach((field) => {
        field.hidden = !paid || permanent;
        field.querySelectorAll<HTMLSelectElement>('select').forEach((input) => {
          input.disabled = !paid || permanent;
          if (!paid || permanent) input.selectedIndex = 0;
        });
      });
      syncCreatePlanSummary();
    }

    function syncCreatePlanSummary() {
      if (!storeForm) return;
      const editing = Boolean(String((storeForm.elements.namedItem('store_id') as HTMLInputElement | null)?.value || ''));
      const storeType = String((storeForm.elements.namedItem('store_type') as HTMLSelectElement | null)?.value || 'commerce');
      const selectedPlan = storeType === 'promo'
        ? String((storeForm.elements.namedItem('promo_plan') as HTMLSelectElement | null)?.value || '')
        : commercialCatalog.commerce?.plans.free ? 'free' : '';
      controller.querySelectorAll<HTMLElement>('[data-create-plan-summary]').forEach((summary) => {
        summary.hidden = editing || summary.dataset.summaryStoreType !== storeType || summary.dataset.summaryPlan !== selectedPlan;
      });
    }

    function closeMenu(restoreFocus = false) {
      const trigger = activeTrigger;
      if (activeMenu) {
        activeMenu.hidden = true;
        activeMenu.style.removeProperty('left');
        activeMenu.style.removeProperty('top');
      }
      trigger?.setAttribute('aria-expanded', 'false');
      activeMenu = null;
      activeTrigger = null;
      activeContext = null;
      if (restoreFocus && trigger?.isConnected) trigger.focus();
    }

    function positionMenu(menu: HTMLElement, trigger: HTMLElement) {
      const margin = 12;
      const gap = 8;
      menu.style.visibility = 'hidden';
      menu.hidden = false;
      const rect = trigger.getBoundingClientRect();
      const width = menu.offsetWidth;
      const height = menu.offsetHeight;
      let left = rect.right - width;
      let top = rect.bottom + gap;
      if (top + height > window.innerHeight - margin) top = rect.top - height - gap;
      left = Math.max(margin, Math.min(left, window.innerWidth - width - margin));
      top = Math.max(margin, Math.min(top, window.innerHeight - height - margin));
      menu.style.left = `${Math.round(left)}px`;
      menu.style.top = `${Math.round(top)}px`;
      menu.style.removeProperty('visibility');
    }

    function openMenu(menu: HTMLElement, trigger: HTMLButtonElement, context: HTMLElement) {
      if (activeMenu === menu && !menu.hidden) {
        closeMenu(true);
        return;
      }
      closeMenu();
      activeMenu = menu;
      activeTrigger = trigger;
      activeContext = context;
      trigger.setAttribute('aria-expanded', 'true');
      positionMenu(menu, trigger);
      menu.querySelector<HTMLElement>('[role="menuitem"]:not([hidden]):not([aria-disabled="true"]):not(:disabled)')?.focus();
    }

    function syncStoreMenu(context: HTMLElement) {
      const id = storeId(context);
      const storeType = context.dataset.storeType === 'promo' ? 'promo' : 'commerce';
      const featured = context.dataset.storeFeatured === 'true';
      const active = context.dataset.storeStatus === 'active';
      const protectedStore = context.dataset.storeProtected === 'true';
      const products = storeMenu?.querySelector<HTMLAnchorElement>('[data-menu-products]');
      const featuredButton = storeMenu?.querySelector<HTMLButtonElement>('[data-menu-featured]');
      const statusButton = storeMenu?.querySelector<HTMLButtonElement>('[data-menu-status]');
      const deleteButton = storeMenu?.querySelector<HTMLButtonElement>('[data-menu-delete]');
      const protectedLabel = storeMenu?.querySelector<HTMLElement>('[data-menu-protected]');
      const viewStore = storeMenu?.querySelector<HTMLAnchorElement>('[data-menu-view-store]');
      const analytics = storeMenu?.querySelector<HTMLAnchorElement>('[data-menu-analytics]');
      const isOverview = context.dataset.storeOverview === 'true';
      storeMenu?.querySelectorAll<HTMLElement>('[data-promo-only], [data-commerce-only], [data-list-only], [data-overview-only]').forEach((item) => {
        item.hidden = (item.hasAttribute('data-promo-only') && storeType !== 'promo')
          || (item.hasAttribute('data-commerce-only') && storeType !== 'commerce')
          || (item.hasAttribute('data-list-only') && isOverview)
          || (item.hasAttribute('data-overview-only') && !isOverview);
      });
      if (products) products.href = `/master/products/${encodeURIComponent(id)}`;
      if (viewStore && storeType === 'promo') {
        const publicSlug = String(context.dataset.promoPublicSlug || '').trim();
        const publicationActive = context.dataset.promoPublicState === 'active';
        if (publicSlug && publicationActive) {
          viewStore.href = `/promo/${encodeURIComponent(publicSlug)}`;
          viewStore.removeAttribute('aria-disabled');
          viewStore.removeAttribute('title');
        } else {
          viewStore.removeAttribute('href');
          viewStore.setAttribute('aria-disabled', 'true');
          viewStore.title = 'La tienda Promo todavía no está publicada.';
        }
      }
      if (analytics && storeType === 'promo') {
        analytics.href = `/t/${encodeURIComponent(String(context.dataset.storeSlug || ''))}/admin/promo/analytics`;
      }
      const featuredLabel = featuredButton?.querySelector<HTMLElement>('[data-featured-label]');
      const statusLabel = statusButton?.querySelector<HTMLElement>('[data-status-label]');
      if (featuredLabel) featuredLabel.textContent = featured ? 'Quitar destacada' : 'Destacar';
      if (statusLabel) statusLabel.textContent = active ? 'Suspender' : 'Activar';
      if (deleteButton) deleteButton.hidden = protectedStore;
      if (protectedLabel) protectedLabel.hidden = !protectedStore;
    }

    function syncSecurityMenu(context: HTMLElement) {
      const id = storeId(context);
      const exists = context.dataset.storeSecurityExists === 'true';
      const view = securityMenu?.querySelector<HTMLAnchorElement>('[data-menu-security-view]');
      if (!view) return;
      view.hidden = !exists;
      view.href = `/master/security/${encodeURIComponent(id)}`;
    }

    document.querySelectorAll<HTMLButtonElement>('[data-action-more]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const context = contextFor(trigger);
        if (!context || !storeMenu) return;
        syncStoreMenu(context);
        openMenu(storeMenu, trigger, context);
      });
    });

    storeMenu?.addEventListener('keydown', (event) => {
      if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      const items = Array.from(storeMenu.querySelectorAll<HTMLElement>('[role="menuitem"]'))
        .filter((item) => !item.hidden
          && item.getAttribute('aria-disabled') !== 'true'
          && !('disabled' in item && (item as HTMLButtonElement).disabled));
      if (!items.length) return;
      event.preventDefault();
      const current = items.indexOf(document.activeElement as HTMLElement);
      const next = event.key === 'Home' ? 0
        : event.key === 'End' ? items.length - 1
          : event.key === 'ArrowUp' ? (current <= 0 ? items.length - 1 : current - 1)
            : (current + 1) % items.length;
      items[next]?.focus();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-action-security]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const context = contextFor(trigger);
        if (!context || !securityMenu) return;
        syncSecurityMenu(context);
        openMenu(securityMenu, trigger, context);
      });
    });

    async function openStoreDialog(context: HTMLElement | null) {
      closeMenu();
      if (!storeDialog || !storeForm) return;
      storeForm.reset();
      slugEdited = Boolean(context);
      const alert = storeForm.querySelector<HTMLElement>('[data-store-form-alert]');
      const idInput = storeForm.querySelector<HTMLInputElement>('[data-store-id-input]');
      const nameInput = storeForm.elements.namedItem('name') as HTMLInputElement | null;
      const slugInput = storeForm.elements.namedItem('slug') as HTMLInputElement | null;
      const phoneInput = storeForm.elements.namedItem('owner_phone') as HTMLInputElement | null;
      const statusInput = storeForm.elements.namedItem('status') as HTMLSelectElement | null;
      const typeInput = storeForm.elements.namedItem('store_type') as HTMLSelectElement | null;
      const typeField = storeForm.querySelector<HTMLElement>('[data-store-type-field]');
      setAlert(alert);
      if (!idInput || !nameInput || !slugInput || !phoneInput || !statusInput || !typeInput) return;
      idInput.value = storeId(context);
      statusInput.value = 'active';
      typeInput.value = 'commerce';
      typeInput.disabled = Boolean(context);
      if (typeField) typeField.hidden = Boolean(context);
      syncCreateStoreType();
      const title = storeDialog.querySelector('h2');
      if (title) title.textContent = context ? 'Editar tienda' : 'Crear tienda';
      window.PZMasterDialog?.open(storeDialog.id, document.activeElement as HTMLElement | null);
      if (!context) {
        nameInput.focus();
        return;
      }
      nameInput.value = String(context.dataset.storeName || '');
      slugInput.value = String(context.dataset.storeSlug || '');
      statusInput.value = context.dataset.storeStatus === 'active' ? 'active' : 'suspended';
      try {
        const record = await pb.collection('stores').getOne(idInput.value, {
          fields: 'id,name,slug,status,owner_phone', requestKey: null,
        });
        if (!storeDialog.open || idInput.value !== record.id) return;
        nameInput.value = String(record.name || '');
        slugInput.value = String(record.slug || '');
        phoneInput.value = String(record.owner_phone || '');
        statusInput.value = record.status === 'active' ? 'active' : 'suspended';
      } catch (_) {
        setAlert(alert, 'No fue posible cargar todos los datos de la tienda.');
      }
    }

    function applySecuritySettings(settings: any) {
      if (!securityForm) return;
      const normalized = normalizeSecuritySettingsPayload(settings || {});
      (securityForm.elements.namedItem('enabled') as HTMLInputElement | null)!.checked = normalized.enabled;
      securityForm.querySelectorAll<HTMLInputElement>('input[name="mode"]').forEach((input) => {
        input.checked = input.value === (normalized.enabled && normalized.mode === 'protection' ? 'protection' : 'monitoring');
      });
      (securityForm.elements.namedItem('manual_blocking_enabled') as HTMLInputElement | null)!.checked = normalized.manual_blocking_enabled;
      (securityForm.elements.namedItem('full_access_blocking_enabled') as HTMLInputElement | null)!.checked = normalized.full_access_blocking_enabled;
      (securityForm.elements.namedItem('permanent_blocks_enabled') as HTMLInputElement | null)!.checked = normalized.permanent_blocks_enabled;
      (securityForm.elements.namedItem('notify_blocked_attempts') as HTMLInputElement | null)!.checked = normalized.notify_blocked_attempts;
      (securityForm.elements.namedItem('retention_days') as HTMLSelectElement | null)!.value = String(normalized.retention_days);
      (securityForm.elements.namedItem('ip_visibility') as HTMLSelectElement | null)!.value = normalized.ip_visibility;
      (securityForm.elements.namedItem('vpn_policy') as HTMLSelectElement | null)!.value = normalized.vpn_policy;
      syncSecurityControls();
    }

    function syncSecurityControls() {
      if (!securityForm) return;
      const enabled = (securityForm.elements.namedItem('enabled') as HTMLInputElement | null)?.checked === true;
      const manual = enabled && (securityForm.elements.namedItem('manual_blocking_enabled') as HTMLInputElement | null)?.checked === true;
      securityForm.querySelectorAll<HTMLElement>('[data-security-dependent]').forEach((group) => {
        group.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((input) => { input.disabled = !enabled; });
      });
      securityForm.querySelectorAll<HTMLInputElement>('[data-manual-dependent]').forEach((input) => {
        input.disabled = !manual;
        if (!manual) input.checked = false;
      });
    }

    async function openSecurityDialog(context: HTMLElement) {
      closeMenu();
      if (!securityDialog || !securityForm) return;
      securityForm.reset();
      const id = storeId(context);
      const storeInput = securityForm.querySelector<HTMLInputElement>('[data-security-store]');
      const history = securityDialog.querySelector<HTMLAnchorElement>('[data-security-history]');
      const alert = securityForm.querySelector<HTMLElement>('[data-security-form-alert]');
      if (storeInput) storeInput.value = id;
      setAlert(alert);
      applySecuritySettings(getDefaultSecuritySettings(id));
      if (history) {
        history.hidden = context.dataset.storeSecurityExists !== 'true';
        history.href = `/master/security/${encodeURIComponent(id)}`;
      }
      window.PZMasterDialog?.open(securityDialog.id, document.activeElement as HTMLElement | null);
      try {
        const settings = await getStoreSecuritySettings(id, pb);
        if (!securityDialog.open || storeInput?.value !== id) return;
        applySecuritySettings(settings);
        if (history) history.hidden = !settings.exists;
      } catch (_) {
        setAlert(alert, 'No fue posible cargar la configuración actual.');
      }
    }

    document.getElementById('create-store')?.addEventListener('click', () => void openStoreDialog(null));
    document.querySelectorAll<HTMLButtonElement>('[data-action-edit-store]').forEach((button) => button.addEventListener('click', () => void openStoreDialog(contextFor(button))));
    document.querySelectorAll<HTMLButtonElement>('[data-action-create-user]').forEach((button) => button.addEventListener('click', () => {
      const id = storeId(contextFor(button));
      if (id) window.location.assign(`/master/stores/${encodeURIComponent(id)}/users?create=1`);
    }));

    securityMenu?.querySelector('[data-menu-security-view]')?.addEventListener('click', () => closeMenu());
    securityMenu?.querySelector('[data-menu-security-configure]')?.addEventListener('click', () => {
      const context = activeContext;
      if (context) void openSecurityDialog(context);
    });
    storeMenu?.querySelector('[data-menu-products]')?.addEventListener('click', () => closeMenu());
    storeMenu?.querySelector('[data-menu-view-store]')?.addEventListener('click', (event) => {
      const link = event.currentTarget as HTMLAnchorElement;
      if (link.getAttribute('aria-disabled') === 'true') event.preventDefault();
      else closeMenu();
    });
    storeMenu?.querySelector('[data-menu-analytics]')?.addEventListener('click', () => closeMenu());
    storeMenu?.querySelector('[data-menu-create-user]')?.addEventListener('click', () => {
      const context = activeContext;
      const id = storeId(context);
      if (id) window.location.assign(`/master/stores/${encodeURIComponent(id)}/users?create=1`);
    });
    storeMenu?.querySelector('[data-menu-edit]')?.addEventListener('click', () => {
      const context = activeContext;
      const id = storeId(context);
      if (context?.dataset.storeType === 'promo' && id) {
        closeMenu();
        window.location.assign(`/master/stores/${encodeURIComponent(id)}`);
        return;
      }
      void openStoreDialog(context);
    });
    storeMenu?.querySelector('[data-menu-configure-security]')?.addEventListener('click', () => {
      const context = activeContext;
      if (context) void openSecurityDialog(context);
    });
    storeMenu?.querySelector<HTMLButtonElement>('[data-menu-featured]')?.addEventListener('click', async (event) => {
      const context = activeContext;
      const button = event.currentTarget as HTMLButtonElement;
      const id = storeId(context);
      if (!context || !id) return;
      const next = context.dataset.storeFeatured !== 'true';
      closeMenu();
      button.disabled = true;
      try {
        await setStoreFeaturedFromMaster(id, next, next ? 10 : 0);
        window.location.reload();
      } catch (_) {
        button.disabled = false;
      }
    });
    storeMenu?.querySelector<HTMLButtonElement>('[data-menu-status]')?.addEventListener('click', () => {
      const context = activeContext;
      const id = storeId(context);
      const trigger = activeTrigger;
      if (!context || !id || !statusDialog) return;
      pendingStatusContext = context;
      const suspending = context.dataset.storeStatus === 'active';
      const title = statusDialog.querySelector('h2');
      const copy = statusDialog.querySelector<HTMLElement>('[data-store-status-copy]');
      const confirm = statusDialog.querySelector<HTMLButtonElement>('[data-store-status-confirm]');
      const alert = statusDialog.querySelector<HTMLElement>('[data-store-status-alert]');
      if (title) title.textContent = suspending ? 'Suspender tienda' : 'Activar tienda';
      if (copy) copy.textContent = suspending
        ? `Se bloqueará el acceso público y administrativo de ${context.dataset.storeName || 'esta tienda'} sin borrar sus datos.`
        : `Se restablecerá el acceso de ${context.dataset.storeName || 'esta tienda'}.`;
      if (confirm) {
        confirm.textContent = suspending ? 'Suspender tienda' : 'Activar tienda';
        confirm.classList.toggle('master-btn--danger-solid', suspending);
        confirm.classList.toggle('master-btn--primary', !suspending);
      }
      setAlert(alert);
      closeMenu();
      window.PZMasterDialog?.open(statusDialog.id, trigger);
    });
    controller.querySelector<HTMLButtonElement>('[data-store-status-confirm]')?.addEventListener('click', async (event) => {
      const context = pendingStatusContext;
      const id = storeId(context);
      if (!context || !id || !statusDialog) return;
      const button = event.currentTarget as HTMLButtonElement;
      const alert = statusDialog.querySelector<HTMLElement>('[data-store-status-alert]');
      const next = context.dataset.storeStatus === 'active' ? 'suspended' : 'active';
      button.disabled = true;
      try {
        await setStoreStatusFromMaster(id, next);
        window.location.reload();
      } catch (error: any) {
        setAlert(alert, error?.message || 'No se pudo cambiar el estado de la tienda.');
        button.disabled = false;
      }
    });
    statusDialog?.addEventListener('close', () => { pendingStatusContext = null; });
    storeMenu?.querySelector<HTMLButtonElement>('[data-menu-delete]')?.addEventListener('click', () => {
      const context = activeContext;
      const trigger = activeTrigger;
      if (!context || context.dataset.storeProtected === 'true') return;
      const detail = {
        storeId: storeId(context), storeName: context.dataset.storeName || '',
        storeType: context.dataset.storeType === 'promo' ? 'promo' : 'commerce',
        protected: false, trigger,
      };
      closeMenu();
      window.dispatchEvent(new CustomEvent('pz:master-store-delete-open', { detail }));
    });

    storeForm?.querySelector<HTMLInputElement>('[name="name"]')?.addEventListener('input', (event) => {
      if (slugEdited || !storeForm) return;
      const slug = storeForm.elements.namedItem('slug') as HTMLInputElement | null;
      if (slug) slug.value = normalizeStoreSlug((event.currentTarget as HTMLInputElement).value);
    });
    storeForm?.querySelector<HTMLInputElement>('[name="slug"]')?.addEventListener('input', (event) => {
      slugEdited = true;
      (event.currentTarget as HTMLInputElement).value = normalizeStoreSlug((event.currentTarget as HTMLInputElement).value);
    });
    storeForm?.querySelector<HTMLSelectElement>('[name="store_type"]')?.addEventListener('change', syncCreateStoreType);
    storeForm?.querySelector<HTMLSelectElement>('[name="promo_plan"]')?.addEventListener('change', syncCreatePromoPlan);
    storeForm?.querySelector<HTMLSelectElement>('[name="promo_validity"]')?.addEventListener('change', syncCreatePromoPlan);

    controller.querySelector<HTMLButtonElement>('[data-store-save]')?.addEventListener('click', async (event) => {
      if (!storeForm || !storeForm.reportValidity()) return;
      const button = event.currentTarget as HTMLButtonElement;
      const alert = storeForm.querySelector<HTMLElement>('[data-store-form-alert]');
      const data = new FormData(storeForm);
      const id = String(data.get('store_id') || '');
      button.disabled = true;
      setAlert(alert);
      try {
        const storeType = String(data.get('store_type') || 'commerce') === 'promo' ? 'promo' : 'commerce';
        const promoPlan = String(data.get('promo_plan') || 'free') === 'basic' ? 'basic' : 'free';
        const promoDefinition = commercialCatalog.promo?.plans[promoPlan];
        if (storeType === 'promo' && !promoDefinition) throw new Error('El catálogo comercial ya no contiene el plan seleccionado.');
        const promoIsPermanent = promoDefinition?.trialDays === 0 && promoDefinition.supportsPermanent && String(data.get('promo_validity') || 'temporary') === 'permanent';
        const promoDurationMonths = promoDefinition?.trialDays === 0 && !promoIsPermanent
          ? Number(data.get('promo_duration_months'))
          : 0;
        const promoImageLimit = Number(promoDefinition?.imageLimit || 0);
        const promoThemeId = String(data.get('promo_theme_id') || 'promo.black-gold');
        const payload = {
          name: String(data.get('name') || ''), slug: String(data.get('slug') || ''),
          owner_phone: String(data.get('owner_phone') || ''), status: String(data.get('status') || ''),
          store_type: storeType as 'commerce' | 'promo',
          ...(storeType === 'promo' ? {
            promo_plan: promoPlan as 'free' | 'basic',
            promo_duration_months: promoDurationMonths,
            promo_is_permanent: promoIsPermanent,
            promo_image_limit: promoImageLimit,
            promo_theme_id: promoThemeId,
          } : {}),
        };
        if (id) await updateStoreFromMaster(id, payload);
        else await createStoreFromMaster(payload);
        if (id) window.location.reload();
        else navigateToMasterStoreList(1);
      } catch (error: any) {
        setAlert(alert, error?.message || 'No se pudo guardar la tienda.');
        button.disabled = false;
      }
    });

    securityForm?.addEventListener('change', syncSecurityControls);
    controller.querySelector<HTMLButtonElement>('[data-security-save]')?.addEventListener('click', async (event) => {
      if (!securityForm) return;
      const button = event.currentTarget as HTMLButtonElement;
      const alert = securityForm.querySelector<HTMLElement>('[data-security-form-alert]');
      const data = new FormData(securityForm);
      const id = String(data.get('store_id') || '');
      button.disabled = true;
      setAlert(alert);
      try {
        await upsertStoreSecuritySettings(id, normalizeSecuritySettingsPayload({
          store: id,
          enabled: data.get('enabled') === 'on',
          mode: String(data.get('mode') || 'monitoring') as any,
          manual_blocking_enabled: data.get('manual_blocking_enabled') === 'on',
          full_access_blocking_enabled: data.get('full_access_blocking_enabled') === 'on',
          permanent_blocks_enabled: data.get('permanent_blocks_enabled') === 'on',
          retention_days: Number(data.get('retention_days') || 30) as any,
          ip_visibility: String(data.get('ip_visibility') || 'hidden') as any,
          notify_blocked_attempts: data.get('notify_blocked_attempts') === 'on',
          vpn_policy: String(data.get('vpn_policy') || 'off') as any,
        }));
        setAlert(alert, 'Configuración guardada correctamente.', true);
        document.querySelector<HTMLElement>(`[data-store-context][data-store-id="${CSS.escape(id)}"]`)?.setAttribute('data-store-security-exists', 'true');
      } catch (error: any) {
        setAlert(alert, error?.message || 'No se pudo guardar la configuración de Seguridad.');
      } finally {
        button.disabled = false;
      }
    });

    document.addEventListener('pointerdown', (event) => {
      const target = event.target as Node | null;
      if (!target || !activeMenu || activeMenu.contains(target) || activeTrigger?.contains(target)) return;
      closeMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && activeMenu) closeMenu(true);
    });
    window.addEventListener('scroll', () => closeMenu(), true);
    window.addEventListener('resize', () => closeMenu());
    window.addEventListener('pagehide', () => closeMenu());
  }
</script>
