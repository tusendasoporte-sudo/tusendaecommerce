---
import '../../styles/promo-master.css';
import type { PromoMasterOverview } from '../../lib/promoMaster';

interface Props { storeId: string; overview: PromoMasterOverview; }

const { storeId, overview } = Astro.props;
const stateLabels: Record<string, string> = {
  draft: 'Configurando', active: 'Activa', paused: 'Pausada', suspended: 'Suspendida', retired: 'Retirada',
  unpublished: 'Sin publicar', missing: 'Ausente', enabled: 'Habilitado', disabled: 'Deshabilitado',
  grace: 'En gracia', expired: 'Vencido', expiring: 'Próximo a vencer', critical: 'Vence pronto',
};
const themeLabels: Record<string, string> = {
  'promo.black-gold': 'Promo Black Gold',
  'promo.minimal': 'Minimal',
  'promo.artisan': 'Artesanal cálida',
  'promo.vibrant': 'Vibrante moderna',
  'promo.professional': 'Profesional corporativa',
  'promo.portfolio': 'Portafolio editorial',
};
const label = (value: string) => stateLabels[value] || value || 'No disponible';
const currentThemeId = overview.theme.draft?.theme_id || 'promo.black-gold';
const selectableThemes = overview.theme.releases.filter((release) => release.status === 'approved' || release.theme_id === currentThemeId);
const expiry = overview.plan.expires_at
  ? new Intl.DateTimeFormat('es-US', { dateStyle: 'medium' }).format(new Date(overview.plan.expires_at))
  : 'Sin fecha disponible';
---

<section class="master-page promo-master" aria-label="Control Master de Tienda Promo" data-promo-master
  data-store-id={storeId} data-entitlement-updated={overview.entitlement.updated} data-draft-version={String(overview.draft.version)}>
  <header class="master-overview-heading promo-master__heading">
    <div>
      <div class="promo-master__eyebrow"><span class="master-pill master-pill--warning">PROMO</span><span>{overview.plan.name}</span></div>
      <h2>{overview.store.name || 'Tienda Promo'}</h2>
      <p>Estado, plan y preferencias generales. El contenido de la página se administra desde el panel Admin Promo.</p>
    </div>
    <a class="master-btn master-btn--secondary" href="/master/stores">Volver a tiendas</a>
  </header>

  <p class="promo-master__feedback" role="status" aria-live="polite" data-promo-feedback hidden></p>
  {overview.health.state !== 'ready' && <div class="master-error" role="alert"><strong>Esta tienda necesita revisión técnica antes de cambiar sus preferencias.</strong></div>}

  <div class="master-kpi-grid" aria-label="Resumen Promo">
    <article class="master-kpi"><span class="master-kpi__label">Estado Promo</span><strong class="master-kpi__value promo-master__kpi-value">{label(overview.site.status)}</strong><span class="master-kpi__meta">/{overview.site.public_slug}</span></article>
    <article class="master-kpi"><span class="master-kpi__label">Plan</span><strong class="master-kpi__value promo-master__kpi-value">{overview.plan.code === 'basic' ? 'Básico' : 'Gratis'}</strong><span class="master-kpi__meta">Vence: {expiry}</span></article>
    <article class="master-kpi"><span class="master-kpi__label">Página pública</span><strong class="master-kpi__value promo-master__kpi-value">{label(overview.publication.state)}</strong><span class="master-kpi__meta">Tu Senda 84</span></article>
    <article class="master-kpi"><span class="master-kpi__label">Fotos</span><strong class="master-kpi__value promo-master__kpi-value">{overview.media.photos_used} / {overview.media.photo_limit}</strong><span class="master-kpi__meta">Según el plan actual</span></article>
  </div>

  <section class="master-card promo-master__card" aria-labelledby="promo-preferences-title">
    <header class="master-card-header"><div><h3 id="promo-preferences-title" class="master-card-title">Configuración de la tienda Promo</h3><span class="master-muted">Black Gold es el tema predeterminado; el Admin Promo puede cambiarlo después.</span></div></header>
    <div class="promo-master__card-body">
      {overview.operations.preferences_update ? (
        <form class="promo-master__form" data-preferences-form>
          <div class="master-field-grid">
            <div class="master-field">
              <label for="promo-store-theme">Tema actual</label>
              <select id="promo-store-theme" name="theme_id" required>
                {selectableThemes.map((release) => <option value={release.theme_id} selected={release.theme_id === currentThemeId}>{themeLabels[release.theme_id] || release.theme_id}</option>)}
              </select>
              <span class="master-muted">Solo aparecen temas aprobados para uso.</span>
            </div>
            <label class="master-switch"><span><strong>Selector de idioma</strong><br /><span class="master-muted">Muestra u oculta el selector en la página pública y en Admin Promo.</span></span><input name="language_selector_enabled" type="checkbox" checked={overview.entitlement.capabilities.language_selector_enabled === true} /></label>
          </div>
          <button class="master-btn master-btn--primary" type="submit">Guardar configuración</button>
        </form>
      ) : <p class="master-notice">La sesión actual no puede cambiar estas preferencias.</p>}
    </div>
  </section>

  <section class="master-card promo-master__card" aria-labelledby="promo-audit-title">
    <header class="master-card-header"><div><h3 id="promo-audit-title" class="master-card-title">Actividad Promo reciente</h3><span class="master-muted">Resumen de acciones administrativas</span></div></header>
    <div class="promo-master__card-body promo-master__activity">
      {overview.activity.length ? overview.activity.map((item) => <article><span class={`promo-master__severity is-${item.severity}`}>{item.severity}</span><div><strong>{item.summary}</strong><span>{item.actor.name} · {item.actor.role} · {item.module}</span></div><time datetime={item.created}>{item.created || 'Fecha no disponible'}</time></article>) : <p class="master-empty">No hay eventos Promo recientes.</p>}
    </div>
  </section>
</section>

<script>
  import { pb } from '../../lib/pocketbase';
  import { updatePromoPreferences } from '../../lib/promoMaster';

  function errorCode(error: any) { return String(error?.data?.error || error?.response?.error || error?.message || 'promo_master_unavailable').slice(0, 80); }
  function errorMessage(error: any) {
    const code = errorCode(error);
    const messages: Record<string, string> = {
      promo_preferences_conflict: 'La configuración cambió en otra sesión. Recarga antes de repetir.',
      promo_theme_not_selectable: 'Ese tema ya no está aprobado para seleccionarlo.',
      invalid_promo_document: 'El tema no puede aplicarse al contenido actual.',
      invalid_payload: 'La operación no cumple el contrato esperado.',
    };
    return messages[code] || `No se pudo guardar la configuración (${code}).`;
  }

  document.querySelectorAll<HTMLElement>('[data-promo-master]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    pb.authStore.loadFromCookie(document.cookie, 'pb_auth');
    const storeId = String(root.dataset.storeId || '');
    const feedback = root.querySelector<HTMLElement>('[data-promo-feedback]');
    const form = root.querySelector<HTMLFormElement>('[data-preferences-form]');
    function announce(message: string, failed = false) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.hidden = !message;
      feedback.classList.toggle('is-error', failed);
    }
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!button || !form.reportValidity()) return;
      const values = new FormData(form);
      button.disabled = true;
      root.setAttribute('aria-busy', 'true');
      announce('Guardando configuración…');
      try {
        await updatePromoPreferences(pb, storeId, {
          expected_entitlement_updated: String(root.dataset.entitlementUpdated || ''),
          expected_draft_version: Number(root.dataset.draftVersion || 0),
          language_selector_enabled: values.get('language_selector_enabled') === 'on',
          theme_id: String(values.get('theme_id') || 'promo.black-gold'),
        });
        announce('Configuración guardada.');
        window.location.reload();
      } catch (error) {
        announce(errorMessage(error), true);
        button.disabled = false;
        root.removeAttribute('aria-busy');
      }
    });
  });
</script>
