<script>
  import { pb } from '../../lib/pocketbase';
  import { runMasterProductWatchAction } from '../../lib/masterProductWatches';

  const watchDetail = document.querySelector<HTMLElement>('[data-watch-detail]');
  const pocketbaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
  if (watchDetail && pocketbaseUrl) {
    if (!pb.authStore.isValid) pb.authStore.loadFromCookie(document.cookie, 'pb_auth');
    watchDetail.querySelectorAll<HTMLButtonElement>('[data-watch-action]').forEach((button) => {
      button.addEventListener('click', async () => {
        const action = String(button.dataset.watchAction || '') as 'enable' | 'pause' | 'resume';
        if (!pb.authStore.isValid || !pb.authStore.token || !['enable', 'pause', 'resume'].includes(action)) return;
        button.disabled = true;
        const previousText = button.textContent || '';
        button.textContent = 'Procesando…';
        const result = await runMasterProductWatchAction(
          pocketbaseUrl,
          pb.authStore.token,
          String(watchDetail.dataset.storeId || ''),
          String(watchDetail.dataset.productId || ''),
          action,
        );
        if (result.available) {
          window.location.hash = 'seguimiento-precio';
          window.location.reload();
        } else {
          button.disabled = false;
          button.textContent = previousText;
        }
      });
    });
  }
</script>
