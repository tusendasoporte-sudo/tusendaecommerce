---
type ChartRow = {
  day: string;
  label: string;
  [key: string]: string | number;
};

type ChartMetric = {
  key: string;
  label: string;
  singular: string;
  plural: string;
  color: string;
};

interface Props {
  chartId: string;
  title: string;
  description: string;
  rows: ChartRow[];
  metrics: ChartMetric[];
}

const { chartId, title, description, rows = [], metrics = [] } = Astro.props;
const width = 900;
const height = 330;
const paddingLeft = 48;
const paddingRight = 44;
const paddingTop = 38;
const paddingBottom = 48;
const innerWidth = width - paddingLeft - paddingRight;
const innerHeight = height - paddingTop - paddingBottom;

function metricMax(metric: ChartMetric) {
  return Math.max(1, ...rows.map((row) => Number(row[metric.key] || 0)));
}

function niceMax(value: number) {
  if (value <= 4) return 4;
  const magnitude = 10 ** Math.floor(Math.log10(value));
  const normalized = value / magnitude;
  const nice = normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
  return nice * magnitude;
}

function pointsFor(metric: ChartMetric) {
  const max = niceMax(metricMax(metric));
  return rows.map((row, index) => {
    const value = Math.max(0, Number(row[metric.key] || 0));
    const x = rows.length > 1
      ? paddingLeft + (index * innerWidth) / (rows.length - 1)
      : paddingLeft + innerWidth / 2;
    const y = paddingTop + innerHeight - (value / max) * innerHeight;
    return { ...row, value, x, y, index, max };
  });
}

function pathFor(points: ReturnType<typeof pointsFor>) {
  if (!points.length) return '';
  if (points.length === 1) return `M ${paddingLeft} ${points[0].y} L ${width - paddingRight} ${points[0].y}`;
  return points.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x.toFixed(2)} ${point.y.toFixed(2)}`).join(' ');
}

function areaPathFor(points: ReturnType<typeof pointsFor>) {
  const line = pathFor(points);
  if (!line || !points.length) return '';
  const baseline = height - paddingBottom;
  return `${line} L ${points[points.length - 1].x.toFixed(2)} ${baseline} L ${points[0].x.toFixed(2)} ${baseline} Z`;
}

function showTick(index: number, total: number) {
  if (total <= 7) return true;
  if (total <= 15) return index === 0 || index === total - 1 || index % 3 === 0;
  return index === 0 || index === total - 1 || index % 5 === 0;
}

function formatNumber(value: number) {
  return new Intl.NumberFormat('es-US').format(value);
}
---

<section class="master-chart-card" data-master-chart data-chart-id={chartId}>
  <header class="master-chart-head">
    <div>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    {metrics.length > 1 && (
      <div class="master-chart-tabs" role="tablist" aria-label={`Métricas de ${title}`}>
        {metrics.map((metric, index) => (
          <button
            type="button"
            role="tab"
            class:list={['master-chart-tab', { 'is-active': index === 0 }]}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`${chartId}-${metric.key}`}
            data-chart-tab={metric.key}
          >
            {metric.label}
          </button>
        ))}
      </div>
    )}
  </header>

  <div class="master-chart-stage">
    {metrics.map((metric, metricIndex) => {
      const points = pointsFor(metric);
      const max = points[0]?.max || 4;
      const ticks = [0, 1, 2, 3, 4].map((index) => Math.round((max * index) / 4));
      const hasActivity = points.some((point) => point.value > 0);
      return (
        <div
          id={`${chartId}-${metric.key}`}
          class="master-chart-panel"
          role="tabpanel"
          data-chart-panel={metric.key}
          hidden={metricIndex !== 0}
        >
          <svg class="master-chart-svg" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${title}: ${metric.label}`}>
            <defs>
              <linearGradient id={`${chartId}-${metric.key}-fill`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color={metric.color} stop-opacity="0.24"></stop>
                <stop offset="100%" stop-color={metric.color} stop-opacity="0.025"></stop>
              </linearGradient>
            </defs>
            {ticks.map((tick) => {
              const y = paddingTop + innerHeight - (tick / max) * innerHeight;
              return (
                <>
                  <line x1={paddingLeft} y1={y} x2={width - paddingRight} y2={y} class="master-chart-grid"></line>
                  <text x={width - 6} y={y + 4} text-anchor="end" class="master-chart-y-label">{formatNumber(tick)}</text>
                </>
              );
            })}
            {points.length > 0 && (
              <>
                <path d={areaPathFor(points)} fill={`url(#${chartId}-${metric.key}-fill)`}></path>
                <path d={pathFor(points)} fill="none" stroke={metric.color} class="master-chart-line"></path>
              </>
            )}
            {points.map((point) => {
              const unit = point.value === 1 ? metric.singular : metric.plural;
              return (
                <g
                  class="master-chart-point"
                  tabindex="0"
                  role="button"
                  aria-label={`${point.label}, ${formatNumber(point.value)} ${unit}`}
                  data-chart-point
                  data-label={point.label}
                  data-value={formatNumber(point.value)}
                  data-unit={unit}
                >
                  <circle cx={point.x} cy={point.y} r="15" fill="transparent"></circle>
                  <circle cx={point.x} cy={point.y} r="7.5" fill={metric.color} opacity="0.14" class="master-chart-point-ring"></circle>
                  <circle cx={point.x} cy={point.y} r="4.8" fill={metric.color} stroke="#fff" stroke-width="2.4"></circle>
                </g>
              );
            })}
            {points.filter((point) => showTick(point.index, points.length)).map((point) => (
              <text x={point.x} y={height - 15} text-anchor="middle" class="master-chart-x-label">{point.label}</text>
            ))}
          </svg>
          {!hasActivity && <p class="master-chart-empty">Sin actividad en este período. La serie conserva todos los días con valor cero.</p>}
        </div>
      );
    })}
    <div class="master-chart-tooltip" data-chart-tooltip hidden role="status" aria-live="polite">
      <span data-tooltip-label></span>
      <strong data-tooltip-value></strong>
    </div>
  </div>
</section>

<style>
  .master-chart-card { min-width: 0; overflow: hidden; border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; box-shadow: 0 18px 44px rgba(15, 23, 42, .06); }
  .master-chart-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; padding: 20px 22px 12px; }
  .master-chart-head h2 { margin: 0; color: #0f172a; font-size: var(--master-font-section-title); line-height: 1.1; font-weight: 950; }
  .master-chart-head p { margin: 6px 0 0; color: #64748b; font-size: 13px; line-height: 1.45; font-weight: 700; }
  .master-chart-tabs { display: flex; max-width: 100%; overflow-x: auto; gap: 6px; padding: 3px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; scrollbar-width: thin; }
  .master-chart-tab { min-height: 40px; border: 0; border-radius: 9px; background: transparent; color: #64748b; padding: 8px 11px; font: inherit; font-size: 13px; font-weight: 900; white-space: nowrap; cursor: pointer; }
  .master-chart-tab.is-active { background: #fff; color: #1d4ed8; box-shadow: 0 4px 14px rgba(15, 23, 42, .09); }
  .master-chart-stage { position: relative; min-width: 0; padding: 0 10px 14px; }
  .master-chart-panel { min-width: 0; }
  .master-chart-svg { display: block; width: 100%; min-width: 650px; height: auto; overflow: visible; }
  .master-chart-panel { overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; }
  .master-chart-grid { stroke: #e2e8f0; stroke-width: 1; stroke-dasharray: 5 7; }
  .master-chart-line { stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .master-chart-y-label, .master-chart-x-label { fill: #64748b; font-size: 12px; font-weight: 800; }
  .master-chart-point { cursor: pointer; outline: none; }
  .master-chart-point-ring { transform-box: fill-box; transform-origin: center; transition: transform .16s ease, opacity .16s ease; }
  .master-chart-point:hover .master-chart-point-ring,
  .master-chart-point:focus .master-chart-point-ring { transform: scale(1.45); opacity: .3; }
  .master-chart-tooltip { position: absolute; z-index: 5; display: grid; gap: 2px; min-width: 112px; max-width: min(210px, calc(100vw - 32px)); transform: translateX(-50%); border: 1px solid #cbd5e1; border-radius: 10px; background: #0f172a; color: #fff; padding: 9px 11px; box-shadow: 0 12px 28px rgba(15, 23, 42, .28); pointer-events: none; }
  .master-chart-tooltip[hidden] { display: none; }
  .master-chart-tooltip span { color: #cbd5e1; font-size: 13px; font-weight: 800; }
  .master-chart-tooltip strong { font-size: 14px; line-height: 1.2; font-weight: 950; }
  .master-chart-empty { margin: -10px 18px 8px; border-radius: 10px; background: #f8fafc; color: #64748b; padding: 10px 12px; text-align: center; font-size: 13px; font-weight: 750; }

  @media (max-width: 720px) {
    .master-chart-head { align-items: stretch; flex-direction: column; padding: 18px 16px 8px; }
    .master-chart-tabs { width: 100%; }
    .master-chart-tab { flex: 1 0 auto; }
    .master-chart-stage { padding-inline: 4px; }
    .master-chart-svg { min-width: 620px; }
  }
</style>

<script is:inline>
  (() => {
    if (window.__pzMasterAnalyticsChartsReady) return;
    window.__pzMasterAnalyticsChartsReady = true;

    function hideTooltip(chart) {
      const tooltip = chart.querySelector('[data-chart-tooltip]');
      if (tooltip) tooltip.hidden = true;
    }

    function showTooltip(chart, point) {
      const tooltip = chart.querySelector('[data-chart-tooltip]');
      const label = tooltip?.querySelector('[data-tooltip-label]');
      const value = tooltip?.querySelector('[data-tooltip-value]');
      if (!tooltip || !label || !value) return;
      label.textContent = point.dataset.label || '';
      value.textContent = `${point.dataset.value || '0'} ${point.dataset.unit || ''}`.trim();
      tooltip.hidden = false;
      const chartRect = chart.getBoundingClientRect();
      const pointRect = point.getBoundingClientRect();
      const viewportPadding = 14;
      let center = pointRect.left + pointRect.width / 2 - chartRect.left;
      const half = tooltip.offsetWidth / 2;
      const viewportLeft = chartRect.left + center - half;
      const viewportRight = chartRect.left + center + half;
      if (viewportLeft < viewportPadding) center += viewportPadding - viewportLeft;
      if (viewportRight > window.innerWidth - viewportPadding) center -= viewportRight - (window.innerWidth - viewportPadding);
      const top = Math.max(6, pointRect.top - chartRect.top - tooltip.offsetHeight - 12);
      tooltip.style.left = `${center}px`;
      tooltip.style.top = `${top}px`;
    }

    document.querySelectorAll('[data-master-chart]').forEach((chart) => {
      const tabs = Array.from(chart.querySelectorAll('[data-chart-tab]'));
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const key = tab.dataset.chartTab || '';
          tabs.forEach((candidate) => {
            const active = candidate === tab;
            candidate.classList.toggle('is-active', active);
            candidate.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          chart.querySelectorAll('[data-chart-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.chartPanel !== key;
          });
          hideTooltip(chart);
        });
      });

      chart.querySelectorAll('[data-chart-point]').forEach((point) => {
        point.addEventListener('pointerdown', (event) => {
          event.stopPropagation();
          showTooltip(chart, point);
        });
        point.addEventListener('click', (event) => {
          event.stopPropagation();
          showTooltip(chart, point);
        });
        point.addEventListener('focus', () => showTooltip(chart, point));
        point.addEventListener('blur', () => hideTooltip(chart));
        point.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          showTooltip(chart, point);
        });
      });
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-chart-point]')) return;
      document.querySelectorAll('[data-master-chart]').forEach(hideTooltip);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') document.querySelectorAll('[data-master-chart]').forEach(hideTooltip);
    });
    window.addEventListener('resize', () => {
      document.querySelectorAll('[data-master-chart]').forEach(hideTooltip);
    });
  })();
</script>
