---
import MasterIcon from './MasterIcon.astro';
import type { PublicHomepageSettings } from '../../lib/publicHomepageSettings';

type HomepageStoreOption = {
  id: string;
  name: string;
  slug: string;
  logoUrl: string;
  featured: boolean;
};

interface Props {
  settings: PublicHomepageSettings;
  stores: HomepageStoreOption[];
  loadError?: boolean;
}

const { settings, stores, loadError = false } = Astro.props;
const STORE_PAGE_SIZE = 10;
const selectedStoreCount = stores.filter((store) => store.featured).length;

function storeInitials(name: string) {
  return String(name || 'TS')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join('') || 'TS';
}
---

<section class="master-page master-homepage-page" data-master-homepage-settings>
  <header class="master-homepage-heading">
    <div>
      <p>Presencia pública</p>
      <h2>Portada comercial</h2>
      <span>Administra desde un solo lugar las secciones públicas que necesitan contenido variable.</span>
    </div>
    <a class="master-btn master-btn--secondary" href="/" target="_blank" rel="noopener noreferrer">
      <MasterIcon name="external" size={18} /> Ver portada
    </a>
  </header>

  {loadError && (
    <div class="master-error" role="alert">
      La configuración de portada todavía no está disponible. Aplica la migración del backend antes de guardar cambios.
    </div>
  )}

  <form
    class="master-homepage-form"
    data-master-homepage-settings-form
    data-record-id={settings.recordId}
    aria-disabled={loadError ? 'true' : undefined}
  >
    <section class="master-card master-homepage-block" aria-labelledby="homepage-stores-title">
      <header class="master-card-header master-homepage-block__heading">
        <div>
          <span class="master-homepage-kicker">NEGOCIOS</span>
          <h3 class="master-card-title" id="homepage-stores-title">Tiendas destacadas</h3>
          <p class="master-card-subtitle">Elige cuáles negocios aparecen en la portada. El enlace del encabezado se oculta cuando esta sección está desactivada o no tiene tiendas.</p>
        </div>
        <label class="master-homepage-switch">
          <input type="checkbox" data-homepage-stores-enabled checked={settings.storesSectionEnabled} disabled={loadError} />
          <span aria-hidden="true"></span>
          <strong>Mostrar sección</strong>
        </label>
      </header>

      <div class="master-card-body">
        {stores.length > 0 ? (
          <details class="master-homepage-store-picker" data-homepage-store-picker>
            <summary>
              <span class="master-homepage-store-picker__summary-copy">
                <strong>Elegir negocios destacados</strong>
                <small data-homepage-store-selected-label aria-live="polite">{selectedStoreCount} {selectedStoreCount === 1 ? 'tienda seleccionada' : 'tiendas seleccionadas'}</small>
              </span>
              <span class="master-homepage-store-picker__chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="master-homepage-store-picker__panel">
              <div class="master-homepage-store-toolbar">
                <label class="master-field">
                  <span>Buscar tienda</span>
                  <input type="search" placeholder="Nombre o dirección de la tienda" autocomplete="off" data-homepage-store-search disabled={loadError} />
                </label>
                <span class="master-homepage-store-results" data-homepage-store-results aria-live="polite">{stores.length} negocios disponibles</span>
              </div>
              <div class="master-homepage-store-list" data-homepage-store-list data-page-size={STORE_PAGE_SIZE}>
                {stores.map((store, index) => (
                  <label class="master-homepage-store-option" data-homepage-store-option data-store-search={`${store.name} ${store.slug}`.toLocaleLowerCase('es')} hidden={index >= STORE_PAGE_SIZE}>
                    <input type="checkbox" value={store.id} data-homepage-featured-store checked={store.featured} disabled={loadError} />
                    <span class="master-homepage-store-option__mark" aria-hidden="true">✓</span>
                    <span class="master-homepage-store-option__logo" aria-hidden="true">
                      {store.logoUrl ? <img src={store.logoUrl} alt="" width="52" height="52" loading="lazy" /> : <span>{storeInitials(store.name)}</span>}
                    </span>
                    <span class="master-homepage-store-option__copy"><strong>{store.name || 'Tienda'}</strong><small>/{store.slug || 'sin-slug'}</small></span>
                  </label>
                ))}
              </div>
              <p class="master-homepage-store-empty" data-homepage-store-empty hidden>No hay tiendas que coincidan con la búsqueda.</p>
              <nav class="master-homepage-store-pagination" aria-label="Paginación de tiendas" data-homepage-store-pagination>
                <button type="button" data-homepage-store-page-prev disabled>← Anterior</button>
                <span data-homepage-store-page-status aria-live="polite">Página 1 de {Math.max(1, Math.ceil(stores.length / STORE_PAGE_SIZE))}</span>
                <button type="button" data-homepage-store-page-next disabled={stores.length <= STORE_PAGE_SIZE}>Siguiente →</button>
              </nav>
            </div>
          </details>
        ) : <p class="master-homepage-empty">No hay tiendas Ecommerce activas disponibles para destacar.</p>}
      </div>
    </section>

    <section class="master-card master-homepage-block" aria-labelledby="homepage-faq-title">
      <header class="master-card-header master-homepage-block__heading">
        <div>
          <span class="master-homepage-kicker">CONTENIDO</span>
          <h3 class="master-card-title" id="homepage-faq-title">Preguntas frecuentes</h3>
          <p class="master-card-subtitle">Edita el encabezado, la introducción y hasta 10 preguntas. También puedes ocultar una pregunta sin perder su contenido.</p>
        </div>
        <label class="master-homepage-switch">
          <input type="checkbox" data-homepage-faq-enabled checked={settings.faqSectionEnabled} disabled={loadError} />
          <span aria-hidden="true"></span>
          <strong>Mostrar sección</strong>
        </label>
      </header>

      <div class="master-card-body master-homepage-faq-body">
        <div class="master-homepage-copy-grid">
          <label class="master-field"><span>Etiqueta superior</span><input type="text" value={settings.faqEyebrow} maxlength="80" required data-homepage-faq-eyebrow disabled={loadError} /></label>
          <label class="master-field"><span>Título</span><input type="text" value={settings.faqTitle} maxlength="140" required data-homepage-faq-title disabled={loadError} /></label>
          <label class="master-field master-homepage-copy-grid__wide"><span>Introducción</span><textarea rows="3" maxlength="360" required data-homepage-faq-intro disabled={loadError}>{settings.faqIntro}</textarea></label>
        </div>

        <div class="master-homepage-faq-list" data-homepage-faq-list>
          {settings.faqs.map((faq, index) => (
            <article class="master-homepage-faq-item" data-homepage-faq-item data-faq-id={faq.id}>
              <header><strong>Pregunta {index + 1}</strong><label><input type="checkbox" data-homepage-faq-visible checked={faq.visible} disabled={loadError} /> Visible</label></header>
              <label class="master-field"><span>Pregunta</span><input type="text" value={faq.question} maxlength="180" required data-homepage-faq-question disabled={loadError} /></label>
              <label class="master-field"><span>Respuesta</span><textarea rows="3" maxlength="800" required data-homepage-faq-answer disabled={loadError}>{faq.answer}</textarea></label>
              <button class="master-btn master-btn--secondary" type="button" data-homepage-faq-remove disabled={loadError}>Quitar pregunta</button>
            </article>
          ))}
        </div>

        <button class="master-btn master-btn--secondary master-homepage-add" type="button" data-homepage-faq-add disabled={loadError}>+ Agregar pregunta</button>
      </div>
    </section>

    <p class="master-form-alert" data-master-homepage-settings-alert aria-live="polite" hidden></p>
    <div class="master-homepage-actions">
      <span>Los cambios se reflejan en la portada pública después de guardar.</span>
      <button class="master-btn master-btn--primary" type="submit" data-master-homepage-settings-save disabled={loadError}>
        <MasterIcon name="save" size={18} /> Guardar portada
      </button>
    </div>
  </form>

  <template data-homepage-faq-template>
    <article class="master-homepage-faq-item" data-homepage-faq-item data-faq-id="">
      <header><strong>Nueva pregunta</strong><label><input type="checkbox" data-homepage-faq-visible checked /> Visible</label></header>
      <label class="master-field"><span>Pregunta</span><input type="text" maxlength="180" required data-homepage-faq-question /></label>
      <label class="master-field"><span>Respuesta</span><textarea rows="3" maxlength="800" required data-homepage-faq-answer></textarea></label>
      <button class="master-btn master-btn--secondary" type="button" data-homepage-faq-remove>Quitar pregunta</button>
    </article>
  </template>
</section>

<script>
  function initializeMasterHomepageSettings() {
    const root = document.querySelector<HTMLElement>('[data-master-homepage-settings]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const form = root.querySelector<HTMLFormElement>('[data-master-homepage-settings-form]');
    const faqList = root.querySelector<HTMLElement>('[data-homepage-faq-list]');
    const template = root.querySelector<HTMLTemplateElement>('[data-homepage-faq-template]');
    const addButton = root.querySelector<HTMLButtonElement>('[data-homepage-faq-add]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-master-homepage-settings-save]');
    const alert = root.querySelector<HTMLElement>('[data-master-homepage-settings-alert]');
    if (!form || !faqList) return;

    const setAlert = (message = '', success = false) => {
      if (!alert) return;
      alert.textContent = message;
      alert.hidden = !message;
      alert.classList.toggle('is-success', success);
    };

    const storeList = form.querySelector<HTMLElement>('[data-homepage-store-list]');
    const storeSearch = form.querySelector<HTMLInputElement>('[data-homepage-store-search]');
    const storeOptions = storeList
      ? Array.from(storeList.querySelectorAll<HTMLElement>('[data-homepage-store-option]'))
      : [];
    const storeSelectedLabel = form.querySelector<HTMLElement>('[data-homepage-store-selected-label]');
    const storeResults = form.querySelector<HTMLElement>('[data-homepage-store-results]');
    const storeEmpty = form.querySelector<HTMLElement>('[data-homepage-store-empty]');
    const storePageStatus = form.querySelector<HTMLElement>('[data-homepage-store-page-status]');
    const storePagePrevious = form.querySelector<HTMLButtonElement>('[data-homepage-store-page-prev]');
    const storePageNext = form.querySelector<HTMLButtonElement>('[data-homepage-store-page-next]');
    const storePageSize = Math.max(1, Number(storeList?.dataset.pageSize || 10));
    let storePage = 1;

    const normalizedSearch = (value: string) => value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase('es')
      .trim();

    const refreshStorePicker = () => {
      if (!storeList) return;
      const query = normalizedSearch(storeSearch?.value || '');
      const filtered = storeOptions.filter((option) => normalizedSearch(option.dataset.storeSearch || '').includes(query));
      const totalPages = Math.max(1, Math.ceil(filtered.length / storePageSize));
      storePage = Math.min(Math.max(storePage, 1), totalPages);
      const pageStart = (storePage - 1) * storePageSize;
      const visibleOptions = new Set(filtered.slice(pageStart, pageStart + storePageSize));
      storeOptions.forEach((option) => { option.hidden = !visibleOptions.has(option); });

      const selectedCount = form.querySelectorAll('[data-homepage-featured-store]:checked').length;
      if (storeSelectedLabel) storeSelectedLabel.textContent = `${selectedCount} ${selectedCount === 1 ? 'tienda seleccionada' : 'tiendas seleccionadas'}`;
      if (storeResults) storeResults.textContent = `${filtered.length} ${filtered.length === 1 ? 'negocio disponible' : 'negocios disponibles'}`;
      if (storeEmpty) storeEmpty.hidden = filtered.length > 0;
      if (storePageStatus) storePageStatus.textContent = `Página ${storePage} de ${totalPages}`;
      if (storePagePrevious) storePagePrevious.disabled = storePage <= 1;
      if (storePageNext) storePageNext.disabled = storePage >= totalPages;
    };

    storeSearch?.addEventListener('input', () => { storePage = 1; refreshStorePicker(); });
    storeList?.addEventListener('change', refreshStorePicker);
    storePagePrevious?.addEventListener('click', () => { storePage -= 1; refreshStorePicker(); });
    storePageNext?.addEventListener('click', () => { storePage += 1; refreshStorePicker(); });
    refreshStorePicker();

    const refreshQuestionLabels = () => {
      faqList.querySelectorAll<HTMLElement>('[data-homepage-faq-item]').forEach((item, index) => {
        const title = item.querySelector<HTMLElement>('header > strong');
        if (title) title.textContent = `Pregunta ${index + 1}`;
      });
    };

    faqList.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>('[data-homepage-faq-remove]');
      if (!button) return;
      const items = faqList.querySelectorAll('[data-homepage-faq-item]');
      if (items.length <= 1) {
        setAlert('La configuración debe conservar al menos una pregunta. Puedes ocultarla si no deseas publicarla.');
        return;
      }
      button.closest('[data-homepage-faq-item]')?.remove();
      refreshQuestionLabels();
      setAlert();
    });

    addButton?.addEventListener('click', () => {
      const count = faqList.querySelectorAll('[data-homepage-faq-item]').length;
      if (count >= 10) {
        setAlert('Puedes configurar hasta 10 preguntas frecuentes.');
        return;
      }
      if (!template) return;
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const item = fragment.querySelector<HTMLElement>('[data-homepage-faq-item]');
      if (!item) return;
      const random = Math.random().toString(36).slice(2, 7);
      item.dataset.faqId = `faq-${Date.now().toString(36)}-${random}`;
      faqList.append(fragment);
      refreshQuestionLabels();
      item.querySelector<HTMLInputElement>('[data-homepage-faq-question]')?.focus();
      setAlert();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setAlert();
      if (!form.reportValidity()) return;
      const storesEnabled = form.querySelector<HTMLInputElement>('[data-homepage-stores-enabled]');
      const faqEnabled = form.querySelector<HTMLInputElement>('[data-homepage-faq-enabled]');
      const faqEyebrow = form.querySelector<HTMLInputElement>('[data-homepage-faq-eyebrow]');
      const faqTitle = form.querySelector<HTMLInputElement>('[data-homepage-faq-title]');
      const faqIntro = form.querySelector<HTMLTextAreaElement>('[data-homepage-faq-intro]');
      if (!storesEnabled || !faqEnabled || !faqEyebrow || !faqTitle || !faqIntro) return;

      const faqs = Array.from(faqList.querySelectorAll<HTMLElement>('[data-homepage-faq-item]')).map((item) => ({
        id: String(item.dataset.faqId || ''),
        visible: item.querySelector<HTMLInputElement>('[data-homepage-faq-visible]')?.checked !== false,
        question: String(item.querySelector<HTMLInputElement>('[data-homepage-faq-question]')?.value || '').trim(),
        answer: String(item.querySelector<HTMLTextAreaElement>('[data-homepage-faq-answer]')?.value || '').trim(),
      }));
      const featuredStoreIds = Array.from(form.querySelectorAll<HTMLInputElement>('[data-homepage-featured-store]:checked')).map((input) => input.value);
      if (faqs.some((faq) => !faq.id || !faq.question || !faq.answer)) {
        setAlert('Completa todas las preguntas y respuestas antes de guardar.');
        return;
      }

      if (saveButton) saveButton.disabled = true;
      try {
        const response = await fetch('/api/master/homepage-settings', {
          method: 'POST',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            record_id: String(form.dataset.recordId || ''),
            stores_section_enabled: storesEnabled.checked,
            faq_section_enabled: faqEnabled.checked,
            faq_eyebrow: faqEyebrow.value.trim(),
            faq_title: faqTitle.value.trim(),
            faq_intro: faqIntro.value.trim(),
            faqs,
            featured_store_ids: featuredStoreIds,
          }),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok || payload?.ok !== true) {
          const message = payload?.error === 'settings_changed'
            ? 'La configuración cambió en otra sesión. Recarga la página antes de guardar.'
            : payload?.error === 'invalid_store_selection'
              ? 'Una de las tiendas seleccionadas ya no está disponible.'
              : 'No fue posible guardar la portada. Revisa el backend e inténtalo nuevamente.';
          setAlert(message);
          return;
        }
        if (payload.settings?.recordId) form.dataset.recordId = String(payload.settings.recordId);
        setAlert('Portada comercial guardada correctamente.', true);
      } catch (_) {
        setAlert('No fue posible conectar con el servidor para guardar la portada.');
      } finally {
        if (saveButton) saveButton.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', initializeMasterHomepageSettings);
  initializeMasterHomepageSettings();
</script>

<style>
  .master-homepage-page { gap: 1.25rem; }
  .master-homepage-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
  .master-homepage-heading > div { display: grid; gap: .35rem; }
  .master-homepage-heading p { margin: 0; color: #155eeb; font-size: .75rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .master-homepage-heading h2 { margin: 0; color: #0b1d43; font-size: clamp(1.65rem, 3vw, 2.25rem); }
  .master-homepage-heading span { color: #5b6880; line-height: 1.5; }
  .master-homepage-form { display: grid; gap: 1.25rem; }
  .master-homepage-block { overflow: hidden; }
  .master-homepage-block__heading { align-items: flex-start; }
  .master-homepage-block__heading > div { max-width: 760px; }
  .master-homepage-kicker { display: block; margin-bottom: .4rem; color: #155eeb; font-size: .69rem; font-weight: 900; letter-spacing: .1em; }
  .master-homepage-switch { flex: 0 0 auto; display: grid; grid-template-columns: 46px auto; align-items: center; gap: .25rem .65rem; color: #243655; cursor: pointer; }
  .master-homepage-switch input { position: absolute; opacity: 0; pointer-events: none; }
  .master-homepage-switch > span { position: relative; grid-row: 1; width: 46px; height: 26px; border-radius: 999px; background: #cbd5e1; transition: background-color 160ms ease; }
  .master-homepage-switch > span::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 2px 7px rgba(15,23,42,.24); transition: transform 160ms ease; }
  .master-homepage-switch input:checked + span { background: #155eeb; }
  .master-homepage-switch input:checked + span::after { transform: translateX(20px); }
  .master-homepage-switch input:focus-visible + span { outline: 3px solid rgba(21,94,235,.25); outline-offset: 2px; }
  .master-homepage-switch strong { grid-column: 2; grid-row: 1; font-size: .84rem; white-space: nowrap; }
  .master-homepage-store-picker { overflow: clip; border: 1px solid #dce3ef; border-radius: 16px; background: #fff; }
  .master-homepage-store-picker > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 68px; padding: .85rem 1rem; color: #142646; cursor: pointer; list-style: none; transition: background-color 160ms ease; }
  .master-homepage-store-picker > summary::-webkit-details-marker { display: none; }
  .master-homepage-store-picker > summary:hover { background: #f7f9fd; }
  .master-homepage-store-picker > summary:focus-visible { outline: 3px solid rgba(21,94,235,.22); outline-offset: -3px; }
  .master-homepage-store-picker__summary-copy { min-width: 0; display: grid; gap: .2rem; }
  .master-homepage-store-picker__summary-copy strong { font-size: .94rem; }
  .master-homepage-store-picker__summary-copy small { color: #68748a; font-size: .8rem; }
  .master-homepage-store-picker__chevron { width: 32px; height: 32px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid #d5deeb; border-radius: 10px; color: #155eeb; font-size: 1.25rem; font-weight: 900; transition: transform 180ms ease, background-color 180ms ease; }
  .master-homepage-store-picker[open] .master-homepage-store-picker__chevron { transform: rotate(180deg); background: #edf4ff; }
  .master-homepage-store-picker__panel { display: grid; gap: .85rem; border-top: 1px solid #e1e7f0; background: #f8faff; padding: 1rem; }
  .master-homepage-store-toolbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
  .master-homepage-store-toolbar .master-field { flex: 1 1 420px; max-width: 560px; }
  .master-homepage-store-results { flex: 0 0 auto; color: #68748a; font-size: .78rem; font-weight: 750; padding-bottom: .75rem; }
  .master-homepage-store-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .master-homepage-store-option { position: relative; min-width: 0; display: grid; grid-template-columns: 26px 44px minmax(0, 1fr); align-items: center; gap: .7rem; border: 1px solid #dce3ef; border-radius: 13px; background: #fff; padding: .7rem .8rem; cursor: pointer; transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }
  .master-homepage-store-option[hidden] { display: none; }
  .master-homepage-store-option:hover { border-color: #a9c4ef; transform: translateY(-1px); }
  .master-homepage-store-option:has(input:checked) { border-color: #78a9fa; background: #eef5ff; box-shadow: 0 7px 18px rgba(21,94,235,.08); }
  .master-homepage-store-option input { position: absolute; opacity: 0; }
  .master-homepage-store-option__mark { width: 26px; height: 26px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: transparent; font-weight: 900; }
  .master-homepage-store-option input:checked + .master-homepage-store-option__mark { border-color: #155eeb; background: #155eeb; color: #fff; }
  .master-homepage-store-option input:focus-visible + .master-homepage-store-option__mark { outline: 3px solid rgba(21,94,235,.25); outline-offset: 2px; }
  .master-homepage-store-option__logo { width: 44px; height: 44px; display: grid; place-items: center; overflow: hidden; border: 1px solid #dbe4f1; border-radius: 12px; background: #fff; color: #164a9f; font-size: .72rem; font-weight: 900; }
  .master-homepage-store-option__logo img { width: 100%; height: 100%; display: block; object-fit: contain; padding: 3px; }
  .master-homepage-store-option__copy { min-width: 0; display: grid; gap: .12rem; }
  .master-homepage-store-option__copy strong { overflow: hidden; color: #142646; text-overflow: ellipsis; white-space: nowrap; }
  .master-homepage-store-option__copy small { overflow: hidden; color: #748198; text-overflow: ellipsis; white-space: nowrap; }
  .master-homepage-store-empty { margin: 0; border: 1px dashed #cbd5e1; border-radius: 12px; background: #fff; color: #64748b; padding: 1rem; text-align: center; }
  .master-homepage-store-pagination { display: grid; grid-template-columns: auto minmax(120px, 1fr) auto; align-items: center; gap: .75rem; }
  .master-homepage-store-pagination span { color: #52627c; font-size: .8rem; font-weight: 800; text-align: center; }
  .master-homepage-store-pagination button { min-height: 38px; border: 1px solid #cbd8eb; border-radius: 10px; background: #fff; color: #19488f; padding: .5rem .8rem; font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer; }
