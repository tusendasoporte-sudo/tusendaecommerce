---
import type { StoreCapabilityAccess } from '../../lib/storeCapabilities';

interface Props {
  access: StoreCapabilityAccess;
  featureName?: string;
  featureDescription?: string;
  preservationMessage?: string;
  requiredPlanLabel?: string;
  infoTitle?: string;
  infoDescription?: string;
  compact?: boolean;
  planExpiredUsesPlanGate?: boolean;
}

const {
  access,
  featureName = 'Función',
  featureDescription,
  preservationMessage = 'Conservaremos tu configuración si cambias de plan.',
  requiredPlanLabel = 'No disponible en el plan actual',
  infoTitle = '',
  infoDescription = '',
  compact = false,
  planExpiredUsesPlanGate = false,
} = Astro.props;

const isTechnicalState = access.reason === 'invalid_capability'
  || access.reason === 'invalid_plan_data'
  || (access.reason === 'plan_expired' && !planExpiredUsesPlanGate);
const isLimitState = access.reason === 'limit_exceeded';
const title = isTechnicalState
  ? 'Función temporalmente no disponible'
  : isLimitState
    ? 'Límite alcanzado'
    : compact ? 'Función no incluida' : `${featureName} no está incluida en el plan actual`;
const description = isTechnicalState
  ? 'Intenta nuevamente más tarde o contacta al administrador principal.'
  : featureDescription || (isLimitState
    ? 'Alcanzaste el límite permitido por tu plan.'
    : 'Tu plan actual no incluye esta función.');
---

{access.allowed ? (
  <slot />
) : (
  <div class:list={[
    'store-capability-gate',
    isTechnicalState && 'store-capability-gate--neutral',
    isLimitState && 'store-capability-gate--limit',
    compact && 'store-capability-gate--compact',
  ]}>
    <div class="store-capability-gate__shell">
      <section
        class="store-capability-gate__card"
        aria-label={title}
        aria-live={isTechnicalState ? 'polite' : undefined}
      >
        <span class="store-capability-gate__lock" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V7Zm3 9.73V19h-2v-2.27a2 2 0 1 1 2 0Z" />
          </svg>
        </span>

        <div class="store-capability-gate__heading">
          <h2>{title}</h2>
          <p>{description}</p>
        </div>

        {!isTechnicalState && (
          <div class="store-capability-gate__notice">
            <span class="store-capability-gate__notice-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M12 2 4 5.5v5.8c0 5 3.4 9.6 8 10.7 4.6-1.1 8-5.7 8-10.7V5.5L12 2Zm0 3.2 5 2.1v4c0 3.4-2 6.7-5 7.7-3-1-5-4.3-5-7.7v-4l5-2.1Zm-1 4.3h2v2h-2v-2Zm0 3h2v4h-2v-4Z" />
              </svg>
            </span>
            <span class="store-capability-gate__notice-copy">
              <span>{preservationMessage}</span>
              {!isLimitState && <span>Para activarla, contacta al administrador principal.</span>}
            </span>
          </div>
        )}

        {!isTechnicalState && (
          <span class="store-capability-gate__badge">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m4 7 4.1 3.1L12 4l3.9 6.1L20 7l-1.4 10H5.4L4 7Zm2.9 8h10.2l.6-4.1-2.4 1.8L12 7.5l-3.3 5.2-2.4-1.8.6 4.1ZM6 19h12v2H6v-2Z" />
            </svg>
            {requiredPlanLabel}
          </span>
        )}
      </section>
    </div>

    {(infoTitle || infoDescription) && (
      <aside class="store-capability-gate__info" aria-label={infoTitle || 'Información de la función'}>
        <span class="store-capability-gate__info-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16Zm-1 6h2v7h-2v-7Zm0-3h2v2h-2V7Z" />
          </svg>
        </span>
        <span class="store-capability-gate__info-copy">
          {infoTitle && <strong>{infoTitle}</strong>}
          {infoDescription && <span>{infoDescription}</span>}
        </span>
      </aside>
    )}
  </div>
)}

<style>
  .store-capability-gate {
    --gate-accent: #5b21b6;
    --gate-accent-strong: #3b177f;
    --gate-border: #d8ccff;
    --gate-soft: #f6f2ff;
    display: grid;
    width: 100%;
    min-width: 0;
    gap: 16px;
    color: #0f172a;
    font-family: inherit;
  }

  .store-capability-gate--limit {
    --gate-accent: #6d28d9;
    --gate-accent-strong: #4c1d95;
  }

  .store-capability-gate--neutral {
    --gate-accent: #475569;
    --gate-accent-strong: #1e293b;
    --gate-border: #dbe3ee;
    --gate-soft: #f8fafc;
  }

  .store-capability-gate__shell {
    min-width: 0;
    border: 1px solid rgba(226, 232, 240, .9);
    border-radius: 22px;
    background: #fff;
    padding: 16px;
    box-shadow: 0 14px 35px rgba(15, 23, 42, .045);
  }

  .store-capability-gate__card {
    display: flex;
    min-width: 0;
    min-height: 390px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    overflow: hidden;
    border: 1px solid var(--gate-border);
    border-radius: 16px;
    background:
      radial-gradient(circle at 16% 10%, rgba(124, 58, 237, .075), transparent 31%),
      linear-gradient(135deg, #fff 0%, var(--gate-soft) 100%);
    padding: clamp(30px, 6vw, 54px) clamp(20px, 7vw, 56px);
    text-align: center;
  }

  .store-capability-gate--compact {
    gap: 10px;
  }

  .store-capability-gate--compact .store-capability-gate__shell {
    border-radius: 16px;
    padding: 8px;
  }

  .store-capability-gate--compact .store-capability-gate__card {
    min-height: 0;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    gap: 13px;
    padding: 16px;
    text-align: left;
  }

  .store-capability-gate--compact .store-capability-gate__lock {
    width: 46px;
    height: 46px;
    border-radius: 13px;
  }

  .store-capability-gate--compact .store-capability-gate__lock svg {
    width: 24px;
    height: 24px;
  }

  .store-capability-gate--compact .store-capability-gate__heading {
    gap: 5px;
  }

  .store-capability-gate--compact .store-capability-gate__heading h2 {
    font-size: 17px;
  }

  .store-capability-gate--compact .store-capability-gate__heading p {
    font-size: 13px;
    line-height: 1.45;
  }

  .store-capability-gate--compact .store-capability-gate__notice {
    grid-column: 2 / -1;
    width: 100%;
    padding: 11px 13px;
  }

  .store-capability-gate--compact .store-capability-gate__badge {
    grid-column: 3;
    grid-row: 1;
  }

  .store-capability-gate--neutral .store-capability-gate__card {
    background: linear-gradient(135deg, #fff, #f8fafc);
  }

  .store-capability-gate__lock {
    display: inline-flex;
    width: 68px;
    height: 68px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid #bfa9ff;
    border-radius: 17px;
    background: linear-gradient(145deg, #fff, #eee7ff);
    color: var(--gate-accent);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .75);
  }

  .store-capability-gate--neutral .store-capability-gate__lock {
    border-color: #cbd5e1;
    background: #f8fafc;
  }

  .store-capability-gate__lock svg {
    width: 34px;
    height: 34px;
    fill: currentColor;
  }

  .store-capability-gate__heading {
    display: grid;
    max-width: 620px;
    gap: 11px;
  }

  .store-capability-gate__heading h2 {
    margin: 0;
    color: #17134d;
    font-size: clamp(21px, 3vw, 27px);
    font-weight: 950;
    letter-spacing: -.035em;
    line-height: 1.16;
  }

  .store-capability-gate--neutral .store-capability-gate__heading h2 {
    color: #1e293b;
  }

  .store-capability-gate__heading p {
    margin: 0;
    color: #334155;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.6;
  }

  .store-capability-gate__notice {
    display: grid;
    width: min(100%, 560px);
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    border-top: 1px solid rgba(109, 40, 217, .12);
    border-radius: 12px;
    background: linear-gradient(100deg, #f0e9ff, #f6f1ff);
    padding: 17px 18px;
    color: #172033;
    text-align: left;
  }

  .store-capability-gate__notice-icon {
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #e0d4ff;
    color: var(--gate-accent);
  }

  .store-capability-gate__notice-icon svg {
    width: 21px;
    height: 21px;
    fill: currentColor;
  }

  .store-capability-gate__notice-copy {
    display: grid;
    min-width: 0;
    gap: 4px;
    font-size: 13.5px;
    font-weight: 650;
    line-height: 1.45;
  }

  .store-capability-gate__badge {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid #c9b8ff;
    border-radius: 999px;
    background: #f1ebff;
    padding: 8px 14px;
    color: var(--gate-accent-strong);
    font-size: 13px;
    font-weight: 900;
    line-height: 1.2;
  }

  .store-capability-gate__badge svg {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
    fill: currentColor;
  }

  .store-capability-gate__info {
    display: grid;
    min-width: 0;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: start;
    gap: 13px;
    border: 1px solid #cfe0ff;
    border-radius: 14px;
    background: rgba(255, 255, 255, .92);
    padding: 17px 18px;
    box-shadow: 0 10px 26px rgba(37, 99, 235, .04);
  }

  .store-capability-gate__info-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    color: #2563eb;
  }

  .store-capability-gate__info-icon svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .store-capability-gate__info-copy {
    display: grid;
    min-width: 0;
    gap: 6px;
    color: #334155;
    font-size: 13px;
    line-height: 1.55;
  }

  .store-capability-gate__info-copy strong {
    color: #172033;
    font-size: 14px;
    font-weight: 900;
  }

  @media (max-width: 640px) {
    .store-capability-gate {
      gap: 12px;
    }

    .store-capability-gate__shell {
      border-radius: 18px;
      padding: 10px;
    }

    .store-capability-gate__card {
      min-height: 410px;
      gap: 20px;
      border-radius: 14px;
      padding: 30px 18px;
    }

    .store-capability-gate__lock {
      width: 60px;
      height: 60px;
      border-radius: 15px;
    }

    .store-capability-gate__lock svg {
      width: 30px;
      height: 30px;
    }

    .store-capability-gate__heading h2 {
      font-size: 21px;
    }

    .store-capability-gate__heading p {
      font-size: 14px;
    }

    .store-capability-gate__notice {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 11px;
      padding: 15px;
    }

    .store-capability-gate__notice-icon {
      width: 36px;
      height: 36px;
    }

    .store-capability-gate__badge {
      max-width: 100%;
      white-space: normal;
    }

    .store-capability-gate__info {
      padding: 15px;
    }

    .store-capability-gate--compact .store-capability-gate__card {
      min-height: 0;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 11px;
      padding: 14px;
    }

    .store-capability-gate--compact .store-capability-gate__badge,
    .store-capability-gate--compact .store-capability-gate__notice {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store-capability-gate *,
    .store-capability-gate *::before,
    .store-capability-gate *::after {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>
