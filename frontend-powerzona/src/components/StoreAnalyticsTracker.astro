---
type Props = {
  storeId?: string;
  pageType?: 'store_home' | 'category' | 'subcategory' | 'product' | 'gifts' | 'search' | 'checkout' | 'landing_qr' | 'other';
  entityType?: string;
  entityId?: string;
  eventType?: 'pageview' | 'landing_qr_view';
  heartbeatEnabled?: boolean;
};

const {
  storeId = '',
  pageType = 'other',
  entityType = '',
  entityId = '',
  eventType = 'pageview',
  heartbeatEnabled = false,
} = Astro.props;

const pocketbaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
---

{storeId && pocketbaseUrl && (
  <script define:vars={{ pocketbaseUrl, storeId, pageType, entityType, entityId, eventType, heartbeatEnabled }}>
    (() => {
      const HEARTBEAT_ENABLED = heartbeatEnabled === true;

      try {
        const path = window.location.pathname || '';

        if (
          path.includes('/admin') ||
          path.includes('/master') ||
          path.includes('/login') ||
          path.includes('/master-login')
        ) {
          return;
        }

        if (navigator.doNotTrack === '1') {
          return;
        }

        const POCKETBASE_URL = String(pocketbaseUrl || '').replace(/\/$/, '');
        const STORE_ID = String(storeId || '').trim();
        const PAGE_TYPE = String(pageType || 'other').trim() || 'other';
        const INITIAL_EVENT_TYPE = String(eventType || 'pageview').trim() || 'pageview';

        if (!POCKETBASE_URL || !STORE_ID) {
          return;
        }

        const storageKey = 'pz_visitor_id';
        const legacyStorageKey = 'tusenda84_visitor_id';
        const sessionKey = 'pz_session_id';
        const lastActivityKey = 'pz_last_activity_at';
        const sessionTimeoutMs = 30 * 60 * 1000;
        const securityDeviceCookie = 'pz_client_device';
        const securityDeviceMaxAge = 60 * 60 * 24 * 365;

        const makeId = (prefix) => {
          if (window.crypto?.randomUUID) return `${prefix}_${window.crypto.randomUUID()}`;
          const randomPart = Math.random().toString(36).slice(2, 12);
          const timePart = Date.now().toString(36);
          return `${prefix}_${timePart}_${randomPart}`;
        };

        let visitorId = localStorage.getItem(storageKey) || localStorage.getItem(legacyStorageKey);
        if (!visitorId) visitorId = makeId('v');
        localStorage.setItem(storageKey, visitorId);

        const nowTime = Date.now();
        const lastActivity = Number(localStorage.getItem(lastActivityKey) || 0);
        const isExpiredSession =
          !Number.isFinite(lastActivity) ||
          !lastActivity ||
          nowTime - lastActivity > sessionTimeoutMs;

        let sessionId = localStorage.getItem(sessionKey);
        if (!sessionId || isExpiredSession) {
          sessionId = makeId('s');
          localStorage.setItem(sessionKey, sessionId);
        }
        localStorage.setItem(lastActivityKey, String(nowTime));

        const now = new Date();
        const localDay = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
          .toISOString()
          .slice(0, 10);

        const endpoint = `${POCKETBASE_URL}/api/collections/store_analytics_events/records`;
        const securityEndpoint = `${POCKETBASE_URL}/api/pz/security/track-navigation`;

        function base64UrlFromBytes(bytes) {
          let binary = '';
          bytes.forEach((byte) => {
            binary += String.fromCharCode(byte);
          });
          return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
        }

        function readCookie(name) {
          const prefix = `${name}=`;
          return document.cookie
            .split(';')
            .map((part) => part.trim())
            .find((part) => part.startsWith(prefix))
            ?.slice(prefix.length) || '';
        }

        function writeSecurityDeviceCookie(token) {
          const secureFlag = window.location.protocol === 'https:' ? '; Secure' : '';
          document.cookie = `${securityDeviceCookie}=${token}; Path=/; SameSite=Lax; Max-Age=${securityDeviceMaxAge}${secureFlag}`;
        }

        function createSecurityDeviceToken() {
          if (!window.crypto?.getRandomValues) return '';
          const bytes = new Uint8Array(32);
          window.crypto.getRandomValues(bytes);
          return base64UrlFromBytes(bytes);
        }

        function getOrCreateSecurityDeviceToken() {
          const existingToken = readCookie(securityDeviceCookie);
          if (/^[A-Za-z0-9_-]{43}$/.test(existingToken)) return existingToken;

          const token = createSecurityDeviceToken();
          if (!token) return '';
          writeSecurityDeviceCookie(token);
          return token;
        }

        async function sha256Hex(value) {
          if (!window.crypto?.subtle || typeof TextEncoder === 'undefined') return '';
          const encoded = new TextEncoder().encode(value);
          const digest = await window.crypto.subtle.digest('SHA-256', encoded);
          return Array.from(new Uint8Array(digest))
            .map((byte) => byte.toString(16).padStart(2, '0'))
            .join('');
        }

        async function getSecurityBrowserTokenDigest() {
          const token = getOrCreateSecurityDeviceToken();
          if (!token) return '';
          return sha256Hex(token);
        }

        function makeSecurityEventId() {
          if (window.crypto?.randomUUID) return window.crypto.randomUUID();
          if (!window.crypto?.getRandomValues) return '';
          const bytes = new Uint8Array(16);
          window.crypto.getRandomValues(bytes);
          return Array.from(bytes).map((byte) => byte.toString(16).padStart(2, '0')).join('');
        }

        function buildPayload(eventType = 'pageview') {
          return {
            store: STORE_ID,
            event_type: eventType,
            day: localDay,
            visitor_id: visitorId,
            session_id: sessionId,
            page_type: PAGE_TYPE,
            entity_type: entityType || '',
            entity_id: entityId || '',
            path: window.location.pathname.slice(0, 240),
            referrer: document.referrer ? document.referrer.slice(0, 240) : '',
            user_agent: PAGE_TYPE === 'landing_qr' ? '' : (navigator.userAgent ? navigator.userAgent.slice(0, 260) : ''),
          };
        }

        async function buildSecurityPayload() {
          const eventId = makeSecurityEventId();
          if (!eventId) return null;

          return {
            store_id: STORE_ID,
            event_id: eventId,
            visitor_id: visitorId || '',
            session_id: sessionId || '',
            browser_token_digest: await getSecurityBrowserTokenDigest(),
            page_type: PAGE_TYPE,
            entity_type: entityType || '',
            entity_id: entityId || '',
            path: window.location.pathname.slice(0, 240),
          };
        }

        async function sendAnalyticsEvent(eventType = 'pageview') {
          const payload = buildPayload(eventType);

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              keepalive: true,
            });

            if (!response.ok) return false;

            return true;
          } catch (_) {
            return false;
          }
        }

        async function sendSecurityNavigationEvent() {
          try {
            const payload = await buildSecurityPayload();
            if (!payload) return false;

            const response = await fetch(securityEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              keepalive: true,
              cache: 'no-store',
            });

            return response.ok;
          } catch (_) {
            return false;
          }
        }

        function getLandingQrViewStorageKey() {
          if (INITIAL_EVENT_TYPE !== 'landing_qr_view') return '';
          return `pz_landing_qr_view_${STORE_ID}_${localDay}`;
        }

        function shouldSkipLandingQrView() {
          if (INITIAL_EVENT_TYPE !== 'landing_qr_view') return false;

          try {
            const key = getLandingQrViewStorageKey();
            return !!key && sessionStorage.getItem(key) === 'sent';
          } catch (_) {
            return false;
          }
        }

        function markLandingQrViewSent() {
          if (INITIAL_EVENT_TYPE !== 'landing_qr_view') return;

          try {
            const key = getLandingQrViewStorageKey();
            if (key) sessionStorage.setItem(key, 'sent');
          } catch (_) {}
        }

        async function sendInitialAnalyticsEvent() {
          if (shouldSkipLandingQrView()) return;

          const [sent] = await Promise.all([
            sendAnalyticsEvent(INITIAL_EVENT_TYPE),
            sendSecurityNavigationEvent(),
          ]);

          if (sent && INITIAL_EVENT_TYPE === 'landing_qr_view') {
            markLandingQrViewSent();
          }
        }

        sendInitialAnalyticsEvent();

        if (HEARTBEAT_ENABLED) {
          let heartbeatTimer = null;

          function startHeartbeat() {
            if (heartbeatTimer) return;

            heartbeatTimer = window.setInterval(() => {
              if (document.hidden) return;
              localStorage.setItem(lastActivityKey, String(Date.now()));
              sendAnalyticsEvent('heartbeat');
            }, 60000);
          }

          function stopHeartbeat() {
            if (!heartbeatTimer) return;
            window.clearInterval(heartbeatTimer);
            heartbeatTimer = null;
          }

          document.addEventListener('visibilitychange', () => {
            if (document.hidden) stopHeartbeat();
            else startHeartbeat();
          });

          startHeartbeat();
        }
      } catch (_) {
      }
    })();
  </script>
)}
