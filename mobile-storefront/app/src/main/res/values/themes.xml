<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Storefront" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/pz_brand_base_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/pz_brand_base_background</item>
        <item name="android:navigationBarColor">@color/pz_brand_base_background</item>
        <item name="android:colorAccent">@color/pz_brand_energy_cobalt</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Storefront.Launch" parent="Theme.Storefront">
        <item name="android:windowBackground">@drawable/storefront_launch_screen</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
