<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/storefront_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <WebView
        android:id="@+id/storefront_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pz_brand_base_background"
        android:contentDescription="@string/storefront_web_content" />

    <ImageView
        android:id="@+id/storefront_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pz_brand_base_background"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/storefront_splash" />

    <ProgressBar
        android:id="@+id/storefront_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressBackgroundTint="@color/pz_brand_platinum"
        android:progressTint="@color/pz_brand_flash_blue"
        android:visibility="gone" />

    <include
        android:id="@+id/storefront_offline"
        layout="@layout/view_storefront_offline"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/notification_permission_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@color/pz_brand_luminous_ice"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_card_title"
            android:textColor="@color/pz_brand_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_permission_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/notification_card_prompt"
            android:textColor="@color/pz_brand_secondary_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/notification_permission_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/pz_brand_energy_cobalt"
            android:text="@string/notification_enable"
            android:textAllCaps="false"
            android:textColor="@color/pz_brand_pearl_white" />
    </LinearLayout>

</FrameLayout>
